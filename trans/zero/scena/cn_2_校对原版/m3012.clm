		CharFlags2Unset char[1] 0x8000
		CharFlagsSet char[0] 0x0010
		CharFlagsSet char[1] 0x0010
	Return

fn[3]:
	TriggerFlagsSet trigger[0] 0x0080
	if flag[1831] && !flag[1832]:
		TriggerFlagsUnset trigger[0] 0x0080
	if flag[1957]:
		ED7ObjPlay object[7] 150 210 0 32
	if flag[1958]:
		ED7ObjPlay object[6] 150 210 0 32
	var[2] = 0
	if flag[1834]:
		var[2] = var[2] + 1
	if flag[1835]:
		var[2] = var[2] + 1
	if flag[1836]:
		var[2] = var[2] + 1
	if var[2] == 3:
		ObjFrame object[3] 90
		ObjFrame object[4] 90
		ObjFrame object[5] 90
		ObjFlagsUnset object[3] 0x0002
		ObjFlagsUnset object[4] 0x0002
		ObjFlagsUnset object[5] 0x0002
	elif var[2] == 2:
		ObjFrame object[3] 20
		ObjFrame object[4] 20
		ObjFrame object[5] 20
		ObjFlagsSet object[3] 0x0002
		ObjFlagsSet object[4] 0x0002
		ObjFlagsSet object[5] 0x0002
	elif var[2] == 1:
		ObjFrame object[3] 10
		ObjFrame object[4] 10
		ObjFrame object[5] 10
		ObjFlagsSet object[3] 0x0002
		ObjFlagsSet object[4] 0x0002
		ObjFlagsSet object[5] 0x0002
	else:
		ObjFrame object[3] 0
		ObjFrame object[4] 0
		ObjFrame object[5] 0
		ObjFlagsSet object[3] 0x0002
		ObjFlagsSet object[4] 0x0002
		ObjFlagsSet object[5] 0x0002
	char[5].12 = 128
	char[5].20 = 183
	char[5].13 = 128
	char[5].21 = 183
	char[5].14 = 128
	char[5].22 = 183
	char[5].15 = 128
	char[5].23 = 183
	char[5].16 = 128
	char[5].24 = 183
	char[5].17 = 128
	char[5].25 = 183
	char[5].18 = 128
	char[5].26 = 183
	char[5].19 = 128
	char[5].27 = 183
