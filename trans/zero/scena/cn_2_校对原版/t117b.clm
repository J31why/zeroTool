fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if flag[736]:
		FlagUnset flag[736]
		if flag[1353]:
			Event fn[0,8]
		elif flag[1354]:
			Event fn[0,9]
		elif flag[1355]:
			Event fn[0,9]
	if flag[1333]:
	elif flag[1330]:
	elif flag[1329]:
		CharFlagsUnset char[3] 0x0080
		CharFlagsUnset char[4] 0x0080
	elif flag[1320]:
		CharFlagsUnset char[0] 0x0080
		CharFlagsUnset char[1] 0x0080
		CharFlagsUnset char[2] 0x0080
	Return

fn[2]:
	if flag[1333]:
	if flag[1342]:
	elif flag[1334]:
		if system[0] == 107 | system[0] == 109 | system[0] == 113:
			if random % 100 < 50:
				Event fn[0,10]
	Return

fn[3]:
	TextStart self
	TextTalk self {
		這次受到邀請的客人……
		雖然沒有透露姓名，
		但都是帝國與共和國的要人。{wait}
	}
	TextWait
	TextTalk self {
		那些政治家與貴族
		真是擅長表裡不一
		這一套啊。{wait}
	}
	TextWait
	TextTalk self {
		……當然我也不例外。
		呵呵……{wait}
	}
	TextWait
	TextEnd self
	Return

fn[4]:
	TextStart self
	if !flag[0]:
		TextTalk self {
			這個拍賣會是與各國要人
			締結關係的
			絕好機會。{wait}
		}
		TextWait
		TextTalk self {
			呵呵……女兒啊，
			順便也找個
			夫婿怎麼樣？{wait}
		}
		TextWait
		TextTalk char[2] {
			呵呵……父親可真是的，
			那簡直像是政治婚姻嘛。{wait}
		}
		TextWait
		TextTalk char[2] {
			父親以上門女婿的身份
			入贅到母親家，
			其實也是這麼回事吧？{wait}
		}
		TextWait
		TextTalk self {
			哇哈哈哈，
			真是說不過你啊。{wait}
		}
		TextWait
		FlagSet flag[0]
	else:
		TextTalk self {
			呵呵……
			從實際上說，也沒有比婚姻
			更加可靠的聯盟了嘛。{wait}
		}
		TextWait
		TextTalk self {
			要是有機會的話，最好能找個……雖然我是這麼想，
			但她終究已經到了有自己見解的年齡了啊。
			哇哈哈哈。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[5]:
	TextStart self
	TextTalk self {
		呵呵……父親可真是的，
		就會開玩笑。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[6]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if !flag[1]:
		TextTalk self {
			和丈夫的緣分已盡，也該分手了……
			就在我如此想的時候，
			瓦奇卻這樣對我說──{wait}
		}
		TextWait
		TextTalk self {
			『你之所以不能原諒你的丈夫，
			正是因為你仍然真心愛著他。』……{wait}
		}
		TextWait
		TextTalk self {
			我竟然忘記了最重要的事呢，
			要感謝瓦奇才行……{wait}
		}
		TextWait
		TextTalk self {
			我先生也在反省了，
			我想，這次就原諒他吧。{wait}
		}
		TextWait
		FlagSet flag[1530]
		FlagSet flag[1]
	else:
		CharSetChipPattern char[3] 0
		TextTalk self {
			我非常感謝瓦奇，
			結果是他讓我們夫婦
			破鏡重圓了。{wait}
		}
		TextWait
		TextTalk self {
			……好了，親愛的，我們走吧。
			競拍差不多也快開始了。{wait}
		}
		TextWait
	CharSetChipPattern self 0
	TextEnd self
	Return

fn[7]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if !flag[2]:
		TextTalk self {
			我還是第一次見到
			艾維琳那麼生氣的樣子呢。
			……說實話，好可怕啊。{wait}
		}
		TextWait
		TextTalk self {
			平時她都很溫柔安分，
			所以我才敢大膽地
			花心出軌……{wait}
		}
		TextWait
		TextTalk self {
			原來她的性格這麼剛烈啊。
			我都不知道呢……{wait}
		}
		TextWait
		FlagSet flag[1530]
		FlagSet flag[2]
	else:
		TextTalk self {
			無論如何，能和艾維琳
			和解，真是太好了。{wait}
		}
		TextWait
		TextTalk self {
			……我以後再也不會花心了。{wait}
		}
		TextWait
	CharSetChipPattern self 0
	TextEnd self
	Return

fn[8]:
	EventBegin 0
	FadeOut 0ms 0x00000000 255
	CamSetDistance 47070 2000 -52070 0ms
	ED7CamRotate 48deg 18deg 0deg 0ms
	CamPers 500 0ms
	CamZoom 18250 0ms
	CharSetPos name[0] (46200, 0, -52600) 90deg
	CharSetPos name[1] (46200, 0, -51400) 90deg
	CharSetPos name[55] (48700, 0, -52000) 270deg
	FadeIn 1000ms 0x00000000
	CamSetDistance 47070 1200 -52070 3000ms
	CamWait 1
	FadeWait
	TextTalk name[55] {
		#13501172V#2904F#11P呵呵，原來如此，
		還有這樣的內情啊。{wait}
	} {
		#13501173V#2902F你們還真大膽呢。{wait}
	}
	TextWait
	TextTalk name[0] {
		#13501174V#5106F#6P……嗯，是啊。{wait}
	} {
		#13501175V#5108F其實除了旁觀之外也做不了什麼，
		所以也許只是為了自我滿足而已吧。{wait}
	}
	TextWait
	TextTalk name[55] {
		#13501176V#2902F#11P呵呵，不過我很欣賞啊。{wait}
	} {
		#13501177V#2909F身為艾莉的同事，
		要是連這點膽識都沒有，
		可就太不合格了呢。{wait}
	}
	TextWait
	Emote name[1] 0mm 2000mm 40 43 100ms 3
	Sleep 500ms
	TextTalk name[1] {
		#13501178V#5313F#6P真、真是的，你在說什麼啊。{wait}
	} {
		#13501179V#5301F……話說回來，
		貝爾，你怎麼會在這裡？{wait}
	} {
		#13501180V聽你剛才說的那些話，
		你好像也是第一次來啊……{wait}
	}
	TextWait
	TextTalk name[55] {
		#13501181V#2902F#11P哈爾特曼議長
		每年都很熱心地邀請我們。{wait}
	} {
		#13501182V#2903F只是，那個人
		不是和一些可疑的傢伙有所來往嗎？{wait}
	} {
		#13501183V所以父親一直以種種
		理由加以拒絕……{wait}
	} {
		#13501184V#2901F不過我卻
		不能完全置之不理。{wait}
	}
	TextWait
	TextTalk name[1] {
		#13501185V#5306F#6P原來如此……
		確實可以理解。{wait}
	}
	TextWait
	Emote name[0] 0mm 2000mm 0 1 250ms 2
	SoundPlay sound[29] 0 100 0
	Sleep 1000ms
	TextTalk name[0] {
		#13501186V#5105F#6P有什麼內情嗎？{wait}
	}
	TextWait
	CharTurnToChar name[1] name[0] 500deg/s
	Sleep 300ms
	TextTalk name[1] {
		#13501187V#5300F#5P之前也說過的，
		叔叔把ＩＢＣ的好幾項事業
		都交給貝爾來打理。{wait}
	} {
		#13501188V這個米修拉姆的開發計畫
		似乎也是由她來管理的。{wait}
	}
	TextWait
	Emote name[0] 0mm 2000mm 2 7 80ms 1
	SoundPlay sound[28] 0 100 0
	Sleep 1000ms
	TextTalk name[0] {
		#13501189V#5111F#6P哎……！？{wait}
	}
	TextWait
	TextTalk name[55] {
		#13501190V#2902F#11P呵呵，話雖如此，
		但其實也只是參與了飯店
		和主題樂園的運營而已。{wait}
	} {
		#13501191V#2906F只是，由於這層關係，
		實在沒辦法每次都拒絕
		一直住在此地的議長的邀請。{wait}
	} {
		#13501192V#2900F所以今年
		就決定出席了。{wait}
	}
	TextWait
	TextTalk name[0] {
		#13501193V#5101F#6P原、原來如此……{wait}
	}
	TextWait
	CharTurnTo name[1] 90deg 400deg/s
	Sleep 300ms
	TextTalk name[1] {
		#13501194V#5311F#6P………………………………{wait}
	}
	TextWait
	Emote name[55] 0mm 2000mm 38 38 250ms 1
	Sleep 1000ms
	TextTalk name[55] {
		#13501195V#2905F#11P哎呀，艾莉？{wait}
	} {
		#13501196V你好像是
		有什麼話想說吧？{wait}
	}
	TextWait
	TextTalk name[1] {
		#13501197V#5303F#6P……嗯，算是吧。{wait}
	} {
		#13501198V#5300F貝爾是那種，對於自己不喜歡的事情
		就絕對不會去做的類型吧？{wait}
	} {
		#13501199V可是，你竟然會特意來到這種自己不感興趣
		的地方。雖說存在著某些內情……{wait}
	} {
		#13501200V但是不是還有其它目的？{wait}
	}
	TextWait
	TextTalk name[55] {
		#13501201V#2904F#11P呵呵……不愧是艾莉。{wait}
	} {
		#13501202V#2902F──其實，在這次的拍賣品裡，
		似乎有件很有意思的東西。{wait}
	} {
		#13501203V我對那個很感興趣，
		所以才決定出席的。{wait}
	}
	TextWait
	Emote name[0] 0mm 2000mm 38 38 250ms 1
	Emote name[1] 0mm 2000mm 38 38 250ms 1
	Sleep 1000ms
	TextTalk name[0] {
		#13501204V#5105F#6P那是……{wait}
	}
	TextWait
	TextTalk name[1] {
		#13501205V#5301F#6P是什麼樣的展品呢？{wait}
	}
	TextWait
	TextTalk name[55] {
		#13501206V#2904F#11P是羅贊貝爾克工房製造的
		初期古典人偶……{wait}
	} {
		#13501207V#2902F據宣傳說，在愛好者之間，
		那可是能標到天價的夢幻作品。{wait}
	}
	TextWait
	TextTalk name[0] {
		#13501208V#5105F#6P古典人偶……
		是那個人偶工房製造的吧。{wait}
	}
	TextWait
	TextTalk name[1] {
		#13501209V#5301F#6P……那也是
		有隱情的作品嗎？{wait}
	}
	TextWait
	TextTalk name[55] {
		#13501210V#2904F#11P可能是贓物，也可能是什麼地方的資產家
		因為某些見不得人的理由而賣出的……{wait}
	} {
		#13501211V#2902F詳情雖然還不清楚，
		但據傳聞說，那是件非常精美的傑作。{wait}
	} {
		#13501212V作為一名收藏家，
		是不能錯過的吧？{wait}
	}
	TextWait
	TextTalk name[1] {
		#13501213V#5306F#6P原來如此，你從以前開始
		就對那裡製作的人偶很著迷呢。{wait}
	}
	TextWait
	TextTalk name[0] {
		#13501214V#5101F#6P……順帶一問，那個人偶
		大概值多少錢呢？{wait}
	}
	TextWait
	TextTalk name[55] {
		#13501215V#2905F#11P這個啊……{wait}
	} {
		#13501216V#2906F初期的作品好像比最近的作品
		要大一圈，
		幾乎沒在市場上出現過。{wait}
	} {
		#13501217V工匠似乎也
		不打算再做那種尺寸的人偶了，
		所以必然很珍貴……{wait}
	} {
		#13501218V#2900F以前在帝都舉行的拍賣會上，
		聽說還有過以五百萬米拉
		落槌的作品呢。{wait}
	}
	TextWait
	Emote name[0] 0mm 2000mm 2 7 80ms 1
	SoundPlay sound[28] 0 100 0
	Sleep 1000ms
	TextTalk name[0] {
		#13501219V#5111F#6P一、一件人偶值那麼多錢！？{wait}
	}
	TextWait
	TextTalk name[1] {
		#13501220V#5309F#6P嗯，因為是擁有眾多
		熱切愛好者的藝術品嘛……{wait}
	} {
		#13501221V#5300F不過，看你的樣子，
		好像是勢在必得了吧？{wait}
	}
	TextWait
	TextTalk name[55] {
		#13501222V#2904F#11P呵呵，不管來路如何，
		人偶本身是無罪的。{wait}
	} {
		#13501223V#2902F當然了，如果那是贓物，
		我也會採取相應措施的。{wait}
	} {
		#13501224V#2909F但在此之後，我還是打算和
		之前的所有者交涉，將它弄到手。{wait}
	}
	TextWait
	TextTalk name[0] {
		#13501225V#5106F#6P……無話可說了。{wait}
