	else:
		CamSetDistance 0 1200 -23250 0ms
		ED7CamRotate 45deg 30deg 0deg 0ms
		CamPers 420 0ms
		CamZoom 25000 0ms
		CharSetPos name[0] (0, 0, -23250) 0deg
		CharSetPos party[1] (0, 0, -23250) 0deg
		CharSetPos name[4] (0, 0, -23250) 0deg
	FadeIn 500ms 0x00000000
	FadeWait
	EventEnd 5
	Return
