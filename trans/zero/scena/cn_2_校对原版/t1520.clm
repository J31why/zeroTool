fn[8]:
	TextStart self
	if flag[1566]:
	elif flag[1565]:
	elif flag[1554]:
	elif flag[1536]:
	elif flag[1351]:
		if !flag[0]:
			TextTalk self {
				呼……呼……
				早安……{wait}
			}
			TextWait
			Emote self 0mm 2000mm 2 7 80ms 1
			SoundPlay sound[28] 0 100 0
			Sleep 1000ms
			TextTalk self {
				啊，不行！
				今天必須要去
				診察室！{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				夏魯魯早就去
				診察室了吧……{wait}
			}
			TextWait
			TextTalk self {
				哇哇……該怎麼辦啊！？{wait}
			}
			TextWait
	elif flag[1346]:
		EmoteStop self
		if !flag[0]:
			TextTalk self {
				……呼……呼…………{wait}
			}
			TextWait
			TextTalk self {
				……再、再睡五分鐘……呼呼……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				再睡五分鐘……
				不，再睡十五分鐘就起床……
				呼呼……{wait}
			}
			TextWait
		Emote self 0mm 1700mm 28 33 250ms 0
	elif flag[1307]:
	elif flag[1292]:
		EmoteStop self
		TextTalk self {
			……呼……呼……{wait}
		}
		TextWait
		TextTalk self {
			哇……這就是最新式的
			導力鐳射手術刀…………{wait}
		}
		TextWait
		TextTalk self {
			嗯……
			竟然開發了這樣的東西……？{wait}
		}
		TextWait
		Emote self 0mm 1700mm 28 33 250ms 0
	elif flag[1282]:
	elif flag[1280]:
	elif flag[1040]:
	elif flag[1024]:
	elif flag[799]:
	elif flag[793]:
		if !flag[0]:
			TextTalk self {
				……呼呼……{wait}
			}
			TextWait
			Emote self 0mm 2000mm 2 7 80ms 1
			SoundPlay sound[28] 0 100 0
			Sleep 1000ms
			TextTalk self {
				……啊呀，都已經這麼晚了！？{wait}
			}
			TextWait
			TextTalk self {
				不・好・了～啊！
				明明要在傍晚趕到
				診察室去的～！！{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				因為通宵太累導致
				睡得太熟了……{wait}
			}
			TextWait
			TextTalk self {
				不快點過去的話，
				又要被凱瑞教授
				訓斥了！{wait}
			}
			TextWait
	elif flag[787]:
		TextTalk self {
			呼……呼……{wait}
		}
		TextWait
		TextTalk name[0] {
			#0000F……還是別吵醒她比較好吧。{wait}
		}
		TextWait
	elif flag[784]:
		EmoteStop self
		if !flag[0]:
			TextTalk self {
				呼……呼……{wait}
			}
			TextWait
			TextTalk self {
				……哇呀！？
				……爆炸了……！{wait}
			}
			TextWait
			TextTalk self {
				…………呼…………呼……{wait}
			}
			TextWait
			TextTalk name[0] {
				#0006F……到、到底在做什麼夢呢……{wait}
			}
			TextWait
			TextTalk name[53] {
				#1302F亞蘇拉主任
