fn[9]:
	TextStart self
	if flag[1566]:
		if !flag[1]:
			TextTalk self {
				啊，你是昨天被送到
				賽西兒小姐房間裡的……{wait}
			}
			TextWait
			TextTalk name[2] {
				#0203F……讓您擔心了。{wait}
			}
			TextWait
			TextTalk self {
				呼，當時確實很擔心呢。
				不過，你現在看起來倒是挺精神的，這就好。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				要是以後又覺得身體不舒服的話，
				請馬上再過來哦。{wait}
			}
			TextWait
			TextTalk self {
				畢竟這裡是專業的醫院呢。{wait}
			}
			TextWait
	elif flag[1565]:
		TextTalk self {
			哎呀，已經這麼晚了！？{wait}
		}
		TextWait
		TextTalk self {
			啊哇哇，必須快點完成
			今天的打掃工作啊……{wait}
		}
		TextWait
	elif flag[1554]:
		TextTalk self {
			約亞西姆副教授也住在
			這邊的宿舍哦。{wait}
		}
		TextWait
		TextTalk self {
			他早上出門時永遠都是那麼邋遢，
			所以我總是提醒他。{wait}
		}
		TextWait
	elif flag[1536]:
		TextTalk self {
			今天亞蘇拉主任竟然準時
			去研究區了，真是很少見。{wait}
		}
		TextWait
		TextTalk self {
			嗯，平時都是早上才回來睡一會的……
			不知道她昨天休息了沒有。{wait}
		}
		TextWait
	elif flag[1351]:
		TextTalk self {
			小女孩？
			我想沒有來過這邊哦……{wait}
		}
		TextWait
		TextTalk self {
			找過院區了嗎？{wait}
		}
		TextWait
	elif flag[1346]:
		if !flag[1]:
			TextTalk self {
				這個時間，護理師希蓉
				一般都會在屋頂
				曬床單。{wait}
			}
			TextWait
			TextTalk self {
				前幾天還在那邊的露臺上
				悠閒地仰望天空……{wait}
			}
			TextWait
			TextTalk self {
				……我全都看到了呢。
				得讓她多注意一點……{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				該說希蓉是毫無防範意識
				還是什麼呢……{wait}
			}
			TextWait
			TextTalk self {
				總之，必須要對總是喜歡
				往露臺跑的男人
				多加注意。{wait}
			}
			TextWait
	elif flag[1307]:
		if !flag[1]:
			TextTalk char[1] {
				聽說今天亞蘇拉主任
				去參加教授會議了。{wait}
			}
			TextWait
			TextTalk char[1] {
				因為她起得很早，
				所以估計現在這個時候
				也還是睡眼惺忪的吧。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk char[1] {
				亞蘇拉主任是個
				愛睡懶覺的人。{wait}
			}
			TextWait
			TextTalk char[1] {
				不會在教授會議上
				也昏昏沉沉地打瞌睡吧。{wait}
			}
			TextWait
	elif flag[1292]:
		if !flag[1]:
			TextTalk self {
				好安靜啊……
				醫生、實習醫生和護理師，
				大家似乎都出門了。{wait}
			}
			TextWait
			TextTalk self {
				……啊！
				這正是一個把所有角落
				都打掃乾淨的機會呢！{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				呵呵，既然決定了……
				在大家回來之前，
				必須要讓這個地方煥然一新呢！{wait}
			}
			TextWait
			TextTalk self {
				打掃打掃，打掃打掃！{wait}
			}
			TextWait
	elif flag[1282]:
		TextTalk self {
			這裡是女子宿舍，男性禁止進入哦！{wait}
		}
		TextWait
		TextTalk self {
			……開玩笑的。
			因為要去研究區的話，
			就必須經過這個職員宿舍……{wait}
		}
		TextWait
	elif flag[1280]:
		TextTalk self {
			打掃打掃……
			職員宿舍真的很乾淨呢。{wait}
		}
		TextWait
		TextTalk self {
			醫生也是，護理師也是，
			大家都會工作到很晚，
			所以基本上都沒怎麼使用過這裡。{wait}
		}
		TextWait
	elif flag[1040]:
		if !flag[1]:
			TextTalk self {
				利頓醫生剛才
				回房間去休息了。{wait}
			}
			TextWait
			TextTalk self {
				他因為上個月的魔獸事件休假了，
				所以現在約亞西姆醫生就
				推了很多工作給他。{wait}
			}
			TextWait
			TextTalk self {
				但是，能休息時
				就應該儘量休息吧。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				嗯，
				我也差不多該去吃午飯了吧。
				只顧著打掃了，肚子好餓啊。{wait}
			}
			TextWait
	elif flag[1024]:
		TextTalk self {
			剛才，亞蘇拉主任
			慌慌張張就出門了。{wait}
		}
		TextWait
		TextTalk self {
			今天也跟以前一樣，
			好像又睡過頭了呢。{wait}
		}
		TextWait
	elif flag[799]:
		TextTalk self {
			明明已經打掃過一次了，
			結果還是因為在意小污漬，
			所以又打掃了一次。{wait}
		}
		TextWait
		TextTalk self {
			……畢竟是女子宿舍，
			一定要非常非常乾淨才行。{wait}
		}
		TextWait
	elif flag[793]:
		TextTalk self {
			好了，打掃成這樣就沒問題了。
			……應該是吧。{wait}
		}
		TextWait
		TextTalk self {
			但是那些小污漬
			讓我好在意啊……{wait}
		}
		TextWait
	elif flag[784]:
		if !flag[1]:
			TextTalk self {
				今天男子宿舍的人
				全部都出去了哦。{wait}
			}
			TextWait
			TextTalk self {
				大概都去研究區或者
				院區工作了吧。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				好，為了努力工作的大家，
				打掃打掃～☆{wait}
			}
			TextWait
	elif flag[777]:
		TextTalk self {
			打掃打掃……打掃打掃……{wait}
		}
		TextWait
		TextTalk self {
			打～掃～真～開～心～啊☆{wait}
		}
		TextWait
	TextEnd self
	Return

