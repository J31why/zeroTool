fn[9]:
	if flag[1320] && !flag[1321]:
		Event fn[0,41]
	elif flag[1329] && !flag[1330]:
		Event fn[0,42]
	if flag[736]:
		FlagUnset flag[736]
		Event fn[0,44]
	if flag[1333]:
	elif flag[1330]:
		Call fn[0,6]
		CharSetPos char[1] (-3480, 1000, 29970) 135deg
		CharSetPos char[2] (-2430, 1000, 30860) 135deg
		ForkFunc char[2] fork[0] fn[0,0]
	elif flag[1329]:
		CharSetPos char[1] (-3480, 1000, 29970) 135deg
		CharSetPos char[2] (-2430, 1000, 30860) 135deg
		ForkFunc char[2] fork[0] fn[0,0]
	elif flag[1320]:
		CharFlagsUnset char[0] 0x0080
		CharFlagsUnset char[1] 0x0080
		ForkFunc char[1] fork[0] fn[0,2]
		CharFlagsUnset char[2] 0x0080
		ForkFunc char[2] fork[0] fn[0,3]
		CharFlagsUnset char[3] 0x0080
		if flag[1326]:
			CharSetPos char[3] (8250, 4000, 19670) 45deg
			CharFlagsUnset char[4] 0x0080
		else:
			ForkFunc char[3] fork[0] fn[0,4]
	Call fn[0,7]
	Return

fn[10]:
	SoundPlayContinuously sound[124] (-10, 1000, 40830) 10000 100000 100 0
	Return

fn[11]:
	TextStart self
	if flag[1333]:
	elif flag[1330]:
		if !flag[0]:
			CharTurnTo self 135deg 0deg/s
			TextTalk self {
				拍賣品清單……準備完畢。
				木槌……準備完畢。{wait}
			}
			TextWait
			CharTurnToChar self field_party[0] 400deg/s
			TextTalk self {
				哎呀，您要上二樓席位嗎？
				請從這邊的樓梯上去。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				在二樓席位也可以
				正常參加競拍哦，
				請從這邊的樓梯上去。{wait}
			}
			TextWait
	elif flag[1329]:
	elif flag[1320]:
		if !flag[0]:
			TextTalk self {
				哎呀，客人……
				距離拍賣會開始
				還有一點時間哦。{wait}
			}
			TextWait
			TextTalk self {
				會場正在進行準備，
				目前謝絕客人入內，請您諒解。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				距離拍賣會開始
				還有一點時間。{wait}
			}
			TextWait
			TextTalk self {
				在西南大間的沙龍裡
				消磨一下時間如何呢？{wait}
			}
			TextWait
	TextEnd self
	Return

fn[12]:
	TextStart self
	if flag[1333]:
	elif flag[1330]:
		if !flag[1]:
			TextTalk self {
				伊莉莎白真是的，
				似乎很喜歡粘著
				來賓雷克多先生呢。{wait}
			}
			TextWait
			TextTalk self {
				那小傢伙
				平時不太親近人的……
				真是不可思議呢。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				說起來，雷克多先生
				擅自就給伊莉莎白
				起了個『小黑』這樣的名字。{wait}
			}
			TextWait
			TextTalk self {
				要是以後叫牠『伊莉莎白』
				也不聽的話，可該怎麼辦呢……{wait}
			}
			TextWait
	elif flag[1329]:
	elif flag[1320]:
		if !flag[1]:
			TextTalk self {
				老爺養的貓伊莉莎白
				不知道跑到哪裡去了。{wait}
			}
			TextWait
			TextTalk self {
				唔唔……真擔心牠
				會對各位來賓失禮啊。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				二位有沒有見到一隻黑貓？{wait}
			}
			TextWait
			TextTalk self {
				伊莉莎白真是的……
				躲到哪裡去了呢。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[13]:
	TextStart self
	if flag[1333]:
	elif flag[1330]:
		if !flag[1257]:
			Call fn[0,14]
		else:
			TextTalk self {
				臺上也檢查完畢了……
				之後就等拍賣品搬進來了。{wait}
			}
			TextWait
	elif flag[1329]:
	elif flag[1320]:
		TextTalk self {
			很抱歉，客人……
			請不要
			到臺上來。{wait}
		}
		TextWait
		TextTalk self {
			這裡是展示拍賣品的地方，
			為了以防萬一，
			我正在進行嚴格檢查。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[14]:
	TextTalk self {
		臺上的檢查
		終於結束了。{wait}
	}
	TextWait
	TextTalk self {
		在角落裡找到了這本書……
		大概是去年的賓客忘在這裡的吧。{wait}
	}
	TextWait
	TextTalk self {
		那位客人今年
		好像沒來……
