fn[2]:
	ED7_F2 1
	SystemFlagsSet 0x08000000
	FadeOut 300ms 0x00000000 100
	if !flag[2081]:
		SoundPlay sound[14] 0 100 0
		ED7ObjPlay object[0] 0 30 0 0
		Sleep 500ms
		ObjFrame object[0] 30
		SoundPlay sound[17] 0 100 0
		TextSetPos -1 -1 -1 -1
		SepithAdd 4 50
		SepithAdd 5 50
		SepithAdd 6 50
		TextMessage null {
			獲得了{color 2}#60I時之耀晶石×５０{color 0}
			{color 2}#61I空之耀晶石×５０{color 0}
			{color 2}#62I幻之耀晶石×５０{color 0}。{wait}
		}
		TextWait
		TextClose 0
		TextSetPos -1 280 60 3
		FlagSet flag[2081]
		ED7_DE 6
	else:
		TextSetPos -1 -1 -1 -1
		TextSetName ""
		TextMessage name[742] {
			{0x06}{color 5}寶箱內空無一物。{wait}
		}
		TextWait
		TextClose 0
	FadeIn 300ms 0x00000000
	TextEnd null
	SystemFlagsUnset 0x08000000
	Return

fn[3]:
	ED7_F2 1
	SystemFlagsSet 0x08000000
	if !flag[2082]:
		SoundPlay sound[14] 0 100 0
		ED7ObjPlay object[1] 0 30 0 0
		Sleep 500ms
		if ItemAdd item[63] 1:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextSetName ""
			TextMessage name[742] {
				{color 0}已取得{item[63]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			TextSetPos -1 280 60 3
			FadeIn 300ms 0x00000000
			FlagSet flag[2082]
			ED7_DE 6
		else:
			FadeOut 300ms 0x00000000 100
			TextSetName ""
			TextMessage name[742] {
				寶箱內裝著{item[63]}{color 0}。
				但因持有物品已滿而放棄{item[63]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			SoundPlay sound[15] 0 100 0
			ED7ObjPlay object[1] 30 0 0 0
	else:
		FadeOut 300ms 0x00000000 100
		TextSetPos -1 -1 -1 -1
		TextSetName ""
		TextMessage name[742] {
			{0x06}{color 5}寶箱內空無一物。{color 0}{wait}
		}
		TextWait
		TextClose 0
		FadeIn 300ms 0x00000000
	Sleep 30ms
	TextEnd null
	SystemFlagsUnset 0x08000000
	Return

