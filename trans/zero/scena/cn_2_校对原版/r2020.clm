	FadeIn 1000ms 0x00000000
	CamSetDistance 130690 8080 23940 10000ms
	ForkFunc name[0] fork[3] fn[0,9]
	ForkFunc name[1] fork[3] fn[0,10]
	ForkFunc name[2] fork[3] fn[0,11]
	ForkFunc name[3] fork[3] fn[0,12]
	CamWait 1
	FadeWait
	CrossFade 1000ms
	CamZoom 48420 0ms
	FadeWait
