	FadeIn 0ms 0xFFFFFFFF
	ED7_E0 3
	ED7LoadChip "chr/ch00250.itc" chip[30]
	ED7LoadChip "chr/ch00254.itc" chip[31]
	EffLoad eff[0] "battle\\mgaria0.eff"
