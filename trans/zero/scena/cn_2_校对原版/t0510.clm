fn[16]:
	EventBegin 0
	FadeOut 1000ms 0x00000000 255
	FadeWait
	CamSetDistance -70 2450 -3180 0ms
	ED7CamRotate 309deg 28deg 0deg 0ms
	CamPers 260 0ms
	CamZoom 29780 0ms
	CharSetPos name[0] (0, 750, -2700) 0deg
	CharSetPos name[1] (-1300, 750, -2700) 0deg
	CharSetPos name[2] (0, 0, -4000) 0deg
	CharSetPos name[3] (-1300, 0, -4000) 0deg
	if !QuestTaskGet quest[28] 0:
		CharTurnTo char[0] 0deg 0deg/s
	else:
		CharTurnTo char[0] 180deg 0deg/s
	CharSetChipPattern char[0] 0
	Sleep 500ms
	FadeIn 500ms 0x00000000
	FadeWait
	if !QuestTaskGet quest[28] 0:
		TextTalk char[0] {
			#11P嗯……真頭痛啊……{wait}
		}
		TextWait
		TextTalk char[0] {
			#11P再怎麼說，也不能讓礦山長
			一個人前去消滅它們啊……{wait}
		}
		TextWait
		TextTalk name[0] {
			#6P#0000F您好，比克森鎮長。{wait}
		} {
			特務支援課成員已經到達。{wait}
		}
		TextWait
		Emote char[0] 0mm 2000mm 38 38 250ms 1
		Sleep 1000ms
		CharTurnTo char[0] 180deg 500deg/s
		TextTalk char[0] {
			#11P哦哦，是你們……！
			我等你們很久啦。{wait}
		}
		TextWait
		TextTalk name[1] {
			#6P#0100F是您發出了支援請求吧。{wait}
		} {
			聽說礦山裡
			出現了魔獸……{wait}
		}
		TextWait
		TextTalk char[0] {
			#11P嗯……正是如此。{wait}
		}
		TextWait
		TextTalk char[0] {
			#11P其實，在礦山的深處，
			有個已經停止開採的廢坑……{wait}
		}
		TextWait
		TextTalk char[0] {
			#11P每天晚上，
			魔獸都會在裡面折騰，
			讓人很頭痛啊。{wait}
		}
		TextWait
		TextTalk name[0] {
			#6P#0005F礦山裡有魔獸出現嗎……
			這實在是很糟糕啊。{wait}
		} {
			這種事情難道
			很常見嗎？{wait}
		}
		TextWait
		TextTalk name[2] {
			#6P#0203F……七耀石的開採地附近
			會出現大量的魔獸，
			每個國家都有很多類似的報告。{wait}
		} {
			#0200F雖然不知道原因，
			但七耀石好像有種
			吸引魔獸的特性。{wait}
		}
		TextWait
		TextTalk name[3] {
			#6P#0301F這麼說來，
			我好像也聽說過很多次呢。{wait}
		}
		TextWait
		TextTalk name[1] {
			#6P#0105F我也聽說過呢，
			好像無論哪個國家
			的礦山裡都有些危險的東西。{wait}
		}
		TextWait
		TextTalk name[0] {
			#6P#0003F是這樣啊……{wait}
		}
		TextWait
		TextTalk char[0] {
			#11P如果只是礦山裡的魔獸，
			在一般情況下，只靠礦工們
			也能夠驅趕掉。{wait}
		}
		TextWait
		TextTalk char[0] {
			#11P但因為正趕上紀念慶典的假期，
			年輕的礦工們都出鎮了。
			所以事態沒法得到及時應對。{wait}
		}
		TextWait
		TextTalk char[0] {
			#11P雖然廢坑的入口已經封鎖起來了……
			但是，如果再這樣放著不管，
			不知道會發生什麼危險的事情。{wait}
		}
		TextWait
		TextTalk char[0] {
			#11P所以我請你們來，
			想讓你們幫忙消滅魔獸。{wait}
		}
		TextWait
		TextTalk char[0] {
			#11P怎麼樣，
			願意接受嗎？{wait}
		}
		TextWait
		QuestTaskSet quest[28] 0
	else:
		TextTalk char[0] {
			#11P其實，在礦山的深處還有個
			已經停止開採的廢坑……
			魔獸就時常湧現在裡頭。{wait}
		}
		TextWait
		TextTalk char[0] {
			#11P我希望你們
			在紀念慶典結束之前，
			消滅裡面的魔獸。{wait}
		}
		TextWait
		TextTalk char[0] {
			#11P怎麼樣，
			願意接受嗎？{wait}
		}
		TextWait
	var[0] = 0
	Menu menu[0] -1 -1 0
		"【接受】" // 0
		"【拒絕】" // 1
	MenuWait var[0]
	switch var[0]:
		case 0:
			MenuClose menu[0]
			TextTalk name[0] {
				#6P#0000F明白了，
				我們接受
				您的請求。{wait}
			}
			TextWait
			TextTalk char[0] {
				#11P……是嗎，太感謝了。{wait}
			}
			TextWait
			TextTalk char[0] {
				#11P那麼，
				請收下這個吧。{wait}
			}
			TextWait
			FadeOut 300ms 0x00000000 100
			TextSetPos -1 -1 -1 -1
			TextSetName ""
			SoundPlay sound[17] 0 100 0
			TextMessage null {
				收下了{item[838]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			TextSetPos -1 280 60 3
			_59
			ItemAdd item[838] 1
			TextTalk char[0] {
				#11P去廢坑的話，就要找到礦山深處的門，
				再使用這把鑰匙開門就能進去了。{wait}
			}
			TextWait
			TextTalk char[0] {
				#11P那麼，就拜託你們了，
				請務必要小心啊。{wait}
			}
			TextWait
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[80] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextSetName ""
			TextMessage null {
				{color 2}任務【討伐礦山的魔獸】{color 0}開始！{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			TextSetPos -1 280 60 3
			QuestTaskSet quest[28] 1
			FlagSet flag[8]
			break
		case 1:
			MenuClose menu[0]
			TextTalk name[0] {
				#6P#0006F對不起……
				我們不能馬上接受。{wait}
			}
			TextWait
			TextTalk char[0] {
				#11P嗯，這樣啊……{wait}
			}
			TextWait
			TextTalk char[0] {
				#11P礦山暫時還是安全的，
				但如果再放著不管，恐怕就控制不住事態了。{wait}
			}
			TextWait
			TextTalk char[0] {
				#11P等你們有空接受的時候，
				再麻煩你們吧。{wait}
			}
			TextWait
			break
		default:
			var[0] = 255
			break
	var[0] = 0
	FadeOut 1000ms 0x00000000 255
	FadeWait
	CharFlagsUnset char[0] 0x0010
	CharSetPos field_party[0] (-610, 750, -2790) 0deg
	Sleep 500ms
	EventEnd 5
	Return

fn[17]:
	EventBegin 0
	FadeOut 1000ms 0x00000000 255
	FadeWait
	CamSetDistance -70 2450 -3180 0ms
	ED7CamRotate 309deg 28deg 0deg 0ms
	CamPers 260 0ms
