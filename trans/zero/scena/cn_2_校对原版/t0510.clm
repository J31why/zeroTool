	TextWait
	TextTalk char[0] {
		#14100539V#5P哈哈，就算只是客套話，
		正派這個詞也都有點誇張呢……{wait}
	}
	TextWait
	TextTalk char[0] {
		#14100540V#5P總之，他的技術很差，屬於那種
		一直輸卻又一直堅持的類型。{wait}
	}
	TextWait
	TextTalk char[0] {
		#14100541V#5P而且，他既沒有好運，也沒有敏銳的直覺，
		每次都會把身上的米拉全部輸光，
		然後才垂頭喪氣地回來。{wait}
	}
	TextWait
	TextTalk name[0] {
		#14100542V#0012F#12P原、原來是這樣……{wait}
	}
	TextWait
	TextTalk name[3] {
		#14100543V#0303F#11P的確，抽獎倒是有可能抽中大獎。
		但賭博的話，如果沒有實力，
		是很難有很大斬獲的。{wait}
	}
	TextWait
	TextTalk name[2] {
		#14100544V#0211F#6P那麼，會不會是在市裡借了債，
		然後又還不上，所以自己躲起來玩失蹤呢……{wait}
	}
	TextWait
	TextTalk name[1] {
		#14100545V#0106F#12P有、有道理……
		的確有這種可能性呢。{wait}
	}
	TextWait
	TextTalk char[0] {
		#14100546V#5P……其實我們也
		有這樣懷疑過。{wait}
	}
	TextWait
	TextTalk char[2] {
		#14100547V#11P如果真是這樣，
		要怎樣才能聯繫上他呢……{wait}
	}
	TextWait
	Emote name[0] 0mm 1700mm 24 27 250ms 0
	Sleep 1500ms
	EmoteStop name[0]
	TextTalk name[0] {
		#14100548V#0004F#12P──我明白了，
		這件事情就交給我們吧。{wait}
	} {
		#14100549V#0000F總之，從賭場開始，
		到岡茲先生可能會去的地方
		打聽一下他的消息吧。{wait}
	}
	TextWait
	TextTalk char[0] {
		#14100550V#5P謝謝你們……
		萬事拜託了。{wait}
	}
	TextWait
	TextTalk char[0] {
		#14100551V#5P如果有什麼消息，
		請馬上聯絡我啊。{wait}
	}
	TextWait
	TextTalk name[0] {
		#14100552V#0000F#12P嗯，那麼，
		請把您的通訊號碼告訴我吧……{wait}
	}
	TextWait
	FadeOut 1000ms 0x00000000 255
	FadeWait
	CharFlagsUnset name[0] 0x0004
	CharSetChipBase name[0] chip[255]
	CharSetChipPattern name[0] 0
	CharFlagsUnset name[1] 0x0004
	CharSetChipBase name[1] chip[255]
