	CharSetPos name[1] (-1300, 750, -2700) 0deg
	CharSetPos name[2] (0, 0, -4000) 0deg
	CharSetPos name[3] (-1300, 0, -4000) 0deg
	_Char4A char[0] 255
	Sleep 500ms
	FadeIn 500ms 0x00000000
	FadeWait
	TextTalk char[0] {
		#11P嗯，你們好像已經把
		魔獸全部消滅了吧。{wait}
	}
	TextWait
	TextTalk name[0] {
		#6P#0000F嗯，已經確認過了，全部殲滅。{wait}
	}
	TextWait
	TextTalk name[2] {
		#6P#0200F短時間內，魔獸應該
		不會再出現了。{wait}
	} {
		至少在紀念慶典結束，
		礦工們回來之前的這段時間裡，
		安全性還是能夠保證的。{wait}
	}
	TextWait
	TextTalk char[0] {
		#11P哦哦，這樣啊……
		真不知道該如何感謝你們。{wait}
	}
	TextWait
	TextTalk char[0] {
		#11P……對了，
		不介意的話，
		請收下這些吧。{wait}
	}
	TextWait
	SepithAdd 0 200
	SepithAdd 1 200
	SepithAdd 2 200
	SepithAdd 3 200
	SepithAdd 4 200
	SepithAdd 5 200
	SepithAdd 6 200
	SoundPlay sound[17] 0 100 0
	FadeOut 300ms 0x00000000 100
	TextSetPos -1 -1 -1 -1
	TextMessage null {
		獲得了{color 2}#56I地之耀晶石×２００{color 0}
		{color 2}#57I水之耀晶石×２００{color 0}
		{color 2}#58I火之耀晶石×２００{color 0}
		{color 2}#59I風之耀晶石×２００{color 0}
		{color 2}#60I時之耀晶石×２００{color 0}
		{color 2}#61I空之耀晶石×２００{color 0}
		{color 2}#62I幻之耀晶石×２００{color 0}。{wait}
	}
	TextWait
	TextClose 0
	FadeIn 300ms 0x00000000
	TextSetPos -1 280 60 3
	_59
	Emote field_party[0] 0mm 2000mm 38 38 250ms 1
	Emote field_party[1] 0mm 2000mm 38 38 250ms 1
	Emote field_party[2] 0mm 2000mm 38 38 250ms 1
	Emote field_party[3] 0mm 2000mm 38 38 250ms 1
	Sleep 1000ms
	TextTalk name[2] {
		#6P#0205F給我們這麼多耀晶石……？{wait}
	}
	TextWait
	TextTalk name[3] {
		#6P#0309F哇，真的可以
		收下嗎？{wait}
	}
	TextWait
	TextTalk name[0] {
		#6P#0011F當、當然不能收吧！？{wait}
	} {
		#0003F鎮長，
		我們和遊擊士不同，
		不能直接收取報酬。{wait}
	}
	TextWait
	TextTalk name[1] {
		#6P#0105F而且，這些耀晶石
		都是在這裡開採出來的
		貴重商品吧？{wait}
	}
	TextWait
	TextTalk char[0] {
		#11P別介意，沒問題的。{wait}
	}
	TextWait
	TextTalk char[0] {
		#11P耀晶石是七耀石的碎片……
		換句話說，只是在開採時
		順便挖出來的副產品而已。{wait}
	}
	TextWait
	TextTalk char[0] {
		#11P如果是政府嚴格規定交易量的
		七耀石，自然不能這麼隨便就給你們，
		但只是耀晶石的話，就完全沒有問題了。{wait}
	}
	TextWait
	TextTalk char[0] {
		#11P而且，只能把這些多餘的
		東西送給你們，
		我才應該說聲抱歉呢。{wait}
	}
	TextWait
	TextTalk name[0] {
		#6P#0005F哪、哪裡的話……{wait}
	}
	TextWait
	TextTalk char[0] {
		#11P呵呵……都已經
		麻煩過你們好多次了。{wait}
	}
	TextWait
	TextTalk char[0] {
		#11P就當作是我個人的謝禮，
		請不必客氣，收下吧。{wait}
	}
	TextWait
	Emote name[0] 0mm 2000mm 24 27 250ms 0
	Sleep 1000ms
	EmoteStop name[0]
	TextTalk name[0] {
		#6P#0003F……我明白了。
		這樣的話……
		我們就心懷感激地收下了。{wait}
	}
	TextWait
	TextTalk char[0] {
		#11P嗯。{wait}
	}
	TextWait
	TextTalk char[0] {
		#11P那麼，這次的事情，
		我要再次向你們表示感謝。{wait}
	}
	TextWait
	TextTalk char[0] {
		#11P如果以後又有什麼事情，還要再麻煩你們啊。{wait}
	}
	TextWait
	FadeOut 300ms 0x00000000 100
	SoundPlay sound[9] 0 100 0
	TextSetPos -1 -1 -1 -1
	TextSetName ""
	TextMessage null {
		{color 2}任務【討伐礦山的魔獸】{color 0}完成！{wait}
	}
	TextWait
	TextClose 0
	FadeIn 300ms 0x00000000
	TextSetPos -1 280 60 3
	FadeOut 1000ms 0x00000000 255
	FadeWait
	QuestFlagsSet quest[28] 0x10
	FlagSet flag[8]
	_Char4B char[0] 255
	CharSetPos field_party[0] (-610, 750, -2790) 0deg
	Sleep 500ms
	EventEnd 5
	Return
