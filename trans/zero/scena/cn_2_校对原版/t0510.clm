fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if flag[1566]:
		CharFlagsSet char[1] 0x0080
		CharFlagsUnset char[3] 0x0080
		CharFlagsSet char[2] 0x0080
	elif flag[1554]:
		CharFlagsSet char[1] 0x0080
	elif flag[1547]:
	elif flag[1544]:
	elif flag[1536]:
		CharFlagsUnset char[3] 0x0080
		CharFlagsSet char[2] 0x0080
	elif flag[1307]:
		CharFlagsUnset char[10] 0x0080
		CharFlagsUnset char[6] 0x0080
		if QuestFlagsGet quest[28] 0x02 && !QuestTaskGet quest[28] 1:
			CharFlagsSet char[1] 0x0080
			CharFlagsUnset char[0] 0x0080
			if QuestTaskGet quest[28] 0:
				CharSetPos char[0] (-1010, 750, -630) 180deg
			else:
				CharSetPos char[0] (-1010, 750, -630) 0deg
				CharFlagsSet char[0] 0x0010
	elif flag[1292]:
		CharFlagsUnset char[10] 0x0080
		CharFlagsUnset char[6] 0x0080
		if QuestFlagsGet quest[28] 0x02 && !QuestTaskGet quest[28] 1:
			CharFlagsSet char[1] 0x0080
			CharFlagsUnset char[0] 0x0080
			if QuestTaskGet quest[28] 0:
				CharSetPos char[0] (-1010, 750, -630) 180deg
			else:
				CharSetPos char[0] (-1010, 750, -630) 0deg
				CharFlagsSet char[0] 0x0010
	elif flag[1282]:
		CharFlagsUnset char[10] 0x0080
		CharFlagsUnset char[6] 0x0080
		if QuestFlagsGet quest[28] 0x02 && !QuestTaskGet quest[28] 1:
			CharFlagsSet char[1] 0x0080
			CharFlagsUnset char[0] 0x0080
			if QuestTaskGet quest[28] 0:
				CharSetPos char[0] (-1010, 750, -630) 180deg
			else:
				CharSetPos char[0] (-1010, 750, -630) 0deg
				CharFlagsSet char[0] 0x0010
	elif flag[1280]:
		CharFlagsUnset char[10] 0x0080
		CharFlagsUnset char[6] 0x0080
	elif flag[1040]:
	elif flag[1024]:
	elif flag[813]:
	elif flag[812]:
		CharFlagsUnset char[5] 0x0080
	elif flag[801]:
		if !flag[810]:
			CharFlagsUnset char[4] 0x0080
		CharFlagsUnset char[5] 0x0080
	if system[0] == 100 && flag[811] && !flag[812]:
		CharFlagsUnset char[0] 0x0080
		CharFlagsSet char[1] 0x0080
		SystemFlagsSet 0x10000000
		Event fn[0,14]
	elif system[0] == 100 && flag[1545] && !flag[1546]:
		CharFlagsUnset char[0] 0x0080
		CharFlagsSet char[1] 0x0080
		SystemFlagsSet 0x10000000
		Event fn[0,15]
	if QuestTaskGet quest[28] 4 && !QuestFlagsGet quest[28] 0x10:
		Event fn[0,17]
	Return

fn[2]:
	char[5].51 = 1200
	if flag[812] && !flag[1024]:
		MapColor 0x00C8D2FF 0ms
	elif flag[1547] && !flag[1548]:
		MapColor 0x00C8D2FF 0ms
	Return

fn[3]:
	TextStart self
	if QuestFlagsGet quest[28] 0x10 && flag[8]:
		TextTalk char[0] {
			你們竟然敢闖進這麼危險的廢坑啊。{wait}
		}
		TextWait
		TextTalk char[0] {
			這次可真是多虧了你們，
			以後還請繼續關照啊。{wait}
		}
		TextWait
	elif QuestTaskGet quest[28] 1 && flag[8]:
		TextTalk char[0] {
			去廢坑的話，就要找到礦山深處的門，
			再使用這把鑰匙開門就能進去了。{wait}
		}
		TextWait
		TextTalk char[0] {
			消滅魔獸的事情就拜託你們啦，
			一定要當心啊。{wait}
		}
		TextWait
	else:
		Call fn[0,16]
	TextEnd self
	Return

fn[4]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if flag[1566]:
	elif flag[1544]:
		TextTalk self {
			岡茲的事情
			就拜託你們了。{wait}
		}
		TextWait
		TextTalk self {
			如果有什麼消息，請馬上聯絡我。{wait}
		}
		TextWait
	elif flag[1536]:
		CharSetChipPattern char[1] 1
		TextTalk self {
			都已經過去兩週了……{wait}
		}
		TextWait
		TextTalk self {
			但願他沒有被捲入到
			什麼糾紛事件中啊……{wait}
		}
		TextWait
		TextTalk self {
			一想到他那玩牌的嗜好，
			就讓人很擔心啊。{wait}
		}
		TextWait
		CharSetChipPattern char[1] 0
	elif flag[1307]:
		if !flag[0]:
			TextTalk self {
				昨天，帝國的商人弗裡吉亞
				又來找我交涉，讓我把
				七耀石的結晶轉讓給她。{wait}
			}
			TextWait
			TextTalk self {
				她從很久以前就一直向我提議了，
				我最後還是抵擋不住她的誠意，賣給了她。{wait}
			}
			TextWait
			TextTalk self {
				哎，她實在是太鍥而不捨了……
				真不愧是大商人的女兒啊。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				弗裡吉亞真是個
				非常有意思的商人呢。{wait}
			}
			TextWait
			TextTalk self {
				哎，她實在是太鍥而不捨了……
				真不愧是大商人的女兒啊。{wait}
			}
			TextWait
	elif flag[1292]:
		TextTalk self {
			已經和弗裡吉亞約好了，
			她今天晚上就會過來，
			和我交易七耀石。{wait}
		}
		TextWait
		TextTalk self {
			她看上去是一個
			非常有熱情的商人……{wait}
		}
		TextWait
		TextTalk self {
			看今天的談判情況再做決定吧，
			轉讓給她也沒什麼不好的。{wait}
		}
		TextWait
	elif flag[1282]:
		TextTalk self {
			在這鎮子裡，好像
			總會有零星的遊客前來觀光。{wait}
		}
		TextWait
		TextTalk self {
			我一定得提醒他們注意，
			不要進入礦山啊。{wait}
		}
		TextWait
	elif flag[1280]:
		if !flag[0]:
			TextTalk self {
				為了慶祝紀念慶典的首日，
				我們昨天舉辦了宴會。{wait}
			}
			TextWait
			TextTalk self {
				呵呵，年輕礦工們的豪放吃相
				可真是壯觀。{wait}
			}
			TextWait
			TextTalk self {
				看來大家都很盡興呢，
				可以說，這次的活動辦得很成功啊。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				年輕的礦工們
				好像都去
				克洛斯貝爾市玩了。{wait}
			}
			TextWait
			TextTalk self {
				大家平時都很辛苦，
				希望今天能盡情享受一下。{wait}
			}
			TextWait
	elif flag[1040]:
		if !flag[0]:
			TextTalk self {
				最近在鎮上做交易的商人
				……是叫弗裡吉亞吧。{wait}
			}
			TextWait
			TextTalk self {
				雖然我被她的執著和誠意折服，
				不過身為一個商人，她還差得遠啊。{wait}
			}
			TextWait
			TextTalk self {
				看樣子，她好像是
				看上了七耀石的結晶……
				嗯，到底該怎麼做呢。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				弗裡吉亞好像要在這裡
				待上很長一段時間呢……{wait}
			}
			TextWait
			TextTalk self {
				明明是個年輕女孩，
				但出手好像相當闊綽。
				就這點來說，真不愧是經商之人啊。{wait}
			}
			TextWait
	elif flag[1024]:
		if !flag[0]:
			TextTalk self {
				『特務支援課』的各位……
				這次的事件，真是多虧了你們的幫助。{wait}
			}
			TextWait
			TextTalk self {
				沒想到，這一連串的事件
				竟然都是有人在背後操控的啊。{wait}
			}
			TextWait
			TextTalk self {
				真危險，差點就中了
				黑手黨的奸計了。{wait}
			}
			TextWait
			TextTalk self {
				真是非常感謝
				你們的幫忙。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				因魔獸侵害而延遲的開採計畫，
				應該很快就能趕上進度的。{wait}
			}
			TextWait
			TextTalk self {
				雖然有些對不住礦工們，
				但最近這段時間只能再辛苦一點了。{wait}
			}
			TextWait
	elif flag[813]:
	elif flag[812]:
		if !flag[0]:
			TextTalk self {
				……警備隊實在是不可靠，
				可又不忍心找繁忙的
				遊擊士來擔任警備。{wait}
			}
			TextWait
			TextTalk self {
				而剛才的那幫傢伙就更不必說了，
				實在是不想和他們扯上關係。{wait}
			}
			TextWait
			TextTalk self {
				嗯……我就姑且相信你們所說的
				『能解決這件事』吧。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				『特務支援課』嗎……
				雖然這名字很陌生……{wait}
			}
			TextWait
			TextTalk self {
				嗯……我就姑且相信你們所說的
				『能解決這件事』吧。{wait}
			}
			TextWait
	elif flag[801]:
	CharSetChipPattern self 0
	TextEnd self
	Return

fn[5]:
	TextStart self
	if QuestFlagsGet quest[28] 0x10 && flag[8]:
		TextTalk self {
			多虧了你們啊，
			實在是幫了大忙。{wait}
		}
		TextWait
		TextTalk self {
			真的太感謝了。{wait}
		}
		TextWait
		TextEnd self
		Return
	elif QuestTaskGet quest[28] 1 && flag[8]:
		TextTalk self {
			由於常年進行
			開採工作，
			廢坑通得非常深。{wait}
		}
		TextWait
		TextTalk self {
			請務必小心，
			不要受傷哦。{wait}
		}
		TextWait
		TextEnd self
		Return
	if flag[1566]:
	elif flag[1554]:
		if !flag[1]:
			TextTalk self {
				比克森為了去找岡茲，
				到克洛斯貝爾去了。{wait}
			}
			TextWait
			TextTalk self {
				……總覺得岡茲的事情
				有些奇怪呢。{wait}
			}
			TextWait
			TextTalk self {
				到底發生了什麼事呢……？{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				……總之，知道岡茲沒事，
				我也就鬆口氣了。{wait}
			}
			TextWait
			TextTalk self {
				我把情況告訴給了鎮上的人，
				大家也都安心了。{wait}
			}
			TextWait
	elif flag[1544]:
		TextTalk self {
			雖然不知道他遇到了什麼事，
			但請務必儘早找到他。{wait}
		}
		TextWait
		TextTalk self {
			其他礦工們
			也都十分擔心呢……{wait}
		}
		TextWait
	elif flag[1536]:
	elif flag[1307]:
		if !flag[1]:
			TextTalk self {
				雖然我聽說弗裡吉亞是
				帝國人後，就有點
				退縮了……{wait}
			}
			TextWait
			TextTalk self {
				不過，她是一個比我想像中
				要溫和很多的好女孩。{wait}
			}
			TextWait
			TextTalk self {
				一說到帝國，總給人一種
				軍人般的威嚴印象……
				但說不定，這種溫和的人也意外地有很多呢。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				說到帝國，給人的第一印象
				就是那種軍人般的威嚴感……
				不過，說不定溫和的人也不少呢。{wait}
			}
			TextWait
			TextTalk self {
				我以前總帶著有色眼鏡去看別人，
				真是感到有些慚愧啊。{wait}
			}
			TextWait
	elif flag[1292]:
		TextTalk self {
			我丈夫也
			支持著各位哦。{wait}
		}
		TextWait
		TextTalk self {
			他一定很欣賞你們這種
			努力拼搏的年輕人吧。{wait}
		}
		TextWait
	elif flag[1282]:
		TextTalk self {
			往年，來鎮上觀光的人
			從來都沒有這麼多過……{wait}
		}
		TextWait
		TextTalk self {
			因為是自治州創立７０周年，
			所以才會有很多人來參觀吧。{wait}
		}
		TextWait
	elif flag[1280]:
		TextTalk self {
			我丈夫每天都要
			制定開採計畫，
			絕對不比礦工們輕鬆……{wait}
		}
		TextWait
		TextTalk self {
			所以至少在這個紀念慶典，
			要好好犒勞一下他。{wait}
		}
		TextWait
	elif flag[1040]:
		if !flag[1]:
			TextTalk self {
				因為土地的關係，
				這個地區實在是難以生產什麼食材。{wait}
			}
			TextWait
			TextTalk self {
				總要頻繁乘坐導力巴士，去外面採購，
				真的很麻煩啊……
				不過，現在就不必那麼辛苦了。{wait}
			}
			TextWait
			TextTalk self {
				因為有個名叫哈羅德・海瓦茲的
				克洛斯貝爾市的貿易商，
				總會定期來販賣一些農作物。{wait}
			}
			TextWait
			TextTalk self {
				特地從阿爾摩利卡村
				送來那麼美味的農作物，
				實在是幫了大忙呢。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				哈羅德先生對自治州各地的
				商品需求瞭若指掌。{wait}
			}
			TextWait
			TextTalk self {
				作為克洛斯貝爾的商人，
				非常值得信賴，讓人對他很有好感。{wait}
			}
			TextWait
	elif flag[1024]:
		TextTalk self {
			我的丈夫和礦山的負責人──
			霍夫曼礦山長一起，
			制定著每天的開採計畫。{wait}
		}
		TextWait
		TextTalk self {
			因為必須注意開採量
			一定不能超過
			政府所規定的上限。{wait}
		}
		TextWait
	elif flag[813]:
	elif flag[812]:
		if !flag[1]:
			TextTalk self {
