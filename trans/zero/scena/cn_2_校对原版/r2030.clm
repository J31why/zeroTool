fn[0]:
	while 1:
		ED7CharAnimation self 1500ms 0 1 2 3 4 3 2 1
	Return

fn[1]:
	while 1:
		ED7CharAnimation self 1000ms 0 1 2 3 4 5
	Return

fn[2]:
	if flag[1280]:
	elif flag[1040]:
		CharFlagsUnset char[0] 0x0080
		CharFlagsUnset char[1] 0x0080
		CharFlagsSet char[11] 0x0080
		CharFlags2Set char[11] 0x8000
	elif flag[1024]:
		CharFlagsUnset char[0] 0x0080
		CharFlagsSet char[11] 0x0080
		CharFlags2Set char[11] 0x8000
	elif flag[801]:
	if flag[736]:
		FlagUnset flag[736]
		Event fn[0,17]
	if flag[1008]:
		FlagUnset flag[1008]
		Event fn[0,11]
	Call fn[0,7]
	Return

fn[3]:
	TriggerFlagsSet trigger[0] 0x0080
	if flag[803] && !flag[804]:
		TriggerFlagsUnset trigger[0] 0x0080
	LookPointFlagsSet look_point[5] 0x0001
	if flag[1342]:
	elif flag[1280]:
		if QuestFlagsGet quest[24] 0x10:
		elif QuestTaskGet quest[24] 6:
		elif QuestTaskGet quest[24] 1:
			LookPointFlagsUnset look_point[5] 0x0001
	if !flag[2083]:
		ObjFrame object[0] 0
	else:
		ObjFrame object[0] 30
	LookPointFlagsSet look_point[3] 0x0001
	LookPointFlagsSet look_point[4] 0x0001
	if flag[981]:
		EffLoad eff[9] "event\\eva00_00.eff"
		EffPlay eff[9] eff_instance[9] null 0 (-32950, 0, 55220) 0 0 0 1000 1000 1000 null (0, 0, 0) 0ms
		LookPointFlagsUnset look_point[3] 0x0001
	elif flag[982]:
		EffLoad eff[9] "event\\eva00_00.eff"
		EffPlay eff[9] eff_instance[9] null 0 (-66470, 0, 184850) 0 0 0 1000 1000 1000 null (0, 0, 0) 0ms
		LookPointFlagsUnset look_point[4] 0x0001
	TriggerFlagsSet trigger[1] 0x0080
	if flag[801] && !flag[805]:
		TriggerFlagsUnset trigger[1] 0x0080
	EffLoad eff[8] "eff\\mgm03_02.eff"
	EffPlay eff[8] eff_instance[8] null 0 (-53600, -3000, 160500) 0 0 0 1000 1000 1000 null (0, 0, 0) 0ms
	SoundPlayContinuously sound[122] (-54240, 0, 198780) 10000 80000 100 0
	ED7_E1 (-21060, 0, 134740)
	if !flag[805]:
		ZeroMap_3 1 1
	Return

fn[4]:
	FlagSet flag[920]
	if !flag[915]:
		TextStart null
		SystemFlagsSet 0x08000000
		TextSetName ""
		TextMessage null {
			{color 5}從寶箱中感覺到了高級魔獸的氣息。
			【推定魔獸等級３５】
			要打開寶箱嗎？{wait}
		}
		Menu menu[0] -1 -1 1
			"是" // 0
			"否" // 1
		MenuWait var[0]
		MenuClose menu[0]
		TextClose 0
		_59
		if var[0] != 0:
			SystemFlagsUnset 0x08000000
			TextEnd null
			Return
	SystemFlagsSet 0x08000000
	if !flag[2083]:
		SoundPlay sound[14] 0 100 0
		ED7ObjPlay object[0] 0 30 0 0
		Sleep 500ms
		if !flag[915]:
			CharColor char[2] 0x00FFFFFF 0ms
			CharTurnToChar char[2] field_party[0] 0deg/s
			_Char91 char[2] 0 1000 0 0 0
			Fork char[2] fork[1]:
				_Char91 self 0 -1000 0 1000 0
			Fork char[2] fork[2]:
				CharColor self 0xFFFFFFFF 1000ms
			CharFlagsUnset char[2] 0x0080
			CharFlagsSet char[2] 0x8000
			TextMessage name[742] {
				{color 5}魔獸出現了！{color 0}{wait}
			}
			TextWait
			TextClose 0
			ForkWait char[2] fork[1]
			ED7Battle battle[6] null 0 0 0 null
			CharFlagsSet char[2] 0x0080
			CharFlagsUnset char[2] 0x8000
			switch system[3]:
				case 0:
					FlagSet flag[915]
					ObjFrame object[0] 30
					Sleep 500ms
					break
				case 2:
					ObjFrame object[0] 0
					TextEnd null
					SystemFlagsUnset 0x08000000
					Return
				case 1:
					ReturnToTitle 0
					Return
		if ItemAdd item[162] 1:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextMessage name[742] {
				{color 0}已取得{item[162]}{color 0}。{wait}
			}
