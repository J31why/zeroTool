	FadeWait
	TextTalk name[2] {
		#6P#0205F……不管看多少次，也都覺得很壯觀呢。
		竟然能在這麼近的地方觀賞瀑布……{wait}
	}
	TextWait
	TextTalk name[1] {
		#12P#0100F嗯，這麼壯觀的瀑布，
		在國外也很少見呢。{wait}
	}
	TextWait
	TextTalk name[0] {
		#6P#0000F怎麼說呢，只要看著它，
		就感覺心情好像平靜下來了。{wait}
	} {
		#0004F心靈受到洗滌，
		說的大概就是
		這種感覺吧……{wait}
	}
	TextWait
	TextTalk name[3] {
		#12P#0304F噢噢，這樣的話，
		要不要來個瀑布修行呢？{wait}
	} {
		#0309F穿條兜襠布，盤坐在瀑布之下，
		說不定會突然開竅，領悟出什麼呢。{wait}
	}
	TextWait
	TextTalk name[0] {
		#6P#0006F……好像很危險，還是算了吧。{wait}
	}
	TextWait
	TextTalk name[2] {
		#6P#0211F……在那之前，實在是太丟臉了，
		請不要讓人想像到那種場景。{wait}
	}
	TextWait
	TextTalk name[3] {
		#12P#0309F哈哈哈，不要害羞嘛。{wait}
	}
	TextWait
	TextTalk name[0] {
		#6P#0000F這個暫且不提……
		格蕾絲小姐委託我們拍攝的照片，
		在這裡似乎能拍到很不錯的呢。{wait}
	}
	TextWait
	if !QuestTaskGet quest[24] 2 && !QuestTaskGet quest[24] 3 && !QuestTaskGet quest[24] 4 && !QuestTaskGet quest[24] 5 && !QuestTaskGet quest[24] 6 && !QuestTaskGet quest[24] 7 && !QuestTaskGet quest[24] 8 && !QuestTaskGet quest[24] 9 && !QuestTaskGet quest[24] 10:
		CharTurnToChar name[0] name[1] 500deg/s
		TextTalk name[0] {
			#6P#0000F那麼艾莉，
			可以拜託你來拍照嗎？{wait}
		}
		TextWait
		CharTurnToChar name[1] name[0] 500deg/s
		TextTalk name[1] {
			#12P#0108F哎，好的。
			雖然我沒什麼自信……{wait}
		}
		TextWait
		CharTurnToChar name[3] name[1] 500deg/s
		TextTalk name[3] {
			#12P#0300F哪裡哪裡，應該沒問題吧。{wait}
		} {
			只要看看鏡頭，
			然後哢嚓一下拍下來
			不就搞定了嘛。{wait}
		}
		TextWait
		CharTurnToChar name[1] name[3] 500deg/s
		TextTalk name[1] {
			#12P#0103F我說你啊……
			要拍出好照片，
			可沒有那麼簡單哦。{wait}
		} {
			#0100F要注意確認
			拍攝對象有沒有被收入取景框中，
			還要構思攝影角度……{wait}
		} {
			而且受到天氣和風的影響，
			照片所呈現出的感覺也會有很大不同。{wait}
		} {
			有時只要錯過那一瞬的時機，
			就再也拍不到
			那麼好的風景了。{wait}
		}
		TextWait
		TextTalk name[2] {
			#6P#0200F外行和專家所拍出的照片，
			差別可是一目了然的。{wait}
		} {
			#0203F不過，某些粗神經的人
			大概無法理解這種細緻的工作吧。{wait}
		}
		TextWait
		CharTurnToChar name[3] name[2] 500deg/s
		TextTalk name[3] {
			#12P#0306F唔……
			你在說誰啊，說誰啊。{wait}
		}
		TextWait
		TextTalk name[0] {
			#6P#0000F好啦好啦，
			總之就交給艾莉吧。{wait}
		}
		TextWait
		TextTalk name[1] {
			#12P#0100F那麼……
			我來試試看吧。{wait}
		}
		TextWait
		_59
		CharTurnTo name[1] 90deg 500deg/s
		CharTurnTo name[0] 90deg 500deg/s
		CharTurnTo name[2] 90deg 500deg/s
		CharTurnTo name[3] 90deg 500deg/s
