		EffPlay eff[0] eff_instance[255] name[1] 192 (0, 1200, 400) 0 0 0 1000 1000 1000 null (0, 0, 0) 0ms
		Sleep 1000ms
		SoundPlay sound[817] 0 100 0
		EffPlay eff[0] eff_instance[255] name[1] 192 (0, 1200, 400) 0 0 0 1000 1000 1000 null (0, 0, 0) 0ms
		Sleep 1000ms
		SoundPlay sound[817] 0 100 0
		EffPlay eff[0] eff_instance[255] name[1] 192 (0, 1200, 400) 0 0 0 1000 1000 1000 null (0, 0, 0) 0ms
		Sleep 1000ms
		TextTalk name[1] {
			#12P#0103F……呼，
			為了保險起見，我多拍了幾張。{wait}
		}
		TextWait
		TextTalk name[0] {
			#6P#0000F看樣子，似乎已經拍好了呢。{wait}
		} {
			感覺怎麼樣啊？{wait}
		}
		TextWait
		TextTalk name[1] {
			#12P#0100F在沒有實際顯像出來之前，
			還無法確定……{wait}
		} {
			不過，我覺得至少
			不會很差吧。{wait}
		}
		TextWait
		TextTalk name[2] {
			#6P#0200F艾莉前輩似乎
			找回感覺了呢。{wait}
		}
		TextWait
		TextTalk name[3] {
			#12P#0300F哼……
			反正只有我完全搞不懂。{wait}
		}
		TextWait
		TextTalk name[0] {
			#6P#0000F如果發現了這種風景漂亮的地方，
