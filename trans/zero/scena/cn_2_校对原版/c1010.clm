fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if flag[1792]:
	elif flag[1566]:
	elif flag[1560]:
		CharFlagsUnset char[2] 0x0080
	elif flag[1554]:
		CharFlagsUnset char[1] 0x0080
		CharFlagsUnset char[4] 0x0080
		CharFlagsUnset char[6] 0x0080
		CharFlagsUnset char[8] 0x0080
		CharFlagsUnset char[9] 0x0080
		CharFlagsUnset char[10] 0x0080
		CharFlagsUnset char[11] 0x0080
		CharSetPos char[9] (-6640, 0, 51900) 90deg
		CharFlagsSet char[9] 0x0010
		if !flag[1658]:
			CharFlagsSet char[0] 0x0010
	elif flag[1536]:
	elif flag[1342]:
		CharFlagsUnset char[4] 0x0080
		CharFlagsUnset char[6] 0x0080
		CharSetPos char[4] (-8400, 150, 49200) 180deg
		CharSetPos char[6] (-10700, 150, 49200) 180deg
	elif flag[1055]:
		CharFlagsUnset char[7] 0x0080
		CharFlagsUnset char[9] 0x0080
		CharSetPos char[7] (2220, 0, 4610) 90deg
		CharSetPos char[9] (3840, 0, 4540) 270deg
	elif flag[1040]:
		CharFlagsUnset char[9] 0x0080
		CharSetChipBase char[9] chip[13]
		CharSetChipPattern char[9] 0
		ForkQuit char[9] fork[0]
		CharFlagsSet char[9] 0x0004
		CharFlagsSet char[9] 0x0010
		CharSetPos char[9] (-6030, 0, 46890) 0deg
		CharFlagsSet char[9] 0x0010
		CharFlagsUnset char[8] 0x0080
		CharSetPos char[8] (-5960, 150, 49360) 180deg
	elif flag[1031]:
		CharFlagsUnset char[1] 0x0080
		CharSetPos char[1] (600, 0, 39580) 90deg
		CharFlagsSet char[1] 0x0010
	elif flag[1024]:
		CharFlagsUnset char[2] 0x0080
	elif flag[801]:
		CharFlagsUnset char[3] 0x0080
		CharFlagsUnset char[5] 0x0080
		if flag[874]:
			CharFlagsSet char[0] 0x0010
	elif flag[777]:
		CharFlagsUnset char[10] 0x0080
		CharSetPos char[10] (-5930, 150, 43070) 180deg
		CharFlagsUnset char[11] 0x0080
		CharFlagsUnset char[11] 0x0010
		CharSetPos char[11] (-4610, 0, 43390) 225deg
	elif flag[768]:
		CharFlagsUnset char[2] 0x0080
	elif flag[533]:
		CharFlagsUnset char[10] 0x0080
		CharSetPos char[10] (-5930, 150, 43070) 180deg
		CharFlagsUnset char[11] 0x0080
		CharFlagsUnset char[11] 0x0010
		CharSetPos char[11] (-4610, 0, 43390) 225deg
	elif flag[526]:
		CharFlagsUnset char[7] 0x0080
		CharFlagsUnset char[9] 0x0080
	if flag[1343] && !flag[1344]:
		SystemFlagsSet 0x10000000
		Event fn[0,31]
	if flag[736]:
		FlagUnset flag[736]
		Event fn[0,27]
	elif flag[737]:
		FlagUnset flag[737]
		Event fn[0,33]
	if system[4] == 0 && !flag[570]:
		Event fn[0,21]
	Return

fn[2]:
	if flag[538] && !flag[768]:
		system[1] = 0
	if flag[1037] && !flag[1038]:
		MapColor 0x00C8D2FF 0ms
	elif flag[1792]:
		MapColor 0x00C8D2FF 0ms
	else:
	if flag[1031] && !flag[1040]:
		ED7_76_2 object[255] "red_" "on"
	Return

fn[3]:
	Call fn[0,4]
	Return

fn[4]:
	TextStart char[0]
	if flag[1792]:
		TextTalk char[0] {
			我們的成員分工合作，
			負責各地的搜索工作。
			市外地區交給我們就好了。{wait}
		}
		TextWait
		TextTalk char[0] {
			你們就專心處理
			藥物調查那邊的事吧。{wait}
		}
		TextWait
		TextTalk char[0] {
			還有，小滴就
			拜託你們照顧了哦！{wait}
		}
		TextWait
		TextTalk name[1] {
			#0100F嗯，請放心。{wait}
		}
		TextWait
		TextTalk name[0] {
			#0000F我們會負責
			照顧好她的。{wait}
		}
		TextWait
	elif flag[1569]:
	elif flag[1566]:
		if !flag[1659]:
			TextTalk char[0] {
				哎呀，是你們啊，
				你們看上去好像很趕時間呢。{wait}
			}
			TextWait
			TextTalk char[0] {
				難道黑手黨鬥爭事件
				有了什麼進展嗎？{wait}
			}
			TextWait
			TextTalk name[0] {
				#0003F不是，我們是在調查別的事件……{wait}
			}
			TextWait
			TextTalk char[0] {
				啊，那應該……
				就是在調查失蹤事件吧？{wait}
			}
			TextWait
			Emote field_party[0] 0mm 2000mm 2 7 80ms 1
			SoundPlay sound[28] 0 100 0
			Emote field_party[1] 0mm 2000mm 2 7 80ms 1
			SoundPlay sound[28] 0 100 0
			Emote field_party[2] 0mm 2000mm 2 7 80ms 1
			SoundPlay sound[28] 0 100 0
			Emote field_party[3] 0mm 2000mm 2 7 80ms 1
			SoundPlay sound[28] 0 100 0
			Sleep 1200ms
			TextTalk name[0] {
				#0005F遊擊士協會
				也知道這件事了嗎！？{wait}
			}
			TextWait
			TextTalk char[0] {
				嗯，亞里歐斯
				也正在調查這件事哦。{wait}
			}
			TextWait
			TextTalk char[0] {
				不過，既然你們開始
				插手這件事了……
				那就說明問題已經很嚴重了吧。{wait}
			}
			TextWait
			TextTalk char[0] {
				失蹤的人應該
				不只一兩個吧？{wait}
			}
			TextWait
			TextTalk name[3] {
				#0301F確實如此……{wait}
			}
			TextWait
			TextTalk name[2] {
				#0200F如果可以的話，
				希望能和你們交換情報……{wait}
			}
			TextWait
			TextTalk char[0] {
				啊，我們當然是
				非常歡迎啦……{wait}
			}
			TextWait
			TextTalk char[0] {
				不過，這件事……
				支援課能單獨決定嗎？{wait}
			}
			TextWait
			Emote field_party[0] 0mm 2000mm 24 27 250ms 0
			Emote field_party[1] 0mm 2000mm 24 27 250ms 0
			Emote field_party[2] 0mm 2000mm 24 27 250ms 0
			Emote field_party[3] 0mm 2000mm 24 27 250ms 0
			Sleep 1000ms
			EmoteStop field_party[0]
			EmoteStop field_party[1]
			EmoteStop field_party[2]
			EmoteStop field_party[3]
			Sleep 300ms
			TextTalk name[0] {
				#0003F（這情報是從一課那邊得來的，
				　確實不方便對外洩露……）{wait}
			}
			TextWait
			TextTalk name[1] {
				#0108F（要是被達德利警官知道了，
				　他應該會勃然大怒的……）{wait}
			}
			TextWait
			TextTalk char[0] {
				沒關係，等你們
				協商好了再來吧，{wait}
			}
			TextWait
			TextTalk char[0] {
				等亞里歐斯回來了，
				人家就把這邊的情報整理好。{wait}
			}
			TextWait
			FlagSet flag[1659]
		else:
			TextTalk char[0] {
				啊，對了，小滴現在
				也剛好來市裡了。{wait}
			}
			TextWait
			TextTalk char[0] {
				亞里歐斯出去調查了，
				所以艾絲蒂爾他們就替他
				帶小滴出去玩……{wait}
			}
			TextWait
			TextTalk char[0] {
				嗯～亞里歐斯可真是
				對不住小滴啊。{wait}
			}
			TextWait
	elif flag[1560]:
		TextTalk char[0] {
			雖然我們終於掌握了情況，
			但他們看起來不像是
			要馬上挑起鬥爭的樣子哦。{wait}
		}
		TextWait
		TextTalk char[0] {
			不過現在還無法定論呢。{wait}
		}
		TextWait
		TextTalk char[0] {
			為了保證協會隨時都有人手出動，
			必須先安排好輪值表呢。{wait}
		}
		TextWait
	elif flag[1554]:
		if !flag[1658]:
			Call fn[0,5]
		else:
			TextTalk char[0] {
				襲擊『黑月』，
				這毫無疑問就是魯巴徹的所作所為……{wait}
			}
			TextWait
			TextTalk char[0] {
				問題是，為什麼他們要在這種局勢下
				突然發起襲擊呢？{wait}
			}
			TextWait
			TextTalk char[0] {
				嗯……總之必須先把
				事情調查清楚啊。{wait}
			}
			TextWait
	elif flag[1536]:
		if !flag[1657]:
			TextTalk char[0] {
				啊，是支援課的小朋友們啊，
				有兩個星期沒見了吧。{wait}
			}
			TextWait
			TextTalk char[0] {
				……關於琪雅身世的消息，
				人家很抱歉。{wait}
			}
			TextWait
			TextTalk name[2] {
				#0200F以協會的情報網
				也還沒發現什麼嗎？{wait}
			}
			TextWait
			TextTalk char[0] {
				嗯，就只查到了
				一點小傳聞而已。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0003F沒事，沒關係。
				琪雅也完全習慣了
				在支援課的生活。{wait}
			} {
				#0000F在查明她的身世以及
				找回記憶之前，我覺得先照顧好
				她現在的生活比較重要。{wait}
			}
			TextWait
			TextTalk char[0] {
				嗯……
				這也對。{wait}
			}
			TextWait
			TextTalk char[0] {
				不過我們這邊也會
				繼續調查的哦。{wait}
			}
			TextWait
			TextTalk char[0] {
				你們那裡要是發現了什麼，
				再跟我們聯絡吧。{wait}
			}
			TextWait
			TextTalk name[1] {
				#0100F嗯，那就萬事拜託了。{wait}
			}
			TextWait
			FlagSet flag[1657]
		elif !flag[0]:
			TextTalk char[0] {
				亞里歐斯上星期
				就去了帝國那邊。{wait}
			}
			TextWait
			TextTalk char[0] {
				雖然是件很麻煩的工作，
				但他也應該快要回來了哦。{wait}
			}
			TextWait
			TextTalk name[3] {
				#0305F咦，那邊發生
				了什麼重大事件嗎？{wait}
			}
			TextWait
			TextTalk char[0] {
				其實也不算什麼重大事件，
				就是那邊的協會分部
				和軍方起了衝突。{wait}
			}
			TextWait
			TextTalk char[0] {
				而能夠勝任調解工作的，
				現在就只有亞里歐斯一人哦。{wait}
			}
			TextWait
			TextTalk char[0] {
				雖然之前在利貝爾
				也有一個人能夠勝任，
				但他已經辭去了遊擊士的工作。{wait}
			}
			TextWait
			TextTalk name[1] {
				#0106F那、那亞里歐斯先生可真是辛苦呢。{wait}
			}
			TextWait
			TextTalk char[0] {
				對啊，是很辛苦哦。{wait}
			}
			TextWait
			TextTalk char[0] {
				越是高等級的遊擊士，
				這種麻煩工作就越多哦。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				而且遊擊士協會
				和帝國政府
				的關係並不好。{wait}
			}
			TextWait
			TextTalk char[0] {
				不過在這一點上，協會在
				克洛斯貝爾的情況倒是很樂觀。{wait}
			}
			TextWait
			TextTalk char[0] {
				市民都很支持我們，
				政府也很信賴我們。{wait}
			}
			TextWait
	elif flag[1342]:
		if !flag[0]:
			TextTalk char[0] {
				我們會動用全大陸
				遊擊士協會的情報網
				來調查琪雅的身世。{wait}
			}
			TextWait
			TextTalk char[0] {
				簡單報告只需一周就能傳來，
				詳細點的也只需要一個月而已哦。{wait}
			}
			TextWait
			if PartyPosition name[1] > -1:
				TextTalk name[1] {
					#0105F一如既往地有效率呢……{wait}
				}
				TextWait
			elif PartyPosition name[2] > -1:
				TextTalk name[2] {
					#0200F一如既往地有效率呢……{wait}
				}
				TextWait
			elif PartyPosition name[3] > -1:
				TextTalk name[3] {
					#0306F一如既往地有效率啊……{wait}
				}
				TextWait
			TextTalk name[0] {
				#0000F那就萬事拜託了。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				遊擊士協會在整個大陸上
				都有獨立的情報網哦。{wait}
			}
			TextWait
			TextTalk char[0] {
				雖然人家不敢完全保證，
				但大概的身世應該查得出來。{wait}
			}
			TextWait
	elif flag[1055]:
		if !flag[0]:
			TextTalk char[0] {
				啊……這不是支援課的嗎。
				你們要去哪裡嗎？{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F嗯，我們要去一趟
				位於烏爾斯拉小徑的遺跡。{wait}
			}
			TextWait
			TextTalk char[0] {
				是『星見之塔』嗎……
				那邊應該已經被警備隊封鎖了。{wait}
			}
			TextWait
			TextTalk char[0] {
				那附近有很厲害
				的魔獸出沒哦，
				你們可要做好萬全的準備。{wait}
			}
			TextWait
			TextTalk name[1] {
				#0100F是，我們會小心的。{wait}
			}
			TextWait
			TextTalk name[2] {
				#0203F（……還是一如既往
				　的細心周到呢。）{wait}
