fn[5]:
	TextStart self
	if !flag[0]:
		CharTurnTo self 0deg 0deg/s
		Emote self 0mm 2000mm 0 1 250ms 2
		SoundPlay sound[29] 0 100 0
		Sleep 1000ms
		CharTurnToChar self field_party[0] 500deg/s
		TextTalk self {
			哎呀……
			你們是在找人嗎？{wait}
		}
		TextWait
		TextTalk name[0] {
			#0005F嗯，我們想找
			在醫院工作的朋友，
			正打算去接待處……{wait}
		}
		TextWait
		TextTalk self {
			哎呀，
			那你們還真是
			走錯地方了啊。{wait}
		}
		TextWait
		TextTalk self {
			接待處在病房大樓一樓的大廳哦。
			好啦，回去回去。{wait}
		}
		TextWait
		TextTalk name[0] {
			#0000F啊，是這樣嗎……
			謝謝您。{wait}
		}
		TextWait
		FlagSet flag[0]
	else:
		TextTalk self {
			接待處在病房大樓一樓的大廳啦。
			好啦，回去回去。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[6]:
	TextStart self
	if flag[1566]:
	elif flag[1565]:
		if !flag[1]:
			Call fn[0,7]
		else:
			TextTalk self {
				梅菲爾雖然有
				諸多抱怨，但還是會
				幫我補救失誤呢。{wait}
			}
			TextWait
			TextTalk self {
				呵呵，有個這麼善良的朋友真是太好了。{wait}
			}
			TextWait
	elif flag[1554]:
		if !flag[1]:
			TextTalk self {
				我把床單的訂貨單寫錯了，
				梅菲爾又發火了。{wait}
			}
			TextWait
			TextTalk self {
				我只是覺得五十張太少了，
				所以就加了個零而已啊～{wait}
			}
			TextWait
			TextTalk self {
				不過，算啦。
				不能總是為
				失敗而煩惱。{wait}
			}
			TextWait
			TextTalk self {
				沒什麼，沒什麼，我不介意！{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				雖然又被梅菲爾
				罵了……
				不過我並不介意。{wait}
			}
			TextWait
			TextTalk self {
				不能總是為失敗而煩惱。
				沒什麼，沒什麼，我不介意！{wait}
			}
			TextWait
	elif flag[1536]:
		if !RecipeLearn 11:
			Call fn[0,8]
		else:
			TextTalk self {
				梅菲爾真是的，
				又訓斥我了。{wait}
			}
			TextWait
			TextTalk self {
				我只是把收到的貨物好好保管起來而已……
				為什麼一定要被罵呢？{wait}
			}
			TextWait
	elif flag[1351]:
		if !flag[1]:
			TextTalk self {
				嗯～我被跑過去的
				小孩子撞到了，暈呼呼的……{wait}
			}
			TextWait
			TextTalk name[0] {
				#0006F對、對不起，
				那應該是我們監護的孩子。{wait}
			} {
				#0005F那個，你沒事吧？{wait}
			}
			TextWait
			TextTalk self {
				沒、沒事哦，
				只是頭有點暈而已。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				不行，可能還要
				再暈一會……{wait}
			}
			TextWait
			TextTalk self {
				啊，剛才的女孩子
				跑進醫院裡面去了。{wait}
			}
			TextWait
	elif flag[1346]:
		if !flag[1]:
			TextTalk self {
				我的同事梅菲爾
				雖然是護理師，卻是個急性子。{wait}
			}
			TextWait
			TextTalk self {
				我總是被她罵……{wait}
			}
			TextWait
			TextTalk self {
				今天她說要去
				蓋巴爾先生的病房，
				沒問題嗎？{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				我的同事梅菲爾
				雖然是護理師，卻是個急性子。{wait}
			}
			TextWait
			TextTalk self {
				蓋巴爾先生
				很任性呢，
				她能忍得下來嗎？{wait}
			}
			TextWait
	elif flag[1307]:
		if !flag[1]:
			TextTalk self {
				呵呵～天氣真好，
				床單似乎也能很快晾乾。{wait}
			}
			TextWait
			TextTalk self {
				……啊，對了。{wait}
			}
			TextWait
			TextTalk self {
				把之前不小心弄髒的
				梅菲爾的衣服
				也一起晾了吧～{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				之前我把藥架上的奇怪藥品
				撒到梅菲爾的便服上了。{wait}
			}
			TextWait
			TextTalk self {
				反正天氣不錯，
				偷偷一起晾了吧。{wait}
			}
			TextWait
	elif flag[1292]:
	elif flag[1282]:
		TextTalk self {
			昨天和賽西兒前輩她們
			換班去休假了。{wait}
		}
		TextWait
		TextTalk self {
			和梅菲爾一起逛街
			好開心哦㈱{wait}
		}
		TextWait
	elif flag[1280]:
	elif flag[1040]:
	elif flag[1024]:
	elif flag[799]:
		if !flag[1]:
			TextTalk self {
				呵呵，好漂亮的晚霞。
				感覺好涼爽。{wait}
			}
			TextWait
			TextTalk self {
				……哈啾！！{wait}
			}
			TextWait
			TextTalk self {
				……啊～鼻涕沾到床單上了！{wait}
			}
			TextWait
			TextTalk self {
				討厭，怎麼辦呀～！
				又要被梅菲爾罵了～！{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				怎、怎麼辦呀～！
				又要被梅菲爾罵了～！{wait}
			}
			TextWait
			TextTalk self {
				拜託戴森先生的話，
				他會不會私下幫我洗了呢……{wait}
			}
			TextWait
	elif flag[793]:
	elif flag[784]:
	elif flag[777]:
	TextEnd self
	Return

fn[7]:
	CharTurnToChar char[1] char[5] 0deg/s
	CharTurnToChar char[5] char[1] 0deg/s
	_Char4A char[1] 255
	_Char4A char[5] 255
	TextTalk char[5] {
		希蓉，你這個人啊……
		只是晾個床單而已，
		要花多長時間啊！{wait}
	}
	TextWait
	TextTalk char[1] {
		啊，梅菲爾。
		你再等等，好像只差一點
		就可以調整到理想的晾曬角度了。{wait}
	}
	TextWait
	TextTalk char[5] {
		理、理想的角度……{wait}
	}
	TextWait
	TextTalk char[5] {
		在你追求這種東西的時候，
		本該由你做的工作
		全都轉給我了啊！{wait}
	}
	TextWait
	TextTalk char[1] {
		啊，你幫我做完了工作嗎？
		哇，謝謝～！{wait}
	}
	TextWait
	TextTalk char[5] {
		……唉……算了，
		我已經連生氣的力氣都沒有了。{wait}
	}
	TextWait
	_Char4B char[1] 255
	_Char4B char[5] 255
	FlagSet flag[1]
	FlagSet flag[3]
	Return

fn[8]:
	TextTalk self {
		我又被罵了。
		唉～梅菲爾
		就是愛生氣。{wait}
	}
	TextWait
	TextTalk self {
		一定是因為總是不能
		按時吃午飯，
		所以才那麼暴躁呢。{wait}
	}
	TextWait
	TextTalk self {
		我試著做了一下之前在紀念慶典
		的露天攤販看到的漢堡，
		還挺簡單的，要不要教給她呢。{wait}
	}
	TextWait
	TextTalk self {
		啊，有興趣的話，
		不妨也教給你們吧。
		真的很簡單的！{wait}
	}
	TextWait
	FadeOut 300ms 0x00000000 100
