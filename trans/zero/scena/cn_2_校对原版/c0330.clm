fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharIdle self (37480, null, 5500) (36680, null, 2140) 1000mm/s
		Sleep 300ms
	Return

fn[2]:
	while 1:
		CharIdle self (-3520, null, 2060) (3160, null, 5020) 1000mm/s
		Sleep 300ms
	Return

fn[3]:
	while 1:
		CharWalkToPos self (35110, 0, 1240) 1000mm/s 0
		CharTurnTo self 315deg 500deg/s
		Sleep 2500ms
		CharTurnTo self 135deg 500deg/s
		Sleep 100ms
		CharWalkToPos self (37510, 0, -1160) 1000mm/s 0
		CharTurnTo self 135deg 500deg/s
		Sleep 2500ms
		CharTurnTo self 315deg 500deg/s
		Sleep 100ms
	Return

