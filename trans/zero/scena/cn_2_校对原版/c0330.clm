fn[5]:
	if system[4] == 3:
		EntranceSetDisabled entrance[0] 0
		EntranceSetDisabled entrance[3] 1
	else:
		EntranceSetDisabled entrance[0] 1
		EntranceSetDisabled entrance[3] 0
	if flag[1037] && !flag[1038]:
		MapColor 0x00C8D2FF 0ms
	elif flag[1792]:
		MapColor 0x00C8D2FF 0ms
	else:
	Return

fn[6]:
	TextStart self
	if flag[1792]:
		if flag[0]:
			TextTalk char[0] {
				#3600F這附近竟然有人失蹤……
				我也會盡全力提供幫助的。{wait}
			} {
				正是在這種時候，我們才更要
				舉全家之力來幫助和支持人家。{wait}
			}
			TextWait
		else:
			TextTalk char[0] {
				#3600F我妻子好像一直都在
				陪著克蕾優夫人。{wait}
			} {
				#3603F……克蕾優夫人是
				我妻子的好朋友，
				我妻子應該很擔心她吧……{wait}
			} {
				#3600F我認為妻子現在最好
				能多陪陪她，
				我也會竭盡所能，提供幫助的。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1307]:
		if flag[1399]:
			if flag[0]:
				TextTalk char[0] {
					#3603F昨天真是給你們添麻煩了……
					還跟你們說了那麼冗長無趣的話，
					實在非常抱歉。{wait}
				} {
					#3601F不好意思，我得再去稍微
					冷靜一下頭腦。{wait}
				}
				TextWait
			else:
				TextTalk char[0] {
					#3603F昨天真是給你們添麻煩了……
					還跟你們說了那麼冗長無趣的話，
					實在非常抱歉。{wait}
				}
				TextWait
				Emote char[0] 0mm 2000mm 24 27 250ms 0
				Sleep 2000ms
				EmoteStop char[0]
				TextTalk char[0] {
					#3608F雖然只是我個人的臆想……
					但昨天出手相助的那女孩
					應該並沒有自報姓名。{wait}
				} {
					#3603F所以，我覺得她會不會是
					我在天國的女兒……{wait}
				} {
					#3600F……哈哈，我想得太美了。
					不好意思，我必須再冷靜一下頭腦呢。{wait}
				}
				TextWait
				FlagSet flag[0]
		else:
			Emote char[0] 0mm 2000mm 38 38 250ms 1
			Sleep 1000ms
			TextTalk char[0] {
				#3600F各位……{wait}
			} {
				昨天真是謝謝你們了。
				一而再再而三的麻煩你們，
				都不知道要怎麼感謝才好了……{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F您太客氣了，那並不算什麼。{wait}
			}
			TextWait
			TextTalk name[1] {
				#0100F您的家人似乎也
				都平靜下來了吧。{wait}
			}
			TextWait
			TextTalk char[0] {
				#3603F嗯，我讓蘇菲亞和柯林
				去好好休息了。{wait}
			} {
				#3600F不過柯林好像並沒覺得害怕呢，
				哈哈哈……{wait}
			}
			TextWait
			Emote char[0] 0mm 2000mm 24 27 250ms 0
			Sleep 2000ms
			EmoteStop char[0]
			TextTalk char[0] {
				#3608F但我們已經嘗過苦頭了。
				不想再遇到那種可怕、悲痛的事，
				也不想再失去什麼……{wait}
			} {
				#3603F只想過上平靜安穩的生活，
				這就是我們如今唯一的願望。{wait}
			}
			TextWait
			FlagSet flag[1399]
	elif flag[1292]:
		if flag[0]:
			_Char4A char[2] 255
			TextTalk char[0] {
				#3600F柯林，你準備好了嗎？{wait}
			} {
				要是口渴了就跟媽媽說啊，
				媽媽帶著水壺呢。{wait}
			}
			TextWait
			_Char4B char[2] 255
		else:
			TextTalk char[0] {
				#3600F兒子說今天有慶典遊行，
				想出去玩。{wait}
			} {
				偶爾也要陪陪家人，
				所以我今天要陪他們
				好好玩個夠。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F哈哈哈……您也很辛苦啊。{wait}
			}
			TextWait
			CharTurnToChar char[0] char[2] 500deg/s
			CharFlagsSet char[0] 0x0010
			FlagSet flag[0]
	elif flag[1282]:
		if flag[0]:
			_Char4A char[1] 255
			TextTalk char[0] {
				#3603F紀念慶典這幾天，
				市區內的交通都堵塞了，
				沒法開車啊……{wait}
			} {
				#3600F蘇菲亞，你還行嗎？
				累了的話要說哦。{wait}
			}
			TextWait
			_Char4B char[1] 255
		else:
			TextTalk char[0] {
				#3600F柯林說他
				無論如何也想去看看
				港灣區的慶典活動。{wait}
			} {
				明明昨晚還
				一直喊累的……
				真是個不接受教訓的孩子啊。{wait}
			}
			TextWait
			CharTurnToChar char[0] char[1] 500deg/s
			CharFlagsSet char[0] 0x0010
			FlagSet flag[0]
	elif flag[1280]:
		if flag[0]:
			TextTalk char[0] {
				#3600F不愧是７０周年慶典，
				今年比往年都要熱鬧啊。{wait}
			} {
				不能讓柯林玩得太累了，
				所以就在這附近稍微逛一逛吧。{wait}
			} {
				各位，
				工作加油啊。{wait}
			}
			TextWait
		else:
			TextTalk char[0] {
				#3605F哦，各位，你們正在工作嗎？{wait}
			} {
				#3600F真是辛苦啊……
				我們正要
				出去玩玩。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F和家人共度紀念慶典……
				這果然是最傳統的
				過節方式呢。{wait}
			}
			TextWait
			TextTalk name[1] {
				#0100F呵呵，請不必在意我們，
				好好享受慶典吧。{wait}
			}
			TextWait
			TextTalk char[0] {
				#3600F那我們就不客氣了。{wait}
			} {
				反正……柯林年紀還小，
				出去轉一圈應該
				就足夠了。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[852]:
		if flag[0]:
			TextTalk char[0] {
				#3600F如果各位累了，
				可以在我們家
				休息休息。{wait}
			} {
				哈哈，請千萬不要客氣啊。
				很多生意上的顧客
				也經常暫住在我們家的。{wait}
			}
			TextWait
		else:
			Emote char[0] 0mm 2000mm 38 38 250ms 1
			Sleep 1000ms
			TextTalk char[0] {
				#3605F啊，是各位……
				你們來了啊！{wait}
			}
			TextWait
			TextTalk name[1] {
				#0100F好像
				打擾你們了呢。{wait}
			}
			TextWait
			TextTalk char[0] {
				#3600F沒有沒有，沒那回事。{wait}
			} {
				對了……你們
				累了吧？{wait}
			} {
				不嫌棄的話，就在我們家
				好好休息休息吧。{wait}
			} {
				哈哈，但是家裡也沒什麼東西好招待的，
				委屈各位了呢。{wait}
			}
			TextWait
			FlagSet flag[0]
	else:
		_Char4A char[1] 255
		Call fn[0,8]
		_Char4B char[1] 255
	TextEnd self
	Return

fn[7]:
	field_party[0].5 = char[3].4
	char[3].5 = char[3].4
	TextStart char[3]
	CharFlagsUnset char[3] 0x0010
	CharTurnToChar char[3] field_party[0] 0deg/s
	char[3].4 = (char[3].4 + 360) % 360
	char[3].4 = char[3].4 + 360 - char[3].5
	char[3].5 = char[3].4 / 180
	if char[3].4 <= 45 | char[3].4 >= 315 && char[3].4 <= 405 | char[3].4 >= 675:
	elif char[3].5 < 1:
		char[3].8 = 2
	elif char[3].5 > 2:
		char[3].8 = 1
	else:
		char[3].8 = char[3].5
	char[3].4 = field_party[0].5
	field_party[0].5 = 0
	char[3].5 = 0
	CharFlagsSet char[3] 0x0010
	if flag[1342]:
		if flag[0]:
			TextTalk char[3] {
				#3608F這幾年來，我還是第一次向別人
				提起女兒的事……{wait}
			} {
				我思考了很多，果然還是想
				先好好休息一段時間。{wait}
			} {
				現在不應該馬上投入工作，
				因為還是家人比較重要。{wait}
			}
			TextWait
		else:
			TextTalk name[0] {
				#0000F哈羅德先生……
				您在用餐嗎？{wait}
			}
			TextWait
			TextTalk char[3] {
				#3600F哈哈，其實我暫時
				休業了。{wait}
			} {
				大概會休息兩個星期左右，
				利用這段時間來調整一下心情。{wait}
			}
			TextWait
			if PartyPosition name[1] > -1:
				TextTalk name[1] {
					#0102F這樣啊……{wait}
				}
				TextWait
			elif PartyPosition name[2] > -1:
				TextTalk name[2] {
					#0202F這樣啊……{wait}
				}
				TextWait
			elif PartyPosition name[3] > -1:
				TextTalk name[3] {
					#0300F原來如此……{wait}
				}
				TextWait
			TextTalk char[3] {
				#3600F這一個星期都陪著家人，
				真是其樂融融啊。{wait}
			} {
				所以我妻子和柯林
				都很開心。{wait}
			}
			TextWait
			FlagSet flag[0]
	CharSetChipPattern char[3] 0
	TextEnd char[3]
	Return

fn[8]:
	TextTalk char[0] {
		#3600F抱歉，商談時間拖長了。{wait}
	} {
		……柯林
		還好嗎？{wait}
	}
	TextWait
	TextTalk char[1] {
		#3700F嗯，他現在正在
		畫畫呢。{wait}
	} {
		還說想要
		新的畫本哦。{wait}
	}
	TextWait
	TextTalk char[0] {
		#3600F哈哈哈，這樣啊……
		那孩子的好奇心也很重呢。{wait}
	}
	TextWait
	CharFlagsUnset char[0] 0x0010
	CharFlagsUnset char[1] 0x0010
	FlagSet flag[852]
	Return

fn[9]:
	TextStart self
	if flag[1554]:
		_Char4A char[6] 255
		_Char4A char[7] 255
		if flag[1]:
			TextTalk char[1] {
				#3701F不過……她的丈夫那麼溫柔，
				竟然也會口出穢語。{wait}
			} {
				真讓人擔心啊，
				他不會
				遇到什麼事了吧？{wait}
			}
			TextWait
		else:
			Call fn[0,13]
			CharFlagsUnset char[6] 0x0010
		_Char4B char[6] 255
		_Char4B char[7] 255
	elif flag[1536]:
		if flag[1]:
			TextTalk char[1] {
				#3700F最近工作很順利。{wait}
			} {
				並不是指生意
				有多好……
				而是和丈夫一起工作，真的很快樂。{wait}
			} {
				#3708F……向各位傾吐後，
				我好像釋然了一些。{wait}
			} {
				#3700F我先生他今天去阿爾摩利卡村了，
				如果各位看見他了，
				就麻煩跟他打聲招呼，說說話哦。{wait}
			}
			TextWait
		else:
			TextTalk char[1] {
				#3700F這不是支援課的各位嗎……？
