fn[24]:
	TextTalk char[0] {
		各位，違規停車的取締工作
		進行得怎麼樣了？{wait}
	}
	TextWait
	TextTalk char[0] {
		如果要報告的話，我現在就
		聯絡公共安全課的各位了。{wait}
	}
	TextWait
	FadeOut 300ms 0x00000000 100
	Menu menu[0] -1 -1 0
		"【進行報告】" // 0
		"【不報告】" // 1
	MenuWait var[1]
	MenuClose menu[0]
	FadeIn 300ms 0x00000000
	if !var[1]:
		TextTalk name[0] {
			#0000F好的，那就
			麻煩您了。{wait}
		}
		TextWait
		TextTalk char[0] {
			明白了。
			不好意思哦，
			還要請你們稍等一下。{wait}
		}
		TextWait
		TextTalk name[1] {
			#0100F嗯，請不用
			在意我們。{wait}
		}
		TextWait
	else:
		TextTalk char[0] {
			工作完成以後，
			就請與我聯絡。{wait}
		}
		TextWait
		TextTalk char[0] {
			我會通知公共安全課的各位
			前來聽取報告的。{wait}
		}
		TextWait
	Return

