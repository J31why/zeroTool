	}
	TextWait
	TextTalk char[3] {
		#11P他們的潛入路線，
		我想共有克洛斯貝爾車站、機場，
		以及唐古拉姆門這三條。{wait}
	}
	TextWait
	TextTalk char[3] {
		#11P車站和機場就交給我們來控制，
