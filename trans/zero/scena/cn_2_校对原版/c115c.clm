	}
	TextWait
	TextTalk char[3] {
		#11P就是想請你們協助我們找出
		在克洛斯貝爾地區從事違法活動的
		『假貨販子』，並將其捕獲。{wait}
	}
	TextWait
	TextTalk name[0] {
		#12P#0005F假貨販子……嗎？{wait}
	}
	TextWait
	TextTalk name[2] {
		#6P#0203F就是仿製那些名牌服飾品和導力器……{wait}
	} {
