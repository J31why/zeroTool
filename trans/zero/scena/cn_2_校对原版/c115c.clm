	}
	TextWait
	TextTalk char[3] {
		#11P而且，這種假貨商人的存在也
		關係到製造商與經銷商的信用，
		是個很大的問題。{wait}
	}
	TextWait
	TextTalk char[3] {
		#11P身為警察，我們今年一定要
