fn[0]:
	var[3] = random % 8
	switch var[3]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if flag[736]:
		FlagUnset flag[736]
		Event fn[0,29]
	if flag[1307]:
		CharFlagsSet char[3] 0x0080
		CharFlagsUnset char[9] 0x0080
		CharFlagsSet char[9] 0x0010
		CharSetPos char[9] (-12850, 0, 7690) 90deg
		CharSetPos char[4] (-11260, 0, 7690) 270deg
		CharSetPos char[6] (-11040, 0, 13810) 90deg
	elif flag[1362]:
		if !flag[1293]:
			CharFlagsSet char[1] 0x0080
			CharFlagsUnset char[2] 0x0080
		CharFlagsSet char[4] 0x0080
		CharFlagsUnset char[15] 0x0080
		CharSetPos char[3] (-10370, 0, 7070) 270deg
		CharSetPos char[15] (-11980, 0, 8189) 135deg
		CharSetPos char[6] (-11930, 0, 7110) 90deg
		CharFlagsSet char[3] 0x0010
		CharFlagsSet char[6] 0x0010
		CharFlagsUnset char[7] 0x0080
		CharSetPos char[7] (-58050, 0, 15900) 90deg
		CharFlagsUnset char[10] 0x0080
		CharFlagsUnset char[11] 0x0080
	elif flag[1292]:
		CharFlagsSet char[3] 0x0080
		CharFlagsSet char[4] 0x0080
		CharFlagsSet char[6] 0x0080
		CharFlagsUnset char[7] 0x0080
		CharSetPos char[7] (-58050, 0, 15900) 90deg
	elif flag[1282]:
		CharFlagsSet char[6] 0x0080
		if QuestFlagsGet quest[27] 0x10:
			CharSetPos char[3] (-124850, 0, 14920) 45deg
			CharFlagsSet char[3] 0x0010
			CharFlagsUnset char[14] 0x0080
			CharFlagsSet char[4] 0x0080
			CharFlagsUnset char[13] 0x0080
		elif QuestTaskGet quest[27] 1:
			CharFlagsSet char[3] 0x0080
			CharFlagsSet char[4] 0x0080
		else:
			CharSetPos char[3] (-57730, 0, 16309) 180deg
			CharSetPos char[4] (-57730, 0, 14480) 0deg
		if QuestFlagsGet quest[27] 0x10:
			CharFlagsUnset char[6] 0x0080
			CharSetPos char[6] (-11040, 0, 13810) 90deg
	elif flag[1280]:
		CharFlagsSet char[3] 0x0080
		CharFlagsSet char[4] 0x0080
		CharFlagsUnset char[8] 0x0080
		CharFlagsUnset char[5] 0x0080
		CharSetPos char[8] (-12850, 0, 7690) 90deg
		CharSetPos char[5] (-11260, 0, 7690) 270deg
		CharFlagsUnset char[9] 0x0080
		CharSetPos char[9] (-11040, 0, 13810) 90deg
		if QuestFlagsGet quest[23] 0x10:
			CharSetPos char[6] (-58050, 0, 15900) 90deg
		else:
			CharFlagsSet char[6] 0x0080
	Return

fn[2]:
	LookPointFlagsSet look_point[2] 0x0001
	if flag[1307]:
		LookPointFlagsUnset look_point[2] 0x0001
		ObjFlagsUnset object[1] 0x0010
	elif flag[1293]:
	elif flag[1362]:
		CharFlagsSet char[1] 0x0080
		CharFlagsUnset char[2] 0x0080
		LookPointFlagsSet look_point[1] 0x0001
	elif flag[1292]:
	elif flag[1282]:
	elif flag[1280]:
	Return

fn[3]:
	Call fn[0,4]
	Return

fn[4]:
	if QuestTaskGet quest[23] 19 && !QuestFlagsGet quest[23] 0x10 && !QuestFlagsGet quest[23] 0x40:
		TextStart char[0]
		Call fn[0,24]
		if !var[1]:
			FadeOut 1000ms 0x00000000 255
			FadeWait
			TextEnd char[0]
			Call fn[0,25]
			Return
		else:
	elif QuestFlagsGet quest[23] 0x02 && !QuestTaskGet quest[23] 0 && !QuestFlagsGet quest[23] 0x40:
		Call fn[0,23]
		Return
	TextStart char[0]
	if QuestFlagsGet quest[53] 0x10 && !flag[642]:
		if system[4] == 0:
			TextTalk char[0] {
				關於通緝魔獸的討伐，
				辛苦大家了。{wait}
			}
			TextWait
		TextTalk char[0] {
			對了，各位知道嗎？
			克洛斯貝爾警察正在進行
			魔獸的情報調查。{wait}
		}
		TextWait
		TextTalk name[0] {
			#0005F情報調查嗎……嗎？{wait}
		}
		TextWait
		TextTalk char[0] {
			嗯，我想各位應該知道
			在戰鬥手冊裡記錄著
			有關魔獸的項目吧。{wait}
		}
		TextWait
		TextTalk char[0] {
			各位曾經遭遇過的魔獸
			都會被記錄在戰鬥手冊裡哦。{wait}
		}
		TextWait
		TextTalk char[0] {
			當情報累積到一定程度時，
			就請拿來給我看一下。{wait}
		}
		TextWait
		TextTalk char[0] {
			因為各位所收集的情報對
			警局內制定安全對策
			很有幫助。{wait}
		}
		TextWait
		if PartyPosition name[1] > -1:
			TextTalk name[1] {
				#0100F原來如此……警察局也
				很下功夫啊。{wait}
			}
			TextWait
		elif PartyPosition name[2] > -1:
			TextTalk name[2] {
				#0200F原來如此……警察局也
				很下功夫啊。{wait}
			}
			TextWait
		elif PartyPosition name[3] > -1:
			TextTalk name[3] {
				#0300F原來如此……警察局也
				很下功夫啊。{wait}
			}
			TextWait
		TextTalk char[0] {
			嗯，這也是為了保障
			市民的安全。{wait}
		}
		TextWait
		TextTalk char[0] {
			各位在向我提交魔獸情報時，
			局內會多少支付一些報酬的。
			所以請不要客氣，隨時過來。{wait}
		}
		TextWait
		FlagSet flag[642]
		FlagSet flag[11]
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"對話" // 0
			"出示戰鬥手冊" // 1
			"放棄" // 2
		MenuWait var[0]
		MenuClose menu[0]
		FadeIn 300ms 0x00000000
		FadeWait
		if var[0] == 1:
			var[0] = 99
			FlagUnset flag[12]
			Call fn[0,30]
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			Call fn[0,5]
	TextEnd char[0]
	Return

fn[5]:
	if QuestTaskGet quest[23] 0 && !QuestTaskGet quest[23] 19 && !QuestFlagsGet quest[23] 0x40:
		TextTalk char[0] {
			各位辛苦了啊。{wait}
		}
		TextWait
		TextTalk char[0] {
			違規停車的取締工作結束之後，
			就請和我聯絡吧。{wait}
		}
		TextWait
		TextTalk char[0] {
			我會通知
			公共安全課的人的。{wait}
		}
		TextWait
		TextTalk name[0] {
			#0000F嗯，到時候
			就麻煩您了。{wait}
		}
		TextWait
	elif flag[11]:
		TextTalk char[0] {
			當魔獸的情報累積到一定程度時，
			就請拿來給我看一下。{wait}
		}
		TextWait
		TextTalk char[0] {
			因為各位所收集的情報對
			制定安全對策很有幫助。{wait}
		}
		TextWait
		TextTalk char[0] {
			而且我們多少會支付一些報酬的，
			所以請不要客氣，隨時過來。{wait}
		}
		TextWait
	elif flag[2]:
		TextTalk char[0] {
			呵呵，各位辛苦了。{wait}
		}
		TextWait
		TextTalk char[0] {
			在紀念慶典期間，
			事件好像也增加了呢……
			各位在努力工作時，也請注意不要太過勉強自己哦。{wait}
		}
		TextWait
	elif flag[1307]:
		TextTalk char[0] {
			按照預定，在大教堂的鐘聲響起，
			宣告黃昏降臨時，閉幕式就正式開始。{wait}
		}
		TextWait
		TextTalk char[0] {
			我們差不多也該去幫忙
			進行準備工作了。{wait}
		}
		TextWait
	elif flag[1293]:
		if !flag[0]:
			TextTalk char[0] {
				每年的紀念慶典都會出現
				不少走失的孩子呢。{wait}
			}
			TextWait
			TextTalk char[0] {
				今年也有很多呢……
				這類事件大概
				發生了二十起左右吧。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				無論是哪個孩子，其父母
				應該都是一樣心急如焚的……{wait}
			}
			TextWait
			TextTalk char[0] {
				總之請盡力幫助他們吧。{wait}
			}
			TextWait
	elif flag[1362]:
		if !flag[0]:
			TextTalk char[0] {
				呼，人潮總算是
				漸漸退去了呢。{wait}
			}
			TextWait
			TextTalk char[0] {
				芙蘭好像也很累了……
				今天就早點收工好了。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				芙蘭應該在自動販賣機
				的附近休息呢。{wait}
			}
			TextWait
			TextTalk char[0] {
				如果方便的話，
				不妨過去和她打個招呼吧。{wait}
			}
			TextWait
	elif flag[1292]:
		TextTalk char[0] {
			今天預定要在市內
			展開紀念遊行活動。{wait}
		}
		TextWait
		TextTalk char[0] {
			前來詢問的人已經有幾十位了，
			對市民的引導工作也是十分必要的啊。{wait}
		}
		TextWait
		TextTalk char[0] {
			看起來……似乎有必要
			拿出全部的幹勁呢。{wait}
		}
		TextWait
	elif flag[1282]:
		if !flag[0]:
			TextTalk char[0] {
				今天將要在市政廳
				召開研討會。{wait}
			}
			TextWait
			TextTalk char[0] {
				雖然並不是那種
				大量市民和遊客聚集的活動，
				但許多來自各個國家的知識份子將會出席。{wait}
			}
			TextWait
			TextTalk char[0] {
				至於克洛斯貝爾的參加者，則是以市長為首。
				另外，據說ＩＢＣ的總裁以及格林伍德先生
				也都會參加呢。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				警備工作自然是由警察來負責，
				但那個亞里歐斯・馬克萊因這次也會
				作為特別增援而參加警備工作……{wait}
			}
			TextWait
			TextTalk char[0] {
				警察局的高層人物雖然心情複雜，
				但畢竟牽涉到各國相關人員的安危，
				似乎也沒辦法提出反對呢。{wait}
			}
			TextWait
	elif flag[1280]:
		if QuestFlagsGet quest[23] 0x10:
			Call fn[0,6]
		elif QuestTaskGet quest[23] 19:
			Call fn[0,24]
			if !var[1]:
				FadeOut 1000ms 0x00000000 255
				FadeWait
				var[0] = 0
				Call fn[0,25]
				TextEnd char[0]
				Return
		else:
			Call fn[0,6]
	Return

fn[6]:
	if !flag[0]:
		TextTalk char[0] {
			啊，是支援課的各位。{wait}
		}
		TextWait
		TextTalk char[0] {
			今年的情況果然
			比往年都要混亂呢。{wait}
		}
		TextWait
		TextTalk char[0] {
			支援請求的處理，請加油啊。{wait}
		}
		TextWait
		FlagSet flag[0]
	else:
		TextTalk char[0] {
			今年的紀念慶典，情況好像
			比往年都要混亂呢。{wait}
		}
		TextWait
		TextTalk char[0] {
			各位也要加油完成
			支援請求的工作哦。{wait}
		}
		TextWait
	Return

fn[7]:
	Call fn[0,8]
	Return

fn[8]:
	TextStart char[1]
	if flag[1307]:
		if !flag[3]:
			TextTalk char[1] {
				#1903F紀念慶典今天就是最終日了……
				總算是快要撐過去了啊～{wait}
			} {
				#1900F大家也真是
				辛苦了啊。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F哈哈，芙蘭你也辛苦了。{wait}
			}
			TextWait
			TextTalk name[2] {
				#0203F（不過對我們來說，真正的重頭戲
				　才剛要開始呢……）{wait}
			}
			TextWait
			TextTalk name[1] {
				#0100F（算了，我們也不希望把她捲進來，
				　就不要多說什麼了吧。）{wait}
			}
			TextWait
			FlagSet flag[3]
		elif !flag[4]:
			TextTalk char[1] {
				#1905F說起來……賽爾蓋警部
