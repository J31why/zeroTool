		大概就是這麼一回事。{wait}
	}
	TextWait
	TextTalk char[4] {
		#11P每年紀念慶典期間，
		都會有很多這樣的假貨販子，偽裝成
		普通的遊客，潛入克洛斯貝爾。{wait}
	}
	TextWait
	TextTalk char[4] {
		#11P像烏爾努公司製造的高級手錶，
		斯托雷加公司的絕版經典產品，
		還有各種七耀石製的小物件……{wait}
	}
	TextWait
	TextTalk char[4] {
		#11P他們將這些東西販賣給
		缺乏鑒別知識的顧客，
		從而謀取不正當的利益。{wait}
	}
	TextWait
	TextTalk name[3] {
		#6P#0301F這根本就是靠行騙來賺錢啊，
		真是些讓人不爽的傢伙。{wait}
	} {
		#0303F總而言之，就是讓我們
		幫忙抓捕那些傢伙吧。{wait}
	}
	TextWait
	TextTalk char[3] {
		#11P嗯，就是這樣。{wait}
	}
	TextWait
	TextTalk char[3] {
		#11P說起來，我們也真是沒用……
