fn[6]:
	EventBegin 1
	SoundPlay sound[1094] 255 100 0
	TextTalk name[0] {
		#0000F這裡的話似乎可以釣到魚。{wait}
	}
	TextWait
	CamSetDistance 52750 -2850 -44000 1500ms
	ED7CamRotate 90deg 27deg 0deg 1500ms
	CamPers 500 1500ms
	CamZoom 26000 1500ms
	Sleep 1000ms
	TextSetName ""
	TextMessage null {
		{color 5}要釣魚嗎？{color 0}{wait}
	}
	Menu menu[0] -1 -1 1
		"釣魚" // 0
		"放棄" // 1
	MenuWait var[0]
	MenuClose menu[0]
	TextClose 0
	_59
	CamWait 1
	if var[0] == 0:
		ED7_E0 2
		if flag[842]:
			Minigame 6 7 55000 -1750 -42250 225 52000 -6150 -45150
		else:
			Minigame 6 8 55000 -1750 -42250 225 52000 -6150 -45150
			if system[69] == 2:
				if ED7NoteFishCount 21 > 0 && !flag[842]:
					FadeOut 0ms 0x00000000 255
					EventBegin 0
					CamSetDistance 55000 -250 -42250 0ms
					ED7CamRotate 90deg 24deg 0deg 0ms
					CamPers 500 0ms
					CamZoom 20500 0ms
					ED7LoadChip "apl/ch50162.itc" chip[30]
					CharFlagsSet field_party[0] 0x0002
					CharSetChipBase field_party[0] chip[30]
					CharSetChipPattern field_party[0] 18
					CharSetPos field_party[0] (55000, -1750, -42250) 225deg
					CharFlagsSet field_party[1] 0x0008
					CharFlagsSet field_party[2] 0x0008
					CharFlagsSet field_party[3] 0x0008
					FadeIn 1000ms 0x00000000
					FadeWait
					TextTalkNamed field_party[0] "羅伊德" {
						#0005F這、這是什麼……{wait}
					} {
						#0003F釣上了很漂亮的魚呢……
						難道這是一條十分稀有的
						特別魚類嗎。{wait}
					}
					TextWait
					FadeOut 1000ms 0x00000000 255
					FadeWait
					CamSetDistance 55000 -250 -42250 0ms
					ED7CamRotate 45deg 23deg 0deg 0ms
					CamPers 500 0ms
					CamZoom 27000 0ms
					CharFlagsUnset field_party[1] 0x0008
					CharFlagsUnset field_party[2] 0x0008
					CharFlagsUnset field_party[3] 0x0008
					CharSetPos field_party[1] (55000, -1750, -42250) 225deg
					CharSetPos field_party[2] (55000, -1750, -42250) 225deg
					CharSetPos field_party[3] (55000, -1750, -42250) 225deg
					CharSetPos field_party[4] (55000, -1750, -42250) 225deg
					CharSetPos field_party[5] (55000, -1750, -42250) 225deg
					CharSetPos field_party[6] (55000, -1750, -42250) 225deg
					CharSetPos field_party[7] (55000, -1750, -42250) 225deg
					CharSetChipBase field_party[0] chip[255]
					CharSetChipPattern field_party[0] 0
					CharFlagsUnset field_party[0] 0x0002
					NextFrame
					UnloadChip chip[30]
					ED7_37
					FlagSet flag[842]
	ED7_E0 2
	EventEnd 4
	Return

fn[7]:
	EventBegin 0
	FadeOut 0ms 0x00000000 255
	ED7_E0 1
	CamSetDistance 63530 -200 -37770 0ms
	ED7CamRotate 45deg 23deg 0deg 0ms
	CamPers 500 0ms
	CamZoom 18690 0ms
	CharSetPos name[0] (62960, -1700, -37310) 90deg
	CharSetPos name[1] (64590, -1700, -38050) 0deg
	CharSetPos name[2] (63900, -1700, -35830) 180deg
	CharSetPos name[3] (65170, -1700, -36660) 270deg
	CamZoom 17690 3000ms
	FadeIn 1000ms 0x00000000
	FadeWait
	TextTalk name[0] {
		#6P#0000F……看來，剛才那個應該就是
		最後一隻魔獸了。{wait}
	}
	TextWait
	TextTalk name[2] {
		#5P#0203F嗯，應該是的。{wait}
	} {
		#0200F廢坑內已經
		感覺不到魔獸的氣息了。{wait}
	}
	TextWait
	TextTalk name[3] {
		#11P#0306F呼～終於搞定了啊。{wait}
	} {
		在這麼大的一個廢坑裡走來走去，
		實在累死人啦。{wait}
	}
	TextWait
	TextTalk name[1] {
		#12P#0100F呵呵，辛苦了。{wait}
	} {
		那麼，羅伊德……
		我們快回去
		向鎮長報告吧。{wait}
	}
	TextWait
	TextTalk name[0] {
		#6P#0000F嗯，好的。{wait}
	}
	TextWait
	TextTalk name[3] {
		#11P#0306F嗚……我已經走不動啦。{wait}
	} {
		#0309F……羅伊德。
		背我到出口吧㈱{wait}
	}
	TextWait
	Emote name[0] 0mm 2000mm 16 19 250ms 1
	SoundPlay sound[23] 0 100 0
	Sleep 1000ms
	TextTalk name[0] {
		#6P#0003F我拒絕。{wait}
	} {
		#0000F別鬧了，
		快點走吧。{wait}
	}
	TextWait
	TextTalk name[3] {
		#11P#0306F哼，薄情鬼。{wait}
	}
	TextWait
	FadeOut 1000ms 0x00000000 255
	FadeWait
	QuestTaskSet quest[28] 4
	TextSetName ""
	TextSetPos -1 40 -1 -1
	TextMessage null {
		{color 5}自動返回鎮長家嗎？{color 0}{0x18}{wait}
	}
	Menu menu[0] -1 -1 0
		"【返回鎮長家】" // 0
		"【放棄】" // 1
	MenuWait var[0]
	MenuClose menu[0]
	TextClose 0
	_59
	TextSetPos -1 280 60 3
	if var[0] == 0:
		BgmStop 4000ms
		BgmWait
		NewScene "scena/t0510.bin" 0 0 0
		Hcf
	else:
		CharSetPos field_party[0] (63730, -1700, -33940) 180deg
		EventEnd 5
	Return
