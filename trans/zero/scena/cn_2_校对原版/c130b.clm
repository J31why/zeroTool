fn[0]:
	if system[0] == 101 && flag[1853] && !flag[1829]:
		FlagSet flag[0]
		Event fn[0,3]
	if flag[736]:
		FlagUnset flag[736]
		Event fn[0,2]
	elif flag[738]:
		FlagUnset flag[738]
		Event fn[0,21]
	elif flag[739]:
		FlagUnset flag[739]
		Event fn[0,46]
	Return

fn[1]:
	if flag[0]:
		system[1] = 513
		FlagUnset flag[0]
	ObjFlagsSet object[13] 0x0004
	ObjFlagsSet object[14] 0x0004
	Return

fn[2]:
	EventBegin 0
	FadeOut 0ms 0x00000000 255
	ED7LoadChip "chr/ch28600.itc" chip[30]
	CamSetDistance 0 2500 -26500 0ms
	ED7CamRotate 0deg 13deg 0deg 0ms
	CamPers 800 0ms
	CamZoom 9000 0ms
	CharFlagsSet name[0] 0x0008
	CharFlagsSet name[1] 0x0008
	CharFlagsSet name[2] 0x0008
	CharFlagsSet name[3] 0x0008
	CharSetChipBase char[17] chip[30]
	CharSetChipPattern char[17] 0
	CharFlagsUnset char[17] 0x0080
	CharFlags2Unset char[17] 0x8000
	CharFlagsSet char[17] 0x8000
	CharSetPos char[17] (2300, 400, 6000) 180deg
	CharSetChipBase char[18] chip[30]
	CharSetChipPattern char[18] 0
	CharFlagsUnset char[18] 0x0080
	CharFlags2Unset char[18] 0x8000
	CharFlagsSet char[18] 0x8000
	CharSetPos char[18] (-2300, 400, 6000) 180deg
	ObjFlagsSet object[1] 0x0004
	ObjFlagsUnset object[12] 0x0004
	ObjFlagsUnset object[12] 0x0010
	ObjFrame object[12] 0
	Sleep 1000ms
	Sc_C4Set 2048
	TextSetPos -1 -1 -1 -1
	TextSetName ""
	TextMessage null {
		{0x18}{color 0}#1K同日，２２：００──{wait}
	}
	Sleep 2500ms
	TextClose 0
	_59
	TextSetPos -1 280 60 3
	Sc_C4Unset 2048
	BgmPlay bgm[513] 0
	CamSetDistance 0 7500 -20500 10000ms
	ED7CamRotate 0deg -9deg 0deg 10000ms
	CamZoom 14000 10000ms
	FadeIn 2000ms 0x00000000
	Sleep 8000ms
	FadeOut 2000ms 0x00000000 255
	FadeWait
	CamWait 121
	CharFlagsUnset name[0] 0x0008
	CharFlagsUnset name[1] 0x0008
	CharFlagsUnset name[2] 0x0008
	CharFlagsUnset name[3] 0x0008
	FlagSet flag[736]
	NewScene "scena/c134b.bin" 0 0 0
	Hcf
	Return

