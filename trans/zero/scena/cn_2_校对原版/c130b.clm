	EffPlay eff[0] eff_instance[255] self 192 (0, 1200, 400) 0 0 0 1000 1000 1000 null (0, 0, 0) 0ms
	SoundPlay sound[817] 0 100 0
	while 1:
		var[0] = random % 100
		if var[0] < 20:
			Sleep 500ms
		elif var[0] < 40:
			Sleep 1500ms
		elif var[0] < 60:
			Sleep 2000ms
		elif var[0] < 80:
			Sleep 3000ms
		else:
			Sleep 4000ms
		EffPlay eff[0] eff_instance[255] self 192 (0, 1200, 400) 0 0 0 1000 1000 1000 null (0, 0, 0) 0ms
		SoundPlay sound[817] 0 100 0
	Return

