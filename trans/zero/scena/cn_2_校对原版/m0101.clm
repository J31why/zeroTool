fn[0]:
	while 1:
		ED7CharAnimation self 1000ms 0 1 2 3 4 5
	Return

fn[1]:
	while 1:
		ED7CharAnimation self 1000ms 0 1 2 3 4 3 2 1
	Return

fn[2]:
	if system[0] == 0:
		if global[0] == 17:
			global[0] = 0
			Event fn[0,18]
	if flag[1560]:
	elif flag[1554]:
		CharSetPos char[0] (497850, 200, 296250) 270deg
	elif flag[1283]:
	else:
	if system[0] == 133 && flag[1052] && !flag[1053]:
		Event fn[0,22]
	elif system[0] == 135 && flag[1283] && !flag[1284]:
		Event fn[0,25]
	if flag[736]:
		FlagUnset flag[736]
		Event fn[0,20]
	elif flag[737]:
		FlagUnset flag[737]
		Event fn[0,30]
	Return

fn[3]:
	if !flag[1024]:
		system[1] = 0
	if system[0] == 133 | system[0] == 134 | system[0] == 139:
		system[1] = 521
		BgmVolume 40 200ms
	elif system[0] == 135:
		system[1] = 521
		BgmVolume 100 200ms
	LookPointFlagsSet look_point[4] 0x0001
	if flag[1053] && !flag[1054]:
		ObjFlagsUnset object[19] 0x0010
		LookPointFlagsUnset look_point[4] 0x0001
	TriggerFlagsSet trigger[0] 0x0080
	if !flag[1054]:
		TriggerFlagsUnset trigger[0] 0x0080
	ObjFlagsUnset object[24] 0x0010
	ObjFrame object[24] 30
	if system[0] == 133 | system[0] == 134 | system[0] == 135 | system[0] == 139:
		SystemFlagsSet 0x00002000
		ED7_E0 0
	else:
		SystemFlagsUnset 0x00002000
	ED7_1D_0 0 1 0 (106000, -6000, 0) 6000 2000 90000
	ED7_1D_0 1 1 0 (98000, -6000, 0) 6000 2000 90000
	ED7_1D_0 2 1 0 (100000, -7380, 89000) 4000 2000 0
