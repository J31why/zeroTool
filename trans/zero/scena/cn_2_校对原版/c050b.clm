				CharSetPos field_party[5] (-24900, 0, 220) 90deg
			elif system[14] != 255:
				CharSetPos field_party[4] (-24900, 0, 220) 90deg
	global[7] = 10
	if flag[736]:
		FlagUnset flag[736]
		Event fn[0,10]
	elif flag[737]:
		FlagUnset flag[737]
		Event fn[0,11]
	elif flag[738]:
