fn[21]:
	EventBegin 1
	if !flag[1610]:
		TextTalk name[3] {
			#0301F魯巴徹商會……
			那件事發生之後，似乎仍然在正常運營啊。{wait}
		}
		TextWait
		TextTalk name[1] {
			#0101F雖然因為琪雅的那件事，
			暫時安分了一段時間……{wait}
		} {
			但自從達成和解之後，
			他們似乎又重新開始『營業』了呢。{wait}
		}
		TextWait
		TextTalk name[0] {
			#0003F之前發生了很多事情啊……
			還是別去刺激他們了。{wait}
		}
		TextWait
		FlagSet flag[1610]
	else:
		TextTalk name[0] {
			#0001F（這前面就是魯巴徹商會了。）{wait}
		} {
			（最好不要貿然刺激他們，
			　還是別隨便靠近了。）{wait}
		}
		TextWait
	CharSetPos field_party[0] (90, 0, 80) 180deg
	EventEnd 4
	Return
