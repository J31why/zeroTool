fn[8]:
	TextStart self
	if flag[0]:
		TextTalk char[0] {
			什麼嘛，不來嗎？{wait}
		}
		TextWait
		TextTalk char[0] {
			真遺憾，畢許本來還打算
			給客人帶來快樂呢～{wait}
		}
		TextWait
	else:
		TextTalk char[0] {
			啊，來了個很帥氣的人呢……！{wait}
		}
		TextWait
		TextTalk char[0] {
			哎呀～太好了。
			有客人來的話，
			店裡的女孩子們也會很高興呢。{wait}
		}
		TextWait
		TextTalk char[0] {
			快快，這邊請。
			呀哈哈哈哈……！{wait}
		}
		TextWait
		FlagSet flag[0]
	TextEnd self
	Return

fn[9]:
	TextStart self
	if flag[1]:
		TextTalk char[1] {
			我今天幹勁十足呢。{wait}
		}
		TextWait
		TextTalk char[1] {
			呵呵，哪怕有一點閒暇時間，
			都必須去攬客呢～♪{wait}
		}
		TextWait
	else:
		TextTalk char[1] {
			呵呵，我是愛麗絲～☆{wait}
		}
		TextWait
		TextTalk char[1] {
			啊，這位小哥～
			不和我一起玩玩嗎～？{wait}
		}
		TextWait
		TextTalk char[1] {
			我今天還有點時間哦～{wait}
		}
		TextWait
		FlagSet flag[1]
	TextEnd self
	Return

