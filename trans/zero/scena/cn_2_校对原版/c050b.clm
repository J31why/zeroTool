fn[4]:
	if !flag[2178]:
		ObjFrame object[4] 0
	else:
		ObjFrame object[4] 30
	if !flag[2179]:
		ObjFrame object[5] 0
	else:
		ObjFrame object[5] 30
	if !flag[2180]:
		ObjFrame object[6] 0
	else:
		ObjFrame object[6] 30
	EntranceSetFunc entrance[2] fn[255,65535]
	if flag[1536] && !flag[1554]:
