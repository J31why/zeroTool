		}
		TextWait
	TextEnd self
	Return

fn[12]:
	if flag[813] && !flag[1024]:
		EventBegin 2
		FadeOut 300ms 0x00000000 100
		FadeWait
		Menu menu[0] -1 -1 0
			"【等待到深夜】" // 0
			"【還有其它事】" // 1
		MenuWait var[0]
		MenuClose menu[0]
		FadeIn 300ms 0x00000000
		FadeWait
		switch var[0]:
			case 0:
				TextTalk name[0] {
					#11200775V#0003F那麼，就暫時留在這裡，
					一直等待到深夜吧。{wait}
				} {
					#11200776V#0001F還要決定好魔獸出現時的
					作戰計畫和人員配置。{wait}
				}
				TextWait
				TextTalk name[2] {
					#11200777V#0201F光是擊退魔獸
					還不行吧……？{wait}
				}
				TextWait
				TextTalk name[1] {
					#11200778V#0103F嗯，還必須要制伏
					操縱魔獸的黑手黨們。{wait}
				}
				TextWait
				TextTalk name[3] {
					#11200779V#0302F嘿，似乎是個
					難度相當高的任務啊。{wait}
				}
				TextWait
				FadeOut 1000ms 0x00000000 255
				FadeWait
				Minigame 24 0 0 0 0 0 0 0 0
				LookPointFlagsSet look_point[2] 0x0001
				FlagSet flag[736]
				NewScene "scena/t050b.bin" 0 0 0
				Hcf
				break
			case 1:
				TextTalk name[3] {
					#11200780V#0300F那麼，準備就緒之後
					再回到這裡來吧。{wait}
				}
				TextWait
				FadeOut 300ms 0x00000000 100
				TextSetPos -1 -1 -1 -1
				TextSetName ""
				TextMessage null {
					{color 5}若想要直接等待到深夜，
					請在桌上顯示！符號的狀態
					按下按鈕。{color 0}{wait}
				}
				TextWait
				TextClose 0
				FadeIn 300ms 0x00000000
				TextSetPos -1 280 60 3
				_59
				break
		EventEnd 3
	Return

