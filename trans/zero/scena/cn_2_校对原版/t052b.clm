	Return

fn[5]:
	TextStart char[0]
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"對話" // 0
			"購物" // 1
			"休息" // 2
			"放棄" // 3
		MenuWait var[0]
		if var[0] < 1 | var[0] > 2:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			ShopOpen shop[82]
			var[0] = 99
		elif var[0] == 2:
			ShopOpen shop[80]
			var[0] = 99
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			if !flag[0]:
				TextTalk char[0] {
					呵呵，那個房間怎麼樣。
					很寬敞，很不錯吧？{wait}
				}
				TextWait
				TextTalk char[0] {
					很少有像你們這樣的
					年輕人會在我們這裡
					留宿呢。{wait}
				}
				TextWait
				TextTalk char[0] {
					……哦，要出門嗎？{wait}
				}
				TextWait
				TextTalk char[0] {
					最近鎮上有些不太平，
					所以最好早點回來哦。{wait}
				}
				TextWait
				FlagSet flag[0]
			else:
				TextTalk char[0] {
					酒館平時會來很多礦工，
					都吵得人頭痛。
					但今天的客人比較少呢。{wait}
				}
				TextWait
				TextTalk char[0] {
					哎呀哎呀，真是被連累得好慘。
					但馬庫斯剛剛受了傷，
					也沒辦法……{wait}
				}
				TextWait
				TextTalk char[0] {
					狼型魔獸什麼的我不管，
					只希望別再惹出麻煩了。{wait}
				}
				TextWait
	TextEnd char[0]
	Return

fn[6]:
	TextStart self
	if !flag[1]:
		TextTalk self {
			……哎呀哎呀，
			每天都飲酒作樂，
			還真是不吸取教訓啊。{wait}
		}
		TextWait
		TextTalk self {
			既然工作結束了，
			就該早點回家啊。{wait}
		}
		TextWait
		FlagSet flag[1]
	else:
		TextTalk self {
			話說回來，岡茲的
			酒品總是那麼差呢……{wait}
		}
		TextWait
	TextEnd self
	Return

fn[7]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if !flag[2]:
		TextTalk self {
			嗯……
			酒果然是好東西啊。{wait}
		}
		TextWait
		TextTalk self {
			一天的疲勞
			仿佛都煙消雲散了。{wait}
		}
		TextWait
		TextTalk self {
			不過喝太多
			也不是好事。{wait}
		}
		TextWait
		FlagSet flag[2]
	else:
		TextTalk self {
			他們礦工平時似乎
			也累積了不少鬱憤呢。{wait}
		}
		TextWait
		TextTalk self {
			喝點美酒，
			才能成為明天的活力嘛。{wait}
		}
		TextWait
	CharSetChipPattern self 0
	TextEnd self
	Return

fn[8]:
	TextStart self
	if !flag[3]:
		TextTalk char[3] {
			（一飲而盡）……{wait}
		}
		TextWait
		TextTalk char[3] {
			……呼～！
			收工後喝杯酒真是格外爽啊！{wait}
		}
		TextWait
		TextTalk char[3] {
			哦，但要注意
			別喝太多才行。{wait}
		}
		TextWait
		TextTalk char[3] {
			岡茲那傢伙，
			只要喝一點就會爛醉如泥了。{wait}
		}
		TextWait
		FlagSet flag[3]
	else:
		TextTalk char[3] {
			岡茲那傢伙，
			只要喝一點就會爛醉如泥了。{wait}
		}
		TextWait
		TextTalk char[3] {
			要是連我都喝醉的話，
			就沒人送這小子回家了……
			哎，真是吃力不討好啊。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[9]:
	TextStart self
	if !flag[4]:
		TextTalk char[4] {
			我啊……
			要在賭場大賺一筆……{wait}
		}
		TextWait
		TextTalk char[4] {
			讓今後的人生變得輕鬆愉快……{wait}
		}
		TextWait
		TextTalk char[4] {
			嗝……
			……喂，你在聽嗎，瑪爾羅？{wait}
		}
		TextWait
		TextTalk char[3] {
			在聽在聽。{wait}
		}
		TextWait
		TextTalk char[3] {
			真是的，同樣的話要說多少遍啊。{wait}
		}
		TextWait
		FlagSet flag[4]
	else:
		TextTalk char[4] {
			嗝……{wait}
		}
		TextWait
		TextTalk char[4] {
			我啊……
			這星期一定要在賭場大賺一筆……{wait}
		}
		TextWait
		TextTalk char[3] {
			……唉，回去之前，
			必須讓你醒醒酒才行啊。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[10]:
	TextStart self
	if !flag[6]:
		TextTalk self {
			對面的房間
			是你們在住吧。{wait}
		}
		TextWait
		TextTalk self {
			我也想住大房間，
			但是老闆娘和我說
			兩個人不能住四人間。{wait}
		}
		TextWait
		TextTalk self {
			那個老闆娘，還真是頗有膽量哦。
			好久都沒有人敢
			不順著我的意了。{wait}
		}
		TextWait
		FlagSet flag[6]
	else:
		TextTalk self {
			算了，反正我們就兩個人……
			暫時忍耐一下，湊和住這個房間吧。{wait}
		}
		TextWait
		TextTalk self {
			話說回來，明天還得
			跟鎮長交涉才行呢。{wait}
		}
		TextWait
		TextTalk self {
			七耀石的結晶……
			明天一定要弄到手！{wait}
		}
		TextWait
	TextEnd self
	Return

fn[11]:
	TextStart self
	if !flag[7]:
		TextTalk self {
			啊……要把餐具
			還給店裡才行。{wait}
		}
		TextWait
		TextTalk self {
