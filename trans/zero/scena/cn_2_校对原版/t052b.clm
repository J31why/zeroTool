	VisShow vis[0] 0 8 480 264 0 0 512 256 0 0 480 256 0x00FFFFFF 1 "c_vis021.itp"
	VisShow vis[1] 0 8 480 264 0 0 512 256 0 0 480 256 0x00FFFFFF 1 "c_vis022.itp"
	FadeIn 1000ms 0x00000000
	CamSetDistance 102370 3300 1380 4000ms
	CamWait 1
	FadeWait
	TextTalk name[0] {
