	}
	TextWait
	TextTalk name[3] {
		#11200628V#0305F#11P那是什麼？{wait}
	}
	TextWait
	FadeOut 300ms 0x00000000 100
	FadeWait
	TextSetPos -1 30 -1 -1
	TextSetName ""
	TextMessage null {
		{color 5}{0x06}{0x18}#1K早就能釐清的資訊是？{color 0}{wait}
	}
	Menu menu[0] -1 -1 0
		"【魔獸的真面目】" // 0
		"【魔獸的住處】" // 1
		"【魔獸的目的】" // 2
	MenuWait var[0]
	MenuClose menu[0]
	TextClose 0
	FadeIn 300ms 0x00000000
	FadeWait
	switch var[0]:
		case 0:
			QuestBonusBp quest[63] 1
			global[6] += 1
			TextTalk name[0] {
				#11200629V#0006F#5P魔獸的真面目……
				雖然想這麼說。{wait}
			} {
