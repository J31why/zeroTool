fn[0]:
	if flag[736]:
		FlagUnset flag[736]
		Event fn[0,4]
	Return

fn[1]:
	if !flag[2176]:
		ObjFrame object[7] 0
	else:
		ObjFrame object[7] 30
	if !flag[2177]:
		ObjFrame object[8] 0
	else:
		ObjFrame object[8] 30
	Return

fn[2]:
	ED7_F2 1
	SystemFlagsSet 0x08000000
	FadeOut 300ms 0x00000000 100
	if !flag[2176]:
		SoundPlay sound[14] 0 100 0
		ED7ObjPlay object[7] 0 30 0 0
		Sleep 500ms
		ObjFrame object[7] 30
		SoundPlay sound[17] 0 100 0
		TextSetPos -1 -1 -1 -1
		SepithAdd 0 80
		SepithAdd 1 80
		SepithAdd 2 80
		SepithAdd 3 80
		SepithAdd 4 80
		SepithAdd 5 80
		SepithAdd 6 80
		TextMessage null {
			獲得了{color 2}#56I地之耀晶石×８０{color 0}
			{color 2}#57I水之耀晶石×８０{color 0}
			{color 2}#58I火之耀晶石×８０{color 0}
			{color 2}#59I風之耀晶石×８０{color 0}
			{color 2}#60I時之耀晶石×８０{color 0}
			{color 2}#61I空之耀晶石×８０{color 0}
			{color 2}#62I幻之耀晶石×８０{color 0}。{wait}
		}
		TextWait
		TextClose 0
		TextSetPos -1 280 60 3
		FlagSet flag[2176]
		ED7_DE 6
	else:
		TextSetPos -1 -1 -1 -1
		TextSetName ""
		TextMessage name[742] {
			{0x06}{color 5}寶箱內空無一物。{wait}
		}
		TextWait
		TextClose 0
	FadeIn 300ms 0x00000000
	TextEnd null
	SystemFlagsUnset 0x08000000
	Return

fn[3]:
	ED7_F2 1
	SystemFlagsSet 0x08000000
	if !flag[2177]:
		SoundPlay sound[14] 0 100 0
		ED7ObjPlay object[8] 0 30 0 0
		Sleep 500ms
		if ItemAdd item[167] 1:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextSetName ""
			TextMessage name[742] {
				{color 0}已取得{item[167]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			TextSetPos -1 280 60 3
			FadeIn 300ms 0x00000000
			FlagSet flag[2177]
			ED7_DE 6
		else:
			FadeOut 300ms 0x00000000 100
			TextSetName ""
			TextMessage name[742] {
				寶箱內裝著{item[167]}{color 0}。
				但因持有物品已滿而放棄{item[167]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			SoundPlay sound[15] 0 100 0
			ED7ObjPlay object[8] 30 0 0 0
	else:
		FadeOut 300ms 0x00000000 100
		TextSetPos -1 -1 -1 -1
		TextSetName ""
		TextMessage name[742] {
			{0x06}{color 5}寶箱內空無一物。{color 0}{wait}
		}
		TextWait
		TextClose 0
		FadeIn 300ms 0x00000000
	Sleep 30ms
	TextEnd null
	SystemFlagsUnset 0x08000000
	Return

