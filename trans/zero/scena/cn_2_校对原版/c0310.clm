	pos (-40820, 0, 40910)
	radius 1500
	bubble_pos (-40820, 1500, 40910)
	unk1 124
	unk2 0
	function fn[0,13]
	unk3 0
	unk4 0

fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharIdle self (-2500, null, 0) (2500, null, 1850) 1000mm/s
		Sleep 300ms
	Return

fn[2]:
	while 1:
		CharIdle self (-1870, null, 6710) (1860, null, 9950) 1000mm/s
		Sleep 300ms
	Return

fn[3]:
	while 1:
		CharIdle self (40970, null, 41050) (45850, null, 45600) 1000mm/s
		Sleep 300ms
	Return

fn[4]:
	if flag[736]:
		FlagUnset flag[736]
		Event fn[0,11]
	if flag[1566]:
		CharSetPos char[0] (0, 4059, 7760) 180deg
		ForkFunc char[0] fork[0] fn[0,2]
		ForkFunc char[1] fork[0] fn[0,0]
	elif flag[1554]:
		CharSetPos char[0] (0, 4059, 7760) 180deg
		ForkFunc char[0] fork[0] fn[0,2]
		CharFlagsSet char[1] 0x0080
	elif flag[1342]:
		CharSetPos char[0] (0, 4059, 7760) 180deg
		ForkFunc char[0] fork[0] fn[0,2]
		ForkFunc char[1] fork[0] fn[0,0]
	elif flag[1307]:
		ForkFunc char[0] fork[0] fn[0,1]
		ForkFunc char[1] fork[0] fn[0,0]
	elif flag[1362]:
		CharSetPos char[0] (0, 4059, 13210) 360deg
		ForkFunc char[0] fork[0] fn[0,0]
		ForkFunc char[1] fork[0] fn[0,0]
	elif flag[1292]:
		CharSetPos char[0] (2580, 4000, 13150) 45deg
		CharSetPos char[1] (-44780, 60, 47510) 270deg
		ForkFunc char[0] fork[0] fn[0,0]
		ForkFunc char[1] fork[0] fn[0,0]
	elif flag[1282]:
		CharSetPos char[1] (43580, 0, 43630) 180deg
		ForkFunc char[0] fork[0] fn[0,1]
		ForkFunc char[1] fork[0] fn[0,3]
	elif flag[1040]:
		CharSetPos char[0] (0, 4059, 7760) 180deg
		ForkFunc char[0] fork[0] fn[0,2]
		ForkFunc char[1] fork[0] fn[0,0]
	elif flag[1036]:
		ForkFunc char[0] fork[0] fn[0,1]
		ForkFunc char[1] fork[0] fn[0,0]
	else:
		CharFlagsSet char[0] 0x0080
		CharFlagsSet char[1] 0x0080
	Return

fn[5]:
	TriggerFlagsSet trigger[0] 0x0080
	if QuestTaskGet quest[34] 6 && !QuestFlagsGet quest[34] 0x10 && !QuestFlagsGet quest[34] 0x40:
		TriggerFlagsUnset trigger[0] 0x0080
	if system[4] == 3:
		EntranceSetDisabled entrance[0] 0
		EntranceSetDisabled entrance[11] 1
	else:
		EntranceSetDisabled entrance[0] 1
		EntranceSetDisabled entrance[11] 0
	if flag[1037] && !flag[1038]:
		MapColor 0x00C8D2FF 0ms
	elif flag[1792]:
		MapColor 0x00C8D2FF 0ms
	else:
	Return

fn[6]:
	TextStart self
	if flag[1792]:
		if flag[0]:
			TextTalk self {
				老爺只聽得進
				艾莉小姐的意見。{wait}
			}
			TextWait
			TextTalk self {
				實在非常抱歉，
				只能拜託您了。{wait}
			}
			TextWait
			TextTalk name[1] {
				#0100F外公是政治家……
				我也不知道他能不能
				聽進我的話。{wait}
			}
			TextWait
		else:
			TextTalk self {
				其實剛才接到了聯絡，
				聽說老爺今天也要加班。{wait}
			}
			TextWait
			TextTalk self {
				唉，真擔心老爺的身體。
				等議會結束後，
				必須先讓老爺好好休息一下。{wait}
			}
			TextWait
			TextTalk name[1] {
				#0103F外公他也很固執……
				現在不管我們怎麼說，他應該都聽不進去吧。{wait}
			} {
				#0100F如果以後遇到合適的時機，
				我會再勸勸他的。{wait}
			}
			TextWait
			TextTalk self {
				好，實在非常抱歉，
				只能拜託您了。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1566]:
		if flag[0]:
			TextTalk self {
				聽說昨天在港灣區
				發生了槍擊事件……{wait}
			}
			TextWait
			TextTalk self {
				不知道邦德先生有沒有
				被捲入什麼恐怖事件中，
				真讓人擔心。{wait}
			}
			TextWait
		else:
			TextTalk self {
				剛才克蕾優夫人
				來過了。{wait}
			}
			TextWait
			TextTalk self {
				說是沒找到自己的丈夫邦德先生。{wait}
			}
			TextWait
			TextTalk self {
				唉，到底發生了什麼事呢？{wait}
			}
			TextWait
			TextTalk self {
				聽說最近發生了很多事件……
				真讓人擔心啊。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1554]:
		if flag[0]:
			TextTalk self {
				我服侍老爺
				已經足足有四十年了。{wait}
			}
			TextWait
			TextTalk self {
				所以絕對
				無法原諒
				哈爾特曼議長的態度。{wait}
			}
			TextWait
		else:
			TextTalk self {
				哈爾特曼議長
				和老爺同是自治州代表，
				應該擔負著統率議會的責任……{wait}
			}
			TextWait
			TextTalk self {
				但他卻對議會的鬆散狀態
				不管不顧……{wait}
			}
			TextWait
			TextTalk self {
				那種態度肯定
				是故意在為難老爺，
				真是不可原諒。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1536]:
		if flag[1635]:
			TextTalk self {
				預算會議的結束時間延遲了，
				所以老爺還要繼續加班。{wait}
			}
			TextWait
			TextTalk self {
				嗯，最讓人擔心的果然
				還是老爺的身體啊。{wait}
			}
			TextWait
			TextTalk self {
				離市長選舉
				僅剩四個月了。{wait}
			}
			TextWait
			TextTalk name[1] {
				#0108F是啊……
				希望外公可不要太勉強啊。{wait}
			}
			TextWait
		else:
			CharTurnToChar self name[1] 500deg/s
			TextTalk self {
				哦，艾莉小姐，
				您今天的氣色好像不是很好啊……{wait}
			}
			TextWait
			TextTalk name[1] {
				#0105F咦…………！？
				沒、沒有啦。{wait}
			} {
				#0103F海爾瑪先生，
				你別亂說啦。{wait}
			}
			TextWait
			TextTalk self {
				這樣啊……不過，
				說到小姐最怕的東西，
				應該只有那個或者是那個了吧……{wait}
			}
			TextWait
			TextTalk self {
				不對不對，好像小時候也
				很怕些鬼怪之類的。
				唔……{wait}
			}
			TextWait
			TextTalk name[3] {
				#0309F大小姐，沒想到你
				也有害怕的東西啊。{wait}
			}
			TextWait
			TextTalk name[8] {
				#0503F對不起，向你們提出了
				奇怪的委託……{wait}
			}
			TextWait
			TextTalk name[1] {
				#0112F我、我可不害怕，
				諾艾兒小姐也請不必自責啊。{wait}
			}
			TextWait
			FlagSet flag[1635]
	elif flag[1342]:
		if PartyPosition name[1] > -1:
			if flag[0]:
				TextTalk self {
					是嗎……
					總之，這棟宅邸裡是
					非常安全的。{wait}
				}
				TextWait
				TextTalk self {
					如果發生了什麼，
					請務必躲到這裡來。{wait}
				}
				TextWait
			else:
				TextTalk self {
					是艾莉小姐，還有各位啊，
					老爺已經把事情的大致情況
					告訴我了……{wait}
				}
				TextWait
				TextTalk self {
					…………………………（四下張望）{wait}
				}
				TextWait
				TextTalk self {
					#2S……這棟宅邸裡是非常安全的。{wait}
				}
				TextWait
				TextTalk self {
					#2S（如果發生了什麼，
					　請務必躲到這裡來！）{wait}
				}
				TextWait
				TextTalk name[1] {
					#0100F謝、謝謝你，海爾瑪先生。
					不過已經沒事了。{wait}
				}
				TextWait
				FlagSet flag[0]
		elif flag[0]:
			TextTalk self {
				是嗎……
				總之，這棟宅邸裡是
				非常安全的。{wait}
			}
			TextWait
			TextTalk self {
				如果發生了什麼，
				請務必躲到這裡來。{wait}
			}
			TextWait
		else:
			TextTalk self {
				是支援課的各位啊，
				老爺已經把事情的大致情況
				告訴我了……{wait}
			}
			TextWait
			TextTalk self {
				…………………………（四下張望）{wait}
			}
			TextWait
			TextTalk self {
				……我們麥克道爾官邸
				是非常安全的。{wait}
			}
			TextWait
			TextTalk self {
				如果發生了什麼，
				請務必和艾莉小姐一起
				躲到這裡來！{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F謝、謝謝您。
				……不過已經沒事了。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1307]:
		if QuestFlagsGet quest[34] 0x10:
			if !flag[0]:
				TextTalk self {
					哎呀呀，剛才
					真是嚇了一跳啊。{wait}
				}
				TextWait
				TextTalk self {
					真是，也不知道那東西是
					什麼時候跑進來的……{wait}
				}
				TextWait
				TextTalk self {
					等老爺回來後，
					必須馬上告訴他啊。{wait}
				}
				TextWait
				TextTalk name[1] {
					#0100F也、也是哦……
					那就麻煩你簡單
					跟外公說下。{wait}
				}
				TextWait
				TextTalk self {
					好，非常樂意效勞。{wait}
				}
				TextWait
				FlagSet flag[0]
			else:
				TextTalk self {
					不過，怪盜Ｂ……
					他竟然會來這裡。{wait}
				}
				TextWait
				TextTalk self {
					我以後必須
					更加提高警惕啊。{wait}
				}
				TextWait
		elif flag[0]:
			TextTalk self {
				最近，艾莉小姐表現活躍的消息，
				是唯一可以讓
				老爺開心的事。{wait}
			}
			TextWait
			TextTalk self {
				希望您能更加
				努力工作。{wait}
			}
			TextWait
		else:
			CharTurnToChar self name[1] 500deg/s
			TextTalk self {
				是艾莉小姐啊。{wait}
			}
			TextWait
			TextTalk self {
				老爺今天好像
				會提早回來。{wait}
			}
			TextWait
			TextTalk name[1] {
				#0105F這樣啊……{wait}
			} {
				#0104F太好了，外公偶爾就該像這樣
				好好放鬆休息一下。{wait}
			}
			TextWait
			TextTalk self {
				嗯，瓊安娜也正在幹勁十足地
				準備晚餐呢。{wait}
			}
			TextWait
			TextTalk self {
				……艾莉小姐，您和您的朋友們
				也留下來一起用晚餐吧？{wait}
			}
			TextWait
			TextTalk name[1] {
				#0105F啊……
				……今天還有很重要的工作要完成……{wait}
			} {
				#0106F抱歉哦，
				也不知道那工作什麼時候能做完。{wait}
			}
			TextWait
			TextTalk self {
				這樣啊，是我考慮不周。{wait}
			}
			TextWait
			TextTalk self {
				那我先去做準備，好迎接老爺回來。{wait}
			}
			TextWait
			TextTalk self {
				希望您能更加
				努力工作。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1362]:
		if flag[0]:
			TextTalk self {
				老爺的責任感太強了……{wait}
			}
			TextWait
			TextTalk self {
				雖然我很擔心他的身體，
				但我只是一介傭人，
				很難勸得了他啊。{wait}
			}
			TextWait
		else:
			TextTalk self {
				老爺這幾天連續出席了
				多個活動和宴會，一定很疲憊了。{wait}
			}
			TextWait
			TextTalk self {
				嗯，雖然我一直請求
				他能偶爾早點回來。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1292]:
		if flag[0]:
			TextTalk self {
				這樣啊，那可真令人遺憾。{wait}
			}
			TextWait
			TextTalk self {
				那就等到十幾年後
				再打開看看吧。{wait}
			}
			TextWait
		else:
			Emote self 0mm 2000mm 38 38 250ms 1
			CharTurnToChar self name[1] 500deg/s
			Sleep 500ms
			TextTalk self {
				哦哦，艾莉小姐！
				您回來得正是時候……{wait}
			}
			TextWait
			TextTalk name[1] {
				#0105F海爾瑪先生，怎麼了嗎！？{wait}
			}
			TextWait
			TextTalk self {
				我們剛才打掃的時候
				在閣樓上發現了這個木箱……{wait}
			}
			TextWait
			TextTalk self {
				我猜應該是小姐您小時候
				放寶物的箱子吧。{wait}
			}
			TextWait
			TextTalk self {
				呵呵，那時候的小姐
				真是可愛啊，
				總是喜歡收集一些很漂亮的小東西……{wait}
			}
			TextWait
			TextTalk self {
				小姐，您看這個木箱要如何處理？{wait}
			}
			TextWait
			TextTalk name[1] {
				#0113F……放回
				原來的地方吧。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F（原來艾莉也有過
				　這麼少女氣的愛好啊……）{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1282]:
		if flag[0]:
			TextTalk self {
				我太大驚小怪了，
				實在非常抱歉。{wait}
			}
			TextWait
			TextTalk self {
				因為老爺不在家，
				所以就想打掃一下。{wait}
			}
			TextWait
		else:
			TextTalk self {
				是艾莉小姐啊。
				我太大驚小怪了，
				實在非常抱歉。{wait}
			}
			TextWait
			TextTalk name[1] {
				#0100F海爾瑪先生，你今天
				好像特別有幹勁啊……{wait}
			}
			TextWait
			TextTalk self {
				哈哈，這沒什麼。{wait}
			}
			TextWait
			TextTalk self {
				每年這個時候，
				老爺都會去參加各種活動，
				幾乎不怎麼回家。{wait}
			}
			TextWait
			TextTalk self {
				家裡只剩些傭人，
				所以我都會趁這個時候做一次大掃除。{wait}
			}
			TextWait
			TextTalk self {
				艾莉小姐去留學的那段時間，
				我每年都保持著這個習慣。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1280]:
		if flag[0]:
			TextTalk self {
				考慮到老爺的身份，
				我也無法太過強求他不要勉強自己。{wait}
			}
			TextWait
			TextTalk self {
				站在傭人的立場上，
				心情還真是很矛盾啊。{wait}
			}
			TextWait
		else:
			TextTalk self {
				老爺的身體
				終於有點好轉了。{wait}
			}
			TextWait
			TextTalk self {
