fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		ED7CharAnimation self 2000ms 0 1 2 3 4
	Return

fn[2]:
	if flag[1489]:
		while 1:
			MapColor 0x00B4B4B4 0ms
			EffPlay eff[0] eff_instance[0] null 0 (0, 0, 0) 0 0 0 1000 1000 1000 null (0, 0, 0) 1000ms
			Sleep 2000ms
			MapColor 0x00FFFFFF 3000ms
			EffStop eff_instance[0] 2
			FlagUnset flag[1489]
			break
	Return

fn[3]:
	if flag[736]:
		FlagUnset flag[736]
		FlagSet flag[1]
		Event fn[0,14]
	if flag[1292] && !flag[1307]:
		if QuestFlagsGet quest[31] 0x10:
		elif QuestTaskGet quest[31] 0:
			CharFlagsUnset char[1] 0x0080
		else:
			CharSetPos char[1] (10370, 3000, 75310) 270deg
			CharFlagsUnset char[1] 0x0080
	Call fn[0,12]
	Return

fn[4]:
	if flag[776] && !flag[777]:
		system[1] = 0
	ED7_1D_0 0 1 0 (7800, 3010, 75130) 20000 2000 90000
	ObjFlagsSet object[7] 0x0004
	TriggerFlagsSet trigger[0] 0x0080
	LookPointFlagsSet look_point[6] 0x0001
	if flag[1280]:
		ED7_76_0 object[255] "bridge_before" 1
		ED7_76_1 object[255] "bridge_after" 1
		ED7_1D_2 0 1
		if !flag[1292]:
			ObjFlagsUnset object[7] 0x0004
			ED7_1D_3 0 1
