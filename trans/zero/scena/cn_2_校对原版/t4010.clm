fn[45]:
	if QuestFlagsGet quest[19] 0x10:
		TextTalk char[0] {
			……拉格教授他
			是遵從自己的意志
			而選擇從醫之路的。{wait}
		}
		TextWait
		TextTalk char[0] {
			對此，我也無法
			再多說些什麼。{wait}
		}
		TextWait
	elif QuestTaskGet quest[19] 2:
		TextTalk char[0] {
			……怎麼了，
			還有什麼別的事情嗎？{wait}
		}
		TextWait
		TextTalk char[0] {
			拿到了藥草的話，
			就快點送過去吧。{wait}
		}
		TextWait
	elif QuestTaskGet quest[19] 1:
		if flag[0]:
			TextTalk char[0] {
				『羽扇豆草』儲備在教堂左側
