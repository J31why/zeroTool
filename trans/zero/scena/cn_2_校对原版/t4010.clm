fn[7]:
	TextStart self
	if flag[1792]:
		TextTalk self {
			今天早上，警備隊的諾艾兒上士
			把調查克洛斯貝爾遺跡
			的報告書送來了。{wait}
		}
		TextWait
		TextTalk self {
			既然很有可能
			與古代遺物有所關聯……
			那麼教會也不可能坐視不理啊。{wait}
		}
		TextWait
	elif flag[1566]:
		TextTalk self {
			……諾艾兒上士所說的那口鐘
			到底是個什麼樣的東西呢？
			真讓人在意啊。{wait}
		}
		TextWait
		TextTalk self {
			而且，那口鐘為什麼會
			突然響起來呢……？{wait}
		}
		TextWait
	elif flag[1554]:
		TextTalk self {
			對於在市內發生的那起襲擊事件，
			艾拉爾達大主教感到十分痛心。{wait}
