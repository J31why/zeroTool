	unk2 0
	function fn[0,4]
	unk3 0
	unk4 0

fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharIdle self (96910, null, 4700) (100000, null, 7500) 1000mm/s
		Sleep 450ms
	Return

fn[2]:
	ForkFunc char[2] fork[0] fn[0,1]
	if flag[1792]:
		CharFlagsUnset char[26] 0x0080
	elif flag[1566]:
		CharSetPos char[3] (149530, 200, 17470) 90deg
		CharTurnTo char[4] 270deg 0deg/s
		CharFlagsUnset char[6] 0x0080
		CharTurnTo char[0] 90deg 0deg/s
	elif flag[1554]:
	elif flag[1536]:
		CharFlagsUnset char[11] 0x0080
		CharFlagsUnset char[12] 0x0080
		CharFlagsUnset char[17] 0x0080
		CharFlagsUnset char[18] 0x0080
		CharFlagsUnset char[21] 0x0080
		CharFlagsUnset char[22] 0x0080
		CharFlagsUnset char[19] 0x0080
		CharFlagsUnset char[20] 0x0080
		CharSetPos char[19] (153620, 150, 9130) 0deg
		CharSetPos char[20] (154930, 150, 9130) 0deg
		CharSetPos char[22] (153620, 150, 12230) 0deg
		CharFlagsSet char[3] 0x0080
	elif flag[1514]:
		CharFlagsUnset char[7] 0x0080
		CharFlagsUnset char[13] 0x0080
		CharFlagsUnset char[8] 0x0080
		CharFlagsUnset char[27] 0x0080
		CharFlagsUnset char[9] 0x0080
		CharSetPos char[9] (154930, 150, 9130) 0deg
		CharSetChipBase char[7] chip[7]
		CharSetChipPattern char[7] 0
		ForkQuit char[7] fork[0]
		CharFlagsSet char[7] 0x0004
		CharFlagsSet char[7] 0x0010
		CharSetPos char[7] (148490, 150, 12230) 0deg
		CharSetChipBase char[8] chip[7]
		CharSetChipPattern char[8] 0
		ForkQuit char[8] fork[0]
		CharFlagsSet char[8] 0x0004
		CharFlagsSet char[8] 0x0010
		CharSetPos char[8] (147140, 150, 12230) 0deg
		CharFlagsUnset char[19] 0x0080
		CharFlagsUnset char[20] 0x0080
		CharSetPos char[19] (147140, 150, 9130) 0deg
		CharSetPos char[20] (148490, 150, 9130) 0deg
	elif flag[1346]:
	elif flag[1342]:
		CharSetPos char[4] (148920, 0, 13890) 180deg
	elif flag[1307]:
	elif flag[1292]:
		CharFlagsUnset char[7] 0x0080
		CharFlagsUnset char[8] 0x0080
		CharSetPos char[4] (154300, 200, 17590) 180deg
	elif flag[1282]:
	elif flag[1280]:
	elif flag[1055]:
		CharFlagsUnset char[23] 0x0080
		CharFlagsUnset char[24] 0x0080
		CharFlagsUnset char[25] 0x0080
		CharFlagsSet char[3] 0x0080
		CharSetPos char[2] (96000, 0, 7830) 270deg
		ForkFunc char[2] fork[0] fn[0,0]
	elif flag[1040]:
		CharFlagsSet char[3] 0x0080
		CharSetPos char[2] (96000, 0, 7830) 270deg
		ForkFunc char[2] fork[0] fn[0,0]
	elif flag[1024]:
		CharFlagsUnset char[7] 0x0080
		CharFlagsUnset char[8] 0x0080
		CharFlagsUnset char[9] 0x0080
		CharFlagsUnset char[10] 0x0080
		CharFlagsUnset char[15] 0x0080
		CharFlagsUnset char[16] 0x0080
		CharSetChipBase char[7] chip[7]
		CharSetChipPattern char[7] 0
		ForkQuit char[7] fork[0]
		CharFlagsSet char[7] 0x0004
		CharFlagsSet char[7] 0x0010
		CharSetPos char[7] (154930, 0, 12230) 0deg
		CharSetChipBase char[8] chip[7]
		CharSetChipPattern char[8] 0
		ForkQuit char[8] fork[0]
		CharFlagsSet char[8] 0x0004
		CharFlagsSet char[8] 0x0010
		CharSetPos char[8] (153620, 0, 12230) 0deg
		CharFlagsUnset char[19] 0x0080
		CharFlagsUnset char[20] 0x0080
		CharSetPos char[19] (147140, 150, 6150) 0deg
		CharSetPos char[20] (148490, 150, 6150) 0deg
		CharFlagsSet char[19] 0x0010
		CharFlagsSet char[20] 0x0010
	elif flag[801]:
	if flag[1280] && !flag[1342]:
		CharFlagsUnset char[14] 0x0080
	Return

fn[3]:
	if flag[1792]:
	elif flag[1566]:
	elif flag[1554]:
	elif flag[1536]:
	elif flag[1514]:
	elif flag[1346]:
	elif flag[1342]:
		LookPointFlagsSet look_point[0] 0x0001
	elif flag[1307]:
	elif flag[1292]:
		LookPointFlagsSet look_point[0] 0x0001
	elif flag[1282]:
	elif flag[1280]:
	elif flag[1055]:
	elif flag[1040]:
	elif flag[1024]:
	elif flag[801]:
	if system[0] == 106:
		if flag[1536] && !flag[1554]:
			if !flag[1077]:
				Event fn[0,40]
		elif flag[1024] && !flag[1040]:
			if !flag[1076]:
				Event fn[0,39]
	if flag[1792]:
		MapColor 0x00C8D2FF 0ms
	Return

fn[4]:
	Call fn[0,5]
	Return

fn[5]:
	TextStart char[0]
	if flag[1792]:
		if !flag[0]:
			TextTalk char[0] {
				遺跡中的那口大鐘……
				到底是怎麼回事呢……{wait}
			}
			TextWait
			TextTalk char[0] {
				（如果那個鐘是古代遺物的話……
				　引來那些人插手的
				　可能性就很高了。）{wait}
			}
			TextWait
			TextTalk char[0] {
				（……哼，豈能讓他們得逞。
				　我絕對不會允許那種人
				　進入克洛斯貝爾。）{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				……嗯，那就這樣吧。
				關於那個遺跡與『星見之塔』，
				我們這邊也會進行調查。{wait}
			}
			TextWait
	elif flag[1566]:
		if !flag[0]:
			Call fn[0,6]
		else:
			TextTalk char[0] {
				能夠召喚出『惡魔』的鐘……
				那個遺跡中居然還
				存在著這種東西嗎……{wait}
			}
			TextWait
	elif flag[1554]:
		if !flag[0]:
			TextTalk char[0] {
				聽說黑手黨之間發生了鬥爭啊。{wait}
			}
			TextWait
			TextTalk char[0] {
				沒有將普通市民捲入，也算是萬幸……
				但這種行為實在是太愚蠢了……{wait}
			}
			TextWait
			TextTalk char[0] {
				女神啊！請把人們從鬥爭
				的因果迴圈中解放出來吧……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				沒有將無辜的市民捲入，
				實在是太好了。{wait}
			}
			TextWait
			TextTalk char[0] {
				女神啊！請把人們從鬥爭
				的因果迴圈中解放出來吧……{wait}
			}
			TextWait
	elif flag[1536]:
		TextTalk char[0] {
			……嗯……是錯覺嗎？
			似乎從山道那邊傳來了鐘聲。{wait}
		}
		TextWait
		TextTalk char[0] {
			奇怪，瑪因茲那邊
			應該沒有鐘樓之類的地方啊……{wait}
		}
		TextWait
		TextTalk name[8] {
			#0505F（……鐘……？
			　有點在意呢……）{wait}
		}
		TextWait
	elif flag[1346]:
		if !flag[0]:
			TextTalk char[0] {
				你們好像已經和
				瑪布林修女談過了啊。{wait}
			}
			TextWait
			TextTalk char[0] {
				……事情已經解決了嗎？{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F是、是的。
				得到了貴重的情報，非常感謝。{wait}
			}
			TextWait
			TextTalk char[0] {
				……那就好，
				歡迎隨時再來。{wait}
			}
			TextWait
			TextTalk char[0] {
				空之女神啊，請引導他們吧……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				要是有什麼煩惱，
				歡迎隨時前來拜訪。{wait}
			}
			TextWait
			TextTalk char[0] {
				空之女神啊，請引導他們吧……{wait}
			}
			TextWait
	elif flag[1342]:
		if !flag[0]:
			TextTalk char[0] {
				歡迎來到
				克洛斯貝爾大教堂。{wait}
			}
			TextWait
			TextTalk name[82] {
				#1110F……啊，長鬍子老爺爺！
				嘿嘿，我可以摸一下嗎？{wait}
			}
			TextWait
			CharTurnToChar char[0] name[82] 500deg/s
			Emote char[0] 0mm 2000mm 38 38 250ms 1
			CharTurnToChar char[0] name[82] 500deg/s
			Sleep 1000ms
			TextTalk char[0] {
				唔……{wait}
			}
			TextWait
			TextTalk name[0] {
				#0011F等一下，琪、琪雅！{wait}
			}
			TextWait
			if flag[1356]:
				TextTalk name[1] {
					#0103F真、真是十分抱歉，大主教。
					這孩子太沒禮貌了……{wait}
				}
				TextWait
			elif flag[1357]:
				TextTalk name[2] {
					#0203F……失禮了。
					請您原諒，她畢竟只是個小孩子……{wait}
				}
				TextWait
			elif flag[1358]:
				TextTalk name[3] {
					#0303F真、真對不起，大主教。{wait}
				}
				TextWait
			TextTalk char[0] {
				哪裡……不用介意。{wait}
			}
			TextWait
			TextTalk char[0] {
				對於小孩子來說，
				活潑有精神就是最好的。{wait}
			}
			TextWait
			TextTalk char[0] {
				女神啊，請賜予這孩子祝福……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				對於小孩子來說，活潑有精神就是最好的。{wait}
			}
			TextWait
			TextTalk char[0] {
				女神啊，請賜予這孩子祝福……{wait}
			}
			TextWait
	elif flag[1307]:
		if !flag[0]:
			TextTalk char[0] {
				好了……
				今晚的彌撒結束之後，
				創立紀念慶典的所有活動便將圓滿落幕。{wait}
			}
			TextWait
			TextTalk char[0] {
				今年也有很多人前來參加彌撒呢，
				願女神的祝福與他們同在……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				今年的紀念慶典
				也來了很多參加彌撒的人。
				願女神的祝福與他們同在……{wait}
			}
			TextWait
	elif flag[1292]:
		if !flag[0]:
			TextTalk char[0] {
				有一個看起來像是帝國政府要員的男人
				在深夜造訪大教堂。{wait}
			}
			TextWait
			TextTalk char[0] {
				似乎是看中了七耀教會的影響力，
				想要拉攏
				身為大主教的我……{wait}
			}
			TextWait
			TextTalk char[0] {
				我以嚴厲的呵斥將他趕了出去。{wait}
			}
			TextWait
			TextTalk char[0] {
				身為空之女神僕人的我
				必須要徹底保持中立。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
