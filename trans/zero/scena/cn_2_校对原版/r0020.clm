fn[3]:
	ED7_F2 1
	SystemFlagsSet 0x08000000
	if !flag[2050]:
		SoundPlay sound[14] 0 100 0
		ED7ObjPlay object[0] 0 30 0 0
		Sleep 500ms
		if ItemAdd item[60] 1:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextSetName ""
			TextMessage name[742] {
				{color 0}已取得{item[60]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			TextSetPos -1 280 60 3
			FadeIn 300ms 0x00000000
			FlagSet flag[2050]
			ED7_DE 6
		else:
			FadeOut 300ms 0x00000000 100
			TextSetName ""
			TextMessage name[742] {
				寶箱內裝著{item[60]}{color 0}。
				但因持有物品已滿而放棄{item[60]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			SoundPlay sound[15] 0 100 0
			ED7ObjPlay object[0] 30 0 0 0
	else:
		FadeOut 300ms 0x00000000 100
		TextSetPos -1 -1 -1 -1
		TextSetName ""
		TextMessage name[742] {
			{0x06}{color 5}寶箱內空無一物。{color 0}{wait}
		}
		TextWait
		TextClose 0
		FadeIn 300ms 0x00000000
	Sleep 30ms
	TextEnd null
	SystemFlagsUnset 0x08000000
	Return

fn[4]:
	ED7_F2 1
	SystemFlagsSet 0x08000000
	FadeOut 300ms 0x00000000 100
	if !flag[2051]:
		SoundPlay sound[14] 0 100 0
		ED7ObjPlay object[1] 0 30 0 0
		Sleep 500ms
		ObjFrame object[1] 30
		SoundPlay sound[17] 0 100 0
		TextSetPos -1 -1 -1 -1
		SepithAdd 0 20
		SepithAdd 1 20
		SepithAdd 2 20
		SepithAdd 3 20
		SepithAdd 4 20
		SepithAdd 5 20
		SepithAdd 6 20
		TextMessage null {
			獲得了{color 2}#56I地之耀晶石×２０{color 0}
			{color 2}#57I水之耀晶石×２０{color 0}
			{color 2}#58I火之耀晶石×２０{color 0}
