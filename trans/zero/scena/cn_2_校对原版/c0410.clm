					我們就從正門進入大廳吧。{wait}
				}
				TextWait
			FlagSet flag[12]
		else:
			TextSetName ""
			TextMessage null {
				{color 5}伊莉雅似乎在舞臺那邊，
				去大廳裡面看看吧。{wait}
			}
			TextWait
			TextClose 0
			_59
	if flag[1072] && !flag[1280]:
