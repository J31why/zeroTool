		} {
			進入閑晃的話會給人家造成麻煩的，
			還是不要進去了。{wait}
		}
		TextWait
	if flag[1036] && !flag[1037]:
		if !flag[12]:
			if system[10] == 2:
				TextTalk name[2] {
					#0205F啊……{wait}
				} {
					#0200F能聽到舞臺上傳來的音樂。
