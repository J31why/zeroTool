		CharIdle self (7420, null, 8330) (12220, null, 13180) 1000mm/s
		Sleep 300ms
	Return

fn[3]:
	while 1:
		CharIdle self (52340, null, 48330) (55490, null, 50370) 1000mm/s
		Sleep 300ms
	Return

fn[4]:
	if flag[1792]:
		CharFlagsUnset char[4] 0x0080
		CharSetPos char[3] (10270, 3500, 13330) 315deg
		ForkFunc char[3] fork[0] fn[0,0]
		if !flag[4]:
			CharFlagsSet char[3] 0x0010
			CharFlagsSet char[4] 0x0010
