		CharFlagsSet char[1] 0x0080
		CharFlagsSet char[2] 0x0080
		CharFlagsSet char[3] 0x0080
		CharFlagsUnset char[5] 0x0080
		CharFlagsUnset char[7] 0x0080
	elif flag[1055]:
	elif flag[1040]:
		CharSetPos char[0] (10280, 3500, 14670) 180deg
		CharSetPos char[2] (10270, 3500, 13330) 0deg
		CharFlagsSet char[0] 0x0010
		CharFlagsSet char[2] 0x0010
	elif flag[1031]:
		CharFlagsUnset char[9] 0x0080
		CharFlagsUnset char[10] 0x0080
		CharSetPos char[0] (3880, 0, -500) 45deg
		CharSetPos char[2] (10270, 3500, 13330) 315deg
		CharSetPos char[3] (53980, 30, 49050) 135deg
		CharSetPos char[9] (9270, 3500, 14320) 135deg
		CharSetPos char[10] (8210, 3500, 14680) 135deg
		ForkFunc char[3] fork[0] fn[0,3]
