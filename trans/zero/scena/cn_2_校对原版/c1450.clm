			CharFlagsSet char[2] 0x0010
	elif flag[1024]:
		CharFlagsUnset char[9] 0x0080
		CharFlagsUnset char[10] 0x0080
		CharSetPos char[0] (5020, 0, -150) 315deg
	elif flag[768]:
	elif flag[533]:
		CharSetPos char[3] (51970, 0, 53350) 315deg
		ForkFunc char[3] fork[0] fn[0,0]
		if flag[3]:
			CharFlagsSet char[2] 0x0010
	elif flag[528]:
		CharSetPos char[2] (10060, 3500, 14220) 180deg
	else:
		CharSetPos char[2] (10060, 3500, 14220) 180deg
	if QuestTaskGet quest[3] 1 && !QuestTaskGet quest[3] 6 && !QuestFlagsGet quest[3] 0x40:
		Event fn[0,23]
	Return

fn[5]:
	if system[4] == 3:
		EntranceSetDisabled entrance[0] 0
		EntranceSetDisabled entrance[13] 1
	else:
		EntranceSetDisabled entrance[0] 1
		EntranceSetDisabled entrance[13] 0
	if flag[1037] && !flag[1038]:
		MapColor 0x00C8D2FF 0ms
	elif flag[1792]:
		MapColor 0x00C8D2FF 0ms
	else:
	ObjFlagsUnset object[4] 0x0010
	LookPointFlagsSet look_point[1] 0x0001
	ObjFlagsSet object[2] 0x0010
	if flag[525] && !flag[768]:
		LookPointFlagsUnset look_point[1] 0x0001
		ObjFlagsUnset object[2] 0x0010
	Return

fn[6]:
	TextStart self
	if flag[10]:
		TextTalk self {
			這幢公寓的空房
			現在應該只有一間哦。{wait}
		}
		TextWait
		TextTalk self {
			嗯，是二樓最左邊的那間。
			如果有些在意的話，
			就去看看吧。{wait}
		}
		TextWait
	elif flag[1792]:
		TextTalk char[0] {
			那麼，今天的晚飯
			該吃什麼好呢……{wait}
		}
		TextWait
		TextTalk char[0] {
			不管發生什麼事件，
			飯總是要吃的。{wait}
		}
		TextWait
	elif flag[1566]:
		if flag[0]:
			TextTalk char[0] {
				從今天早上開始，那些不良少年們
				好像就一直在尋找同伴呢。{wait}
			}
			TextWait
			TextTalk char[0] {
				嗯，雖然事不關己，
				但終歸還是有些擔心啊……{wait}
			}
			TextWait
		else:
			TextTalk char[0] {
				從今天早上開始，那些不良少年們
				好像就一直在尋找同伴呢。{wait}
			}
			TextWait
			TextTalk char[0] {
				不過，既然是舊市街的年輕人，
				大概只是跑到什麼地方去玩了吧……{wait}
			}
			TextWait
			TextTalk char[0] {
				但至少應該把自己的行程
				告訴同伴一聲啊。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1554]:
		TextTalk char[0] {
			剛才去街上時，
			被不良幫派的成員纏住了呢。{wait}
		}
		TextWait
		TextTalk char[0] {
			嗯……那個藍頭髮的孩子
			應該只是個新入夥的小弟而已，
			但他的眼神莫名地兇狠呢……{wait}
		}
		TextWait
	elif flag[1536]:
		if flag[0]:
			TextTalk char[0] {
				那些不良幫派的成員
				安分了不少呢。{wait}
			}
			TextWait
			TextTalk char[0] {
				終於可以和平相處了啊。{wait}
			}
			TextWait
		else:
			TextTalk char[0] {
				最近這一個月，那些不良幫派
				的孩子們好像安分了不少呢。{wait}
			}
			TextWait
			TextTalk char[0] {
				再也不像以前那樣，
				整天爭鬥吵鬧個不停了。{wait}
			}
			TextWait
			TextTalk char[0] {
				不過……我聽說他們的
				內部關係變得很壞。{wait}
			}
			TextWait
			TextTalk char[0] {
				你們幾個，如果要在舊市街辦事，
				可要多加小心哦。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1342]:
		if flag[0]:
			TextTalk char[0] {
				在這個舊市街，沒有哪個年輕人
				比那個孩子更有出息了。{wait}
			}
			TextWait
			TextTalk char[0] {
				呵呵，她可真是個好孩子呀。{wait}
			}
			TextWait
		else:
			TextTalk char[0] {
				今天早上，我在門口
				突然遇到了莉夏。{wait}
			}
			TextWait
			TextTalk char[0] {
				她說稍後要去和朋友
				一起玩呢。{wait}
			}
			TextWait
			TextTalk char[0] {
				呵呵，她的性格開朗又樂觀，
				真是個好孩子啊。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1307]:
		if flag[0]:
			TextTalk char[0] {
				今天就去見見
				市長好了。{wait}
			}
			TextWait
			TextTalk char[0] {
				呵呵，因為閉幕式既不是很擠，
				而且還能免費參加哦。{wait}
			}
			TextWait
		else:
			TextTalk char[0] {
				那麼，今天就去參加
				閉幕式好了。{wait}
			}
			TextWait
			TextTalk char[0] {
				呵呵，我每年都會
				去觀看閉幕式的。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1362]:
		if flag[0]:
			TextTalk char[0] {
				雖然住在這種破舊的公寓中，
				但這裡是最讓我放鬆的。{wait}
			}
			TextWait
			TextTalk char[0] {
				真是不可思議啊。{wait}
			}
			TextWait
		else:
			TextTalk char[0] {
				我出去觀看了遊行，
				真是走得我筋疲力盡啊。{wait}
			}
			TextWait
			TextTalk char[0] {
				雖然住在這種破舊的公寓中，
				但這裡是最讓我放鬆的。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1292]:
		if flag[0]:
			TextTalk char[0] {
				即使在我們舊市街居民看來，
				麥克道爾市長也是一位傑出的人物呢。{wait}
			}
			TextWait
		else:
			TextTalk char[0] {
				麥克道爾市長也是一位傑出的人物啊。{wait}
			}
			TextWait
			TextTalk char[0] {
				即使發生了那種事件，也仍然為了
				克洛斯貝爾的政治而竭盡全力，
				還將紀念慶典也順利舉辦成功了。{wait}
			}
			TextWait
			TextTalk char[0] {
				真是位堅強剛毅的人啊。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1282]:
		if flag[0]:
			TextTalk char[0] {
				一會不如去給考試的孩子
				送些慰問品吧。{wait}
			}
			TextWait
			TextTalk char[0] {
				如果附近的鄰居們有什麼困難，
				我可無法視而不見啊。{wait}
			}
			TextWait
		else:
			TextTalk char[0] {
				這所公寓內的住戶們好像也
				都很享受紀念慶典啊。
				呵呵，不錯不錯。{wait}
			}
			TextWait
			Emote char[0] 0mm 2000mm 24 27 250ms 0
			Sleep 1500ms
			EmoteStop char[0]
			TextTalk char[0] {
				不對，好像把一個人給忘了。{wait}
			}
			TextWait
			TextTalk char[0] {
				有個要考試的孩子
				一個人在家裡，
				好像很寂寞呢。{wait}
			}
			TextWait
			TextTalk char[0] {
				哎呀呀，一會就去給他
				送點慰問品吧。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1055]:
		if flag[0]:
			TextTalk char[0] {
				雖然是舊市街的居民，
				但也想在慶典期間奢侈一番呢。{wait}
			}
			TextWait
			TextTalk char[0] {
				必須要趁現在
				多攢些私房錢啊。{wait}
			}
			TextWait
		else:
			TextTalk char[0] {
				我的私房錢應該是
				放在這裡的，嗯……{wait}
			}
			TextWait
			TextTalk char[0] {
				呵呵，為了紀念慶典，
				我正在存錢呢。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1040]:
		if !flag[3]:
			Call fn[0,12]
		else:
			CharTurnToChar self field_party[0] 0deg/s
			TextTalk self {
				莉夏那樣的孩子
				居然會住在舊市街，
				真是出乎我的意料啊。{wait}
			}
			TextWait
			TextTalk self {
				哈哈哈，那群奸詐的可惡議員，
				嘴上嘟嘟囔囔說個不停，
				但最終還是打道回府了。{wait}
			}
			TextWait
			TextTalk self {
				這都是托那個性格和善的
				孩子的福啊。{wait}
			}
			TextWait
			CharTurnTo char[0] 180deg 0deg/s
	elif flag[1031]:
		if !flag[0]:
			TextTalk self {
				那些議員好像去了
				柯洛娜那裡啊……{wait}
			}
			TextWait
			TextTalk self {
				我們都已經習慣了，
				總能應付過去……
				柯洛娜沒事吧……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				從很久以前就一直有
				重新開發舊市街的計畫……
				所以議員時不時就會前來騷擾。{wait}
			}
			TextWait
			TextTalk self {
				希望柯洛娜能把
				他們應付過去啊……{wait}
			}
			TextWait
	elif flag[1024]:
		TextTalk self {
			（哎呀呀，又有議員
			　來騷擾了啊。）{wait}
		}
		TextWait
		TextTalk self {
			（動不動就來煩人……
			　想辦法應付過去吧。）{wait}
		}
		TextWait
	elif flag[801]:
		TextTalk char[0] {
			今天也是個好天氣啊。{wait}
		}
		TextWait
		TextTalk char[0] {
			不然就去東側大道看看，
			到店裡拿點他們不要的東西好了。{wait}
		}
		TextWait
	elif flag[777]:
		TextTalk char[0] {
			聽說有一個
			年輕女孩搬來了。{wait}
		}
		TextWait
		TextTalk char[0] {
			也許和我一樣，
			是個無親無故的人吧。{wait}
		}
		TextWait
	elif flag[768]:
		if flag[0]:
			TextTalk char[0] {
				我已經在這舊市街
				住了六十年了。{wait}
			}
			TextWait
			TextTalk char[0] {
				事到如今，也不想再
				搬到其它地方生活了。{wait}
			}
			TextWait
		else:
			TextTalk char[0] {
				我已經在這舊市街
				住了六十年了。{wait}
			}
			TextWait
			TextTalk char[0] {
				呵呵，在那些最近新建起來的
				商業街，歡樂街出現之前，
				這一帶也是充滿活力的。{wait}
			}
			TextWait
			TextTalk char[0] {
				而現在這裡簡直算是被政府
				徹底拋棄的地方了，
				但即使如此，我也沒打算離開。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[533]:
		if flag[0]:
			TextTalk char[0] {
				在舊市街生活的人們，
				都有著各自的苦衷。{wait}
			}
			TextWait
			TextTalk char[0] {
				但誰都不會被排斥，這就是舊市街的特色。不過，
				正因為居民魚龍混雜，這裡時常會發生許多糾紛。{wait}
			}
			TextWait
		else:
			TextTalk char[0] {
				正在找工作的失業者，
				或者是被人追債的破落戶……{wait}
			}
			TextWait
			TextTalk char[0] {
				在這舊市街之中，
				也有很多來自外國的異鄉人。{wait}
			}
			TextWait
			TextTalk char[0] {
				不過，只要生活在這裡，大家就都是同伴。
				大家要相互支撐，和睦地生活下去。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[528]:
		if flag[0]:
