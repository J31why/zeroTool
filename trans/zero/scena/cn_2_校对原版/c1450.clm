	elif flag[1342]:
		CharSetPos char[6] (-48650, 200, 4460) 270deg
		CharFlagsUnset char[8] 0x0080
		if !flag[1433]:
			CharFlagsSet char[8] 0x0010
	elif flag[1292]:
