fn[17]:
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"對話" // 0
			"請求同行" // 1
			"放棄" // 2
		MenuWait var[0]
		MenuClose menu[0]
		FadeIn 300ms 0x00000000
		switch var[0]:
			case 0:
				var[0] = 99
				TextTalk char[5] {
					#1200F嗚嚕嚕嚕……
					嗚嚕嚕嚕嚕嚕……{wait}
				}
				TextWait
				TextTalk name[2] {
					#0200F『如果想找什麼結婚戒指的話，
					　就來請求我和你們同行吧。』{wait}
				} {
					『可以暫時陪你們一陣。』
					……牠這麼說。{wait}
				}
				TextWait
				break
			case 1:
				if QuestTaskGet quest[21] 1:
					TextTalk name[0] {
						#0000F好，那我們
						這就去歡樂街吧。{wait}
					}
					TextWait
				else:
					TextTalk name[0] {
						#0000F好，那我們
						這就去歡樂街吧。{wait}
					}
					TextWait
					TextTalk name[1] {
						#0100F副局長離開賭場的時候，
						戒指好像還戴在他的手上呢……
						就先從那附近找起吧。{wait}
					}
					TextWait
				FadeOut 1000ms 0x00000000 255
				FadeWait
				BgmStop 4000ms
				BgmWait
				PartyAdd name[27] null 255
				FlagSet flag[1182]
				Sc_C4Set 4096
				FlagSet flag[741]
				NewScene "scena/c0400.bin" 0 0 0
				Hcf
				break
	Return

