	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if !flag[10]:
		TextTalk name[82] {
			#1110F蘭迪，那我就
			出門啦～！{wait}
		}
		TextWait
		TextTalk char[10] {
			#0302F噢！打起精神出發吧！{wait}
		}
		TextWait
		Sleep 300ms
		if flag[1356]:
			TextTalk char[10] {
				#0300F……羅伊德、大小姐，
				小琪就交給你們啦。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F嗯，交給我們好了。{wait}
			}
			TextWait
			TextTalk name[1] {
				#0100F我們會儘早
				回來的。{wait}
			}
			TextWait
		elif flag[1357]:
			TextTalk char[10] {
				#0300F……羅伊德、小緹，
				小琪就交給你們啦。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F嗯，交給我們好了。{wait}
			}
			TextWait
			TextTalk name[2] {
				#0202F我們會儘早
				回來的。{wait}
			}
			TextWait
		FlagSet flag[10]
	else:
		TextTalk char[10] {
			#0303F那麼，就趁現在
			看一看《熱辣寶貝》寫真集吧。{wait}
		} {
			#0309F這一周以來一直都
			緊繃著神經，沒法好好放鬆啊。{wait}
		}
		TextWait
		TextTalk name[0] {
			#0006F（蘭迪，在小孩子面前
			　看這種不良雜誌，是不是有點……）{wait}
		}
		TextWait
		TextTalk name[82] {
			#1105F？？？{wait}
		}
		TextWait
	CharSetChipPattern self 0
	TextEnd self
	Return

