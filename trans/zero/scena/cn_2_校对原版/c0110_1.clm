fn[19]:
	TextTalk name[0] {
		#0000F賽特，今天真是幫大忙啦。
		你那敏銳的嗅覺真是名不虛傳。{wait}
	}
	TextWait
	TextTalk name[2] {
		#0200F嗯，超乎想像呢。{wait}
	} {
		在以後的物證調查之類工作中
		似乎也能發揮作用呢。{wait}
	}
	TextWait
	TextTalk char[5] {
		#1200F嗚嚕嚕嚕……{wait}
	}
	TextWait
	TextTalk name[2] {
		#0200F『下次找我時最好接些
		　稍微像樣一點的工作！』
		……牠這樣說。{wait}
	}
	TextWait
	TextTalk name[3] {
		#0300F哈哈，被牠批評了嗎。{wait}
	}
	TextWait
	TextTalk name[1] {
		#0100F這次牠可是比我們
		還要活躍啊。{wait}
	} {
		今後也請多關照啦，
		賽特。{wait}
	}
	TextWait
	FlagSet flag[1181]
	Return

fn[20]:
	EventBegin 0
	CrossFade 500ms
	CamSetDistance 15900 1550 9800 0ms
	ED7CamRotate 45deg 18deg 0deg 0ms
	CamPers 400 0ms
	CamZoom 24500 0ms
	CharSetPos name[0] (15200, 850, 9800) 45deg
	CharSetPos name[1] (15900, 850, 9100) 45deg
	CharSetPos name[2] (14100, 850, 9500) 45deg
	CharSetPos name[3] (15600, 850, 8000) 45deg
	FadeWait
	TextTalk name[0] {
		#0000F#6P那麼……
		只要用這個終端將報告
		發送給警察局總部就可以了吧？{wait}
	}
	TextWait
	TextTalk name[2] {
		#0202F#6P是的，
		趕快試試吧。{wait}
	}
	TextWait
	ED7_E3 10
	FadeOut 300ms 0x00000000 255
	FadeWait
	ED7_E3 5
	var[3] = 0
	NextFrame
	while var[3] != 255:
		var[3] = ED7_E3 0
		switch var[3]:
			case 0:
				if QuestFlagsGet quest[1] 0x20:
					QuestList quest[1] quest[2] quest[3] quest[53]
				else:
					QuestList quest[1]
				break
			case 1:
				SystemFlagsSet 0x40000000
				ED7_E3 7
				Sleep 500ms
				TextSetName "接待小姐芙蘭"
				SoundPlay sound[2062] 255 100 0
				TextMessage null {
					您好，這裡是克洛斯貝爾警察局～！{wait}
				}
				TextWait
				if ED7_E3 4:
					SoundPlay sound[2067] 255 100 0
					TextMessage null {
						那麼，我將對各位的報告進行處理～{wait}
					}
					TextWait
					TextClose 0
					var[6] = system[47]
					ED7_E3 12
					if var[6] != system[47]:
						switch system[47]:
							case 14:
								SoundPlay sound[2075] 255 100 0
								TextMessage null {
									級別１ｓｔ──
									羅伊德警官，實在太厲害了！{wait}
								}
								TextWait
								break
							case 13:
								SoundPlay sound[2074] 255 100 0
								TextMessage null {
									級別２ｎｄ──
									羅伊德警官，好厲害呢！{wait}
								}
								TextWait
								break
							case 12:
								SoundPlay sound[2073] 255 100 0
								TextMessage null {
									級別３ｒｄ──
									羅伊德警官，做得很好啊！{wait}
								}
								TextWait
								break
							default:
								SoundPlay sound[2073] 255 100 0
								TextMessage null {
									級別３ｒｄ──（測試）
									羅伊德警官，做得很好啊！{wait}
								}
								TextWait
								break
						SoundPlay sound[2076] 255 100 0
						TextMessage null {
							獎勵物品
							也會馬上給你們送去的～！{wait}
						}
						TextWait
						SoundPlay sound[2077] 255 100 0
						TextMessage null {
							大家辛苦了～！
							以後也請隨時來向我報告～{color 0}{wait}
						}
						TextWait
					else:
						SoundPlay sound[2078] 255 100 0
						TextMessage null {
							報告就是以上這些吧～{wait}
						}
						TextWait
						SoundPlay sound[2079] 255 100 0
						TextMessage null {
							那麼，以後如果完成了新的委託，
							請再來向我報告吧～{color 0}{wait}
						}
						TextWait
					FlagSet flag[13]
				elif flag[13]:
					SoundPlay sound[2063] 255 100 0
					TextMessage null {
						哎呀……
						剛才已經報告過了哦。{wait}
					}
					TextWait
					SoundPlay sound[2064] 255 100 0
					TextMessage null {
						等完成了新的委託之後再來報告吧～{color 0}{wait}
					}
					TextWait
				else:
					SoundPlay sound[2065] 255 100 0
					TextMessage null {
						哎呀，好像並沒有可以
						報告的委託哦～{wait}
					}
					TextWait
					SoundPlay sound[2066] 255 100 0
					TextMessage null {
						請下次再來報告吧～{color 0}{wait}
					}
					TextWait
				TextClose 0
				ED7_E3 8
				SystemFlagsUnset 0x40000000
				if !QuestTaskGet quest[1] 2:
					Sleep 1000ms
					TextMessage name[0] {
						{color 0}#0002F原來如此……
						轉瞬之間就完成了啊。{wait}
					}
					TextWait
					TextMessage name[1] {
						#0109F今後如果完成了新的委託，
						再用同樣的方式進行報告就可以了。{wait}
					}
					TextWait
					Sleep 200ms
					SoundPlay sound[824] 0 100 0
					Sleep 1000ms
					TextMessage name[2] {
						#0205F啊……
						新的支援請求好像
						又發送過來了。{wait}
					} {
						#0202F慎重起見，還是確認一下吧。{wait}
					}
					TextWait
					QuestTaskSet quest[1] 2
				break
			case 255:
				if QuestTaskGet quest[1] 2 && !flag[533] && (!QuestFlagsGet quest[2] 0x02 | !QuestFlagsGet quest[3] 0x02 | !QuestFlagsGet quest[53] 0x02):
					TextMessage name[2] {
						{color 0}#0203F新的支援請求好像
						又發送過來了。{wait}
					} {
						#0200F慎重起見，還是確認一下吧。{wait}
					}
					TextWait
					var[3] = 0
				break
	ED7_E3 6
	FadeIn 300ms 0x00000000
	FadeWait
	ED7_E3 11
	if QuestTaskGet quest[1] 2:
		Call fn[1,21]
	else:
		EventEnd 5
	Return

fn[21]:
	Sleep 500ms
	TextTalk name[3] {
		#0301F#12P好像發來了不少任務呢……
		地下區域又出現魔獸了嗎？{wait}
	}
	TextWait
	TextTalk name[1] {
		#0101F這就是所謂的『通緝魔獸』吧。{wait}
	} {
		這種魔獸好像一般都是由協會的
		遊擊士負責討伐的……{wait}
	}
	TextWait
	Emote name[0] 0mm 2000mm 24 27 250ms 0
	Sleep 2000ms
	EmoteStop name[0]
	CharTurnTo name[0] 180deg 500deg/s
	Sleep 300ms
	TextTalk name[0] {
		#0003F#5P……那個，各位。{wait}
	} {
		#0001F我們來試著自己對付
		這個『通緝魔獸』吧，如何？{wait}
	}
	TextWait
	Emote name[1] 0mm 2000mm 38 38 250ms 1
	Emote name[2] 0mm 2000mm 38 38 250ms 1
	Emote name[3] 0mm 2000mm 38 38 250ms 1
	Sleep 1000ms
	Fork name[1] fork[1]:
		CharTurnToChar self name[0] 500deg/s
	Sleep 50ms
	Fork name[2] fork[1]:
		CharTurnToChar self name[0] 500deg/s
	Sleep 50ms
	Fork name[3] fork[1]:
		CharTurnToChar self name[0] 500deg/s
	Sleep 300ms
	TextTalk name[1] {
		#0105F那個……{wait}
	}
	TextWait
	TextTalk name[3] {
		#0305F#12P是要為前天的事情出口氣嗎？{wait}
	}
	TextWait
	TextTalk name[0] {
		#0006F#5P嗯，那時多虧了
		亞里歐斯・馬克萊因的相救，
		不過……{wait}
	} {
		#0001F如果我們事先做好充足的準備，
		憑自己的力量應該也能將它擊退的。{wait}
	} {
		畢竟是工作的第一天，機會難得，
		就當是開個好頭，怎麼樣？{wait}
	}
	TextWait
	TextTalk name[1] {
		#0103F嗯～確實呢……{wait}
	}
	TextWait
	TextTalk name[2] {
		#0204F#6P雖然很麻煩，
		但這麼說也有道理呢。{wait}
	}
	TextWait
	TextTalk name[3] {
		#0304F#12P這主意也不錯嘛。
		而且畢竟被搶了風頭，要把面子挽回才行。{wait}
	} {
		#0300F那麼，準備完畢之後，
		我們就去車站前的入口吧。{wait}
	}
	TextWait
	TextTalk name[0] {
		#0000F#5P就這麼辦吧！{wait}
	}
	TextWait
	FadeOut 1000ms 0x00000000 255
	FadeWait
	SoundPlay sound[828] 0 100 0
	TextSetPos -1 -1 -1 -1
	TextSetName ""
	TextMessage null {
		{color 5}在支援請求中，會有一些緊急度較高，
		必須要接受的任務。{wait}
	}
	TextWait
	TextMessage null {
		{color 5}這種任務都會附有『緊急』的標示，
		只有將其完成，才能使主線劇情繼續進展。{wait}
	}
	TextWait
	TextMessage null {
		{color 5}除此之外的支援請求
		並無全部完成的必要，
		但若超過期限則會失效，還請注意。{wait}
	}
	TextWait
	TextClose 0
	_59
	TextSetPos -1 280 60 3
	CamSetDistance 15730 1850 9350 0ms
	ED7CamRotate 45deg 22deg 0deg 0ms
	CamPers 340 0ms
	CamZoom 27500 0ms
	CharSetPos field_party[0] (15730, 850, 9350) 225deg
	CharSetPos field_party[1] (15730, 850, 9350) 225deg
	CharSetPos field_party[2] (15730, 850, 9350) 225deg
	CharSetPos field_party[3] (15730, 850, 9350) 225deg
