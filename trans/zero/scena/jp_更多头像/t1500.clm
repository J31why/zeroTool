			{}  あればよさそうだ。）{wait}
		}
		TextWait
	QuestTaskSet quest[44] 4
	if QuestTaskGet quest[44] 0 && QuestTaskGet quest[44] 1 && QuestTaskGet quest[44] 2 && QuestTaskGet quest[44] 4:
		QuestTaskSet quest[44] 5
		TextTalk name[0] {
			#12P#0000F（プレゼントの材料になりそうな物も揃ったし
			{}  包装用の箱とリボンも手に入ったな……）{wait}
		} {
			（よし、そろそろシズクちゃんの所に
			{}  持っていってあげよう。）{wait}
		}
		TextWait
	FadeOut 1000ms 0x00000000 255
	FadeWait
	CharSetPos field_party[0] (-37600, 3000, 16800) 270deg
	CharFlagsSet field_party[4] 0x0080
	CharFlags2Set field_party[4] 0x8000
	LookPointFlagsSet look_point[8] 0x0001
	Sleep 500ms
	EventEnd 5
	Return

fn[64]:
	EventBegin 1
	if flag[784] && !flag[793]:
		TextTalk name[0] {
			#0001Fこっちは街道の方だ……{wait}
		} {
			#0003Fさすがにセシル姉を
			連れては行けないよ。{wait}
		}
		TextWait
		if !flag[785]:
			TextTalk name[53] {
				#1300Fふふ、魔獣騒ぎの
				調査だったわよね。{wait}
			} {
				付いてきて。
				病院棟の２階に案内するわ。{wait}
			}
			TextWait
		else:
			TextTalk name[53] {
				#1300Fふふ、魔獣騒ぎの
				調査だったわよね。{wait}
			} {
				現場は病院棟の屋上よ。
				案内するわね。{wait}
			}
			TextWait
	if flag[793] && !flag[799]:
		TextTalk name[0] {
			#0000Fこっちは街道の方だ……{wait}
		} {
			#0003F帰る前にセシル姉に
			報告をしないとな。{wait}
		}
		TextWait
	if flag[799] && !flag[1024]:
		TextTalk name[0] {
			#0000Fもう夕方だし、
			帰りはバスを使おう。{wait}
		} {
			バス停を調べれば
			次のバスの時刻が分かるはずだ。{wait}
		}
		TextWait
	if flag[1346] && !flag[1349]:
		TextTalk name[0] {
			#0000Fおっと……
			せっかく来たんだし、
			病院で相談してみないとな。{wait}
		} {
			受付で『神経科』について
			問い合わせてみよう。{wait}
		}
		TextWait
	if flag[1349] && !flag[1351]:
		TextTalk name[0] {
			#0003Fキーアを連れて
			街道に出るわけにはいかない……{wait}
		} {
			#0000Fそれにヨアヒム先生に
			記憶について相談してみないとな。{wait}
		}
		TextWait
	if flag[1351] && !flag[1536]:
		if !flag[11]:
			TextTalk name[0] {
				#0003F……キーアは多分、
				病院の敷地内にいるはずだ。{wait}
			} {
				#0001F早いところ探し出さないとな。{wait}
			}
			TextWait
		else:
			TextTalk name[0] {
				#0001F早くキーアを探し出そう。
				病院の敷地内にいるはずだ。{wait}
			}
			TextWait
	Sleep 50ms
	CharSetPos field_party[0] (-61000, 0, 0) 90deg
	EventEnd 4
	Return

