			TextTalk char[1] {
				はいそこ、座れ座れ～。{wait}
			}
			TextWait
			TextTalk char[1] {
				立ってると邪魔になんだろ。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk char[1] {
				俺っちはいま手一杯だ。
				注文ならマスターに言いな～！{wait}
			}
			TextWait
			TextTalk char[1] {
				すっげー怖ぇ顔してるけどな。
				はははは……！{wait}
			}
			TextWait
	elif flag[1292]:
		if !flag[1]:
			TextTalk char[1] {
				うっす！　警察の人か。
				お仕事ご苦労さん！{wait}
			}
			TextWait
			TextTalk char[1] {
				何か食べてくか？
				今日は大変だろ～。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk char[1] {
				マスターは昨日から
