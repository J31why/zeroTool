fn[9]:
	if flag[1307]:
		if !flag[1]:
			TextTalk char[1] {
				いやあ、今年は色々あった。{wait}
			}
			TextWait
			TextTalk char[1] {
				サンサンが店を手伝い始めて
				初めての記念祭だったし……{wait}
			}
			TextWait
			TextTalk char[1] {
				お陰で客入りは倍増した㈱{wait}
			}
			TextWait
			TextTalk char[1] {
				店長は気が気じゃ
				なかったみたいだけどな。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk char[1] {
				今年はサンサンが
