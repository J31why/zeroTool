			}
			TextWait
	elif flag[1282]:
		if !flag[1]:
			TextTalk char[1] {
				昨日は旧市街の方で
				ドタバタがあったらしいな。{wait}
			}
			TextWait
			TextTalk char[1] {
				客が興奮して話してたぜ。
				一体何があったんだ？{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk char[1] {
				昨日は旧市街の方で
				ドタバタがあったらしいな。{wait}
			}
			TextWait
			TextTalk char[1] {
				客は面白かったとか言ってたが
