fn[10]:
	TextStart self
	if flag[1307]:
		TextTalk self {
			#15004Fせっせっ……
			今日は創立記念祭の最終日よ。{wait}
		} {
			#15002Fお客さんも張り切って食べていくの。
			最後に思いっきり楽しむんだって。{wait}
		}
		TextWait
	elif flag[1362]:
		if !flag[2]:
			TextTalk self {
				#15003Fパパが今日は
				宿の掃除をしろというの。{wait}
			} {
				#15014Fパパ、どうしたんだろ。
				そんなに掃除する所もないよ……？{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			TextTalk self {
				#15003F宿の掃除なんて
				すぐに済んでしまうのに。{wait}
			} {
				#15006Fふう、パレード見たかったなぁ……
				もう終わっちゃったのかな……{wait}
			}
			TextWait
	elif flag[1292]:
		if !flag[2]:
			TextTalk self {
				#15000Fリーシャ、今ごろ
				公演ガンバッてるかな～。{wait}
			} {
				#15002Fふふっ、きっと大勢のお客さんに
				拍手されているに違いないね。{wait}
			} {
				#15009F私も負けてられないよ。
				お仕事頑張らなくっちゃ♪{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			TextTalk self {
				#15000F今日はお泊りの部屋も満室だったの。{wait}
			} {
				#15004Fせっせっ……
				はりきって綺麗にしないとね。{wait}
			}
			TextWait
	elif flag[1282]:
		TextTalk self {
			#15006Fパパったら
			またお客さんをおどかして……{wait}
		} {
			#15001Fダメよ、お客さんには
			いつもスマイルでないと。{wait}
		}
		TextWait
	elif flag[1280]:
		if !flag[2]:
			TextTalk self {
				#15002Fあ、いらっしゃい～！{wait}
			} {
				#15006Fふう、お客さん多くてびっくり。
				注文をとるのも大変ね。{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			Emote self 0mm 2000mm 40 43 100ms 3
			Sleep 1200ms
			TextTalk self {
				#15006Fうう……手が足りないよ～。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[11]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if flag[1307]:
		if !flag[3]:
			TextTalk self {
				もぐもぐ……
				みんな盛り上がってるなぁ。{wait}
			}
			TextWait
			TextTalk self {
				俺は今日も変わらず
				共和国までドライブだ。{wait}
			}
			TextWait
			TextTalk self {
				運送業には休みがないんだよな～。{wait}
			}
			TextWait
			FlagSet flag[3]
		else:
			TextTalk self {
				もぐもぐ……
				盛り上がってる奴が羨ましいぜ。{wait}
			}
			TextWait
	elif flag[1362]:
		if !flag[3]:
			TextTalk self {
				やれやれ、この人出じゃ
				表通りを走るのは難しそうだな。{wait}
			}
			TextWait
			TextTalk self {
				事故っても困るし
				裏通りから街道に出るとするか。{wait}
			}
			TextWait
			FlagSet flag[3]
		else:
			TextTalk self {
				やれやれ、今日の運送は
				だいぶ遅れちまいそうだな。{wait}
			}
			TextWait
	elif flag[1292]:
		if !flag[3]:
			TextTalk self {
				今日はパレードがあるんだってな。{wait}
			}
			TextWait
			TextTalk self {
				ウチの会社も
