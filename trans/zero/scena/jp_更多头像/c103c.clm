		FlagSet flag[8]
	elif flag[1362]:
		FlagSet flag[7]
	elif flag[1292]:
		FlagSet flag[7]
	elif flag[1282]:
		FlagSet flag[8]
	elif flag[1280]:
		FlagSet flag[8]
	Return

fn[5]:
	if flag[1307]:
		Call fn[0,8]
	elif flag[1362]:
		Call fn[0,6]
	elif flag[1292]:
		Call fn[0,6]
	elif flag[1282]:
		Call fn[0,8]
	elif flag[1280]:
		Call fn[0,8]
	Return

fn[6]:
	TextStart char[0]
	if flag[7]:
		var[0] = 99
		while var[0] == 99:
			FadeOut 300ms 0x00000000 100
			Menu menu[0] -1 -1 1
				"話をする" // 0
				"買い物をする" // 1
				"休憩をする" // 2
				"やめる" // 3
			MenuWait var[0]
			if var[0] < 1 | var[0] > 2:
				MenuClose menu[0]
				FadeIn 300ms 0x00000000
				FadeWait
			if var[0] == 1:
				ShopOpen shop[52]
				var[0] = 99
			elif var[0] == 2:
				ShopOpen shop[50]
				var[0] = 99
			elif var[0] != 0:
			elif var[0] == 0:
				var[0] = 99
				Call fn[0,7]
	else:
		Call fn[0,7]
	TextEnd char[0]
	Return

fn[7]:
	if flag[1307]:
		if !flag[0]:
			TextTalk char[0] {
				特製チャーハン２、お待ち！{wait}
			}
			TextWait
			TextTalk char[0] {
				……今日の客入りはそれほどでもない。{wait}
			}
			TextWait
			TextTalk char[0] {
				何とか乗り切れそうね。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				この人出も今日限り。
				また明日からは常連客ばかりの営業ね。{wait}
			}
			TextWait
			TextTalk char[0] {
				……何とか乗り切れそうね。{wait}
			}
			TextWait
	elif flag[1362]:
		if !flag[0]:
			TextTalk char[0] {
				ハイお客さん！　ご注文は何ね！{wait}
			}
			TextWait
			TextTalk char[0] {
				ん？　んん？
				何を食べるかね……ッ！？{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				宿のチェックインは
				夕方５時からよ。{wait}
			}
			TextWait
			TextTalk char[0] {
				それまでは
				宿部屋に入ってはいけない。
				……いいね？{wait}
			}
			TextWait
	elif flag[1292]:
		if !flag[0]:
			TextTalk char[0] {
				……何か食べるか？{wait}
			}
			TextWait
			TextTalk char[0] {
				ん？　何か食べるかね……ッ！？{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				サンサンは奥に下がらせたよ。{wait}
			}
			TextWait
			TextTalk char[0] {
				大勢の男どもに
				さらすのは、やはり心配ね。{wait}
			}
			TextWait
	elif flag[1282]:
		if !flag[0]:
			CharTurnToChar char[0] char[6] 300deg/s
			TextTalk char[0] {
				……あそこの席の男、
				ちらちらサンサンに色目使っている。{wait}
			}
			TextWait
			TextTalk char[0] {
				………ギンッ…………………{wait}
			}
			TextWait
			TextTalk char[6] {
				お、おかしいな……
				何だか寒気が……{wait}
			}
			TextWait
			CharFlagsUnset char[0] 0x0010
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				サンサンに手を
				出したら許さないよ。{wait}
			}
			TextWait
			TextTalk char[0] {
				よく覚えておくよろし。{wait}
			}
			TextWait
	elif flag[1280]:
		if !flag[0]:
			Emote char[0] 0mm 2000mm 14 15 250ms 2
			SoundPlay sound[23] 0 100 0
			Sleep 1200ms
			TextTalk char[0] {
				さすが記念祭は騒がしいね……{wait}
			}
			TextWait
			TextTalk char[0] {
				ワタシは静かな店が好き。
				……客なんて来なくていいよ。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				……あまり騒がしいと
				東方人街を思い出すよ。{wait}
			}
			TextWait
			TextTalk char[0] {
				あの街はいつもこんな空気だった。{wait}
			}
			TextWait
	Return

