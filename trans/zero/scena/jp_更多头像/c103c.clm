			}
			TextWait
			TextTalk self {
				なにせ俺たちは
				運転のプロだからなぁ。{wait}
			}
			TextWait
			FlagSet flag[3]
		else:
			TextTalk self {
				ウチの会社も
				運転手を１人貸し出してるんだ。{wait}
			}
			TextWait
			TextTalk self {
				……その分こっちは
				忙しくなっちまったけどな。{wait}
			}
			TextWait
	elif flag[1282]:
		TextTalk self {
			観光バスがぞくぞく
			来てるみたいだな。{wait}
		}
		TextWait
		TextTalk self {
			タングラム門の方には
			まだ何台も入国待ちしてたぜ。{wait}
		}
		TextWait
	elif flag[1280]:
		if !flag[3]:
			TextTalk self {
