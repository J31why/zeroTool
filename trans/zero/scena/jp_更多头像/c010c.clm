fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharWalkToPos self (10430, 0, -1800) 2000mm/s 0
		CharWalkToPos self (10430, 0, 39440) 2000mm/s 0
		Sleep 2000ms
		CharSetPos self (30000, 0, -3010) 270deg
	Return

fn[2]:
	while 1:
		CharIdle self (870, null, -7530) (-3530, null, -11930) 1000mm/s
		Sleep 300ms
	Return

fn[3]:
	while 1:
		CharIdle self (-22080, null, -17100) (-25290, null, -20310) 1000mm/s
		Sleep 300ms
	Return

fn[4]:
	while 1:
		CharWalkToPos self (-7290, 0, 11150) 2000mm/s 0
		CharWalkToPos self (-13960, 0, 1780) 2000mm/s 0
		CharTurnTo self 315deg 400deg/s
		Sleep 2000ms
		CharTurnTo self 360deg 400deg/s
		Sleep 100ms
		CharWalkToPos self (-7290, 0, 11150) 2000mm/s 0
		CharWalkToPos self (0, 0, 15110) 2000mm/s 0
		CharTurnTo self 0deg 400deg/s
		Sleep 2000ms
		CharTurnTo self 225deg 400deg/s
		Sleep 100ms
	Return

