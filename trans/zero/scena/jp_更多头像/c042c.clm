sepith[0] 0 0 0 0 0 0 0 0

fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharIdle self (62680, null, 1330) (66890, null, 5550) 1000mm/s
		Sleep 300ms
	Return

fn[2]:
	if flag[1294]:
		CharFlagsSet char[1] 0x0080
		CharFlagsSet char[2] 0x0080
		CharFlagsUnset char[3] 0x0080
		CharFlagsUnset char[5] 0x0080
		CharSetPos char[0] (-66690, 0, 4990) 0deg
		CharSetPos char[4] (-66690, 0, 6530) 180deg
	elif QuestFlagsGet quest[29] 0x10:
		CharFlagsSet char[1] 0x0080
		CharFlagsSet char[2] 0x0080
		CharFlagsSet char[0] 0x0080
	elif QuestTaskGet quest[29] 0:
		CharSetPos char[0] (-1880, 10, 15240) 135deg
		CharSetPos char[2] (-210, 0, 13820) 0deg
		CharTurnTo char[1] 180deg 0deg/s
	else:
		ForkFunc char[1] fork[2] fn[0,13]
		ForkFunc char[2] fork[2] fn[0,13]
		ForkFunc char[0] fork[2] fn[0,13]
		CharFlagsSet char[1] 0x0010
		CharFlagsSet char[2] 0x0010
		CharFlagsSet char[0] 0x0010
	Return

fn[3]:
	Return

fn[4]:
	if QuestFlagsGet quest[29] 0x02 && !QuestTaskGet quest[29] 0 && !QuestFlagsGet quest[29] 0x10 && !QuestFlagsGet quest[29] 0x40:
		Call fn[0,11]
		Return
	TextStart self
	if flag[1294]:
		if flag[0]:
			TextTalk char[0] {
				今日の人出では
				迷子になるのも無理はないだろうね。{wait}
			}
			TextWait
			TextTalk char[0] {
				早く見つかる事を祈っているよ。{wait}
			}
			TextWait
		else:
			TextTalk char[0] {
				ああ、ロイド君か。
				男の子が迷子になったそうだね。{wait}
			}
			TextWait
			TextTalk char[0] {
				ふむ、外は記念祭の人出だし
				今日はパレードもあった……{wait}
			}
			TextWait
			TextTalk char[0] {
				早く見つかるといいんだが。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif QuestFlagsGet quest[29] 0x10:
	elif QuestTaskGet quest[29] 0:
		TextTalk char[0] {
			明日からはまた
			イリア君の公演がある……{wait}
		}
		TextWait
		TextTalk char[0] {
			この大事な時期に
			ストーカーが出るなんて
			居ても立ってもいられないよ……{wait}
		}
		TextWait
		TextTalk char[0] {
			どうか、早急に
			捕まえてはくれないだろうか！{wait}
		}
		TextWait
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 0
			"【引き受ける】" // 0
			"【断る】" // 1
		MenuWait var[0]
		MenuClose menu[0]
		FadeIn 300ms 0x00000000
		_59
		if var[0] == 0:
			TextEnd self
			EventBegin 0
			BgmStop 1500ms
			CrossFade 500ms
			CamSetDistance -250 1670 13660 0ms
			ED7CamRotate 32deg 29deg 0deg 0ms
			CamPers 650 0ms
			CamZoom 14970 0ms
			CharSetPos name[0] (260, 120, 13350) 346deg
			CharSetPos name[1] (-850, 450, 12100) 346deg
			CharSetPos name[2] (-840, 0, 13680) 346deg
			CharSetPos name[3] (300, 450, 12100) 346deg
			CharSetPos char[0] (-1480, 0, 15690) 180deg
			CharSetPos char[2] (1330, 0, 15700) 225deg
			CharTurnTo char[1] 180deg 0deg/s
			_Char4A char[1] 255
			_Char4A char[2] 255
			_Char4A char[0] 255
			BgmWait
			Sleep 10ms
			BgmPlay bgm[111] 0
			FadeWait
			QuestTaskSet quest[29] 1
			Call fn[0,12]
			Return
		TextTalk name[0] {
			#0006Fすみません……まだ
			他の仕事が残っていまして。
			今は手が離せないんです。{wait}
		}
		TextWait
		TextTalk char[0] {
			そうか……
			それなら仕方ない。{wait}
		}
		TextWait
		TextTalk char[0] {
			手が空いたら頼めないだろうか。
			何としても
			早急に解決して欲しいんだ。{wait}
		}
		TextWait
	else:
		TextTalk self {
			ふむ、試してみる
			価値はありそうだよ。{wait}
		}
		TextWait
		TextTalk self {
			しかしリーシャ君も大したものだ。
			このイリア君の無茶なオーダーに
			応えられるなんて。{wait}
		}
		TextWait
		TextTalk char[1] {
			#1700Fあはは、だってリーシャだもの。{wait}
		} {
			#1709F見込んだあたしの目に
			狂いはなーい！{wait}
		}
		TextWait
	TextEnd self
	Return

fn[5]:
