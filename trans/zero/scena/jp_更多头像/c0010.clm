			TextWait
			TextTalk self {
				うう、興奮してきたぁ！{wait}
			}
			TextWait
	else:
		TextTalk self {
			共和国の東方人街って
			治安とか大丈夫なのかな……{wait}
		}
		TextWait
		TextTalk self {
			ジャックの世界そのまま、
			ゴロツキばかりだったらどうしよう。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[25]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if !QuestFlagsGet quest[45] 0x10:
		TextTalk self {
			彼氏に捨てられちゃってね……
			いまから傷心旅行にしゃれ込むの。{wait}
		}
		TextWait
		TextTalk self {
			……でも、私はめげないわ。{wait}
		}
		TextWait
		TextTalk self {
			外国でもっとかっこいい人を
			見つけるんだから……！{wait}
		}
		TextWait
	else:
		TextTalk self {
			うーん、傷心旅行に行くなら
			帝国かしら、共和国かしら。{wait}
		}
		TextWait
		TextTalk self {
			どうせならかっこいい男の人が
			いそうな方がいいけど……
			どっちも捨てがたいわね。{wait}
		}
		TextWait
	CharSetChipPattern self 0
	TextEnd self
	Return

