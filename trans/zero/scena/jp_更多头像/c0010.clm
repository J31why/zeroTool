fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharIdle self (19730, null, 1670) (16239, null, -2020) 1000mm/s
		Sleep 300ms
	Return

fn[2]:
	while 1:
		CharWalkToPos self (20920, 4000, -8210) 1000mm/s 0
		CharWalkToPos self (20920, 4000, 760) 1000mm/s 0
		CharTurnTo self 270deg 200deg/s
		Sleep 2500ms
		CharWalkToPos self (20920, 4000, -8210) 1000mm/s 0
		CharWalkToPos self (18700, 4000, -8210) 1000mm/s 0
		CharTurnTo self 315deg 200deg/s
		Sleep 4500ms
	Return

fn[3]:
	if flag[736]:
		FlagUnset flag[736]
		Event fn[0,33]
	elif !flag[547]:
		Event fn[0,28]
	if flag[1536]:
		if !QuestFlagsGet quest[45] 0x10:
			CharSetPos char[5] (18820, 0, 4500) 90deg
			CharSetPos char[4] (19970, 0, 4500) 270deg
			CharFlagsSet char[5] 0x0010
			CharFlagsSet char[4] 0x0010
		else:
			CharSetPos char[5] (19970, 0, -4490) 90deg
		CharFlagsUnset char[14] 0x0080
		CharFlagsUnset char[15] 0x0080
		CharFlagsUnset char[16] 0x0080
		CharFlagsUnset char[17] 0x0080
		CharFlagsSet char[16] 0x0010
		CharFlagsUnset char[8] 0x0080
		CharFlagsUnset char[9] 0x0080
	else:
		if !QuestFlagsGet quest[9] 0x10:
			CharFlagsSet char[5] 0x0010
			if !QuestTaskGet quest[9] 1:
			else:
				CharFlagsSet char[5] 0x0080
		else:
			CharFlagsSet char[5] 0x0080
			CharFlagsUnset char[6] 0x0080
			CharFlagsUnset char[7] 0x0080
		CharFlagsUnset char[10] 0x0080
		CharFlagsUnset char[11] 0x0080
		CharFlagsUnset char[12] 0x0080
		CharFlagsUnset char[13] 0x0080
	Return

fn[4]:
	ObjFlagsUnset object[2] 0x0010
	if QuestTaskGet quest[45] 9 && !QuestFlagsGet quest[45] 0x10 && !QuestFlagsGet quest[45] 0x40:
		ObjFlagsSet object[2] 0x0010
	ObjFlagsUnset object[1] 0x0010
	if flag[1024]:
	elif flag[801]:
		if QuestFlagsGet quest[9] 0x10:
			ObjFlagsSet object[1] 0x0010
		elif QuestTaskGet quest[9] 1:
			ObjFlagsSet object[1] 0x0010
			EntranceSetFunc entrance[0] fn[0,34]
	if QuestFlagsGet quest[45] 0x10 && !flag[1688]:
		ObjFlagsSet object[1] 0x0010
	Return

fn[5]:
	Call fn[0,6]
	Return

fn[6]:
	TextStart char[0]
	if flag[1536]:
		if !QuestFlagsGet quest[45] 0x10:
			if !flag[0]:
				TextTalk char[0] {
					１０数年前の《百日戦役》では
					帝国と共和国は対立関係にあったろう？{wait}
				}
				TextWait
				TextTalk char[0] {
					鉄道も運行を停止したために、
					クロスベルに来ていた旅行者たちは
					足止めを喰らうことになったんだ。{wait}
				}
				TextWait
				TextTalk char[0] {
					今ではそういったことが起こらないよう
					充分に体制が見直されたけどね。{wait}
				}
				TextWait
				FlagSet flag[0]
			else:
				TextTalk char[0] {
					１０数年前の《百日戦役》で
					この鉄道は一時運行を停止して、
					多くの人々を難民としてしまったんだ。{wait}
				}
				TextWait
				TextTalk char[0] {
					今ではそういったことが起こらないよう
					充分に体制が見直されたけどね。{wait}
				}
				TextWait
		else:
			TextTalk char[0] {
				マクダエル市長も、
				帝国や共和国で会議があるときは
				列車を使って移動しているよ。{wait}
			}
			TextWait
			TextTalk char[0] {
				飛行艇で行くとなると確かに早いけど、
				ミラがそれなりにかかるからねぇ。{wait}
			}
			TextWait
			TextTalk char[0] {
				いやはや、まさに堅実な市長らしいよ。{wait}
			}
			TextWait
	elif !QuestFlagsGet quest[9] 0x10:
		TextTalk char[0] {
			本日もクロスベル駅を
			ご利用いただきありがとうございます。{wait}
		}
		TextWait
		TextTalk char[0] {
			列車の到着時は
			大変込み合いますので
			どうかお気をつけ下さいませ。{wait}
		}
		TextWait
	else:
		TextTalk char[0] {
			鉄道は《大陸鉄道公社》によって
			運営されているんだ。{wait}
		}
		TextWait
		TextTalk char[0] {
			ちなみにクワトロさんは、
			臨検のために帝国から派遣されてきた人で
			公社の社員ってワケじゃないんだよ。{wait}
		}
		TextWait
	TextEnd char[0]
	Return

fn[7]:
	Call fn[0,8]
	Return

fn[8]:
	TextStart char[1]
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"話をする" // 0
			"買い物をする" // 1
			"やめる" // 2
		MenuWait var[0]
		if var[0] != 1:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			if flag[1792]:
				ShopOpen shop[137]
			elif flag[1536]:
				ShopOpen shop[136]
			elif flag[1342]:
				ShopOpen shop[135]
			elif flag[1307]:
				ShopOpen shop[134]
			elif flag[1280]:
				ShopOpen shop[133]
			elif flag[1024]:
				ShopOpen shop[132]
			elif flag[768]:
				ShopOpen shop[131]
			else:
				ShopOpen shop[130]
			var[0] = 99
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			if flag[1536]:
				if !QuestFlagsGet quest[45] 0x10:
					if !flag[1]:
						TextTalk char[1] {
							間もなく、共和国行き列車が
							１番ホームから発車いたします。{wait}
						}
						TextWait
						TextTalk char[1] {
							ご搭乗ならお急ぎいただくか、
							次の列車をお待ちくださいね。{wait}
						}
						TextWait
						FlagSet flag[1]
					else:
						TextTalk char[1] {
							間もなく、共和国行き列車が
							１番ホームから発車いたしますよ。{wait}
						}
						TextWait
						TextTalk char[1] {
							かけ込み乗車は危険ですので、
							余裕を持ってご搭乗ください。{wait}
						}
						TextWait
				elif !flag[1]:
					TextTalk char[1] {
						国境の門からも
						帝国・共和国への
						定期バスが出ております。{wait}
					}
					TextWait
					TextTalk char[1] {
						お時間はかかりますが、
						そちらでの帰省の方法も
						ご案内しております。{wait}
					}
					TextWait
					TextTalk char[1] {
						万一にも列車に間に合わない場合、
						お気軽にご相談くださいませ。{wait}
					}
					TextWait
					FlagSet flag[1]
				else:
					TextTalk char[1] {
						国境門から出るバスを利用した
						陸路での帰省もご案内しております。{wait}
					}
					TextWait
					TextTalk char[1] {
						万一にも列車に間に合わない場合、
						お気軽にご相談くださいませ。{wait}
					}
					TextWait
			elif !QuestFlagsGet quest[9] 0x10:
				if !flag[1]:
					TextTalk char[1] {
						あっ……{wait}
					}
					TextWait
					Emote name[0] 0mm 1700mm 0 1 250ms 2
					SoundPlay sound[29] 0 100 0
					Emote name[1] 0mm 1700mm 0 1 250ms 2
					SoundPlay sound[29] 0 100 0
					Emote name[2] 0mm 1700mm 0 1 250ms 2
					SoundPlay sound[29] 0 100 0
					Emote name[3] 0mm 1700mm 0 1 250ms 2
					SoundPlay sound[29] 0 100 0
					Sleep 1000ms
					TextTalk char[1] {
						……失礼しました。
						最近クロスベルタイムズで、
						お見かけしたものですから……{wait}
					}
					TextWait
					TextTalk char[1] {
						今日は依頼の件で
						来られたのでしょうか？{wait}
					}
					TextWait
					TextTalk char[1] {
						クワトロさんなら、
						階段を上って左手の
						臨検官室前でお待ちですよ。{wait}
					}
					TextWait
					FlagSet flag[1]
				else:
					TextTalk char[1] {
						今日は依頼の件で
						来られたのでしょうか？{wait}
					}
					TextWait
					TextTalk char[1] {
						クワトロさんなら、
						階段を上って左手の
						臨検官室前でお待ちですよ。{wait}
					}
					TextWait
			elif !flag[1]:
				TextTalk char[1] {
					警備隊の詰める東西の国境門への
					貨物列車も当駅から出ています。{wait}
				}
				TextWait
				TextTalk char[1] {
					直接物資を運搬することができるので、
					警備隊ではとても重宝しているそうですよ。{wait}
				}
				TextWait
				FlagSet flag[1]
			else:
				TextTalk char[1] {
					警備隊の詰める東西の国境門への
					貨物列車も当駅から出ています。{wait}
				}
				TextWait
				TextTalk char[1] {
					一般の方はご利用になれないので
					ご注意くださいね。{wait}
				}
				TextWait
	TextEnd char[1]
	Return

fn[9]:
	Call fn[0,10]
	Return

fn[10]:
	TextStart char[2]
	if flag[1536]:
		if !QuestFlagsGet quest[45] 0x10:
			TextTalk char[2] {
				おや……お急ぎですか？{wait}
			}
			TextWait
			TextTalk char[2] {
				危険ですので、
				ホームでは走らないで下さいね。{wait}
			}
			TextWait
		else:
			TextTalk char[2] {
				近頃物騒な事件が多いようです。{wait}
			}
			TextWait
			TextTalk char[2] {
				お客様には、
				気をつけて列車の旅を
				楽しんできてほしいものですね。{wait}
			}
			TextWait
	elif !QuestFlagsGet quest[9] 0x10:
		TextTalk char[2] {
			列車内では飲食物の
			販売もしております。{wait}
		}
		TextWait
		TextTalk char[2] {
			長旅の際には
			ぜひご利用くださいませ。{wait}
		}
		TextWait
	else:
		TextTalk char[2] {
			駅を利用するビジネスマンには、
			毎日帝国や共和国と
			行き来している方もおられます。{wait}
		}
		TextWait
		TextTalk char[2] {
			そういう方がクロスベルの経済を
			支えているかと思うと、
			ただただ頭の下がる想いです。{wait}
		}
		TextWait
	TextEnd char[2]
	Return

fn[11]:
	Call fn[0,12]
	Return

fn[12]:
	TextStart char[3]
	if flag[1536]:
		if !QuestFlagsGet quest[45] 0x10:
			if !flag[3]:
				TextTalk char[3] {
					あっ……すみません、
					少しお待ちいただけますか。{wait}
				}
				TextWait
				TextSetPos -1 -1 -1 -1
				TextSetName ""
				TextMessage null {
					{0x18}{color 12}……お客様にお知らせします。{wait}
				} {
					車両発車のベルが鳴りましたら
					ホーム中ほどまでお下がりください。{wait}
				} {
					車両が通過する際に
					身を乗り出したりしないよう
					お願い申し上げます。{color 0}{wait}
				}
				TextWait
				TextClose 0
				_59
				TextSetPos -1 280 60 3
				FlagSet flag[3]
			else:
				TextTalk char[3] {
					えっと……
					とにかく危ないので
					身を乗り出さないでくださいね。{wait}
				}
				TextWait
		else:
			TextTalk char[3] {
				本来私は内気な方なのですが、
				構内アナウンスの担当になってから
				軽やかに舌が回るようになりました。{wait}
			}
			TextWait
			TextTalk char[3] {
				うふふ……
				うってつけの役を任されて
				本当に良かったと思っていますよ。{wait}
			}
			TextWait
	elif !QuestFlagsGet quest[9] 0x10:
		if !flag[3]:
			TextTalk char[3] {
				本日もクロスベル駅を
				ご利用いただき
				ありがとうございます。{wait}
			}
			TextWait
			TextTalk char[3] {
				こちらでは切符の発券のほか
				ご利用案内もさせて頂いています。{wait}
			}
			TextWait
			TextTalk char[3] {
				ご不明な点がありましたら
				ぜひお尋ねくださいね。{wait}
			}
			TextWait
			FlagSet flag[3]
		else:
			TextTalk char[3] {
				私は構内のアナウンスも
				担当しているんです。{wait}
			}
			TextWait
			TextTalk char[3] {
				もし鉄道のご利用について
