fn[12]:
	TextStart self
	if !flag[1120]:
		TextTalk self {
			このベルガード門では
			帝国方面の国境を警備しているぞ。{wait}
		}
		TextWait
		Emote char[0] 0mm 2000mm 38 38 250ms 1
		Sleep 1000ms
		CharTurnToChar char[0] name[3] 300deg/s
		TextTalk self {
			あれ……？
			あんた、もしかしてランディか！？{wait}
		}
		TextWait
		TextTalk name[3] {
			#0300F……よっ、久しぶりだな。{wait}
		}
		TextWait
		TextTalk self {
			はは……また来てくれて嬉しいぜ。
			もうこっちには顔を出さないと
			思ってたからな。{wait}
		}
		TextWait
		TextTalk self {
			まぁ、ゆっくりしてってくれ。{wait}
		}
		TextWait
		FlagSet flag[1120]
	elif flag[1566]:
		TextTalk self {
			今晩は夜間演習が行われる予定でな。{wait}
		}
		TextWait
		TextTalk self {
			日頃のうっ憤も相当溜まってる。
			こういう機会に上手く晴らさないとな。{wait}
		}
		TextWait
	elif flag[1554]:
		TextTalk self {
			昨日タングラム門の方から
			例の遺跡の調査報告書が
			届いたらしい。{wait}
		}
		TextWait
		TextTalk self {
			司令のヤツは気にも
			留めてないようだったがな。{wait}
		}
		TextWait
	elif flag[1536]:
		if !flag[0]:
			CharTurnToChar char[0] name[3] 0deg/s
			TextTalk self {
				ランディ、今日は一体どうしたんだ？{wait}
			}
			TextWait
			TextTalk name[3] {
				#0300Fああ、お前らが撤収した
				遺跡の調査を
				引き受けることになったんだ。{wait}
			}
			TextWait
			TextTalk self {
				な、なんだって……？{wait}
			}
			TextWait
			TextTalk name[3] {
				#0300F話を聞いた感じだと、
				司令閣下がタングラム門に
				押し付けたっぽいな。{wait}
			} {
				#0309Fはは、手柄は俺たちが頂くからな。
				ざまーみろだ。{wait}
			} {
				#0300F……って司令に言っといてくれ。{wait}
			}
			TextWait
			TextTalk self {
				……自分で言え。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				いやしかし……あんたらが
				タングラム門の隊員と
				一緒に調査してくれるなら心強い。{wait}
			}
			TextWait
			TextTalk self {
				頼むぞ、俺たちの不始末を
				なんとかつけてやってくれ。{wait}
			}
			TextWait
	elif flag[1307]:
		TextTalk self {
			今日でこの忙しいのも終わる……
