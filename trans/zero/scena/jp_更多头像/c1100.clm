		}
		TextWait
	elif PartyPosition name[2] > -1:
		CharTurnToChar name[2] name[0] 500deg/s
		TextTalk name[2] {
			#12P#0203Fええ、そう記憶しています。{wait}
		} {
			#0200Fどこかに移動した
			可能性が高そうですね。{wait}
		}
		TextWait
	elif PartyPosition name[3] > -1:
		CharTurnToChar name[3] name[0] 500deg/s
		TextTalk name[3] {
			#12P#0303Fおお、前にデートで
			立ち寄ったから間違いねぇ。{wait}
		} {
			#0301Fどこかに移動しちまったのか？{wait}
		}
		TextWait
	CharTurnToChar name[82] name[0] 500deg/s
	TextTalk name[82] {
		#11P#1112Fえー、それじゃあ
		おじいちゃんにさしいれ
		できないのー？{wait}
	}
	TextWait
	CharTurnToChar name[0] name[82] 500deg/s
	TextTalk name[0] {
		#5P#0003Fいや、たぶん街の外には
		移動してないだろうし……{wait}
	} {
		#0000Fせっかくだから
		市内を探してみよう。{wait}
	}
	TextWait
	TextTalk name[82] {
		#11P#1100Fうんっ！{wait}
	}
	TextWait
	TriggerFlagsSet trigger[0] 0x0080
	CharSetPos field_party[0] (8100, 2390, -5930) 225deg
	QuestTaskSet quest[38] 2
	EventEnd 5
	Return

fn[18]:
	while 1:
		CharTurnTo self 0deg 550deg/s
		Sleep 500ms
		CharTurnTo self 270deg 550deg/s
		Sleep 500ms
	Return

fn[19]:
	while 1:
		CharTurnTo self 180deg 600deg/s
		Sleep 500ms
		CharTurnTo self 90deg 600deg/s
		Sleep 500ms
	Return

