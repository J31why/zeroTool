fn[5]:
	TextStart self
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"話をする" // 0
			"買い物をする" // 1
			"やめる" // 2
		MenuWait var[0]
		if var[0] != 1:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			ShopOpen shop[128]
			var[0] = 99
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			if flag[1792]:
				if !flag[0]:
					TextTalk self {
						あ……そろそろ
						お店閉めちゃいますよ。{wait}
					}
					TextWait
					TextTalk self {
						ご注文ならラストオーダーです。
						ビシッと言っちゃって下さいね。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk self {
						ご注文ならラストオーダーですよ。
						ビシッと言っちゃって下さいね。{wait}
					}
					TextWait
			elif flag[1566]:
				TextTalk self {
					今朝は警察の人たちが
					バタバタしていたみたいです。{wait}
				}
				TextWait
				TextTalk self {
					何かあったのかしら……{wait}
				}
				TextWait
			elif flag[1554]:
				if !flag[0]:
					TextTalk self {
						あら、今日は快晴ですね……{wait}
					}
					TextWait
					TextTalk self {
						雨だとお商売できないので
						天気がいいのは助かりますね。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk self {
						今日は暑くなりそうだし
						売り上げも期待できそうです。{wait}
					}
					TextWait
			elif flag[1536]:
				if !flag[0]:
					TextTalk self {
						議会が開かれているとかで、
						朝夕はこの辺りも賑やかなんです。{wait}
					}
					TextWait
					TextTalk self {
						でも……議員の人もマスコミの人も
						あまり買ってくれないんですよね……{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk self {
						私は記念祭の方がいいです。{wait}
					}
					TextWait
					TextTalk self {
						議会なんて
						よく分からないですし……{wait}
					}
					TextWait
			elif flag[1342]:
				if flag[0]:
					TextTalk self {
						うーん、そろそろ場所を
						変えようかしら……{wait}
					}
					TextWait
					TextTalk self {
						記念祭から帰国する
						お客さんを狙わないとね。{wait}
					}
					TextWait
				else:
					TextTalk self {
						いらっしゃいませー！
						新鮮なジュースはいかがですか～？{wait}
					}
					TextWait
					TextTalk self {
						……市内観光に疲れたら
						お姉さんに言ってくださいね。{wait}
					}
					TextWait
					TextTalk self {
						おいしいジュースを
						販売しちゃいますから。{wait}
					}
					TextWait
					FlagSet flag[0]
			elif flag[1055]:
				if !flag[0]:
					TextTalk self {
						記念祭に向けて、
						ジュース用の果物の仕入れを
						増やす予定なんです。{wait}
					}
					TextWait
					TextTalk self {
						……そういえば母も
						似たような事を言ってましたっけ。{wait}
					}
					TextWait
					TextTalk self {
						うーん、私も負けてられませんね。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk self {
						母は百貨店の食材コーナーを
						任されているんです。{wait}
					}
					TextWait
					TextTalk self {
						仕入れが大得意なので……
						こっそりコツを教えてもらおうかな。{wait}
					}
					TextWait
			elif flag[1040]:
				TextTalk self {
					いらっしゃいませ。
					お客様も何か注文なさいます？{wait}
				}
				TextWait
			elif flag[1031]:
				if !flag[0]:
					TextTalk self {
						私の母は百貨店で
						食材コーナーを任されているんです。{wait}
					}
					TextWait
					TextTalk self {
						昔から輸入食材を扱う仕事をしていて、
						結構有名なお店を開いていたんですよ。{wait}
					}
					TextWait
					TextTalk self {
						ふふっ、私がお商売を始めたのは
						母の影響かもしれませんね。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk self {
						母は百貨店で
						食材コーナーを任されているんです。{wait}
					}
					TextWait
					TextTalk self {
						輸入食材の取り扱いにかけては
						ちょっと定評があるんですよ。{wait}
					}
					TextWait
			elif flag[1024]:
				if !flag[0]:
					TextTalk self {
						私、自分で商売をやってみたくて
						出店を始めたんです。{wait}
					}
					TextWait
					TextTalk self {
						でも……このオート三輪を
						買うのに借金してしまいました。{wait}
					}
					TextWait
					TextTalk self {
						……がんばって稼がなくっちゃ。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk self {
						自分の力を試したかったので、
						母には頼らず借金をしました。{wait}
					}
					TextWait
					TextTalk self {
						出店を成功させて、借金を
						返してこそ真のお商売ですよね。
						……がんばらなくっちゃ。{wait}
					}
					TextWait
			elif flag[801]:
				if !RecipeLearn 22:
					Call fn[0,6]
				elif !flag[0]:
					TextTalk self {
						いらっしゃいませー！
						ジュースはいかがですか～？{wait}
					}
					TextWait
					TextTalk self {
						……さっき遊撃士の方が
						声を掛けてくださったんです。{wait}
					}
					TextWait
					TextTalk self {
						ちょ、ちょっと
						カッコいい人だったな……{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk self {
						ゆ、遊撃士の方って
						やっぱりカッコいいですよね。{wait}
					}
					TextWait
			elif flag[777]:
