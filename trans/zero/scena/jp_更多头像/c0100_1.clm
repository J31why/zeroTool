calmare zero_k scena
scena:
	name "c0100" "c0100" "c0100_1"
	town town[4]
	bgm bgm[100]
	flags 8192
	item_use fn[0,255]
	unk 255 0

entry:
	pos (0, 0, -1000)
	unk1 0
	cam_from (0, 2500, 34000)
	cam_pers 262
	unk2 30
	cam_deg 45deg
	cam_limit 0deg 360deg
	cam_at (1100, 0, -3500)
	unk3 0
	unk4 0
	flags 0x0001
	town town[4]
	init fn[0,5]
	reinit fn[0,6]

// NB: this line is meaningless, it's just here for roundtripping.
label blank

sepith[0] 0 0 0 0 0 0 0 0

fn[0]:
	TextStart self
	if flag[1792]:
		TextTalk self {
			今日はきちんと買い物も済んだわ。{wait}
		}
		TextWait
		TextTalk self {
			予定通りに事が進むって
			なんて気持ちいいのかしら～。{wait}
		}
		TextWait
	elif flag[1566]:
		TextTalk self {
			ふあ～……おはよー。{wait}
		}
		TextWait
		TextTalk self {
			今日も良い一日になるといいわね。{wait}
		}
		TextWait
	elif flag[1554]:
		if !flag[0]:
			TextTalk self {
				港湾区の方に人だかりが出来てたわ。{wait}
			}
			TextWait
			TextTalk self {
				警察の人も来てて、
				何だかおっかない雰囲気だったけど
				何かあったのかな～？{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				港湾区で何かあったみたい。
				……怖いことだったらやだな～。{wait}
			}
			TextWait
	elif flag[1550]:
	elif flag[1536]:
		TextTalk self {
			なんだか、予算議会ってのが
			遅れ気味なんですって～。{wait}
		}
		TextWait
		TextTalk self {
			まぁでも、毎年同じように
			遅れてるみたいだし……
			あんまり気にならないかなぁ。{wait}
		}
		TextWait
	elif flag[1342]:
		if !flag[0]:
			TextTalk self {
				記念祭の最終日に
				ミシュラムで花火を見たわ。
				綺麗だったな～。{wait}
			}
			TextWait
			TextTalk self {
				けど、あの夜はひと騒動あって
				大変だったそうよ。{wait}
			}
			TextWait
			TextTalk self {
				ミシュラムに宿泊するお金がなくて
				かえってラッキーだったかもね～。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				記念祭最終日の夜は
				ミシュラムでひと騒動あったそうよ。{wait}
			}
			TextWait
			TextTalk self {
				直前で帰れてラッキーだったかも～。{wait}
			}
			TextWait
	elif flag[1055]:
		if !flag[0]:
			TextTalk self {
				マグダエル市長って
				しっかりした
				おじいちゃんって感じよね。{wait}
			}
			TextWait
			TextTalk self {
				政治家なのに親しみやすいし
				まだまだ元気、みたいな。{wait}
			}
			TextWait
			TextTalk self {
				でも……いつも
				杖をついてるのよね。
				やっぱり体がつらいのかなー。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				パパが、マグダエル市長は今年で
				引退するかもって言ってたけど……{wait}
			}
			TextWait
			TextTalk self {
				やっぱり本当なのかなー。{wait}
			}
			TextWait
	elif flag[1040]:
		if !flag[0]:
			TextTalk self {
				今年の記念祭は
				どんな感じになるのかなー。{wait}
			}
			TextWait
			TextTalk self {
				どこのお店も
				何か準備してるみたいだし
				ふふっ、楽しみよね～。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				クロスベル最大のお祭り、
				創立記念祭まであと少し……{wait}
			}
			TextWait
			TextTalk self {
				ふふっ、楽しみよね～。{wait}
			}
			TextWait
	elif flag[1037]:
		TextTalk self {
			買い物してたら遅くなっちゃった。{wait}
		}
		TextWait
		TextTalk self {
			お店をのぞいてると
			ついつい長引いちゃうのよね～。{wait}
		}
		TextWait
	elif flag[1031]:
		TextTalk self {
			今日は警察の人が多いわね……{wait}
		}
		TextWait
		TextTalk self {
			朝から５回も６回もすれ違うの。{wait}
		}
		TextWait
		TextTalk self {
			事件があったわけでも
			なさそうなのに……
			一体何してるのかしら。{wait}
		}
		TextWait
	elif flag[1024]:
		if !flag[0]:
			TextTalk self {
				はーあ、アルカンシェルのチケット
				結局手に入らなかったわ。{wait}
			}
			TextWait
			TextTalk self {
				友達と２人で
				頑張って並んだんだけどなー。{wait}
			}
			TextWait
			TextTalk self {
				あたしたちの５人くらい前で
				全部売り切れちゃったの。{wait}
			}
			TextWait
			TextTalk self {
				ううっ、ほんとショックだわ。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				ああ、思い出すだけで悔しいぃ～！{wait}
			}
			TextWait
			TextTalk self {
				そもそもあそこのチケット、
				ちょっと高すぎるのよっ！{wait}
			}
			TextWait
			TextTalk self {
				お小遣いはたいても
				なかなか買えないじゃない。{wait}
			}
			TextWait
	elif flag[801]:
		TextTalk self {
			アルモリカ村の野菜は
			健康にいいって噂よ。{wait}
		}
		TextWait
		TextTalk self {
			お肌ツルツルになるんだって。
			あたしも試してみようかな。{wait}
		}
		TextWait
	elif flag[777]:
		if !flag[0]:
			TextTalk self {
				今日は西通りの親戚の家に
				遊びに行くつもりなの。{wait}
			}
			TextWait
			TextTalk self {
				でも市内には
				バスが通ってないのよね。{wait}
			}
			TextWait
			TextTalk self {
				まったく不便なんだから。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				クロスベル市は広いんだし、
				市内バスがあっても
				いいと思うんだけど。{wait}
			}
			TextWait
	elif flag[768]:
		TextTalk self {
			さっき緑の大きな車とすれ違ったの。{wait}
		}
		TextWait
		TextTalk self {
			クロスベル警備隊の紋章が入ってたわ。
			警備隊の人だったのかな～。{wait}
		}
		TextWait
	elif flag[533]:
		if !flag[0]:
			TextTalk self {
				友達とアパルトメントを
				借りようと思ってるんだけど……{wait}
			}
			TextWait
			TextTalk self {
				中々安い物件が
				見つからないのよね～。{wait}
			}
			TextWait
			TextTalk self {
				しばらく実家暮らしから
				抜け出せそうにないわ。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				最近の好景気で
				お家賃が高止まりしてるらしいの。{wait}
			}
			TextWait
			TextTalk self {
				はあ、ルームシェアなら
				何とかなるかと思ったんだけど。{wait}
			}
			TextWait
	elif flag[526]:
		if !flag[0]:
			TextTalk self {
				うちのパパね、大きな会社に
				勤めてるんだけど……{wait}
			}
			TextWait
			TextTalk self {
				最近『導力ネット』ってのが
				整備されたんだって。{wait}
			}
			TextWait
			TextTalk self {
				でも使い方が判らないって
				毎日困ってるわ。{wait}
			}
			TextWait
			TextTalk self {
				んもう、ダメダメよねぇ～。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				『導力ネット』って、何だか
				スゴク便利なものらしいけど……{wait}
			}
			TextWait
			TextTalk self {
				使い方が判らないんじゃ
				無いのと同じよねぇ～。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[1]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if flag[1792]:
		TextTalk self {
			ようやっと、長引いておった
			予算議会が片付いたそうじゃ。{wait}
		}
		TextWait
		TextTalk self {
			市民への発表は後日……
			はてさて、如何なる結果になったかのう。{wait}
		}
		TextWait
		TextTalk self {
			せめて去年よりは
			ムダの少ない予算案が
			可決されている事を祈るばかりじゃ。{wait}
		}
		TextWait
	elif flag[1566]:
		TextTalk self {
			今日こそ予算議会に
			決着がつくかのう。{wait}
		}
		TextWait
		TextTalk self {
			今年は例年よりさらに
			長引いておる気がするわい。{wait}
		}
		TextWait
	elif flag[1554]:
		TextTalk self {
			聞いたか、マフィアの抗争の噂……{wait}
		}
		TextWait
		TextTalk self {
			嫌な感じじゃ……
			昔はこういうことには
			常に人死にが絡んでおった。{wait}
		}
		TextWait
		TextTalk self {
			クロスベルも多少は
			平和になったかと思うたが、
			まだまだ安心できんのう……{wait}
		}
		TextWait
	elif flag[1550]:
	elif flag[1536]:
		if !flag[1]:
			TextTalk self {
				鉱山町マインツへ向かうトンネルから
				分かれた道の先に遺跡があってな。{wait}
			}
			TextWait
			TextTalk self {
				満月の夜に美しい鐘の音色を
				鳴り響かせるという伝説があるのじゃよ。{wait}
			}
			TextWait
			TextTalk self {
				中世の時代に建てられたらしいこと
				以外は何もわかっていないがのう。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				鉱山町マインツへ向かうトンネルから
				分かれた道の先に遺跡があってな。{wait}
			}
			TextWait
			TextTalk self {
				満月の夜に美しい鐘の音色を
				鳴り響かせるという伝説があるのじゃよ。{wait}
			}
			TextWait
	elif flag[1342]:
		if !flag[1]:
			TextTalk self {
				明日から、予算議会が
				市庁舎の方で行われるのじゃ。{wait}
			}
			TextWait
			TextTalk self {
				クロスベルの各公共事業に回される
				予算を決定する大事な議会なのだが……{wait}
			}
			TextWait
			TextTalk self {
				毎年、終了予定日までには
				纏まらなくてのう。
				今年はどうなることやら……{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				クロスベルの予算議会は、
				毎年なかなか纏まらなくてのう。{wait}
			}
			TextWait
			TextTalk self {
				市長と議長の対立が
				決定を遅らせているようじゃが、
				今年はどうなることやら……{wait}
			}
			TextWait
	elif flag[1055]:
		if !flag[1]:
			TextTalk self {
				クロスベル市の南にある
				『星見の塔』は
				中世に建てられたものとされておる。{wait}
			}
			TextWait
			TextTalk self {
				当時からクロスベルは
				交易と戦乱の地だったという。{wait}
			}
			TextWait
			TextTalk self {
				時の有力者が
				占星術を頼って
				作らせたという話じゃよ。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				『星見の塔』は中世の頃
				占星術のために作られたという。{wait}
			}
			TextWait
			TextTalk self {
				もっとも、ろくに
				調査されたことが無いとも聞く。
				嘘か本当かは定かではないな。{wait}
			}
			TextWait
	elif flag[1040]:
		TextTalk self {
			ＩＢＣの総裁・ディーター殿は
			昔からクロスベルを支えてきた
			経済の第一人者じゃ。{wait}
		}
		TextWait
		TextTalk self {
			ただ儲けておるだけではなく、
			公共事業や福祉・支援機関への寄付も
			精力的に行っておる。{wait}
		}
		TextWait
		TextTalk self {
			天はニ物を与えぬというが……
			ディーター殿にはニ物も三物も
			感じてしまうな。{wait}
		}
		TextWait
	elif flag[1037]:
		TextTalk self {
			さて、わしもそろそろ帰らねばな。{wait}
		}
		TextWait
		TextTalk self {
			いつまでもこんな所にいたら
			風邪をひいてしまうわい。{wait}
		}
		TextWait
	elif flag[1031]:
		TextTalk self {
			噂のアルカンシェルの新作は、
			準主役に新人が起用されたそうじゃ。{wait}
		}
		TextWait
		TextTalk self {
			あのイリア・プラティエに
			スカウトされたという噂が本当なら、
			かなりの実力者じゃろうな。{wait}
		}
		TextWait
	elif flag[1024]:
		TextTalk self {
			クロスベル自治州に住むものは
			賑やかなことが大好きでな。{wait}
		}
		TextWait
		TextTalk self {
			特に祭りともなると、
			老いも若きも沸きあがるもんじゃ。{wait}
		}
		TextWait
		TextTalk self {
			来月開催される創立記念祭は７０周年。
			今年はどれほどの賑わいを見せるかのう。{wait}
		}
		TextWait
	elif flag[801]:
		TextTalk self {
			劇団《アルカンシェル》は
			クロスベルが誇る大スター集団じゃ。{wait}
		}
		TextWait
		TextTalk self {
			外国の著名人にも人気でな、
			お忍びで入国してくる者も
			少なくないそうじゃぞ。{wait}
		}
		TextWait
	elif flag[777]:
		if !flag[1]:
			TextTalk self {
				この前裏通りの方で
				妙なアンティークショップを
				見つけたんじゃ。{wait}
			}
			TextWait
			TextTalk self {
				おかしな品が並んでおってな、
				店主の婆さんも
				怪しい感じじゃったわい。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				この前裏通りの方で
				妙なアンティークショップを
				見つけたんじゃ。{wait}
			}
			TextWait
			TextTalk self {
				はて……昔から
				あんな店があったかのう。{wait}
			}
			TextWait
	elif flag[768]:
		if !flag[1]:
			TextTalk self {
				クロスベル人というやつは
				中々に噂好きでな。{wait}
			}
			TextWait
			TextTalk self {
				毎日散歩しておるだけで
				随分と物知りになってしまうんじゃ。{wait}
			}
			TextWait
			TextTalk self {
				事件の裏話から
				外国の景気の動向まで……{wait}
			}
			TextWait
			TextTalk self {
				クロスベルにはあらゆる情報が
				飛び交っておるといっても
				過言ではないじゃろうな。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				クロスベル人と
				いうやつは噂好きなんじゃ。{wait}
			}
			TextWait
			TextTalk self {
				まあ、昔から交易を
				しておった民じゃからかのう。{wait}
			}
			TextWait
	elif flag[533]:
		if !flag[1]:
			TextTalk self {
				クロスベルには昔から
				ルバーチェ商会という連中がおる。{wait}
			}
			TextWait
			TextTalk self {
				……いわゆるマフィアじゃな。{wait}
			}
			TextWait
			TextTalk self {
				悲しいことに警察にも
				取り締まる事ができんのじゃ。
				関わらん方がええぞ。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				ルバーチェ商会は警察も
				ろくに取り締まる事ができん。
				……関わらん方がええぞ。{wait}
			}
			TextWait
	elif flag[526]:
		if !flag[1]:
			TextTalk self {
				百貨店の新装に
				新しいオーバルストア……{wait}
			}
			TextWait
			TextTalk self {
				クロスベルの街並みは
				どんどん新しくなっていくのう。{wait}
			}
			TextWait
			TextTalk self {
				良い事とは思うが、
				こうも目まぐるしくては
				迷子になってしまいそうじゃ。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				こうも街並みが変わると
				クロスベル育ちのワシでも
				迷子になってしまいそうじゃよ。{wait}
			}
			TextWait
	CharSetChipPattern self 0
	TextEnd self
	Return

fn[2]:
	TextStart self
	if flag[1792]:
		TextTalk self {
			さっき空港のほうから
			警察官が引き揚げて行ったよ。{wait}
		}
		TextWait
		TextTalk self {
			爆発物がどうとか
			話していたらしいけど……
			ううむ、やはり物騒だなぁ……{wait}
		}
		TextWait
	elif flag[1566]:
		if !flag[2]:
			TextTalk self {
				警察の車両が慌てて
				空港のほうに向かっていったよ。{wait}
			}
			TextWait
			TextTalk self {
				何かあったんだろうか。
				いやな感じだねぇ……{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			TextTalk self {
				警察が慌てているなんて
				ろくな事じゃないに決まってる。
				いやな感じだねぇ……{wait}
			}
			TextWait
	elif flag[1554]:
		if !flag[2]:
			TextTalk self {
				港湾区の事件……聞いたかい？{wait}
			}
			TextWait
			TextTalk self {
				……子供をあまり遠くに
				行かせないようにしないとな。{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			TextTalk self {
				ミミ、物騒だから
				あまり父さんのそばから
				離れるんじゃないぞー。{wait}
			}
			TextWait
	elif flag[1550]:
	elif flag[1536]:
		TextTalk self {
			導力車が普及してきた今、
			道路の整備に積極的に
			取り組むべきだと思う。{wait}
		}
		TextWait
		TextTalk self {
			特に中央広場は人通りも多いし、
			予算が割けるなら
			道路の拡張をして欲しいよね。{wait}
		}
		TextWait
	elif flag[1342]:
		if !flag[2]:
			CharTurnToChar self name[82] 0deg/s
			TextTalk self {
				おや、キミは……
				特務支援課の子なのかい？{wait}
			}
			TextWait
