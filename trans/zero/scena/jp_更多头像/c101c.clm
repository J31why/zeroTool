fn[4]:
	TextStart char[0]
	if flag[1307]:
		if !flag[0]:
			TextTalk char[0] {
				#04000Fあら、坊やたちじゃない。
				これからどこかにお出掛けかしら？{wait}
			}
			TextWait
			TextTalk name[0] {
				#0012Fえ、ええ、仕事がてら……{wait}
			}
			TextWait
			TextTalk char[0] {
				#04005Fそう……{wait}
			} {
				#04003F……まあいいわ。
				警察内部の事情にまで
				首を突っ込むつもりは無いし。{wait}
			} {
				#04000Fどこに行くか知らないけど
				自分たちの責任で頑張りなさいな。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0001F……はい。{wait}
			}
			TextWait
			TextTalk name[2] {
				#0203F（薄々感づかれてます……）{wait}
			}
			TextWait
			TextTalk name[3] {
				#0301F（ハン、さすがに鋭いな……）{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				#04003Fま、警察にも色々あるんでしょうけど
				アタシが口を出すことじゃないわね。{wait}
			} {
				#04000Fせいぜい頑張りなさい。
				ただし、自分たちの責任でね。{wait}
			}
			TextWait
	elif flag[1362]:
		if !flag[0]:
			Call fn[0,5]
		else:
			TextTalk char[0] {
				#04006Fやれやれ、本当はアリオスに
				お休みをあげたかったんだけど。{wait}
			} {
				#04008F……シズクちゃん、
				寂しがっていないかしら？{wait}
			}
			TextWait
	elif flag[1292]:
		if !flag[0]:
			TextTalk char[0] {
				#04004Fそろそろ市外に足を伸ばす
				観光客も出てくる頃よ。{wait}
			} {
				#04000Fウチもウルスラ病院の方に
				エステルちゃんたちを回したわ。{wait}
			} {
				#04000Fま、アナタたちも
				せいぜい気をつけておきなさい。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				#04001Fアリオスは手配魔獣の対処……{wait}
			} {
				#04003Fパレードへの対応は
				リンたちに任せるとして……{wait}
			} {
				#04001F例の件はスコットに頼んで
				ヴェンツェルは待機かしら……{wait}
			} {
				#04006Fああん、もう！
				人手が倍は欲しいわねぇ。{wait}
			}
			TextWait
	elif flag[1282]:
		if !flag[1437]:
			TextTalk char[0] {
				#04000Fアナタたち、昨日は随分
				活躍したみたいじゃない？{wait}
			} {
				#04009Fウチのエステルちゃんたちを
				出し抜くなんて大金星だわ。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000Fはは……
				それは俺たちも同感です。{wait}
			}
			TextWait
			TextTalk name[3] {
				#0306Fちょいと禁じ手を
				使っちまったからなぁ。{wait}
			}
			TextWait
			TextTalk char[0] {
				#04004Fま、その調子で成長して
				こっちを楽にしてちょうだい。{wait}
			} {
				#04000Fそうそう……
				アリオスが昨日の夜、
				やっと出張から戻ってきたのよ。{wait}
			} {
				#04006F市庁舎からの要請が来てたから
				早速、シンポジウムの
				警備に回ってもらったわ。{wait}
			}
			TextWait
			Emote name[0] 0mm 2000mm 38 38 250ms 1
			Sleep 500ms
			TextTalk name[0] {
				#0005Fあれ、シンポジウムの警備は
				警察が担当していたんじゃ……{wait}
			}
			TextWait
			TextTalk name[2] {
				#0200Fええ、それも捜査一課が
				受け持っていたはずです。{wait}
			}
			TextWait
			TextTalk char[0] {
				#04003Fま、共同警備ってわけね。{wait}
			} {
				#04000F外国のＶＩＰも参加するから
				少しでも確実な可能性を
				追求したんじゃないかしら？{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000Fな、なるほど……{wait}
			}
			TextWait
			TextTalk name[3] {
				#0300Fそらま、《風の剣聖》がいたら
				確実は確実だわな。{wait}
			}
			TextWait
			TextTalk name[1] {
				#0100F一応、そういう場合には
				警察とギルドも協力するんですね。{wait}
			}
			TextWait
			FlagSet flag[1437]
		elif !flag[0]:
			TextTalk char[0] {
				#04005Fそういえば……
				エステルちゃんたちの方は
				野暮用があるとか言ってたわね。{wait}
			} {
				#04003F何でもちょっと辺鄙#4Rへんぴ#な所を
				訪ねてみるらしいけど……{wait}
			} {
				#04012Fま、アリオスも戻ってきたし
				少しは息抜きしてもらいましょう。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				#04003Fアリオスは市庁舎、
				エステルちゃんたちは私用……{wait}
			} {
				#04001FスコットたちはＩＢＣ、
				リンたちは大聖堂ね……{wait}
			} {
				#04006F……ふう、メンバーの行動を
				把握するものも楽じゃないわね。{wait}
			}
			TextWait
	elif flag[1280]:
		if !flag[0]:
			TextTalk char[0] {
				#04000Fあら坊やたち、ご苦労様。{wait}
			} {
				#04001F実は、本部の要請で出張してる
				アリオスの帰国が遅れているのよ。{wait}
			} {
				#04008F結局、記念祭の初日には
				間に合わなかったのよねぇ……{wait}
			} {
				#04001F本部の連中にはアタシから
				苦情を言ってやらなくちゃ。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				#04001F記念祭の間は
				出張は基本的にキャンセル。
				全メンバーで乗り切るのが通例よ。{wait}
			} {
				#04007Fまったく……よりによって
				アリオスを独り占めするなんて
				本部には文句言わなくっちゃ。{wait}
			}
			TextWait
	TextEnd char[0]
	Return

fn[5]:
	TextStart self
	if flag[1362]:
		if !flag[0]:
			_Char4A char[0] 255
			_Char4A char[1] 255
			TextTalk char[0] {
				#04000F戻ったばかりで悪いけど
				ちょっと時間をもらえる？{wait}
			} {
				#04001Fさっきレミフェリア支部から
				連絡があったんだけど……{wait}
			}
			TextWait
			TextTalk char[1] {
				#1403F例の件についてか……{wait}
			} {
				#1400F……分かった。
				詳しい話を聞こう。{wait}
			}
			TextWait
			_Char4B char[0] 255
			_Char4B char[1] 255
			CharFlagsUnset char[0] 0x0010
			CharFlagsUnset char[1] 0x0010
			FlagSet flag[0]
		else:
			TextTalk char[1] {
				#1403F……先ほどの件は気にするな。{wait}
			} {
				#1400Fまだ仕事があるのだろう？
				お前たちのペースで励むがいい。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[6]:
	TextStart self
	if flag[1307]:
		if !flag[2]:
			_Char4A char[2] 255
			_Char4A char[3] 255
			TextTalk char[2] {
				#08409F今予定されている仕事をこなせば
				来週の出張は行かなくていいと
				ミシェルに言われたよ。{wait}
			} {
				#08405Fヴェンツェル、もしかしてお前……{wait}
			}
			TextWait
			TextTalk char[3] {
				#08504Fたまには１人で出張に行きたい……
				俺はそう希望を出しただけだ。{wait}
			} {
				#08500F記念祭の忙しい時期も終わる。
				……たまには婚約者と過ごすんだな。{wait}
			}
			TextWait
			TextTalk char[2] {
				#08404F……ありがとう、相棒。{wait}
			}
			TextWait
			CharFlagsUnset char[2] 0x0010
			CharFlagsUnset char[3] 0x0010
			_Char4B char[2] 255
			_Char4B char[3] 255
			FlagSet flag[2]
		else:
			TextTalk self {
				#08400F来週はヴェンツェルの言うように……
				パールと過ごすとするかな。{wait}
			} {
				#08404F……彼女の予定も
				確認しておかないとな。{wait}
			} {
				#08406F久しぶりに会うとなると
				緊張するなぁ……{wait}
			}
			TextWait
	TextEnd self
	Return

fn[7]:
	TextStart self
	if flag[1307]:
		if !flag[2]:
			Call fn[0,6]
		else:
			TextTalk self {
				#08503Fスコットは仕事にかまけすぎて
				婚約者とろくすっぽ会えていない。{wait}
			} {
				#08500Fたまにはこういう時間を
