fn[8]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if flag[1362]:
		if !flag[3]:
			TextTalk self {
				#08606Fようやくパレードの警備が
				終わったよ。{wait}
			} {
				#08606Fあの人ごみの中にいるのは
				流石に疲れたね。{wait}
			}
			TextWait
			TextTalk name[3] {
				#0300Fおお……お疲れ。{wait}
			}
			TextWait
			TextTalk self {
				#08609Fん、どうもどうも。
				まぁ、ゆっくり体を休めるとするよ。{wait}
			}
			TextWait
			FlagSet flag[3]
		else:
			TextTalk self {
				#08605Fそういえば、人ごみの中に
				見たことある顔がいたような……{wait}
			} {
				#08603Fううん、気のせいかな。
				あの人がクロスベルに来るなんて
				連絡はなかったし……{wait}
			}
			TextWait
	CharSetChipPattern self 0
	TextEnd self
	Return

