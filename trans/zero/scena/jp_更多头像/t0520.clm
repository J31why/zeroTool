fn[5]:
	if flag[812] && !flag[813]:
		Call fn[0,17]
	else:
		TextStart char[0]
		var[0] = 99
		while var[0] == 99:
			FadeOut 300ms 0x00000000 100
			Menu menu[0] -1 -1 1
				"話をする" // 0
				"買い物をする" // 1
				"休憩をする" // 2
				"やめる" // 3
			MenuWait var[0]
			if var[0] < 1 | var[0] > 2:
				MenuClose menu[0]
				FadeIn 300ms 0x00000000
				FadeWait
			if var[0] == 1:
				ShopOpen shop[82]
				var[0] = 99
			elif var[0] == 2:
				ShopOpen shop[80]
				var[0] = 99
			elif var[0] != 0:
			elif var[0] == 0:
				var[0] = 99
				if flag[1566]:
					TextTalk char[0] {
						結局ガンツさんがいなくなった理由も、
						村長が帰ってこない理由も
						未だに私らには伏せられたままさ。{wait}
					}
					TextWait
					TextTalk char[0] {
						ああ、心配だねぇ……{wait}
					}
					TextWait
				elif flag[1554]:
					TextTalk char[0] {
						バスに乗ろうとしてた町長を
						見かけたんだが、
						なんだか浮かない顔をしていてね。{wait}
					}
					TextWait
					TextTalk char[0] {
						ガンツさんに何かあったのかねぇ？{wait}
					}
					TextWait
				elif flag[1547]:
					TextTalk char[0] {
						数ヶ月前の魔獣騒動といい
						今回の鉱員の失踪といい……{wait}
					}
					TextWait
					TextTalk char[0] {
						なんだか短い間に
						色々なことが起こってるねぇ。{wait}
					}
					TextWait
					TextTalk char[0] {
						悪いことの予兆だったり
						しなきゃあいいんだが……{wait}
					}
					TextWait
				elif flag[1544]:
					TextTalk char[0] {
						なんだかお疲れのようだね。
						なんだったら宿をとってくかい？{wait}
					}
					TextWait
				elif flag[1536]:
					TextTalk char[0] {
						なんだか最近締まらないねぇ……{wait}
					}
					TextWait
					TextTalk char[0] {
						一番飲みっぷりのいいのが
						来ないからかしら。{wait}
					}
					TextWait
				elif flag[1307]:
					if !flag[0]:
						TextTalk char[0] {
							うちに置いてある酒は、
							ハロルドっていう商人さんに
							頼んでるんだよ。{wait}
						}
						TextWait
						TextTalk char[0] {
							流石、身なりがいいだけあって
							なかなかいい酒を
							選んで持ってきてくれるんだ。{wait}
						}
						TextWait
						TextTalk char[0] {
							最近鉱員どもに麦酒を
							あらかた開けられちまったし……
							また来た時に頼んでおかないとねぇ。{wait}
						}
						TextWait
						FlagSet flag[0]
					else:
						TextTalk char[0] {
							ハロルドさんが仕入れてくれる酒は
							なかなかいいものが多くてね。{wait}
						}
						TextWait
						TextTalk char[0] {
							ウチとしては重宝させてもらってるよ。{wait}
						}
						TextWait
				elif flag[1292]:
					if !flag[0]:
						TextTalk char[0] {
							ウェイトレスのリュッカ、
							いつもはブアイソでね。
							憎まれ口ばかり叩いちゃうのよ。{wait}
						}
						TextWait
						TextTalk char[0] {
							……今度、お酒を盛ってやろうかねぇ。{wait}
						}
						TextWait
						TextTalk char[0] {
							あの子、めちゃくちゃ酒に弱いからね。
							酔っ払ったときの顔は見ものなんだよ。{wait}
						}
						TextWait
						Emote field_party[0] 0mm 2000mm 16 19 250ms 1
						SoundPlay sound[23] 0 100 0
						Emote field_party[1] 0mm 2000mm 16 19 250ms 1
						SoundPlay sound[23] 0 100 0
						Emote field_party[2] 0mm 2000mm 16 19 250ms 1
						SoundPlay sound[23] 0 100 0
						Emote field_party[3] 0mm 2000mm 16 19 250ms 1
						SoundPlay sound[23] 0 100 0
						Sleep 1000ms
						TextTalk name[1] {
							#0106F軽犯罪にならないのかしら……{wait}
						}
						TextWait
						FlagSet flag[0]
					else:
						TextTalk char[0] {
							……今度、リュッカにお酒を盛ってやろうかねぇ。{wait}
						}
						TextWait
						TextTalk char[0] {
							あの子、めちゃくちゃ酒に弱いからね。
							酔っ払ったときの顔は見ものなんだよ。{wait}
						}
						TextWait
				elif flag[1282]:
					TextTalk char[0] {
						創立７０周年だからかねぇ。
						今年は去年より観光客が多くて
						大助かりだよ。{wait}
					}
					TextWait
					TextTalk char[0] {
						この時期は、いつも鉱員たちは
						街に行っちまうから儲からないんだよね。{wait}
					}
					TextWait
				elif flag[1280]:
					if !flag[0]:
						TextTalk char[0] {
							昨日は鉱員全員で宴会をやってたのさ。{wait}
						}
						TextWait
						TextTalk char[0] {
							忙しかったけど、
							あれだけ楽しそうにしてもらえると
							酒場冥利に尽きるというものさ。{wait}
						}
						TextWait
						FlagSet flag[0]
					else:
						TextTalk char[0] {
							そういえば、鉱員のロージーが
							完全に潰れちゃってね。
							仕方なく店で休ませてるんだ。{wait}
						}
						TextWait
						TextTalk char[0] {
							まったく、若いってのに
							情けないったらありゃしないね。{wait}
						}
						TextWait
				elif flag[1055]:
					TextTalk char[0] {
						今日来てるお客さん、
						随分若いけど遊撃士だそうだよ。{wait}
					}
					TextWait
					TextTalk char[0] {
						……なんだか重い雰囲気だけど
						何かあったのかしらねぇ？{wait}
					}
					TextWait
				elif flag[1040]:
					if !flag[0]:
						TextTalk char[0] {
							ほんと、昼間のこの店は
							ヒマなもんだよ。{wait}
						}
						TextWait
						TextTalk char[0] {
							……よし、ヒマだから
							いいことを教えてあげよう。{wait}
						}
						TextWait
						TextTalk char[0] {
							ウェイトレスやってるリュッカは
							いつもブアイソなんだけどね……{wait}
						}
						TextWait
						TextTalk char[0] {
							笑うと超絶に可愛いのさ。
							あたしが男だったら
							絶対惚れちまうね。{wait}
						}
						TextWait
						FlagSet flag[0]
					else:
						TextTalk char[0] {
							リュッカはいつもブアイソだけど、
							笑顔は超絶に可愛いんだよ。{wait}
						}
						TextWait
						TextTalk char[0] {
							ま、その笑顔に
							なかなかならないのが
							残念なんだけどねぇ。{wait}
						}
						TextWait
				elif flag[1024]:
					if !flag[0]:
						TextTalk char[0] {
							魔獣騒ぎも収まって、
							この町もいつも通りさ。{wait}
						}
						TextWait
						TextTalk char[0] {
							鉱員連中は
							『早く帰れなくなった』なんて
							寝ぼけたことをぬかしてたけどね。{wait}
						}
						TextWait
						TextTalk char[0] {
							とにかく、
							危険な目に遭わなくなって
							本当によかったよ。{wait}
						}
						TextWait
						FlagSet flag[0]
					else:
						TextTalk char[0] {
							魔獣騒ぎも収まって、
							鉱員や町の人間が
							襲われることもなくなった。{wait}
						}
						TextWait
						TextTalk char[0] {
							アンタたちのお陰さ。
							本当にありがとうよ。{wait}
						}
						TextWait
				elif flag[812]:
					if !flag[0]:
						TextTalk char[0] {
							ん、出かけるのかい？{wait}
						}
						TextWait
						TextTalk char[0] {
							最近物騒だし、
							遅くならないうちに帰るんだよ。{wait}
						}
						TextWait
						FlagSet flag[0]
					else:
						TextTalk char[0] {
							なんだったら飲んで
							暖まってくかい？{wait}
						}
						TextWait
						TextTalk char[0] {
							……席埋まっちゃってるけど。{wait}
						}
						TextWait
				elif flag[801]:
					if !flag[820]:
						FlagSet flag[820]
						global[2] = global[2] + 1
					if !flag[0]:
						TextTalk char[0] {
							おや、見かけない顔だねぇ。
							クロスベル市から来たのかい？{wait}
						}
						TextWait
						TextTalk char[0] {
							しかし、
							タイミングの悪い時に来たねぇ。{wait}
						}
						TextWait
						TextTalk char[0] {
							最近、狼型の魔獣が
							この辺を荒らしまわっててね。{wait}
						}
						TextWait
						TextTalk char[0] {
							うちも前に食糧庫を荒らされてねぇ。
							まったく、迷惑ったらないよ。{wait}
						}
						TextWait
						FlagSet flag[0]
					else:
						TextTalk char[0] {
							そうそう、
							良かったら何か食べてくかい？{wait}
						}
						TextWait
						TextTalk char[0] {
							ゆっくり休もうと思ったら
							今が休み時だよ。{wait}
						}
						TextWait
						TextTalk char[0] {
							夜になったら、
							帰ってきた鉱員どもで
							席がいっぱいになっちまうからね。{wait}
						}
						TextWait
		TextEnd char[0]
	Return

fn[6]:
	TextStart self
	if flag[1566]:
		TextTalk self {
			ガンツさん失踪には
			とんでもなく大きな謎が……
			隠されているような気がするわ。{wait}
		}
		TextWait
		TextTalk self {
			……ミステリー小説の
			読みすぎかしら……{wait}
		}
		TextWait
	elif flag[1554]:
		TextTalk self {
			ガンツさんが見つかったってことは……
			またお祝いの宴会が開かれる可能性は大ね。{wait}
		}
		TextWait
		TextTalk self {
			はぁ……また片付けが大変なんだろうな。{wait}
		}
		TextWait
	elif flag[1547]:
		TextTalk self {
			ガンツさんってほんと、
			賭け事はへたくそみたいよ。{wait}
		}
		TextWait
		TextTalk self {
			ここで酔っ払ってるときの話題は
			大抵賭け事に負けた愚痴だったもの。{wait}
		}
		TextWait
	elif flag[1544]:
		TextTalk self {
			ん、掃除はこんなとこかな。{wait}
		}
		TextWait
		TextTalk self {
			ガンツさん１人いないだけで
			掃除もえらく簡単ね。{wait}
		}
		TextWait
	elif flag[1536]:
		if !flag[1]:
			TextTalk self {
				さーて、客の居ぬ間に掃除しなきゃ。{wait}
			}
			TextWait
			TextTalk self {
				って言っても、最近はなんだか
				あんまり宴会をしてないみたいだけど。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				最近はあまり宴会がないから
				掃除が楽でいいわ。{wait}
			}
			TextWait
	elif flag[1307]:
		TextTalk self {
			今日で記念祭も終わりかぁ。{wait}
		}
		TextWait
		TextTalk self {
			観光客はいなくなるかもしれないけど、
			入れ替わりに鉱員が帰ってくるのよね。{wait}
		}
		TextWait
		TextTalk self {
			あーあ、忙しい忙しい。{wait}
		}
		TextWait
	elif flag[1292]:
		TextTalk self {
			まぁまぁ忙しいけど……
			あなたたちもなんか飲んでく？{wait}
		}
		TextWait
		TextTalk self {
			……仕事中だとしても責任持たないけど。{wait}
		}
		TextWait
	elif flag[1282]:
		TextTalk self {
			記念祭やってる最中に
			わざわざこんな寂れたトコにくる
			観光客ねぇ……{wait}
		}
		TextWait
		TextTalk self {
			……ま、気持ちはわかるかな。
			私も人ごみ嫌いだし。{wait}
		}
		TextWait
	elif flag[1280]:
		if !flag[1]:
			TextTalk self {
				ったく、毎日毎日ホント大変ね。{wait}
			}
			TextWait
			TextTalk self {
				……酒なんかどこがいいのかしら。
				私全然飲めないから魅力が分からないわ。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0006Fや、宿酒場のウェイトレスとは
				思えない発言だね……{wait}
			}
			TextWait
			TextTalk self {
				うっさいよお客さん。
				私の勝手でしょ。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				ほんと、酒なんかどこがいいのかしら。{wait}
			}
			TextWait
			TextTalk self {
				……前に興味本位で飲んだときは
				記憶が無くなっちゃったから、
