	Return

fn[8]:
	TextStart self
	if QuestTaskGet quest[29] 3 && !QuestFlagsGet quest[29] 0x10 && !QuestFlagsGet quest[29] 0x40:
		if !QuestTaskGet quest[29] 4:
			if !flag[10]:
				TextTalk name[0] {
					#0001F（よし、聞き込みをしてみよう。）{wait}
				} {
					#0000Fすみません、
					少しよろしいですか？{wait}
				}
				TextWait
			FlagSet flag[10]
			FadeOut 300ms 0x00000000 100
			TextSetName ""
			TextMessage null {
				{color 5}ロイド達はストーカーについて
				心当たりを尋ねてみた。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			_59
			TextTalk self {
				……例のストーカーの話ね。
				雇われ管理人として
				私も警戒しているわ。{wait}
			}
			TextWait
			TextTalk name[1] {
				#0100Fストーカーを実際に
				見かけた事はありますか？{wait}
			}
			TextWait
			TextTalk self {
				私はここに
				毎日顔を出しているけど、
				実はほとんど無いわね。{wait}
			}
			TextWait
			TextTalk self {
				でも先日、ちらっとだけ見たわ。{wait}
			}
			TextWait
			TextTalk self {
				帽子を深くかぶった少年だったけど
				すぐに消えてしまったから
				詳しい事は判らないわね。{wait}
			}
			TextWait
			TextTalk name[2] {
				#0200F他に思い出せる特徴などは？{wait}
			}
			TextWait
			TextTalk self {
				そうね……{wait}
			}
			TextWait
			TextTalk self {
				あえて言えば、
				特に特徴が無いのが特徴ね。{wait}
			}
			TextWait
			Emote field_party[0] 0mm 2000mm 0 1 250ms 2
			SoundPlay sound[29] 0 100 0
			Emote field_party[1] 0mm 2000mm 0 1 250ms 2
			SoundPlay sound[29] 0 100 0
			Emote field_party[2] 0mm 2000mm 0 1 250ms 2
			SoundPlay sound[29] 0 100 0
			Emote field_party[3] 0mm 2000mm 0 1 250ms 2
			SoundPlay sound[29] 0 100 0
			Sleep 1000ms
			TextTalk self {
				地味な格好だったのかしら。
				さっぱり記憶に無いわ。{wait}
			}
			TextWait
			TextTalk name[3] {
				#0303Fふむ、そう来るか……{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000Fでもリーシャから聞いた情報に
				間違いはなさそうだな……{wait}
			}
			TextWait
			QuestTaskSet quest[29] 4
			if QuestTaskGet quest[29] 4 && QuestTaskGet quest[29] 5 && QuestTaskGet quest[29] 6 && QuestTaskGet quest[29] 7 && QuestTaskGet quest[29] 8:
				TextTalk name[0] {
					#0000Fよし、下調べはこんな所だな。{wait}
				} {
					一旦イリアさんの部屋に戻って
					整理してみよう。{wait}
				}
				TextWait
				TextTalk name[3] {
					#0300F了解、そろそろ作戦を考えるか！{wait}
				}
				TextWait
				TriggerFlagsUnset trigger[0] 0x0080
				QuestTaskSet quest[29] 9
		else:
			TextTalk self {
				私が見たのは
				帽子を深くかぶった少年ね。
				人相までは判らなかったわ。{wait}
			}
			TextWait
			TextTalk self {
				あとは、結構
				地味な格好だったと思うわ。{wait}
			}
			TextWait
			TextTalk self {
				特に記憶に残っていないもの。{wait}
			}
			TextWait
	elif flag[1792]:
		if !flag[0]:
			TextTalk self {
				さー、仕事仕事……{wait}
			}
			TextWait
			TextTalk self {
				これもお給料を溜めて
				イリア様の舞台を見るため……{wait}
			}
			TextWait
			TextTalk self {
				来月辺りのチケットが
				確保できるといいわね～。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				ゴミの分別も排水溝の掃除も、
				すべてはイリア様にお会いするため……{wait}
			}
			TextWait
			TextTalk self {
				さー、もう少し頑張りますか。{wait}
			}
			TextWait
	elif flag[1566]:
		if !flag[0]:
			TextTalk self {
				３階の人、この前
				ようやく後姿を拝めたわ。{wait}
			}
			TextWait
			TextTalk self {
				出かけていく所だったから
				よく見えなかったけど……{wait}
			}
			TextWait
			TextTalk self {
				ま、どこにでもいそうな
				普通の人だったわね。{wait}
			}
			TextWait
			TextTalk self {
				金髪は綺麗だったけど。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				ま、ファッションを嗜む女性なら
				あのくらい決めてて普通よね。{wait}
			}
			TextWait
			TextTalk self {
				うん、後姿からして
				意外と普通っぽい人だったわ。{wait}
			}
			TextWait
	elif flag[1554]:
		if !flag[0]:
			TextTalk self {
				さ、仕事仕事……{wait}
			}
			TextWait
			TextTalk self {
				またお給料を貯めて
				アルカンシェルを見に行くのよ。{wait}
			}
			TextWait
			TextTalk self {
				そのために
				わき目も振らず仕事に励むの！{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				これも全てイリア様に会うため……{wait}
			}
			TextWait
			TextTalk self {
				今日も仕事、仕事よ！{wait}
			}
			TextWait
	elif flag[1536]:
		if !flag[0]:
			TextTalk self {
				３階の人、最近部屋に
				子供を泊めているみたいね。{wait}
			}
			TextWait
			TextTalk self {
				３階の人には会った事が無いけど、
				その子は時々見かけるわ。{wait}
			}
			TextWait
			TextTalk self {
				帽子を被った１３、４歳くらいの
				ちょっと美形な子なのよね。{wait}
			}
			TextWait
			Emote self 0mm 2000mm 38 38 250ms 1
			Sleep 500ms
			TextTalk self {
				…………あら？
				そういえばあの子、前にどこかで
				見たような気がするけど……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				ん～、あの子どこかで
				見た事がある気が……{wait}
			}
			TextWait
			TextTalk self {
				……ま、いいわ。
				管理人が詮索するのも
				ヤボってものよね。{wait}
			}
			TextWait
	elif flag[1342]:
		if !flag[0]:
			TextTalk self {
				くぅ～……っ！！{wait}
			}
			TextWait
			TextTalk self {
				イリア様、素晴らしかったわ！{wait}
			}
			TextWait
			TextTalk self {
				それに……あの競演の
				《月の姫》役の子も凄かったわね。{wait}
			}
			TextWait
			TextTalk self {
				新人アーティストって聞いてるけど
				一気にファンになっちゃったわ！{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				それにしても……イリア様って
				どこに住んでらっしゃるのかしら。{wait}
			}
			TextWait
			TextTalk self {
				住所さえ判明すれば
				私は地の果てまで追っかけをするわよ。{wait}
			}
			TextWait
			if QuestFlagsGet quest[29] 0x10 | flag[1531]:
				Emote field_party[0] 0mm 2000mm 16 19 250ms 1
				SoundPlay sound[23] 0 100 0
				Emote field_party[1] 0mm 2000mm 16 19 250ms 1
				SoundPlay sound[23] 0 100 0
				Sleep 1000ms
				TextTalk name[0] {
					#0005F（イリアさんのこと、
					{}  気付いてないんだ……）{wait}
