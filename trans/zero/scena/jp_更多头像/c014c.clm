fn[9]:
	TextTalk char[1] {
		#08100Fオッケー。
		何について聞きたいの？{wait}
	}
	TextWait
	var[3] = 0
	while var[3] != 255:
		FadeOut 300ms 0x00000000 100
		Menu menu[1] -1 -1 1
			"戦術オーブメントについて" // 0
			"クオーツについて" // 1
			"スロットについて" // 2
			"導力魔法（アーツ）について" // 3
			"やめる" // 4
		MenuWait var[3]
		MenuClose menu[1]
		FadeIn 300ms 0x00000000
		_59
		switch var[3]:
			case 0:
				TextTalk char[1] {
					#08100F《戦術オーブメント》っていうのは、
					個人の戦闘用に特化した
					小型の携帯導力器のことよ。{wait}
				} {
					#08102F使用者の能力を強化してくれるほか
					導力魔法#8Rア  ー  ツ#の使用もサポートしてくれるの。{wait}
				} {
					#08110F一般的には、たんに『オーブメント』って
					呼ばれたりするわね。{wait}
				} {
					#08100Fロイド達が使ってるのは、
					その中でも最新型の
					『エニグマ』っていうタイプよ。{wait}
				} {
					#08104Fオーブメントは個人に合わせて
					完璧に調整されてるから、
					持ち主によって構造が異なるわよ。{wait}
				} {
					#08100F属性限定のスロットがあったり、
					スロットを結ぶ線#2Rライン#の形が違ったりするわ。
					一度みんなで見比べてみるといいかもね。{wait}
				}
				TextWait
				break
			case 1:
				TextTalk char[1] {
					#08100Fクオーツは、セピスを精錬して作られる
					オーブメント用の『結晶回路』のことね。{wait}
				} {
					#08102F必要なセピスさえ持ってきてくれれば
					ウチで合成ができるわよ。{wait}
				} {
					#08100Fクオーツによって色々な効果があるし、
					属性値が一定以上になると
					導力魔法#8Rア  ー  ツ#が使えるようになるの。{wait}
				} {
					#08110Fセピスが溜まったら色々試してみてね。{wait}
				}
				TextWait
				break
			case 2:
				TextTalk char[1] {
					#08100Fオーブメントのスロットは
					初めはほとんどが未開封の状態なの。{wait}
				} {
					#08104Fクオーツをセットするには
					まずはスロットを開封する必要があるわね。{wait}
				} {
					#08102Fスロットを開封すれば、
					クオーツも沢山セットできるようになるし
					最大ＥＰの値も上昇するわ。{wait}
				} {
					#08110F開封にはセピスが必要だけど
					かなり便利になるはずよ。
					積極的に開けていくといいと思うわ。{wait}
				}
				TextWait
				break
			case 3:
				TextTalk char[1] {
					#08100F戦術オーブメントを使って発動する魔法が
					いわゆる導力魔法#8Rオーバルアーツ#ね。{wait}
				} {
					#08110F単純に『アーツ』って呼ばれる事が多いわ。{wait}
				} {
					#08104Fオーブメントに内蔵されている機構と
					クオーツが使用者と共鳴連鎖することで
					魔法現象を展開するんだけど……{wait}
				} {
					#08111Fま、細かいことはいいかな。{wait}
				} {
					#08100Fアーツは、セットしたクオーツの
					『ラインごとの属性値の合計』によって
					発動できる種類が決まってくるの。{wait}
				} {
					#08105Fちょっと難しいけど……
					そうね、例えば。{wait}
				} {
					#08104Fラインが繋がっているスロットに
					クオーツをセットしていって、
					地属性の合計値が２以上になると……{wait}
				} {
					#08110F『クエイク』ってアーツが
					使えるようになるわ。{wait}
				} {
					#08102Fクオーツをセットするほど、
					たくさんのアーツが
					使えるようになるってわけね。{wait}
				} {
					#08109F他のアーツの組み合わせは
					アーツリストに載ってるはずよ。
					参考にしてね。{wait}
				}
				TextWait
				break
			default:
				var[3] = 255
				break
	var[3] = 0
	Return

