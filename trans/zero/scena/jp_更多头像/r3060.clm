			if QuestTaskGet quest[24] 6:
				var[3] += 1
			if QuestTaskGet quest[24] 7:
				var[3] += 1
			if QuestTaskGet quest[24] 8:
				var[3] += 1
			if QuestTaskGet quest[24] 9:
				var[3] += 1
			if QuestTaskGet quest[24] 10:
				var[3] += 1
			if var[3] == 4:
				TextTalk name[0] {
					#12P#0000Fご苦労さん。
					無事に撮影出来たみたいだな。{wait}
				} {
					これでグレイスさんに提示された
					５枚ってノルマは達成できた。
					これでいつでも提出できそうだな。{wait}
				}
				TextWait
			else:
				TextTalk name[0] {
					#12P#0000Fご苦労さん。
					無事に撮影出来たみたいだな。{wait}
				} {
					それじゃ、行くとしようか。{wait}
				}
				TextWait
		FadeOut 1000ms 0x00000000 255
		FadeWait
		CharSetPos field_party[0] (80450, 18000, 14340) 45deg
		CharSetChipBase name[1] chip[255]
		CharSetChipPattern name[1] 0
		UnloadChip chip[50]
		QuestTaskSet quest[24] 10
		Sleep 500ms
		SystemFlagsUnset 0x08000000
		ED7_37
		LookPointFlagsSet look_point[3] 0x0001
		EventEnd 5
	else:
		TextStart null
		CharTurnTo name[0] 45deg 0deg/s
		TextTalk name[0] {
			#0005F（グレイスさんに依頼された写真、
			{}  ここなら撮れそうだけど……）{wait}
		} {
			#0003F（今はそんなことをしている
			{}  場合じゃないな。）{wait}
		} {
			#0001F（一刻も早く観光客を
			{}  保護してやらないと……）{wait}
		}
		TextWait
		TextEnd null
	Return
