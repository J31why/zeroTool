		FadeOut 300ms 0x00000000 100
		Menu menu[1] -1 -1 1
			"戦術オーブメントについて" // 0
			"クオーツについて" // 1
			"スロットについて" // 2
			"導力魔法（アーツ）について" // 3
			"やめる" // 4
		MenuWait var[3]
		MenuClose menu[1]
		if var[3] != 4 && var[3] != -2:
			FadeIn 300ms 0x00000000
			_59
		switch var[3]:
			case 0:
				TextTalk char[1] {
					#08100F《戦術オーブメント》っていうのは、
					個人の戦闘用に特化した
					小型の携帯導力器のことよ。{wait}
				} {
					#08102F使用者の能力を強化してくれるほか
					導力魔法#8Rア  ー  ツ#の使用もサポートしてくれるの。{wait}
				} {
					#08110F一般的には、単に『オーブメント』って
