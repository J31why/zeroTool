				} {
					#08111Fま、細かいことはいいかな。{wait}
				} {
					#08100Fアーツは、セットしたクオーツの
					『ラインごとの属性値の合計』によって
					発動できる種類が決まってくるの。{wait}
				} {
					#08105Fちょっと難しいけど……
					そうね、例えば。{wait}
				} {
					#08104Fラインが繋がっているスロットに
