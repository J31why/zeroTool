	if flag[8]:
		var[0] = 99
		while var[0] == 99:
			FadeOut 300ms 0x00000000 100
			Menu menu[0] -1 -1 1
				"話をする" // 0
				"買い物をする" // 1
				"休憩をする" // 2
				"やめる" // 3
			MenuWait var[0]
			if var[0] < 1 | var[0] > 2:
				MenuClose menu[0]
				FadeIn 300ms 0x00000000
				FadeWait
			if var[0] == 1:
				ShopOpen shop[52]
				var[0] = 99
			elif var[0] == 2:
				ShopOpen shop[50]
				var[0] = 99
			elif var[0] != 0:
			elif var[0] == 0:
				var[0] = 99
				Call fn[0,13]
	else:
		Call fn[0,13]
	TextEnd char[4]
	Return

