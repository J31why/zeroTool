fn[5]:
	TextStart self
	if flag[0]:
		_Char4A char[1] 255
		TextTalk char[0] {
			#0404Fアッバス、折角だから
			乾杯してから行こうか。{wait}
		} {
			#0400Fウフフ、一応クロスベルを
			讃えるお祭りなワケだしさ。{wait}
		}
		TextWait
		_Char4B char[1] 255
	else:
		TextTalk char[0] {
			#0404F今日はみんなで記念祭に
			繰り出そうって話をしていてね。{wait}
		} {
			#0400F……そうだ、君たちもどう？
			結構楽しいと思うよ。{wait}
		}
		TextWait
		TextTalk name[0] {
			#0003Fいや、悪いが職務中だからさ。{wait}
		} {
			#0001Fっていうかワジ、
			分かってて誘ってるだろ？{wait}
		}
		TextWait
		TextTalk char[0] {
			#0409Fあはは！
			君ってホント頭固いなぁ。{wait}
		}
		TextWait
		CharTurnTo char[0] 135deg 0deg/s
		CharFlagsSet char[0] 0x0010
		FlagSet flag[0]
	TextEnd self
	Return

fn[6]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if flag[10]:
		TextTalk char[6] {
			#0400F（アッバスに関しては
			{}  僕も詳しいわけじゃないけど。）{wait}
		} {
			（ゼムリア大陸の
			{}  中東部あたりの出身らしいよ。）{wait}
		} {
			（ふふ……
			{}  かなりの物好きなのは確かだよね。）{wait}
		}
		TextWait
	elif flag[1793]:
		if flag[0]:
			TextTalk char[6] {
				#0400Fじきに日も落ちるだろう。{wait}
			} {
				どこに行くか知らないけど
				早く行った方がいいんじゃない？{wait}
			}
			TextWait
		else:
			TextTalk char[6] {
				#0404F……………………………………{wait}
			}
			TextWait
			TextTalk name[0] {
				#0005Fワジ、どうしたんだ？{wait}
			}
			TextWait
			TextTalk char[6] {
				#0400F……いや、そう言えば
				今夜は満月だと思ってね。{wait}
			} {
				#0402F今日は晴れているし
				綺麗なお月様が見えるんじゃない？{wait}
			}
			TextWait
			TextTalk name[1] {
				#0100Fそう……{wait}
			}
			TextWait
			TextTalk name[2] {
				#0200F月は不吉の
				象徴でもありますが……{wait}
			}
			TextWait
			TextTalk name[3] {
				#0303F……今の状況だと
				洒落になってねぇな。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1792]:
		if flag[0]:
			TextTalk char[6] {
				#0400Fまあ、バイパーの方は
				僕の方でも気に掛けておくよ。{wait}
			} {
				君らは君らの
				仕事をしてくるといい。{wait}
			}
			TextWait
		else:
			TextTalk char[6] {
				#0403Fヴァルドもさすがに
				焦れてきたみたいだね。{wait}
			} {
				#0400F……あの意地っ張りさえ直せば
				楽になれるのにさ。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000Fワジって結構、
				ヴァルドのこと気に掛けてるよな。{wait}
			} {
				#0005F実はバイパーの事だって
				最初から心配してたんじゃ……？{wait}
			}
			TextWait
			TextTalk char[6] {
				#0404Fクス……どうかな。{wait}
			} {
				#0402Fただヴァルドってさ、
				放っておけない所があるんだよね。{wait}
			}
			TextWait
