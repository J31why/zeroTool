fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharWalkToPos self (-4260, 0, 8920) 2000mm/s 0
		CharWalkToPos self (720, 0, 6870) 2000mm/s 0
		CharWalkToPos self (780, 0, 1070) 2000mm/s 0
		CharWalkToPos self (7240, 0, -2090) 2000mm/s 0
		CharWalkToPos self (7240, 0, -6010) 2000mm/s 0
		CharWalkToPos self (3280, 0, -8790) 2000mm/s 0
		CharWalkToPos self (-8880, 0, 3240) 2000mm/s 0
	Return

fn[2]:
	Fork self fork[2]:
		CharShake self 4 0 0 600ms
	while 1:
		var[3] = random % 100
		if var[3] <= 60:
			CharIdle self (-3730, null, 7180) (950, null, 8410) 1000mm/s
			Sleep 100ms
		else:
			CharTurnTo self 225deg 1000deg/s
			CharTurnTo self 315deg 1000deg/s
			CharTurnTo self 45deg 1000deg/s
			CharTurnTo self 135deg 1000deg/s
			CharTurnTo self 225deg 1000deg/s
			Sleep 500ms
	Return

fn[3]:
	if flag[1307]:
		CharSetPos char[3] (-6980, 0, 1280) 90deg
		ForkFunc char[3] fork[0] fn[0,0]
		CharFlagsUnset char[5] 0x0080
		CharFlagsUnset char[6] 0x0080
		CharFlagsUnset char[7] 0x0080
		CharFlagsUnset char[8] 0x0080
		CharFlagsUnset char[9] 0x0080
		CharFlagsUnset char[10] 0x0080
		CharFlagsUnset char[11] 0x0080
		CharFlagsUnset char[12] 0x0080
		CharSetPos char[4] (-210, 5000, 18380) 0deg
		CharSetChipBase char[4] chip[25]
		CharSetChipPattern char[4] 0
		ForkFunc char[4] fork[0] fn[0,0]
		CharFlagsUnset char[4] 0x0040
		CharFlagsSet char[4] 0x0010
		Emote char[4] 0mm 2000mm 24 27 250ms 0
	elif flag[1362]:
		CharSetPos char[2] (-1460, 0, 7630) 180deg
		ForkFunc char[2] fork[0] fn[0,2]
		CharSetPos char[3] (6810, 0, 9660) 270deg
		ForkFunc char[3] fork[0] fn[0,0]
		CharFlagsUnset char[19] 0x0080
		CharFlagsUnset char[21] 0x0080
	elif flag[1292]:
		CharFlagsUnset char[20] 0x0080
		CharFlagsUnset char[22] 0x0080
		CharFlagsUnset char[24] 0x0080
	elif flag[1286]:
		CharFlagsSet char[3] 0x0080
		CharFlagsUnset char[17] 0x0080
		CharFlagsUnset char[18] 0x0080
	elif flag[1282]:
		CharFlagsSet char[3] 0x0080
		CharFlagsUnset char[17] 0x0080
		CharFlagsUnset char[18] 0x0080
	elif flag[1280]:
		CharFlagsUnset char[14] 0x0080
		CharFlagsUnset char[15] 0x0080
		CharFlagsUnset char[16] 0x0080
	Return

fn[4]:
	Return

fn[5]:
	Call fn[0,6]
	Return

fn[6]:
	TextStart char[23]
	if !flag[610]:
		TextTalk char[23] {
			へい、らっしゃい。
			と言いてえところだが……{wait}
		}
		TextWait
		TextTalk char[23] {
			坊主ら、クロスベルじゃ
			許可証がなきゃ武器は売れねえんだぜ。
			冷やかしなら帰るんだな。{wait}
		}
		TextWait
		TextTalk name[0] {
			#0000Fあ、いや俺たちは
			クロスベル警察の者ですけど……{wait}
		}
		TextWait
		Emote char[23] 0mm 2000mm 0 1 250ms 2
		SoundPlay sound[29] 0 100 0
		Sleep 1000ms
		TextTalk char[23] {
			お前らみたいなのが警察……？{wait}
		}
		TextWait
		TextTalk char[23] {
			そうか、セルゲイの奴が
			言っていた例の……{wait}
		}
		TextWait
		TextTalk char[23] {
			フン、分かったぜ。
			好きに見ていけよ。{wait}
		}
		TextWait
		TextTalk char[23] {
			武器を買うときは
			俺に捜査手帳を見せな。
			それが許可証代わりだからよ。{wait}
		}
		TextWait
		FlagSet flag[610]
		FlagSet flag[1402]
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"話をする" // 0
			"買い物をする" // 1
			"やめる" // 2
		MenuWait var[0]
		if var[0] != 1:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			if flag[1792]:
				ShopOpen shop[5]
			elif flag[1536]:
				ShopOpen shop[4]
			elif flag[1280]:
				ShopOpen shop[3]
			elif flag[1024]:
				ShopOpen shop[2]
			elif flag[768]:
				ShopOpen shop[1]
			else:
				ShopOpen shop[0]
			var[0] = 99
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			if flag[1307]:
				if !flag[0]:
					TextTalk char[23] {
						やれやれ、バカ騒ぎも
						今日で最後だな。{wait}
					}
					TextWait
					TextTalk char[23] {
						へっ……ま、お前らも
						騒ぎたいなら今のうちにな。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[23] {
						今日までは無礼講みてえなもんだ。
						騒ぎたいなら今のうちにな。{wait}
					}
					TextWait
			elif flag[1300]:
				TextTalk char[23] {
					よう、まだ迷子の子を
					探してんのかい？{wait}
				}
				TextWait
				TextTalk char[23] {
					この街は広いからなぁ……
					まあ辛抱強く聞き込むしか
					ねえだろうな。{wait}
				}
				TextWait
			elif flag[1294]:
				if !flag[1379]:
					TextTalk name[0] {
						#0001F（うん、この人なら
						{}  何か知っているかもしれないな……）{wait}
					}
					TextWait
					TextMessage null {
						{color 5}ロイドはコリンの写真を見せ
						心当たりが無いか尋ねてみた。{color 0}{wait}
					}
					TextWait
					TextClose 0
					_59
					TextTalk char[23] {
						ほう、写真を使って
						聞き込みか……
						今日は警察らしい事をしているな。{wait}
					}
					TextWait
					TextTalk name[0] {
						#0012Fはは、まあ……{wait}
					} {
						#0001Fそれで心当たりはありませんか？
						知人のお子さんなんですが……{wait}
					}
					TextWait
					TextTalk char[23] {
						俺はパレードも見てないもんでな。
						店に来たんでなきゃ判らねえぜ。{wait}
					}
					TextWait
					TextTalk char[23] {
						だがまあ、パレードに
						くっ付いて行っちまったんなら
						東通りじゃねえか？{wait}
					}
					TextWait
					TextTalk char[23] {
						パレードの道順は
						あっちのはずだぜ。{wait}
					}
					TextWait
					TextTalk name[0] {
						#0008Fそうですね……
						（ランディの連絡だと
						{}  東通りはシロだったらしいけど……）{wait}
					}
					TextWait
					TextTalk name[95] {
						#3300F……それで、お兄さんは
						どうするのかしら？{wait}
					}
					TextWait
					FlagSet flag[1379]
					global[2] = global[2] + 1
					FlagSet flag[0]
					Call fn[0,31]
					TextTalk name[95] {
						#3304Fふふ……慎重なのね。
						面白いお兄さん。{wait}
					}
					TextWait
				else:
					TextTalk char[23] {
						パレードの道順は
						ここから東通りだったはずだ。{wait}
					}
					TextWait
					TextTalk char[23] {
						パレードにくっ付いて
						行っちまったんなら、
						あっちの方じゃねえか？{wait}
					}
					TextWait
			elif flag[1362]:
				if !flag[0]:
					TextTalk char[23] {
						導力車か……パレードも
						様変わりしたもんだな。{wait}
					}
					TextWait
					TextTalk char[23] {
						ま、警察連中が大変なのは
						昔と変わらねえ。{wait}
					}
					TextWait
					TextTalk char[23] {
						今ごろ新米警官はバテバテだろうよ。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[23] {
						時代が変わっても
						警察連中が大変なのは
						変わらねえなあ。{wait}
					}
					TextWait
			elif flag[1292]:
				if !flag[0]:
					TextTalk char[23] {
						今日はパレードがあるな。{wait}
					}
					TextWait
					TextTalk char[23] {
						やれやれ……
						制服連中もご苦労さんなこった。{wait}
					}
					TextWait
					TextTalk char[23] {
						俺は同情しちまうぜ。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[23] {
						お前らも暇なら
						行政区の広場に行ってみな。{wait}
					}
					TextWait
					TextTalk char[23] {
						制服連中が大わらわだろうよ。{wait}
					}
					TextWait
			elif flag[1286]:
				if !flag[0]:
					TextTalk char[23] {
						セルゲイのやつと
						１杯飲もうかと思ったんだが……{wait}
					}
					TextWait
					TextTalk char[23] {
						あいつ、今日は会議みてえだな。{wait}
					}
					TextWait
					TextTalk char[23] {
						ふーむ、また面倒事を
						押し付けられてなきゃいいんだが……{wait}
					}
					TextWait
					Emote field_party[0] 0mm 2000mm 0 1 250ms 2
					SoundPlay sound[29] 0 100 0
					Emote field_party[1] 0mm 2000mm 0 1 250ms 2
					SoundPlay sound[29] 0 100 0
					Emote field_party[2] 0mm 2000mm 0 1 250ms 2
					SoundPlay sound[29] 0 100 0
					Emote field_party[3] 0mm 2000mm 0 1 250ms 2
					SoundPlay sound[29] 0 100 0
					Sleep 1000ms
					TextTalk name[0] {
						#0005Fどういうことですか……？{wait}
					}
					TextWait
					TextTalk char[23] {
						ああ、あいつは
						昔っからはみ出しモンだからな。
						何かと厄介事を背負い込むんだよ。{wait}
					}
					TextWait
					TextTalk char[23] {
						お前ら『特務支援課』の
						お茶にごしとかよ。{wait}
					}
					TextWait
					Emote field_party[0] 0mm 2000mm 16 19 250ms 1
					SoundPlay sound[23] 0 100 0
					Emote field_party[1] 0mm 2000mm 16 19 250ms 1
					SoundPlay sound[23] 0 100 0
					Emote field_party[2] 0mm 2000mm 16 19 250ms 1
					SoundPlay sound[23] 0 100 0
					Emote field_party[3] 0mm 2000mm 16 19 250ms 1
					SoundPlay sound[23] 0 100 0
					Sleep 1000ms
					TextTalk name[2] {
						#0203Fそうでしたね……{wait}
					}
					TextWait
					TextTalk char[23] {
						ま、支援課はあいつが
						自分でブッ建てた部署だ。
						自業自得だがな。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[23] {
						まあ今日の会議は
						明日のパレードの警備体制絡みだろ。{wait}
					}
					TextWait
					TextTalk char[23] {
						支援課も金星を挙げてることだし
						そう心配することもねえか。{wait}
					}
					TextWait
			elif flag[1282]:
				if !flag[0]:
					TextTalk char[23] {
						そういや、アリオスの奴が
						帰国したらしいな。{wait}
					}
					TextWait
					TextTalk char[23] {
						今年は人出がハンパじゃねえ。{wait}
					}
					TextWait
					TextTalk char[23] {
						やっこさんも戻らざるを
						得なかったみたいだな。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[23] {
						アリオスも帰国しているそうだな。{wait}
					}
					TextWait
					TextTalk char[23] {
						今年の人出じゃ仕方ねえだろ。{wait}
					}
					TextWait
			elif flag[1280]:
				if !flag[1402]:
					TextTalk char[23] {
						……らっしゃい。
						ウチは武器屋だぜ。{wait}
					}
					TextWait
					TextTalk char[23] {
						って、なんだお前らか。
						浮かれた観光客かと思ったぜ。{wait}
					}
					TextWait
					TextTalk char[23] {
						お前らも、めでたい日に
						しけた武器屋なんぞに入るんじゃねえよ。{wait}
					}
					TextWait
					TextTalk char[23] {
						ほれ、用が済んだら
						帰った帰った。{wait}
					}
					TextWait
