fn[24]:
	TextTalk char[0] {
		皆さん、違法駐車の
		取り締まりはどうでしたか？{wait}
	}
	TextWait
	TextTalk char[0] {
		報告なさるのなら広域防犯課の方々を
		お呼びしますけれど。{wait}
	}
	TextWait
	FadeOut 300ms 0x00000000 100
	Menu menu[0] -1 -1 0
		"【報告する】" // 0
		"【まだしない】" // 1
	MenuWait var[1]
	MenuClose menu[0]
	FadeIn 300ms 0x00000000
	if !var[1]:
		TextTalk name[0] {
			#0000Fはい、それでは
			お願いします。{wait}
		}
		TextWait
		TextTalk char[0] {
			分かりました。
			申し訳ないのですけど
			また少々お待ちくださいね。{wait}
		}
		TextWait
		TextTalk name[1] {
			#0100Fええ、あまり
			お気になさらないで下さい。{wait}
		}
		TextWait
	else:
		TextTalk char[0] {
			お仕事が終わったら
			私の方にお知らせくださいね。{wait}
		}
		TextWait
		TextTalk char[0] {
			広域防犯課の方々を
			お呼びしますから。{wait}
		}
		TextWait
	Return

