fn[3]:
	Call fn[0,4]
	Return

fn[4]:
	if QuestTaskGet quest[23] 19 && !QuestFlagsGet quest[23] 0x10 && !QuestFlagsGet quest[23] 0x40:
		TextStart char[0]
		Call fn[0,24]
		if !var[1]:
			FadeOut 1000ms 0x00000000 255
			FadeWait
			TextEnd char[0]
			Call fn[0,25]
			Return
	elif QuestFlagsGet quest[23] 0x02 && !QuestTaskGet quest[23] 0 && !QuestFlagsGet quest[23] 0x40:
		Call fn[0,23]
		Return
	TextStart char[0]
	if QuestFlagsGet quest[53] 0x10 && !flag[642]:
		if system[4] == 0:
			TextTalk char[0] {
				手配魔獣の討伐、
				お疲れ様でした。{wait}
			}
			TextWait
		TextTalk char[0] {
			そうそう、ご存知ですか？
			現在クロスベル警察では
			魔獣の情報調査を行っているんです。{wait}
		}
		TextWait
		TextTalk name[0] {
			#0005F情報調査……ですか？{wait}
		}
		TextWait
		TextTalk char[0] {
			ええ、戦闘手帳には
			魔獣についての項目があるのは
			ご存知だと思います。{wait}
		}
		TextWait
		TextTalk char[0] {
			戦ったことのある魔獣は
			戦闘手帳に記述されていくんですよ。{wait}
		}
		TextWait
		TextTalk char[0] {
			もし情報がある程度溜まったら、
			私の方に見せてください。{wait}
		}
		TextWait
		TextTalk char[0] {
			皆さんの集めた情報を元に
			署内で安全対策に
			役立たせてもらいますから。{wait}
		}
		TextWait
		if PartyPosition name[1] > -1:
			TextTalk name[1] {
				#0100Fなるほど……警察も
				色々な工夫をしているんですね。{wait}
			}
			TextWait
		elif PartyPosition name[2] > -1:
			TextTalk name[2] {
				#0200Fなるほど……警察も
				色々な工夫をしているようですね。{wait}
			}
			TextWait
		elif PartyPosition name[3] > -1:
			TextTalk name[3] {
				#0300Fなるほど……警察も
				色々な工夫をしてるんスね。{wait}
			}
			TextWait
		TextTalk char[0] {
			ええ、これも市民の安全を
			守るためですから。{wait}
		}
		TextWait
		TextTalk char[0] {
			魔獣の情報を見せていただく際には
			多少の手当ても支給しますよ。
			気軽に立ち寄ってくださいね。{wait}
		}
		TextWait
		FlagSet flag[642]
		FlagSet flag[11]
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"話をする" // 0
			"戦闘手帳を見せる" // 1
			"やめる" // 2
		MenuWait var[0]
		MenuClose menu[0]
		FadeIn 300ms 0x00000000
		FadeWait
		if var[0] == 1:
			var[0] = 99
			FlagUnset flag[12]
			Call fn[0,30]
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			Call fn[0,5]
	TextEnd char[0]
	Return

fn[5]:
	if QuestTaskGet quest[23] 0 && !QuestTaskGet quest[23] 19 && !QuestFlagsGet quest[23] 0x40:
		TextTalk char[0] {
			皆さんお疲れ様ですね。{wait}
		}
		TextWait
		TextTalk char[0] {
			違法駐車の取り締まりが終わったら
			私の方にお問い合わせ下さい。{wait}
		}
		TextWait
		TextTalk char[0] {
			また広域防犯課の方々を
			お呼びしますから。{wait}
		}
		TextWait
		TextTalk name[0] {
			#0000Fええ、その時は
			よろしくお願いします。{wait}
		}
		TextWait
	elif flag[11]:
		TextTalk char[0] {
			魔獣の情報がある程度溜まったら
			私の方に見せてくださいね。{wait}
		}
		TextWait
		TextTalk char[0] {
			皆さんの集めた情報を元に
			安全対策に役立たせてもらいます。{wait}
		}
		TextWait
		TextTalk char[0] {
			多少の手当ても支給しますから
			気軽に立ち寄ってくださいね。{wait}
		}
		TextWait
	elif flag[2]:
		TextTalk char[0] {
			ふふ、皆さんお疲れ様でした。{wait}
		}
		TextWait
		TextTalk char[0] {
			記念祭中は事件も
			増えているみたいですけど……
			無理せずに頑張ってくださいね。{wait}
		}
		TextWait
	elif flag[1307]:
		TextTalk char[0] {
			夕暮れを告げる大聖堂の鐘の後、
			閉会式が執り行われる予定です。{wait}
		}
		TextWait
		TextTalk char[0] {
			そろそろ私たちも
			準備を手伝わないといけませんね。{wait}
		}
		TextWait
	elif flag[1293]:
		if !flag[0]:
			TextTalk char[0] {
				毎年、記念祭では
				迷子が何人も出ているんです。{wait}
			}
			TextWait
			TextTalk char[0] {
				今年は多かったですね……
				２０件くらいは
				あったんじゃないでしょうか。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				どんなお子さんのご両親も
				心配で仕方ないのは皆同じ……{wait}
			}
			TextWait
			TextTalk char[0] {
				どうか力になってあげて下さい。{wait}
			}
			TextWait
	elif flag[1362]:
		if !flag[0]:
			TextTalk char[0] {
				ふう、ようやく
				人の波が引きましたね。{wait}
			}
			TextWait
			TextTalk char[0] {
				フランも疲れているようだし……
				今日は早めに上がらせようかしら。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				フランなら自販機の近くで
				休憩していると思います。{wait}
			}
			TextWait
			TextTalk char[0] {
				よかったら声を
				かけてあげてください。{wait}
			}
			TextWait
	elif flag[1292]:
		TextTalk char[0] {
			今日は市内で記念パレードの
			行進が予定されています。{wait}
		}
		TextWait
		TextTalk char[0] {
			問い合わせが何十件も来ていますし、
			市民の誘導もしなくてはいけません。{wait}
		}
		TextWait
		TextTalk char[0] {
			さてと……気合いを
			入れる必要がありそうですね。{wait}
		}
		TextWait
	elif flag[1282]:
		if !flag[0]:
			TextTalk char[0] {
				今日は、市庁舎の方で
				シンポジウムが開催されるんです。{wait}
			}
			TextWait
			TextTalk char[0] {
				一般の市民や観光客が
				集まるようなものではありませんが
				各国の知識人が多数出席されます。{wait}
			}
			TextWait
			TextTalk char[0] {
				クロスベルからは、市長を始め、
				ＩＢＣ総裁やグリムウッド先生なども
				参加されるそうですね。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				もちろん警備は警察の担当ですが
				あのアリオス・マクレイン氏も
				特別に警備に参加されるとか……{wait}
			}
			TextWait
			TextTalk char[0] {
				上層部としては複雑でしょうが
				各国の関係者の手前、
				反対できなかったみたいですね。{wait}
			}
			TextWait
	elif flag[1280]:
		if QuestFlagsGet quest[23] 0x10:
			Call fn[0,6]
		elif QuestTaskGet quest[23] 19:
			Call fn[0,24]
			if !var[1]:
				FadeOut 1000ms 0x00000000 255
				FadeWait
				var[0] = 0
				Call fn[0,25]
				TextEnd char[0]
				Return
		else:
			Call fn[0,6]
	Return

fn[6]:
	if !flag[0]:
		TextTalk char[0] {
			あら、支援課の皆さん。{wait}
		}
		TextWait
		TextTalk char[0] {
			やはり今年は
			例年になく混雑しているようです。{wait}
		}
		TextWait
		TextTalk char[0] {
			支援要請、頑張ってくださいね。{wait}
		}
		TextWait
		FlagSet flag[0]
	else:
		TextTalk char[0] {
			今年の記念祭は例年になく
			混雑しているようです。{wait}
		}
		TextWait
		TextTalk char[0] {
			皆さんも支援要請、
			頑張ってくださいね。{wait}
		}
		TextWait
	Return

fn[7]:
	Call fn[0,8]
	Return

fn[8]:
	TextStart char[1]
	if flag[1307]:
		if !flag[3]:
			TextTalk char[1] {
				#1903F記念祭も今日で最終日……
				何とか乗り切れそうです～。{wait}
			} {
				#1900F皆さんも
				本当にお疲れさまです。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000Fはは、フランもお疲れ。{wait}
			}
			TextWait
			TextTalk name[2] {
				#0203F（わたしたちの最大の山場は
				{}  これからですが……）{wait}
			}
			TextWait
			TextTalk name[1] {
				#0100F（まあ、巻き込みたくないし
				{}  彼女には黙っておきましょう。）{wait}
			}
			TextWait
			FlagSet flag[3]
		elif !flag[4]:
			TextTalk char[1] {
				#1905Fそういえば……セルゲイ警部も
				会議で本部にいらっしゃってますよ。{wait}
			} {
				#1900Fお会いになって行きます？{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000Fいや、今はいいよ。{wait}
			}
			TextWait
			TextTalk name[3] {
				#0300Fフランちゃん、
				お互いもう一頑張りしようぜ。{wait}
			}
			TextWait
			TextTalk char[1] {
