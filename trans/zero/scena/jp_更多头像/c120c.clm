fn[79]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 2450ms 0 251
			break
		case 1:
			ED7_A0 self 2550ms 0 251
			break
		case 2:
			ED7_A0 self 2600ms 0 251
			break
		case 3:
			ED7_A0 self 2400ms 0 251
			break
		case 4:
			ED7_A0 self 2650ms 0 251
			break
		case 5:
			ED7_A0 self 2350ms 0 251
			break
		case 6:
			ED7_A0 self 2500ms 0 251
			break
		default:
			ED7_A0 self 2500ms 0 251
			break
	while 1:
		var[2] = random % 3
		switch var[2]:
			case 0:
				CharTurnTo self 45deg 500deg/s
				break
			case 1:
				CharTurnTo self 270deg 500deg/s
				break
			case 2:
				CharTurnTo self 135deg 500deg/s
				break
		ED7_A0 self 2500ms 0 251
	Return

