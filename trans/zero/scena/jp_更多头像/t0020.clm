	}
	TextWait
	BgmStop 2000ms
	Sleep 1000ms
	SoundPlay sound[13] 0 100 0
	Minigame 24 0 0 0 0 0 0 0 0
	Sleep 4000ms
	BgmResume
	CharSetPos char[6] (-2060, 180, 4000) 0deg
	CharSetChipPattern char[6] 0
	CharSetPos field_party[0] (-260, 0, 2660) 0deg
