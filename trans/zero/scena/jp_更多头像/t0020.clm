			}
			TextWait
			FlagSet flag[4]
		else:
			TextTalk self {
				イリア・プラティエの舞台……㈱
				あぁ、前に一度見た時の感動を
				思い出しちゃった。{wait}
			}
			TextWait
			TextTalk self {
				うーん、また行きたいわねぇ。{wait}
			}
			TextWait
	elif flag[801]:
		if !flag[4]:
			TextTalk self {
				私達、この村に引っ越そうか
				本気で迷っているのよ。{wait}
			}
			TextWait
			TextTalk self {
