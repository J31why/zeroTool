fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharWalkToPos self (700, 0, 2050) 2000mm/s 0
		CharWalkToPos self (6210, 0, 2640) 2000mm/s 0
		CharTurnTo self 45deg 400deg/s
		Sleep 1800ms
		CharTurnTo self 225deg 400deg/s
		Sleep 100ms
		CharWalkToPos self (2810, 0, 1030) 2000mm/s 0
		CharWalkToPos self (3120, 0, -560) 2000mm/s 0
		CharTurnTo self 135deg 400deg/s
		Sleep 1800ms
		CharTurnTo self 270deg 400deg/s
		Sleep 100ms
		CharWalkToPos self (-2050, 0, -820) 2000mm/s 0
		CharTurnTo self 315deg 400deg/s
		Sleep 1800ms
		CharTurnTo self 45deg 400deg/s
		Sleep 100ms
	Return

fn[2]:
	while 1:
		CharIdle self (141770, null, -2220) (143890, null, -100) 1000mm/s
		Sleep 250ms
	Return

fn[3]:
	if QuestTaskGet quest[31] 3 && !QuestFlagsGet quest[31] 0x10:
		Event fn[0,40]
	if flag[1566]:
		CharFlagsUnset char[8] 0x0080
		CharFlagsUnset char[3] 0x0080
		ForkFunc char[3] fork[0] fn[0,1]
	elif flag[1554]:
		CharFlagsUnset char[7] 0x0080
		CharFlagsUnset char[10] 0x0080
		CharFlagsUnset char[3] 0x0080
		ForkFunc char[3] fork[0] fn[0,1]
	elif flag[1536]:
		CharFlagsUnset char[19] 0x0080
		CharSetPos char[19] (-41720, 0, 3490) 90deg
		CharTurnTo char[0] 270deg 0deg/s
		CharFlagsUnset char[3] 0x0080
		ForkFunc char[3] fork[0] fn[0,1]
		CharFlagsUnset char[8] 0x0080
		CharFlagsUnset char[20] 0x0080
		CharFlagsUnset char[21] 0x0080
	elif flag[1307]:
		CharFlagsUnset char[8] 0x0080
		CharFlagsUnset char[15] 0x0080
		CharFlagsUnset char[17] 0x0080
	elif flag[1292]:
		CharFlagsUnset char[15] 0x0080
		CharFlagsUnset char[17] 0x0080
		CharFlagsUnset char[18] 0x0080
		CharTurnTo char[0] 270deg 0deg/s
		if QuestFlagsGet quest[31] 0x10:
			CharSetPos char[15] (84000, 180, -2040) 283deg
			CharSetPos char[17] (82190, 180, -1670) 103deg
		elif QuestTaskGet quest[31] 0:
			CharFlagsSet char[5] 0x0080
			CharFlagsSet char[6] 0x0080
			CharFlagsSet char[15] 0x0080
			CharFlagsSet char[17] 0x0080
			CharFlagsUnset char[4] 0x0080
			CharSetPos char[2] (750, 0, 1500) 270deg
		elif QuestFlagsGet quest[31] 0x02:
			CharFlagsSet char[5] 0x0080
			CharFlagsSet char[6] 0x0080
			CharFlagsSet char[15] 0x0080
			CharFlagsSet char[17] 0x0080
			CharSetPos char[2] (0, 0, 3700) 360deg
			CharFlagsSet char[2] 0x0010
	elif flag[1282]:
		CharFlagsUnset char[14] 0x0080
		CharFlagsUnset char[16] 0x0080
	elif flag[1280]:
		CharFlagsUnset char[22] 0x0080
		CharFlagsUnset char[23] 0x0080
	elif flag[1040]:
		CharFlagsUnset char[8] 0x0080
		CharFlagsUnset char[9] 0x0080
		ForkFunc char[9] fork[0] fn[0,2]
		CharFlagsUnset char[12] 0x0080
		CharTurnTo char[0] 270deg 0deg/s
		CharFlagsUnset char[3] 0x0080
		ForkFunc char[3] fork[0] fn[0,1]
	elif flag[1024]:
		CharFlagsUnset char[3] 0x0080
		CharSetPos char[3] (2350, 0, -720) 135deg
		CharFlagsUnset char[11] 0x0080
		CharFlagsUnset char[8] 0x0080
		CharFlagsUnset char[9] 0x0080
		ForkFunc char[9] fork[0] fn[0,2]
	elif flag[801]:
		CharFlagsUnset char[8] 0x0080
		CharFlagsUnset char[9] 0x0080
		ForkFunc char[9] fork[0] fn[0,2]
		CharFlagsUnset char[3] 0x0080
		ForkFunc char[3] fork[0] fn[0,1]
	elif flag[776]:
		CharFlagsUnset char[8] 0x0080
		CharFlagsUnset char[9] 0x0080
		ForkFunc char[9] fork[0] fn[0,2]
		CharFlagsUnset char[3] 0x0080
		ForkFunc char[3] fork[0] fn[0,1]
		CharFlagsUnset char[19] 0x0080
		CharFlagsSet char[19] 0x0010
	elif flag[774]:
		CharFlagsUnset char[8] 0x0080
		CharFlagsUnset char[9] 0x0080
		ForkFunc char[9] fork[0] fn[0,2]
		CharFlagsUnset char[3] 0x0080
		ForkFunc char[3] fork[0] fn[0,1]
		CharFlagsUnset char[19] 0x0080
	elif flag[768]:
		CharFlagsUnset char[8] 0x0080
		CharFlagsUnset char[9] 0x0080
		ForkFunc char[9] fork[0] fn[0,2]
		CharFlagsUnset char[3] 0x0080
		ForkFunc char[3] fork[0] fn[0,1]
		CharFlagsSet char[6] 0x0080
		CharFlagsUnset char[13] 0x0080
	if flag[1280] && !flag[1536]:
		CharFlagsUnset char[26] 0x0080
		CharFlagsUnset char[27] 0x0080
	Return

fn[4]:
	if flag[777]:
		ED7_76_0 object[255] "tuika00" 1
	if flag[1292]:
		if QuestFlagsGet quest[31] 0x10:
		elif QuestTaskGet quest[31] 0:
			LookPointFlagsSet look_point[0] 0x0001
		elif QuestFlagsGet quest[31] 0x02:
			LookPointFlagsSet look_point[0] 0x0001
	Return

fn[5]:
	TextStart self
	if flag[1566]:
		if !flag[0]:
			TextTalk self {
				この雑貨店は、
				わしの曽祖父の代から続く
				由緒正しい店なんじゃ。{wait}
			}
			TextWait
			TextTalk self {
				だが、ジェイクのやつは
				そこの所をよく分かっておらん。{wait}
			}
			TextWait
			TextTalk self {
				もっと誇りをもって
				仕事に臨んでほしいもんじゃて。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				ジェイクには、
				もっと誇りをもって
				この仕事に臨んでほしいもんじゃ。{wait}
			}
			TextWait
			TextTalk self {
				この店が《ジェイク雑貨店》になるのは
				いつの話やら……{wait}
			}
			TextWait
	elif flag[1554]:
		if !flag[0]:
			TextTalk self {
				仕事ぶりがだらしないから
				ジェイクを叱り付けてやったんじゃ。{wait}
			}
			TextWait
			TextTalk self {
				たまに『街にでて大物になる』などと
				寝言をほざいておるようじゃが……{wait}
			}
			TextWait
			TextTalk self {
				そんな暇があったら
				店の仕事を一つでも多く
				覚えろというんじゃ。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				ジェイクのやつ、たまに
				『街にでて大物になる』などと
				寝言をほざいておるようじゃが……{wait}
			}
			TextWait
			TextTalk self {
				そんな暇があったら
				店の仕事を一つでも多く
				覚えろというんじゃ。{wait}
			}
			TextWait
	elif flag[1536]:
		if !flag[0]:
			_Char4A char[19] 255
			CharTurnToChar self char[19] 0deg/s
			TextTalk self {
				毎度ハロルド君には
				世話になっておるなぁ。{wait}
			}
			TextWait
			TextTalk self {
				どれ、今日はハチミツを一瓶
				おまけしてやるかの。
				家族で楽しむがよかろう。{wait}
			}
			TextWait
			TextTalk char[19] {
				#3609Fふふ……ありがとうございます。
				妻と息子も喜びますよ。{wait}
			}
			TextWait
			_Char4B char[19] 255
			FlagSet flag[0]
		else:
			TextTalk self {
				ハロルド君に比べて
				うちのジェイクときたら……
				いつまでたっても半人前のままじゃ。{wait}
			}
			TextWait
			TextTalk self {
				記念祭を乗り切ったんじゃから
				少しでもハロルド君に
				近づいてほしいのう。{wait}
			}
			TextWait
	elif flag[1307]:
		if !flag[0]:
			TextTalk self {
				観光客がクロスベル市に帰ったら
				とたんに寂しくなったのう。{wait}
			}
			TextWait
			TextTalk self {
				……ジェイクもヒマしておるようじゃな。
				どれ、いっちょう喝をいれてやるか。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				カウンターに立つものが
				あんな腑抜けていてはイカン。{wait}
			}
			TextWait
			TextTalk self {
				どれ、いっちょう喝をいれてやるか。{wait}
			}
			TextWait
	elif flag[1292]:
		if !flag[0]:
			Call fn[0,7]
		else:
			TextTalk self {
				ほほ、近年まれに見る繁盛じゃわい。{wait}
			}
			TextWait
			TextTalk self {
				去年の記念祭では
				こうはいかんかったからのう。
				ありがたいことじゃ。{wait}
			}
			TextWait
	elif flag[1282]:
		TextTalk self {
			ほほほ、観光客が土産として
			沢山ハチミツを
			買っていってくれてのう。{wait}
		}
		TextWait
		TextTalk self {
			うちとしても大助かりじゃ。
			デリックの案に乗って
			正解じゃったのう。{wait}
		}
		TextWait
	elif flag[1280]:
		if !flag[0]:
			TextTalk self {
				記念祭の出店、
				初日の売り上げは
				なかなか好調だったんじゃ。{wait}
			}
			TextWait
			TextTalk self {
				《アルカンシェル》が
				客を集めてくれたお陰じゃの。
				ほっほっほ。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				《アルカンシェル》が
				客を集めてくれたお陰で、
				出店の出だしは好調じゃ。{wait}
			}
			TextWait
			TextTalk self {
				このまま最終日まで
				行ってくれるといいが……{wait}
			}
			TextWait
	elif flag[1040]:
		if !flag[0]:
			Call fn[0,7]
		else:
			TextTalk self {
				デリックめ、
				なかなか話の出来る奴じゃ。{wait}
			}
			TextWait
			TextTalk self {
				次期村長の自覚が
				しっかりできとるようじゃな。{wait}
			}
			TextWait
			TextTalk self {
				……ジェイクにも、店を継ぐ自覚を
				しっかり持って欲しいもんじゃがのう。{wait}
			}
			TextWait
	elif flag[1024]:
		if !flag[0]:
			TextTalk self {
				デリックの奴が進めておる
				創立記念祭の出店は良い考えじゃのう。{wait}
			}
			TextWait
			TextTalk self {
				この村もだんだん昔のような活気が
				なくなっておるし、
				それもまたいいのかもしれん。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				村に活気を取り戻す為にも、
				創立記念祭への出店は大いに結構じゃ。{wait}
			}
			TextWait
	elif flag[801]:
		if !flag[0]:
			TextTalk self {
				ふむ、今日は奥の農場から
				ハチミツを仕入れてくるとするかのう。{wait}
			}
			TextWait
			TextTalk self {
				本当ならジェイクにも
				仕入れのイロハを
				教えたいもんじゃが……{wait}
			}
			TextWait
			TextTalk self {
				今は店番で一杯一杯じゃからな。
				またの機会にするとしよう。{wait}
			}
			TextWait
