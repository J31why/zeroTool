fn[12]:
	TextStart char[4]
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"話をする" // 0
			"休憩をする" // 1
			"やめる" // 2
		MenuWait var[0]
		if var[0] != 1:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			ShopOpen shop[111]
			var[0] = 99
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			if flag[1566]:
				TextTalk char[4] {
					このような早くから
					宿に来るとは変わった奴だな。{wait}
				}
				TextWait
				TextTalk char[4] {
					……まぁいい。
					休んでいくなら好きにするがいいさ。{wait}
				}
				TextWait
			elif flag[1554]:
				if !flag[3]:
					TextTalk char[4] {
						ソーニャ副司令は
						隊員に過度の負担をかけないよう
						上手く仕事を配分しているようだ。{wait}
					}
					TextWait
					TextTalk char[4] {
						いざというときに疲れていては
						緊急度の高い事件に対応できないからな。{wait}
					}
					TextWait
					TextTalk char[4] {
						お前たちも体調だけは
						いつでも万全に整えておくんだな。{wait}
					}
					TextWait
					FlagSet flag[3]
				else:
					TextTalk char[4] {
						いつ何が起こっても対応できるよう、
						休息はとれるときにとっておけ。{wait}
					}
					TextWait
					TextTalk char[4] {
						何ならこの施設で休んでも構わんぞ。{wait}
					}
					TextWait
			elif flag[1536]:
				TextTalk char[4] {
					何でも、化け物が出たとかで
					タングラム門の警備隊員は
					任務に尻込みしてしまっているらしい。{wait}
				}
				TextWait
				TextTalk char[4] {
					肝っ玉の小さい奴らだ。
					化け物と言っても、魔獣なら
					散々戦ってきたろうに。{wait}
				}
				TextWait
			elif flag[1307]:
				TextTalk char[4] {
					……皆、忙しそうだな。{wait}
				}
				TextWait
				TextTalk char[4] {
					俺は暇だし、あとで
					ティマスの方を手伝ってやるか……{wait}
				}
				TextWait
			elif flag[1292]:
				TextTalk char[4] {
					俺はイリア・プラティエの
					大ファンなんだ……{wait}
				}
				TextWait
				TextTalk char[4] {
					こんな所に勤務したばっかりに
					アルカンシェルの公演を
					見に行けないなんてな……{wait}
				}
				TextWait
			elif flag[1282]:
				if QuestFlagsGet quest[27] 0x10:
					TextTalk char[4] {
