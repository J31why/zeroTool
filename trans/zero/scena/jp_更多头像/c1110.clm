				市長が不在のこんな時に……！{wait}
			}
			TextWait
			Emote char[6] 0mm 2000mm 40 43 100ms 3
			TextTalk char[6] {
				と、とにかく閉会式の
				準備を進めませんと……{wait}
			}
			TextWait
			TextTalk char[6] {
				私、会場の椅子を
				確保してきますね！{wait}
			}
			TextWait
			_Char4B char[5] 255
			_Char4B char[6] 255
	elif flag[1282]:
		if !flag[4]:
			TextTalk self {
				国際シンポジウム傍聴の方は
				今しばらくお待ちくださ～い。{wait}
			}
			TextWait
			TextTalk self {
				開場時間になり次第、
				ご案内いたしま～す。{wait}
			}
			TextWait
			FlagSet flag[4]
		else:
			TextTalk self {
				ふう、国際シンポジウムも
				なんとか無事に開催できそうだよ。{wait}
			}
			TextWait
			TextTalk self {
				ちなみに会場には
				アリオス・マクレインも来てるんだぜ。
				会場警備はばっちりだな。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[13]:
