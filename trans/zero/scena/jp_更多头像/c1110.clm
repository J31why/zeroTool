fn[11]:
	TextStart self
	TextTalk self {
		#14502Fやあロイド達か。{wait}
	} {
		#14500F今日のシンポジウムには
		マクダエル市長や
		外国のＶＩＰも出席なさるんだ。{wait}
	} {
		#14504F結構壮観な顔ぶれらしいよ。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[12]:
	TextStart self
	if flag[1307]:
		if QuestFlagsGet quest[34] 0x10:
			TextTalk self {
				『聖者の祈り』が戻ってきたんだな。
				よかったぜ……{wait}
			}
			TextWait
			TextTalk self {
				とと、喜んでる場合じゃない。
				ただでさえ閉会式の
				準備が遅れてるんだ。{wait}
			}
			TextWait
			TextTalk self {
				閉会式まであと３時間……
				急がないとな。{wait}
			}
			TextWait
		else:
			_Char4A char[5] 255
			_Char4A char[6] 255
			TextTalk char[5] {
