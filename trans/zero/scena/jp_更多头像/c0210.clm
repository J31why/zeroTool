fn[6]:
	if flag[13]:
		TextTalk char[0] {
			#14702F今日は助かったぜ。
			ついでにオレの焼いたパンでも
			食べていってくれ。{wait}
		} {
			#14709Fへへっ、サービスしとくぜ？{wait}
		}
		TextWait
		TextTalk name[0] {
			#0000Fサンキュー、選ばせて貰うよ。{wait}
		}
		TextWait
	elif flag[1792]:
		if !flag[1898]:
			TextTalk char[0] {
				#14700Fようロイド。
				また何かの捜査してんのか？{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000Fああ、そんな所だよ。{wait}
			} {
				#0001F……オスカー、念のため
				聞いておくけど、この辺りで
				何か変わった事は無かったか？{wait}
			} {
				黒服の連中を見かけた、とか……{wait}
			}
			TextWait
			TextTalk char[0] {
				#14703F変わった事か……んー。{wait}
			} {
				#14705F実はさっき、
				ベネットが急に怒り出して
				出て行っちまったんだよな。{wait}
			} {
				#14701F一体どうしちまったんだ？{wait}
			}
			TextWait
			if !flag[1897]:
				Emote field_party[0] 0mm 2000mm 16 19 250ms 1
				SoundPlay sound[23] 0 100 0
				Emote field_party[1] 0mm 2000mm 16 19 250ms 1
				SoundPlay sound[23] 0 100 0
				Emote field_party[2] 0mm 2000mm 16 19 250ms 1
				SoundPlay sound[23] 0 100 0
				Emote field_party[3] 0mm 2000mm 16 19 250ms 1
				SoundPlay sound[23] 0 100 0
				Sleep 1000ms
				TextTalk name[0] {
					#0006Fお前、ホント、
					そういう所は鈍いよな。{wait}
				}
				TextWait
				TextTalk name[1] {
					#0100F西通りのあたりは
					特に事件も無さそうね。{wait}
				}
				TextWait
			else:
				Emote name[0] 0mm 2000mm 16 19 250ms 1
				SoundPlay sound[23] 0 100 0
				Sleep 1000ms
				TextTalk name[0] {
					#0000Fさ、さあ、知らないけど……{wait}
				} {
					オスカーのせいじゃないのか？
					お前、たまに鈍いしさ……{wait}
				}
				TextWait
				TextTalk char[0] {
					#14705Fえ、そうか？{wait}
				}
				TextWait
				TextTalk name[1] {
					#0100F（まあ、西通りのあたりは
					{}  特に事件も無さそうね。）{wait}
				}
				TextWait
			FlagSet flag[1898]
		else:
			TextTalk char[0] {
				#14703F今日はベネットが
				すごく美味いパンを焼いて
				食べさせてくれたんだよな。{wait}
			} {
				#14706Fで、素直に感想を言ったら
				急に怒って出て行っちまったんだ。{wait}
			} {
				#14701Fんー、一体どうしたのかねぇ？{wait}
			}
			TextWait
	elif flag[1566]:
		if !flag[0]:
			TextTalk char[0] {
				#14705F昨日は港湾区の方で
				撃ち合いがあったんだって？{wait}
			} {
				#14701Fマフィアも本気になれば
				市民を巻き込んだ抗争くらい
				平気でやるってことか……{wait}
			} {
				#14706Fったく、厄介な連中だぜ。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				#14703Fせっかく店の売り上げも
				順調に伸びてる所だしな。{wait}
			} {
				#14701F面倒事は勘弁して欲しいぜ。{wait}
			}
			TextWait
	elif flag[1554]:
		if !flag[0]:
			CharTurnTo char[0] 90deg 0deg/s
			TextTalk char[0] {
				#14703Fっと、毛布はどこだ……？{wait}
			}
			TextWait
			CharTurnToChar char[0] field_party[0] 500deg/s
			TextTalk char[0] {
				#14700Fベネット、新作の開発で
				ほとんど寝てないみてぇなんだ。{wait}
			} {
				#14709Fはは、手間がかかるよな。
				セシルさんに面倒を見られてた
				小さい頃のロイドみたいだぜ。{wait}
			}
			TextWait
			Emote name[0] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Sleep 1000ms
			TextTalk name[0] {
				#0003Fむ、昔のことを
				いきなり持ち出すなよ。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				#14704Fやれやれ、バッタリいく前に
				部屋に連れて行かねぇとな。{wait}
			}
			TextWait
	elif flag[1536]:
		if !flag[1643]:
			TextTalk char[0] {
