					elif flag[1024]:
						ShopOpen shop[202]
					elif flag[768]:
						ShopOpen shop[201]
					else:
						ShopOpen shop[200]
					var[0] = 99
				elif var[0] == 2:
					TextTalk char[0] {
						#14700F集めてきて欲しいのは
						『魔獣の魚肉』を４つ、
						『魔獣の卵』を３つって所だな。{wait}
					} {
						#14702F食材が不足気味でな、
