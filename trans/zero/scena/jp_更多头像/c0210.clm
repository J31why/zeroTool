fn[5]:
	if QuestFlagsGet quest[6] 0x02 && !QuestTaskGet quest[6] 0 && !QuestFlagsGet quest[6] 0x40:
		_Char4A char[0] 255
		CharTurnToChar field_party[0] char[0] 0deg/s
		Call fn[0,29]
		Return
	TextStart char[0]
	if QuestTaskGet quest[6] 0 && !QuestFlagsGet quest[6] 0x10 && ItemHas item[301] 0 >= 4 && ItemHas item[303] 0 >= 3 && !QuestFlagsGet quest[6] 0x40:
		TextTalk char[0] {
			#14700Fロイド、食材集めの方は
			どうなった？{wait}
		}
		TextWait
		var[0] = 0
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 0
			"【集めた食材を渡す】" // 0
			"【やめておく】" // 1
		MenuWait var[0]
		FadeIn 300ms 0x00000000
		MenuClose menu[0]
		_59
		switch var[0]:
