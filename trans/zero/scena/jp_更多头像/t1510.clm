					}
					TextWait
			elif flag[1282]:
				TextTalk char[0] {
					寮で働いているマローネは
					私の姪っ子でね。{wait}
				}
				TextWait
				TextTalk char[0] {
					家事手伝いで暇そうにしてたのを
					拾ってやったのさ。{wait}
				}
				TextWait
				TextTalk char[0] {
					あのコ、綺麗好きなだけが
					取り柄だから、掃除するのは
					かなり向いてるのよ。{wait}
				}
				TextWait
			elif flag[1280]:
				if !flag[0]:
					TextTalk char[0] {
						せっかくの記念祭なのに
						入院してベッドの上なんて
						気の毒だろう？{wait}
					}
					TextWait
					TextTalk char[0] {
						だから記念祭中くらいは
						病院食を豪華にしてあげようと
						思ってるんだ。{wait}
					}
					TextWait
					TextTalk char[0] {
						かといって、
						あまり偏った食事は出せないからね。
						アイデアで勝負しないと……{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[0] {
						記念祭中くらいは
						病院食を豪華にしてあげようと
						思ってるんだ。{wait}
					}
					TextWait
					TextTalk char[0] {
						昨日からメニューに入れた
						豆腐で作ったハンバーグ……
						ヘルシーでいいだろう？{wait}
					}
					TextWait
			elif flag[1040]:
				if !flag[0]:
					TextTalk char[0] {
						ここの研修医さんは
						食事の時間も勉強してるほど
						みんな熱心なのよ。{wait}
					}
					TextWait
					TextTalk char[0] {
						うんうん、若いうちは勉強しなきゃね。
						それが楽しい将来に繋がるってもんさ。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[0] {
						どれ、勉強熱心な研修医さんの為に
						アタマの良くなる特別メニューでも
						考えてみるかね。{wait}
					}
					TextWait
					TextTalk char[0] {
						魚の目玉なんてどうかねぇ？{wait}
					}
					TextWait
			elif flag[1024]:
				TextTalk char[0] {
					食堂に来るお客さんが
					アルカンシェルの話をしてたのよ。{wait}
				}
				TextWait
				TextTalk char[0] {
					新しい演目……
					『金の太陽、銀の月』だっけ？
					ぜひ見てみたいわ～。{wait}
				}
				TextWait
			elif flag[799]:
				if !RecipeLearn 5:
					Call fn[0,5]
				elif !flag[0]:
					TextTalk char[0] {
						入院患者の食事も
