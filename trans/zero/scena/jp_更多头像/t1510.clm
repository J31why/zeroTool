					}
					TextWait
					TextTalk char[0] {
						何か食いたきゃ言っとくれ。
						ウデによりをかけて
						作らせてもらうからさ。{wait}
					}
					TextWait
	TextEnd char[0]
	Return

fn[5]:
	TextTalk char[0] {
		この病院では食事の栄養バランスも
		しっかりと考えられていてね。{wait}
	}
	TextWait
	TextTalk char[0] {
		とくにあたしが得意なのは
		手作りのビーフシチューさ。{wait}
	}
	TextWait
	TextTalk char[0] {
		作り方を教えるから、
		よかったらあんたたちも
		試してごらん。{wait}
	}
	TextWait
	FadeOut 300ms 0x00000000 100
	TextSetPos -1 -1 -1 -1
	TextSetName ""
	SoundPlay sound[17] 0 100 0
	TextMessage null {
		{item[413]}{color 0}のレシピを教えてもらった。{wait}
	}
	TextWait
	TextMessage null {
		{item[413]}{color 0}のレシピを覚えた。{wait}
	}
	TextWait
	TextClose 0
	FadeIn 300ms 0x00000000
	TextSetPos -1 280 60 3
	_59
	RecipeLearn 5
	Return

fn[6]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if QuestTaskGet quest[40] 10 && !QuestFlagsGet quest[40] 0x10:
		if !flag[1]:
			TextTalk self {
				あっ……その本！{wait}
			}
			TextWait
			TextTalk self {
				本が無事見つかったみたいで
				なによりだわ。
				面倒かけてごめんなさいね。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				しかしまぁ、あの膨大な
				本棚から見つけ出すなんて
				なかなか大変だったでしょ？{wait}
			}
			TextWait
			TextTalk self {
				よく見つけられたわよねー。
				人海戦術ってヤツかしら。{wait}
			}
			TextWait
		CharSetChipPattern self 0
