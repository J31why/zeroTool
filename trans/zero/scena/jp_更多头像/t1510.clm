						寝言を言い出してね。{wait}
					}
					TextWait
					TextTalk char[0] {
						つい、んなもん食いたきゃ
						レストランにでも行けって
						突っぱねちまったよ。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[0] {
						昨日、個室に入院してるゲバルさんが
						『ステーキを出せ』なんて
						寝言を言い出してね。{wait}
					}
					TextWait
					TextTalk char[0] {
						こっちも栄養バランスに気をつけて
						作ってるんだから
						ああいう手合いには困っちまうよ。{wait}
					}
					TextWait
			elif flag[793]:
				if !RecipeLearn 5:
					Call fn[0,5]
				elif !flag[0]:
					TextTalk char[0] {
						昼休みも終わって、
						寮の中もようやく静かになったね。{wait}
					}
					TextWait
					TextTalk char[0] {
						あとであたしも
						マローネを手伝って
						掃除するとしよう。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[0] {
						あ……注文があるなら
						遠慮なく言いなよ？{wait}
					}
					TextWait
			elif flag[784]:
				if !RecipeLearn 5:
					Call fn[0,5]
				elif !flag[0]:
					TextTalk char[0] {
						おやセシルさん、
						まだ休憩時間は残ってるだろう？
						もう戻るのかい？{wait}
					}
					TextWait
					TextTalk char[0] {
						ただでさえ看護師は忙しいんだ。
						休める時に休んどかないとだめだよ。{wait}
					}
					TextWait
					TextTalk name[53] {
						#1302Fふふ、大丈夫ですよ。
						ロイドに会えたおかげで
						疲れなんて吹っ飛んじゃいました。{wait}
					} {
						#1300F寮長、場所を借りさせてもらって
						ありがとうございますね。{wait}
					}
					TextWait
					TextTalk char[0] {
						はは、いいってことよ。
						あんたはうちの寮生だしね。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[0] {
						あんたたち、セシルさんを
						あんまり連れまわしちゃダメよ。
						これで結構忙しい子なんだからね。{wait}
					}
					TextWait
			elif flag[777]:
				if !RecipeLearn 5:
					Call fn[0,5]
				elif !flag[0]:
					TextTalk char[0] {
						ほいほい、いらっしゃい。
						ここは病院職員たちの寮だよ。{wait}
					}
					TextWait
					TextTalk char[0] {
						夜勤疲れで寝てる先生もいるから
