fn[4]:
	TextStart char[0]
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"話をする" // 0
			"買い物をする" // 1
			"休憩をする" // 2
			"やめる" // 3
		MenuWait var[0]
		if var[0] < 1 | var[0] > 2:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			if flag[1280]:
				ShopOpen shop[93]
			else:
				ShopOpen shop[92]
			var[0] = 99
		elif var[0] == 2:
			ShopOpen shop[90]
			var[0] = 99
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			if flag[1566]:
				TextTalk char[0] {
					あいよ、いらっしゃい！{wait}
				}
				TextWait
				TextTalk char[0] {
					病院もついさっき、今日の業務が
					始まったばかりだよ。{wait}
				}
				TextWait
			elif flag[1565]:
				if !flag[0]:
					TextTalk char[0] {
						そろそろ看護師の子が
						病院食をとりにくる頃だね。{wait}
					}
					TextWait
					TextTalk char[0] {
						最近の食事はなかなか
						入院患者さんたちに好評なんだ。{wait}
					}
					TextWait
					TextTalk char[0] {
						以前ゲバル議員さんに
						『もっと豪華にしろ』だのワガママを
						言われたときは腹が立ったもんだが……{wait}
					}
					TextWait
					TextTalk char[0] {
						アレのおかげでメニューを
						工夫するようになったんだから
						結果オーライさね。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[0] {
						最近の食事はなかなか
						入院患者さんたちに好評なんだ。{wait}
					}
					TextWait
					TextTalk char[0] {
						ゲバルさんがワガママ言ってくれた
						おかげとも言えるね。{wait}
					}
					TextWait
			elif flag[1554]:
				TextTalk char[0] {
					今朝運び込まれた患者は
					なんでも撃たれた傷があったそうね。{wait}
				}
				TextWait
				TextTalk char[0] {
					やぁねぇ……
					病院まで危ないことに
					巻き込まれなけりゃいいけど。{wait}
				}
				TextWait
			elif flag[1536]:
				TextTalk char[0] {
					あの遊撃士さんは病院関係の仕事を
					よく手伝ってくれてね。{wait}
				}
				TextWait
				TextTalk char[0] {
					いつもお世話になってるし、
					今日は私がご馳走しようかねぇ。{wait}
				}
				TextWait
			elif flag[1351]:
				TextTalk char[0] {
					ん、さっき一緒にいた女の子は
					どうしたんだい？{wait}
				}
				TextWait
				TextTalk char[0] {
					……なに、はぐれたのかい！？
					はぁ、なにやってんだい。{wait}
				}
				TextWait
			elif flag[1346]:
				if !flag[0]:
					TextTalk char[0] {
						ふーん、話が聞こえてきたけど……
						あんたがセシルさんの弟さんの
						娘なんだって？{wait}
					}
					TextWait
					TextTalk name[82] {
						#1105Fえ、キーアはやっぱりそーなんだ？{wait}
					}
					TextWait
					TextTalk name[0] {
						#0011Fち、違っ……！
						だからそれは誤解ですってば！{wait}
					}
					TextWait
					TextTalk char[0] {
						あはは、からかってみただけだよ。
						本気にしない、しない。{wait}
					}
					TextWait
					TextTalk name[82] {
						#1111Fふーん？{wait}
					}
					TextWait
					TextTalk name[0] {
						#0005Fはぁ……{wait}
					}
					TextWait
					if flag[1356]:
						TextTalk name[1] {
							#0102F（ふふ、からかいやすい体質だとは
							思っていたけど……）{wait}
						}
						TextWait
					elif flag[1357]:
						TextTalk name[2] {
							#0202F（ロイドさんは、
							いわゆるいじられキャラという
							ヤツですね。）{wait}
						}
						TextWait
					elif flag[1358]:
						TextTalk name[3] {
							#0309F（はっはっは、愛#2Rう#い奴だぜ。
							ロイドはこうでなくちゃな。）{wait}
						}
						TextWait
					FlagSet flag[0]
				else:
					TextTalk char[0] {
						あはは、からかって悪かったよ。{wait}
					}
					TextWait
					TextTalk char[0] {
						まぁ、お詫びといっちゃなんだが
						好きにくつろいでいっとくれ。{wait}
					}
					TextWait
			elif flag[1307]:
				TextTalk char[0] {
					おやいらっしゃい。{wait}
				}
				TextWait
				TextTalk char[0] {
					記念祭もやってるだろうに
