fn[6]:
	TextStart self
	if flag[1307]:
		TextTalk self {
			#14501F駅の方は大変混雑しています。{wait}
		} {
			#14501F落し物、迷子などには
			お気をつけくださ～い！{wait}
		}
		TextWait
	elif flag[1362]:
		TextTalk self {
			#14506Fパレードの誘導のために
			街中を走り回ってきた所なんだ……{wait}
		} {
			#14506Fぜえ、ぜえ……
			つ、疲れたぜ……{wait}
		}
		TextWait
	elif flag[1292]:
		TextTalk self {
			#14501Fパレードの警備は
			オレたち広域防犯課が
			一手に担ってるんだ。{wait}
		} {
			#14506F……この人ごみだし
			道を確保するのも大変だよ。{wait}
		}
		TextWait
	elif flag[1282]:
	elif flag[1280]:
		TextTalk self {
			#14501Fぴっぴー！　押さないで下さい！{wait}
		} {
			#14501F車の前に飛び出さないように！{wait}
		}
		TextWait
	TextEnd self
	Return

