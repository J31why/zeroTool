fn[6]:
	Call fn[0,7]
	Return

fn[7]:
	if QuestTaskGet quest[2] 0 && !QuestTaskGet quest[2] 1 && !QuestFlagsGet quest[2] 0x40:
		CharTurnToChar field_party[0] char[1] 0deg/s
		_Char4A char[1] 255
		_Char4A char[0] 255
		Call fn[0,36]
		Return
	TextStart char[1]
	if flag[15]:
		TextTalk char[1] {
			当百貨店では
			遺失物の届けが多いんですよ。{wait}
		}
		TextWait
		TextTalk char[1] {
			発見後１週間以上経つと
			警察に届ける決まりなのですが……
			常時十数点はお預かりしているんです。{wait}
		}
		TextWait
		TextTalk char[1] {
			皆様も落し物には
			ご注意くださいませ。{wait}
		}
		TextWait
	elif flag[1792]:
		TextTalk char[1] {
			夕暮れのあたるクロスベル市……
			とても美しいと思います。{wait}
		}
		TextWait
		TextTalk char[1] {
			美しい自然も良いですけど、
			近代文化の中をジョギングするのも
			なかなか悪くはないですよ。{wait}
		}
		TextWait
	elif flag[1566]:
