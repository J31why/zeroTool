sepith[0] 0 0 0 0 0 0 0 0

fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharWalkToPos self (13800, 8000, 6200) 2000mm/s 0
		CharWalkToPos self (14520, 8000, 20050) 2000mm/s 0
		CharWalkToPos self (8730, 8000, 20460) 2000mm/s 0
		CharWalkToPos self (8730, 8000, 20460) 2000mm/s 0
		CharWalkToPos self (8530, 8000, 26610) 2000mm/s 0
		CharWalkToPos self (-14240, 8000, 26610) 2000mm/s 0
		CharWalkToPos self (-17130, 8000, 23430) 2000mm/s 0
		CharWalkToPos self (-17130, 8000, 7560) 2000mm/s 0
		CharWalkToPos self (-11380, 8000, 2990) 2000mm/s 0
		CharWalkToPos self (14040, 8000, 2490) 2000mm/s 0
	Return

fn[2]:
	if flag[1792]:
		CharSetPos char[9] (14240, 0, 2440) 270deg
		CharSetPos char[10] (-14920, 0, 10470) 0deg
	elif flag[1566]:
		CharSetPos char[10] (-14920, 0, 10470) 0deg
	elif flag[1554]:
	elif flag[1550]:
	elif flag[1536]:
		CharSetPos char[10] (-14920, 0, 10470) 0deg
	elif flag[1346]:
		CharSetPos char[1] (6620, 0, 10670) 225deg
		CharFlagsSet char[0] 0x0080
		CharFlagsUnset char[16] 0x0080
		if flag[1434]:
			CharFlagsUnset char[14] 0x0080
			CharFlagsUnset char[15] 0x0080
	elif flag[1342]:
		CharSetPos char[1] (6620, 0, 10670) 225deg
		CharFlagsSet char[0] 0x0080
		CharFlagsUnset char[16] 0x0080
	elif flag[1055]:
		CharFlagsUnset char[7] 0x0080
		CharSetPos char[10] (-14920, 0, 10470) 0deg
	elif flag[1040]:
		CharSetPos char[10] (-14920, 0, 10470) 0deg
		CharSetPos char[9] (-17370, 30, 22740) 45deg
	elif flag[1037]:
		CharSetPos char[9] (14240, 0, 2440) 270deg
		CharFlagsSet char[10] 0x0080
	elif flag[1031]:
		CharTurnToChar char[0] char[1] 0deg/s
		CharTurnToChar char[1] char[0] 0deg/s
		CharFlagsSet char[0] 0x0010
		CharSetPos char[9] (14040, 8000, 21830) 90deg
	elif flag[1024]:
		CharSetPos char[9] (-17370, 30, 22740) 45deg
	elif flag[801]:
		CharSetPos char[10] (-14920, 0, 10470) 0deg
	elif flag[777]:
		CharSetPos char[9] (-5240, 8000, 5490) 0deg
	elif flag[768]:
	elif flag[533]:
	elif flag[526]:
	Return

fn[3]:
	LookPointFlagsSet look_point[8] 0x0001
	if flag[1536]:
	elif flag[1342]:
		LookPointFlagsSet look_point[0] 0x0001
		LookPointFlagsSet look_point[1] 0x0001
		LookPointFlagsUnset look_point[8] 0x0001
	if system[0] == 102:
		ED7_76_1 object[255] "model5" 1
	else:
		ED7_76_0 object[255] "model5" 1
	if flag[1037] && !flag[1038]:
		MapColor 0x00C8D2FF 0ms
	elif flag[1792]:
		MapColor 0x00C8D2FF 0ms
	else:
	if flag[1554]:
	elif flag[1536]:
		if QuestFlagsGet quest[42] 0x10:
		elif QuestTaskGet quest[42] 3:
			EntranceSetFunc entrance[0] fn[0,35]
	Return

fn[4]:
	Call fn[0,5]
	Return

fn[5]:
	if QuestTaskGet quest[2] 0 && !QuestTaskGet quest[2] 1 && !QuestFlagsGet quest[2] 0x40:
		CharTurnToChar field_party[0] char[0] 0deg/s
		_Char4A char[1] 255
		_Char4A char[0] 255
		Call fn[0,36]
		Return
	TextStart char[0]
	if flag[15]:
		TextTalk char[0] {
			ふふ、見つかって良かったですね。{wait}
		}
		TextWait
		TextTalk char[0] {
			また百貨店タイムズを
			ご利用くださいませ。{wait}
		}
		TextWait
	elif flag[1792]:
		if !flag[0]:
			TextTalk char[0] {
				はぁ……スコットさんは
				いつごろゆっくりできるように
				なるのかしら。{wait}
			}
			TextWait
			TextTalk char[0] {
				……結婚はまだ遠いなぁ……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				……あっ、すみません！
				ぼーっとしちゃっていました。{wait}
			}
			TextWait
			TextTalk char[0] {
				何かありましたら
				遠慮なく仰ってください。
				丁寧にご案内させていただきます。{wait}
			}
			TextWait
	elif flag[1566]:
		TextTalk char[0] {
			仕事が始まって間もない
			この時間はなんだか、
			気だるくて心地いいんです。{wait}
		}
		TextWait
		TextTalk char[0] {
			今日も一日、お仕事を
			頑張ってくださいませ。{wait}
		}
		TextWait
	elif flag[1554]:
		TextTalk char[0] {
			百貨店《タイムズ》へ
			ようこそいらっしゃいました。{wait}
		}
		TextWait
		TextTalk char[0] {
			当店ではお客様の心をくすぐる
			さまざまな催しが行われています。{wait}
		}
		TextWait
		TextTalk char[0] {
			『心をくすぐると笑顔がこぼれる』……
			それが支配人の座右の銘なのです。{wait}
		}
		TextWait
	elif flag[1536]:
		if QuestTaskGet quest[42] 3 && !QuestFlagsGet quest[42] 0x10:
			if flag[0]:
				TextTalk char[0] {
					恋人へのプレゼントを選んでいると
					とても楽しい一時を過ごせますよね。{wait}
				}
				TextWait
				TextTalk char[0] {
					ふふ、どうかお買い物を
					楽しんでいってくださいね。{wait}
				}
				TextWait
			else:
				TextTalk char[0] {
					お客様……もしかして
					恋人へのプレゼントを
					お選びですか？{wait}
				}
				TextWait
				TextTalk char[0] {
					ふふ、とても恋人想いなんですね。{wait}
				}
				TextWait
				TextTalk name[158] {
					えっ……
					い、いやいや、俺とフランさんは
					まだそんな仲じゃあ……！{wait}
				}
				TextWait
				TextTalk name[0] {
					#0006F（本当に違うあたり、切ないな……）{wait}
				}
				TextWait
				FlagSet flag[0]
		else:
			TextTalk char[0] {
				マクダエル市長も御用達の
				百貨店《タイムズ》へ
				ようこそいらっしゃいました。{wait}
			}
			TextWait
			TextTalk char[0] {
				……なんて、ちょっと
				あざとすぎますかね？{wait}
			}
			TextWait
	elif flag[1342]:
	elif flag[1055]:
		if !flag[0]:
			TextTalk char[0] {
				シンシア先輩みたいな美人の方は
				ヒールでキチッとキメてる
				イメージなんですけど……{wait}
			}
			TextWait
			TextTalk char[0] {
				朝、スニーカーで
				通勤しているのを見たときは
				ちょっぴり驚いちゃいました。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				シンシア先輩みたいな美人の方は
				ヒールでキチッとキメてる
				イメージなんですけど……{wait}
			}
			TextWait
			TextTalk char[0] {
				実はスニーカー姿が似合っているって、
				ギャップがいいですよね。{wait}
			}
			TextWait
	elif flag[1040]:
		TextTalk char[0] {
			ネストン支配人は、
			色々な企画に携わってきた
			すごい方なんだそうです。{wait}
		}
		TextWait
		TextTalk char[0] {
			昔は創立記念祭の行事進行にも
			関わっていたとかいないとか……{wait}
		}
		TextWait
		TextTalk char[0] {
			うーん、私が言うのもなんですが
			只者じゃないですね。{wait}
		}
		TextWait
	elif flag[1037]:
		TextTalk char[0] {
			……あら、ジャネッタさんったら
			食品売り場を眺めて
			よだれをたらしているわ。{wait}
		}
		TextWait
		TextTalk char[0] {
			ふふ、ああいう子供っぽいところが
			私たちを癒してくれるんですよ。{wait}
		}
		TextWait
	elif flag[1031]:
		if !flag[1]:
			Call fn[0,7]
		else:
			CharTurnToChar char[0] field_party[0] 0deg/s
			TextTalk char[0] {
				実は私、ギルドの遊撃士に
				婚約者がいるんですよ……{wait}
			}
			TextWait
			TextTalk char[0] {
				あ、忙しくてなかなか会えないけど
				私のことを大事に想ってくれる
				とてもいい人なんですよ？{wait}
			}
			TextWait
			CharTurnToChar char[0] char[1] 0deg/s
	elif flag[1024]:
		if !flag[0]:
			TextTalk char[0] {
				こちらでは、駅やバス、飛行船の
				時刻案内も行っていますよ。{wait}
			}
			TextWait
			TextTalk char[0] {
				帝国や共和国からも
				お客様が沢山いらっしゃるものですから。{wait}
			}
			TextWait
			TextTalk char[0] {
				皆様もぜひご利用くださいね。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				こちらでは、駅やバス、飛行船の
				時刻案内も行っていますよ。
				皆様もぜひご利用くださいね。{wait}
			}
			TextWait
	elif flag[801]:
		if !flag[0]:
			TextTalk char[0] {
				……はぁ……スコットさん、
				今頃何してるのかな……{wait}
			}
			TextWait
			Emote char[0] 0mm 2000mm 38 38 250ms 1
			Sleep 1000ms
			TextTalk char[0] {
				し、失礼しました。
				お客様の前で……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				失礼しました。
				お客様の前でため息なんて……{wait}
			}
			TextWait
	elif flag[777]:
		TextTalk char[0] {
			支配人が何か
			考え込んでらっしゃいますね……{wait}
		}
		TextWait
		TextTalk char[0] {
			また新しい企画でも
			練ってらっしゃるんでしょうか。{wait}
		}
		TextWait
	elif flag[768]:
		TextTalk char[0] {
			皆様、お早うございます。{wait}
		}
		TextWait
		TextTalk char[0] {
			どうか本日も
			一日元気にお過ごしくださいね。{wait}
		}
		TextWait
	elif flag[533]:
		if !flag[0]:
			TextTalk char[0] {
				シンシア先輩はこの百貨店の
				看板娘なんですよ。{wait}
			}
			TextWait
			TextTalk char[0] {
				とても女性らしくて素敵ですから、
				街の女の子の憧れの的なんです。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				シンシア先輩はこの百貨店の
				看板娘なんですよ。{wait}
			}
			TextWait
			TextTalk char[0] {
				うふふ……かくいう私も、
				シンシア先輩に憧れて
				この仕事に就いたんです。{wait}
			}
			TextWait
	elif flag[526]:
		if !flag[0]:
			TextTalk char[0] {
				輸入食材や洋服、
				靴に雑貨、アクセサリ……{wait}
			}
			TextWait
			TextTalk char[0] {
				当百貨店にはいくつもの専門店があります。
				ふふ、一度覗いてみてはいかがですか？{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				当百貨店には
				いくつもの専門店があるんです。{wait}
			}
			TextWait
			TextTalk char[0] {
				ふふ、皆様も
				覗いてみてはいかがですか？{wait}
			}
			TextWait
	TextEnd char[0]
