fn[7]:
	TextStart self
	if flag[1566]:
		TextTalk char[4] {
			今日の公演は
			役をやりくりして何とかしよう。{wait}
		}
		TextWait
		TextTalk char[4] {
			……ニコル君が
			戻ってきてくれるのが
			一番いいんだが……{wait}
		}
		TextWait
	elif flag[1554]:
		Call fn[0,12]
	elif flag[1550]:
		if flag[0]:
			TextTalk char[4] {
				貴賓席のお客様は
				私がご案内する事にしているんだ。{wait}
			}
			TextWait
			TextTalk char[4] {
				だが……今日は
				変わったお客様だね……{wait}
			}
			TextWait
			TextTalk char[4] {
				それもこの歳で貴賓席なんて……
				そういった方面にツテでも
				ある人なんだろうか。{wait}
			}
			TextWait
		else:
			_Char4A char[13] 255
			TextTalk char[13] {
				#3509Fおお、リッチ～。
				見晴らしイイじゃん？{wait}
			}
			TextWait
			TextTalk char[4] {
				ははは……公演時刻は
				約１０分後となります。{wait}
			}
			TextWait
			TextTalk char[4] {
				『金の太陽、銀の月』、
				どうぞごゆっくりお楽しみ下さい。{wait}
			}
			TextWait
			CharFlagsUnset char[4] 0x0010
			FlagSet flag[0]
			_Char4B char[13] 255
	elif flag[1342]:
		_Char4A char[2] 255
		if flag[0]:
			TextTalk char[4] {
				私も外国公演はしないと
				決めているわけではないんだ……{wait}
			}
			TextWait
			TextTalk char[4] {
				……バルサモ君、悪いが
				一度検討してくれるかな。{wait}
			}
			TextWait
		else:
			TextTalk char[4] {
				ふむ、興行の話だね……{wait}
			}
			TextWait
			TextTalk char[4] {
				私もキリカさんの話には
				心を動かされるものがあったよ。{wait}
			}
			TextWait
			TextTalk char[4] {
				あの人はどうやら
				アルカンシェルの芸術性を
				理解しているようだ……{wait}
			}
			TextWait
			TextTalk char[4] {
				……バルサモ君、悪いが
				検討してみてくれるかな。
				任せきりで悪いんだが。{wait}
			}
			TextWait
			FlagSet flag[0]
		_Char4B char[2] 255
	elif flag[1055]:
		if flag[0]:
			TextTalk char[4] {
				イリア君の指導のかいあって
				リーシャ君の実力も上がっているんだ。{wait}
			}
			TextWait
			TextTalk char[4] {
				残りのメンバーが付いてこれれば
				素晴らしい舞台になるはずだよ。{wait}
			}
			TextWait
		else:
			TextTalk char[4] {
				おや、君たちか。{wait}
			}
			TextWait
			TextTalk char[4] {
				色々ごたごたしてしまっているが、
				稽古は進めないとねぇ。{wait}
			}
			TextWait
			TextTalk char[4] {
				リーシャ君も近頃めきめきと
				演技力を上げている……{wait}
			}
			TextWait
			TextTalk char[4] {
				みんなにも頑張ってもらわないとね。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1040]:
		if flag[0]:
			TextTalk char[4] {
				（捜査一課の方が早速やってきてね。
				{}  朝から事情聴取なんだ。）{wait}
			}
			TextWait
			TextTalk char[4] {
				（しかし……こんな日に限って
				{}  イリア君は寝坊でね。
				{}  まったく冷や冷やさせてくれるよ。）{wait}
			}
			TextWait
		else:
			_Char4A char[11] 255
