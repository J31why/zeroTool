					}
					TextWait
					TextTalk char[4] {
						帝国・共和国への守りが
						門の鉄柵一本という現状、
						僕はどうしても不安だよ。{wait}
					}
					TextWait
			elif flag[1536]:
				if !flag[4]:
					TextTalk char[4] {
