fn[6]:
	if flag[1566]:
		CharFlagsUnset char[24] 0x0080
		CharFlagsUnset char[25] 0x0080
		ForkFunc char[1] fork[0] fn[0,1]
		CharFlagsUnset char[5] 0x0080
		CharFlagsUnset char[6] 0x0080
	elif flag[1554]:
		CharFlagsUnset char[22] 0x0080
		CharFlagsUnset char[23] 0x0080
		ForkFunc char[1] fork[0] fn[0,1]
	elif flag[1536]:
		CharFlagsUnset char[20] 0x0080
		ForkFunc char[20] fork[0] fn[0,3]
		ForkFunc char[1] fork[0] fn[0,1]
		CharFlagsUnset char[21] 0x0080
	elif flag[1307]:
		CharFlagsUnset char[17] 0x0080
		CharFlagsUnset char[18] 0x0080
		CharFlagsUnset char[19] 0x0080
		CharSetPos char[1] (-110, 0, 1840) 180deg
		CharFlagsSet char[1] 0x0010
	elif flag[1292]:
		CharFlagsUnset char[14] 0x0080
		CharFlagsUnset char[15] 0x0080
		CharFlagsUnset char[16] 0x0080
		ForkFunc char[1] fork[0] fn[0,2]
	elif flag[1282]:
		CharFlagsUnset char[12] 0x0080
		CharFlagsUnset char[13] 0x0080
		ForkFunc char[1] fork[0] fn[0,1]
	elif flag[1280]:
		CharFlagsUnset char[9] 0x0080
		CharFlagsUnset char[10] 0x0080
		CharFlagsUnset char[11] 0x0080
		CharFlagsUnset char[29] 0x0080
		CharFlagsUnset char[30] 0x0080
		CharSetPos char[1] (-6660, 0, -4750) 0deg
		if QuestFlagsGet quest[25] 0x10:
			CharFlagsUnset char[34] 0x0080
		if system[0] == 100 && QuestFlagsGet quest[25] 0x02 && !QuestTaskGet quest[25] 0:
			Event fn[0,42]
	elif flag[1040]:
		CharFlagsUnset char[8] 0x0080
		ForkFunc char[1] fork[0] fn[0,2]
	elif flag[1024]:
		CharFlagsUnset char[7] 0x0080
		ForkFunc char[1] fork[0] fn[0,1]
	if flag[1280] && !flag[1536]:
		CharFlagsUnset char[27] 0x0080
		CharFlagsUnset char[26] 0x0080
	Return

fn[7]:
	ObjFrame object[7] 140
	LookPointFlagsSet look_point[3] 0x0001
	ObjFlagsSet object[8] 0x0004
	ED7_78 object[4] char[28]
	ObjFlagsSet object[4] 0x0004
	ObjFlagsSet object[5] 0x0004
	ObjFlagsSet object[9] 0x0004
	ED7_76_0 object[4] "light" 1
	ED7_76_0 object[5] "light" 1
	ED7_76_0 object[9] "light" 1
	if flag[1566]:
	elif flag[1554]:
	elif flag[1536]:
	elif flag[1307]:
		ObjFlagsUnset object[4] 0x0004
		CharSetPos char[28] (-6000, 100, 0) 0deg
		Sc_D1 char[28] 0 270000 0 0ms
		ObjFlagsUnset object[5] 0x0004
		ED7_78 object[5] char[31]
		CharSetPos char[31] (150, 100, 0) 0deg
		Sc_D1 char[31] 0 270000 0 0ms
	elif flag[1292]:
		ObjFlagsUnset object[4] 0x0004
		CharSetPos char[28] (5500, 100, 0) 0deg
		Sc_D1 char[28] 0 270000 0 0ms
	elif flag[1282]:
	elif flag[1280]:
		ObjFlagsUnset object[8] 0x0004
		ED7_78 object[8] char[35]
		ObjFlagsUnset object[4] 0x0004
		Sc_D1 char[28] 0 90000 0 0ms
		CharSetPos char[28] (2840, 100, 5360) 0deg
		ED7_78 object[5] char[31]
		ObjFlagsUnset object[5] 0x0004
		CharSetPos char[31] (16570, 100, 5380) 0deg
		Sc_D1 char[31] 0 90000 0 0ms
		if QuestTaskGet quest[25] 2 && !QuestTaskGet quest[25] 3:
			LookPointFlagsUnset look_point[3] 0x0001
	elif flag[1040]:
		ObjFlagsUnset object[4] 0x0004
		CharSetPos char[28] (-6000, 100, 0) 0deg
		Sc_D1 char[28] 0 270000 0 0ms
	elif flag[1024]:
	Return

fn[8]:
	Call fn[0,9]
	Return

fn[9]:
	if flag[1292] && !flag[1307]:
		TextStart char[14]
	else:
		TextStart char[0]
	if flag[1566]:
		if !flag[0]:
			TextTalk char[0] {
				色々悩むこともあるけど……
				この受付の仕事だって
				警備隊の大切な任務の一つだ。{wait}
			}
			TextWait
			TextTalk char[0] {
				仕事を与えられている以上は
				きちんと成し遂げる。{wait}
			}
			TextWait
			TextTalk char[0] {
				何はなくとも、それが大事だと思うよ。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				警備隊にいると報われないことは
				確かに多いけど……{wait}
			}
			TextWait
			TextTalk char[0] {
				今与えられている仕事は
				ちゃんとしないとね。{wait}
			}
			TextWait
	elif flag[1554]:
		TextTalk char[0] {
			さて、今日も受付の仕事だ。{wait}
		}
		TextWait
		TextTalk char[0] {
			……俺は、入隊時に夢見ていた
			警備隊員をやれてるのかな……{wait}
		}
		TextWait
	elif flag[1536]:
		TextTalk char[0] {
			ベルガード門詰めの警備隊員による
			遺跡の調査は、早々に打ち切られた。{wait}
		}
		TextWait
		TextTalk char[0] {
			引き時を弁えるのも司令の仕事だけど、
			さすがにこれは怠慢と言わざるをえないよ。{wait}
		}
		TextWait
	elif flag[1307]:
		TextTalk char[0] {
			帰国する観光客が増えだしたな……
			やれやれ、今日中に終わるのかね。{wait}
		}
		TextWait
		TextTalk char[0] {
			せっかくの記念祭なのに
			こんなムサい所で
			足止め食らわすとかわいそうだな。{wait}
		}
		TextWait
	elif flag[1292]:
		_Char4A char[0] 255
		_Char4A char[14] 255
		TextTalk char[0] {
			はい、出国手続きは終わりです。{wait}
		}
		TextWait
		TextTalk char[0] {
			ゲートを開くので
			少しお待ち下さい。{wait}
		}
		TextWait
		TextTalk char[14] {
			うむ、そうかね。
			とっとと妻を呼んで来るか。{wait}
		}
		TextWait
		_Char4B char[0] 255
		_Char4B char[14] 255
	elif flag[1282]:
		if !flag[0]:
			TextTalk char[0] {
				ふぅ……
				そろそろピークは過ぎたかな。
				随分忙しかったよ。{wait}
			}
			TextWait
			TextTalk char[0] {
				帝国人は質実剛健な気質だって
				聞いていたけど……
				案外お祭り好きも多いみたいだな。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				折角の記念祭だ、
				帝国や共和国の人も
				楽しんできてほしいね。{wait}
			}
			TextWait
	elif flag[1280]:
		if !flag[0]:
			TextTalk char[0] {
				あー、忙しい。
				やっと長蛇の列をさばききったよ。{wait}
			}
			TextWait
			TextTalk char[0] {
				今年は陸路の客が結構多いね。
				素直に列車で来たほうが
				直接街に着いて楽だろうに。{wait}
			}
			TextWait
			TextTalk char[0] {
				……ま、折角のお祭りだ。
				普段と違うことしたほうが
				楽しいだろうね。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				今年は陸路の客が結構多いね。
				素直に列車で来たほうが
				直接街に着いて楽だろうに。{wait}
			}
			TextWait
			TextTalk char[0] {
				……ま、折角のお祭りだ。
				普段と違うことしたほうが
				楽しいだろうね。{wait}
			}
			TextWait
	elif flag[1040]:
		if !flag[0]:
			TextTalk char[0] {
				帝国方面へは、バスは殆ど出ていないんだ。{wait}
			}
			TextWait
			TextTalk char[0] {
