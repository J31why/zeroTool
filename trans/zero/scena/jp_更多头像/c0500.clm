fn[7]:
	TextStart self
	if flag[1037]:
		TextTalk char[0] {
			おいお前ら……
			もう用事はねえはずだろ。{wait}
		}
		TextWait
		TextTalk char[0] {
			クク、それとも若頭に
			可愛がって欲しいのか？{wait}
		}
		TextWait
	else:
		TextTalk char[0] {
			オイオイ坊主ども、
			お帰りはあっちだぜ。{wait}
		}
		TextWait
		TextTalk char[0] {
			怖い目に遭いたくなかったら
			さっさと失せるんだな。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[8]:
	TextStart self
	if flag[1037]:
		TextTalk self {
			いつまでうろついてんだ、
			アア？{wait}
		}
		TextWait
	else:
		TextTalk char[1] {
			《ルバーチェ商会》に何か用事か？{wait}
		}
		TextWait
		TextTalk char[1] {
			ハッ、若頭がお会いになった程度で
			調子こいてんじゃねえぞ。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[9]:
	TextStart self
	if flag[1792]:
		if flag[0]:
			TextTalk char[2] {
				ぺろり……どこかに
				ええお客さんおらへんか？{wait}
			}
			TextWait
			TextTalk char[2] {
				ワテがハッピーな世界に
				連れて行ってあげようやん。
				うひゃひゃひゃ……！{wait}
			}
			TextWait
		else:
			TextTalk char[2] {
				なんや釈然とせんまま
				日が暮れてきたね。
				今日はほんまおかしな一日やわ……{wait}
			}
			TextWait
			TextTalk char[2] {
				……まあええわ、商売始めよか。
				時は金なりやしね。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1566]:
		TextTalk self {
			なんや……昨日に続いて
			今日も通りが静かやね。{wait}
		}
		TextWait
		TextTalk self {
			こう、いつもうごめいとった
			この街の『黒いシミ』が
			感じられんちゅうか。{wait}
		}
		TextWait
		TextTalk self {
			……なんや静かすぎるわー。{wait}
		}
		TextWait
	elif flag[1554]:
		if flag[1557]:
			if flag[0]:
				TextTalk char[2] {
					（あの人な、元猟兵やったっちゅう噂や。
					{}  関わったらろくな死に方でけへんで。）{wait}
				}
				TextWait
				TextTalk char[2] {
					（やめとき、やめとき！
					{}  ……触らぬが吉や。）{wait}
				}
				TextWait
			else:
