fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if system[0] == 101 && flag[761]:
		FlagUnset flag[761]
		Event fn[0,2]
	CharFlagsSet char[7] 0x0080
	CharFlagsSet char[8] 0x0080
	CharFlagsSet char[6] 0x0080
	CharFlagsSet char[5] 0x0080
	if flag[1566]:
		if QuestFlagsGet quest[49] 0x10:
			CharFlagsUnset char[6] 0x0080
			CharSetPos char[6] (1080, 300, 29510) 0deg
			CharFlagsSet char[6] 0x0010
		CharFlagsSet char[4] 0x0080
	elif flag[1554]:
	elif flag[1536]:
	elif flag[1307]:
	elif flag[1362]:
		CharFlagsSet char[4] 0x0010
	elif flag[1292]:
		CharFlagsSet char[4] 0x0010
	elif flag[1282]:
		CharFlagsUnset char[9] 0x0080
		CharFlagsUnset char[10] 0x0080
	elif flag[1280]:
	elif flag[1055]:
		CharSetPos char[3] (7110, 300, 32759) 90deg
		CharFlagsSet char[3] 0x0010
	elif flag[1040]:
	elif flag[1031]:
		CharSetPos char[3] (7110, 300, 32759) 90deg
		CharFlagsSet char[3] 0x0010
	elif flag[1024]:
	elif flag[801]:
		CharSetPos char[3] (7110, 300, 32759) 90deg
		if flag[892]:
			if !flag[869]:
				CharFlagsUnset char[6] 0x0080
				CharFlagsSet char[6] 0x0010
				CharFlagsUnset char[5] 0x0080
				CharFlagsSet char[5] 0x0010
	elif flag[777]:
		if flag[892]:
			CharFlagsUnset char[6] 0x0080
			CharFlagsSet char[6] 0x0010
			CharFlagsUnset char[5] 0x0080
			CharFlagsSet char[5] 0x0010
		CharFlagsUnset char[8] 0x0080
		CharSetPos char[3] (7110, 300, 32759) 90deg
		CharFlagsSet char[3] 0x0010
	else:
		CharFlagsUnset char[7] 0x0080
		if flag[892]:
			CharFlagsUnset char[6] 0x0080
			CharFlagsUnset char[5] 0x0080
			CharFlagsSet char[5] 0x0010
		CharSetPos char[3] (7110, 300, 32759) 90deg
		CharFlagsSet char[3] 0x0010
		CharFlagsSet char[7] 0x0010
		CharFlagsSet char[4] 0x0010
	if QuestTaskGet quest[45] 5 && !QuestTaskGet quest[45] 6 && !QuestFlagsGet quest[45] 0x40:
		Event fn[0,23]
	Return

fn[2]:
	SoundPlay sound[160] 0 100 0
	Return

fn[3]:
	if system[4] == 3:
		EntranceSetDisabled entrance[0] 0
		EntranceSetDisabled entrance[2] 1
	else:
		EntranceSetDisabled entrance[0] 1
		EntranceSetDisabled entrance[2] 0
	if flag[1041] && !flag[1049]:
		system[1] = 111
	if flag[1037] && !flag[1038]:
		MapColor 0x00C8D2FF 0ms
	elif flag[1792]:
		MapColor 0x00C8D2FF 0ms
	else:
	TriggerFlagsSet trigger[0] 0x0080
	if flag[525] && !flag[1042]:
		TriggerFlagsUnset trigger[0] 0x0080
	if flag[768] && !flag[1024] && !flag[892]:
		EntranceSetFunc entrance[0] fn[0,13]
	Return

fn[4]:
	TextStart self
	if flag[1566]:
		TextTalk self {
			む……今日は
			客が少ない気がするな。{wait}
		}
		TextWait
		TextTalk self {
			気のせいだろうか。{wait}
		}
		TextWait
	elif flag[1554]:
		if flag[0]:
			TextTalk self {
				客に不安を与えないのも
				警備員の仕事だ。{wait}
			}
			TextWait
			TextTalk self {
				発砲事件があったといっても、
				ＩＢＣは極めて安全だぞ。{wait}
			}
			TextWait
		else:
			TextTalk self {
				本日は警備員を
				２割ほど増やしている。{wait}
			}
			TextWait
			TextTalk self {
				……港湾公園の方で
				事件があったと言うからな。
				念のためだ。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1536]:
		if flag[0]:
			TextTalk self {
				ウチの保安部は
				世界中の主要都市に対して
				治安レベルの格付けを行っているのだ。{wait}
			}
			TextWait
			TextTalk self {
				これも各地を飛び回る
				クロイス総裁を守るためには
				必要なことだからな。{wait}
			}
			TextWait
		else:
			TextTalk self {
				この２、３週間ほどで
				市内の治安レベルが悪化している。{wait}
			}
			TextWait
			TextTalk self {
				我が保安部の格付けによると
				Ｃ－にまで落ち込んだぞ。{wait}
			}
			TextWait
			TextTalk self {
				人気のない裏路地などは危険だ。
				市民も注意してくれるといいんだが。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1307]:
		if flag[0]:
			TextTalk self {
				警備員たるもの油断は許されん。
				気を引き締めておかんとな。{wait}
			}
			TextWait
		else:
			TextTalk self {
				本日が祭りの最終日だな。{wait}
			}
			TextWait
			TextTalk self {
				こういう時こそ
				トラブルが起こりやすいものだ。
				気を引き締めておかんとな。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1362]:
		TextTalk self {
			重役の方たちは
			今日は一日中会議だそうだ。{wait}
		}
		TextWait
		TextTalk self {
			ふむ、同情してしまうな。{wait}
		}
		TextWait
	elif flag[1292]:
		if flag[0]:
			TextTalk self {
				祭りの影に忘れ去られそうだが、
				クロスベルの治安は良いとは言えんのだ。{wait}
			}
			TextWait
			TextTalk self {
				観光客が迷い込んで
				事件にあわなきゃいいんだがな。{wait}
			}
			TextWait
		else:
			TextTalk self {
				ウチの保安部の報告によると
				クロスベル市内の治安レベルが
				また悪化しているそうだ。{wait}
			}
			TextWait
			TextTalk self {
				ふむ……警察は何をしておるのか。{wait}
			}
			TextWait
			TextTalk self {
				あまり悪化するようなら
				我らも体制を強化する必要があるぞ。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1282]:
		if flag[0]:
			TextTalk self {
				どちらにせよ
				セキュリティカードが無くては
				エレベーターは動かんのだがな。{wait}
			}
			TextWait
		else:
			TextTalk self {
				先ほど、慣れない客が
				エレベーターに乗ろうとしたのだ。{wait}
			}
			TextWait
			TextTalk self {
				やれやれ、観光客め。
				この先は立ち入り禁止だと
				言っておるのに。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1280]:
		TextTalk self {
			港湾公園の方は
			大した混雑だそうだな。{wait}
		}
		TextWait
		TextTalk self {
			普段より客も多い……
			警備にも気を遣うぞ。{wait}
		}
		TextWait
	elif flag[1055]:
		TextTalk self {
			このビルの
			セキュリティシステムは
			外部から独立している。{wait}
		}
		TextWait
		TextTalk self {
			ハッキングだか
			何だかを食らっても
			問題ないはずだぞ。{wait}
		}
		TextWait
	elif flag[1040]:
		if flag[1042]:
			TextTalk self {
				上の階に用事か？{wait}
			}
			TextWait
			TextTalk self {
				このエレベーターに乗って
				認証カードを使うといい。{wait}
			}
			TextWait
		else:
			TextTalk self {
				む……この上の階は
				関係者以外立ち入りはできないぞ。{wait}
			}
			TextWait
			TextTalk self {
				用事があるなら
				総合受付で許可を貰ってからだな。{wait}
			}
			TextWait
	elif flag[1031]:
		if !flag[0]:
			TextTalk self {
				フム、クロスベル周辺の
				治安レベルが悪化しているようだな……{wait}
			}
			TextWait
			TextTalk self {
				現在の所、大きな問題に
				直結しているわけではなさそうだが……{wait}
			}
			TextWait
			TextTalk self {
				この自治州には傭兵を取り締まる
				法律があるわけではないのだ。
				……どんな事でも起こりうるぞ……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			Emote char[0] 0mm 2000mm 24 27 250ms 1
			Sleep 1500ms
			TextTalk self {
				クロスベルという土地は
				非常に難しいのだ。{wait}
			}
			TextWait
			TextTalk self {
				決して安全とは言い切れん……
				我らも気を引き締めねばな……{wait}
			}
			TextWait
	elif flag[1024]:
		if flag[0]:
			TextTalk self {
				会社が大きくなれば
				それだけ守るものも増える。{wait}
			}
			TextWait
			TextTalk self {
				どこの企業も苦労しているようだな。{wait}
			}
			TextWait
		else:
			TextTalk self {
				最近では、うちの保安部にも
				外国企業から引き合いが来ていてな。{wait}
			}
			TextWait
			TextTalk self {
				ＶＩＰの警護依頼から
				警備のノウハウを教えてくれ、
				なんて話もある。{wait}
			}
			TextWait
			TextTalk self {
				どこの会社も
				保安には苦労しているようだな。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[801]:
		if flag[0]:
			TextTalk self {
				……知っているか？
				ここの地下１階には
				デカイ社員食堂があってな……{wait}
			}
			TextWait
			TextTalk self {
				ごほん、いや、何でもない。
				まだ勤務時間だからな。{wait}
			}
			TextWait
		else:
			TextTalk self {
				俺は体力を維持するため
				毎朝１００セルジュほど走っている。{wait}
			}
			TextWait
			TextTalk self {
				いざという時のために
				体は常に鍛えておかんとな。{wait}
			}
			TextWait
			TextTalk self {
				……だが、朝に走ると
				腹の減り具合が早くてな……{wait}
			}
			TextWait
			TextTalk self {
				ごほん、いや、何でもないんだが……{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[777]:
		if flag[0]:
			TextTalk self {
				このビルは、大陸で最も
				セキュリティの高い場所だ。{wait}
			}
			TextWait
			TextTalk self {
				安心して商談に
				励んでもらって構わないぞ。{wait}
			}
			TextWait
		else:
			TextTalk self {
				このビルは、大陸で最も
				セキュリティの高い場所だと
				自負している。{wait}
			}
			TextWait
			TextTalk self {
				防犯機能を重視した近代ビル。{wait}
			}
			TextWait
			TextTalk self {
				導力技術を駆使した
				最新のセキュリティシステム。{wait}
			}
			TextWait
			TextTalk self {
				そして我ら保安部の者も
				正式な訓練を受けたプロだ。{wait}
			}
			TextWait
			TextTalk self {
				どんな悪党も
				ここに侵入する事はできないぞ。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[0]:
		TextTalk self {
			ＩＢＣ内の保安なら
			俺たちに任せてくれ。
			こっちもプロなんでね。{wait}
		}
		TextWait
	else:
		TextTalk self {
			ほう、そのジャケット……
			君達は警察の関係者か？{wait}
		}
		TextWait
		TextTalk self {
			俺たちはＩＢＣグループに
			勤める保安部の者だ。{wait}
		}
		TextWait
		TextTalk self {
			ＩＢＣ内の保安なら
			俺たちに任せてくれよ。{wait}
		}
		TextWait
		FlagSet flag[0]
	TextEnd self
	Return

fn[5]:
	TextStart self
	if flag[1566]:
		if flag[1]:
			TextTalk self {
				今日はクロイス総裁も
				マリアベルさんも出張なんです。{wait}
			}
			TextWait
			TextTalk self {
				少し寂しいですね。{wait}
			}
			TextWait
		else:
			TextTalk self {
				マリアベルさんは
				今日は外国に出張なさっています。{wait}
			}
			TextWait
			TextTalk self {
				あの方も年々
				出張が増えていますね……{wait}
			}
			TextWait
			TextTalk self {
				ますますお父上に似てきましたよ。{wait}
			}
			TextWait
			FlagSet flag[1]
	elif flag[1554]:
		TextTalk self {
			今日はお客様も
			心なしか少ないようです。{wait}
		}
		TextWait
		TextTalk self {
			ふう……いくら我々でも
			ビルの外までは警備できませんよ。{wait}
		}
		TextWait
	elif flag[1536]:
		if flag[1]:
			TextTalk self {
				記念祭のあおりでしょうか、
				近頃企業進出の話が多いんですよ。{wait}
			}
			TextWait
			TextTalk self {
				自分も少し気になってしまいます。{wait}
			}
			TextWait
		else:
			TextTalk self {
				このビルには
				ラインフォルト社の営業部が
				入っているんですが……{wait}
			}
			TextWait
			TextTalk self {
				近頃、ライバルである
				ヴェルヌ社も支部を設けたいという
				打診があるそうなんです。{wait}
			}
			TextWait
			TextTalk self {
				うーん、事あるごとに
				対立する２社だと聞いていましたが、
				ホント負けず嫌いな話ですよね。{wait}
			}
			TextWait
			FlagSet flag[1]
	elif flag[1307]:
		if flag[1]:
			TextTalk self {
				あまり報道されませんが……
				クロスベルは過去に
				テロ事件などにも見舞われています。{wait}
			}
			TextWait
			TextTalk self {
				記念祭が無事に終わりそうで
				何よりですよ。{wait}
			}
			TextWait
		else:
			TextTalk self {
				記念祭も今日で終わりですね……{wait}
			}
			TextWait
			TextTalk self {
				遊べなかったのは残念ですが、
				まあ何事もなくて良かったですよ。{wait}
			}
			TextWait
			FlagSet flag[1]
	elif flag[1362]:
		TextTalk self {
			先ほどマリアベルさんが
			顔をお見せになったんです。{wait}
		}
		TextWait
		TextTalk self {
			僕ら社員の
			労をねぎらって下さったんですよ。
			嬉しいものですね。{wait}
		}
		TextWait
	elif flag[1292]:
		if flag[1]:
			TextTalk self {
				ミシュラムのワンダーランドって
				聞いた事はありませんか？{wait}
			}
			TextWait
			TextTalk self {
				《みっしぃ》って名前の猫が
				マスコットキャラなんですけど。{wait}
			}
			TextWait
		else:
			TextTalk self {
				エルム湖の対岸にある
				《ミシュラム》には
				テーマパークがあるんですよ。{wait}
			}
			TextWait
