fn[19]:
	if flag[777]:
		field_party[0].5 = self.4
		self.5 = self.4
		TextStart self
		CharFlagsUnset self 0x0010
		CharTurnToChar self field_party[0] 0deg/s
		self.4 = (self.4 + 360) % 360
		self.4 = self.4 + 360 - self.5
		self.5 = self.4 / 180
		if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
		elif self.5 < 1:
			self.8 = 2
		elif self.5 > 2:
			self.8 = 1
		else:
			self.8 = self.5
		self.4 = field_party[0].5
		field_party[0].5 = 0
		self.5 = 0
		CharFlagsSet self 0x0010
		if flag[6]:
			TextTalk self {
				ＩＢＣに預金を
				下ろしに来たのですよ。{wait}
			}
			TextWait
			TextTalk self {
				クロスベル市民なら
				みんなＩＢＣよね。
				利回りも一番だもの。{wait}
			}
			TextWait
		else:
			TextTalk self {
				孫の誕生日でね。
				少し大きな買い物をしようと思って。{wait}
			}
			TextWait
			TextTalk self {
				ひい、ふう、みい……
				ええ、きちんと全額揃っているわね。{wait}
			}
			TextWait
			FlagSet flag[6]
		CharSetChipPattern self 0
		TextEnd self
	else:
		TextStart self
		Call fn[0,10]
		TextEnd self
	Return

