fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if flag[1792]:
	elif flag[1566]:
	elif flag[1560]:
		CharFlagsUnset char[2] 0x0080
	elif flag[1554]:
		CharFlagsUnset char[1] 0x0080
		CharFlagsUnset char[4] 0x0080
		CharFlagsUnset char[6] 0x0080
		CharFlagsUnset char[8] 0x0080
		CharFlagsUnset char[9] 0x0080
		CharFlagsUnset char[10] 0x0080
		CharFlagsUnset char[11] 0x0080
		CharSetPos char[9] (-6640, 0, 51900) 90deg
		CharFlagsSet char[9] 0x0010
		if !flag[1658]:
			CharFlagsSet char[0] 0x0010
	elif flag[1536]:
	elif flag[1342]:
		CharFlagsUnset char[4] 0x0080
		CharFlagsUnset char[6] 0x0080
		CharSetPos char[4] (-8400, 150, 49200) 180deg
		CharSetPos char[6] (-10700, 150, 49200) 180deg
	elif flag[1055]:
		CharFlagsUnset char[7] 0x0080
		CharFlagsUnset char[9] 0x0080
		CharSetPos char[7] (2220, 0, 4610) 90deg
		CharSetPos char[9] (3840, 0, 4540) 270deg
	elif flag[1040]:
		CharFlagsUnset char[9] 0x0080
		CharSetChipBase char[9] chip[13]
		CharSetChipPattern char[9] 0
		ForkQuit char[9] fork[0]
		CharFlagsSet char[9] 0x0004
		CharFlagsSet char[9] 0x0010
		CharSetPos char[9] (-6030, 0, 46890) 0deg
		CharFlagsSet char[9] 0x0010
		CharFlagsUnset char[8] 0x0080
		CharSetPos char[8] (-5960, 150, 49360) 180deg
	elif flag[1031]:
		CharFlagsUnset char[1] 0x0080
		CharSetPos char[1] (600, 0, 39580) 90deg
		CharFlagsSet char[1] 0x0010
	elif flag[1024]:
		CharFlagsUnset char[2] 0x0080
	elif flag[801]:
		CharFlagsUnset char[3] 0x0080
		CharFlagsUnset char[5] 0x0080
		if flag[874]:
			CharFlagsSet char[0] 0x0010
	elif flag[777]:
		CharFlagsUnset char[10] 0x0080
		CharSetPos char[10] (-5930, 150, 43070) 180deg
		CharFlagsUnset char[11] 0x0080
		CharFlagsUnset char[11] 0x0010
		CharSetPos char[11] (-4610, 0, 43390) 225deg
	elif flag[768]:
		CharFlagsUnset char[2] 0x0080
	elif flag[533]:
		CharFlagsUnset char[10] 0x0080
		CharSetPos char[10] (-5930, 150, 43070) 180deg
		CharFlagsUnset char[11] 0x0080
		CharFlagsUnset char[11] 0x0010
		CharSetPos char[11] (-4610, 0, 43390) 225deg
	elif flag[526]:
		CharFlagsUnset char[7] 0x0080
		CharFlagsUnset char[9] 0x0080
	if flag[1343] && !flag[1344]:
		SystemFlagsSet 0x10000000
		Event fn[0,31]
	if flag[736]:
		FlagUnset flag[736]
		Event fn[0,27]
	elif flag[737]:
		FlagUnset flag[737]
		Event fn[0,33]
	if system[4] == 0 && !flag[570]:
		Event fn[0,21]
	Return

fn[2]:
	if flag[538] && !flag[768]:
		system[1] = 0
	if flag[1037] && !flag[1038]:
		MapColor 0x00C8D2FF 0ms
	elif flag[1792]:
		MapColor 0x00C8D2FF 0ms
	else:
	if flag[1031] && !flag[1040]:
		ED7_76_2 object[255] "red_" "on"
	Return

fn[3]:
	Call fn[0,4]
	Return

fn[4]:
	TextStart char[0]
	if flag[1792]:
		TextTalk char[0] {
			#04004Fウチのメンバーには
			各地の捜索を割り当てたわ。
			市外については任せてくれてＯＫよ。{wait}
		} {
			#04000Fアナタたちは気兼ねなく
			薬物調査の方を進めてちょうだい。{wait}
		} {
			#04011Fそれと、くれぐれも
			シズクちゃんのことを頼むわよ！{wait}
		}
		TextWait
		TextTalk name[1] {
			#0100Fええ、それはもう。{wait}
		}
		TextWait
		TextTalk name[0] {
			#0000F責任をもって
			預からせていただきます。{wait}
		}
		TextWait
	elif flag[1569]:
	elif flag[1566]:
		if !flag[1659]:
			TextTalk char[0] {
				#04005Fあら、アナタたち。
				何だか余裕が無さそうね。{wait}
			} {
				#04001Fまさかマフィアたちの抗争に
				進展でもあったのかしら？{wait}
			}
			TextWait
			TextTalk name[0] {
				#0003Fいえ、それとは別なんですが……{wait}
			}
			TextWait
			TextTalk char[0] {
				#04001Fあら、だったら……
				ひょっとして行方不明者の件？{wait}
			}
			TextWait
			Emote field_party[0] 0mm 2000mm 2 7 80ms 1
			SoundPlay sound[28] 0 100 0
			Emote field_party[1] 0mm 2000mm 2 7 80ms 1
			SoundPlay sound[28] 0 100 0
			Emote field_party[2] 0mm 2000mm 2 7 80ms 1
			SoundPlay sound[28] 0 100 0
			Emote field_party[3] 0mm 2000mm 2 7 80ms 1
			SoundPlay sound[28] 0 100 0
			Sleep 1200ms
			TextTalk name[0] {
				#0005Fギルドの方でも
				掴んでいたんですか！？{wait}
			}
			TextWait
			TextTalk char[0] {
				#04001Fええ、ちょうど
				アリオスが調べている所よ。{wait}
			} {
				#04003Fただ、そっちの方でも
				問題になっているという事は……
				かなり深刻かもしれないわね。{wait}
			} {
				#04001F消えたのは１人や２人じゃ
				きかないかもしれないわよ？{wait}
			}
			TextWait
			TextTalk name[3] {
				#0301F確かにな……{wait}
			}
			TextWait
			TextTalk name[2] {
				#0200Fできれば情報交換を
				しておきたい所ですが……{wait}
			}
			TextWait
			TextTalk char[0] {
				#04000Fあら、こっちの方は
				むしろ大歓迎だけど……{wait}
			} {
				#04005Fそっちはいいの？
				支援課だけで判断してしまって。{wait}
			}
			TextWait
			Emote field_party[0] 0mm 2000mm 24 27 250ms 0
			Emote field_party[1] 0mm 2000mm 24 27 250ms 0
			Emote field_party[2] 0mm 2000mm 24 27 250ms 0
			Emote field_party[3] 0mm 2000mm 24 27 250ms 0
			Sleep 1000ms
			EmoteStop field_party[0]
			EmoteStop field_party[1]
			EmoteStop field_party[2]
			EmoteStop field_party[3]
			Sleep 300ms
			TextTalk name[0] {
				#0003F（確かに一課から資料を借りてる手前、
				{}  外に捜査情報をもらす訳にも……）{wait}
			}
			TextWait
			TextTalk name[1] {
				#0108F（ダドリーさんあたりが知ったら
				{}  目を剥いて怒りそうね……）{wait}
			}
			TextWait
			TextTalk char[0] {
				#04000Fま、そのあたりの折り合いが
				付いたら来てちょうだい。{wait}
			} {
				#04000Fアリオスが戻ってきたら
				こちらの情報も整理しておくから。{wait}
			}
			TextWait
			FlagSet flag[1659]
		else:
			TextTalk char[0] {
				#04000Fあ、そうそう、ちょうど今、
				シズクちゃんが街に来てるのよ。{wait}
			} {
				#04003F調査に出たアリオスの代わりに
				エステルちゃんたちが遊びに
				連れていってくれてるけど……{wait}
			} {
				#04006Fうーん、シズクちゃんには
				申しわけない事をしちゃったわね。{wait}
			}
			TextWait
	elif flag[1560]:
		TextTalk char[0] {
			#04001Fようやく状況が掴めたけど
			今すぐ本格的な抗争が起こる
			雰囲気では無さそうね。{wait}
		} {
			#04003Fただ、予断は許さない状況よ。{wait}
		} {
			#04001Fいつでもメンバーを動かせるよう、
			シフトを組みなおしておかないと。{wait}
		}
		TextWait
	elif flag[1554]:
		if !flag[1658]:
			Call fn[0,5]
		else:
			TextTalk char[0] {
				#04003F《黒月》を襲撃したのは
				間違いなくルバーチェとして……{wait}
			} {
				#04001F問題は、どうしてこの状況で
				突発的に事を起こしたかよね。{wait}
			} {
				#04003Fふむ……とにかく状況を
				正確に見極めておきたい所ね。{wait}
			}
			TextWait
	elif flag[1536]:
		if !flag[1657]:
			TextTalk char[0] {
				#04000Fあら、支援課の坊やたち。
				２週間ぶりくらいね。{wait}
			} {
				#04006F……悪いわね、
				キーアちゃんの情報の事。{wait}
			}
			TextWait
			TextTalk name[2] {
				#0200Fギルドの情報網でも
				まだ掴めてないんですよね？{wait}
			}
			TextWait
			TextTalk char[0] {
				#04006Fええ、噂の一つくらいは
				引っかかると思ったんだけど。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0003Fいや、いいんです。
				キーアもすっかり支援課に
				馴染んでしまいましたし。{wait}
			} {
				#0000F身元や記憶を探るよりも
				日常の生活を優先してやりたいと
				思っているので。{wait}
			}
			TextWait
			TextTalk char[0] {
				#04004Fそう……
				ま、それも判断の一つよね。{wait}
			} {
				#04000F一応引き続き
				調査の方は続けさせてもらうわ。{wait}
			} {
				#04000Fそっちも、また何か判ったら
				連絡してちょうだい。{wait}
			}
			TextWait
			TextTalk name[1] {
				#0100Fええ、よろしくお願いします。{wait}
			}
			TextWait
			FlagSet flag[1657]
		elif !flag[0]:
			TextTalk char[0] {
				#04000Fアリオスは先週から
				帝国方面に飛んでいるわ。{wait}
			} {
				#04000Fかなり面倒な仕事だったけど
				そろそろ戻ってくるはずよ。{wait}
			}
			TextWait
			TextTalk name[3] {
				#0305Fへえ、なんか向こうで
				デカイ事件でもあったとか？{wait}
			}
			TextWait
			TextTalk char[0] {
				#04000F大事件ってほどでもないけど、
				向こうのギルド支部が
				軍部と揉めちゃってね。{wait}
			} {
				#04000F今だと、調停できるのが
				アリオスくらいしか居ないのよ。{wait}
			} {
				#04003F前はリベールにもう一人、
				打ってつけの人がいたんだけど
				遊撃士を辞めちゃってねぇ。{wait}
			}
			TextWait
			TextTalk name[1] {
				#0106Fそ、それは大変ですね。{wait}
			}
			TextWait
			TextTalk char[0] {
				#04006Fそうよ、大変なのよ。{wait}
			} {
				#04012F高位の遊撃士になるほど
				この手の面倒事が増えるのよねぇ。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				#04001Fちなみに帝国政府と
				遊撃士協会の関係は
				あまりよろしくないのよね。{wait}
			} {
				#04004Fその点だけはクロスベルは
				恵まれているわね。{wait}
			} {
				#04000F市民からの支持も高いし、
				政府からも信頼されているもの。{wait}
			}
			TextWait
	elif flag[1342]:
		if !flag[0]:
			TextTalk char[0] {
				#04000Fキーアちゃんの身元は
				大陸全土の遊撃士協会の
				情報網を使って調べてみるわ。{wait}
			} {
				#04000F簡単な報告なら１週間、
				詳しく調べるなら１ヶ月って所ね。{wait}
			}
			TextWait
			if PartyPosition name[1] > -1:
				TextTalk name[1] {
					#0105Fいつもながら速いですね……{wait}
				}
				TextWait
			elif PartyPosition name[2] > -1:
				TextTalk name[2] {
					#0200Fいつもながら速いですね……{wait}
				}
				TextWait
			elif PartyPosition name[3] > -1:
				TextTalk name[3] {
					#0306Fいつもながら速いな……{wait}
				}
				TextWait
			TextTalk name[0] {
				#0000Fよろしくお願いします。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				#04004F遊撃士協会は大陸全土に
				独自の情報網を持っているわ。{wait}
			} {
				#04000Fまあ、絶対とは言えないけど
				大抵の身元は判るはずよ。{wait}
			}
			TextWait
	elif flag[1055]:
		if !flag[0]:
			TextTalk char[0] {
				#04000Fあら……支援課じゃない。
				どこかへ出かけるのかしら？{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000Fええ、ちょっと
				ウルスラ間道の遺跡へ。{wait}
			}
			TextWait
			TextTalk char[0] {
				#04003F『星見の塔』か……
				警備隊が封鎖してるハズだけど。{wait}
			} {
				#04012Fあの辺りは手強い魔獣が
				出没する事があるのよ。
				準備は怠らないことねえ。{wait}
			}
			TextWait
			TextTalk name[1] {
				#0100Fええ、気をつけます。{wait}
			}
			TextWait
			TextTalk name[2] {
				#0203F（……いつも意外と
				{}  面倒見がいいんですよね。）{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				#04006Fふう……アナタたちが訪ねてくると
				ついつい世話を焼いちゃうわねぇ。{wait}
			} {
				#04012Fまあいいわ、『星見の塔』に行くなら
				十分に準備しておきなさい。{wait}
			} {
				#04001Fあの辺り、手強い魔獣が
				出没することがあるんだから。{wait}
			}
			TextWait
	elif flag[1040]:
		if !flag[0]:
			TextTalk char[0] {
				#04000Fそういえば、アルカンシェルの
