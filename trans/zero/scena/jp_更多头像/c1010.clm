	FadeWait
	if flag[638]:
		TextTalk name[0] {
			#11P#0005Fええっと……
			ミシェルさん？{wait}
		} {
			#0000F言われたとおり
			来てみたんですが……{wait}
		}
		TextWait
		VisSet vis[0] 3 0xFFFFFFFF 500ms 0 0
		VisSet vis[0] 0 -10000 0 500ms 0
		VisWait vis[0] 3
		VisWait vis[0] 0
		TextSetPos -1 280 35 3
		Sleep 300ms
		TextSetName "受付ミシェル"
		TextMessage char[0] {
			うふふ……待ってたわ。{wait}
		} {
			呼ばれて素直に来るなんて、
			なかなか可愛い所もあるじゃない。{wait}
		}
		TextWait
		TextClose 0
		_59
		TextSetPos -1 280 60 3
		VisSet vis[0] 3 0x00FFFFFF 500ms 0 0
		VisSet vis[0] 0 0 0 500ms 0
		VisWait vis[0] 3
		VisWait vis[0] 0
		Emote name[0] 0mm 2000mm 16 19 250ms 1
		SoundPlay sound[23] 0 100 0
		Emote name[1] 0mm 2000mm 16 19 250ms 1
		SoundPlay sound[23] 0 100 0
		Emote name[2] 0mm 2000mm 16 19 250ms 1
		SoundPlay sound[23] 0 100 0
		Emote name[3] 0mm 2000mm 16 19 250ms 1
		SoundPlay sound[23] 0 100 0
		Sleep 1000ms
		TextTalk name[0] {
			#11P#0003F……コホン。
			ええっと、確か……{wait}
		} {
			#0000F俺たちの実力を確かめるための
			趣向を用意しているという話でしたね。{wait}
		}
		TextWait
		TextTalk char[0] {
			#04000F#5Pよく覚えていたわね。{wait}
		} {
			#04011F#5P──アナタたち。
			よかったらテストを
			受けて見る気はない？{wait}
		}
		TextWait
	else:
		TextTalk char[0] {
			#04003F#5Pしかし『特務支援課』ねぇ……{wait}
		} {
			#04001F#5P警察内部のしがらみと
			ゴタゴタで生まれた部署って
			聞いたけど、本当なのかしら？{wait}
