fn[5]:
	TextStart self
	if flag[1792]:
		TextTalk self {
			日が落ちてきました……
			視界の悪い夕方は
			魔獣の危険度も増します。{wait}
		}
		TextWait
		TextTalk self {
			街道を歩くおつもりなら
			どうかお気をつけて。{wait}
		}
		TextWait
	elif flag[1566]:
		TextTalk self {
			本日は警備隊の方から
			曹長殿がいらっしゃっています。{wait}
		}
		TextWait
		TextTalk self {
			一体どのようなご用なのでしょうか……？{wait}
		}
		TextWait
	elif flag[1554]:
		TextTalk self {
			近頃、クロスベルがまた
			物騒になってきている気がします。{wait}
		}
		TextWait
		TextTalk self {
			日曜学校で子供たちを預かる大聖堂も、
			しかと用心しなければなりませんね。{wait}
		}
		TextWait
	elif flag[1536]:
		TextTalk self {
			こんにちは、
			クロスベル大聖堂へようこそ。{wait}
		}
		TextWait
		TextTalk self {
			本日は日曜学校が開かれています。
			授業の妨げにならないよう
			ご注意ください。{wait}
		}
		TextWait
	elif flag[1346]:
		TextTalk self {
			おや……もうお帰りでしょうか。{wait}
		}
		TextWait
		TextTalk self {
			またいつでもお越しください。
			皆様に女神の加護があらんことを……{wait}
		}
		TextWait
	elif flag[1342]:
		if !flag[0]:
			TextTalk self {
				こんにちは、
				クロスベル大聖堂へようこそ。{wait}
			}
			TextWait
			TextTalk name[82] {
				#1110Fこんにちはっ！　キーアだよ！{wait}
			}
			TextWait
			TextTalk self {
				はは……元気がよくて何よりです。{wait}
			}
			TextWait
			if flag[1123]:
				TextTalk name[0] {
					#0000Fえっと……マーブル先生は
					いらっしゃいますか？{wait}
				} {
					この子のことについて
					相談したいことがありまして……{wait}
				}
				TextWait
				TextTalk self {
					おや、そうでしたか。{wait}
				}
				TextWait
				TextTalk self {
					シスター・マーブルなら
					日曜学校の教室で
					雑務を行っておられますよ。{wait}
				}
				TextWait
				TextTalk name[0] {
					#0000Fあ、そうですか……
					ありがとうございます。{wait}
				}
				TextWait
				if flag[1356]:
					TextTalk name[1] {
						#0104Fほっ、良かった。
						先生はいらっしゃるみたいね。{wait}
					}
					TextWait
				elif flag[1357]:
					TextTalk name[2] {
						#0200F随分と熱心な方なんですね。{wait}
					}
					TextWait
				elif flag[1358]:
					TextTalk name[3] {
						#0300Fどうやら行き違いには
						ならなかったみてぇだな。{wait}
					}
					TextWait
				TextTalk name[0] {
					#0000F……よし、じゃあさっそく
					マーブル先生に会いに行くとしよう。{wait}
				}
				TextWait
				TextTalk name[82] {
					#1109Fごーっ！{wait}
				}
				TextWait
			FlagSet flag[0]
		elif flag[1123]:
			TextTalk self {
				シスター・マーブルなら
				日曜学校の教室で
				雑務を行っておられますよ。{wait}
			}
			TextWait
		else:
			TextTalk self {
				ふふ……子供は元気が一番です。{wait}
			}
			TextWait
	elif flag[1307]:
		if !flag[0]:
			TextTalk self {
				記念祭中は大聖堂内で
				ミサを執り行っています。{wait}
			}
			TextWait
			TextTalk self {
				今日で記念祭も終わり……
				気を引き締めておきましょう。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				今日で記念祭も終わり……
				気を引き締めて
				守衛にあたりたいと思います。{wait}
			}
			TextWait
	elif flag[1292]:
		TextTalk self {
			連日、記念祭は
			大盛況のようですね。{wait}
		}
		TextWait
		TextTalk self {
			これだけ人が多いと
			守衛も大変です。{wait}
		}
		TextWait
	elif flag[1282]:
		TextTalk self {
			記念祭中は大聖堂内で
			ミサを執り行っています。{wait}
		}
		TextWait
		TextTalk self {
			外国の方などもぽつぽつと
			訪れているようです。{wait}
		}
		TextWait
	elif flag[1280]:
		TextTalk self {
			記念祭中は大聖堂内で
			ミサを執り行っています。{wait}
		}
		TextWait
		TextTalk self {
			参加を希望されるなら
			ご自由にお通りください。{wait}
		}
		TextWait
		TextTalk self {
			児童の方には
			お菓子の配布などもしてますので
			よろしければどうぞ。{wait}
		}
		TextWait
	elif flag[1040]:
		TextTalk self {
			本日もお日柄良く、
			何事もなく終わりそうです。{wait}
		}
		TextWait
		TextTalk self {
			こんな日がいつまでも
			続くといいですね。{wait}
		}
		TextWait
	elif flag[1024]:
		if !flag[0]:
			TextTalk self {
				今日は講堂の方で
				日曜学校が開かれています。{wait}
			}
			TextWait
			TextTalk self {
				不審者が入らないよう
				注意しているのですが……{wait}
			}
			TextWait
			TextTalk self {
				あなた達は……
				警察の方のようですね。
				どうぞ、お通りください。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				子供たちを預かる身として
				守衛役は気を遣います。{wait}
			}
			TextWait
			TextTalk self {
				先日の狼騒動といい、
				物騒な事件が多いですからね。{wait}
			}
			TextWait
	elif flag[801]:
		if !flag[0]:
			TextTalk self {
				このクロスベル大聖堂では、
				教区長であるエラルダ大司教が
				七耀の教えを施しています。{wait}
			}
			TextWait
			TextTalk self {
				敷地内ではお静かにお願いします。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				敷地内ではお静かにお願いします。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[6]:
	TextStart self
	if flag[1792]:
		if !flag[1]:
			TextTalk self {
				私がシスターとしてここに就任して
				そろそろ半年近くがたちます。{wait}
			}
			TextWait
			TextTalk self {
				多くの市民や子供たちと
				出会えましたけど……{wait}
			}
			TextWait
			TextTalk self {
				シスター・マーブルと比べると
				どうしても未熟さがでてしまいます。{wait}
			}
			TextWait
			TextTalk self {
				いつか私も彼女のような
				立派なシスターになれるといいなぁ……{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				私がシスターとしてここに就任して
				そろそろ半年近くがたちます。{wait}
			}
			TextWait
			TextTalk self {
				いつか私もシスター・マーブルのような
				立派なシスターになれるといいなぁ……{wait}
			}
			TextWait
	elif flag[1566]:
		if !flag[1]:
			TextTalk self {
				今日来ている警備隊の方は
				プライベートでもよく
				お祈りに来られています。{wait}
			}
			TextWait
			TextTalk self {
				ノエルさんといいましたか……
				礼儀正しく心優しい方だと思いますよ。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				ノエルさんはプライベートでも
				よくお祈りに来られますよ。{wait}
			}
			TextWait
	elif flag[1554]:
		TextTalk self {
			タミル君とハミル君は
			よくここに遊びに来るんです。{wait}
		}
		TextWait
		TextTalk self {
			ええっと……
			あれ、どっちがどっちだったかしら……{wait}
		}
		TextWait
	elif flag[1536]:
		if !flag[1]:
			TextTalk self {
				今日は東通りの
				子供たちが来ているんですよ。{wait}
			}
			TextWait
			TextTalk self {
				……それにしても、今時の子たちは
				しっかりしていますよね。{wait}
			}
			TextWait
			TextTalk self {
				クータ君なんかはあの歳で、
				色んな店の安売り情報なんかに
				詳しいんですよ。{wait}
			}
			TextWait
			TextTalk self {
				安いお店を教えてもらいましたし
				あとで買出しに行こうかしら。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				今日は東通りの
				子供たちが来ているんですよ。{wait}
			}
			TextWait
			TextTalk self {
				今時の子はしっかりしていて、
				大人としての私の立場が
				危うい気がしますね……{wait}
			}
			TextWait
	elif flag[1346]:
		CharTurnToChar self name[82] 0deg/s
		if !flag[1]:
			TextTalk self {
				そういえば……
				あなたは日曜学校には
				通っていないのかしら？{wait}
			}
			TextWait
			TextTalk name[82] {
				#1111Fガッコー？
				キーアもそこにいくの？{wait}
			}
			TextWait
			TextTalk name[0] {
				#0003Fえ、えっと……
				説明が難しいんですが、
				この子には色々ありまして、今は……{wait}
			}
			TextWait
			TextTalk self {
				あ、いえ……
				立ち入った事を聞いてしまって
				すみません。{wait}
			}
			TextWait
			TextTalk self {
				でももし来れるようになったら……
				そのときは日曜学校においで下さいね。{wait}
			}
			TextWait
			TextTalk self {
				他の子供たちも、
				友達が増えたら喜ぶだろうし……{wait}
			}
			TextWait
			TextTalk name[82] {
				#1110Fうん、気がむいたらね～！{wait}
			}
			TextWait
			Emote name[0] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			if flag[1356]:
				Emote name[1] 0mm 2000mm 16 19 250ms 1
				SoundPlay sound[23] 0 100 0
			elif flag[1357]:
				Emote name[2] 0mm 2000mm 16 19 250ms 1
				SoundPlay sound[23] 0 100 0
			elif flag[1358]:
				Emote name[3] 0mm 2000mm 16 19 250ms 1
				SoundPlay sound[23] 0 100 0
			Emote self 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Sleep 1500ms
			FlagSet flag[1]
		else:
			TextTalk self {
				えっと……キーアちゃん。
				いつか日曜学校においで下さいね。{wait}
			}
			TextWait
			TextTalk self {
				私たち、歓迎しちゃいますから。{wait}
			}
			TextWait
	elif flag[1342]:
		if !flag[1]:
			CharTurnToChar self name[82] 0deg/s
			TextTalk self {
				……あら可愛らしい！
				ふふ、お名前はなんです？{wait}
			}
			TextWait
			TextTalk name[82] {
				#1110Fキーアの名前はキーアだよ！{wait}
			} {
				#1109F……あ、おねえさん、
				おもしろいかっこうしてるね～。{wait}
			}
			TextWait
			TextTalk self {
				そ、そう？
				一般的な修道女の服なのだけど……{wait}
			}
			TextWait
			TextTalk name[82] {
				#1111Fシュードー……ジョー？{wait}
			}
			TextWait
			TextTalk name[0] {
				#0003F（うーん、七耀教会の事は
				{}  ほとんど知らないのか……？）{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				面白い格好……面白い格好……
				そうなのかしら……{wait}
			}
			TextWait
			TextTalk self {
				もしかして……
				子どもになめられる要因は
				この、服に……？{wait}
			}
			TextWait
			Emote name[0] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			if flag[1356]:
				Emote name[1] 0mm 2000mm 16 19 250ms 1
				SoundPlay sound[23] 0 100 0
			elif flag[1357]:
				Emote name[2] 0mm 2000mm 16 19 250ms 1
				SoundPlay sound[23] 0 100 0
			elif flag[1358]:
				Emote name[3] 0mm 2000mm 16 19 250ms 1
				SoundPlay sound[23] 0 100 0
			Sleep 1000ms
			TextTalk name[0] {
				#0006Fあ、あの……子どもの言う事ですし
				深く考えない方がいいと思いますよ。{wait}
			}
			TextWait
	elif flag[1307]:
		if !flag[1]:
			TextTalk self {
				噂で聞きました。
				街で小さい子供が迷子になっていたとか……{wait}
			}
			TextWait
			TextTalk self {
				皆さんがそれを助ける為に
				動き回っているのを
				沢山の人が見ていたらしくって。{wait}
			}
			TextWait
			TextTalk self {
				ふふ、お手柄でしたね。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				昨日はお手柄でしたね。
				こんな広い自治州から
				迷子の子供を見つけてしまうなんて。{wait}
			}
			TextWait
	elif flag[1292]:
		if !flag[1]:
			TextTalk self {
				私、子供になめられやすくて。
