							#0003F（東通りの市場……
							{}  落し物をしたトロントさんが
							{}  立ち寄っていた場所だな。）{wait}
						}
						TextWait
						FlagSet flag[17]
					TextTalk name[0] {
						#0000Fすみません、この辺りで
						落し物を見かけませんでしたか？{wait}
					}
					TextWait
					TextTalk self {
						落し物ッスか……？{wait}
					}
					TextWait
					TextTalk self {
						いんや、見てないッスね。{wait}
					}
					TextWait
