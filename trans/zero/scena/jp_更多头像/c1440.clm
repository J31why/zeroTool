fn[13]:
	TextStart self
	if flag[2]:
		TextTalk char[2] {
			ふう……
			旧市街の子供たちに教えるのは
			いつも一筋縄ではいきません。{wait}
		}
		TextWait
	else:
		TextTalk char[2] {
			ジンゴちゃんにも日曜学校に
			参加してもらいたいのですが、
			いつも追い返されてしまうのです。{wait}
		}
		TextWait
		TextTalk char[2] {
			なんとかアシュリーさんにも
			ご理解頂ければいいのですけれど……{wait}
		}
		TextWait
		FlagSet flag[2]
	TextEnd self
	Return

fn[14]:
