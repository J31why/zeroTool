fn[14]:
	TextStart self
	if flag[1307]:
		TextTalk self {
			あらいけない、今日で
			スタンプラリーが終わりじゃない。{wait}
		}
		TextWait
		TextTalk self {
			急いで景品交換
			してもらわなくっちゃ。{wait}
		}
		TextWait
	elif flag[1362]:
		TextTalk self {
			今年のパレードは凄かったわねー。{wait}
		}
		TextWait
		TextTalk self {
			手を振ってた子供達も
			可愛かったわ～。{wait}
		}
		TextWait
	elif flag[1292]:
		TextTalk self {
			買い物ついでに
			出店を回ってしまったわ。{wait}
		}
		TextWait
		TextTalk self {
			ふう……いけないいけない。
			家族には内緒にしておきましょ。{wait}
		}
		TextWait
	elif flag[1282]:
		if !flag[4]:
			TextTalk self {
				今年はアルモリカ村の方に
				行く人もいるみたいね。{wait}
			}
			TextWait
			TextTalk self {
				確かにきれいな所だし……
				何より美味しい料理が食べれるものね。{wait}
			}
			TextWait
			FlagSet flag[4]
		else:
			TextTalk self {
				アルモリカ村はきれいな所だし
				美味しい料理が食べれるもの。{wait}
			}
			TextWait
			TextTalk self {
				観光客が立ち寄るのも
				判る気がするわね。{wait}
			}
			TextWait
	elif flag[1280]:
		TextTalk self {
			記念祭の間も
			休めないのが主婦業よね。{wait}
		}
		TextWait
		TextTalk self {
			夕飯の材料だけは
			買っておかなくちゃ。{wait}
		}
		TextWait
	TextEnd self
	Return

