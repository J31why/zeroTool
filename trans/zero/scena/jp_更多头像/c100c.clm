fn[11]:
	if flag[13]:
		TextTalk char[3] {
			クロスベル産の魚も人気があるんだが
			仕入れ先が少なくてね。
			いつも品薄気味なんだよ。{wait}
		}
		TextWait
		TextTalk char[3] {
			あんた達の持ってる魚は
			中々質が良さそうだ。{wait}
		}
		TextWait
		TextTalk char[3] {
			良ければあたしの店に卸しておくれよ。
			多少のお礼はするよ。{wait}
		}
		TextWait
	elif flag[1307]:
		TextTalk char[3] {
			今日はいつもの
			５倍仕入れたんだよ。{wait}
		}
		TextWait
		TextTalk char[3] {
			何とか売り切ってやらなくちゃ。{wait}
		}
		TextWait
	elif flag[1362]:
		TextTalk char[3] {
			今年の売れ行きはすごいわねえ。{wait}
		}
		TextWait
		TextTalk char[3] {
			後で亭主に自慢してやらなくちゃ。{wait}
		}
		TextWait
	elif flag[1292]:
		TextTalk char[3] {
			はいよ、いらっしゃ～い！{wait}
		}
		TextWait
		TextTalk char[3] {
			記念祭の見所は
			パレードだけじゃないよ。{wait}
		}
		TextWait
		TextTalk char[3] {
			露店街の店も
			しっかり見ていっておくれ～っ！{wait}
		}
		TextWait
	elif flag[1282]:
		TextTalk char[3] {
			はいよ、いらっしゃ～い！
			朝の採れたて、新鮮だよ～っ！{wait}
		}
		TextWait
		TextTalk char[3] {
			ささっとゴハンに盛り付けて
			醤油をたらすと絶品だよっ！{wait}
		}
		TextWait
	elif flag[1280]:
		if !flag[3]:
			TextTalk char[3] {
				はいよ、いらっしゃ～い！{wait}
			}
			TextWait
			TextTalk char[3] {
				こっちのお魚なんていかが？{wait}
			}
			TextWait
			TextTalk char[3] {
				そこの龍老飯店に持ち込めば
				さくっとお刺身にしてくれるよっ！{wait}
			}
			TextWait
			FlagSet flag[3]
		else:
			TextTalk char[3] {
				東通りの宿は
