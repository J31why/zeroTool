fn[7]:
	TextStart self
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"話をする" // 0
			"買い物をする" // 1
			"やめる" // 2
		MenuWait var[0]
		if var[0] != 1:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			ShopOpen shop[57]
			var[0] = 99
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			if flag[1307]:
				if !flag[0]:
					TextTalk self {
						……ふう、申し訳ないッス。{wait}
					}
					TextWait
					TextTalk self {
						７０周年記念のグッズは
						すべて売り切れたんスよ。{wait}
					}
					TextWait
					Emote self 0mm 2000mm 8 9 250ms 2
					SoundPlay sound[27] 0 100 0
					Sleep 1500ms
					TextTalk self {
						いやあ、売れたッスねぇ～！
						こんな売り上げは初めてッスよ～！{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk self {
						……ふう、申し訳ないッス。
						記念グッズは売り切れたッスよ。{wait}
					}
					TextWait
					TextTalk self {
						ふふふ、頑張って
						作ったかいがあったッス。{wait}
					}
					TextWait
			elif flag[1362]:
				TextTalk self {
					子供達に風車が
					たくさん売れたッス。{wait}
				}
				TextWait
				TextTalk self {
					子供って
					ああいうのが好きなんスね。
					勉強になったッス。{wait}
				}
				TextWait
			elif flag[1292]:
				TextTalk self {
					なんだか
					人が集まってるッスよ。{wait}
				}
				TextWait
				TextTalk self {
					売り込みのチャンスッスね！{wait}
				}
				TextWait
			elif flag[1282]:
				TextTalk self {
					……いやあ
					記念祭は凄い人出ッス。{wait}
				}
				TextWait
				TextTalk self {
					記念グッズが飛ぶように
					売れていくッスよ。{wait}
				}
				TextWait
			elif flag[1280]:
				if !flag[0]:
					TextTalk self {
						#4Sヘイ、らっしゃ～い！{wait}
					}
					TextWait
					TextTalk self {
						いかがッスか、
						こちら７０周年記念の
						グッズっスよ～っ！{wait}
					}
					TextWait
					TextTalk self {
						傘たてに卓上時計、
						シガレットケースもあるッス！{wait}
					}
					TextWait
					TextTalk self {
						クロスベル市庁舎の模型は
						一品限りの早い者勝ちッスぅ！！{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk self {
						７０周年記念の
						グッズはいかがっスか～っ！{wait}
					}
					TextWait
	TextEnd self
	Return

