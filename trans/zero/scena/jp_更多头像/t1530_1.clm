calmare zero_k scena
scena:
	name "t1530" "t1530" "t1530_1"
	town town[79]
	bgm bgm[123]
	flags 8192
	item_use fn[0,255]
	unk 255 0

entry:
	pos (0, 0, -1000)
	unk1 0
	cam_from (0, 2500, 34000)
	cam_pers 262
	unk2 30
	cam_deg 45deg
	cam_limit 0deg 360deg
	cam_at (0, 0, 0)
	unk3 0
	unk4 0
	flags 0x0001
	town town[79]
	init fn[0,255]
	reinit fn[0,255]

// NB: this line is meaningless, it's just here for roundtripping.
label blank

fn[0]:
	Call fn[1,1]
	Return

fn[1]:
	if flag[783] && !flag[784]:
		Call fn[0,9]
	elif flag[1562] && !flag[1563]:
		Call fn[0,14]
	elif QuestFlagsGet quest[22] 0x02 && !QuestTaskGet quest[22] 0:
		Call fn[1,76]
	else:
		TextStart char[0]
		if flag[1566]:
			if !flag[0]:
				TextTalk char[0] {
					今朝方、黒月貿易公司の方々が
					退院されていきました。{wait}
				}
				TextWait
				TextTalk char[0] {
					まだ完治されていなかったのですが
					歩けるからと無理矢理に……{wait}
				}
				TextWait
				if PartyPosition name[9] != -1:
					TextTalk name[9] {
						#0603Fフン……さすがツァオの部下か。
						なかなかタフに出来ているようだな。{wait}
					}
					TextWait
				FlagSet flag[0]
			else:
				TextTalk char[0] {
					今朝方、黒月貿易公司の方々が
					退院されていきました。{wait}
				}
				TextWait
				TextTalk char[0] {
					銃を受けた傷もあるので
					お止めしたかったんですけどね……{wait}
				}
				TextWait
		elif flag[1565]:
			TextTalk char[0] {
				ヨアヒム先生とお話できたようで
				なによりでした。{wait}
			}
			TextWait
			TextTalk char[0] {
				またいつでもいらっしゃってくださいね。{wait}
			}
			TextWait
		elif flag[1554]:
			TextTalk char[0] {
				ヨアヒム先生が研究棟４階の
				研究室でお待ちです。{wait}
			}
			TextWait
			TextTalk char[0] {
				……サボリに行かないうちに
				向かった方がよろしいかと思いますよ。{wait}
			}
			TextWait
		elif flag[1536]:
			if !flag[1733]:
				TextTalk char[0] {
					聖ウルスラ病院へようこそ。
					本日はどういったご用件でしょう？{wait}
				}
				TextWait
				TextTalk name[8] {
					#0500Fウルスラ病院に来るのは
					結構久しぶりですね。{wait}
				} {
					例の狼魔獣の事件以来、この辺りには
					巡回に来る程度でしたし。{wait}
				}
				TextWait
				TextTalk name[0] {
					#0000Fはは、こう言っちゃなんだけど
					曹長は病気になんかかからなそうだしな。{wait}
				}
				TextWait
				TextTalk name[8] {
					#0504Fええ、もちろんですよ。{wait}
				} {
					#0500F警備隊に入ってからは
					小さな病気もしないように
					体調管理には気を遣ってますし。{wait}
				}
				TextWait
				TextTalk char[0] {
					ふふ、素晴らしいことですね。
					一番大事なのは病院に
					かからないようにすることですから。{wait}
				}
				TextWait
				TextTalk char[0] {
					でも、何かあったらすぐご相談くださいね。
					個人じゃどうにも出来ないことも
					あると思いますから。{wait}
				}
				TextWait
				FlagSet flag[1733]
			else:
				TextTalk char[0] {
					一番大事なのは病院にかからないよう
					健康管理をすることだと思います。{wait}
				}
				TextWait
				TextTalk char[0] {
					ふふ、そちらの警備隊員さんの心がけは
					素晴らしいことだと思いますよ。{wait}
				}
				TextWait
		elif flag[1351]:
			Call fn[1,26]
		elif flag[1346]:
			TextTalk char[0] {
				ヨアヒム先生の研究室は
				研究棟の４階にありますよ。{wait}
			}
			TextWait
			TextTalk char[0] {
				病棟の屋上に出れば
				研究棟の場所はすぐ分かるはずです。{wait}
			}
			TextWait
		elif flag[1307]:
			if !flag[0]:
				TextTalk char[0] {
					ようこそ、ウルスラ病院へ。{wait}
				}
				TextWait
				TextTalk char[0] {
					本日、教授の方々は
					教授会のため出張となっております。{wait}
				}
				TextWait
				TextTalk char[0] {
					担当の先生をお確かめの上
					診察手続きをお願いします。{wait}
				}
				TextWait
				FlagSet flag[0]
			else:
				TextTalk char[0] {
					本日、教授の方々は
					教授会のため出張となっております。{wait}
				}
				TextWait
				TextTalk char[0] {
					担当の先生をお確かめの上
					診察手続きをお願いします。{wait}
				}
				TextWait
		elif flag[1292]:
			if !flag[0]:
				TextTalk char[0] {
					今日は観光客の方が
					診察を受けに来ているようです。{wait}
				}
				TextWait
				TextTalk char[0] {
					最先端の医療を体験したい気持ちは
					分かる気がするんですが……{wait}
				}
				TextWait
				TextTalk char[0] {
					それで具合の悪い患者さんの
					診察順が遅くなるのは
					なにか違う気がしますね。{wait}
				}
				TextWait
				FlagSet flag[0]
			else:
				TextTalk char[0] {
					健康診断などをしに
					観光客の方が来ているみたいです。{wait}
				}
				TextWait
				TextTalk char[0] {
					……外来として来ている以上
					無下にはしませんけど……
					動機を知るとなんだか複雑です。{wait}
				}
				TextWait
		elif flag[1282]:
			CharTurnTo char[0] 266deg 0deg/s
			_Char4A char[15] 255
			TextTalk char[0] {
				まぁ、ディーター総裁……{wait}
			}
			TextWait
			TextTalk char[0] {
				今年もお越しいただいて
				本当にありがとうございます。{wait}
			}
			TextWait
			TextTalk char[0] {
				きっと患者の皆様も喜ばれますわ。{wait}
			}
			TextWait
			TextTalk char[15] {
				#2804Fなに、気にしないでくれたまえ。{wait}
			} {
				私の個人的な我が侭なのだからね。{wait}
			}
			TextWait
			_Char4B char[15] 255
		elif flag[1280]:
			if QuestFlagsGet quest[22] 0x10 && !flag[0]:
				TextTalk char[0] {
					セシルさんたち看護師の方は、
					うまく分担して休暇を取ったとか。{wait}
				}
				TextWait
				TextTalk char[0] {
					うらやましいです。
					事務方は人が少ないですから
					なかなか休めないんですよ。{wait}
				}
				TextWait
			elif QuestFlagsGet quest[22] 0x10:
				TextTalk char[0] {
					またなにかあったら
					病院にお越しくださいね。{wait}
				}
				TextWait
				TextTalk char[0] {
					誠意を以って
					対応させていただきますから。{wait}
				}
				TextWait
			elif QuestTaskGet quest[22] 0:
				TextTalk char[0] {
					ヨアヒム先生に
					早く戻っていただかないと……{wait}
				}
				TextWait
				TextTalk char[0] {
					皆さん、どうかよろしくお願いします。{wait}
				}
				TextWait
			elif QuestFlagsGet quest[22] 0x02:
		elif flag[1040]:
			if !flag[0]:
				TextTalk char[0] {
					職員寮のキルシュ寮長や
					マローネさんもクラーク事務長の
					部下にあたるんですが……{wait}
				}
				TextWait
				TextTalk char[0] {
					ここだけの話、事務長は
					キルシュ寮長には
					頭が上がらないそうです。{wait}
				}
				TextWait
				FlagSet flag[0]
			else:
				TextTalk char[0] {
					ここだけの話、クラーク事務長は
					キルシュ寮長には
					頭が上がらないそうです。{wait}
				}
				TextWait
		elif flag[1024]:
			if !flag[0]:
				TextTalk char[0] {
					院長は主に各国を渡り歩いて
					技術交流や人材発掘をしているので
					なかなか病院にいらっしゃらないんです。{wait}
				}
				TextWait
				TextTalk char[0] {
					実は、かく言う私も
					お会いしたことがなくて……
					どんな方なんでしょうね。{wait}
				}
				TextWait
				FlagSet flag[0]
			else:
				TextTalk char[0] {
					院長はとても忙しい方ですから、
					なかなか病院に
					いらっしゃらないんです。{wait}
				}
				TextWait
				TextTalk char[0] {
					実質、病院の経営は教授たちに
					任されていることになりますね。{wait}
				}
				TextWait
		elif flag[799]:
			TextTalk char[0] {
				本日の外来受付は終了しました。{wait}
			}
			TextWait
			TextTalk char[0] {
				遅い時間になると物騒です、
				お見舞いの方はお急ぎください。{wait}
			}
			TextWait
		elif flag[793]:
			TextTalk char[0] {
				夕方が近づいて、外来のお客様も、
				少しずつはけてきました。{wait}
			}
			TextWait
			TextTalk char[0] {
				リットンさんのこともありますし、
				暗くならないうちに
				皆さんが帰れるようにしないと。{wait}
			}
			TextWait
		elif flag[784]:
			if !flag[0]:
				TextTalk char[0] {
					……あの、セシルさん。{wait}
				}
				TextWait
				TextTalk char[0] {
					一応職場ですし、
					人前でああいうスキンシップは
					慎んだ方がいいと思いますよ。{wait}
				}
				TextWait
				TextTalk name[0] {
					#0006F……面目ないです。{wait}
				}
				TextWait
				TextTalk name[53] {
					#1305Fあら、ロイドが謝ることは
					ないでしょう？{wait}
				} {
					#1309Fふふ……セラさん、
					うらやましいんでしょ？
					私にこーんな可愛い弟がいて。{wait}
				}
				TextWait
				TextTalk char[0] {
					はぁ……もう好きにしてください。{wait}
				}
				TextWait
				FlagSet flag[0]
			else:
				TextTalk char[0] {
					……もう止めませんので
					抱き合うなりなんなり
					好きにすればいいと思いますよ。{wait}
				}
				TextWait
				TextTalk name[0] {
					#0006F（呆れられてる……）{wait}
				}
				TextWait
		elif flag[777]:
		TextEnd char[0]
	Return

fn[2]:
	Call fn[1,3]
	Return

fn[3]:
	TextStart char[1]
	if flag[1566]:
		TextTalk char[1] {
			病院長が不在の中ですが
			経営状態は非常に良好と言えます。{wait}
		}
		TextWait
		TextTalk char[1] {
			これもひとえに、長年で培われた
			病院への信頼のお陰でしょうね。{wait}
		}
		TextWait
	elif flag[1565]:
		TextTalk char[1] {
			受付に病院内の連絡係など、
			セラくんはよく働いてくれています。{wait}
		}
		TextWait
		TextTalk char[1] {
			単純な仕事量ならセシルさんにも
			ひけをとらないんじゃないでしょうか。{wait}
		}
		TextWait
	elif flag[1554]:
		TextTalk char[1] {
			運ばれてきた患者は必ず助けるのが
			ウルスラ病院のモットーです。{wait}
		}
		TextWait
		TextTalk char[1] {
			たとえ極悪人が相手でも
			それは変わりませんよ。{wait}
		}
		TextWait
	elif flag[1536]:
		TextTalk char[1] {
			当病院は各国各機関から
			資金を受けていますが、
			経営方針は実に倹約的です。{wait}
		}
		TextWait
		TextTalk char[1] {
			そうした資金はできるだけ、
			通常診察を受けられない方に
			使われるようにしてあるのですよ。{wait}
		}
		TextWait
	elif flag[1351]:
		TextTalk char[1] {
			この病院に勤めている以上、
			私たち事務もやり方は違えど
			患者さんを助ける為に動いています。{wait}
		}
		TextWait
		TextTalk char[1] {
			患者さんたちが笑顔で退院されると
			幸せな気持ちになりますよ。{wait}
		}
		TextWait
	elif flag[1346]:
		TextTalk char[1] {
			教授たちは研修医への指導と研究、
			回診の仕事を兼ねていますから
			お忙しい方ばかりなのですよ。{wait}
		}
		TextWait
		TextTalk char[1] {
			ヨアヒム先生を見ていると
			そうは見えないんですけどね。{wait}
		}
		TextWait
	elif flag[1307]:
		if !flag[1]:
			TextTalk char[1] {
				私はこの病院の事務全般を
				統括しているのです。{wait}
			}
			TextWait
			TextTalk char[1] {
				設備への予算分配から
				導力ネットワークの整備まで……{wait}
			}
			TextWait
			TextTalk char[1] {
				仕事が多くてなかなか大変ですが
				やりがいはありますよ。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk char[1] {
				特に、導力ネットの整備が大変なのです。
				病院には私以外に操作できる方が
				いらっしゃいませんから。{wait}
			}
			TextWait
			TextTalk char[1] {
				できればクロスベル市のほうから
				技師の一人でも回して欲しい所です。{wait}
			}
			TextWait
	elif flag[1292]:
		CharTurnTo char[1] 180deg 0deg/s
		CharTurnTo char[58] 15deg 0deg/s
		_Char4A char[58] 255
		TextTalk char[1] {
			健康診断をご希望ですか？
			それでは、こちらの書類に
			サインをお願いします。{wait}
		}
		TextWait
		TextTalk char[1] {
			初診ですので
			お時間頂くと思いますが
			お待ちいただいても？{wait}
		}
		TextWait
		TextTalk char[58] {
			ああ、構わないよ。{wait}
		}
		TextWait
		_Char4B char[58] 255
	elif flag[1282]:
		TextTalk char[1] {
			毎年、ディーター総裁には
			入院患者全員に行き渡るほどの
			プレゼントを寄贈して頂いています。{wait}
		}
		TextWait
		TextTalk char[1] {
			いやはや、本当に出来たお方ですよ。{wait}
		}
		TextWait
	elif flag[1280]:
		if !flag[1]:
			TextTalk char[1] {
				受付にカード制度を導入するか
				検討しているのです。{wait}
			}
			TextWait
			TextTalk char[1] {
				事前に個人情報を登録した
				カードキーを用意して、
				受付の手間を削減するものです。{wait}
			}
			TextWait
			TextTalk char[1] {
				ただ、カードの量産体制や
				個人情報の保護などの問題もありますから
				開発が難航しているんですよ。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk char[1] {
				受付にカード制度を導入するか
				検討しているのです。{wait}
			}
			TextWait
			TextTalk char[1] {
				ただ、こちらはなかなか
				開発が難航していまして……
				当分先の話になりそうですな。{wait}
			}
			TextWait
	elif flag[1040]:
		if !flag[1]:
			TextTalk char[1] {
				寮の食堂で昼食を食べていたら
				職員が昼時に来るなと
				叩き出されてしまいました。{wait}
			}
			TextWait
			TextTalk char[1] {
				いやはや……
				キルシュ寮長には
				頭が上がりません。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk char[1] {
				いやはや……
				キルシュ寮長には
				頭が上がりません。{wait}
			}
			TextWait
			TextTalk char[1] {
				……女性は強し、ですね。{wait}
			}
			TextWait
	elif flag[1024]:
		if !flag[1]:
			TextTalk char[1] {
				ウルスラ病院は導力ネットワークで
				クロスベル市と繋がっています。{wait}
			}
			TextWait
			TextTalk char[1] {
				試験的にではあるんですが
				導力ネットワークを使った
				予約サービスなどもあります。{wait}
			}
			TextWait
			TextTalk char[1] {
				ただ、普及率の問題で
				あまり活用されていないですけどね。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk char[1] {
				導力ネットワークでの
				事前予約サービスを使えば、
				待ち時間なくスムーズに診察できます。{wait}
			}
			TextWait
			TextTalk char[1] {
				ただ、普及率の問題で
				あまり活用されていないですけどね。{wait}
			}
			TextWait
	elif flag[799]:
		TextTalk char[1] {
			警察の皆様……
			フェンスの設置にご協力
			ありがとうございました。{wait}
		}
		TextWait
		TextTalk char[1] {
			これで魔獣が入り込むようなことが
			なくなればいいのですが……{wait}
		}
		TextWait
	elif flag[793]:
		TextTalk char[1] {
			警察の皆様……
			何か捜査に進展はありましたか？{wait}
		}
		TextWait
	elif flag[784]:
		TextTalk char[1] {
			病院施設に魔獣が入ることなど
			信じたくはありませんが……
			本当だとしたら由々しき事態です。{wait}
		}
		TextWait
		TextTalk char[1] {
			リットン君が魔獣に襲われた証拠を
			押さえてほしいと思います。{wait}
		}
		TextWait
	elif flag[777]:
		TextTalk char[1] {
			聖ウルスラ医科大学病院へ
			ようこそいらっしゃいました。{wait}
		}
		TextWait
		TextTalk char[1] {
			受付はもう一方のカウンターで
			承っております。
			そちらをご利用くださいませ。{wait}
		}
		TextWait
	TextEnd char[1]
	Return

fn[4]:
	TextStart self
	if flag[1566]:
		CharTurnToChar self char[52] 0deg/s
		TextTalk self {
			あら、今日はどういったご用件でしょう。{wait}
		}
		TextWait
		TextTalk self {
			初診の方は、一旦受付で
			手続きをお願いしますね。{wait}
		}
		TextWait
	elif flag[1565]:
		TextTalk self {
			運び込まれた人は、
			今はＩＣＵ横の病室で休んでいるわ。{wait}
		}
		TextWait
		TextTalk self {
			命に別状はないし、
			明日にも歩けるようになるそうよ。{wait}
		}
		TextWait
	elif flag[1554]:
		TextTalk self {
			今日運び込まれた患者さん、
			とりあえず一命はとりとめたみたい。{wait}
		}
		TextWait
		TextTalk self {
			……怪我の様子があきらかに
			銃や殴打によるものみたいだから
			どうにもキナ臭いんだけどね……{wait}
		}
		TextWait
	elif flag[1536]:
		CharTurnToChar self char[45] 0deg/s
		TextTalk self {
			あらボク、大丈夫？
			けっこう熱があるみたいね……{wait}
		}
