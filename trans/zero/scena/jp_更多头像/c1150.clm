fn[44]:
	var[1] = 1
	while var[1] != 255:
		if flag[11] && flag[12] && flag[13] && flag[14]:
			Menu menu[1] -1 -1 0
				"【支援要請とは？】" // 0
				"【どこでチェックするの？】" // 1
				"【報告はどうすればいいの？】" // 2
				"【捜査官のランクって？】" // 3
				"特に聞きたいことはない" // 4
			MenuWait var[1]
		else:
			Menu menu[1] -1 -1 0
				"【支援要請とは？】" // 0
				"【どこでチェックするの？】" // 1
				"【報告はどうすればいいの？】" // 2
				"【捜査官のランクって？】" // 3
			MenuWait var[1]
		MenuClose menu[1]
		if !QuestFlagsGet quest[1] 0x10:
			FadeIn 300ms 0x00000000
			FadeWait
		elif var[1] != 4:
			FadeIn 300ms 0x00000000
			FadeWait
		switch var[1]:
			case 0:
				TextTalk char[0] {
					#5P特務支援課に届けられる
					各方面からの様々な“依頼”です。{wait}
				}
				TextWait
				TextTalk char[0] {
					#5P簡単な手伝いから本格的な捜査、
					魔獣退治など、様々なタイプの依頼が
					来るのではないかと思われます。{wait}
				}
				TextWait
				TextTalk char[0] {
					#5P一部の例外を除いて、
					実際に引き受けるかどうかは
					皆さんにお任せしますが……{wait}
				}
				TextWait
				TextTalk char[0] {
					#5P期限内に達成しないと消滅するので
					それだけは注意してください。{wait}
				}
				TextWait
				FlagSet flag[11]
				break
			case 1:
				TextTalk char[0] {
					#5P現在引き受けられる支援要請は、
					特務支援課の端末で
					チェックすることができます。{wait}
				}
				TextWait
				TextTalk char[0] {
					#5P一度チェックすれば、
					捜査手帳にも記録されるので
					そちらも確認してみてください。{wait}
				}
				TextWait
				TextTalk char[0] {
					#5Pなお、支援要請の追加更新は
					１日１回を目安にしています。{wait}
				}
				TextWait
				TextTalk char[0] {
					#5P日付が変わったら支援課の端末を
					確認してみるのをお勧めします。{wait}
				}
				TextWait
				FlagSet flag[12]
				break
			case 2:
				TextTalk char[0] {
					#5P支援要請を“達成”したら
					特務支援課の端末から
					『報告』を行ってください。{wait}
				}
				TextWait
				TextTalk char[0] {
					#5P導力ネットワークを通じて
					すぐに査定させていただきます。{wait}
				}
				TextWait
				TextTalk char[0] {
					#5P内容に応じた特別手当なども
					出ますので、こまめに報告されると
					よろしいかと思います。{wait}
				}
				TextWait
				FlagSet flag[13]
				break
			case 3:
				TextTalk char[0] {
					#5P通常の捜査任務をこなしたり
					支援要請を達成していくことで
					皆さんの実績は上がっていきます。{wait}
				}
				TextWait
				TextTalk char[0] {
					#5Pこれを『ＤＰ（捜査ポイント）』といい、
					各任務や支援要請でどう行動したかで
					ボーナスが付くこともあります。{wait}
				}
				TextWait
				TextTalk char[0] {
					#5P──ＤＰが規定値に達したところで
					『捜査官ランク』が上がります。{wait}
				}
				TextWait
				TextTalk char[0] {
					#5P現状でランクは１５段階あり、
					ランクアップごとに特典もあるので
					頑張る価値はあると思います。{wait}
				}
				TextWait
				FlagSet flag[14]
				break
			case 4:
				var[1] = 255
				break
			default:
				break
		if var[1] != 255:
			FadeOut 300ms 0x00000000 100
			FadeWait
	var[1] = 0
	Return

