	if !flag[9]:
		TextTalk name[0] {
			#0000Fっと、そうだ……{wait}
		}
		TextWait
		TextTalk name[3] {
			#0300Fん、どうしたんだ？{wait}
		}
		TextWait
		TextTalk name[0] {
			#0000Fいや、実は西通りにオスカーって
			幼馴染が居てさ、
			一度顔を出すって約束してたんだ。{wait}
		} {
			ついでだし
			寄って来てもいいかな？{wait}
		}
		TextWait
		TextTalk name[1] {
			#0100Fええ、そのくらいなら
			いいんじゃない？{wait}
		}
		TextWait
		TextTalk name[2] {
			#0200Fこの近くなんですか？{wait}
		}
		TextWait
		TextTalk name[0] {
			#0000Fああ、モルジュっていう
			パン屋に勤めてるはずなんだ。{wait}
		} {
			大通りに面してるって
			言ってたけど……
			どの辺りなのかな。{wait}
		}
		TextWait
