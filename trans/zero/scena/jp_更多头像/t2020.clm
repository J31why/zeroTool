fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharWalkToPos self (-890, 0, 5100) 2000mm/s 0
		CharWalkToPos self (12780, 0, 5100) 2000mm/s 0
		CharWalkToPos self (12780, 0, 3300) 2000mm/s 0
		CharWalkToPos self (860, 0, 3300) 2000mm/s 0
		CharWalkToPos self (860, 0, -10930) 2000mm/s 0
		CharWalkToPos self (-890, 0, -10930) 2000mm/s 0
	Return

fn[2]:
	while 1:
		CharIdle self (39330, null, -31860) (42170, null, -29120) 1000mm/s
		Sleep 300ms
	Return

fn[3]:
	ED7_76_0 object[255] "main03" 1
	if flag[1536]:
		ED7_76_1 object[255] "main03" 1
	if flag[1282] && !flag[1536]:
		CharSetPos char[0] (-40640, 0, 1570) 135deg
	elif flag[1280] && !flag[1282]:
		if QuestFlagsGet quest[25] 0x10:
			CharFlagsSet char[0] 0x0080
		elif QuestFlagsGet quest[25] 0x02:
			CharSetPos char[0] (-35130, 0, 4170) 0deg
			CharFlagsSet char[0] 0x0010
		else:
			CharSetPos char[0] (-40640, 0, 1570) 135deg
	else:
	if flag[1280] && !flag[1536]:
		CharFlagsSet char[1] 0x0080
	if !flag[1280] && system[0] == 106 && !flag[895]:
		Event fn[0,12]
	Return

fn[4]:
	Return

fn[5]:
	CharTurnToChar self name[3] 0deg/s
	TextTalk self {
		#07911Fあ……あなた、ランディじゃないの！{wait}
	}
	TextWait
	TextTalk name[3] {
		#0300Fおお、ミレイユ曹長殿じゃねーか。
		元気にしてたか？{wait}
	}
	TextWait
	TextTalk self {
		#07906Fあ、あいかわらず礼儀のない……{wait}
	} {
		#07901Fそれに、今は昇級して准尉なの！
		気安く呼びかけないでくれる？{wait}
	}
	TextWait
	TextTalk name[3] {
		#0300Fハハ、そうだったか。
		悪い悪い。{wait}
	} {
		#0304Fでもまぁ……
		俺はもう警備隊は抜けたし、
		階級なんてぶっちゃけ関係ねぇよ。{wait}
	} {
		#0309Fこれからも気安く呼ばせてもらうぜ、
		ミレイユ准尉殿。{wait}
	}
	TextWait
	TextTalk self {
		#07913F……もう！！
		勝手にしなさい！！{wait}
	}
	TextWait
	FlagSet flag[1121]
	Return

