fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharWalkToPos self (-13830, 10000, -2960) 2000mm/s 0
		CharTurnTo self 270deg 400deg/s
		Sleep 2000ms
		CharTurnTo self 0deg 400deg/s
		Sleep 100ms
		CharWalkToPos self (-14060, 10000, 2900) 2000mm/s 0
		CharTurnTo self 270deg 400deg/s
		Sleep 2000ms
		CharTurnTo self 180deg 400deg/s
		Sleep 100ms
	Return

fn[2]:
	if !flag[1040] && flag[1031]:
		CharFlagsUnset char[2] 0x0080
		CharFlagsUnset char[3] 0x0080
	if flag[1280] && !flag[1536]:
		CharFlagsUnset char[0] 0x0080
	else:
		ForkFunc char[1] fork[0] fn[0,1]
	if flag[1282] && !flag[1292]:
		CharSetPos char[0] (-8560, 5000, -19100) 175deg
		ForkFunc char[1] fork[0] fn[0,1]
	elif flag[1280] && !flag[1282]:
		if system[0] == 103 && QuestTaskGet quest[25] 4 && !QuestTaskGet quest[25] 5:
			Event fn[0,10]
	if flag[1280] && !flag[1536]:
		CharFlagsUnset char[4] 0x0080
	Return

fn[3]:
	LookPointFlagsSet look_point[0] 0x0001
	LookPointFlagsSet look_point[1] 0x0001
	LookPointFlagsSet look_point[2] 0x0001
	LookPointFlagsSet look_point[3] 0x0001
	LookPointFlagsSet look_point[4] 0x0001
	if flag[1280] && !flag[1282]:
		if QuestTaskGet quest[25] 6 && QuestTaskGet quest[25] 7 && QuestTaskGet quest[25] 8 && QuestTaskGet quest[25] 9 && !QuestFlagsGet quest[25] 0x10:
			LookPointFlagsUnset look_point[4] 0x0001
		elif QuestTaskGet quest[25] 5:
			if !QuestTaskGet quest[25] 6:
				LookPointFlagsUnset look_point[0] 0x0001
			if !QuestTaskGet quest[25] 7:
				LookPointFlagsUnset look_point[1] 0x0001
			if !QuestTaskGet quest[25] 8:
				LookPointFlagsUnset look_point[2] 0x0001
			if !QuestTaskGet quest[25] 9:
				LookPointFlagsUnset look_point[3] 0x0001
	if !flag[2206]:
		ObjFrame object[2] 0
	else:
		ObjFrame object[2] 30
	Return

fn[4]:
	ED7_F2 1
	SystemFlagsSet 0x08000000
	if !flag[2206]:
		SoundPlay sound[14] 0 100 0
		ED7ObjPlay object[2] 0 30 0 0
		Sleep 500ms
		if ItemAdd item[1606] 1:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextSetName ""
			TextMessage name[742] {
				{color 0}已取得{item[1606]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			TextSetPos -1 280 60 3
			FadeIn 300ms 0x00000000
			FlagSet flag[2206]
			ED7_DE 6
		else:
			FadeOut 300ms 0x00000000 100
			TextSetName ""
			TextMessage name[742] {
				寶箱內裝著{item[1606]}{color 0}。
				但因持有物品已滿而放棄{item[1606]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			SoundPlay sound[15] 0 100 0
			ED7ObjPlay object[2] 30 0 0 0
	else:
		FadeOut 300ms 0x00000000 100
		TextSetPos -1 -1 -1 -1
		TextSetName ""
		TextMessage name[742] {
			{0x06}{color 5}寶箱內空無一物。{color 0}{wait}
		}
		TextWait
		TextClose 0
		FadeIn 300ms 0x00000000
	Sleep 30ms
	TextEnd null
	SystemFlagsUnset 0x08000000
	Return

fn[5]:
	TextStart self
	if flag[1307]:
		if !flag[0]:
			TextTalk self {
				真是少見呢，達利亞今天
				竟然主動和我搭話了。{wait}
			}
			TextWait
			TextTalk self {
				……但是她說的內容太深奧，
				我沒能聽懂。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				哎呀，明明是個增進
				關係的機會呢，
				真恨自己那麼無知。{wait}
			}
			TextWait
	elif flag[1292]:
		if !flag[0]:
			TextTalk self {
				兩個人就這麼傻站在這裡的話，
				會有點不好意思吧。{wait}
			}
			TextWait
			TextTalk self {
				尤其是像達利亞
				那麼端莊有禮的人，
				也不能總是和她隨便閒聊家常……{wait}
			}
			TextWait
			TextTalk self {
				哎呀，真想一個人待一會，
				我再去休息一下好了。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				我和在唐古拉姆門工作的巴雷爾
				認識很長時間了，
				所以在一起時比較輕鬆……{wait}
			}
			TextWait
			TextTalk self {
				但我怎麼也沒法適應
				和女同事一起單獨工作呢。{wait}
			}
			TextWait
	elif flag[1282]:
		if !flag[0]:
			TextTalk self {
				呼……
				果然還是待在這裡才能讓人內心平靜。{wait}
			}
			TextWait
			TextTalk self {
				再稍微休息一下，我就要回去繼續守衛國境了……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				我是有得到達利亞的同意，
				才在這休息的。{wait}
			}
			TextWait
			TextTalk self {
				……可絕對不是在
				偷懶哦。{wait}
			}
			TextWait
	elif flag[1280]:
		if QuestTaskGet quest[25] 5 && !QuestFlagsGet quest[25] 0x10:
			if !flag[0]:
				TextTalk self {
					哎？你們說那個啟動鑰匙應該在屋頂上？{wait}
				}
				TextWait
				TextTalk self {
					這……我和達利亞明明已經
					把各個角落都仔細搜尋了一遍呢。{wait}
				}
				TextWait
				TextTalk self {
					……不過，可能是
					我們看漏了吧。
					搜索就拜託諸位了。{wait}
				}
				TextWait
				FlagSet flag[0]
			else:
				TextTalk self {
					我們也尋找過那個啟動鑰匙……
					但也許是看漏了吧。{wait}
				}
				TextWait
				TextTalk self {
					不好意思，就拜託你們繼續搜尋了。{wait}
				}
				TextWait
		elif !flag[0]:
			TextTalk self {
				我在唐古拉姆門那邊
				有一個叫做巴雷爾的朋友。{wait}
			}
			TextWait
			TextTalk self {
				說實話，我很羨慕那傢伙呢……{wait}
			}
			TextWait
			TextTalk self {
				這裡一旦出現什麼緊急情況的話，
				我們的司令卻很可能會不在，
				讓人很不放心呢。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				我好羨慕在唐古拉姆門
				工作的巴雷爾啊。{wait}
			}
			TextWait
			TextTalk self {
				我被派遣到這個地方，
				真是倒楣……{wait}
			}
			TextWait
	TextEnd self
	Return

fn[6]:
	TextStart self
	if flag[1566]:
		if !flag[1]:
			TextTalk self {
				在幾年前，帝國曾經發生了
				多處遊擊士協會同時遭受
				獵兵團襲擊的事件。{wait}
			}
			TextWait
			TextTalk self {
				雖然在一位很有威望的遊擊士
				的領導下，事態順利平息了……
				但仍然還流傳著各種傳言。{wait}
			}
			TextWait
			TextTalk self {
				有人說，
				其實那場襲擊事件本身也只是
				為了聲東擊西而演的一場戲……{wait}
			}
			TextWait
			TextTalk self {
				……總覺得有什麼內情呢。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				幾年前發生的那場
				帝國遊擊士協會遭襲事件……{wait}
			}
			TextWait
			TextTalk self {
				……總覺得有什麼內情呢。{wait}
			}
			TextWait
	elif flag[1554]:
		TextTalk self {
			一看到帝國那邊的守備那麼堅固……
			就會對我們這個毫無防備，
			形同虛設的國境門感到痛心疾首。{wait}
		}
		TextWait
		TextTalk self {
			如果帝國真的有心要打過來，
			我們這個關卡肯定就……{wait}
		}
		TextWait
	elif flag[1536]:
		TextTalk self {
			以前，在利貝爾曾經
			發生過導力停止現象……{wait}
		}
		TextWait
		TextTalk self {
			那時候，帝國的奧斯本宰相閣下
			大膽出動了原本已經廢棄的
			蒸氣驅動式戰車。{wait}
		}
		TextWait
		TextTalk self {
			如此周密的準備……
			真是個可怕的男人。{wait}
		}
		TextWait
	elif flag[1307]:
		if !flag[1]:
			TextTalk self {
				畢竟我們是在同一個地方擔任警備工作，
				我為了搞好關係，拉近距離，
				就試著談了談這個話題──{wait}
			}
			TextWait
			TextTalk self {
				關於前一陣在利貝爾發生的異變，
				你是怎麼想的……{wait}
			}
			TextWait
			TextTalk self {
				突然問了這樣的問題，
				果然不太好吧。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				唉……怕生的人真是很辛苦啊。
				一旦話題中斷了，
				氣氛就會莫名地尷尬起來……{wait}
			}
			TextWait
			TextTalk self {
				沒辦法，
				今天還是不聊了，
				集中精力專心工作吧。{wait}
			}
			TextWait
	elif flag[1292]:
		if !flag[1]:
			TextTalk self {
				我和布魯德先生很少聊天，
				就算說話，也說不上幾句。{wait}
			}
			TextWait
			TextTalk self {
				和女隊員們在一起的時候，
				我倒不是這樣的……
				可能是因為我比較害羞吧。{wait}
			}
			TextWait
			TextTalk self {
				大家同樣在做著守衛國境的工作，
				還是希望能相處得更融洽一些呢。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				如果是米蕾優准尉的話，
				既容易與她親近，
				又很好說話……{wait}
			}
			TextWait
			TextTalk self {
				但和男性單獨在一起，
				我實在是很難習慣呢。
				我是個很怕生的人……{wait}
			}
			TextWait
	elif flag[1282]:
		if !flag[1]:
			TextTalk self {
				布魯德先生說他
				想休息一會，
				所以我暫時要獨自站崗。{wait}
			}
			TextWait
			TextTalk self {
				這本來是違反規定的行為……
				不過反正司令也不在，就裝作沒看見吧。{wait}
			}
			TextWait
			TextTalk self {
				雖說是工作，但日復一日地望著這
				毫無變化的相同景色，多少也會有些厭倦呢。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				……再過一會，
				我也去休息一下好了。{wait}
			}
			TextWait
			TextTalk self {
				嘗嘗在工作時間偷懶的感覺，
				或許也是一種樂趣。{wait}
			}
			TextWait
	elif flag[1280]:
		if QuestTaskGet quest[25] 5 && !QuestFlagsGet quest[25] 0x10:
			TextTalk self {
				……呼……{wait}
			}
			TextWait
			TextTalk self {
				昨天晚上，司令跑到屋頂上
				大聲唱歌……{wait}
			}
			TextWait
			TextTalk self {
				我們最近都已經這麼忙了，
				他卻連個安穩覺都不讓我們睡好。{wait}
			}
			TextWait
		elif !flag[1]:
			TextTalk self {
				因為警備隊裡的
				女隊員數量並不多，
				所以有時候會引起別人的好奇呢。{wait}
			}
			TextWait
			TextTalk self {
				唐古拉姆門的索妮亞副司令和
				諾艾兒上士都是漂亮的美人，
				我猜她們會更加辛苦呢。{wait}
			}
			TextWait
			TextTalk self {
				『美女警備隊員的獨家專訪！』
				被那種新聞攪擾的日子可真是……
				哎呀，完全不敢想像……{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				這麼說來，
				在利貝爾發生了
				那次異變之後……{wait}
			}
			TextWait
			TextTalk self {
				有位名叫尤莉亞的王室親衛隊隊長
				也被大肆炒作了一番呢。{wait}
			}
			TextWait
			TextTalk self {
				我看到過她的照片，
				也是一位英氣十足的人呢……
				當時一定是辛苦了一陣子吧。{wait}
			}
			TextWait
	elif flag[1040]:
		if !flag[1]:
			TextTalk self {
				直到前年為止，
				那邊那個加雷利亞要塞，
				一直都有一門巨大的列車砲瞄準著這邊。{wait}
			}
			TextWait
			TextTalk self {
				真有種一觸即發的感覺呢……
				看那種嚴守戒備的態勢，簡直就像是要
				再次爆發大規模的爭端一樣。{wait}
			}
			TextWait
			TextTalk self {
				雖然托不戰條約的福，
				這裡最近十分和平……
				但那種恐懼感終究是難以忘懷的。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				多虧了前年簽署的不戰條約，
				克洛斯貝爾才得以從極度緊張的狀態下解放。{wait}
			}
			TextWait
			TextTalk self {
				提出條約的人是利貝爾的艾莉西亞女王，
				她實在是讓人敬佩啊。{wait}
			}
			TextWait
	elif flag[1024]:
		if !flag[1]:
			TextTalk self {
				那個看上去很像岩壁的，是帝國引以為傲的
				『加雷利亞要塞』的一角。{wait}
			}
			TextWait
			TextTalk self {
				帝國的軍事力量對我們來說是一大威脅，
				所以在任何時候都不能放鬆警惕。{wait}
			}
			TextWait
			TextTalk name[3] {
				#0300F嗯～不過，繃得太緊也不好哦。{wait}
			} {
				#0304F認真工作自然是很好，
				但我覺得，適度放鬆也是必不可少的。{wait}
			}
			TextWait
			TextTalk self {
				……蘭迪前輩是放鬆過頭了！{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				……不過，的確是這樣，
				太過緊張也是不好的。{wait}
			}
			TextWait
			TextTalk self {
				再過一會，我就去和
				布魯德先生換個班吧。{wait}
			}
			TextWait
			TextTalk name[3] {
				#0306F（認真的傢伙……）{wait}
			}
			TextWait
	TextEnd self
	Return

fn[7]:
	TextStart self
	if flag[1031]:
		if !flag[2]:
			_Char4A char[2] 255
			_Char4A char[3] 255
			TextTalk char[2] {
				#0805F哇～好壯觀……{wait}
			} {
				#0801F那就是帝國那邊的國境吧。
				至今為止，好像一直都沒有
				機會好好觀察一下呢。{wait}
			}
			TextWait
			TextTalk char[3] {
