fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if flag[1338]:
		CharFlagsUnset char[8] 0x0080
		CharFlagsUnset char[9] 0x0080
		CharFlagsSet char[0] 0x0080
		CharFlagsSet char[1] 0x0080
	elif flag[1333]:
		CharFlagsSet char[0] 0x0080
		CharFlagsSet char[1] 0x0080
	elif flag[1330]:
	elif flag[1329]:
	elif flag[1320]:
	if system[0] == 101 && flag[1333] && !flag[1334]:
		Event fn[0,19]
	if system[0] == 106 && flag[1336] && !flag[1338]:
		Event fn[0,23]
	Return

fn[2]:
	TriggerFlagsSet trigger[0] 0x0080
	TriggerFlagsSet trigger[1] 0x0080
	if flag[1320] && !flag[1328]:
		TriggerFlagsUnset trigger[0] 0x0080
	if flag[1330] && !flag[1331]:
		TriggerFlagsUnset trigger[1] 0x0080
	if flag[1330] && !flag[1333]:
		if system[0] == 100 | system[0] == 101:
			Call fn[0,9]
	if flag[1331]:
		if system[0] == 102 | system[0] == 103:
			Call fn[0,10]
	if flag[1334]:
		if system[0] == 100 | system[0] == 101:
			Call fn[0,11]
	if flag[1331]:
		ED7_76_0 object[255] "mado_a" 1
		ED7_76_1 object[255] "mado_b" 1
	else:
		ED7_76_1 object[255] "mado_a" 1
		ED7_76_0 object[255] "mado_b" 1
	if flag[1333]:
	EntranceSetFunc entrance[2] fn[255,65535]
	if flag[1330] && !flag[1333]:
		EntranceSetFunc entrance[2] fn[0,32]
	ObjFlagsSet object[8] 0x0010
	if flag[1312] && !flag[1330]:
		ObjFlagsUnset object[8] 0x0010
	ObjFlagsSet object[9] 0x0010
	if flag[1312] && !flag[1333]:
		ObjFlagsUnset object[9] 0x0010
	Return

fn[3]:
	if flag[1320] && !flag[1327]:
		Call fn[0,12]
	else:
		TextStart char[0]
		if flag[1333]:
		elif flag[1330]:
			TextTalk self {
				老爺正在和瑪律克尼會長
				就拍賣會的安排
				進行最終確認。{wait}
			}
			TextWait
			TextTalk self {
				請不要打擾他們。{wait}
			}
			TextWait
		elif flag[1329]:
			TextTalk self {
				這裡是本館的主人
				哈爾特曼議長閣下的
				居室。{wait}
			}
			TextWait
			TextTalk self {
				拍賣會即將開始，
				請儘快前往會場。{wait}
			}
			TextWait
		elif flag[1320]:
			TextTalk self {
				這裡是本館的主人
				哈爾特曼議長閣下的
				居室。{wait}
			}
			TextWait
			if flag[1324]:
				TextTalk self {
					老爺現在應該
					在一樓左手邊的
					沙龍。{wait}
				}
				TextWait
				TextTalk self {
					如果有事的話，
					請到那邊去找他。{wait}
				}
				TextWait
			else:
				TextTalk self {
					老爺正準備前往一樓
					左手邊的沙龍。{wait}
				}
				TextWait
				TextTalk self {
					如果有什麼要事，
					請到那邊去等候。{wait}
				}
				TextWait
		TextEnd char[0]
	Return

fn[4]:
	TextStart self
	TextTalk self {
		………………………………{wait}
	}
	TextWait
	TextSetName ""
	TextMessage null {
		{color 5}似乎完全失去了意識。{color 0}{wait}
	}
	TextWait
	TextClose 0
	_59
	TextEnd self
	Return

fn[5]:
	TextStart self
	if flag[1333]:
	elif flag[1330]:
	elif flag[1329]:
		TextTalk self {
			實在失禮……
			您待在這邊
			會影響商品的搬運。{wait}
		}
		TextWait
		TextTalk self {
			請在會場耐心等候。{wait}
		}
		TextWait
	elif flag[1320]:
		if !flag[0]:
			TextTalk self {
				……客人，還有什麼事嗎？{wait}
			}
			TextWait
			TextTalk name[0] {
				#5100F啊，不……
				沒什麼。{wait}
			} {
				#5108F（……剛才的聲音到底是……？）{wait}
			}
			TextWait
			Emote self 0mm 2000mm 0 1 250ms 2
			SoundPlay sound[29] 0 100 0
			Sleep 1000ms
			TextTalk self {
				……拍賣品在開場之前
				都是非公開的。{wait}
			}
			TextWait
			TextTalk self {
				請耐心等待
				拍賣會的展出。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				拍賣品在開場之前都是非公開的，
				請耐心等待
				拍賣會的展出。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[6]:
	TextStart self
	if !flag[1]:
		TextTalk char[8] {
			#3505F啊，
			本該去了後院的人
			竟然還在這裡呢。{wait}
		} {
			#3502F你們還有時間在這裡磨磨蹭蹭嗎～？{wait}
		}
		TextWait
		TextTalkNamed name[0] "琪雅" {
			#5810F#N奇怪的人，再見哦！{wait}
		}
		TextWait
		TextTalk char[8] {
			#3504F好好，再見啦～{wait}
		} {
			#3501F……話說，叫我奇怪的人，
			未免也太過分了吧？{wait}
		}
		TextWait
		FlagSet flag[1]
	else:
		_Char4A char[9] 255
		CharTurnToChar self char[9] 0deg/s
		TextTalk char[8] {
			#3509F房間的主人好像不在，
			可以盡情玩了哦，小黑。{wait}
		} {
			#3507F好，不如來踢罐子吧！{wait}
		}
		TextWait
		TextTalk char[9] {
			喵嗚？{wait}
		}
		TextWait
		_Char4B char[9] 255
	TextEnd self
	Return

fn[7]:
	TextStart self
	TextTalk self {
		咕嚕喵～{wait}
	}
	TextWait
	TextEnd self
	Return

fn[8]:
	ED7_F2 3
	TextStart null
	FadeOut 300ms 0x00000000 100
	Menu menu[0] -1 -1 1
		"在此地休息" // 0
		"放棄" // 1
	MenuWait var[0]
	MenuClose menu[0]
	TextClose 0
	if var[0] == 0:
		SoundLoad sound[13]
		BgmStop 3000ms
		FadeOut 1000ms 0x00000000 255
		Sleep 700ms
		SoundPlay sound[13] 0 100 0
		FadeWait
		PartySetAttr name[255] 254 0
		CamLookChar field_party[0] 0ms
		ED7_31 1
		Sleep 3500ms
		BgmResume
		FadeIn 1000ms 0x00000000
		TextClose 0
		TextEnd null
		Return
	elif var[0] != 0:
		FadeIn 300ms 0x00000000
		TextEnd null
		Return
	Return
	Return

