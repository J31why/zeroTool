		TextTalk self {
			說到克洛斯貝爾的慶典，
			就一定少不了遊行！{wait}
		}
		TextWait
		TextTalk self {
			我就是為了看這個，
			才會遠道而來的～！{wait}
		}
		TextWait
	TextEnd self
	Return

fn[25]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if flag[7]:
		TextTalk char[14] {
			今天就在西側大道
			悠閒地度過吧，
			呵呵。{wait}
		}
		TextWait
	else:
		TextTalk char[14] {
			雖然我平時
			都是在住宅區悠閒度日的。{wait}
		}
		TextWait
		TextTalk char[14] {
			但我喜歡的那個長椅，今天卻被一個
			一臉疲憊的穿西裝男子給占了。{wait}
		}
		TextWait
		TextTalk char[14] {
			呵呵，看他一副沒精打采的樣子，
			我就把那座位讓給他了。{wait}
		}
		TextWait
		FlagSet flag[7]
	CharSetChipPattern self 0
	TextEnd self
	Return

