fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharIdle self (-28870, null, 2540) (-21090, null, 6380) 1000mm/s
		Sleep 300ms
	Return

fn[2]:
	while 1:
		CharIdle self (-2830, null, -6400) (-1500, null, -8300) 1000mm/s
		Sleep 300ms
	Return

fn[3]:
	if system[0] == 111:
		if global[7] == 6 | global[7] == 7:
			CharSetPos field_party[0] (110, 3000, 22760) 180deg
			CharSetPos field_party[1] (110, 3000, 22760) 180deg
			CharSetPos field_party[2] (110, 3000, 22760) 180deg
			CharSetPos field_party[3] (110, 3000, 22760) 180deg
			if system[15] != 255:
				CharSetPos field_party[4] (110, 3000, 22760) 180deg
				CharSetPos field_party[5] (110, 3000, 22760) 180deg
			elif system[14] != 255:
				CharSetPos field_party[4] (110, 3000, 22760) 180deg
			system[0] = 101
		else:
			CharSetPos field_party[0] (24460, 0, -8180) 270deg
			CharSetPos field_party[1] (24460, 0, -8180) 270deg
			CharSetPos field_party[2] (24460, 0, -8180) 270deg
			CharSetPos field_party[3] (24460, 0, -8180) 270deg
			if system[15] != 255:
				CharSetPos field_party[4] (24460, 0, -8180) 270deg
				CharSetPos field_party[5] (24460, 0, -8180) 270deg
			elif system[14] != 255:
				CharSetPos field_party[4] (24460, 0, -8180) 270deg
			system[0] = 100
	global[7] = 2
	if flag[1307]:
		CharSetPos char[11] (21980, 0, -10790) 135deg
		CharFlagsUnset char[14] 0x0080
	elif flag[1292]:
		CharSetPos char[11] (-2410, 0, -1730) 90deg
		CharFlagsUnset char[12] 0x0080
		CharFlagsUnset char[13] 0x0080
		if flag[1362]:
			EffLoad eff[0] "event\\eva02_00.eff"
	elif flag[1282]:
		CharFlagsUnset char[3] 0x0080
		CharTurnTo char[5] 180deg 0deg/s
		CharTurnTo char[6] 225deg 0deg/s
		CharSetPos char[11] (-6580, 0, 5810) 0deg
		CharFlagsUnset char[7] 0x0080
		CharFlagsUnset char[8] 0x0080
		if QuestTaskGet quest[29] 3 && !QuestFlagsGet quest[29] 0x10 && !QuestFlagsGet quest[29] 0x40:
			CharFlagsSet char[5] 0x0080
			CharFlagsSet char[6] 0x0080
			CharFlagsSet char[11] 0x0080
		CharFlagsUnset char[15] 0x0080
		CharFlagsUnset char[16] 0x0080
	elif flag[1280]:
		CharFlagsUnset char[3] 0x0080
		CharFlagsUnset char[4] 0x0080
	if flag[1487] && !flag[1303]:
		Event fn[0,27]
	if flag[736]:
		FlagUnset flag[736]
		Event fn[0,30]
	elif flag[737]:
		FlagUnset flag[737]
		Event fn[0,31]
	elif flag[738]:
		FlagUnset flag[738]
		Event fn[0,34]
	Return

fn[4]:
	ObjFlagsUnset object[9] 0x0010
	ObjFrame object[9] 30
	EntranceSetFunc entrance[1] fn[255,65535]
	EntranceSetFunc entrance[8] fn[255,65535]
	TriggerFlagsSet trigger[0] 0x0080
	if flag[1294] && !flag[1303]:
		EntranceSetFunc entrance[1] fn[0,40]
		EntranceSetFunc entrance[8] fn[0,41]
		TriggerFlagsUnset trigger[0] 0x0080
	if flag[1303] && !flag[1307]:
		EntranceSetFunc entrance[1] fn[0,40]
	LookPointFlagsSet look_point[3] 0x0001
	if QuestTaskGet quest[29] 8 && !QuestFlagsGet quest[29] 0x10:
		LookPointFlagsUnset look_point[3] 0x0001
	if QuestTaskGet quest[29] 3 && !QuestFlagsGet quest[29] 0x10 && flag[2177]:
		LookPointFlagsSet look_point[1] 0x0001
		LookPointFlagsUnset look_point[3] 0x0001
	if !flag[2176]:
		ObjFrame object[7] 0
	else:
		ObjFrame object[7] 30
	if !flag[2177]:
		ObjFrame object[8] 0
	else:
		ObjFrame object[8] 30
	EffLoad eff[7] "event\\ev308_02.eff"
	EffPlay eff[7] eff_instance[255] null 0 (-25000, -4000, 4000) 0 0 0 1000 1000 1000 null (0, 0, 0) 0ms
	EffPlay eff[7] eff_instance[255] null 0 (0, -4000, 0) 0 0 0 1000 1000 1000 null (0, 0, 0) 0ms
	EffPlay eff[7] eff_instance[255] null 0 (24000, -4000, -8000) 0 0 0 1000 1000 1000 null (0, 0, 0) 0ms
	EffPlay eff[7] eff_instance[255] null 0 (4000, -1000, 18000) 0 0 0 1000 1000 1000 null (0, 0, 0) 0ms
	Return

fn[5]:
	ED7_F2 1
	SystemFlagsSet 0x08000000
	FadeOut 300ms 0x00000000 100
	if !flag[2176]:
		SoundPlay sound[14] 0 100 0
		ED7ObjPlay object[7] 0 30 0 0
		Sleep 500ms
		ObjFrame object[7] 30
		SoundPlay sound[17] 0 100 0
		TextSetPos -1 -1 -1 -1
		SepithAdd 0 80
		SepithAdd 1 80
		SepithAdd 2 80
		SepithAdd 3 80
		SepithAdd 4 80
		SepithAdd 5 80
		SepithAdd 6 80
		TextMessage null {
			獲得了{color 2}#56I地之耀晶石×８０{color 0}
			{color 2}#57I水之耀晶石×８０{color 0}
			{color 2}#58I火之耀晶石×８０{color 0}
			{color 2}#59I風之耀晶石×８０{color 0}
			{color 2}#60I時之耀晶石×８０{color 0}
			{color 2}#61I空之耀晶石×８０{color 0}
			{color 2}#62I幻之耀晶石×８０{color 0}。{wait}
		}
		TextWait
		TextClose 0
		TextSetPos -1 280 60 3
		FlagSet flag[2176]
		ED7_DE 6
	else:
		TextMessage name[742] {
			{0x06}{color 5}寶箱內空無一物。{wait}
		}
		TextWait
		TextClose 0
	FadeIn 300ms 0x00000000
	TextEnd null
	SystemFlagsUnset 0x08000000
	Return

fn[6]:
	ED7_F2 1
	SystemFlagsSet 0x08000000
	if !flag[2177]:
		SoundPlay sound[14] 0 100 0
		ED7ObjPlay object[8] 0 30 0 0
		Sleep 500ms
		if ItemAdd item[167] 1:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextSetName ""
			TextMessage name[742] {
				{color 0}已取得{item[167]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			TextSetPos -1 280 60 3
			FadeIn 300ms 0x00000000
			FlagSet flag[2177]
			ED7_DE 6
		else:
			FadeOut 300ms 0x00000000 100
			TextSetName ""
			TextMessage name[742] {
				寶箱內裝著{item[167]}{color 0}。
				但因持有物品已滿而放棄{item[167]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			SoundPlay sound[15] 0 100 0
			ED7ObjPlay object[8] 30 0 0 0
	else:
		FadeOut 300ms 0x00000000 100
		TextSetPos -1 -1 -1 -1
		TextSetName ""
		TextMessage name[742] {
			{0x06}{color 5}寶箱內空無一物。{color 0}{wait}
		}
		TextWait
		TextClose 0
		FadeIn 300ms 0x00000000
	Sleep 30ms
	TextEnd null
	SystemFlagsUnset 0x08000000
	if QuestTaskGet quest[29] 3 && !QuestTaskGet quest[29] 8:
		Call fn[0,32]
	Return

fn[7]:
	TextStart self
	if flag[1282]:
		if !flag[9]:
			CharFlagsSet char[15] 0x0010
			_Char4A char[15] 255
			CharTurnToChar char[15] char[16] 0deg/s
			TextTalk char[15] {
				趕快出發啦！我等不及了！
				今天要比昨天逛更多的店！{wait}
			} {
				『紀念慶典』可是不會等人的～{wait}
			}
			TextWait
			FlagSet flag[9]
			CharFlagsUnset char[15] 0x0010
		else:
			TextTalk char[15] {
				『紀念慶典』可是不會等人的～{wait}
			}
			TextWait
		_Char4B char[15] 255
	TextEnd self
	Return

fn[8]:
	TextStart self
	if flag[1282]:
		if !flag[10]:
			TextTalk char[16] {
				媽媽到底在做什麼呀……
				肯恩等不住快一個人先走了呢。{wait}
			} {
				不過娜娜會等媽媽的！{wait}
			}
			TextWait
		else:
			TextTalk char[16] {
				娜娜會等媽媽的！
				──怎麼還不出來呀……{wait}
			}
			TextWait
	TextEnd self
	Return

fn[9]:
	TextStart self
	if flag[1307]:
		TextTalk self {
			今天日落之後，
			將會有壓軸的煙火哦。{wait}
		}
		TextWait
		TextTalk self {
			這可不能錯過呢。
			要占個好位置才行。{wait}
		}
		TextWait
	elif flag[1362]:
		if !flag[6]:
			TextTalk self {
				７０周年紀念日快樂！{wait}
			}
			TextWait
			TextSetName ""
			TextMessage null {
				{color 5}龐斯架好了導力相機。{color 0}{wait}
			}
			TextWait
			TextClose 0
