	function fn[0,8]
	unk3 0
	unk4 0

fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharWalkToPos self (-4260, 0, 8920) 2000mm/s 0
		CharWalkToPos self (720, 0, 6870) 2000mm/s 0
		CharWalkToPos self (780, 0, 1070) 2000mm/s 0
		CharWalkToPos self (7240, 0, -2090) 2000mm/s 0
		CharWalkToPos self (7240, 0, -6010) 2000mm/s 0
		CharWalkToPos self (3280, 0, -8790) 2000mm/s 0
		CharWalkToPos self (-8880, 0, 3240) 2000mm/s 0
	Return

fn[2]:
	Fork self fork[2]:
		CharShake self 4 0 0 600ms
	while 1:
		var[3] = random % 100
		if var[3] <= 60:
			CharIdle self (-3730, null, 7180) (950, null, 8410) 1000mm/s
			Sleep 100ms
		else:
			CharTurnTo self 225deg 1000deg/s
			CharTurnTo self 315deg 1000deg/s
			CharTurnTo self 45deg 1000deg/s
			CharTurnTo self 135deg 1000deg/s
			CharTurnTo self 225deg 1000deg/s
			Sleep 500ms
	Return

fn[3]:
	if flag[1307]:
		CharSetPos char[3] (-6980, 0, 1280) 90deg
		ForkFunc char[3] fork[0] fn[0,0]
		CharFlagsUnset char[5] 0x0080
		CharFlagsUnset char[6] 0x0080
		CharFlagsUnset char[7] 0x0080
		CharFlagsUnset char[8] 0x0080
		CharFlagsUnset char[9] 0x0080
		CharFlagsUnset char[10] 0x0080
		CharFlagsUnset char[11] 0x0080
		CharFlagsUnset char[12] 0x0080
		CharSetPos char[4] (-210, 5000, 18380) 0deg
		CharSetChipBase char[4] chip[25]
		CharSetChipPattern char[4] 0
		ForkFunc char[4] fork[0] fn[0,0]
		CharFlagsUnset char[4] 0x0040
		CharFlagsSet char[4] 0x0010
		Emote char[4] 0mm 2000mm 24 27 250ms 0
	elif flag[1362]:
		CharSetPos char[2] (-1460, 0, 7630) 180deg
		ForkFunc char[2] fork[0] fn[0,2]
		CharSetPos char[3] (6810, 0, 9660) 270deg
		ForkFunc char[3] fork[0] fn[0,0]
		CharFlagsUnset char[19] 0x0080
		CharFlagsUnset char[21] 0x0080
	elif flag[1292]:
		CharFlagsUnset char[20] 0x0080
		CharFlagsUnset char[22] 0x0080
		CharFlagsUnset char[24] 0x0080
	elif flag[1286]:
		CharFlagsSet char[3] 0x0080
		CharFlagsUnset char[17] 0x0080
		CharFlagsUnset char[18] 0x0080
	elif flag[1282]:
		CharFlagsSet char[3] 0x0080
		CharFlagsUnset char[17] 0x0080
		CharFlagsUnset char[18] 0x0080
	elif flag[1280]:
		CharFlagsUnset char[14] 0x0080
		CharFlagsUnset char[15] 0x0080
		CharFlagsUnset char[16] 0x0080
	Return

fn[4]:
	Return

fn[5]:
	Call fn[0,6]
	Return

fn[6]:
	TextStart char[23]
	if !flag[610]:
		TextTalk char[23] {
			嘿，歡迎光臨。
			本來應該這麼說……{wait}
		}
		TextWait
		TextTalk char[23] {
			不過，小子們，在克洛斯貝爾，
			如果沒有許可證的話，是不能買武器的。
			如果只是來閒逛的話，還是請回吧。{wait}
		}
		TextWait
		TextTalk name[0] {
			#0000F啊，不，我們
			是克洛斯貝爾警察局的人……{wait}
		}
		TextWait
		Emote char[23] 0mm 2000mm 0 1 250ms 2
		SoundPlay sound[29] 0 100 0
		Sleep 1000ms
		TextTalk char[23] {
			你們這樣的小鬼會是警察……？{wait}
		}
		TextWait
		TextTalk char[23] {
			對了，你們就是
			賽爾蓋那傢伙之前說的……{wait}
		}
		TextWait
		TextTalk char[23] {
			哼，知道啦。
			你們隨便看吧。{wait}
		}
		TextWait
		TextTalk char[23] {
			想買武器的時候，
			要給我看搜查手冊啊。
			這個可以代替許可證。{wait}
		}
		TextWait
		FlagSet flag[610]
		FlagSet flag[1402]
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"對話" // 0
			"購物" // 1
			"放棄" // 2
		MenuWait var[0]
		if var[0] != 1:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			if flag[1792]:
				ShopOpen shop[5]
			elif flag[1536]:
				ShopOpen shop[4]
			elif flag[1280]:
				ShopOpen shop[3]
			elif flag[1024]:
				ShopOpen shop[2]
			elif flag[768]:
				ShopOpen shop[1]
			else:
				ShopOpen shop[0]
			var[0] = 99
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			if flag[1307]:
				if !flag[0]:
					TextTalk char[23] {
						哎呀呀，狂歡
						也就到今天為止了啊。{wait}
					}
					TextWait
					TextTalk char[23] {
						哦……好吧，你們幾個，
						要玩樂的話，也就趁現在了。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[23] {
						到今天為止，都可以不拘小節。
						要玩樂的話，也就趁現在了。{wait}
					}
					TextWait
			elif flag[1300]:
				TextTalk char[23] {
					喲，還在找那個
					走失的孩子嗎？{wait}
				}
				TextWait
				TextTalk char[23] {
					這個城市很大啊……
					不過，也只能耐心
					去探聽情報了。{wait}
				}
				TextWait
			elif flag[1294]:
				if !flag[1379]:
					TextTalk name[0] {
						#0001F（嗯，這個人
						　可能知道些什麼吧……）{wait}
					}
					TextWait
					TextMessage null {
						{color 5}羅伊德出示了柯林的照片，
						並詢問對方是否有什麼線索。{color 0}{wait}
					}
					TextWait
					TextClose 0
					_59
					TextTalk char[23] {
						哦，拿著照片
						探聽情報嗎……
						今天做的事倒是很像警察的工作嘛。{wait}
					}
					TextWait
					TextTalk name[0] {
						#0012F哈哈，是啊……{wait}
					} {
						#0001F那麼，您有線索嗎？
						這是我一個熟人的孩子……{wait}
					}
					TextWait
					TextTalk char[23] {
						我並沒有去看遊行，
						既然他沒來我的店，那我肯定沒見過。{wait}
					}
					TextWait
					TextTalk char[23] {
						不過，如果他是跟著
						遊行的隊伍走了，
						應該是去了東側大道那邊吧？{wait}
					}
					TextWait
					TextTalk char[23] {
						遊行隊伍的行進路線
						應該是會經過那裡的。{wait}
					}
					TextWait
					TextTalk name[0] {
						#0008F說得也是呢……
						（可是，根據蘭迪的聯絡，
						　他好像沒有去過東側大道……）{wait}
					}
					TextWait
					TextTalk name[95] {
						#3300F……那麼，大哥哥，
						你打算怎麼辦呢？{wait}
					}
					TextWait
					FlagSet flag[1379]
					global[2] = global[2] + 1
					FlagSet flag[0]
					Call fn[0,31]
					TextTalk name[95] {
						#3304F呵呵……真是慎重啊，
						好有趣的大哥哥。{wait}
					}
					TextWait
				else:
					TextTalk char[23] {
						遊行的行進路線
						應該是從這裡往東側大道去的。{wait}
					}
					TextWait
					TextTalk char[23] {
						如果是跟著
						遊行的隊伍走了，
						應該就是去那邊了吧？{wait}
					}
					TextWait
			elif flag[1362]:
				if !flag[0]:
					TextTalk char[23] {
						導力車嗎……遊行
						也是日新月異啊。{wait}
					}
					TextWait
					TextTalk char[23] {
						不過，警察們還是那麼忙，
						這一點倒是一直都沒變呢。{wait}
					}
					TextWait
					TextTalk char[23] {
						那些新人警官如今肯定都已經精疲力盡了吧。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[23] {
						就算時代變遷，
						警察們的忙碌和辛苦也是
						從來都不會變的啊。{wait}
					}
					TextWait
			elif flag[1292]:
				if !flag[0]:
					TextTalk char[23] {
						今天有遊行呢。{wait}
					}
					TextWait
					TextTalk char[23] {
						哎呀呀……
						那些穿制服的傢伙可要辛苦了。{wait}
					}
					TextWait
					TextTalk char[23] {
						我真同情他們啊。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[23] {
						你們要是有空的話，
						也可以去行政區的廣場看看。{wait}
					}
					TextWait
					TextTalk char[23] {
						穿制服的傢伙們一定都手忙腳亂了。{wait}
					}
					TextWait
			elif flag[1286]:
				if !flag[0]:
					TextTalk char[23] {
						我本想和賽爾蓋那傢伙
						一起去喝一杯……{wait}
					}
					TextWait
					TextTalk char[23] {
						不過，他今天好像要開會啊。{wait}
					}
					TextWait
					TextTalk char[23] {
						唔～希望不是又把麻煩事
						推給他了……{wait}
					}
					TextWait
					Emote field_party[0] 0mm 2000mm 0 1 250ms 2
					SoundPlay sound[29] 0 100 0
					Emote field_party[1] 0mm 2000mm 0 1 250ms 2
					SoundPlay sound[29] 0 100 0
					Emote field_party[2] 0mm 2000mm 0 1 250ms 2
					SoundPlay sound[29] 0 100 0
					Emote field_party[3] 0mm 2000mm 0 1 250ms 2
					SoundPlay sound[29] 0 100 0
					Sleep 1000ms
					TextTalk name[0] {
						#0005F此話怎講……？{wait}
					}
					TextWait
					TextTalk char[23] {
						啊，那傢伙從以前開始
						就一直是個怪人嘛。
						總會莫名其妙地背上一些麻煩事。{wait}
					}
					TextWait
					TextTalk char[23] {
						比如給你們『特務支援課』
						收拾善後什麼的。{wait}
					}
					TextWait
					Emote field_party[0] 0mm 2000mm 16 19 250ms 1
					SoundPlay sound[23] 0 100 0
					Emote field_party[1] 0mm 2000mm 16 19 250ms 1
					SoundPlay sound[23] 0 100 0
					Emote field_party[2] 0mm 2000mm 16 19 250ms 1
					SoundPlay sound[23] 0 100 0
					Emote field_party[3] 0mm 2000mm 16 19 250ms 1
					SoundPlay sound[23] 0 100 0
					Sleep 1000ms
					TextTalk name[2] {
						#0203F的確是呢……{wait}
					}
					TextWait
					TextTalk char[23] {
						不過，支援課是那傢伙
						自己建立的部門。
						這也算是自作自受吧。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[23] {
						算了，今天的會議大概是
						商討明天遊行時的警備體制吧。{wait}
					}
					TextWait
					TextTalk char[23] {
						支援課畢竟立過了大功，
						也不用太擔心吧。{wait}
					}
					TextWait
			elif flag[1282]:
				if !flag[0]:
					TextTalk char[23] {
						話說回來，亞里歐斯
						那傢伙好像回國了。{wait}
					}
					TextWait
					TextTalk char[23] {
						今年的人多得非比尋常嘛。{wait}
					}
					TextWait
					TextTalk char[23] {
						他好像也
						不得不回來了。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[23] {
						亞里歐斯好像也回國了。{wait}
					}
					TextWait
					TextTalk char[23] {
						今年的人這麼多，也沒辦法吧。{wait}
					}
