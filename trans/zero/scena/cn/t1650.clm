fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if flag[1566]:
	elif flag[1565]:
		CharFlagsUnset char[0] 0x0080
	elif flag[1536]:
	elif flag[1351]:
		CharFlagsUnset char[0] 0x0080
	if flag[736]:
		FlagUnset flag[736]
		Event fn[0,13]
	elif flag[737]:
		FlagUnset flag[737]
		Event fn[0,19]
	Return

fn[2]:
