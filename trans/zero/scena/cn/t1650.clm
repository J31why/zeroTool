	elif flag[1536]:
	elif flag[1351]:
		LookPointFlagsUnset look_point[0] 0x0001
	EntranceSetFunc entrance[1] fn[0,5]
	if flag[1359] && !flag[1536]:
		MapColor 0x00C8D2FF 0ms
	elif flag[1564] && !flag[1566]:
		MapColor 0x00C8D2FF 0ms
	Return

fn[3]:
	Call fn[0,4]
	Return

fn[4]:
	field_party[0].5 = char[0].4
	char[0].5 = char[0].4
	TextStart char[0]
	CharFlagsUnset char[0] 0x0010
	CharTurnToChar char[0] field_party[0] 0deg/s
	char[0].4 = (char[0].4 + 360) % 360
	char[0].4 = char[0].4 + 360 - char[0].5
	char[0].5 = char[0].4 / 180
	if char[0].4 <= 45 | char[0].4 >= 315 && char[0].4 <= 405 | char[0].4 >= 675:
	elif char[0].5 < 1:
		char[0].8 = 2
	elif char[0].5 > 2:
		char[0].8 = 1
	else:
		char[0].8 = char[0].5
	char[0].4 = field_party[0].5
	field_party[0].5 = 0
	char[0].5 = 0
	CharFlagsSet char[0] 0x0010
	if flag[1566]:
	elif flag[1565]:
		if !flag[0]:
			TextTalk char[0] {
				#2410F這藥錠就是傳聞中的『真知』嗎，
				還是完全不同的藥呢……{wait}
			} {
				#2400F雖然這樣說可能有些不謹慎，
				但身為藥物學研究者，
				我對此真的非常感興趣。{wait}
			} {
				#2401F總而言之，我會盡一切努力
				來仔細調查這藍色藥錠的。{wait}
			}
			TextWait
			TextTalk name[2] {
				#0208F……………………………………{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				#2403F借助惡魔之力的謎之秘藥……
				這種藥究竟是不是真正的『真知』，
				只有調查之後方可得知。{wait}
			} {
				#2401F總而言之，我會盡一切努力
				來仔細調查這藍色藥錠的。{wait}
			}
			TextWait
	elif flag[1536]:
	elif flag[1350]:
		if !flag[0]:
			TextTalk char[0] {
				#2400F既然琪雅不願意，
				住院檢查就暫且作罷吧。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0006F實在對不起……
				難得讓您幫我們出主意。{wait}
			}
			TextWait
			TextTalk char[0] {
				#2404F哈哈，不必介意。{wait}
			} {
				#2405F話說回來，
				你們還是早點去
				追琪雅為好吧？{wait}
			} {
				這間烏爾斯拉醫院占地還挺廣的，
				要是走丟的話，可不好找哦。{wait}
			}
			TextWait
			if flag[1356]:
				TextTalk name[1] {
					#0108F是呀……還是趕快去追比較好吧，
					琪雅好像很生氣啊……{wait}
				}
				TextWait
			elif flag[1357]:
				TextTalk name[2] {
					#0203F的確……
					在給醫院的人添麻煩之前，
					還是儘快找到她比較好呢。{wait}
				}
				TextWait
			elif flag[1358]:
				TextTalk name[3] {
					#0300F趕快找到她，
					向她道歉吧。{wait}
				}
				TextWait
			TextTalk name[0] {
				#0000F嗯，那就走吧。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				#2400F琪雅今後說不定也會
				改變主意，
				還是事先做好檢查的準備吧。{wait}
			} {
				有什麼事的話就再來商量，
				隨時都可以與我聯絡。{wait}
			}
			TextWait
	CharSetChipPattern char[0] 0
	TextEnd char[0]
	Return

