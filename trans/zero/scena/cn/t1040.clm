fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharWalkToPos self (-98090, 0, 5880) 2000mm/s 0
		CharWalkToPos self (-98090, 0, 12710) 2000mm/s 0
		CharWalkToPos self (-92260, 0, 12710) 2000mm/s 0
		CharWalkToPos self (-92260, 0, 15180) 2000mm/s 0
		CharWalkToPos self (-101100, 0, 15180) 2000mm/s 0
		CharWalkToPos self (-101100, 0, 5880) 2000mm/s 0
	Return

fn[2]:
	if system[0] == 100 && flag[1318] && !flag[1319]:
		Event fn[0,24]
	if flag[1333]:
	elif flag[1330]:
	elif flag[1329]:
	elif flag[1320]:
	elif flag[1319]:
	elif flag[1318]:
		CharFlagsUnset char[7] 0x0080
		CharFlagsUnset char[8] 0x0080
		CharFlagsUnset char[9] 0x0080
		CharFlagsUnset char[10] 0x0080
		CharFlagsUnset char[11] 0x0080
	elif flag[1312]:
		CharFlagsUnset char[0] 0x0080
		CharFlagsUnset char[3] 0x0080
		CharFlagsUnset char[4] 0x0080
		CharFlagsUnset char[5] 0x0080
		CharFlagsUnset char[6] 0x0080
		CharFlagsUnset char[14] 0x0080
		CharFlagsUnset char[15] 0x0080
	elif flag[1307]:
	ForkFunc char[2] fork[0] fn[0,1]
	Return

fn[3]:
	if flag[1318] && !flag[1342]:
		ED7_76_0 object[255] "t1040_sky" 1
		ED7_76_1 object[255] "t1040_sky_y" 1
	else:
		ED7_76_1 object[255] "t1040_sky" 1
		ED7_76_0 object[255] "t1040_sky_y" 1
	LookPointFlagsSet look_point[2] 0x0001
	if QuestFlagsGet quest[36] 0x02 && !QuestTaskGet quest[36] 5:
		EffLoad eff[0] "event\\eva00_00.eff"
		EffPlay eff[0] eff_instance[0] null 0 (-102930, 800, 14990) 0 0 0 1000 1000 1000 null (0, 0, 0) 0ms
		LookPointFlagsUnset look_point[2] 0x0001
	Return

fn[4]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if !flag[0]:
		CharSetChipPattern self 0
		TextTalk self {
			#3403F唔……
			不愧是打著
			高級餐廳的名號。{wait}
		} {
			#3400F……只不過……{wait}
		} {
			#3404F（呵呵……
			　還是麻緒婆婆那質樸的料理
			　更加合我的口味呢。）{wait}
		}
		TextWait
		FlagSet flag[0]
	else:
		TextTalk self {
			#3405F……哎呀，你們
			也是來用餐的嗎？{wait}
		} {
			#3400F這裡的食物雖然價格不菲，
			但味道很值得稱讚哦。
			有興趣的話，不如就點一些吧。{wait}
		}
		TextWait
	CharSetChipPattern self 0
	TextEnd self
	Return

fn[5]:
	Call fn[0,6]
	Return

fn[6]:
	TextStart char[1]
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"對話" // 0
			"購物" // 1
			"放棄" // 2
		MenuWait var[0]
		if var[0] != 1:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			ShopOpen shop[102]
			var[0] = 99
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			if flag[1333]:
			elif flag[1330]:
			elif flag[1329]:
			elif flag[1320]:
			elif flag[1319]:
			elif flag[1318]:
				TextTalk char[1] {
					太陽也下山了，
					從米修拉姆回來的客人們
					差不多要蜂湧而至了。{wait}
				}
				TextWait
				TextTalk char[1] {
					得趁現在
					為晚餐做好準備
					才行。{wait}
				}
				TextWait
			elif flag[1312]:
				TextTalk char[1] {
					歡迎，
					歡迎光臨餐廳《幸運》。{wait}
				}
				TextWait
				TextTalk char[1] {
					我傾注心血製作的料理，
					還請您賞光品嘗。{wait}
				}
				TextWait
				TextTalk char[1] {
					用最高級食材烹製的料理，
					一定能將客人們
					引入幸福的漩渦吧。{wait}
				}
				TextWait
			elif flag[1307]:
	TextEnd char[1]
	Return

fn[7]:
	TextStart self
	if flag[1333]:
	elif flag[1330]:
	elif flag[1329]:
	elif flag[1320]:
	elif flag[1319]:
	elif flag[1318]:
		if !flag[1]:
			TextTalk self {
				有個滿身大汗的奇怪大叔
				經常來這裡吃午餐。{wait}
			}
			TextWait
			TextTalk self {
				我想他多半是
				某個設施裡的工作人員……{wait}
			}
			TextWait
			TextTalk self {
				……莫非是咪西裡面的……{wait}
			}
			TextWait
			TextTalk self {
				……不不，當我沒說。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				有個滿身大汗的奇怪大叔
				經常來這裡吃午餐。{wait}
			}
			TextWait
			TextTalk self {
				……莫非是咪西裡面的……{wait}
			}
			TextWait
			TextTalk self {
				……不不，當我沒說。{wait}
			}
			TextWait
	elif flag[1312]:
		if !flag[1]:
			TextTalk self {
				那個東方長相的女性……
				吃東西時的表情好像很嚴肅呢。{wait}
			}
			TextWait
			TextTalk self {
				……難不成，
				是競爭對手派來的間諜嗎……！？{wait}
			}
			TextWait
			TextTalk self {
				………………………………！{wait}
			}
			TextWait
			TextTalk self {
				……但仔細一想，
				這家店好像也沒有
				什麼競爭對手呢。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				呵呵，仔細一想，
				這家店好像也沒有
				什麼競爭對手呢。{wait}
			}
			TextWait
			TextTalk self {
				把客人當成間諜，
				真是太失禮了啊，
				必須要反省呢。{wait}
			}
			TextWait
	elif flag[1307]:
	TextEnd self
	Return

