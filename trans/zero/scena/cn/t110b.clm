			Sleep 150ms
			CrossFade 1000ms
			CharSetChipBase name[0] chip[30]
			CharSetChipPattern name[0] 0
			FadeWait
			SoundPlay sound[882] 0 100 0
			Sleep 500ms
			TextSetName ""
			TextMessage null {
