		CharSetPos name[2] (1250, 0, -33500) 315deg
		CharSetPos name[3] (600, 0, -31250) 315deg
	FadeIn 1000ms 0x00000000
	CamSetDistance 0 900 -27300 3000ms
	CamWait 1
	FadeWait
	if flag[1353]:
		CharTurnToChar name[1] name[0] 300deg/s
		TextTalk name[1] {
			#13500710V#5304F#2P我這邊準備好了哦。{wait}
