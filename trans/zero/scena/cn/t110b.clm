		CharTurnToChar name[2] name[0] 300deg/s
		TextTalk name[2] {
			#13500712V#5403F#2P……我這邊已經
			準備好了。{wait}
		} {
			#13500713V#5401F差不多該走了吧？{wait}
		}
		TextWait
	elif flag[1355]:
		CharTurnToChar name[3] name[0] 300deg/s
		TextTalk name[3] {
			#13500714V#5604F#2P我隨時都可以出發哦。{wait}
		} {
			#13500715V#5600F差不多該走了吧？{wait}
		}
		TextWait
	CharTurnToChar name[0] party[1] 400deg/s
	TextTalk name[0] {
