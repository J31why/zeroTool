				#0C記住了{item[422]}{color 0}的食譜。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			TextSetPos -1 280 60 3
			_59
			RecipeLearn 8
	TextClose 0
	FadeIn 300ms 0x00000000
	_59
	FadeWait
	TextEnd null
	Return
