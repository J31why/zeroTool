fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if flag[1307]:
		CharFlagsUnset char[1] 0x0080
	elif flag[1362]:
	elif flag[1292]:
	elif flag[1282]:
	elif QuestTaskGet quest[22] 0:
		CharFlagsSet char[0] 0x0080
	elif flag[1280]:
		CharFlagsSet char[2] 0x0010
		CharFlagsUnset char[2] 0x0080
	if QuestTaskGet quest[22] 0 && !QuestTaskGet quest[22] 1:
		Event fn[0,8]
	Return

fn[2]:
	if !flag[1282] && QuestTaskGet quest[22] 0:
		LookPointFlagsSet look_point[0] 0x0001
	LookPointFlagsSet look_point[1] 0x0001
	if QuestTaskGet quest[34] 1 && !QuestTaskGet quest[34] 2 && !QuestFlagsGet quest[34] 0x40:
		LookPointFlagsUnset look_point[1] 0x0001
	Return

fn[3]:
	Call fn[0,4]
	Return

