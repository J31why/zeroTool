fn[5]:
	if flag[3]:
		if global[3] == 5:
			if !flag[0]:
				TextTalk char[0] {
					羅伊德團員，你聽說過這個傳聞嗎？{wait}
				}
				TextWait
				TextTalk char[0] {
					在克洛斯貝爾，棲息著傳說中的魚王
					──『霸王蛇魚』。{wait}
				}
				TextWait
				TextTalk char[0] {
					牠們以艾魯姆湖為主要棲息地，
					性情可謂兇殘非常，
					據說在從前，連漁民都懼怕牠們。{wait}
				}
				TextWait
				TextTalk char[0] {
					但是，最近這十幾年來，
					卻幾乎沒有人目擊過牠們……{wait}
				}
				TextWait
				TextTalk char[0] {
					如果能把這傢伙釣上來，
					毫無疑問就能得到榮譽勳章了……{wait}
				}
				TextWait
				FlagSet flag[0]
			else:
				TextTalk char[0] {
					『霸王蛇魚』簡直是
					魚王中的魚王……
					釣到那傢伙可是我們釣公師團的共同夢想。{wait}
				}
				TextWait
				TextTalk char[0] {
					雖然這十幾年來都沒有人目擊過牠們，
					但如果是已經成為『特級釣師』的你，
					說不定還真有可能將牠釣上來吧……{wait}
				}
				TextWait
		elif !flag[0]:
			TextTalk char[0] {
				不愧是羅伊德團員，
				都成了『釣聖』還這麼謙虛。{wait}
			}
			TextWait
			TextTalk char[0] {
				哇哈哈，我非常欣賞你！
				今天晚上不如去夜釣吧。{wait}
			}
			TextWait
			TextTalk char[0] {
				我們分部在舉辦聯歡會時，
				就經常會去夜釣！{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F哈哈，不好意思。
				今天晚上稍微有些不方便……{wait}
			} {
				下次如果有機會，
				我絕對樂意奉陪到底。{wait}
			}
			TextWait
			TextTalk char[0] {
				哇哈哈哈，連拒絕的方式都這麼謙遜有禮！{wait}
			}
			TextWait
			TextTalk char[0] {
				好吧！那等你有空時，就來和我說。
				到時候連同慶祝會一起，舉辦一場釣魚大賽吧。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				一定要慶祝羅伊德團員
				取得了『釣聖』的稱號啊。{wait}
			}
			TextWait
			TextTalk char[0] {
				到時候把你釣到霸王蛇魚的神勇經過
				慢慢說給我聽吧，哇哈哈哈！{wait}
			}
			TextWait
	elif flag[1307]:
		TextTalk char[0] {
			那麼，我今天也出去
			釣魚吧。{wait}
		}
		TextWait
		TextTalk char[0] {
			市內最近好像不是很太平，
			不然就去瑪因茲一帶好啦。{wait}
		}
		TextWait
	elif flag[1362]:
		TextTalk char[0] {
			聽說在克洛斯貝爾的某個地方，
			棲息著一種被稱為『魚王』
			的巨大魚類……{wait}
		}
		TextWait
		TextTalk char[0] {
			除此之外，也還有電鰻、
			魔鬼巨鯰等體型相當
			驚人的大型魚。{wait}
		}
		TextWait
		if global[3] < 5:
			TextTalk char[0] {
				……羅伊德團員，如果你有興趣，
				請一定去試著挑戰啊。{wait}
			}
			TextWait
		else:
			TextTalk char[0] {
				……羅伊德團員，如果你有興趣
				請一定要再去挑戰啊。{wait}
			}
			TextWait
	elif flag[1292]:
		if !flag[0]:
			TextTalk char[0] {
				釣公師團的團長是一位
				名叫費瑟爾的男爵。{wait}
			}
			TextWait
			TextTalk char[0] {
				本想趁著紀念慶典，
				請他來這裡看看的，
				但他的行程果然還是排不開啊……{wait}
			}
			TextWait
			TextTalk char[0] {
				團長先生現在大概
				也很忙吧。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				費瑟爾男爵為了在各國
				設立釣公師團的分部，
				正在四處奔波。{wait}
			}
			TextWait
			TextTalk char[0] {
				排程實在是太過緊湊，
				所以沒能把他請過來啊。{wait}
			}
			TextWait
	elif flag[1282]:
		if !flag[0]:
			TextTalk char[0] {
				昨天垂釣的收穫真是很棒呢！{wait}
			}
			TextWait
			TextTalk char[0] {
				羅伊德團員，就保持這種勢頭
				繼續努力吧！{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				雖說是紀念慶典，
				但釣魚也不能懈怠啊。{wait}
			}
			TextWait
			TextTalk char[0] {
				長時間把魚竿扔著不用的話，
				垂釣技術是會下降的，
				最好能保持每天都垂釣一下呢。{wait}
			}
			TextWait
	elif flag[1280]:
		if !flag[0]:
			TextTalk char[0] {
				……羅伊德團員，
				警察的工作很忙吧？{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F啊，是很忙呢……
				畢竟是在紀念慶典期間嘛。{wait}
			}
			TextWait
			TextTalk char[0] {
				是嗎……
				不好意思，提了奇怪的問題啊。{wait}
			}
			TextWait
			TextTalk char[0] {
				請不用在意，在本職工作上多努力吧。
				但閒暇時也不要忘了追求更大的垂釣成果啊！{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				羅伊德團員，不用在意我們的事，
				請在本職工作上多加努力吧。{wait}
			}
			TextWait
			TextTalk char[0] {
				當然，閒暇時也不要忘了
				追求更大的垂釣成果啊！{wait}
			}
			TextWait
	Return

fn[6]:
	TextStart self
	if flag[1280]:
		if !flag[1]:
			_Char4A char[0] 255
			TextTalk self {
				嗯，其實我也曾詢問過
				遊擊士艾絲蒂爾……{wait}
			}
			TextWait
			TextTalk char[0] {
				但有本職工作的團員
				果然都很忙吧……{wait}
			}
			TextWait
			TextTalk char[0] {
				在不妨礙本職工作的前提下盡情享受
				垂釣之趣，這是我們的基本理念。
				雖然很遺憾，但還是不要叫她了。{wait}
			}
			TextWait
			TextTalk self {
				呵呵，可是她自己吵著說
				無論如何也要參加呢。{wait}
			}
			TextWait
			TextTalk self {
				說是要把工作放下，暫時休假……{wait}
			}
			TextWait
			Emote char[0] 0mm 2000mm 2 7 80ms 1
			SoundPlay sound[28] 0 100 0
			Sleep 1000ms
			TextTalk char[0] {
				呵呵，那還真是令人期待啊。
				讓我們來個久違的大狂歡吧！{wait}
			}
			TextWait
			TextTalk name[0] {
				#0005F（？？？
				　……在說些什麼呢？）{wait}
			}
			TextWait
			_Char4B char[0] 255
			FlagSet flag[1]
		else:
			TextTalk self {
				呵呵，很令人期待吧。{wait}
			}
			TextWait
			TextTalk self {
				從上個月就開始計畫的重量級活動……
				大家一起來狂歡吧。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[7]:
	TextStart self
	if flag[1307]:
		if !QuestTaskGet quest[34] 2:
			TextTalk self {
				彼得先生和那位特級釣師
				好像去了米修拉姆的說。{wait}
			}
			TextWait
			TextTalk self {
				……嘖～
				本來還想和他
				再來一場垂釣比賽呢。{wait}
			}
			TextWait
		elif !flag[2]:
			TextTalk self {
				雖然不太瞭解具體狀況，
				但警察的工作也很辛苦的說～{wait}
			}
			TextWait
			TextTalk self {
				啊，請不用在意
				我啦。{wait}
			}
			TextWait
			TextTalk self {
				反正閑著也是閑著，我也出去
				釣釣魚好啦～{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			TextTalk self {
				彼得先生和那位特級釣師
				好像去了米修拉姆的說。{wait}
			}
			TextWait
			TextTalk self {
				我也沒事可做，
				乾脆找個地方打發時間好了～{wait}
			}
			TextWait
	TextEnd self
	Return

