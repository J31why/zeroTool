fn[15]:
	TextStart null
	FadeOut 300ms 0x00000000 100
	TextMessage null {
		{color 5}書架上放著書籍《簡單的魚類料理》。{wait}
	}
	TextWait
	if flag[561]:
		if !RecipeLearn 8:
			FadeOut 300ms 0x00000000 100
			TextSetPos -1 -1 -1 -1
			TextSetName ""
			SoundPlay sound[17] 0 100 0
			TextMessage null {
				#0C書裡寫著{item[422]}{color 0}的做法。{wait}
			}
			TextWait
