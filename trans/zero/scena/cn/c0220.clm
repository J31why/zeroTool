fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharWalkToPos self (6850, 1000, 14410) 2000mm/s 0
		Sleep 2000ms
		CharTurnTo self 90deg 500deg/s
		CharWalkToPos self (10890, 1000, 14410) 2000mm/s 0
		CharWalkToPos self (10890, 1000, 17280) 2000mm/s 0
		Sleep 2000ms
		CharTurnTo self 180deg 500deg/s
		CharWalkToPos self (10890, 1000, 14410) 2000mm/s 0
	Return

fn[2]:
	while 1:
		CharIdle self (9860, null, 12830) (12990, null, 15750) 1000mm/s
		Sleep 300ms
	Return

fn[3]:
	Fork name[0] fork[2]:
		CharColor self 0xFFFFFFFF 500ms
	Fork name[0] fork[1]:
		CharWalkToPos self (3850, 30, 680) 2000mm/s 0
	ForkWait name[0] fork[1]
	Fork name[0] fork[1]:
		CharWalkToPos self (5780, 30, 2800) 2000mm/s 0
	ForkWait name[0] fork[1]
	Sleep 100ms
	CharTurnTo name[0] 0deg 1000deg/s
	Return

