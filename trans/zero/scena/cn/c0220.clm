fn[8]:
	if flag[1792]:
		CharSetPos char[0] (7200, 1000, 18560) 0deg
		CharFlagsUnset char[0] 0x0080
		CharFlagsSet char[1] 0x0080
		CharSetPos char[2] (6750, 1020, 14000) 270deg
	elif flag[1566]:
		CharSetPos char[1] (6600, 140, 5500) 270deg
		CharFlagsSet char[2] 0x0080
		CharFlagsUnset char[4] 0x0080
	elif flag[1560]:
		CharSetPos char[0] (1930, 1020, 17480) 0deg
		CharFlagsUnset char[0] 0x0080
		CharFlagsSet char[1] 0x0080
		CharSetPos char[2] (930, 1000, 16580) 0deg
	elif flag[1554]:
		CharSetPos char[2] (11280, 1000, 14370) 0deg
		ForkFunc char[2] fork[0] fn[0,2]
	elif flag[1536]:
		CharSetPos char[2] (5010, 1020, 12770) 0deg
	elif flag[1342]:
		CharFlagsSet char[1] 0x0080
	elif flag[1307]:
		CharSetPos char[0] (5270, 1020, 12800) 270deg
		CharFlagsUnset char[0] 0x0080
		CharFlagsSet char[1] 0x0080
		CharSetPos char[2] (4180, 1020, 12800) 90deg
	elif flag[1294]:
		CharSetPos char[1] (6600, 140, 5500) 270deg
		CharFlagsUnset char[3] 0x0080
	elif flag[1362]:
		CharSetPos char[1] (6600, 140, 5500) 270deg
		CharFlagsUnset char[3] 0x0080
	elif flag[1292]:
		CharSetPos char[2] (6020, 1020, 15940) 270deg
	elif flag[1282]:
	elif flag[1280]:
		CharSetPos char[2] (5130, 1020, 12990) 0deg
	elif flag[1055]:
		CharSetPos char[0] (1930, 1020, 17480) 0deg
		CharFlagsUnset char[0] 0x0080
		CharFlagsSet char[1] 0x0080
		CharSetPos char[2] (13280, 1000, -1500) 180deg
	elif flag[1040]:
	elif flag[1031]:
	elif flag[1024]:
	elif flag[801]:
		CharSetPos char[0] (5270, 1020, 12800) 270deg
		CharFlagsUnset char[0] 0x0080
		CharFlagsSet char[1] 0x0080
		CharSetPos char[2] (4180, 1020, 12800) 90deg
	elif flag[777]:
		if (QuestTaskGet quest[8] 1 | QuestTaskGet quest[8] 2) && !QuestFlagsGet quest[8] 0x10:
			CharFlagsSet char[1] 0x0080
	elif flag[768]:
	elif flag[534]:
		CharFlagsSet char[2] 0x0080
	elif flag[533]:
		CharFlagsSet char[1] 0x0080
	elif flag[526]:
		CharFlagsSet char[1] 0x0080
	if flag[1566] && !flag[1792] && !flag[1603]:
		Event fn[0,26]
	elif flag[535] && !flag[536]:
		SystemFlagsSet 0x10000000
		Event fn[0,20]
	elif flag[1031] && !flag[1032]:
		SystemFlagsSet 0x10000000
		Event fn[0,25]
	Return

fn[9]:
	if system[4] == 3:
		EntranceSetDisabled entrance[0] 0
		EntranceSetDisabled entrance[3] 1
	else:
		EntranceSetDisabled entrance[0] 1
		EntranceSetDisabled entrance[3] 0
	if flag[1037] && !flag[1038]:
		MapColor 0x00C8D2FF 0ms
	elif flag[1792]:
		MapColor 0x00C8D2FF 0ms
	else:
	Return

fn[10]:
	TextStart self
	if flag[1792]:
		if !flag[1899]:
			Call fn[0,18]
		else:
			TextTalk self {
				#2200F有關魯巴徹商會
				的諮詢問題
				都由我來負責。{wait}
			} {
				我想應該可以暫時
				避免混亂擴散。{wait}
			} {
				但是，最多也只能維持一天……
				你們也要動作快點才行。{wait}
			}
			TextWait
	elif flag[1566]:
	elif flag[1560]:
		TextTalk self {
			#2200F接下來，
			我還有工作……
			但黑月那邊的事果然讓人在意啊。{wait}
		} {
			#2203F關於襲擊者相當異常的體能，
			我好像曾在『教團』事件中
			有所耳聞……{wait}
		} {
			#2200F哈哈，大概是記錯了吧。
			抱歉，說了些奇怪的話呢。{wait}
		}
		TextWait
		TextTalk name[2] {
			#0208F………………………………{wait}
		}
		TextWait
	elif flag[1554]:
	elif flag[1536]:
	elif flag[1307]:
		if !flag[0]:
			TextTalk char[0] {
				#2200F啊，是你們啊。
				我聽哈羅德先生說了，{wait}
			} {
				你們好像成功
				救出了柯林啊。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0012F嗯，總算是平安解決了。{wait}
			} {
				#0005F說起來……伊安律師。{wait}
			} {
				#0000F哈羅德先生所說的那位
				曾經關照過他的律師，莫非就是……？{wait}
			}
			TextWait
			TextTalk char[0] {
				#2202F哈哈，只是幫他
				做了下債務整理而已。{wait}
			} {
				#2203F那個時候，以黑手黨做後臺的
				無德高利貸者找他麻煩。{wait}
			} {
				#2200F因為利息高得太離譜了，
				所以我就稍微幫了他一下。{wait}
			}
			TextWait
			TextTalk name[1] {
				#0100F是這樣啊……{wait}
			}
			TextWait
			TextTalk name[3] {
				#0306F不過，竟然在這種事情中
				都能看到魯巴徹的影子啊。{wait}
			}
			TextWait
			TextTalk name[2] {
				#0211F他們還真是壞事做盡呢……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				#2200F唔，錢包帶了吧……{wait}
			} {
				今天畢竟是最後一天啊，
				我打算和彼特
				一起去逛一逛。{wait}
			} {
				從明天開始，又要有一大堆的工作了。
				偶爾也要
				養精蓄銳一下才行。{wait}
			}
			TextWait
	elif flag[1055]:
		if !flag[0]:
			TextTalk char[0] {
				#2200F啊，不好。
				找不到要用的資料了。{wait}
			} {
				#2203F今天也還有工作呢，
				再這樣下去會遲到的。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F伊安律師，您好像很忙啊。{wait}
			}
			TextWait
			TextTalk char[0] {
				#2200F嗯……因為下個月就是紀念慶典，
				找我諮詢的人也變多了。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				#2200F我並不是很擅長處理
				這類整理文件的工作呢。{wait}
			} {
				呼……還是讓彼特
				和我一起找吧。{wait}
			}
			TextWait
	elif flag[801]:
		if !flag[0]:
			Call fn[0,12]
		else:
			CharTurnToChar char[0] char[2] 0deg/s
			TextTalk self {
				#2203F那個……
				事情大概就是這樣。{wait}
			} {
				#2200F啊啊，是、是我的錯。
				原諒我吧，彼特。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[11]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if flag[1792]:
	elif flag[1566]:
		TextTalk self {
			#2200F以後如果又有失蹤者方面的諮詢，
			我會聯絡賽爾蓋的。{wait}
		} {
			#2203F……但是，看你們的反應，
			似乎不像是普通的失蹤事件啊。{wait}
		} {
			嗯……希望是我多慮了……{wait}
		}
		TextWait
	elif flag[1554]:
		if !flag[1646]:
			TextTalk self {
				#2200F哎呀，今天你們還真早啊。{wait}
			} {
				是碰到什麼麻煩事了嗎？
				如果要找我商量的話，正好有時間呢……{wait}
			}
			TextWait
			TextTalk name[0] {
				#0008F不，那個。{wait}
			} {
				#0001F伊安律師，其實是
				『黑月』的事務所
				好像遭到襲擊了。{wait}
			}
			TextWait
			Emote self 0mm 2000mm 2 7 80ms 1
			SoundPlay sound[28] 0 100 0
			Sleep 1000ms
			TextTalk self {
				#2205F怎麼會……
				這是真的嗎！？{wait}
			}
			TextWait
			if !flag[1555]:
				TextTalk name[3] {
					#0300F我們打算馬上
					就去現場看一下。{wait}
				} {
					感覺應該是魯巴徹的
					那幫傢伙忍耐不住，
					終於下手了。{wait}
				}
				TextWait
			else:
				TextTalk name[3] {
					#0300F我們之前去稍微
					查看了一下。{wait}
				} {
					魯巴徹那幫傢伙
					還用上了重型機關槍，
					看來是忍耐不住，終於下手了啊。{wait}
				}
				TextWait
			TextTalk self {
				#2203F唔，竟然在那種鬧區裡……{wait}
			} {
				#2201F而且……總覺得很難理解……{wait}
			}
			TextWait
			Emote field_party[0] 0mm 2000mm 38 38 250ms 1
			Emote field_party[1] 0mm 2000mm 38 38 250ms 1
			Emote field_party[2] 0mm 2000mm 38 38 250ms 1
			Emote field_party[3] 0mm 2000mm 38 38 250ms 1
			Sleep 1000ms
			TextTalk self {
				#2201F魯巴徹的行動方式似乎很奇怪。{wait}
			} {
				雖然能夠理解他們決定去
				襲擊競爭對手黑月，
				但總感覺這次的行動毫無計劃性……{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F說得對……
				我也是這麼想的。{wait}
			} {
				看起來，也不像是兩派黑手黨
				的全力火拼。{wait}
			}
			TextWait
			TextTalk self {
				#2201F嗯……總之，
				我也會留心的。{wait}
			} {
				既然發生了這種事情，
				來我這裡諮詢的公司也會變多，
				說不定能瞭解到什麼。{wait}
			}
			TextWait
			TextTalk name[1] {
				#0100F真不好意思，
				一直麻煩您。{wait}
			}
			TextWait
			FlagSet flag[1646]
		else:
			TextTalk self {
				#2203F竟然在鬧區發動襲擊……
				實在讓人難以理解啊……{wait}
			} {
				#2201F總之，擔心治安惡化
				的企業有很多，
				而黑月那邊也有可能進行報復……{wait}
			} {
				我會留心的。{wait}
			}
			TextWait
	elif flag[1536]:
		if !flag[1645]:
			TextTalk self {
				#2200F哦，是你們啊。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F伊安律師，好久不見了。{wait}
			} {
				……律師，您最近
				好像異常繁忙啊。
				今天也要出門嗎？{wait}
			}
			TextWait
			TextTalk self {
				#2201F嗯，最近這段時間，和黑手黨
				有關的糾紛變多了。{wait}
			}
			TextWait
			TextTalk name[1] {
				#0105F黑手黨……是魯巴徹嗎？{wait}
			}
			TextWait
			TextTalk self {
				#2203F嗯，而且很多
				都是非常危險的事件……{wait}
			} {
				地產投機，或是在歡樂街上當保鏢……{wait}
			} {
				#2200F在進行這種『交易』時，
				會突然對一般民眾動用私刑，
				最後害得他們被送進醫院。{wait}
			}
			TextWait
			TextTalk name[3] {
				#0301F嘖……那些黑手黨們
				就是恐嚇方面的專家啊。{wait}
			}
			TextWait
			TextTalk self {
				#2201F嗯，雖然的確如此……
				但總覺得情況有些奇怪……{wait}
			}
			TextWait
			Emote self 0mm 2000mm 24 27 250ms 0
			Sleep 1000ms
			EmoteStop self
			TextTalk self {
				#2201F你們是在市區裡巡邏嗎？
				那麼，請你們支援課
				也多注意一下吧。{wait}
			} {
				#2203F雖然大部分事情
				都會由各位遊擊士
				負責解決。{wait}
			}
			TextWait
			if system[10] != 8:
				Emote field_party[0] 0mm 2000mm 16 19 250ms 1
				SoundPlay sound[23] 0 100 0
			if system[11] != 8:
				Emote field_party[1] 0mm 2000mm 16 19 250ms 1
				SoundPlay sound[23] 0 100 0
			if system[12] != 8:
				Emote field_party[2] 0mm 2000mm 16 19 250ms 1
				SoundPlay sound[23] 0 100 0
			if system[13] != 8:
				Emote field_party[3] 0mm 2000mm 16 19 250ms 1
				SoundPlay sound[23] 0 100 0
			Sleep 1000ms
			TextTalk name[0] {
				#0000F是、是這樣啊，
				我們會儘量留心的。{wait}
			}
			TextWait
			TextTalk name[8] {
				#0500F（支援課的各位
				　也很辛苦啊……）{wait}
			}
			TextWait
			FlagSet flag[1645]
		else:
			TextTalk self {
				#2200F今天要去見那個
				遭到恐嚇的公司社長。{wait}
			} {
				#2203F除此之外還有好幾件事情……
				嗯，差不多要到
				傍晚才能回來。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F（真的很忙啊……）{wait}
			}
			TextWait
			TextTalk name[1] {
				#0100F（我們也注意一下
				　市區的狀況為好。）{wait}
			}
			TextWait
	elif flag[1303]:
		Call fn[0,13]
	elif flag[1294]:
		if !flag[1386]:
			TextTalk self {
				#2205F是羅伊德啊。
				今天沒和其他人在一起嗎？{wait}
			}
