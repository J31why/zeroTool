		}
		TextWait
		TextTalk char[1] {
			#2809F哈哈哈，你可真是與眾不同啊！{wait}
		} {
			#2803F但是，那份感性……
			如果丟棄的話，實在很可惜。{wait}
		} {
			#2801F──那我就直說吧。
			怎麼樣，要不要來我們ＩＢＣ呢！？{wait}
		}
		TextWait
		Emote char[0] 0mm 2000mm 38 38 250ms 1
		Sleep 1000ms
		CharSetChipPattern char[0] 1
		TextTalk char[0] {
			#3505F嗯……？
			說起來，總裁您……{wait}
		} {
