		TextTalk char[1] {
			#2801F──那我就直說吧。
			怎麼樣，要不要來我們ＩＢＣ呢！？{wait}
		}
		TextWait
		TextTalk char[0] {
			#3510F嗯～這個嘛。
			……要是按小時支付薪水的話……{wait}
		} {
			#3509F此外，如果還有
			加班補助和風險補助
			的話就更好了～！{wait}
		}
		TextWait
