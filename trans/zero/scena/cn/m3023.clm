	VisWait vis[0] 3
	TextTalk name[0] {
		#0006F我才想要問……{wait}
	} {
		#0001F佩戴這枚徽章的搜查官……
		果然是被你們殺害的吧？{wait}
	}
	TextWait
	TextTalk char[0] {
		#3002F#11P這、這個嘛，
		完全聽不懂你在說些什麼……{wait}
	} {
		#3004F哼，你們要是太過得意忘形，
		說不定就會遭遇和那傢伙一樣的下場哦。{wait}
	} {
		#3002F你們最好還是弄清自己的立場，
		用心照料好我們──{wait}
	}
