fn[7]:
	if flag[961]:
		Return
	EventBegin 1
	field_party[0].11 = 0
	field_party[1].11 = 0
	field_party[2].11 = 0
	field_party[3].11 = 0
	field_party[4].11 = 0
	field_party[5].11 = 0
	field_party[6].11 = 0
	field_party[7].11 = 0
