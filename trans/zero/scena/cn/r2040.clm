	CharSetChipPattern field_party[1] 0
	CharSetChipPattern field_party[2] 0
	CharSetChipPattern field_party[3] 0
	CharSetChipPattern field_party[4] 0
	CharSetChipPattern field_party[5] 0
	CharSetChipPattern field_party[6] 0
	CharSetChipPattern field_party[7] 0
	TextSetName ""
	TextMessage name[742] {
		{color 5}有大型魔獸在徘徊。{wait}
	}
	Menu menu[0] -1 -1 0
		"【動手擊退】" // 0
		"【放棄】" // 1
	MenuWait var[0]
	MenuClose menu[0]
	TextClose 0
	switch var[0]:
		case 1:
			Sleep 500ms
			CharSetPos2 field_party[0] (0, 22000, 71920) 0deg
			EventEnd 5
			Return
	ED7Battle battle[2] null 0 256 0 null
	ED7_E0 2
	EventBegin 1
	CamSetDistance 0 23000 71920 0ms
	CharSetPos2 field_party[0] (0, 22000, 71920) 0deg
	CharSetPos2 field_party[1] (0, 22000, 71920) 0deg
	CharSetPos2 field_party[2] (0, 22000, 71920) 0deg
	CharSetPos2 field_party[3] (0, 22000, 71920) 0deg
	CharSetPos2 field_party[4] (0, 22000, 71920) 0deg
	CharSetPos2 field_party[5] (0, 22000, 71920) 0deg
	CharSetPos2 field_party[6] (0, 22000, 71920) 0deg
	CharSetPos2 field_party[7] (0, 22000, 71920) 0deg
	switch system[3]:
		case 2:
			EventEnd 5
			Return
		case 1:
			ReturnToTitle 0
			Return
	EventBegin 1
	CharFlagsSet char[6] 0x0080
	TriggerFlagsSet trigger[0] 0x0080
	FadeWait
	Sleep 400ms
	SoundPlay sound[9] 0 100 0
	TextSetPos -1 -1 -1 -1
	FadeOut 300ms 0x00000000 100
	TextSetName ""
	TextMessage name[742] {
		{color 5}消滅了通緝魔獸！{wait}
	}
	TextWait
	TextClose 0
	FlagSet flag[961]
	QuestFlagsSet quest[11] 0x10
	QuestFlagsSet quest[11] 0x02
	QuestTaskSet quest[11] 0
	FadeIn 300ms 0x00000000
	TextSetPos -1 280 60 3
	EventEnd 5
	Return
