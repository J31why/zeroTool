fn[0]:
	while 1:
		ED7CharAnimation self 1000ms 0 1 2 3 4 5
	Return

fn[1]:
	Return

fn[2]:
	if system[4] != 1:
		CharFlagsSet char[6] 0x0080
		TriggerFlagsSet trigger[0] 0x0080
	elif !flag[961]:
		CharFlagsUnset char[6] 0x0080
		TriggerFlagsUnset trigger[0] 0x0080
	char[6].40 = 8
	CharFlags2Unset char[6] 0x0100
	char[6].7 = 2000
	if !flag[2084]:
		ObjFrame object[0] 0
	else:
		ObjFrame object[0] 30
	if !flag[2085]:
		ObjFrame object[1] 0
	else:
		ObjFrame object[1] 30
	LookPointFlagsSet look_point[2] 0x0001
	LookPointFlagsSet look_point[3] 0x0001
	if flag[983]:
		EffLoad eff[9] "event\\eva00_00.eff"
		EffPlay eff[9] eff_instance[9] null 0 (16410, 18000, 53460) 0 0 0 1000 1000 1000 null (0, 0, 0) 0ms
		LookPointFlagsUnset look_point[2] 0x0001
	elif flag[984]:
		EffLoad eff[9] "event\\eva00_00.eff"
		EffPlay eff[9] eff_instance[9] null 0 (57110, 36000, 119510) 0 0 0 1000 1000 1000 null (0, 0, 0) 0ms
		LookPointFlagsUnset look_point[3] 0x0001
	if !flag[805]:
		ZeroMap_3 1 1
	Return

fn[3]:
	ED7_F2 1
	SystemFlagsSet 0x08000000
	if !flag[2084]:
		SoundPlay sound[14] 0 100 0
		ED7ObjPlay object[0] 0 30 0 0
		Sleep 500ms
		if ItemAdd item[504] 1:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextSetName ""
			TextMessage name[742] {
				{color 0}已取得{item[504]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			TextSetPos -1 280 60 3
			FadeIn 300ms 0x00000000
			FlagSet flag[2084]
			ED7_DE 6
		else:
			FadeOut 300ms 0x00000000 100
			TextSetName ""
			TextMessage name[742] {
				寶箱內裝著{item[504]}{color 0}。
				但因持有物品已滿而放棄{item[504]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			SoundPlay sound[15] 0 100 0
			ED7ObjPlay object[0] 30 0 0 0
	else:
		FadeOut 300ms 0x00000000 100
		TextSetPos -1 -1 -1 -1
		TextSetName ""
		TextMessage name[742] {
			{0x06}{color 5}寶箱內空無一物。{color 0}{wait}
		}
		TextWait
		TextClose 0
		FadeIn 300ms 0x00000000
	Sleep 30ms
	TextEnd null
	SystemFlagsUnset 0x08000000
	Return

