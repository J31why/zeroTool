	}
	TextWait
	CharTurnTo name[0] 0deg 500deg/s
	TextTalk name[0] {
		#10100128V#0006F#5P哈～那可真是不得了啊。{wait}
	} {
		#10100129V#0000F而且……
		導力車的數量好像也明顯增加了。{wait}
	} {
		#10100130V三年前都還幾乎
		見不到一輛呢……{wait}
	}
	TextWait
	TextTalk char[15] {
		#10100131V呵呵，即使是現在，那終究也只是
		有錢人專用的奢侈品啊……{wait}
	}
	TextWait
	TextTalk char[15] {
		#10100132V不過說心裡話，導力巴士增加了班數，
		這倒真是一大幸事。{wait}
	}
	TextWait
	TextTalk char[15] {
		#10100133V像南邊的醫院，坐車的話
		只要三十分鐘左右就能到了。{wait}
	}
	TextWait
	TextTalk name[0] {
		#10100134V#0002F#5P嘿，那可真是比以前便利許多啊。{wait}
	} {
		#10100135V#0004F是嗎……
		僅僅三年，就有了如此大的變化。{wait}
	}
	TextWait
	TextTalk char[14] {
		#10100136V#12P那麼，就在這裡說再見吧。{wait}
	}
	TextWait
