	TextWait
	TextTalk char[14] {
		#10100125V#12P那是去年才剛剛開業的
		『導力商店』哦。{wait}
	}
	TextWait
	TextTalk char[14] {
		#10100126V#12P那家店不僅經營各種最新的導力製品，
		甚至連導力車都有銷售呢。{wait}
	}
	TextWait
	TextTalk char[14] {
		#10100127V#12P帝國產、共和國產、利貝爾產、
