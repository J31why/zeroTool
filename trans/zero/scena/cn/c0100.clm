fn[53]:
	TextTalk name[0] {
		#0005F啊……還是先去
		導力商店看看吧。{wait}
	} {
		#0000F就是街角的那個建築。{wait}
	}
	TextWait
	if system[10] == 2:
		TextTalk name[2] {
			#0200F瞭解。{wait}
		}
		TextWait
	elif system[10] == 3:
		TextTalk name[3] {
			#0300F瞭解，這就走吧。{wait}
		}
		TextWait
	elif system[10] == 1:
		TextTalk name[1] {
			#0100F是啊，那我們就去吧。{wait}
		}
		TextWait
	Return

