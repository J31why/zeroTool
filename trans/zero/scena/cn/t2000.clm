	TextTalk name[3] {
		#11P#0300F……好啦，工作就算是
		告一段落了吧？{wait}
	}
	TextWait
	TextTalk name[1] {
		#6P#0106F不管怎麼說……
		能找到啟動鑰匙，真是太好了。{wait}
	} {
		#0108F萬一被外人給撿到的話，可就……{wait}
	}
	TextWait
	TextTalk name[0] {
		#5P#0000F現在回想一下那個掉落的地方，
		從某種意義上說，或許算是幸運的呢。{wait}
	}
	TextWait
	TextTalk name[2] {
		#12P#0203F……應該說惡人反而有好運吧。{wait}
	} {
		#0200F說到底，那個司令要是能盡職一點，
		也就不會發生這樣的事情了。{wait}
	}
	TextWait
	TextTalk name[3] {
		#11P#0303F司令那傢伙，一直以來
		都只會考慮自己的事情，
		真是個不讓人省心的混蛋啊。{wait}
	} {
		#0301F如果我們找不到
		啟動鑰匙的話，
		他多半就會把責任推卸給米蕾優吧。{wait}
	}
	TextWait
	TextTalk name[1] {
		#6P#0106F……該怎麼說呢……
		真是個無可救藥的人呢。{wait}
	}
	TextWait
	TextTalk name[0] {
		#5P#0003F……確實如此。{wait}
	} {
		#0000F但是……警備隊中也有像
		副司令和准尉這種可靠的人。{wait}
	} {
		希望隊員們也好好努力，
		不要因現狀而氣餒啊。{wait}
	}
	TextWait
	TextTalk name[3] {
		#11P#0304F……哈哈，說得也是。{wait}
	} {
		#0300F好啦，羅伊德，
		我們也走吧。{wait}
	}
	TextWait
	TextTalk name[0] {
		#5P#0000F嗯，好的。{wait}
	}
