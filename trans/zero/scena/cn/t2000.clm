fn[12]:
	TextStart self
	if !flag[1120]:
		TextTalk self {
			這貝爾加德門可是
			守衛帝國方向國境的要塞哦。{wait}
		}
		TextWait
		Emote char[0] 0mm 2000mm 38 38 250ms 1
		Sleep 1000ms
		CharTurnToChar char[0] name[3] 300deg/s
		TextTalk self {
			哎呀……？
			你、你不是蘭迪嗎！？{wait}
		}
		TextWait
		TextTalk name[3] {
			#0300F……喲，好久不見啊。{wait}
		}
		TextWait
		TextTalk self {
			哈哈……你能再來，我很高興。
			還以為你再也不會
			出現在這邊了呢。{wait}
		}
		TextWait
		TextTalk self {
			總之，你就隨便看看吧。{wait}
		}
		TextWait
		FlagSet flag[1120]
	elif flag[1566]:
		TextTalk self {
			今晚計畫舉行夜間演習呢。{wait}
		}
		TextWait
		TextTalk self {
			我們平時也積攢了不少鬱憤，
			要借這次機會好好消解一下。{wait}
		}
		TextWait
	elif flag[1554]:
		TextTalk self {
			昨天，好像從
			唐古拉姆門那邊送來了
			那個遺跡的調查報告書。{wait}
		}
		TextWait
		TextTalk self {
			但司令那傢伙
			似乎根本就不想理會呢。{wait}
		}
		TextWait
	elif flag[1536]:
		if !flag[0]:
			CharTurnToChar char[0] name[3] 0deg/s
			TextTalk self {
				蘭迪，今天到底有什麼事情啊？{wait}
			}
			TextWait
			TextTalk name[3] {
				#0300F哦，你們放棄的那個
				遺跡的調查，
				現在由我們接手了。{wait}
			}
			TextWait
			TextTalk self {
				你、你說什麼……？{wait}
			}
			TextWait
			TextTalk name[3] {
				#0300F從聽來的流言判斷，
				似乎是司令大人硬推給
				唐古拉姆門那邊的啊。{wait}
			} {
				#0309F哈哈，功勞就由我們領受了，
				你活該。{wait}
			} {
				#0300F……麻煩你這樣轉告給司令。{wait}
			}
			TextWait
			TextTalk self {
				……你自己去說吧。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				不過……有你們和
				唐古拉姆門的隊員
