	_59
	TextTalk char[12] {
		#11P真沒想到，竟然
		掛在了那種地方……{wait}
	}
	TextWait
	TextTalk name[0] {
		#6P#0000F恐怕是司令
		在屋頂唱歌時，一時忘我，
		不慎掉落的吧。{wait}
	}
	TextWait
	TextTalk char[12] {
		#11P呼……不過，總算是萬幸，
		最後終於找到了。{wait}
	}
	TextWait
	TextTalk char[12] {
		#11P這下終於可以把
		裝甲車轉移到
		遊客看不到的地方了。{wait}
	}
	TextWait
	TextTalk char[12] {
		#11P蘭迪，那個……
		我算是欠了你一個人情呢。{wait}
	}
	TextWait
	TextTalk name[3] {
		#5P#0304F沒什麼大不了的啦。{wait}
	} {
		#0309F算啦，如果妳一定
		要還這個人情的話……
		就和我約會一次來銷帳吧。{wait}
	}
	TextWait
	TextTalk char[12] {
		#11P真是的……
		一點都沒變，還是像個傻瓜。{wait}
	}
	TextWait
	TextTalk char[12] {
		#11P……那麼，
		真是謝謝大家了。{wait}
	}
	TextWait
	TextTalk name[0] {
		#6P#0000F嗯，要是再有什麼事情的話，
		請儘管向我們提出支援請求吧。{wait}
	}
	TextWait
	TextTalk char[12] {
		#11P好的，一定。
		……那麼，我就先失陪了。{wait}
	}
	TextWait
