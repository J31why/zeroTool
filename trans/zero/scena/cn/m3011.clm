fn[7]:
	SystemFlagsSet 0x08000000
	if flag[1953]:
		TextStart null
		TextSetName ""
		TextMessage null {
			{color 5}拉杆好像已經不能動了。{wait}
		}
		TextWait
		TextClose 0
		_59
		SystemFlagsUnset 0x08000000
		TextEnd null
	else:
		EventBegin 1
		TextMessage null {
			{color 5}安裝著拉杆。
			扳動它嗎？{wait}
		}
		Menu menu[0] -1 -1 1
			"是" // 0
			"否" // 1
		MenuWait var[0]
		MenuClose menu[0]
		TextClose 0
		_59
		if var[0] == 0:
			CrossFade 500ms
			CharSetPos field_party[0] (165540, -18000, -37690) 180deg
			CharSetPos field_party[1] (166750, -18000, -36030) 180deg
			CharSetPos field_party[2] (165390, -18000, -35830) 180deg
			CharSetPos field_party[3] (166270, -18000, -35080) 180deg
			CamSetDistance 165160 -17000 -37720 0ms
			ED7CamRotate 45deg 25deg 0deg 0ms
			CamPers 340 0ms
			CamZoom 30000 0ms
			FadeWait
			SoundPlay sound[142] 0 100 0
			ED7ObjPlay object[12] 0 100 0 0
			ObjWait object[12]
			Sleep 500ms
			CrossFade 500ms
			CamSetDistance 167000 -23000 -36890 0ms
			ED7CamRotate 45deg 44deg 0deg 0ms
			CamPers 560 0ms
			CamZoom 30000 0ms
			FadeWait
			Sleep 500ms
			SoundPlay sound[155] 2 100 0
			ED7ObjPlay object[13] 0 60 0 0
			ObjWait object[13]
			SoundStop sound[155]
			SoundPlay sound[149] 0 100 0
			Shake 0 300 3000 200ms
			Sleep 1000ms
			FlagSet flag[1953]
		SystemFlagsUnset 0x08000000
		EventEnd 5
	Return
