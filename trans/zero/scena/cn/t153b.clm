fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if system[0] == 110 && flag[1804] && !flag[1806]:
		Event fn[0,13]
	elif system[0] == 104 && flag[1804] && !flag[1805]:
		Event fn[0,11]
	elif flag[1803] && !flag[1804]:
		SystemFlagsSet 0x10000000
		Event fn[0,10]
	Return

fn[2]:
	if flag[1805] && !flag[1822]:
		Call fn[0,12]
	ObjFlagsUnset object[0] 0x0010
	Return

fn[3]:
	TextStart self
	TextSetName ""
	TextMessage null {
		{color 5}黑手黨成員失去了意識。{color 0}{wait}
	}
	TextWait
	TextClose 0
	_59
	TextEnd self
	Return

fn[4]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	TextTalk self {
		樓上還有不少
		醫院的工作人員
		以及患者。{wait}
	}
	TextWait
	TextTalk self {
		那些人就
		拜託你們了……！{wait}
	}
	TextWait
	CharSetChipPattern self 0
	TextEnd self
	Return

fn[5]:
	TextStart self
	if !flag[0]:
		TextTalk self {
			以前魔獸作亂時建造的防護欄還在，
			所以我一直都很放心。{wait}
		}
		TextWait
		TextTalk self {
			但、但沒想到黑手黨
			竟然會入侵到醫院裡……{wait}
		}
		TextWait
		TextTalk self {
			這裡的醫生和學員來自大陸各國，
			如果不妥善處理，會演變成國際問題的……！{wait}
		}
		TextWait
		FlagSet flag[0]
	else:
		TextTalk self {
			本以為黑手黨應該稍微
			有些組織性的……{wait}
		}
		TextWait
		TextTalk self {
			在這種情況下……
			不妥善處理的話，就會演變成國際問題的……！{wait}
		}
		TextWait
	TextEnd self
	Return

fn[6]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if !flag[1]:
		TextTalk self {
			對、對了。
			從今天傍晚開始，
			就要給病人看病……{wait}
		}
		TextWait
		TextTalk self {
			在這樣的騷亂中，就算有人
			突然發病也不足為奇……
			該怎麼辦呢……！{wait}
		}
		TextWait
		TextTalk self {
			總、總之，我們作為醫生，
			要先冷靜下來……{wait}
		}
		TextWait
		FlagSet flag[1]
	else:
		TextTalk self {
			說起來，今天的安排是傍晚
			給輕微發病的患者
			診斷病情。{wait}
		}
		TextWait
		TextTalk self {
			唔……希望病人的發病
			不要變得更加嚴重啊……{wait}
		}
		TextWait
	CharSetChipPattern self 0
	TextEnd self
	Return

fn[7]:
	TextStart self
	if !flag[2]:
		TextTalk self {
			面對這種異常事態，
			我的心情卻意外地平靜。{wait}
		}
		TextWait
		TextTalk self {
			這或許要歸功於一直在冷靜沉著的
			貝爾達因醫生手下學習吧。{wait}
		}
		TextWait
		TextTalk self {
			……希望醫生也能平安無事啊……{wait}
		}
		TextWait
		FlagSet flag[2]
	else:
		TextTalk self {
			……畢竟是這時間，
			那些前來醫院就診的患者們
			很可能也被捲進來了。{wait}
		}
		TextWait
		TextTalk self {
			……連槍聲都能聽得到，
			住宿設施那邊也很讓人擔心啊……{wait}
		}
		TextWait
	TextEnd self
	Return

fn[8]:
	TextStart self
	if !flag[3]:
		TextTalk self {
			竟然襲擊擁有最新醫療技術的
			烏爾斯拉醫院，
			真是群愚蠢的傢伙們！{wait}
		}
		TextWait
		TextTalk self {
			而且他們……
			竟然攜帶著武器
			闖入醫院。{wait}
		}
		TextWait
		TextTalk self {
			如果把正在進行試驗的機器弄壞，
			會給醫療事業的未來造成巨大損失！{wait}
		}
		TextWait
		FlagSet flag[3]
	else:
		TextTalk self {
			真是完全搞不懂他們的目的，
			為什麼要襲擊這裡呢……{wait}
		}
		TextWait
		TextTalk self {
			總而言之，
			只能希望女神保佑
			院內的機器不要被破壞了……{wait}
		}
		TextWait
	TextEnd self
	Return

fn[9]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if !flag[4]:
		CharSetChipPattern self 0
		TextTalk self {
			……別慌，要冷靜下來，芙蘿拉。{wait}
		}
		TextWait
		TextTalk self {
			因、因為這點小事就方寸大亂的話，
			是沒法成為一名合格的醫生的……{wait}
		}
		TextWait
		FlagSet flag[4]
	else:
		TextTalk self {
			……我想冷靜下來。{wait}
		}
		TextWait
		TextTalk self {
			抱歉，不好意思……
			能讓我一個人待會嗎？{wait}
		}
		TextWait
	CharSetChipPattern self 0
	TextEnd self
	Return

