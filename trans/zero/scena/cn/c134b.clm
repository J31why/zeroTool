		} {
			#2901F但無奈的是，手段終究還是不夠啊。{wait}
		} {
			最重要的是，無論是對方的真實身份，
			還是對方的目的，我們都還沒有完全搞清，
			所以也無法採取恰當的行動啊。{wait}
		}
		TextWait
		TextTalk name[0] {
			#0008F首先還是要努力把握情況呢。{wait}
		} {
			#0006F然後就是思考對手的下一步動作，
			並採取最有效的對策……
			大概就是這樣吧。{wait}
		}
		TextWait
		TextTalk char[1] {
			#2905F……難得我們想法一致呢。{wait}
		} {
			#2904F算了，先這樣吧。
			關於通訊網路的恢復，
