				無論如何都要妨礙一下。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0006F（好像在說什麼讓人不安的話……）{wait}
			}
			TextWait
	elif flag[1]:
		TextTalk char[1] {
			#2904F關於通訊網路的恢復，
			我已經向技術部發出指示了，
			稍後應該就能有所進展了吧。{wait}
		} {
			#2900F……總之，現在的首要任務
			就是努力弄清眼下的情況啊。{wait}
		}
		TextWait
	else:
		TextTalk char[1] {
			#2903F雖然已經考慮過好幾個打破
