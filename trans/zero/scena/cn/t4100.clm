fn[4]:
	TextStart self
	if QuestFlagsGet quest[46] 0x10 && flag[2]:
		if !flag[0]:
			TextTalk self {
				你們……
				調查過那塊墓碑了吧。{wait}
			}
			TextWait
			TextTalk self {
				在很久以前，
				那塊墓碑上刻著名字的部分
				就已經變得模糊不清了。{wait}
			}
			TextWait
			TextTalk self {
				那到底是
				誰的墓呢……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				就算是每天都來掃墓的我，
				也從沒看見那塊墓碑
				前有人來過。{wait}
			}
			TextWait
			TextTalk self {
				那塊墓碑到底
				是誰的呢……{wait}
			}
			TextWait
		TextEnd self
		Return
	if flag[1566]:
		if !flag[0]:
			TextTalk self {
				經常有人提醒我說，
				我只是在已故之人的束縛下
				浪費餘生……{wait}
			}
			TextWait
			TextTalk self {
				……呵呵，但是
				為了不忘記這個人，
				我只有一直來這裡，不是嗎？{wait}
			}
			TextWait
			TextTalk self {
				所以，我想我今後
				仍然會繼續來掃墓。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				不管別人怎麼說……
				我今後也會時常
				來探望他。{wait}
			}
			TextWait
			TextTalk self {
				因為這是陰陽相隔的夫婦
				僅有的維繫了……{wait}
			}
			TextWait
	elif flag[1554]:
		TextTalk self {
			人與人的鬥爭是件很悲哀的事情……{wait}
		}
		TextWait
		TextTalk self {
			一旦出現組織或者國家之間的戰爭，
			就肯定會將無辜的人捲進去。{wait}
		}
		TextWait
		TextTalk self {
			就像利貝爾的女王陛下
			提出了《不戰條約》一樣……
			希望大家都能思考和平解決問題的方法。{wait}
		}
		TextWait
	elif flag[1536]:
		TextTalk self {
			守墓人每天都像那樣
			守護著每個墓地。{wait}
		}
		TextWait
		TextTalk self {
			儘管墓碑僅僅只是一個標記……
			但是安眠於此的人們一定會高興的。{wait}
		}
		TextWait
	elif flag[1342]:
		if !flag[0]:
			CharTurnTo self 0deg 0deg/s
			TextTalk self {
				…………………………{wait}
			}
			TextWait
			TextTalk name[82] {
				#1110F……老婆婆，
				你閉著眼睛在幹什麼呀？{wait}
			}
			TextWait
			CharTurnToChar self field_party[0] 500deg/s
			TextTalk self {
				哎……？{wait}
			}
			TextWait
			TextTalk name[0] {
				#0005F這可不好……！
				不可以打擾人家，琪雅……！{wait}
			}
			TextWait
			TextTalk self {
				呵呵，沒關係的。{wait}
			}
			TextWait
			TextTalk self {
				……我的丈夫在這裡長眠，
				所以我在為他祈禱。{wait}
			}
			TextWait
			TextTalk name[82] {
				#1106F祈禱…………{wait}
			}
			TextWait
			TextTalk self {
				對……只要來到這裡，
				我就覺得能夠跟他說上話呢……{wait}
			}
			TextWait
			FlagSet flag[0]
		elif flag[1346]:
			TextTalk self {
				好了……
				差不多該回家了吧。{wait}
			}
			TextWait
			TextTalk self {
				再見啦……我還會來看你的。{wait}
			}
			TextWait
		else:
			TextTalk self {
				呵呵……
				似乎很久沒有跟你這樣的孩子
				說過話了呢。{wait}
			}
			TextWait
			TextTalk self {
				我的兒子住在國外……
				你讓我想起那孩子小時候的樣子了呢。{wait}
			}
			TextWait
	elif flag[1307]:
		if !flag[0]:
			TextTalk self {
				克洛斯貝爾成立後的第七十年
				即將平靜地過去……{wait}
			}
			TextWait
			TextTalk self {
				……今天就在這裡
				眺望一會景色，
				平靜度過吧。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				……今天就在這裡
				平靜地度過吧。{wait}
			}
			TextWait
	elif flag[1292]:
		if !flag[0]:
			TextTalk self {
				昨天晚上已經悠閒地在
				熱鬧的大街上散過步了。{wait}
			}
			TextWait
			TextTalk self {
				被霓虹燈點亮的街道
				真的非常漂亮。{wait}
			}
			TextWait
			TextTalk self {
				呵呵……如果可以的話，
				真想跟我丈夫一起去散步呢。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				克洛斯貝爾市的美麗夜景……
				如果可以的話，
				真想跟我丈夫一起欣賞呢。{wait}
			}
			TextWait
	elif flag[1282]:
		if !flag[0]:
			TextTalk self {
				昨天來祈禱的時候，
				守墓的老人
				跟我說話了。{wait}
			}
			TextWait
			TextTalk self {
				我開始覺得，一直在這裡祈禱的話，
				不就白白浪費了
				難得的紀念慶典嗎……{wait}
			}
			TextWait
			TextTalk self {
				所以今天晚上我打算好好去
				欣賞下克洛斯貝爾的夜景。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				我開始覺得，一直在這裡祈禱的話，
				不就白白浪費了
				難得的紀念慶典嗎……{wait}
			}
			TextWait
			TextTalk self {
				雖然有點對不起長眠於此的丈夫……
				但今天就讓我好好享受一下吧。{wait}
			}
			TextWait
	elif flag[1280]:
		CharTurnTo self 0deg 0deg/s
		if !flag[0]:
			TextTalk self {
				…………………………{wait}
			}
			TextWait
			TextTalk name[0] {
				#0001F（正在專心祈禱呢……）{wait}
			}
			TextWait
			TextTalk name[1] {
				#0108F（……打擾到人家就不太好了，
				　我們走吧。）{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				…………………………{wait}
			}
			TextWait
	elif flag[1040]:
		if !flag[0]:
			TextTalk self {
				我的丈夫在三十年前的戰爭中
				離開了這個世界。{wait}
			}
			TextWait
			TextTalk self {
				那個人與我吵架而離開家後，
				便突然被捲入了戰鬥裡……
				結果我連他最後一眼都沒有看到。{wait}
			}
			TextWait
			TextTalk self {
				……你們應該也有珍視的人吧？{wait}
			}
			TextWait
			TextTalk self {
				千萬不要像我一樣，
				與對方留下永遠無法挽回的遺憾。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				……你們應該也有珍視的人吧？{wait}
			}
			TextWait
			TextTalk self {
				千萬不要像我一樣，
				與對方留下永遠無法挽回的遺憾。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1024]:
		if !flag[0]:
			TextTalk self {
				……我的丈夫大約在三十年前
				被捲入了
				帝國與共和國的戰爭中。{wait}
			}
			TextWait
			TextTalk self {
				雖然平時一直都在吵架，
				但他去世之後
				還真是寂寞啊……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				雖說都是三十年前
				那場戰爭的錯……{wait}
			}
			TextWait
			TextTalk self {
				但是他去世之後
				還真是寂寞啊……{wait}
			}
			TextWait
	elif flag[801]:
		CharTurnTo self 0deg 0deg/s
		if !flag[0]:
			TextTalk self {
				…………………………{wait}
			}
			TextWait
			CharTurnToChar self field_party[0] 500deg/s
			TextTalk self {
				哎呀，對不起。
				沒有注意到你們在這裡。{wait}
			}
			TextWait
			TextTalk self {
				因為剛才正在虔心祈禱……
				請不要介意哦。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				…………………………{wait}
			}
			TextWait
			TextTalk name[1] {
				#0105F（正在專心祈禱呢……）{wait}
			} {
				#0108F（……打擾到人家就不太好了，
				　我們走吧。）{wait}
			}
			TextWait
	TextEnd self
	Return

fn[5]:
	TextStart self
	if flag[1792]:
	elif flag[1566]:
	elif flag[1554]:
	elif flag[1536]:
		if !flag[1]:
			TextTalk self {
				我將所有墓碑都打掃了一遍。{wait}
			}
			TextWait
			TextTalk self {
				這麼多的墓碑，
				其中也有不少是無人打掃的。
				……真是件可悲的事情呢。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				這麼多的墓碑，
				其中也有不少是無人打掃的。{wait}
			}
			TextWait
			TextTalk self {
				雖然不來掃墓的人大概都各有苦衷……
				但這片寂寞的土地中有靈魂在沉睡著。
				真希望大家平常能夠抽時間來看看啊。{wait}
			}
			TextWait
	elif flag[1346]:
		TextTalk self {
			……就算是主日學校的孩子們，
			也不太願意接近墓地這種地方呢……{wait}
		}
		TextWait
		CharTurnToChar self name[82] 500deg/s
		TextTalk self {
			哈哈哈，這位小姑娘真是特別啊。{wait}
		}
		TextWait
