fn[8]:
	EventBegin 0
	CrossFade 500ms
	CamSetDistance 4730 1500 0 0ms
	ED7CamRotate 0deg 27deg 0deg 0ms
	CamPers 260 0ms
	CamZoom 26660 0ms
	CharSetPos name[0] (2750, 0, -1250) 45deg
	CharSetPos name[1] (2100, 0, -600) 45deg
	CharSetPos name[2] (1750, 0, -2250) 45deg
	CharSetPos name[3] (1100, 0, -1600) 45deg
	FadeWait
	TextTalk char[4] {
		#0905F那麼，哈羅德先生
		您是在七年前創建了如今的貿易公司……？{wait}
	}
	TextWait
