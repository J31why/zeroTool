fn[5]:
	TextStart self
	if flag[1566]:
		TextTalk self {
			琦咪等下要去給
			礦工叔叔們送慰問品哦。{wait}
		}
		TextWait
		TextTalk self {
			爸爸說，琦咪送去的話，
			大家會很開心，
			所以才要我去送。{wait}
		}
		TextWait
		TextTalk self {
			嘿嘿，其實爸爸
			是個很容易害羞的人呢～{wait}
		}
		TextWait
	elif flag[1554]:
		TextTalk self {
			礦工叔叔們啊～
			都對琦咪很好哦。{wait}
		}
		TextWait
		TextTalk self {
			大家都說
			很尊敬爸爸！
			嘿嘿～{wait}
		}
		TextWait
	elif flag[1547]:
		TextTalk self {
			今天的晚飯會是什麼呢♪{wait}
		}
		TextWait
	elif flag[1544]:
		TextTalk self {
			琦咪最喜歡
			幫爸爸的忙了。{wait}
		}
		TextWait
	elif flag[1536]:
		TextTalk self {
			爸爸他啊～以前當過礦工，
			所以很關心現在的礦工們。{wait}
		}
		TextWait
		TextTalk self {
			偶爾還會給缺錢的礦工
			送些食材呢。{wait}
		}
		TextWait
	elif flag[1307]:
		TextTalk self {
			爸爸說，今天晚上
			要關店出去玩。{wait}
		}
		TextWait
		TextTalk self {
			紀念慶典期間一直很忙，
			希望他能好好開心一下啊。{wait}
		}
		TextWait
	elif flag[1292]:
		TextTalk self {
			所謂的耀晶石，
			就是七耀石的碎片哦。{wait}
		}
		TextWait
		TextTalk self {
			我知道的很多吧，嘿嘿。{wait}
		}
		TextWait
	elif flag[1282]:
		TextTalk self {
			好想看看
			爸爸當礦工時的樣子啊～{wait}
		}
		TextWait
	elif flag[1280]:
		if !flag[1]:
			TextTalk self {
				爸爸
				本來不太高興，
				不過今天好像已經恢復了。{wait}
			}
			TextWait
			TextTalk self {
				嘿嘿，
				一定是因為琦咪支持他的緣故吧。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				爸爸
				本來不太高興，
				不過好像又有精神了。{wait}
			}
			TextWait
	elif flag[1040]:
		TextTalk self {
			哈羅德叔叔他啊～
			在看著琦咪的時候，
			表情好像總有點悲傷。{wait}
		}
		TextWait
		TextTalk self {
			發生過什麼事呢……？{wait}
		}
		TextWait
	elif flag[1024]:
		if !flag[1]:
			TextTalk self {
				紀念慶典快到了，
				爸爸好像卻
				不太高興。{wait}
			}
			TextWait
			TextTalk self {
				難道是琦咪做了什麼壞事嗎？{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				只要一提到紀念慶典，
				爸爸就會不高興。{wait}
			}
			TextWait
	elif flag[813]:
	elif flag[812]:
		if !flag[1]:
			TextTalk self {
				爸爸以前
				也是礦工哦。{wait}
			}
			TextWait
			TextTalk self {
				身材也很高大健壯，
				聽說是鎮上最棒的礦工呢。
				很厲害吧。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				聽說爸爸
				以前是鎮上最棒的礦工。
				很厲害吧。{wait}
			}
			TextWait
	elif flag[801]:
		if !flag[823]:
			FlagSet flag[823]
			global[2] = global[2] + 1
		if !flag[1]:
			TextTalk self {
				幫忙，幫忙♪{wait}
			}
			TextWait
			TextTalk self {
				爸爸雖然
				對鎮上的人很凶，
				但是對我很溫柔哦。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				爸爸對我
				很溫柔的，
				所以不要怕他哦。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[6]:
