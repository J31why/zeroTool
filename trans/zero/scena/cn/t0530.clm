fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if !flag[1055] && flag[1040]:
		CharFlagsUnset char[2] 0x0080
		CharFlagsUnset char[3] 0x0080
		CharFlagsUnset char[4] 0x0080
		if flag[1187]:
			CharTurnToChar char[2] char[3] 0deg/s
			CharTurnToChar char[4] char[3] 0deg/s
	if flag[1280] && !flag[1536]:
		CharFlagsUnset char[5] 0x0080
	Return

fn[2]:
	if flag[812] && !flag[1024]:
		MapColor 0x00C8D2FF 0ms
	elif flag[1547] && !flag[1548]:
		MapColor 0x00C8D2FF 0ms
	Return

fn[3]:
	Call fn[0,4]
	Return

fn[4]:
	TextStart char[0]
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"對話" // 0
			"購物" // 1
			"放棄" // 2
		MenuWait var[0]
		if var[0] != 1:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			if flag[1280]:
				ShopOpen shop[86]
			elif flag[1024]:
				ShopOpen shop[85]
			elif flag[768]:
				ShopOpen shop[87]
			else:
				ShopOpen shop[85]
			var[0] = 99
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			if flag[1566]:
				if !flag[0]:
					TextTalk char[0] {
						又是被魔獸襲擊，又是失蹤……
						礦工們還真是不幸啊。{wait}
					}
					TextWait
					TextTalk char[0] {
						霍夫曼那傢伙，在這種時候
						才更應該保持鎮定啊。{wait}
					}
					TextWait
					TextTalk char[0] {
						這正是礦山長發揮能力的時候哦。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[0] {
						……我要不是因為腳受了傷，
						也可以去幫礦工們的忙……{wait}
					}
					TextWait
					TextTalk char[0] {
						不，礦山長已經是霍夫曼了。
						他們一定能夠
						自己解決問題的吧。{wait}
					}
					TextWait
			elif flag[1554]:
				TextTalk char[0] {
					岡茲那傢伙，竟然讓鎮長
