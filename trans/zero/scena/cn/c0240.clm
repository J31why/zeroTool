			ED7_76_1 object[255] "huku_nugippa" 1
			ED7_76_1 object[255] "model5" 1
	LookPointFlagsSet look_point[1] 0x0001
	LookPointFlagsSet look_point[2] 0x0001
	if QuestTaskGet quest[29] 1 && !QuestFlagsGet quest[29] 0x10 && !QuestFlagsGet quest[29] 0x40:
		LookPointFlagsUnset look_point[1] 0x0001
		LookPointFlagsUnset look_point[2] 0x0001
	TriggerFlagsSet trigger[0] 0x0080
	if QuestTaskGet quest[29] 9 && !QuestFlagsGet quest[29] 0x10 && !QuestFlagsGet quest[29] 0x40:
		TriggerFlagsUnset trigger[0] 0x0080
	if QuestTaskGet quest[29] 1 && !QuestFlagsGet quest[29] 0x10 && !QuestFlagsGet quest[29] 0x40:
		EntranceSetFunc entrance[8] fn[0,36]
	if system[4] == 3:
		EntranceSetDisabled entrance[0] 0
		EntranceSetDisabled entrance[8] 1
		EntranceSetDisabled entrance[7] 0
		EntranceSetDisabled entrance[9] 1
	else:
