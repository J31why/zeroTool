fn[7]:
	if flag[11]:
		system[1] = 0
		FlagUnset flag[11]
	char[10].51 = 1000
	if !flag[1536] && flag[1342]:
		char[10].51 = 1500
		Emote char[10] 0mm 2000mm 28 33 250ms 0
	ObjFlagsUnset object[2] 0x0010
	LookPointFlagsUnset look_point[0] 0x0001
	if flag[1554]:
	elif flag[1536]:
	elif flag[1342]:
		ObjFlagsSet object[2] 0x0010
