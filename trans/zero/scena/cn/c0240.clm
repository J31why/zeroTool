	elif flag[1280]:
	elif flag[1055]:
		ObjFlagsSet object[2] 0x0010
		LookPointFlagsSet look_point[0] 0x0001
	elif flag[1040]:
		ObjFlagsSet object[2] 0x0010
		LookPointFlagsSet look_point[0] 0x0001
	ED7_76_0 object[255] "huku_nugippa" 1
	ED7_76_0 object[255] "model5" 1
	ED7_76_0 object[255] "bed_event" 1
	if flag[1536]:
