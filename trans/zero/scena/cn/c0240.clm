		EntranceSetDisabled entrance[7] 1
		EntranceSetDisabled entrance[9] 0
	if flag[1037] && !flag[1038]:
		MapColor 0x00C8D2FF 0ms
	elif flag[1792]:
		MapColor 0x00C8D2FF 0ms
	else:
	Return

fn[8]:
	TextStart self
	if QuestTaskGet quest[29] 3 && !QuestFlagsGet quest[29] 0x10 && !QuestFlagsGet quest[29] 0x40:
		if !QuestTaskGet quest[29] 4:
			if !flag[10]:
				TextTalk name[0] {
					#0001F（好，開始詢問線索吧。）{wait}
				} {
					#0000F打擾一下，
					能佔用您一點時間嗎？{wait}
				}
				TextWait
			FlagSet flag[10]
			FadeOut 300ms 0x00000000 100
			TextSetName ""
			TextMessage null {
				{color 5}羅伊德等人就跟蹤狂一事
				向對方進行了詢問。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			_59
			TextTalk self {
				……你說的是跟蹤狂那件事啊。
				我作為這裡的管理員，
				警惕性一直很高。{wait}
			}
			TextWait
			TextTalk name[1] {
				#0100F您親眼見到過
				跟蹤狂嗎？{wait}
			}
			TextWait
			TextTalk self {
				我每天
				都會到這裡看看，
				但基本沒見過呢。{wait}
			}
			TextWait
			TextTalk self {
				只有前些天看到過一次。{wait}
			}
			TextWait
			TextTalk self {
				是個把帽檐壓得很低的少年，
				因為他很快就走掉了，
				所以我也沒有看得太清楚。{wait}
			}
			TextWait
			TextTalk name[2] {
				#0200F您還能想起其它特徵嗎？{wait}
			}
			TextWait
			TextTalk self {
				這個嘛……{wait}
			}
			TextWait
			TextTalk self {
				非要說的話，
				完全沒有特徵……也算是特徵吧。{wait}
			}
			TextWait
			Emote field_party[0] 0mm 2000mm 0 1 250ms 2
			SoundPlay sound[29] 0 100 0
			Emote field_party[1] 0mm 2000mm 0 1 250ms 2
			SoundPlay sound[29] 0 100 0
			Emote field_party[2] 0mm 2000mm 0 1 250ms 2
			SoundPlay sound[29] 0 100 0
			Emote field_party[3] 0mm 2000mm 0 1 250ms 2
			SoundPlay sound[29] 0 100 0
			Sleep 1000ms
			TextTalk self {
				也不知是不是因為他穿著太過樸素，
				反正我是一點特別的印象都沒有。{wait}
			}
			TextWait
			TextTalk name[3] {
				#0303F呃，竟然會這樣……{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F不過，從莉夏那裡聽來的情報
				似乎沒錯……{wait}
			}
			TextWait
			QuestTaskSet quest[29] 4
			if QuestTaskGet quest[29] 4 && QuestTaskGet quest[29] 5 && QuestTaskGet quest[29] 6 && QuestTaskGet quest[29] 7 && QuestTaskGet quest[29] 8:
				TextTalk name[0] {
					#0000F好，調查就到此結束吧。{wait}
				} {
					先回伊莉雅小姐的房間，
					整理一下目前的情報好了。{wait}
				}
				TextWait
				TextTalk name[3] {
					#0300F好的，差不多也該擬定對策了！！{wait}
				}
				TextWait
				TriggerFlagsUnset trigger[0] 0x0080
				QuestTaskSet quest[29] 9
		else:
			TextTalk self {
				我看到的是一個
				帽檐壓得很低的少年，
				沒能看清他的長相。{wait}
			}
			TextWait
			TextTalk self {
				另外，我記得
				他的穿著打扮非常普通。{wait}
			}
			TextWait
			TextTalk self {
				我連一點特別的印象都沒有。{wait}
			}
			TextWait
	elif flag[1792]:
		if !flag[0]:
			TextTalk self {
				好了，該工作了……{wait}
			}
			TextWait
			TextTalk self {
				這也是為了把工資攢起來，
				去看伊莉雅小姐的表演……{wait}
			}
			TextWait
			TextTalk self {
				要是能買到下個月左右
				的門票就好了～{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				無論是做垃圾分類還是打掃水溝，
				都是為了能見到伊莉雅小姐……{wait}
			}
			TextWait
			TextTalk self {
				好了，再努力一下吧。{wait}
			}
			TextWait
	elif flag[1566]:
		if !flag[0]:
			TextTalk self {
				前段時間，我第一次看到
				住在三樓的人，雖然只是個背影。{wait}
			}
			TextWait
			TextTalk self {
				因為她正往外走，
				所以也沒怎麼看清楚……{wait}
			}
			TextWait
			TextTalk self {
				不過，是個感覺很
				普通的人。{wait}
			}
			TextWait
			TextTalk self {
				雖然她的金髮很漂亮。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				不過，對於愛打扮的女性來說，
				也沒什麼大不了的。{wait}
			}
			TextWait
			TextTalk self {
				嗯，從背影來看，
				是個很普通的人呢，真意外啊。{wait}
			}
			TextWait
	elif flag[1554]:
		if !flag[0]:
			TextTalk self {
				好了，工作工作……{wait}
			}
			TextWait
			TextTalk self {
				還得存錢去看
				彩虹劇團的表演呢。{wait}
			}
			TextWait
			TextTalk self {
				我可是為了去看那個，
				才會這麼努力工作呢！{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				這一切都是為了能見到伊莉雅小姐……{wait}
			}
			TextWait
			TextTalk self {
				今天也要努力工作！{wait}
			}
			TextWait
	elif flag[1536]:
		if !flag[0]:
			TextTalk self {
				那個住在三樓的人，最近似乎
				留小孩在家裡過夜呢。{wait}
			}
			TextWait
			TextTalk self {
				我沒和住在三樓的那位打過照面，
				但時常能見到那個孩子。{wait}
			}
			TextWait
			TextTalk self {
				戴著帽子，十三四歲左右，
				是個挺好看的小孩子。{wait}
			}
			TextWait
			Emote self 0mm 2000mm 38 38 250ms 1
			Sleep 500ms
			TextTalk self {
				…………咦？
				說起來，之前好像在哪裡
				見過那個孩子呢……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				嗯～好像在哪裡
				見到過那個孩子……{wait}
			}
			TextWait
			TextTalk self {
				……呃，算了。
				身為管理員，
				管太多閒事也不好啊。{wait}
			}
			TextWait
	elif flag[1342]:
		if !flag[0]:
			TextTalk self {
				唔……！！{wait}
			}
			TextWait
			TextTalk self {
				伊莉雅小姐實在是太棒了！{wait}
			}
			TextWait
			TextTalk self {
				另外……扮演『月之姬』
				的那個演員也很厲害。{wait}
			}
			TextWait
			TextTalk self {
				聽說她還只是個新人，
				但我已經完全迷上她了！{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				不過……伊莉雅小姐
				究竟住在什麼地方呢？{wait}
			}
			TextWait
