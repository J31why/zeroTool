fn[12]:
	TextStart char[4]
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"對話" // 0
			"休息" // 1
			"放棄" // 2
		MenuWait var[0]
		if var[0] != 1:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			ShopOpen shop[111]
			var[0] = 99
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			if flag[1566]:
				TextTalk char[4] {
					這麼早就來招待所，
					真是些奇怪的傢伙。{wait}
				}
				TextWait
				TextTalk char[4] {
					……不過無所謂啦。
					如果是要休息，就自便好了。{wait}
				}
				TextWait
			elif flag[1554]:
				if !flag[3]:
					TextTalk char[4] {
						索妮亞副司令
						為了不讓隊員負擔過重，
						似乎精心分配了工作量。{wait}
					}
					TextWait
					TextTalk char[4] {
						因為如果處在疲勞狀態的話，
						一旦有緊急事件出現就無法應對了。{wait}
					}
					TextWait
					TextTalk char[4] {
						你們也要隨時保持一個
						萬全的身體狀況啊。{wait}
					}
					TextWait
					FlagSet flag[3]
				else:
					TextTalk char[4] {
						為了保證隨時都能應對突發事件，
						該休息的時候就要好好休息。{wait}
					}
					TextWait
					TextTalk char[4] {
						願意的話，在這所設施裡休息一下也行啊。{wait}
					}
					TextWait
			elif flag[1536]:
				TextTalk char[4] {
					好像是因為出現了什麼怪物，
					唐古拉姆門的警備隊員都
					不敢去執行任務了。{wait}
				}
				TextWait
				TextTalk char[4] {
					一群膽小鬼。
					就算是怪物又如何，
					不是都已經和魔獸戰鬥過很多次了嗎。{wait}
				}
				TextWait
			elif flag[1307]:
				TextTalk char[4] {
					……大家看上去很忙。{wait}
				}
				TextWait
				TextTalk char[4] {
					我現在比較閑，等會要不要去
					提馬斯那裡幫幫忙呢……{wait}
				}
				TextWait
			elif flag[1292]:
				TextTalk char[4] {
					我是伊莉雅・普拉提耶的
					超級崇拜者……{wait}
				}
				TextWait
				TextTalk char[4] {
					因為要在這種地方執勤，
					所以沒法去看彩虹劇團
					的公演……{wait}
				}
				TextWait
			elif flag[1282]:
				if QuestFlagsGet quest[27] 0x10:
					TextTalk char[4] {
						……要休息嗎？
						現在倒是有不少空房間哦。{wait}
					}
					TextWait
					TextTalk char[4] {
						因為是紀念慶典，
						所以不會有遊客在
						這種地方住吧。{wait}
					}
					TextWait
				elif QuestTaskGet quest[27] 4:
					TextTalk char[4] {
						……今天的客人好多啊……{wait}
					}
					TextWait
				else:
					TextTalk char[4] {
						……什麼啊，要休息嗎？{wait}
					}
					TextWait
			elif flag[1280]:
				TextTalk char[4] {
					《彩虹劇團》公演……
					昨天是首演哦。{wait}
				}
				TextWait
				TextTalk char[4] {
					……好想去啊……{wait}
				}
				TextWait
			elif flag[1040]:
				TextTalk char[4] {
					在我們這邊住宿的都是
					共和國來的旅行者和
					貿易商這樣的人。{wait}
				}
				TextWait
				TextTalk char[4] {
					偶爾也有錯過巴士，
					滯留在此的人留宿，
					所以這樣的設施很有必要的啊。{wait}
				}
				TextWait
			elif flag[1024]:
				TextTalk char[4] {
					……要去休息嗎？{wait}
				}
				TextWait
				TextTalk char[4] {
					請隨意，
					……不過不能保證舒適程度啊。{wait}
				}
				TextWait
	TextEnd char[4]
	Return

fn[13]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	TextTalk self {
		（狼吞虎嚥……）{wait}
	}
	TextWait
	TextTalk self {
		今天就在這悠閒地享受，
		明天再搭班車回去吧。{wait}
	}
	TextWait
	CharSetChipPattern self 0
	TextEnd self
	Return

