	radius 1000
	bubble_pos (-1750, 1000, -12300)
	unk1 124
	unk2 0
	function fn[0,75]
	unk3 0
	unk4 0

fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharIdle self (-3720, null, 4960) (2240, null, 7900) 1000mm/s
		Sleep 450ms
	Return

fn[2]:
	if flag[1566]:
		CharFlagsUnset char[23] 0x0080
		CharFlagsUnset char[24] 0x0080
		CharFlagsUnset char[25] 0x0080
	elif flag[1554]:
		CharFlagsUnset char[21] 0x0080
		CharFlagsUnset char[22] 0x0080
		CharFlagsUnset char[26] 0x0080
	elif flag[1536]:
		CharFlagsUnset char[18] 0x0080
		CharFlagsUnset char[19] 0x0080
		CharFlagsUnset char[20] 0x0080
		CharFlagsSet char[2] 0x0080
		CharFlags2Set char[2] 0x8000
	elif flag[1307]:
		CharFlagsUnset char[15] 0x0080
		CharFlagsUnset char[16] 0x0080
		CharFlagsUnset char[17] 0x0080
		CharSetPos char[1] (7150, 0, -1840) 0deg
	elif flag[1292]:
		CharFlagsUnset char[13] 0x0080
		CharFlagsUnset char[14] 0x0080
	elif flag[1282]:
		if flag[736]:
			FlagUnset flag[736]
			Event fn[0,47]
		if QuestFlagsGet quest[27] 0x10:
			CharFlagsUnset char[11] 0x0080
			CharFlagsUnset char[12] 0x0080
			CharSetPos char[1] (-4280, 0, 5130) 180deg
		elif QuestTaskGet quest[27] 13:
			CharFlagsUnset char[33] 0x0080
			CharSetPos char[33] (1720, 0, 7110) 270deg
			CharFlagsSet char[1] 0x0080
			CharFlagsSet char[2] 0x0080
		elif QuestTaskGet quest[27] 4:
			CharFlagsSet char[2] 0x0080
			Call fn[0,56]
		elif QuestTaskGet quest[27] 3:
			CharFlagsSet char[1] 0x0080
			CharFlagsSet char[2] 0x0080
			CharFlagsUnset char[33] 0x0080
	elif flag[1280]:
		CharFlagsUnset char[8] 0x0080
		CharFlagsUnset char[9] 0x0080
		ForkFunc char[9] fork[0] fn[0,1]
		CharFlagsUnset char[10] 0x0080
		CharFlagsUnset char[28] 0x0080
		CharFlagsUnset char[29] 0x0080
	elif flag[1040]:
		CharSetPos char[1] (7150, 0, -1840) 0deg
		CharFlagsUnset char[6] 0x0080
		CharFlagsUnset char[7] 0x0080
		CharFlagsUnset char[27] 0x0080
		CharFlagsUnset char[30] 0x0080
		CharFlagsUnset char[31] 0x0080
	elif flag[1024]:
		CharFlagsUnset char[5] 0x0080
	if system[0] == 109 && QuestTaskGet quest[27] 5 && QuestTaskGet quest[27] 6 && QuestTaskGet quest[27] 7 && QuestTaskGet quest[27] 8 && QuestTaskGet quest[27] 9 && QuestTaskGet quest[27] 10 && QuestTaskGet quest[27] 11 && QuestTaskGet quest[27] 12 && !QuestTaskGet quest[27] 13:
		Event fn[0,58]
	Return

fn[3]:
	ObjFrame object[6] 140
	ED7_78 object[4] char[32]
	ObjFlagsSet object[4] 0x0004
	ObjFlagsSet object[5] 0x0004
	ObjFlagsSet object[9] 0x0004
	ED7_76_0 object[4] "light" 1
	ED7_76_0 object[4] "chukin" 1
	ED7_76_0 object[5] "light" 1
	if flag[1566]:
		ObjFlagsUnset object[4] 0x0004
		Sc_D1 char[32] 0 90000 0 0ms
	elif flag[1554]:
		ObjFlagsUnset object[4] 0x0004
		Sc_D1 char[32] 0 270000 0 0ms
	elif flag[1536]:
		ObjFlagsUnset object[4] 0x0004
		CharSetPos char[32] (-8690, 100, 220) 0deg
		Sc_D1 char[32] 0 90000 0 0ms
		CharFlagsSet char[2] 0x0080
		CharFlags2Set char[2] 0x8000
	elif flag[1307]:
		ObjFlagsUnset object[4] 0x0004
		Sc_D1 char[32] 0 90000 0 0ms
		ObjFlagsUnset object[5] 0x0004
		ED7_78 object[5] char[44]
		Sc_D1 char[44] 0 90000 0 0ms
	elif flag[1292]:
	elif flag[1282]:
		if QuestFlagsGet quest[27] 0x10:
			ObjFlagsUnset object[4] 0x0004
			Sc_D1 char[32] 0 270000 0 0ms
	elif flag[1280]:
	elif flag[1040]:
		ObjFlagsUnset object[4] 0x0004
		Sc_D1 char[32] 0 270000 0 0ms
	elif flag[1024]:
	ObjFlagsSet object[8] 0x0004
	ED7_76_0 object[8] "light" 1
	if flag[1566]:
	elif flag[1554]:
		ObjFlagsUnset object[8] 0x0004
		ED7_78 object[8] char[45]
	TriggerFlagsSet trigger[0] 0x0080
	TriggerFlagsSet trigger[1] 0x0080
	TriggerFlagsSet trigger[2] 0x0080
	TriggerFlagsSet trigger[3] 0x0080
	if QuestFlagsGet quest[27] 0x10:
	elif QuestTaskGet quest[27] 13:
		ObjFlagsSet object[4] 0x0004
		TriggerFlagsUnset trigger[2] 0x0080
		TriggerFlagsUnset trigger[3] 0x0080
	elif QuestTaskGet quest[27] 4:
		TriggerFlagsUnset trigger[0] 0x0080
		TriggerFlagsUnset trigger[1] 0x0080
	Return

fn[4]:
	Call fn[0,5]
	Return

fn[5]:
	if flag[1292] && !flag[1307]:
		TextStart char[13]
	elif flag[1280] && !flag[1282]:
		TextStart char[8]
	elif flag[1040] && !flag[1280]:
		TextStart char[6]
	else:
		TextStart char[0]
	if flag[1566]:
		if !flag[0]:
			TextTalk char[0] {
				那麼，今天的盤查工作
				也必須努力呢。{wait}
			}
			TextWait
