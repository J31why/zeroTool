	EventBegin 1
	if flag[521] && !flag[524]:
		TextTalk name[0] {
			#0001F這裡就是出口，
			外面的清風涼爽怡人……{wait}
		} {
			#0006F……但現在還是先去
			聽聽大家怎麼說吧。{wait}
		}
		TextWait
	if flag[1038] && !flag[1040]:
		TextTalk name[0] {
			#0008F艾莉，出去了嗎……？{wait}
		} {
			#0001F不，還是先在
			支援課裡面找找吧。{wait}
		}
		TextWait
	if flag[1550] && !flag[1554]:
		TextTalk name[0] {
			#0000F伊安律師好像來了，
			還是先去打個招呼吧。{wait}
		}
