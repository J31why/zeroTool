		FlagUnset flag[994]
		FlagUnset flag[995]
		FlagUnset flag[996]
		FlagUnset flag[997]
		FlagUnset flag[998]
		FlagUnset flag[999]
		var[2] = random % 8
		if var[2] == 0:
