		#12P#0003F是啊……
		情報實在太少了，
		也沒辦法進行推理。{wait}
	} {
		#0001F不好意思，可以給我們
		遭竊店鋪的名單嗎？{wait}
	} {
		我們想去進行一下查訪，
		藉此收集情報。{wait}
	}
	TextWait
	TextTalk char[18] {
		#11P原來如此，店名
		都已經記錄在這裡了。{wait}
	}
	TextWait
	TextTalk char[18] {
		#11P遭竊的店鋪有……
		……我要開始讀了，可以吧？{wait}
	}
	TextWait
	TextTalk name[1] {
		#12P#0100F嗯，當然可以。{wait}
	}
	TextWait
	TextTalk char[18] {
		#11P中央廣場的『納德爾漢堡』、
		行政區的『庫羅瑪果汁店』……{wait}
	}
	TextWait
	TextTalk char[18] {
		#11P歡樂街的『帕雷特披薩』，
		以及這個港灣公園中的
		『米斯拉冰淇淋』。{wait}
	}
	TextWait
	TextTalk name[1] {
		#12P#0103F（認真記錄……）
		……一共有四家店鋪，
		而且好像分散在不同街區呢。{wait}
	}
	TextWait
	TextTalk name[2] {
		#6P#0200F既然有四家店鋪，
		依次問一遍，至少也能發現
		一條線索吧。{wait}
	}
	TextWait
	TextTalk name[0] {
		#12P#0001F嗯，總之，現在就去查訪一遍吧。{wait}
	}
	TextWait
	TextTalk name[0] {
		#12P#0000F各位就請暫時留在
