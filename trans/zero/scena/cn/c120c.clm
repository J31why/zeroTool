fn[76]:
	TextTalk name[0] {
		#12P#0001F明白了。
		事態也很嚴重，我們
		立刻接受任務。{wait}
	}
	TextWait
	TextTalk char[13] {
		#5P太好了……
		這樣一來，就能安心了！{wait}
	}
	TextWait
