fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if flag[1331] && !flag[1332]:
		Event fn[0,12]
	Return

fn[2]:
	LookPointFlagsSet look_point[0] 0x0001
	if flag[1332] && !flag[1333]:
		LookPointFlagsUnset look_point[0] 0x0001
	if flag[1333]:
		ObjFrame object[4] 120
	else:
		ED7_76_1 object[4] "CA01" 2
	if flag[1333]:
		Call fn[0,26]
	if flag[1333]:
	if flag[1332] && !flag[1333]:
		if flag[1353]:
			CharFlagsUnset char[0] 0x0080
			CharFlags2Unset char[0] 0x8000
		elif flag[1354]:
			CharFlagsUnset char[1] 0x0080
			CharFlags2Unset char[1] 0x8000
		elif flag[1355]:
			CharFlagsUnset char[2] 0x0080
			CharFlags2Unset char[2] 0x8000
		CharFlagsUnset char[3] 0x0080
		CharFlags2Unset char[3] 0x8000
	Return

fn[3]:
	TextStart self
	if !flag[1]:
		TextTalk self {
			#5308F話說回來……
			全都是十分眼熟的美術品和名畫。{wait}
		} {
			到底使用什麼管道，
			才能收集到這種商品呢。{wait}
		} {
			#5303F『銀』剛才說的
			『炸彈』也很令人在意……{wait}
		}
		TextWait
		Emote name[0] 0mm 2000mm 24 27 250ms 0
		Sleep 2000ms
		EmoteStop name[0]
		TextTalk self {
			#5305F……羅伊德，怎麼了？{wait}
		} {
			你的臉色好像不太好……{wait}
		}
		TextWait
		TextTalk name[0] {
			#5112F……不，沒什麼。{wait}
		} {
			#5108F（剛才的聲音，
			　艾莉他們
			　果然沒聽見嗎……）{wait}
		}
		TextWait
		FlagSet flag[1]
	else:
		TextTalk self {
			#5308F到底是透過什麼管道，
			才收集到這種商品的呢。{wait}
		} {
			#5306F魯巴徹的門路……
			似乎比想像的還要寬呢。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[4]:
