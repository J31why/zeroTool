sepith[0] 0 0 0 0 0 0 0 0

fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharWalkToPos self (13800, 8000, 6200) 2000mm/s 0
		CharWalkToPos self (14520, 8000, 20050) 2000mm/s 0
		CharWalkToPos self (8730, 8000, 20460) 2000mm/s 0
		CharWalkToPos self (8730, 8000, 20460) 2000mm/s 0
		CharWalkToPos self (8530, 8000, 26610) 2000mm/s 0
		CharWalkToPos self (-14240, 8000, 26610) 2000mm/s 0
		CharWalkToPos self (-17130, 8000, 23430) 2000mm/s 0
		CharWalkToPos self (-17130, 8000, 7560) 2000mm/s 0
		CharWalkToPos self (-11380, 8000, 2990) 2000mm/s 0
		CharWalkToPos self (14040, 8000, 2490) 2000mm/s 0
	Return

fn[2]:
	if flag[1792]:
		CharSetPos char[9] (14240, 0, 2440) 270deg
		CharSetPos char[10] (-14920, 0, 10470) 0deg
	elif flag[1566]:
		CharSetPos char[10] (-14920, 0, 10470) 0deg
	elif flag[1554]:
	elif flag[1550]:
	elif flag[1536]:
		CharSetPos char[10] (-14920, 0, 10470) 0deg
	elif flag[1346]:
		CharSetPos char[1] (6620, 0, 10670) 225deg
		CharFlagsSet char[0] 0x0080
		CharFlagsUnset char[16] 0x0080
		if flag[1434]:
			CharFlagsUnset char[14] 0x0080
			CharFlagsUnset char[15] 0x0080
	elif flag[1342]:
		CharSetPos char[1] (6620, 0, 10670) 225deg
		CharFlagsSet char[0] 0x0080
		CharFlagsUnset char[16] 0x0080
	elif flag[1055]:
		CharFlagsUnset char[7] 0x0080
		CharSetPos char[10] (-14920, 0, 10470) 0deg
	elif flag[1040]:
		CharSetPos char[10] (-14920, 0, 10470) 0deg
		CharSetPos char[9] (-17370, 30, 22740) 45deg
	elif flag[1037]:
		CharSetPos char[9] (14240, 0, 2440) 270deg
		CharFlagsSet char[10] 0x0080
	elif flag[1031]:
		CharTurnToChar char[0] char[1] 0deg/s
		CharTurnToChar char[1] char[0] 0deg/s
		CharFlagsSet char[0] 0x0010
		CharSetPos char[9] (14040, 8000, 21830) 90deg
	elif flag[1024]:
		CharSetPos char[9] (-17370, 30, 22740) 45deg
	elif flag[801]:
		CharSetPos char[10] (-14920, 0, 10470) 0deg
	elif flag[777]:
		CharSetPos char[9] (-5240, 8000, 5490) 0deg
	elif flag[768]:
	elif flag[533]:
	elif flag[526]:
	Return

fn[3]:
	LookPointFlagsSet look_point[8] 0x0001
	if flag[1536]:
	elif flag[1342]:
		LookPointFlagsSet look_point[0] 0x0001
		LookPointFlagsSet look_point[1] 0x0001
		LookPointFlagsUnset look_point[8] 0x0001
	if system[0] == 102:
		ED7_76_1 object[255] "model5" 1
	else:
		ED7_76_0 object[255] "model5" 1
	if flag[1037] && !flag[1038]:
		MapColor 0x00C8D2FF 0ms
	elif flag[1792]:
		MapColor 0x00C8D2FF 0ms
	else:
	if flag[1554]:
	elif flag[1536]:
		if QuestFlagsGet quest[42] 0x10:
		elif QuestTaskGet quest[42] 3:
			EntranceSetFunc entrance[0] fn[0,35]
	Return

fn[4]:
	Call fn[0,5]
	Return

fn[5]:
	if QuestTaskGet quest[2] 0 && !QuestTaskGet quest[2] 1 && !QuestFlagsGet quest[2] 0x40:
		CharTurnToChar field_party[0] char[0] 0deg/s
		_Char4A char[1] 255
		_Char4A char[0] 255
		Call fn[0,36]
		Return
	TextStart char[0]
	if flag[15]:
		TextTalk char[0] {
			呵呵，能找到就好哦。{wait}
		}
		TextWait
		TextTalk char[0] {
			『時代』百貨
			歡迎您的下次光臨。{wait}
		}
		TextWait
	elif flag[1792]:
		if !flag[0]:
			TextTalk char[0] {
				呼……斯克特的工作
				什麼時候才能變得
				輕鬆一點啊。{wait}
			}
			TextWait
			TextTalk char[0] {
				……結婚還早得很啊……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				……啊，對不起！
				不小心發了呆。{wait}
			}
			TextWait
			TextTalk char[0] {
				如果有什麼需要，
				請儘管吩咐。
				我們會認真為您服務的。{wait}
			}
			TextWait
	elif flag[1566]:
		TextTalk char[0] {
			工作才剛剛開始，
			這種時候總讓人感覺
			懶洋洋的，心情也輕鬆愉快。{wait}
		}
		TextWait
		TextTalk char[0] {
			今天也請
			加油工作哦。{wait}
		}
		TextWait
	elif flag[1554]:
		TextTalk char[0] {
			歡迎光臨
			『時代』百貨。{wait}
		}
		TextWait
		TextTalk char[0] {
			本店為了抓住顧客的心，
			會舉辦各式各樣的活動。{wait}
		}
		TextWait
		TextTalk char[0] {
			『抓住顧客的心，就能讓顧客展現笑容』……
			這是我們經理的座右銘。{wait}
		}
		TextWait
	elif flag[1536]:
		if QuestTaskGet quest[42] 3 && !QuestFlagsGet quest[42] 0x10:
			if flag[0]:
				TextTalk char[0] {
					為戀人選購禮物，
					真是一個非常快樂的過程呢。{wait}
				}
				TextWait
				TextTalk char[0] {
					呵呵，請您盡情享受
					購物的樂趣吧。{wait}
				}
				TextWait
			else:
				TextTalk char[0] {
					客人……您莫非是在
					挑選送給戀人的
					禮物嗎？{wait}
				}
				TextWait
				TextTalk char[0] {
					您與戀人的感情真是好呢。{wait}
				}
				TextWait
				TextTalk name[158] {
					哎……
					啊，不不，我和芙蘭小姐
					還不是那種……！{wait}
				}
				TextWait
				TextTalk name[0] {
					#0006F（猜錯了這個事實本身，才是最讓人難過的呢……）{wait}
				}
				TextWait
				FlagSet flag[0]
		else:
			TextTalk char[0] {
				歡迎光顧麥克道爾
				市長的指定購物場所──
				『時代』百貨。{wait}
			}
			TextWait
			TextTalk char[0] {
				……這種說法是不是
				有點太誇張了啊？{wait}
			}
			TextWait
	elif flag[1342]:
	elif flag[1055]:
		if !flag[0]:
			TextTalk char[0] {
				辛茜亞前輩那樣的美人
				給人的一貫印象就是穿
				著高跟鞋，氣質冷豔……{wait}
			}
			TextWait
			TextTalk char[0] {
				早上看到她穿著運動鞋
				來上班的時候，真是有些
				吃驚呢。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				辛茜亞前輩那樣的美人
				給人的一貫印象就是穿
				著高跟鞋，氣質冷豔……{wait}
			}
			TextWait
			TextTalk char[0] {
				但她這種比較適合休閒風的
				印象反差，更加吸引人呢。{wait}
			}
			TextWait
	elif flag[1040]:
		TextTalk char[0] {
			奈斯頓經理負責過
			各式各樣的企劃活動，
			是個很能幹的人呢。{wait}
		}
		TextWait
		TextTalk char[0] {
			似乎還曾經在創立紀念慶典
			中負責過活動安排呢……{wait}
		}
		TextWait
		TextTalk char[0] {
			嗯～雖然我也說不太清楚，
			但總之不是尋常之輩。{wait}
		}
		TextWait
	elif flag[1037]:
		TextTalk char[0] {
			……啊，珍妮塔
			望著食品賣場，
			正在流口水呢。{wait}
		}
		TextWait
		TextTalk char[0] {
			呵呵，她那種孩子氣的地方
			總能讓我們感到輕鬆愉快呢。{wait}
		}
		TextWait
	elif flag[1031]:
		if !flag[1]:
			Call fn[0,7]
		else:
			CharTurnToChar char[0] field_party[0] 0deg/s
			TextTalk char[0] {
				其實我和協會中的一位
				遊擊士已經定了婚呢……{wait}
			}
			TextWait
			TextTalk char[0] {
				啊，雖然因為他很忙，很少有機會
				見面，但他一直都很重視我，
				為我著想，是個很好的人哦。{wait}
			}
			TextWait
			CharTurnToChar char[0] char[1] 0deg/s
	elif flag[1024]:
		if !flag[0]:
			TextTalk char[0] {
				這裡也提供查詢列車和巴士，
				以及飛行船時刻表的服務哦。{wait}
			}
			TextWait
			TextTalk char[0] {
				因為我們的客人有很多是從帝國
				或共和國前來光顧的。{wait}
			}
			TextWait
			TextTalk char[0] {
				如有需要，歡迎各位隨時前來查詢。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				這裡也提供查詢列車和巴士，
				以及飛行船時刻表的服務哦。
				如有需要，歡迎各位隨時前來查詢。{wait}
			}
			TextWait
	elif flag[801]:
		if !flag[0]:
			TextTalk char[0] {
				……呼……斯克特現在
				正在做什麼呢……{wait}
			}
			TextWait
			Emote char[0] 0mm 2000mm 38 38 250ms 1
			Sleep 1000ms
			TextTalk char[0] {
				失、失禮了。
				竟然在客人面前……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				實在是失禮了。
				竟然在客人面前歎氣……{wait}
			}
			TextWait
	elif flag[777]:
		TextTalk char[0] {
			經理好像又有
			什麼靈感了呢……{wait}
		}
		TextWait
		TextTalk char[0] {
			是在策劃一些
			新的活動吧。{wait}
		}
		TextWait
	elif flag[768]:
		TextTalk char[0] {
			各位，早安。{wait}
		}
		TextWait
		TextTalk char[0] {
			希望大家都能精神飽滿地
			度過今天哦。{wait}
		}
		TextWait
	elif flag[533]:
		if !flag[0]:
			TextTalk char[0] {
				辛茜亞前輩可是這個百貨
				中的偶像級店員呢。{wait}
			}
			TextWait
			TextTalk char[0] {
				不但漂亮，而且十分有女人味，
				街上的很多女孩子都很憧憬她。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				辛茜亞前輩可是這個百貨
				中的偶像級店員呢。{wait}
			}
			TextWait
			TextTalk char[0] {
				呵呵……其實我也
				是因為憧憬辛茜亞前輩，
				才會選擇這個工作的。{wait}
			}
			TextWait
	elif flag[526]:
		if !flag[0]:
			TextTalk char[0] {
				進口食材、洋裝、
				鞋子、雜貨、飾品……{wait}
			}
			TextWait
			TextTalk char[0] {
				本店有各種類型的專櫃呢。
				呵呵，各位要不要親自去看看呢？{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				本店有各種
				類型的專櫃呢。{wait}
			}
			TextWait
			TextTalk char[0] {
				呵呵，各位要不要
				親自去看看呢？{wait}
			}
			TextWait
	TextEnd char[0]
	Return

fn[6]:
	Call fn[0,7]
	Return

fn[7]:
	if QuestTaskGet quest[2] 0 && !QuestTaskGet quest[2] 1 && !QuestFlagsGet quest[2] 0x40:
		CharTurnToChar field_party[0] char[1] 0deg/s
		_Char4A char[1] 255
		_Char4A char[0] 255
		Call fn[0,36]
		Return
	TextStart char[1]
	if flag[15]:
		TextTalk char[1] {
			在本店裡，
			經常會發現遺失物。{wait}
		}
		TextWait
		TextTalk char[1] {
			平時一直都要保管著十幾件左右……
			按規定，如果發現後一週內都無人認領，
			就要將失物交給警察了。{wait}
		}
		TextWait
		TextTalk char[1] {
			也請各位客人多加小心，
			不要遺失物品。{wait}
		}
		TextWait
