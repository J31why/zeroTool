	CharFlagsSet char[23] 0x0080
	CharFlagsSet char[22] 0x0080
	CharFlagsSet char[24] 0x0080
	CamSetDistance -1140 2000 -2670 0ms
	ED7CamRotate 228deg 29deg -1deg 0ms
	CamPers 520 0ms
	CamZoom 16580 0ms
	FadeWait
	BgmWait
	Sleep 10ms
	BgmPlay bgm[101] 0
	TextTalk name[0] {
		#6P#0005F那個叫阿巴斯的傢伙……
		從一開始就是這麼打算的吧。{wait}
	}
	TextWait
	TextTalk name[1] {
		#5P#0106F結果把兩個組織的成員
		都拉來做了一次訓練。{wait}
	} {
		#0100F確實，他好像從一開始
		就有這樣的預謀呢。{wait}
	}
	TextWait
	TextTalk name[3] {
		#11P#0306F到頭來，我們完全被他算計了啊。
		……真是個大意不得的傢伙。{wait}
	}
	TextWait
	TextTalk name[2] {
		#12P#0206F是啊……身體相當疲勞呢。{wait}
	} {
		#0200F不過，多虧他的說教，
		不良分子成員們應該
		會變得安分不少吧。{wait}
	}
	TextWait
	TextTalk name[0] {
		#6P#0000F也是，無論如何，
		我們都達到了最初的目的。{wait}
	}
	TextWait
	Fork name[0] fork[1]:
		CharTurnToChar self name[3] 400deg/s
	Fork name[2] fork[1]:
		CharTurnToChar self name[1] 400deg/s
	Fork name[1] fork[1]:
		CharTurnToChar self name[2] 400deg/s
	Fork name[3] fork[1]:
		CharTurnToChar self name[0] 400deg/s
	Sleep 400ms
	TextTalk name[0] {
		#6P#0000F好，那我們差不多
		也該回去了。{wait}
	}
	TextWait
	TextTalk name[1] {
		#5P#0100F嗯，我們走吧。{wait}
	}
	TextWait
	Return

