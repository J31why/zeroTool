fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharWalkToPos self (700, 0, 2050) 2000mm/s 0
		CharWalkToPos self (6210, 0, 2640) 2000mm/s 0
		CharTurnTo self 45deg 400deg/s
		Sleep 1800ms
		CharTurnTo self 225deg 400deg/s
		Sleep 100ms
		CharWalkToPos self (2810, 0, 1030) 2000mm/s 0
		CharWalkToPos self (3120, 0, -560) 2000mm/s 0
		CharTurnTo self 135deg 400deg/s
		Sleep 1800ms
		CharTurnTo self 270deg 400deg/s
		Sleep 100ms
		CharWalkToPos self (-2050, 0, -820) 2000mm/s 0
		CharTurnTo self 315deg 400deg/s
		Sleep 1800ms
		CharTurnTo self 45deg 400deg/s
		Sleep 100ms
	Return

fn[2]:
	while 1:
		CharIdle self (141770, null, -2220) (143890, null, -100) 1000mm/s
		Sleep 250ms
	Return

fn[3]:
	if QuestTaskGet quest[31] 3 && !QuestFlagsGet quest[31] 0x10:
		Event fn[0,40]
	if flag[1566]:
		CharFlagsUnset char[8] 0x0080
		CharFlagsUnset char[3] 0x0080
		ForkFunc char[3] fork[0] fn[0,1]
	elif flag[1554]:
		CharFlagsUnset char[7] 0x0080
		CharFlagsUnset char[10] 0x0080
		CharFlagsUnset char[3] 0x0080
		ForkFunc char[3] fork[0] fn[0,1]
	elif flag[1536]:
		CharFlagsUnset char[19] 0x0080
		CharSetPos char[19] (-41720, 0, 3490) 90deg
		CharTurnTo char[0] 270deg 0deg/s
		CharFlagsUnset char[3] 0x0080
		ForkFunc char[3] fork[0] fn[0,1]
		CharFlagsUnset char[8] 0x0080
		CharFlagsUnset char[20] 0x0080
		CharFlagsUnset char[21] 0x0080
	elif flag[1307]:
		CharFlagsUnset char[8] 0x0080
		CharFlagsUnset char[15] 0x0080
		CharFlagsUnset char[17] 0x0080
	elif flag[1292]:
		CharFlagsUnset char[15] 0x0080
		CharFlagsUnset char[17] 0x0080
		CharFlagsUnset char[18] 0x0080
		CharTurnTo char[0] 270deg 0deg/s
		if QuestFlagsGet quest[31] 0x10:
			CharSetPos char[15] (84000, 180, -2040) 283deg
			CharSetPos char[17] (82190, 180, -1670) 103deg
		elif QuestTaskGet quest[31] 0:
			CharFlagsSet char[5] 0x0080
			CharFlagsSet char[6] 0x0080
			CharFlagsSet char[15] 0x0080
			CharFlagsSet char[17] 0x0080
			CharFlagsUnset char[4] 0x0080
			CharSetPos char[2] (750, 0, 1500) 270deg
		elif QuestFlagsGet quest[31] 0x02:
			CharFlagsSet char[5] 0x0080
			CharFlagsSet char[6] 0x0080
			CharFlagsSet char[15] 0x0080
			CharFlagsSet char[17] 0x0080
			CharSetPos char[2] (0, 0, 3700) 360deg
			CharFlagsSet char[2] 0x0010
	elif flag[1282]:
		CharFlagsUnset char[14] 0x0080
		CharFlagsUnset char[16] 0x0080
	elif flag[1280]:
		CharFlagsUnset char[22] 0x0080
		CharFlagsUnset char[23] 0x0080
	elif flag[1040]:
		CharFlagsUnset char[8] 0x0080
		CharFlagsUnset char[9] 0x0080
		ForkFunc char[9] fork[0] fn[0,2]
		CharFlagsUnset char[12] 0x0080
		CharTurnTo char[0] 270deg 0deg/s
		CharFlagsUnset char[3] 0x0080
		ForkFunc char[3] fork[0] fn[0,1]
	elif flag[1024]:
		CharFlagsUnset char[3] 0x0080
		CharSetPos char[3] (2350, 0, -720) 135deg
		CharFlagsUnset char[11] 0x0080
		CharFlagsUnset char[8] 0x0080
		CharFlagsUnset char[9] 0x0080
		ForkFunc char[9] fork[0] fn[0,2]
	elif flag[801]:
		CharFlagsUnset char[8] 0x0080
		CharFlagsUnset char[9] 0x0080
		ForkFunc char[9] fork[0] fn[0,2]
		CharFlagsUnset char[3] 0x0080
		ForkFunc char[3] fork[0] fn[0,1]
	elif flag[776]:
		CharFlagsUnset char[8] 0x0080
		CharFlagsUnset char[9] 0x0080
		ForkFunc char[9] fork[0] fn[0,2]
		CharFlagsUnset char[3] 0x0080
		ForkFunc char[3] fork[0] fn[0,1]
		CharFlagsUnset char[19] 0x0080
		CharFlagsSet char[19] 0x0010
	elif flag[774]:
		CharFlagsUnset char[8] 0x0080
		CharFlagsUnset char[9] 0x0080
		ForkFunc char[9] fork[0] fn[0,2]
		CharFlagsUnset char[3] 0x0080
		ForkFunc char[3] fork[0] fn[0,1]
		CharFlagsUnset char[19] 0x0080
	elif flag[768]:
		CharFlagsUnset char[8] 0x0080
		CharFlagsUnset char[9] 0x0080
		ForkFunc char[9] fork[0] fn[0,2]
		CharFlagsUnset char[3] 0x0080
		ForkFunc char[3] fork[0] fn[0,1]
		CharFlagsSet char[6] 0x0080
		CharFlagsUnset char[13] 0x0080
	if flag[1280] && !flag[1536]:
		CharFlagsUnset char[26] 0x0080
		CharFlagsUnset char[27] 0x0080
	Return

fn[4]:
	if flag[777]:
		ED7_76_0 object[255] "tuika00" 1
	if flag[1292]:
		if QuestFlagsGet quest[31] 0x10:
		elif QuestTaskGet quest[31] 0:
			LookPointFlagsSet look_point[0] 0x0001
		elif QuestFlagsGet quest[31] 0x02:
			LookPointFlagsSet look_point[0] 0x0001
	Return

fn[5]:
	TextStart self
	if flag[1566]:
		if !flag[0]:
			TextTalk self {
				這個雜貨店的歷史很悠久，
				是從我曾祖父的時代開始
				世代相傳的老店。{wait}
			}
			TextWait
			TextTalk self {
				可是，傑克那傢伙
				一點也不明白其中的可貴之處。{wait}
			}
			TextWait
			TextTalk self {
				真希望他在工作的時候
				能多帶點自豪感啊。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				希望傑克
				在工作的時候
				能再多帶點自豪感啊。{wait}
			}
			TextWait
			TextTalk self {
				這家店要變成『傑克雜貨店』
				得等到幾時呢……{wait}
			}
			TextWait
	elif flag[1554]:
		if !flag[0]:
			TextTalk self {
				因為傑克工作太懶散，
				我訓了他一頓。{wait}
			}
			TextWait
			TextTalk self {
				他偶爾也會胡說些
				『要進城做一番大事業』之類的夢話……{wait}
			}
			TextWait
			TextTalk self {
				有那種閒工夫的話，
				還不如多學點
				店裡的手藝呢。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				傑克那傢伙，偶爾會
				胡說些『要進城做一番大事業』
				之類的夢話……{wait}
			}
			TextWait
			TextTalk self {
				有那種閒工夫的話，
				還不如多學點
				店裡的手藝呢。{wait}
			}
			TextWait
	elif flag[1536]:
		if !flag[0]:
			_Char4A char[19] 255
			CharTurnToChar self char[19] 0deg/s
			TextTalk self {
				每次都承蒙
				你的照顧呢。{wait}
			}
			TextWait
			TextTalk self {
				來，今天就額外
				多送你一瓶蜂蜜，
				和家人一起吃吧。{wait}
			}
			TextWait
			TextTalk char[19] {
				#3609F呵呵……感激不盡，
				我的太太和孩子都會很開心的。{wait}
			}
			TextWait
			_Char4B char[19] 255
			FlagSet flag[0]
		else:
			TextTalk self {
				和哈羅德相比，
				我家的傑克可真是……
				始終都成不了氣候啊。{wait}
			}
			TextWait
			TextTalk self {
				既然撐過了紀念慶典，
				希望他能多少趕上
				哈羅德一些。{wait}
			}
			TextWait
	elif flag[1307]:
		if !flag[0]:
			TextTalk self {
				遊客一回克洛斯貝爾市，
				這裡馬上就冷清下來了呢。{wait}
			}
			TextWait
			TextTalk self {
				……傑克似乎在偷懶啊。
				好，我去呵斥他一下吧。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				站櫃臺的人
				怎麼可以那麼無精打采呢。{wait}
			}
			TextWait
			TextTalk self {
				好，我去呵斥他一下吧。{wait}
			}
			TextWait
	elif flag[1292]:
		if !flag[0]:
			Call fn[0,7]
		else:
			TextTalk self {
				呵呵，生意真是近年少有的好啊。{wait}
			}
			TextWait
			TextTalk self {
				去年的紀念慶典
				可沒有這麼好的生意呢，
				真是難得啊。{wait}
			}
			TextWait
	elif flag[1282]:
		TextTalk self {
			呵呵呵，遊客們
			買了很多蜂蜜
			當特產呢。{wait}
		}
		TextWait
		TextTalk self {
			真是太好了，
			還好採用了
			德瑞克的點子。{wait}
		}
		TextWait
	elif flag[1280]:
		if !flag[0]:
			TextTalk self {
				在紀念慶典開露天店，
				第一天的銷量
				相當不錯呢。{wait}
			}
			TextWait
			TextTalk self {
				多虧《彩虹劇團》
				幫我們吸引了這麼多客人。
				呵呵呵。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				多虧《彩虹劇團》
				幫我們吸引了這麼多客人，
				露天店的銷量十分不錯呢。{wait}
			}
			TextWait
			TextTalk self {
				希望能這樣一直
				保持到最終日……{wait}
			}
			TextWait
	elif flag[1040]:
		if !flag[0]:
			Call fn[0,7]
		else:
			TextTalk self {
				德瑞克那傢伙，
				還挺能幹的嘛。{wait}
			}
			TextWait
			TextTalk self {
				似乎已經有繼任
				下任村長的自覺了。{wait}
			}
			TextWait
			TextTalk self {
				……真希望傑克
				也能有繼承家業的自覺啊。{wait}
			}
			TextWait
	elif flag[1024]:
		if !flag[0]:
			TextTalk self {
				德瑞克那傢伙提出的『在創立紀念慶典
				開設露天店鋪』，可真是個不錯的點子。{wait}
			}
			TextWait
			TextTalk self {
				我們村子已經漸漸
				失去了往日的活力，
				那樣做說不定很不錯。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				為了讓村子恢復活力，
				我很樂意去創立紀念慶典開露天店。{wait}
			}
			TextWait
	elif flag[801]:
		if !flag[0]:
			TextTalk self {
				唔，今天到後面的農場
				去進一點蜂蜜吧。{wait}
			}
			TextWait
			TextTalk self {
				其實我也想
				教傑克一點
				進貨的基礎……{wait}
			}
