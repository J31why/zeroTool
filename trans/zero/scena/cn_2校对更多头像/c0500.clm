				蘭迪先生是大笨蛋～！
				大騙子～！{wait}
			}
			TextWait
			TextTalk self {
				要是不來店裡玩的話，
				愛麗絲可是會生氣哦～！{wait}
			}
			TextWait
	else:
		Call fn[0,12]
	TextEnd self
	Return

fn[12]:
	CharTurnToChar self name[3] 0deg/s
