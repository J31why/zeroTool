				有時候啊，那些戴著墨鏡的人
				會在大半夜折騰個沒完，
				到處跑來跑去，不知道在搞什麼。{wait}
			}
			TextWait
			TextTalk char[3] {
				之前有一天晚上，
				簡直吵得我們都做不了生意了。{wait}
			}
			TextWait
			TextTalk char[3] {
				真的是，讓人火大啊～！{wait}
			}
			TextWait
			FlagSet flag[1]
	elif flag[533]:
		if flag[635]:
			TextTalk char[3] {
				我正在跟其他女孩比賽，
				看誰的業績更高呢。{wait}
			}
			TextWait
			TextTalk self {
				可是、可是……{wait}
			}
			TextWait
			TextTalk char[3] {
				啊啊～這個月恐怕要輸了呢～！{wait}
			}
			TextWait
		else:
			Call fn[0,12]
	elif flag[635]:
		if !flag[1]:
			TextTalk self {
				蘭迪先生許下的諾言，
				一般都兌現不了啊～{wait}
			}
			TextWait
			TextTalk self {
				之前還信誓旦旦地說會來呢，
				結果也沒有來～{wait}
			}
			TextWait
			TextTalk name[3] {
				#0303F啊，那天我好像是在
				酒吧裡結識了一位美女。{wait}
			}
			TextWait
			CharTurnToChar self name[3] 0deg/s
			TextTalk self {
				真是的，蘭迪先生是大笨蛋～！
				大騙子～！{wait}
			}
			TextWait
			Emote name[0] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Emote name[1] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Emote name[2] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Sleep 1000ms
