fn[7]:
	TextStart self
	if flag[1037]:
		TextTalk char[0] {
			喂，你們幾個……
			事情應該已經辦完了吧。{wait}
		}
		TextWait
		TextTalk char[0] {
			哼哼，還是說，想讓我們的副頭目
			好好陪你們玩玩呢？{wait}
		}
		TextWait
	else:
		TextTalk char[0] {
			喂喂，小鬼頭們，
			回去的路在那邊呢。{wait}
		}
		TextWait
		TextTalk char[0] {
			要是不想遭遇到什麼可怕的事情，
			還是乖乖消失為好。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[8]:
	TextStart self
	if flag[1037]:
		TextTalk self {
			你們想閑晃到什麼時候啊，
			嗯？！{wait}
		}
		TextWait
	else:
		TextTalk char[1] {
			來『魯巴徹商會』有什麼事情嗎？{wait}
		}
		TextWait
		TextTalk char[1] {
			哈，別以為見過副頭目
			就有資本囂張了。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[9]:
	TextStart self
	if flag[1792]:
		if flag[0]:
			TextTalk char[2] {
				（吐舌頭）……哪裡有
				好客人呢？{wait}
			}
			TextWait
			TextTalk char[2] {
				讓我帶你去一個
				快樂美好的世界玩玩吧。
				嘿嘿嘿嘿……！{wait}
			}
			TextWait
		else:
			TextTalk char[2] {
				搞什麼啊，還莫名其妙的呢，
				太陽就都下山了。
				今天真是奇怪的一天啊……{wait}
			}
			TextWait
			TextTalk char[2] {
				……算啦，不想了，開始做生意好了。
				時間就是金錢啊。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1566]:
		TextTalk self {
			怎麼搞的……今天跟昨天一樣，
			街上還是這麼安靜。{wait}
		}
		TextWait
		TextTalk self {
			該怎麼說呢，好像感覺不到
			這座城市中一直蠢蠢欲動的
			『黑色暗潮』了呢。{wait}
		}
		TextWait
		TextTalk self {
			……怎麼回事，也太安靜了啊。{wait}
		}
		TextWait
	elif flag[1554]:
		if flag[1557]:
