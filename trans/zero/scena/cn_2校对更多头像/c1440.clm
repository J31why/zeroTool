				} {
					#15602F那個獵兵大叔看上去很凶呢。
					他以前也來過店裡呢～{wait}
				}
				TextWait
			else:
				TextTalk char[1] {
					#15600F客人，要買點什麼嗎？{wait}
				} {
					#15600F現金交易可是不行的～
					請用適當的東西來交換吧～{wait}
				}
				TextWait
	TextEnd char[1]
	Return

fn[11]:
	TextStart char[1]
	Emote char[1] 0mm 2000mm 38 38 250ms 1
	Sleep 1000ms
	TextTalk char[1] {
		#15602F啊，客人～
		今天要買點什麼嗎？{wait}
	} {
		#15609F啊哈～最近進購了一些
		威力比較強大的手榴彈呢。{wait}
	} {
		#15602F用它的話，一枚就能滅掉一個小隊～{wait}
	}
	TextWait
	TextTalk name[0] {
		#0006F啊，這家店還是一如既往地可疑呢……{wait}
	}
	TextWait
	if PartyPosition name[1] > -1:
		TextTalk name[1] {
			#0103F表面上雖然只是個
			從事物物交換的店……{wait}
		} {
			但經營範圍並不僅限於此，
			算是無限接近於黑的灰色行業呢……{wait}
		}
		TextWait
	elif PartyPosition name[2] > -1:
		TextTalk name[2] {
			#0203F表面上雖然是個以物易物
			的交換店……{wait}
		} {
			但營業範圍不止於此，
			可以說是無限接近於黑的灰色行業吧……{wait}
		}
		TextWait
	elif PartyPosition name[3] > -1:
		TextTalk name[3] {
			#0303F表面上看，雖然只是個
			交換物品的商店……{wait}
		} {
			但實際上，它的營業範圍要廣得多，
			可以說是一家無限接近黑色的灰色店鋪吧……{wait}
		}
		TextWait
	FadeOut 300ms 0x00000000 100
	SoundPlay sound[828] 0 100 0
	TextSetName ""
	TextMessage null {
		{color 5}※與晶歌交談，並選擇『交換』，
		　就會出現可交換商品一覽表。
		　如果攜帶有交換所需的物品，就可以進行交換。{color 0}{wait}
	}
	TextWait
	TextMessage null {
		{color 5}※這裡的裝備與結晶迴路都是一些
		　在其它地方無法得到的高價稀有品。{color 0}{wait}
	}
	TextWait
	TextMessage null {
		{color 5}※雖然不用花費米拉，但要用相應的物品
		　來進行交換。所以，是否真的需要交換，
		　請在仔細考慮之後再做出決定。{color 0}{wait}
	}
	TextWait
	TextClose 0
	_59
	FadeIn 300ms 0x00000000
	FlagSet flag[1436]
	TextEnd char[1]
	Return

