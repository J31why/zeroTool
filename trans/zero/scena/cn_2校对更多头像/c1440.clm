fn[13]:
	TextStart self
	if flag[2]:
		TextTalk char[2] {
			呼……
			要想教育舊市街的這些孩子們，
			用一般的方法是行不通的。{wait}
		}
		TextWait
	else:
		TextTalk char[2] {
			雖然曾經多次要求晶歌
			也來參加主日學校的課程，
			但每次都吃閉門羹呢。{wait}
		}
		TextWait
		TextTalk char[2] {
			艾胥莉小姐要是
			能予以理解就好了……{wait}
		}
		TextWait
		FlagSet flag[2]
	TextEnd self
	Return

fn[14]:
	TextStart self
	if flag[1566]:
		if !flag[3]:
			TextTalk self {
				#08601F關於昨天的襲擊事件，
				我想來詢問一下情況……{wait}
			} {
				#08606F但這裡的店主
				實在是很難接近呢。{wait}
			} {
				#08601F我不是這裡的常客，
				所以待在店裡挺不舒服的。{wait}
			}
			TextWait
			FlagSet flag[3]
		else:
			TextTalk self {
				#08601F我是那種無論遇到什麼事情，
				都只依靠自己這一雙拳頭的類型。{wait}
			} {
				#08603F看來是和這家店無緣啊。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[15]:
	TextStart self
	if flag[1566]:
		if !flag[4]:
			TextTalk self {
				#08701F溫蔡爾他們去
				貝爾加德門那邊進行調查了。{wait}
			} {
				#08701F根據目擊情報，
				那邊好像有黑手黨呢。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0005F黑手黨竟然跑到警備隊的駐紮地……
				又想做些什麼呢？{wait}
			}
			TextWait
			TextTalk self {
				#08701F至今為止，已經有過
				很多目擊情報了。{wait}
			} {
				#08703F有不少小道消息都說，好像和
				警備隊的司令有什麼牽扯呢。{wait}
			}
			TextWait
			TextTalk name[3] {
				#0301F大概又是行賄受賄之類的事情吧。{wait}
			} {
				#0306F真是的，那個司令真是不知悔改……{wait}
			}
			TextWait
			FlagSet flag[4]
		else:
			TextTalk self {
				#08703F呼，貝爾加德門那邊的調查雖然
				不是什麼大不了的事情，不過……{wait}
			} {
				#08701F剛剛發生過那種襲擊事件，謹慎起見，
				還是應該把事情的真相搞清楚啊。{wait}
			}
			TextWait
	TextEnd self
	Return

