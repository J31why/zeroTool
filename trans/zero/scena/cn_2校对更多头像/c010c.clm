		global[2] = 0
		FlagSet flag[1485]
		QuestTaskSet quest[70] 7
		Call fn[0,7]
	Return

fn[37]:
	TextStart null
	FadeOut 300ms 0x00000000 100
	TextSetName ""
	TextSetPos -1 -1 -1 -1
	TextMessage null {
		{color 5}       『克洛斯貝爾之鐘』
		Ｓ１１８５　在克洛斯貝爾自治州
		發掘出土的巨型大鐘。
		依據出土遺跡的情況來看，
		可推斷為中世紀時期的物品。
		使用多種金屬打造而成，
		敲打時會發出悅耳的低音。{wait}
	}
	TextWait
	TextMessage null {
		{color 5}據推測，是由當時的權貴人士所製造，
		但關於其具體用途，
		目前仍然諸說紛紜。{wait}
	}
	TextWait
	TextClose 0
	FadeIn 300ms 0x00000000
	_59
	TextSetPos -1 280 60 3
	if QuestTaskGet quest[34] 0 && !QuestTaskGet quest[34] 1:
		if !flag[14]:
			TextTalk name[0] {
				#0003F『克洛斯貝爾之鐘』……
				正可謂是這個城市的
				『象徵』呢。{wait}
			}
