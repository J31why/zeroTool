			}
			TextWait
			TextTalk name[0] {
				#0000F嗯……
				想辦法試試進去調查吧。{wait}
			}
			TextWait
			FlagSet flag[14]
		else:
			TextTalk name[0] {
				#0001F『克洛斯貝爾之鐘』……
				正可謂是這個城市的『象徵』。{wait}
			} {
				#0003F嗯……說不定可以
				從地下進去，調查內部呢。{wait}
			}
			TextWait
	TextEnd null
	Return

