fn[5]:
	TextStart self
	if flag[1792]:
		TextTalk self {
			太陽下山了呢……
			在能見度不好的黃昏，
			魔獸的危險度也會增加。{wait}
		}
		TextWait
		TextTalk self {
			若打算去郊外街道的話，
			請多加注意。{wait}
		}
		TextWait
	elif flag[1566]:
		TextTalk self {
			今天警備隊的
			上士來了。{wait}
		}
		TextWait
		TextTalk self {
			到底有什麼事呢……？{wait}
		}
		TextWait
	elif flag[1554]:
		TextTalk self {
			我感覺克洛斯貝爾最近
			好像變得更加危險了。{wait}
		}
		TextWait
		TextTalk self {
			大教堂作為主日學校的授課點，
			聚集了很多孩子們，必須多加留心呢。{wait}
		}
		TextWait
	elif flag[1536]:
		TextTalk self {
			下午好，
			歡迎來到克洛斯貝爾大教堂。{wait}
		}
		TextWait
		TextTalk self {
			今天是主日學校的開課日，
			請注意不要妨礙
			到老師上課。{wait}
		}
		TextWait
	elif flag[1346]:
		TextTalk self {
			哎呀……就要回去了嗎？{wait}
		}
		TextWait
		TextTalk self {
			歡迎隨時再來。
			願女神保佑各位……{wait}
		}
		TextWait
	elif flag[1342]:
		if !flag[0]:
			TextTalk self {
				下午好，
				歡迎來到克洛斯貝爾大教堂。{wait}
			}
			TextWait
			TextTalk name[82] {
				#1110F下午好！我是琪雅！{wait}
			}
			TextWait
			TextTalk self {
				哈哈……這麼有精神，真是再好不過了。{wait}
			}
			TextWait
			if flag[1123]:
				TextTalk name[0] {
					#0000F那個……請問
					瑪布林老師在嗎？{wait}
				} {
					我想跟她商量一下
					有關這個孩子的事情……{wait}
				}
				TextWait
				TextTalk self {
					哎呀，是這樣啊。{wait}
				}
				TextWait
				TextTalk self {
					瑪布林修女她
					正在主日學校的教室裡
					處理雜事呢。{wait}
				}
				TextWait
				TextTalk name[0] {
					#0000F啊，是這樣啊……
					謝謝你。{wait}
				}
				TextWait
				if flag[1356]:
					TextTalk name[1] {
						#0104F呼，太好了，
						老師好像在呢。{wait}
					}
					TextWait
				elif flag[1357]:
					TextTalk name[2] {
						#0200F真是位熱心的人呢。{wait}
					}
					TextWait
				elif flag[1358]:
					TextTalk name[3] {
						#0300F似乎沒有
						與那位修女錯過啊。{wait}
					}
					TextWait
				TextTalk name[0] {
					#0000F……好了，那麼快一點去
					找瑪布林老師吧。{wait}
				}
				TextWait
				TextTalk name[82] {
					#1109F出發～！{wait}
				}
				TextWait
			FlagSet flag[0]
		elif flag[1123]:
			TextTalk self {
				瑪布林修女她
				正在主日學校的教室裡
				處理雜事呢。{wait}
			}
			TextWait
		else:
			TextTalk self {
				呵呵……小孩子最重要的就是要有精神。{wait}
			}
			TextWait
	elif flag[1307]:
		if !flag[0]:
			TextTalk self {
				紀念慶典期間大教堂內
				會舉行彌撒。{wait}
			}
			TextWait
			TextTalk self {
				今天紀念慶典也要結束了……
				最後再加把勁吧。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				今天紀念慶典也要結束了……
				我想再加把勁
				做好守衛工作。{wait}
			}
			TextWait
	elif flag[1292]:
		TextTalk self {
			這幾天，紀念慶典
			真是盛況空前呢。{wait}
		}
		TextWait
		TextTalk self {
			那麼多的人，
			讓守衛工作變得也很辛苦啊。{wait}
		}
		TextWait
	elif flag[1282]:
		TextTalk self {
			紀念慶典期間大教堂內
			會舉行彌撒。{wait}
		}
		TextWait
		TextTalk self {
			似乎也有很多國外遊客
			前來造訪呢。{wait}
		}
		TextWait
	elif flag[1280]:
		TextTalk self {
			紀念慶典期間大教堂內
			會舉行彌撒。{wait}
		}
		TextWait
		TextTalk self {
			各位若想參加，
			就請自便吧。{wait}
		}
		TextWait
		TextTalk self {
			舉辦彌撒期間還會給
			孩子們發放點心，
			若不嫌棄，請務必收下。{wait}
		}
		TextWait
	elif flag[1040]:
		TextTalk self {
			今天也是個吉日，
			儀式似乎能平安無事地順利結束呢。{wait}
		}
		TextWait
		TextTalk self {
			這樣的日子
			要是可以永遠持續下去就好了。{wait}
		}
		TextWait
	elif flag[1024]:
		if !flag[0]:
			TextTalk self {
				今天主日學校要在
				講堂開課。{wait}
			}
			TextWait
			TextTalk self {
				為了避免可疑人員進入
				我正在此處進行守衛……{wait}
			}
			TextWait
			TextTalk self {
				不過你們……
				好像是警察吧，
				請過去吧。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				為了保護聚集在這裡的孩子們的安全，
				作為守衛的我必須要嚴加留心。{wait}
			}
			TextWait
			TextTalk self {
				比如之前的狼型魔獸騷亂，
				危險事件實在是太多了。{wait}
			}
			TextWait
	elif flag[801]:
		if !flag[0]:
			TextTalk self {
				身為教區長的艾拉爾達大主教
				正在這所克洛斯貝爾大教堂裡
				傳授七耀的教誨。{wait}
			}
			TextWait
			TextTalk self {
				在教會用地內請保持安靜。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				在教會用地內請保持安靜。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[6]:
	TextStart self
	if flag[1792]:
		if !flag[1]:
			TextTalk self {
				我在這裡做修女的工作，
				差不多也快半年了吧。{wait}
			}
			TextWait
			TextTalk self {
				因此也認識了許多
				市民和孩子們……{wait}
			}
			TextWait
			TextTalk self {
				但與瑪布林修女比起來，
				我還遠遠不夠成熟。{wait}
			}
			TextWait
			TextTalk self {
				真希望有一天，我也能成為
				像她一樣的出色修女……{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				我在這裡做修女的工作，
				差不多也快半年了吧。{wait}
			}
			TextWait
			TextTalk self {
				真希望有一天我也能成為
				像她一樣出色的修女……{wait}
			}
			TextWait
	elif flag[1566]:
		if !flag[1]:
			TextTalk self {
				今天來的那位警備隊上士，
				私下裡也會經常
				來這裡祈禱。{wait}
			}
			TextWait
			TextTalk self {
				記得是叫諾艾兒吧……
				真是個有禮貌又心地善良的人啊。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				諾艾兒小姐私下裡
				也經常來這裡祈禱。{wait}
			}
			TextWait
	elif flag[1554]:
		TextTalk self {
			泰米爾和哈米爾
			經常會來這裡玩。{wait}
		}
		TextWait
		TextTalk self {
			那個……
			哎，好像搞不清方向了……{wait}
		}
		TextWait
	elif flag[1536]:
		if !flag[1]:
			TextTalk self {
				今天東側大道的
				孩子們來了哦。{wait}
			}
			TextWait
			TextTalk self {
				……話說回來，現在的孩子們
				都懂事得很早呢。{wait}
			}
			TextWait
			TextTalk self {
				比如庫塔，小小年紀
				就對各家店鋪的打折情況
				瞭解得非常清楚。{wait}
			}
			TextWait
			TextTalk self {
				剛才他告訴了我一些物價便宜的店，
				稍後就去那裡買東西好了。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				今天東側大道的
				孩子們來了哦。{wait}
			}
			TextWait
			TextTalk self {
				現在的孩子都懂事得很早，
				作為大人的我
				還真覺得自己的地位岌岌可危呢……{wait}
			}
			TextWait
	elif flag[1346]:
		CharTurnToChar self name[82] 0deg/s
		if !flag[1]:
			TextTalk self {
				說起來……
				你沒有在主日學校
				上學嗎？{wait}
			}
			TextWait
			TextTalk name[82] {
				#1111F上學？
				琪雅也要去那裡嗎？{wait}
			}
			TextWait
			TextTalk name[0] {
				#0003F那、那個……
				情況解釋起來有些麻煩，
				但這個孩子的情況比較特殊，所以現在……{wait}
			}
			TextWait
			TextTalk self {
				啊，不……
				都怪我這麼刨根問底的，
				真是對不起。{wait}
			}
			TextWait
			TextTalk self {
				但要是以後能來上學了……
				請一定要送她來主日學校哦。{wait}
			}
			TextWait
			TextTalk self {
				多了個小夥伴，
				其他的孩子們也肯定會非常高興的……{wait}
			}
			TextWait
			TextTalk name[82] {
				#1110F嗯，如果琪雅有興趣的話～！{wait}
			}
			TextWait
			Emote name[0] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			if flag[1356]:
				Emote name[1] 0mm 2000mm 16 19 250ms 1
				SoundPlay sound[23] 0 100 0
			elif flag[1357]:
				Emote name[2] 0mm 2000mm 16 19 250ms 1
				SoundPlay sound[23] 0 100 0
			elif flag[1358]:
				Emote name[3] 0mm 2000mm 16 19 250ms 1
				SoundPlay sound[23] 0 100 0
			Emote self 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Sleep 1500ms
			FlagSet flag[1]
		else:
			TextTalk self {
				那個……琪雅，
				希望妳以後能來主日學校哦。{wait}
			}
			TextWait
			TextTalk self {
				我們一定會歡迎你的。{wait}
			}
			TextWait
	elif flag[1342]:
		if !flag[1]:
			CharTurnToChar self name[82] 0deg/s
			TextTalk self {
				……哎呀，好可愛呢！
				呵呵，你叫什麼名字呢？{wait}
			}
			TextWait
			TextTalk name[82] {
				#1110F琪雅的名字叫做琪雅哦！{wait}
			} {
				#1109F……啊，姊姊你
				打扮得好有趣～{wait}
			}
			TextWait
			TextTalk self {
				是、是嗎？
				這只是一般的修女服而已……{wait}
			}
			TextWait
			TextTalk name[82] {
				#1111F修……女？{wait}
			}
			TextWait
			TextTalk name[0] {
				#0003F（嗯，七耀教會的事，
				　琪雅基本都不知道嗎……？）{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				打扮得好有趣……打扮得好有趣……
				是這樣嗎……{wait}
			}
			TextWait
			TextTalk self {
				莫非……
				被孩子們小瞧的原因是
				這身衣服……？{wait}
			}
			TextWait
			Emote name[0] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			if flag[1356]:
				Emote name[1] 0mm 2000mm 16 19 250ms 1
				SoundPlay sound[23] 0 100 0
			elif flag[1357]:
				Emote name[2] 0mm 2000mm 16 19 250ms 1
				SoundPlay sound[23] 0 100 0
			elif flag[1358]:
				Emote name[3] 0mm 2000mm 16 19 250ms 1
				SoundPlay sound[23] 0 100 0
			Sleep 1000ms
			TextTalk name[0] {
				#0006F那、那個……童言無忌，
				我覺得您還是別太在意比較好。{wait}
			}
			TextWait
	elif flag[1307]:
		if !flag[1]:
			TextTalk self {
