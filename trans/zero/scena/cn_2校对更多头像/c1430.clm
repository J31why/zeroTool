fn[6]:
	EventBegin 0
	CrossFade 500ms
	CamSetDistance 14750 2250 7600 0ms
	ED7CamRotate 45deg 26deg 0deg 0ms
	CamPers 440 0ms
	CamZoom 19000 0ms
	CharSetPos name[0] (13750, 1000, 7200) 90deg
	CharSetPos name[1] (13650, 1000, 8000) 90deg
	CharSetPos name[2] (12500, 1000, 7200) 90deg
	CharSetPos name[3] (12400, 1000, 8000) 90deg
	CharTurnTo char[0] 270deg 0deg/s
	CharSetChipPattern char[0] 0
	FadeWait
	TextTalk char[0] {
		噢，是客人嗎？{wait}
	}
	TextWait
	TextTalk char[0] {
		真抱歉，今天已經
		把零件用光了。{wait}
	}
	TextWait
	TextTalk char[0] {
		要是有什麼需要，
		請下次再來吧。{wait}
	}
	TextWait
	TextTalk name[0] {
		#0005F那個……
		這裡是工房商店吧？{wait}
	}
	TextWait
	TextTalk name[2] {
		#0203F（進行調查……）{wait}
	} {
		#0200F資料庫中並沒有
		記載這個地方……
		似乎是沒有經營許可證呢……{wait}
	}
	TextWait
	TextTalk char[0] {
		哈哈哈，確實還沒有
		遞交申請呢。{wait}
	}
	TextWait
	TextTalk char[0] {
		這裡是我的個人工房，
		並不是什麼正式的商店。{wait}
	}
	TextWait
	TextTalk char[0] {
		只是不時負責修理一些
		壞掉的導力製品。{wait}
	}
	TextWait
	TextTalk name[2] {
		#0200F也就是所謂的修理店吧。{wait}
	}
	TextWait
	TextTalk name[3] {
		#0300F哈～真不愧是克洛斯貝爾啊。
		有各式各樣的店呢。{wait}
	}
	TextWait
	TextTalk name[1] {
		#0103F不過……我覺得還是去申請
		一份營業許可證更好吧。{wait}
	}
	TextWait
	TextTalk char[0] {
		哈哈，說的沒錯。{wait}
	}
	TextWait
	TextTalk char[0] {
		算了，反正今天已經要關門盤點了，
		如果有什麼需要，就請以後再來吧。{wait}
	}
	TextWait
	TextTalk char[0] {
		像導力燈壞掉之類的小事，
		只需很便宜的價格就能解決！{wait}
	}
	TextWait
	CharSetPos field_party[0] (13750, 1000, 7600) 90deg
	FlagSet flag[595]
	EventEnd 5
	Return

fn[7]:
	FadeOut 300ms 0x00000000 100
	SoundPlay sound[828] 0 100 0
	TextMessage null {
