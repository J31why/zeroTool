				#0000F斯克特先生
				是這家店的常客嗎？{wait}
			}
			TextWait
			TextTalk name[1] {
				#0100F但、但這家店終究
				也屬於違法營業啊……{wait}
			}
			TextWait
			TextTalk self {
				#08402F哈哈，別說這麼死板的話，
				你們不是也來了嘛。{wait}
			} {
				#08404F如果不懂得活用各種資源，
				是無法勝任克洛斯貝爾
				遊擊士這一工作的。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				#08400F我今天過來取之前
