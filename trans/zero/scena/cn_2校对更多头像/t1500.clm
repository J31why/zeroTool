fn[64]:
	EventBegin 1
	if flag[784] && !flag[793]:
		TextTalk name[0] {
			#0001F這裡是通往郊外的方向……{wait}
		} {
			#0003F怎麼說也不能把賽西兒姊姊
			帶到那種地方去。{wait}
		}
		TextWait
		if !flag[785]:
			TextTalk name[53] {
				#1300F呵呵，是要進行
				魔獸騷亂的調查吧。{wait}
			} {
				跟我來，
				我帶你們去院區二樓。{wait}
			}
			TextWait
		else:
			TextTalk name[53] {
				#1300F呵呵，是要進行
				魔獸騷亂的調查吧。{wait}
			} {
				事發現場在院區的屋頂，
				我帶你們去吧。{wait}
			}
			TextWait
	if flag[793] && !flag[799]:
		TextTalk name[0] {
			#0000F這裡是通往郊外的方向……{wait}
		} {
			#0003F回去之前
			必須向賽西兒姊姊報告一下。{wait}
		}
		TextWait
	if flag[799] && !flag[1024]:
		TextTalk name[0] {
			#0000F已經黃昏了，
			回去的時候乘坐巴士吧。{wait}
		} {
			只要調查巴士站，
			應該就能知道下一班巴士的抵達時間了。{wait}
		}
		TextWait
	if flag[1346] && !flag[1349]:
		TextTalk name[0] {
			#0000F哎呀……
			好不容易來到這了，
			得去醫院找醫生商量一下呢。{wait}
		} {
			到接待處去詢問下有關
			『神經科』的事吧。{wait}
		}
		TextWait
	if flag[1349] && !flag[1351]:
		TextTalk name[0] {
			#0003F不能帶著琪雅
			去市外啊……{wait}
		} {
			#0000F而且還必須向約亞西姆醫生
			詢問有關琪雅記憶的事。{wait}
		}
		TextWait
	if flag[1351] && !flag[1536]:
		if !flag[11]:
			TextTalk name[0] {
				#0003F……琪雅大概
				還在醫院用地的範圍內。{wait}
			} {
