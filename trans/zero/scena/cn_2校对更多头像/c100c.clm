fn[14]:
	TextStart self
	if flag[1307]:
		TextTalk self {
			啊，不好了，印章收集之旅
			的禮品兌換，好像就截至到今天啊。{wait}
		}
		TextWait
		TextTalk self {
			必須趕快去
			兌換禮品。{wait}
		}
		TextWait
	elif flag[1362]:
		TextTalk self {
			今年的遊行真的很壯觀啊～{wait}
		}
		TextWait
		TextTalk self {
			揮手致意的孩子們
			也都很可愛啊～{wait}
		}
		TextWait
	elif flag[1292]:
		TextTalk self {
			出來購物，忍不住
			就逛了很多家店。{wait}
		}
		TextWait
		TextTalk self {
			呼……這可不太好啊，
			對家人們還是保密吧。{wait}
		}
		TextWait
	elif flag[1282]:
		if !flag[4]:
			TextTalk self {
				今年好像也有人去了
				阿爾摩利卡村。{wait}
			}
			TextWait
			TextTalk self {
				那裡確實是個很漂亮的地方……
				最重要的是還能吃到無比美味的料理呢。{wait}
			}
			TextWait
			FlagSet flag[4]
		else:
			TextTalk self {
				阿爾摩利卡村是個很漂亮的地方，
				而且在那裡還能吃到無比美味的料理。{wait}
			}
			TextWait
			TextTalk self {
				遊客們會前往那裡
				也是可以理解的。{wait}
			}
			TextWait
	elif flag[1280]:
		TextTalk self {
			在紀念慶典期間也不能休息
			的人就是家庭主婦了。{wait}
		}
		TextWait
		TextTalk self {
			烹製晚餐的食材
			總不能不去買。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[15]:
