fn[6]:
	ObjFlagsUnset object[6] 0x0010
	ObjFrame object[6] 30
	EffLoad eff[7] "event\\ev308_02.eff"
	EffPlay eff[7] eff_instance[255] null 0 (-16000, -4300, 14000) 0 0 0 1000 1000 1000 null (0, 0, 0) 0ms
	EffPlay eff[7] eff_instance[255] null 0 (10000, -4300, 1000) 0 0 0 1000 1000 1000 null (0, 0, 0) 0ms
	EffPlay eff[7] eff_instance[255] null 0 (-16000, -6000, -10000) 0 0 0 1000 1000 1000 null (0, 0, 0) 0ms
	Return

fn[7]:
	TextStart self
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"對話" // 0
			"購物" // 1
			"放棄" // 2
		MenuWait var[0]
		if var[0] != 1:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			ShopOpen shop[57]
			var[0] = 99
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			if flag[1307]:
				if !flag[0]:
					TextTalk self {
						……呼，真抱歉。{wait}
					}
					TextWait
					TextTalk self {
						７０周年紀念的收藏品
						已經全部賣完啦。{wait}
					}
					TextWait
					Emote self 0mm 2000mm 8 9 250ms 2
					SoundPlay sound[27] 0 100 0
					Sleep 1500ms
					TextTalk self {
						呀，全部賣完了呢～！
						如此大賣還是頭一次呢～！{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk self {
						……呼，真抱歉。
						紀念收藏品已經全部賣完了。{wait}
					}
					TextWait
					TextTalk self {
						呵呵，辛苦製作的汗水
						終於有了回報呢。{wait}
					}
					TextWait
			elif flag[1362]:
				TextTalk self {
					孩子們買了
					很多風車。{wait}
				}
				TextWait
				TextTalk self {
					小孩子嘛，就是喜歡
					這種東西。
					我也算是瞭解啦。{wait}
				}
				TextWait
			elif flag[1292]:
				TextTalk self {
					不知為何，
					聚集了很多人啊。{wait}
				}
				TextWait
				TextTalk self {
					這可是絕好的銷售機會啊！{wait}
				}
				TextWait
			elif flag[1282]:
				TextTalk self {
					……哎呀，
					紀念慶典來了很多人呢。{wait}
				}
				TextWait
				TextTalk self {
					紀念品就像不要錢一樣，
					賣得飛快啊。{wait}
				}
				TextWait
			elif flag[1280]:
				if !flag[0]:
					TextTalk self {
						#4S嘿，歡迎光臨～！{wait}
					}
					TextWait
					TextTalk self {
						來看看嗎？
						這裡有７０周年紀念
						的收藏品哦～！{wait}
					}
					TextWait
					TextTalk self {
						雨傘架，桌上鐘錶，
						連煙盒都有哦！{wait}
					}
					TextWait
					TextTalk self {
						克洛斯貝爾市政廳的模型
						僅此一套，先到先得喲！！{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk self {
						要不要買點７０周年
						的紀念品呀～！{wait}
					}
					TextWait
	TextEnd self
	Return

