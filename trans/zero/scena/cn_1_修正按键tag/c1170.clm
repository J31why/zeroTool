calmare zero_k scena
scena:
	name "c1170" "c1170" "c1170"
	town town[24]
	bgm bgm[111]
	flags 8192
	item_use fn[0,255]
	unk 255 0

entry:
	pos (0, 0, -1000)
	unk1 0
	cam_from (0, 0, 34000)
	cam_pers 262
	unk2 30
	cam_deg 45deg
	cam_limit 0deg 360deg
	cam_at (0, 0, 0)
	unk3 0
	unk4 0
	flags 0x0001
	town town[24]
	init fn[0,0]
	reinit fn[0,1]

fn[0]:
	Event fn[0,2]
	Return

fn[1]:
	Return

fn[2]:
	EventBegin 1
	FadeOut 0ms 0x00000000 255
	CamSetDistance 0 1000 0 0ms
	ED7CamRotate 45deg 25deg 0deg 0ms
	CamPers 400 0ms
	CamZoom 22000 0ms
	CharSetPos field_party[0] (0, 0, 400) 0deg
	if system[11] != 255:
		CharSetPos field_party[1] (-500, 0, -700) 0deg
	if system[12] != 255:
		CharSetPos field_party[2] (500, 0, -700) 0deg
	if system[13] != 255:
		CharSetPos field_party[3] (0, 0, -1700) 0deg
	if system[14] != 255:
		CharSetPos field_party[4] (-1200, 0, -1900) 0deg
	if system[15] != 255:
		CharSetPos field_party[5] (-1200, 0, 1900) 0deg
	FadeIn 500ms 0x00000000
	FadeWait
	var[0] = 0
	if system[0] == 101:
		Menu menu[0] 10 10 0
			"★【 ３Ｆ 】" // 0
			"　【 １Ｆ 】" // 1
			"　【 離開 】" // 2
		var[2] = 0
	elif system[0] == 100:
		Menu menu[0] 10 10 0
			"　【 ３Ｆ 】" // 0
			"★【 １Ｆ 】" // 1
			"　【 離開 】 " // 2
		var[2] = 1
	MenuWait var[0]
	MenuClose menu[0]
	TextClose 0
	if var[0] == 2:
		FadeOut 500ms 0x00000000 255
		FadeWait
	elif var[2] < var[0]:
		FadeOut 2000ms 0x00000000 255
		SoundPlay sound[159] 0 100 0
		CamSetDistance 0 16000 0 2000ms
		FadeWait
		CamWait 1
		Sleep 800ms
	elif var[2] > var[0]:
		FadeOut 2000ms 0x00000000 255
		SoundPlay sound[159] 0 100 0
		CamSetDistance 0 -14000 0 2000ms
		FadeWait
		CamWait 1
		Sleep 800ms
	else:
		FadeOut 500ms 0x00000000 255
		FadeWait
	if var[0] == 2:
		switch var[2]:
			case 0:
				EventEnd 5
				NewScene "scena/c1160.bin" 100 0 0
				Hcf
				break
			case 1:
				EventEnd 5
				NewScene "scena/c1150.bin" 101 0 0
				Hcf
				break
	else:
		switch var[0]:
			case 0:
				SoundPlay sound[160] 0 100 0
				Sleep 500ms
				EventEnd 5
				NewScene "scena/c1160.bin" 100 0 0
				Hcf
				break
			case 1:
				SoundPlay sound[160] 0 100 0
				Sleep 500ms
				EventEnd 5
				NewScene "scena/c1150.bin" 101 0 0
				Hcf
				break
	Return
