	TextTalk name[0] {
		#11101647V#0000F#6P………………………………{wait}
	}
	TextWait
	TextTalk name[1] {
		#11101648V#0100F#6P黃昏的景色真美呢……{wait}
	}
	TextWait
	TextTalk name[2] {
		#11101649V#0203F#4P是啊……
		感覺美麗得有些讓人不敢直視。{wait}
	}
	TextWait
	Sleep 100ms
	CharSetChipPattern name[3] 0
	Sleep 300ms
	TextTalk name[3] {
		#11101650V#0304F#11P哈～話說，導力車
		還真是好方便啊。{wait}
	} {
		#11101651V#0300F不過，咱們支援課要是也能
		配備專用車就更好了。{wait}
	}
	TextWait
	CharTurnToChar name[0] name[3] 500deg/s
	Sleep 300ms
	TextTalk name[0] {
		#11101652V#0006F#6P唉，應該很難吧。{wait}
	} {
		#11101653V#0000F雖然其它搜查課
		好像都有自己的車…{wait}
	}
	TextWait
	Sleep 100ms
	CharSetChipBase name[2] chip[32]
	CharSetChipPattern name[2] 0
	Sleep 200ms
	TextTalk name[2] {
		#11101654V#0200F#4P……確實，在搜查一課，
		每名調查員應該都配備有
		自己的專用車輛呢。{wait}
	}
	TextWait
	Emote name[0] 0mm 2000mm 2 7 80ms 1
	SoundPlay sound[28] 0 100 0
	Sleep 50ms
	Emote name[1] 0mm 1700mm 2 7 80ms 1
	SoundPlay sound[28] 0 100 0
	Sleep 50ms
	Emote name[3] 0mm 1700mm 2 7 80ms 1
	SoundPlay sound[28] 0 100 0
	Sleep 1000ms
	CharSetChipBase name[3] chip[33]
	CharSetChipPattern name[3] 1
	CharTurnTo name[0] 90deg 500deg/s
	Sleep 300ms
	TextTalk name[0] {
		#11101655V#0005F#5P是、是嗎！？{wait}
	}
	TextWait
	TextTalk name[1] {
		#11101656V#0106F#6P那樣的話，待遇也
		實在是太過優厚了……{wait}
	}
	TextWait
	TextTalk name[3] {
		#11101657V#0306F#5P哎呀呀……這種時候就更加感覺
		不被重視很辛苦了。{wait}
	}
	TextWait
	TextTalk name[0] {
		#11101658V#0006F#5P算了，沒有的東西，
		再想也沒有用……{wait}
	} {
		#11101659V#0000F而且，你們不覺得
		徒步穿越街道也是一種很好的鍛煉嗎？{wait}
	}
	TextWait
	TextTalk name[2] {
		#11101660V#0203F#4P雖然並非本意……
		但也許確實如此呢。{wait}
	} {
		#11101661V#0211F不過，今天已經沒有時間
		再繼續調查下去了吧？{wait}
	}
	TextWait
	TextTalk name[0] {
		#11101662V#0003F#5P嗯，剩下的就是北部的礦山鎮了。{wait}
	} {
		#11101663V#0000F就按照剛才說的那樣，
		今天先回去整理一下調查報告書，
		明天再去拜訪那裡吧。{wait}
	}
	TextWait
	TextTalk name[2] {
		#11101664V#0206F#4P呼……瞭解。{wait}
	}
	TextWait
	TextTalk name[1] {
		#11101665V#0109F#6P呵呵……
		今天還真是累了呢。{wait}
	}
	TextWait
	Sleep 100ms
	CharSetChipBase name[3] chip[33]
	CharSetChipPattern name[3] 0
	Sleep 200ms
	Emote name[3] 0mm 1700mm 10 11 250ms 2
	SoundPlay sound[27] 0 100 0
	Sleep 1200ms
	TextTalk name[3] {
		#11101666V#0309F#11P嗯……
		不過，賽西兒小姐真是太棒了。{wait}
	} {
		#11101667V#0307F好，要是下次有機會，就以
		聯誼會的名義，與她拉近個人關係吧……！{wait}
	}
	TextWait
	Emote name[0] 0mm 2000mm 16 19 250ms 1
	SoundPlay sound[23] 0 100 0
