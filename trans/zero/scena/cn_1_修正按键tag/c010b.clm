	EntranceSetFunc entrance[0] fn[255,65535]
	EntranceSetFunc entrance[1] fn[255,65535]
	EntranceSetFunc entrance[2] fn[255,65535]
	EntranceSetFunc entrance[3] fn[255,65535]
	EntranceSetFunc entrance[4] fn[255,65535]
	TriggerFlagsSet trigger[0] 0x0080
	TriggerFlagsSet trigger[1] 0x0080
	TriggerFlagsSet trigger[2] 0x0080
	TriggerFlagsSet trigger[3] 0x0080
	if flag[1550] && !flag[1554]:
		EntranceSetFunc entrance[0] fn[0,50]
		EntranceSetFunc entrance[1] fn[0,51]
		EntranceSetFunc entrance[2] fn[0,52]
		EntranceSetFunc entrance[4] fn[0,53]
