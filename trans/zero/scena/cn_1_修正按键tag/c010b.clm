fn[58]:
	TextTalk name[0] {
		#0000F太陽都下山了嗎……{wait}
	} {
		琪雅還在等著我們呢，
		不要繞道了，直接回去吧。{wait}
	}
	TextWait
	if PartyPosition name[1] > -1:
		TextTalk name[1] {
			#0100F是呀，工作
			差不多也告一段落了。{wait}
		}
		TextWait
	elif PartyPosition name[2] > -1:
		TextTalk name[2] {
			#0200F說得是呢，快點回去吧。{wait}
		}
		TextWait
	elif PartyPosition name[3] > -1:
		TextTalk name[3] {
			#0300F是啊，趕快回去，
			看看小琪的小臉吧。{wait}
		}
		TextWait
	Return

