		TriggerFlagsUnset trigger[1] 0x0080
		TriggerFlagsUnset trigger[2] 0x0080
		TriggerFlagsUnset trigger[3] 0x0080
	Return

fn[6]:
	TextStart self
	TextTalk self {
		糟糕了～！
		天色都這麼暗了。{wait}
	}
	TextWait
	TextTalk self {
		明明是出來買晚飯的食材的……
		嗚嗚，這下絕對要挨罵了。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[7]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	TextTalk self {
		哦哦……不知不覺都這麼晚了啊。{wait}
	}
	TextWait
	TextTalk self {
		最近不太安寧，
		還是趕快回家吧。{wait}
	}
	TextWait
	CharSetChipPattern self 0
	TextEnd self
	Return

fn[8]:
	TextStart self
	TextTalk self {
		果然，想變瘦的話，
		還是需要適度的運動啊。{wait}
	}
	TextWait
	TextTalk self {
		你啊，明天開始堅持跑步吧。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[9]:
	TextStart self
	TextTalk self {
		哎……
		讓我一個人跑步？才不要呢～{wait}
	}
	TextWait
	TextTalk self {
		我說，陪我一起跑啦～
		那樣我才能堅持下去嘛。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[10]:
	TextStart self
	TextTalk self {
		嘿喲……
		差不多該收攤了吧。{wait}
	}
	TextWait
	TextTalk self {
		啊，你們想要的話，
		可以把剩下的氣球都拿走哦。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[11]:
	TextStart self
	if !flag[614]:
		SoundPlay sound[823] 0 100 0
		TextTalk name[0] {
