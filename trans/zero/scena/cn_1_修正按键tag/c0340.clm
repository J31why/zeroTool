fn[7]:
	if system[4] == 3:
		EntranceSetDisabled entrance[0] 0
		EntranceSetDisabled entrance[3] 1
	else:
		EntranceSetDisabled entrance[0] 1
		EntranceSetDisabled entrance[3] 0
	if flag[1037] && !flag[1038]:
		MapColor 0x00C8D2FF 0ms
	elif flag[1792]:
		MapColor 0x00C8D2FF 0ms
	else:
	Return

fn[8]:
	TextStart self
	if flag[1792]:
		TextTalk char[0] {
			哎呀，下面好吵啊。{wait}
		}
		TextWait
		TextTalk char[0] {
			發生什麼事了嗎？{wait}
		}
		TextWait
	elif flag[1362]:
		TextTalk char[0] {
			紀念慶典最盛大的活動
			終於也結束了。
			孫子們能開心比什麼都重要。{wait}
		}
		TextWait
		TextTalk char[0] {
			那麼……還剩下一條行程安排，
			明天也要按計劃把事情完成呀。{wait}
		}
		TextWait
	elif flag[1292]:
		if flag[0]:
			TextTalk char[0] {
				等洗完衣服，
				我也出去走走吧。{wait}
			}
			TextWait
		else:
			TextTalk char[0] {
				今天是一家人
				一起大掃除的日子。{wait}
			}
			TextWait
			TextTalk char[0] {
				大家分工合作
				就能早點完成打掃了。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1282]:
		if flag[0]:
			TextTalk char[0] {
				我兒子在ＩＢＣ工作，
				兒媳在外資企業的分公司工作。{wait}
			}
			TextWait
			TextTalk char[0] {
				雖然我知道他們很忙，
				但至少在慶典期間也要回來
				陪孫子們玩一玩啊。{wait}
			}
			TextWait
		else:
			TextTalk char[0] {
				難得的紀念慶典，
				兒子和兒媳卻都說工作很忙不能回來。{wait}
			}
			TextWait
			TextTalk char[0] {
				唉……我倒是
				無所謂，{wait}
			}
			TextWait
			TextTalk char[0] {
				不過孫子們
				應該會很寂寞吧。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1280]:
		if flag[0]:
			TextTalk char[0] {
				今天我準備帶孫子們
				在附近逛逛。{wait}
			}
			TextWait
			TextTalk char[0] {
				紀念慶典是個悠久的傳統慶典，
				雖然玩的時候要注意節制，但不好好享受就太可惜了。{wait}
			}
			TextWait
		else:
			TextTalk char[0] {
				就算是紀念慶典，
				也不用那麼急急忙忙的。{wait}
			}
			TextWait
			TextTalk char[0] {
				窗戶要關好……
				嗯，應該沒忘什麼東西吧？{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1040]:
		_Char4A char[1] 255
		if flag[0]:
			CharTurnToChar self field_party[0] 0deg/s
			TextTalk char[0] {
				別看我現在上了年紀，
				年輕時也是銀髮飄飄，很受歡迎的。{wait}
			}
			TextWait
			TextTalk char[0] {
				我還很擅長跳舞哦。{wait}
			}
			TextWait
			CharTurnTo self 0deg 0deg/s
		else:
			TextTalk char[0] {
				像這樣，腰放低點，{wait}
			}
			TextWait
			TextTalk char[0] {
				然後將手輕輕搭上，
				剩下的只要跟著節奏就行了。{wait}
			}
			TextWait
			FlagSet flag[0]
		_Char4B char[1] 255
	elif flag[0]:
		TextTalk char[0] {
			我今天約了一個
			老朋友見面。{wait}
		}
		TextWait
		TextTalk char[0] {
			呵呵，要不要互相吹捧下
			自己的孫子們呢。{wait}
		}
		TextWait
	else:
		TextTalk char[0] {
			菲利克雖然有點調皮，
			但其實是個善良的孩子。{wait}
		}
		TextWait
		TextTalk char[0] {
			莘蒂比較早熟，
			但很開朗，也很會做家務。{wait}
		}
		TextWait
		TextTalk char[0] {
			最近，安里的臉上
			一直掛著燦爛的笑容。{wait}
		}
		TextWait
		TextTalk char[0] {
			……有這麼多孫子，
			真是幸福啊。
			兒子做得最孝順的事就是給我生了這幾個孫子。{wait}
		}
		TextWait
		FlagSet flag[0]
	TextEnd self
	Return

fn[9]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if flag[1566]:
		if flag[0]:
			TextTalk char[3] {
				那個……邦德先生
				出什麼事了嗎？{wait}
			}
			TextWait
		else:
			TextTalk char[3] {
				住在隔壁的蘇菲亞夫人
				剛才過來問我
				有沒有見過邦德先生。{wait}
			}
			TextWait
			TextTalk char[3] {
				邦德先生好像是住這附近的
				一位證券經理吧。{wait}
			}
			TextWait
			TextTalk char[3] {
				我也沒見過他……
				邦德先生怎麼了？{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1554]:
		if flag[0]:
			TextTalk char[3] {
				我們這些市民，
				已經對議會不抱一絲希望了。{wait}
			}
			TextWait
			TextTalk char[3] {
				……雖然很令人遺憾，
				但還是希望趕快結束算了。{wait}
			}
			TextWait
		else:
			TextTalk char[3] {
				克洛斯貝爾的議會
				在七十多年來一直
				都反覆做著同樣的事。{wait}
			}
			TextWait
			TextTalk char[3] {
				有時帝國派掌權，
				有時共和國派掌權，
				但都是追求自己的利益……{wait}
			}
			TextWait
			TextTalk char[3] {
				議會從沒做出一點成績。
				我們這些市民會對其失望，
				也是理所當然的了。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1536]:
		if flag[0]:
			TextTalk char[3] {
				比起考試成績，
				與朋友一起學習的過程
				更加重要。{wait}
			}
			TextWait
			TextTalk char[3] {
				我是這樣想的呢。{wait}
			}
			TextWait
		else:
			TextTalk char[3] {
				安里在主日學校的考試……
				好像又是滿分。{wait}
			}
			TextWait
			TextTalk char[3] {
				一個人只懂得
				學習書本知識是不夠的。{wait}
			}
			TextWait
			TextTalk char[3] {
				希望他能多學學
				怎樣跟朋友相處。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1342]:
		if flag[0]:
			TextTalk char[3] {
				我兒子雖然是ＩＢＣ事業部的主任，
				但作為一家之主還遠遠不夠。{wait}
			}
			TextWait
		else:
			TextTalk char[3] {
				正因為是難得的休息日，
				才更不能懶懶散散的。{wait}
			}
			TextWait
			TextTalk char[3] {
				這種時候就應該
				幫忙做一點
				家務事啊。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1055]:
		if flag[0]:
			TextTalk char[3] {
				說起名門出身的人，
				性格往往各不相同。{wait}
			}
			TextWait
			TextTalk char[3] {
				但至少我的朋友都是
				一些嚴肅認真的人。{wait}
			}
			TextWait
			TextTalk char[3] {
				一定是因為背負著家族之名，
				所以必須具備相應的覺悟吧。{wait}
			}
			TextWait
		else:
			TextTalk char[3] {
				我有幾個老朋友
				都是名門出身的。{wait}
			}
			TextWait
			TextTalk char[3] {
				克洛斯貝爾現在這些有名望的家族，
				以前都是經商起家的……{wait}
			}
			TextWait
			TextTalk char[3] {
				在悠長的年月中人才輩出，
				逐漸被世人所認可，最終成為了名門世家。{wait}
			}
			TextWait
			TextTalk char[3] {
				我雖然並不是很喜歡
				世家傳承這種觀點。
				但大家都是一些嚴肅認真的人哦。{wait}
			}
			TextWait
			TextTalk char[3] {
				一定是因為背負著家族之名，
				所以必須具備相應的覺悟吧。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[801]:
		if flag[0]:
			TextTalk char[3] {
				安里最近
				變得很活潑。{wait}
			}
			TextWait
			TextTalk char[3] {
				如果是交了朋友的緣故，
				那就必須感謝那個朋友啊。{wait}
			}
			TextWait
		else:
			TextTalk char[3] {
				最近安里
				經常去外面玩。{wait}
			}
			TextWait
			TextTalk char[3] {
				以前明明都會
				一直悶在家裡的。
				是因為交了朋友吧。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[777]:
		TextTalk char[3] {
			今天來
			整理整理舊衣服吧。{wait}
		}
		TextWait
		TextTalk char[3] {
			免得到了換季時期，
			孩子們又會慌慌張張地找不到衣服。{wait}
		}
		TextWait
	elif flag[768]:
		if flag[0]:
			TextTalk char[3] {
				我正在幫安里
				織新睡衣哦。{wait}
			}
			TextWait
			TextTalk char[3] {
				手工織的應該
				更能讓他感到溫暖吧。{wait}
			}
			TextWait
		else:
			TextTalk char[3] {
				我正在幫安里
				織新睡衣哦。{wait}
			}
			TextWait
			TextTalk char[3] {
				雖然只要花點錢
				就能買到好品質的衣服，{wait}
			}
			TextWait
			TextTalk char[3] {
				但安里年紀還小，
				手工織的應該
				更能讓他感到溫暖吧。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[533]:
		if flag[0]:
			TextTalk char[3] {
				希望孩子們能多
				經歷點事情，
				這樣他們才能懂得如何去分辨善惡。{wait}
			}
			TextWait
		else:
			TextTalk char[3] {
				這世上有好人
