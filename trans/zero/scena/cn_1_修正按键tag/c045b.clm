	_59
	VisSet vis[1] 3 0x00FFFFFF 500ms 0 0
	VisWait vis[1] 3
	BgmVolume 100 500ms
	TextTalk char[9] {
		#14100637V#11P哼，是還有過那種事啊。{wait}
	}
	TextWait
	TextTalk char[9] {
		#14100638V#11P想起來了……
		確實是當時的那些警察小鬼啊。{wait}
	}
	TextWait
	TextTalk char[9] {
		#14100639V#11P你們找本大爺有什麼事？嗝！{wait}
	}
	TextWait
	TextTalk name[0] {
		#14100640V#6P#0006F那個，其實是瑪因茲的
		鎮長先生拜託我們……{wait}
	} {
		#14100641V#0000F來尋找您的下落。{wait}
	}
	TextWait
	Emote char[9] 0mm 2000mm 38 38 250ms 1
	Sleep 1000ms
	TextTalk char[9] {
		#14100642V#11P鎮長找我……？{wait}
	}
	TextWait
