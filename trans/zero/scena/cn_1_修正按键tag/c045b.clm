fn[13]:
	TextStart self
	TextTalk self {
		拜託交易對象訂了旅館，
		沒想到是這麼高級的飯店。{wait}
	}
	TextWait
	TextTalk self {
		這有一半算是應酬吧。
		唉唉，真不知道之後會怎樣。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[14]:
	TextStart self
	if !flag[2]:
		TextTalk self {
			我和我太太預約了
			頂層的一間客房。{wait}
		}
		TextWait
		TextTalk self {
			待在克洛斯貝爾的這段期間，
			就決定住在這裡了。{wait}
		}
		TextWait
		FlagSet flag[2]
	else:
		TextTalk self {
			如此說來……
			聽說有個人
			把這裡的豪華套房包下來了。{wait}
		}
		TextWait
		TextTalk self {
			呵呵，是哪裡的有錢少爺嗎？
			挺讓人感興趣呢。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[15]:
	TextStart self
	TextTalk self {
		說到千禧飯店，
		一直都是以格調高雅而聞名的。{wait}
	}
	TextWait
	TextTalk self {
		住宿還是應該
		選擇值得信賴的地方呢。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[16]:
	Call fn[0,17]
	Return

fn[17]:
