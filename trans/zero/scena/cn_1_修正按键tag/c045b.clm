fn[6]:
	TextStart char[3]
	if !flag[604]:
		TextTalk char[3] {
			歡迎光臨《千禧飯店》。{wait}
		}
		TextWait
		TextTalk char[3] {
			呵呵，本飯店
			為您提供多種多樣的服務。{wait}
		}
		TextWait
		TextTalk char[3] {
			可以讓您在歡樂之都克洛斯貝爾
			享受完美的一天。{wait}
		}
		TextWait
		_59
		FadeOut 300ms 0x00000000 100
		TextSetPos -1 -1 -1 -1
		SoundPlay sound[828] 0 100 0
		TextSetName ""
		TextMessage null {
			{color 5}在飯店或酒館裡休息
			可以回復ＣＰ。{wait}
		}
		TextWait
		TextMessage null {
			{color 5}在普通酒館裡可以回復ＣＰ１００，
			在高級飯店裡可以回復ＣＰ２００。{wait}
		}
		TextWait
		TextClose 0
		FadeIn 300ms 0x00000000
		TextSetPos -1 280 60 3
		_59
		FlagSet flag[604]
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"對話" // 0
			"休息" // 1
			"放棄" // 2
		MenuWait var[0]
		if var[0] != 1:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			ShopOpen shop[60]
			var[0] = 99
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			TextTalk char[3] {
				哎呀，要住宿嗎？{wait}
			}
			TextWait
			TextTalk char[3] {
				今天未被預約的房間
				只剩下一間了。{wait}
			}
			TextWait
			TextTalk char[3] {
				還請
				儘早下決定。{wait}
			}
			TextWait
	TextEnd char[3]
	Return

