		#14100627V#11P嗯嗯？你們是什麼人……？{wait}
	}
	TextWait
	TextTalk name[0] {
		#14100628V#6P#0003F──打擾了，
		我們是克洛斯貝爾警察局的人。{wait}
	} {
		#14100629V#0000F您是瑪因茲的岡茲先生吧？{wait}
	}
	TextWait
	TextTalk char[9] {
		#14100630V#11P嗝，是啊……{wait}
	}
	TextWait
	TextTalk char[9] {
		#14100631V#11P我好像
		在哪裡見過你們幾個……？{wait}
	}
	TextWait
	TextTalk name[0] {
		#14100632V#6P#0005F哎……{wait}
	}
	TextWait
	TextTalk name[2] {
		#14100633V#6P#0211F……話說，這個人……{wait}
	} {
		#14100634V不就是軍犬風波的時候
		差點被襲擊的
