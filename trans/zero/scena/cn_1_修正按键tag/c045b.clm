fn[9]:
	TextStart self
	_Char4A char[1] 255
	TextTalk char[2] {
		小費也是那位客人的一番好意……
		朵莉絲，你就收下吧。{wait}
	}
	TextWait
	TextTalk char[2] {
		還有，不要在其他客人的面前
		商量這種事哦。{wait}
	}
	TextWait
	_Char4B char[1] 255
	TextEnd self
	Return

fn[10]:
	TextStart self
	_Char4A char[2] 255
	TextTalk char[1] {
		住在頂層的客人
		給了我一筆
		數額驚人的小費。{wait}
	}
	TextWait
	TextTalk char[1] {
		這、這麼多錢，該怎麼辦呀……
		還是報告給總管比較好吧。{wait}
	}
	TextWait
	_Char4B char[2] 255
	TextEnd self
	Return

fn[11]:
	TextStart self
