fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if QuestTaskGet quest[13] 2 && !QuestFlagsGet quest[13] 0x10:
		Event fn[0,13]
	if flag[1566]:
		CharFlagsUnset char[2] 0x0080
		CharFlagsUnset char[3] 0x0080
		CharFlagsUnset char[4] 0x0080
		CharSetChipBase char[4] chip[5]
		CharSetChipPattern char[4] 0
		ForkQuit char[4] fork[0]
		CharFlagsSet char[4] 0x0004
		CharFlagsSet char[4] 0x0010
		CharSetPos char[4] (38320, 180, -2250) 0deg
		CharFlagsSet char[4] 0x0010
		CharFlagsSet char[4] 0x0040
		CharFlagsSet char[4] 0x0004
	elif flag[1554]:
		CharFlagsUnset char[2] 0x0080
		CharFlagsUnset char[3] 0x0080
	elif flag[1536]:
		CharFlagsUnset char[2] 0x0080
		CharFlagsUnset char[3] 0x0080
		CharFlagsUnset char[4] 0x0080
		CharSetChipBase char[1] chip[6]
		CharSetChipPattern char[1] 0
		ForkQuit char[1] fork[0]
		CharFlagsSet char[1] 0x0004
		CharFlagsSet char[1] 0x0010
		CharSetPos char[1] (-38500, 150, -3230) 90deg
	elif flag[1307]:
		CharFlagsUnset char[3] 0x0080
		CharFlagsUnset char[4] 0x0080
	elif flag[1292]:
		CharFlagsUnset char[3] 0x0080
		CharFlagsUnset char[4] 0x0080
	elif flag[1282]:
		CharFlagsUnset char[3] 0x0080
	elif flag[1280]:
		CharFlagsUnset char[3] 0x0080
		CharFlagsUnset char[4] 0x0080
	elif flag[1040]:
		CharFlagsUnset char[2] 0x0080
		CharFlagsUnset char[3] 0x0080
		CharFlagsUnset char[4] 0x0080
	elif flag[1024]:
		CharFlagsUnset char[2] 0x0080
		CharFlagsUnset char[3] 0x0080
		CharFlagsUnset char[4] 0x0080
	elif flag[801]:
		CharFlagsUnset char[2] 0x0080
		CharFlagsUnset char[3] 0x0080
	elif flag[776]:
		CharFlagsUnset char[2] 0x0080
		CharFlagsUnset char[3] 0x0080
	elif flag[774]:
		CharFlagsUnset char[2] 0x0080
		CharFlagsUnset char[3] 0x0080
	elif flag[768]:
