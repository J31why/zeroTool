fn[2]:
	ED7_76_0 object[255] "kage03" 1
	ED7_76_0 object[255] "tuika01" 1
	if !flag[2078]:
		ObjFrame object[0] 0
	else:
		ObjFrame object[0] 30
	LookPointFlagsSet look_point[1] 0x0001
	if QuestTaskGet quest[40] 4 && !QuestTaskGet quest[40] 5:
		LookPointFlagsUnset look_point[1] 0x0001
	Call fn[0,3]
	Return

fn[3]:
	if system[0] != 102:
		ObjFlagsSet object[0] 0x0004
	else:
		ObjFlagsUnset object[0] 0x0004
	Return

fn[4]:
	ED7_F2 1
	SystemFlagsSet 0x08000000
	if !flag[2078]:
		SoundPlay sound[14] 0 100 0
		ED7ObjPlay object[0] 0 30 0 0
		Sleep 500ms
		if ItemAdd item[133] 1:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextSetName ""
			TextMessage name[742] {
				{color 0}已取得{item[133]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			TextSetPos -1 280 60 3
			FadeIn 300ms 0x00000000
			FlagSet flag[2078]
			ED7_DE 6
		else:
			FadeOut 300ms 0x00000000 100
			TextSetName ""
			TextMessage name[742] {
				寶箱內裝著{item[133]}{color 0}。
				但因持有物品已滿而放棄{item[133]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			SoundPlay sound[15] 0 100 0
			ED7ObjPlay object[0] 30 0 0 0
	else:
		FadeOut 300ms 0x00000000 100
		TextSetPos -1 -1 -1 -1
		TextSetName ""
		TextMessage name[742] {
			{0x06}{color 5}寶箱內空無一物。{color 0}{wait}
		}
		TextWait
		TextClose 0
		FadeIn 300ms 0x00000000
	Sleep 30ms
	TextEnd null
	SystemFlagsUnset 0x08000000
	Return

fn[5]:
	if flag[1024]:
		if QuestFlagsGet quest[13] 0x02 && !QuestTaskGet quest[13] 0:
			Call fn[0,12]
			Return
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if flag[1566]:
		if !flag[0]:
			TextTalk self {
				……如今的生活
				是女神賜予阿爾摩利卡村
				的自然姿態。{wait}
			}
			TextWait
			TextTalk self {
				胡亂追求發展的話，
				必然會再次導致
				之前的魔獸騷動那種事。{wait}
			}
			TextWait
			TextTalk self {
				……雖然也不是不明白
				那傢伙的想法。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				德瑞克想讓村民們過上
				富裕生活的想法也不是不能理解……{wait}
			}
			TextWait
			TextTalk self {
				但作為現任村長，只有這一點是不能妥協的。{wait}
			}
			TextWait
	elif flag[1554]:
		TextTalk self {
			我認為像德瑞克那樣，
			拿村子和克洛斯貝爾市來比較，
			是毫無意義的……{wait}
		}
		TextWait
		TextTalk self {
			克洛斯貝爾市是克洛斯貝爾市，
			阿爾摩利卡村是阿爾摩利卡村……{wait}
		}
		TextWait
		TextTalk self {
			兩者各行其道才是
			順應自然法則。{wait}
		}
		TextWait
	elif flag[1536]:
		if !flag[0]:
			TextTalk self {
				我前幾天跟德瑞克
				討論了村子的將來……{wait}
			}
			TextWait
			TextTalk self {
				他還是堅持
				應該發展村子，
				不肯聽我的話。{wait}
			}
			TextWait
			TextTalk self {
				紀念慶典中，因為他太過貪心，
				招來了過多的遊客，
				已經產生很多問題了……{wait}
			}
			TextWait
			TextTalk self {
				德瑞克也真讓人傷腦筋啊。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				德瑞克那傢伙，
				不支持我希望村子
				維持現狀的想法。{wait}
			}
			TextWait
			TextTalk self {
				……到底該怎麼辦才好呢。{wait}
			}
			TextWait
	elif flag[1307]:
		if !flag[0]:
			TextTalk self {
				唔……遊客也差不多
				都回克洛斯貝爾市了啊。{wait}
			}
			TextWait
			TextTalk self {
				這次為了吸引遊客而開設露天店……
				到底對不對呢？{wait}
			}
			TextWait
			TextTalk self {
				雖然村子的確有盈利……
				但是也發生了遊客
				誤入古戰場這樣的麻煩。{wait}
			}
			TextWait
			TextTalk self {
				……等德瑞克回來以後，
				要好好跟他談一次才行。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				雖然遊客增加，
				村子有所盈利，
				但是也發生了一些麻煩……{wait}
			}
			TextWait
			TextTalk self {
				……等德瑞克回來以後，
				要好好跟他談一次才行。{wait}
			}
			TextWait
	elif flag[1292]:
		if !flag[0]:
			TextTalk self {
				……今年的紀念慶典
				果然來了很多遊客啊。{wait}
			}
			TextWait
			TextTalk self {
				德瑞克的目的
				達到了嗎……{wait}
			}
			TextWait
			TextTalk self {
				這會對村子的發展
				有所幫助嗎……？{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				來觀光的遊客數量，
				今天應該會達到頂峰吧。{wait}
			}
			TextWait
			TextTalk self {
				這究竟能否對村子的發展
				有所幫助呢……？{wait}
			}
			TextWait
	elif flag[1282]:
		if !flag[0]:
			TextTalk self {
				嗯……參觀紀念慶典的遊客被吸引而來，
				讓村子變得熱鬧，倒也不錯……
				但不知會持續到何時呢。{wait}
			}
			TextWait
			TextTalk self {
				他們畢竟只是遊客嘛。
				到紀念慶典快結束的時候，
				也會漸漸散去的吧。{wait}
			}
			TextWait
			TextTalk self {
				聽說他們還妨礙了農務……
				果然凡事並非都只有好的一面啊。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				我感覺村子的熱鬧
				也只是一時的。{wait}
			}
			TextWait
			TextTalk self {
				聽說他們還妨礙了農務……
				果然凡事並非都只有好的一面啊。{wait}
			}
			TextWait
	elif flag[1280]:
		if !flag[0]:
			TextTalk self {
				看露天店的情況，
				似乎廣受好評。{wait}
			}
			TextWait
			TextTalk self {
				作為長年生產蜂蜜的
				阿爾摩利卡村村長，
				沒有比這更值得驕傲的了。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				露天店似乎廣受好評……
				將這件事交給德瑞克，
				看來是正確的啊。{wait}
			}
			TextWait
			TextTalk self {
				身為阿爾摩利卡村村長，
				沒有比這更值得驕傲的了。{wait}
			}
			TextWait
	elif flag[1040]:
		if !flag[0]:
			TextTalk self {
				德瑞克提出的開辦露天店的建議……
				似乎進展得很順利。{wait}
			}
			TextWait
			TextTalk self {
				唔，村民們
				似乎也很開心……{wait}
			}
			TextWait
			TextTalk self {
				允許他這麼做，
				或許是正確的吧。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				接下來就是創立紀念慶典
				正式開始之後的事了。{wait}
			}
			TextWait
			TextTalk self {
				希望遊客不要來得太多，
				進而引發什麼不好的事情。{wait}
			}
			TextWait
	elif flag[1024]:
		if QuestFlagsGet quest[13] 0x10:
			TextTalk self {
				特務支援課嗎……{wait}
			}
			TextWait
			TextTalk self {
				一開始見面的時候，
				還真沒想到
				警察會這麼可靠呢。{wait}
			}
			TextWait
			TextTalk self {
				以後再有什麼事的話，就麻煩你們了。{wait}
			}
			TextWait
		elif QuestTaskGet quest[13] 0:
			TextTalk self {
				魔獸侵佔的私有地
				就在村子的東南方向，
				沿著那個方向前進就是了。{wait}
			}
			TextWait
			TextTalk self {
				私有地裡的東西，
				你們可以隨便使用。
				一切就拜託了。{wait}
			}
			TextWait
		elif !flag[0]:
			TextTalk self {
				我兒子德瑞克
				提議要振興村子。{wait}
			}
			TextWait
			TextTalk self {
				雖然我認為如果
				做得太過火，忘卻了
				謙恭的生活態度也不好……{wait}
			}
			TextWait
			TextTalk self {
				不過，在創立紀念慶典開設露天店這種事，
				我以前也曾經參加過，
				所以就推薦他試試。{wait}
			}
			TextWait
			TextTalk self {
				好吧，
				看看會有什麼結果……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				看到克洛斯貝爾市的樣子，
				我就會覺得
				一味發展也未必是好事。{wait}
			}
			TextWait
			TextTalk self {
				我覺得這個村子
				一直像往昔一樣樸素就好。{wait}
			}
			TextWait
			TextTalk self {
				但我兒子德瑞克
				似乎不同意我的看法……{wait}
			}
			TextWait
			TextTalk self {
				好吧，在紀念慶典開辦的露天店，
				會有什麼結果呢……{wait}
			}
			TextWait
	elif flag[801]:
		if !flag[0]:
			TextTalk self {
				昨天聽你們說過之後，
				我就提醒過村民了。{wait}
			}
			TextWait
			TextTalk self {
				魔獸還沒被找到吧？
				我們村子也尚不能安心度日啊。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				魔獸還沒被找到吧？
				村民們當然都得注意，
				你們也要多加小心哦。{wait}
			}
			TextWait
	elif flag[776]:
		if !flag[0]:
			TextTalk self {
				唔，果然什麼也沒查到嗎……{wait}
			}
			TextWait
			TextTalk self {
				那已經是三個星期前的事了。
				從某種程度上說，也是沒辦法的吧。{wait}
			}
			TextWait
			TextTalk self {
				既然我們村子之外的地方也受了災，
				或許應該去
				那些地方問問吧。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				還有『神狼』的事……
				那純粹只是個傳說。{wait}
			}
			TextWait
			TextTalk self {
				雖然我告訴了你們，
				但也不用太在意啊。{wait}
			}
			TextWait
	elif flag[768]:
		if !flag[0]:
			TextTalk self {
				話說，探聽情報啊……
				警察的工作
				也不比遊擊士輕鬆啊。{wait}
			}
			TextWait
			TextTalk self {
				畢竟事情發生的時候
				都已經是深夜了嘛。{wait}
			}
			TextWait
			TextTalk self {
				雖然不知道能不能得到什麼有用的情報……
				不過還是先問問村裡的人吧。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				現在這時間的話，
				出去幹農活的人
				應該也都回來了吧。{wait}
			}
			TextWait
			TextTalk self {
				也有很多人在
				河邊的酒館《白蠟亭》吃午飯。
				願意的話，去那裡看看如何？{wait}
			}
			TextWait
	CharSetChipPattern self 0
	TextEnd self
	Return

fn[6]:
	TextStart self
	if flag[1566]:
		TextTalk self {
			我丈夫昨天又和德瑞克
			吵了一架。{wait}
		}
		TextWait
		TextTalk self {
			畢竟是父子，
			真希望他們能互相理解……{wait}
		}
		TextWait
		TextTalk self {
			但是看情況，一時半會還是很難啊。{wait}
		}
		TextWait
	elif flag[1554]:
		TextTalk self {
			我丈夫和德瑞克
			都有堅定的思想，
			對立是在所難免的。{wait}
		}
		TextWait
		TextTalk self {
			……事情總會有波折呢。{wait}
		}
