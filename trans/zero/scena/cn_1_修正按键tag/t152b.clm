fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if system[0] == 115 && flag[1796] && !flag[1802]:
		Event fn[0,13]
	if flag[736]:
		FlagUnset flag[736]
		Event fn[0,6]
	Return

fn[2]:
	ED7_76_0 object[255] "BED01" 1
	ED7_76_0 object[255] "BED02" 1
	TriggerFlagsSet trigger[0] 0x0080
	if flag[1796] && !flag[1801]:
		TriggerFlagsUnset trigger[0] 0x0080
	if flag[1801] && !flag[1822]:
		Call fn[0,12]
	Return

fn[3]:
	TextStart self
	TextSetName ""
	TextMessage null {
		{color 5}黑手黨成員失去了意識。{color 0}{wait}
	}
	TextWait
	TextClose 0
	_59
	TextEnd self
	Return

fn[4]:
	TextStart self
	if !flag[0]:
		TextTalk self {
			我們工作結束之後
			就在房間裡聊天……{wait}
		}
		TextWait
		TextTalk self {
			突然間就有黑衣人和狗闖進來，
			我們嚇得動都不敢動。{wait}
		}
		TextWait
		TextTalk self {
			還好你們來了，
			總算是放心了。
			謝謝，真的很感謝你們。{wait}
		}
		TextWait
		FlagSet flag[0]
	else:
		CharTurnToChar self char[3] 0deg/s
		TextTalk self {
			……那些黑衣人和狗
			還在外面四處晃悠呢……{wait}
		}
		TextWait
		TextTalk self {
			希蓉，可不能離開這裡哦。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[5]:
	TextStart self
	if !flag[1]:
		TextTalk self {
			賽西兒前輩和其他護理師們
			都還留在院區內值夜班。{wait}
		}
		TextWait
		TextTalk self {
			請、請努力救出她們吧。
			我和梅菲爾
			就躲在這裡……{wait}
		}
		TextWait
		FlagSet flag[1]
	else:
		TextTalk self {
			呼…………
			安下心之後，就全身無力了。{wait}
		}
		TextWait
		TextTalk self {
			咦、咦……
			腳在發抖，都動不了……{wait}
		}
		TextWait
	TextEnd self
	Return

