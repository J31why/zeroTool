	ED7_76_0 object[1] "light01" 1
	ED7_76_0 object[2] "sign01" 1
	ED7_76_0 object[2] "light01" 1
	if system[0] == 101:
		SystemFlagsSet 0x00002000
		SystemFlagsSet 0x08000000
		ED7_E0 2
	else:
		SystemFlagsUnset 0x00002000
		SystemFlagsUnset 0x08000000
	TriggerFlagsSet trigger[2] 0x0080
	if !flag[1291]:
		TriggerFlagsUnset trigger[2] 0x0080
	TriggerFlagsSet trigger[3] 0x0080
	if flag[1291] && !flag[705]:
		TriggerFlagsUnset trigger[3] 0x0080
	Return

