fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharIdle self (62680, null, 1330) (66890, null, 5550) 1000mm/s
		Sleep 300ms
	Return

fn[2]:
	if flag[1294]:
		CharFlagsSet char[1] 0x0080
		CharFlagsSet char[2] 0x0080
		CharFlagsUnset char[3] 0x0080
		CharFlagsUnset char[5] 0x0080
		CharSetPos char[0] (-66690, 0, 4990) 0deg
		CharSetPos char[4] (-66690, 0, 6530) 180deg
	elif QuestFlagsGet quest[29] 0x10:
		CharFlagsSet char[1] 0x0080
		CharFlagsSet char[2] 0x0080
		CharFlagsSet char[0] 0x0080
	elif QuestTaskGet quest[29] 0:
		CharSetPos char[0] (-1880, 10, 15240) 135deg
		CharSetPos char[2] (-210, 0, 13820) 0deg
		CharTurnTo char[1] 180deg 0deg/s
	else:
		ForkFunc char[1] fork[2] fn[0,13]
		ForkFunc char[2] fork[2] fn[0,13]
		ForkFunc char[0] fork[2] fn[0,13]
		CharFlagsSet char[1] 0x0010
		CharFlagsSet char[2] 0x0010
		CharFlagsSet char[0] 0x0010
	Return

fn[3]:
	Return

fn[4]:
	if QuestFlagsGet quest[29] 0x02 && !QuestTaskGet quest[29] 0 && !QuestFlagsGet quest[29] 0x10 && !QuestFlagsGet quest[29] 0x40:
		Call fn[0,11]
		Return
	TextStart self
	if flag[1294]:
		if flag[0]:
			TextTalk char[0] {
				今天這麼多人，
				出現走失的孩子也難怪吧。{wait}
			}
			TextWait
			TextTalk char[0] {
				希望能早點找到他啊。{wait}
			}
			TextWait
		else:
			TextTalk char[0] {
				哦，是羅伊德啊，
				聽說有小男孩走丟了呢。{wait}
			}
			TextWait
			TextTalk char[0] {
				唔，紀念慶典時的人這麼多，
				而且今天又有遊行……{wait}
			}
			TextWait
			TextTalk char[0] {
				真希望能早點找到啊。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif QuestFlagsGet quest[29] 0x10:
	elif QuestTaskGet quest[29] 0:
		TextTalk char[0] {
			從明天開始，
			伊莉雅的公演又要開始了……{wait}
		}
		TextWait
		TextTalk char[0] {
			在如此重要的時期，
			竟然會出現跟蹤狂，
			真是令人坐立不安啊……{wait}
		}
		TextWait
		TextTalk char[0] {
			希望各位能儘快
			幫忙將他逮捕歸案啊！{wait}
		}
		TextWait
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 0
			"【接受】" // 0
			"【拒絕】" // 1
		MenuWait var[0]
		MenuClose menu[0]
		FadeIn 300ms 0x00000000
		_59
		if var[0] == 0:
			TextEnd self
			EventBegin 0
			BgmStop 1500ms
			CrossFade 500ms
			CamSetDistance -250 1670 13660 0ms
			ED7CamRotate 32deg 29deg 0deg 0ms
			CamPers 650 0ms
			CamZoom 14970 0ms
			CharSetPos name[0] (260, 120, 13350) 346deg
			CharSetPos name[1] (-850, 450, 12100) 346deg
			CharSetPos name[2] (-840, 0, 13680) 346deg
			CharSetPos name[3] (300, 450, 12100) 346deg
			CharSetPos char[0] (-1480, 0, 15690) 180deg
			CharSetPos char[2] (1330, 0, 15700) 225deg
			CharTurnTo char[1] 180deg 0deg/s
			_Char4A char[1] 255
			_Char4A char[2] 255
			_Char4A char[0] 255
			BgmWait
			Sleep 10ms
			BgmPlay bgm[111] 0
			FadeWait
			QuestTaskSet quest[29] 1
			Call fn[0,12]
			Return
		else:
			TextTalk name[0] {
				#0006F實在抱歉……我們
				還有其它工作沒有完成。
				現在脫不開身呢。{wait}
			}
			TextWait
			TextTalk char[0] {
				是嗎……
				那就沒辦法了。{wait}
			}
			TextWait
			TextTalk char[0] {
				如果有空了，就請來幫幫忙吧。
				我們無論如何，也希望
				能儘快解決這件事。{wait}
			}
			TextWait
	else:
		TextTalk self {
			唔，似乎有
			嘗試的價值呢。{wait}
		}
		TextWait
		TextTalk self {
			不過，莉夏也真是了不起啊。
			竟然能夠接受
			伊莉雅那麼胡來的要求。{wait}
		}
		TextWait
		TextTalk char[1] {
			#1700F啊哈哈，因為她是莉夏嘛。{wait}
		} {
			#1709F畢竟是被我看中的人，我的眼光
			是絕對不會錯的～！{wait}
		}
		TextWait
	TextEnd self
	Return

fn[5]:
	if QuestFlagsGet quest[29] 0x02 && !QuestTaskGet quest[29] 0 && !QuestFlagsGet quest[29] 0x10 && !QuestFlagsGet quest[29] 0x40:
		Call fn[0,11]
		Return
	TextStart self
	if QuestTaskGet quest[29] 0:
		TextTalk char[1] {
			#1704F好，趁現在
			繼續排練吧。{wait}
		}
		TextWait
		_Char4A char[2] 255
		_Char4A char[0] 255
		CharTurnToChar char[2] char[1] 500deg/s
		CharTurnToChar char[0] char[1] 500deg/s
		TextTalk char[2] {
			#1801F不，請等一下，
			伊莉雅小姐！！{wait}
		}
		TextWait
		TextTalk char[0] {
			是呀，現在還不行！{wait}
		}
		TextWait
		CharTurnTo char[1] 225deg 500deg/s
		TextTalk char[1] {
			#1706F嘖～有什麼關係嘛。
			反正也閑著～{wait}
		}
		TextWait
		TextTalk name[0] {
			#0006F（看來，要接受任務的話，
			　還是越早越好啊。）{wait}
		}
		TextWait
		CharTurnTo char[2] 0deg 500deg/s
		CharTurnTo char[0] 135deg 500deg/s
		_Char4B char[2] 255
		_Char4B char[0] 255
	else:
		TextTalk char[1] {
			#1700F關於下一個登場的時機，
			還要再調整一下……{wait}
		}
		TextWait
		TextTalk char[2] {
			#1800F是啊，那樣的話，
			我也更容易配合……{wait}
		}
		TextWait
		TextTalk name[0] {
			#0000F（好像在商量排練的事呢。）{wait}
		}
		TextWait
		TextTalk name[1] {
			#0100F（今天應該是休演日，
			　但三個人都主動來練習了呢。）{wait}
		}
		TextWait
	TextEnd self
	Return

fn[6]:
	if QuestFlagsGet quest[29] 0x02 && !QuestTaskGet quest[29] 0 && !QuestFlagsGet quest[29] 0x10 && !QuestFlagsGet quest[29] 0x40:
		Call fn[0,11]
		Return
	TextStart self
	if QuestTaskGet quest[29] 0:
		TextTalk char[2] {
			#1803F不好意思，伊莉雅小姐
			對這種事很不重視。{wait}
		} {
			#1808F我也無法在
			白天應對……{wait}
		}
		TextWait
		Emote char[2] 0mm 2000mm 38 38 250ms 1
		Sleep 500ms
		TextTalk char[2] {
			#1801F那、那個，總之就
			拜託各位了。{wait}
		}
		TextWait
	else:
		Call fn[0,5]
	TextEnd self
	Return

fn[7]:
	TextStart self
	if flag[1]:
		TextTalk char[3] {
			抱歉哦，演出的時候，
			我也沒有注意觀眾席。{wait}
		}
		TextWait
		TextTalk char[3] {
			去問問伊莉雅小姐或普莉耶小姐
			也許比較好吧。{wait}
		}
		TextWait
	else:
		TextTalk char[3] {
			……哎，小男孩？{wait}
		}
		TextWait
