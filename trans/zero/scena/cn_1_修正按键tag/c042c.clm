fn[10]:
	TextTalk name[0] {
		#0005F咦……？
		劇團裡還有這樣的孩子嗎？{wait}
	}
	TextWait
	if flag[1294] && !flag[1303]:
		TextTalk self {
			……你是幹什麼的，
			難道認識伊莉雅小姐嗎？{wait}
		}
		TextWait
	else:
		TextTalk self {
			……你們是幹什麼的，
			難道認識伊莉雅小姐嗎？{wait}
		}
		TextWait
	TextTalk self {
		哼……
		無關人員禁止進入劇團。{wait}
	}
	TextWait
	TextTalk self {
		就算認識伊莉雅小姐，
		也別厚著臉皮進來啊。{wait}
	}
	TextWait
	FlagSet flag[1680]
	Return

fn[11]:
