					#0006F嗚……{wait}
				}
				TextWait
			FlagSet flag[2]
		else:
			TextTalk self {
				我還在學習工作的要領，
				不懂的事情還有很多……{wait}
			}
			TextWait
			TextTalk self {
				接下來的路還很長，
				別礙事哦。{wait}
			}
			TextWait
	elif !flag[1680]:
		Call fn[0,10]
	else:
		TextTalk self {
			……接下來要進行調整，
			然後又是夜場的演出了。{wait}
		}
		TextWait
		TextTalk self {
