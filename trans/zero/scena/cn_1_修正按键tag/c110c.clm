fn[11]:
	TextStart self
	if flag[1307]:
		if !flag[2]:
			TextTalk self {
				今天就是最終日了啊……{wait}
			}
			TextWait
			TextTalk self {
				要玩的話就要把握機會了……！！{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			TextTalk self {
				好，今天要去哪裡呢。
				從哪裡開始玩起呢！！{wait}
			}
			TextWait
	elif flag[1362]:
		TextTalk self {
			市長的演說真精彩。{wait}
		}
		TextWait
		TextTalk self {
			還有『咪西』也很可愛！{wait}
		}
		TextWait
		Emote field_party[0] 0mm 2000mm 16 19 250ms 1
		SoundPlay sound[23] 0 100 0
		Emote field_party[1] 0mm 2000mm 16 19 250ms 1
		SoundPlay sound[23] 0 100 0
		Emote field_party[2] 0mm 2000mm 16 19 250ms 1
		SoundPlay sound[23] 0 100 0
		Emote field_party[3] 0mm 2000mm 16 19 250ms 1
		SoundPlay sound[23] 0 100 0
		Sleep 1000ms
		TextTalk name[0] {
			#0003F（在、在說什麼呢……？）{wait}
		}
		TextWait
	elif flag[1292]:
		if !flag[2]:
			TextTalk self {
				雖說是紀念慶典，
				但玩得太過火也不好啊。{wait}
			}
			TextWait
			TextTalk self {
				人還是要保持自制心的！
				在不忘掉自制的前提下盡情享受吧！{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			TextTalk self {
				……帶相機了吧？{wait}
			}
			TextWait
			TextTalk self {
				遊行馬上就要開始了哦！！{wait}
			}
			TextWait
	elif flag[1282]:
		if !flag[2]:
			TextTalk self {
				哇噢！今天將在市政廳
				召開國際研討會呢！{wait}
			}
			TextWait
			TextTalk self {
				在市長的號召之下，國內外的
				眾多專家學者紛紛響應而來……！{wait}
			}
			TextWait
			TextTalk self {
				他們的研究討論
				必定會給克洛斯貝爾
				帶來一道耀眼的曙光！！{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			TextTalk self {
				市政廳那裡今天要
				召開國際研討會呢！{wait}
			}
			TextWait
			TextTalk self {
				……我受不了這種死板的場合，
				所以就不去旁聽了。{wait}
			}
			TextWait
	elif flag[1280]:
		if !flag[2]:
			TextTalk self {
				阿爾摩利卡村來的
				蛋包飯……嗎？{wait}
			}
			TextWait
			TextTalk self {
				這麼一說，
				我就必須要去
				吃一次看看了。{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			TextTalk self {
				我最討厭
				誘人的東西一直
				在眼前勾引我了。{wait}
			}
			TextWait
			TextTalk self {
				所以必須要去吃吃看才行。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[12]:
