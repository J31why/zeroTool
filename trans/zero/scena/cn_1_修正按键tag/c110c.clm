fn[6]:
	TextStart self
	if flag[1307]:
		TextTalk self {
			車站一帶非常擁擠混亂。{wait}
		}
		TextWait
		TextTalk self {
			請注意不要丟東西，
			不要讓小孩走失～！{wait}
		}
		TextWait
	elif flag[1362]:
		TextTalk self {
			為了引導遊行的秩序，
			我在市內四處奔波了好久……{wait}
		}
		TextWait
		TextTalk self {
			呼、呼……
			累、累死了……{wait}
		}
		TextWait
	elif flag[1292]:
		TextTalk self {
			遊行活動的警備工作
			由我們公共安全課
			全權負責。{wait}
		}
		TextWait
		TextTalk self {
			……在這種人群中，
			想保證道路順暢都很困難。{wait}
		}
		TextWait
	elif flag[1282]:
	elif flag[1280]:
		TextTalk self {
			嘟嘟～！請不要推擠！{wait}
		}
		TextWait
		TextTalk self {
			請不要跑到車輛的前面！{wait}
		}
		TextWait
	TextEnd self
	Return

fn[7]:
	TextStart self
	if flag[1307]:
		if !flag[0]:
			_Char4A char[2] 255
			CharTurnToChar self char[2] 0deg/s
			TextTalk self {
				亞比……
				你已經累了嗎？{wait}
			}
			TextWait
			TextTalk self {
				好～那麼就讓
				媽媽來背你吧！{wait}
			}
			TextWait
			TextTalk char[2] {
				真、真的嗎～？
				好～耶！{wait}
			}
			TextWait
			_Char4B char[2] 255
			FlagSet flag[0]
		else:
			TextTalk self {
				在紀念慶典期間，每天都在玩，
				好像已經累壞了。{wait}
			}
			TextWait
			TextTalk self {
				這也難怪呢……
				也許連我都玩得有些過火了。{wait}
			}
			TextWait
	elif flag[1362]:
		if !flag[0]:
			Call fn[0,8]
		else:
			TextTalk self {
				今年真是留下了
				很不錯的回憶。{wait}
			}
			TextWait
			TextTalk self {
				呵呵，克洛斯貝爾的
				紀念慶典真是有趣呢。{wait}
			}
			TextWait
	elif flag[1292]:
		CharTurnToChar self char[2] 0deg/s
		TextTalk self {
			看啊，那就是遊行哦。{wait}
		}
		TextWait
		TextTalk self {
			一邊放著音樂，
			一邊在市內巡遊。{wait}
		}
		TextWait
	elif flag[1282]:
		_Char4A char[2] 255
		CharTurnToChar self char[2] 0deg/s
		TextTalk self {
			亞比，好吃嗎？{wait}
		}
		TextWait
		TextTalk self {
			能不能也分給
			媽媽一點呀～？{wait}
		}
		TextWait
		TextTalk char[2] {
			嗯，分給你！{wait}
		}
		TextWait
		TextTalk char[2] {
			媽媽，一起來
			吃吧～！{wait}
		}
		TextWait
		_Char4B char[2] 255
	elif flag[1280]:
		TextTalk self {
			我今年才剛剛
			搬來克洛斯貝爾，
			還是第一次參加紀念慶典呢。{wait}
		}
		TextWait
		TextTalk self {
			真是很壯觀啊……
			讓我大吃一驚。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[8]:
