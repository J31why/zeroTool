fn[10]:
	if QuestTaskGet quest[32] 2 && !QuestFlagsGet quest[32] 0x10 && !QuestFlagsGet quest[32] 0x40 && !QuestTaskGet quest[32] 4:
		Call fn[0,43]
		Return
	TextStart self
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"對話" // 0
			"購物" // 1
			"放棄" // 2
		MenuWait var[0]
		if var[0] != 1:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			ShopOpen shop[128]
			var[0] = 99
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			if QuestFlagsGet quest[32] 0x10 && flag[1292] && !flag[1307] && !flag[1511]:
				TextTalk self {
