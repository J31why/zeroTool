					}
					TextWait
			elif flag[1292]:
				if QuestTaskGet quest[32] 2 && !QuestFlagsGet quest[32] 0x10 && !QuestFlagsGet quest[32] 0x40:
					TextTalk self {
						光注意著招呼客人……
