		ED7_31 1
		Sleep 3500ms
		ObjFrame object[4] 0
		BgmResume
		FadeIn 1000ms 0x00000000
		TextClose 0
		TextEnd null
		Return
	elif var[0] != 0:
		FadeIn 300ms 0x00000000
		TextEnd null
		Return
	Return
	Return

