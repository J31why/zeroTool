fn[2]:
	char[8].51 = 1200
	Return

fn[3]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	EmoteStop char[0]
	if !flag[0]:
		CharSetChipPattern self 0
		TextTalk self {
			獨佔七耀石的採購權嗎……{wait}
		}
		TextWait
		TextTalk self {
			的確，礦工們的安全
			是最重要的……{wait}
		}
		TextWait
		TextTalk self {
			但還有商人正在與我們做生意。
			我也不能失信於他們……{wait}
		}
		TextWait
		TextTalk name[0] {
			#0003F（鎮長先生……
			　好像很苦惱呢。）{wait}
		} {
			#0001F（……那些傢伙今晚一定會出現。
			　準備完畢後，就在房間內待命吧。）{wait}
		}
		TextWait
		FlagSet flag[0]
	else:
		TextTalk self {
			呀，是你們啊……
			今晚要住在鎮裡嗎？{wait}
		}
		TextWait
		TextTalk self {
			有礦工受傷了，
			你們也要小心啊。{wait}
		}
		TextWait
	Emote char[0] 0mm 1700mm 24 27 250ms 0
	CharSetChipPattern self 0
	TextEnd self
	Return

fn[4]:
	TextStart self
	TextTalk self {
		老伴他……好像很苦惱。{wait}
	}
	TextWait
	TextTalk self {
		做一些能讓他打起精神的
		食物吧。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[5]:
	TextStart self
	TextTalk self {
		我家孫兒們也真是的，
		大半夜還這麼吵鬧。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[6]:
	TextStart self
	if !flag[2]:
		Call fn[0,7]
	else:
		TextTalk self {
			真是的，哥哥，
			去和工友們一起喝點酒不是挺好的嘛。{wait}
		}
		TextWait
		TextTalk self {
			……聽說馬庫斯先生
			剛被襲擊過，
			應該不會這麼快再出現魔獸吧……{wait}
		}
		TextWait
	TextEnd self
	Return

fn[7]:
	_Char4A char[3] 255
	_Char4A char[4] 255
	CharTurnToChar char[3] char[4] 0deg/s
	CharTurnToChar char[4] char[3] 0deg/s
	TextTalk char[3] {
		哥哥，
		今天沒去喝酒嗎？{wait}
	}
	TextWait
	TextTalk char[4] {
		鎮長說過，讓我
		早點回家的。{wait}
	}
	TextWait
	TextTalk char[4] {
		我直接回家，你有什麼不滿的啊？{wait}
	}
	TextWait
	TextTalk char[3] {
		……如果一定要說的話……{wait}
	}
	TextWait
	TextTalk char[3] {
		對了，……可以說是『你真不合群』吧？{wait}
	}
	TextWait
	TextTalk char[4] {
		你、你煩不煩啊。{wait}
	}
	TextWait
	_Char4B char[3] 255
	_Char4B char[4] 255
	FlagSet flag[2]
	Return

fn[8]:
	TextStart self
	if !flag[2]:
		Call fn[0,7]
	else:
		TextTalk self {
			嘖，多管閒事。{wait}
		}
		TextWait
		TextTalk self {
			……我平時也不怎麼喝酒的。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[9]:
	TextStart self
	if flag[834]:
		CharTurnToChar self char[7] 0deg/s
		TextTalk self {
			喂喂，快點吃飯啦。
			我肚子餓了。{wait}
		}
		TextWait
	else:
		TextTalk self {
			等爸爸回來才能吃晚飯，
			要忍一忍。{wait}
		}
		TextWait
		TextTalk self {
			……肚子好餓啊，
			爸爸還不回來嗎。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[10]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if !flag[3]:
		Call fn[0,11]
	else:
		TextTalk self {
			啊，是你們呀。
			進礦山是可以，
			但是要小心點，別受傷啊。{wait}
		}
		TextWait
	CharSetChipPattern self 0
	TextEnd self
	Return

fn[11]:
	CharSetChipPattern char[5] 0
	CharSetChipPattern char[7] 0
	TextTalk char[5] {
		你說那個被魔獸襲擊的
		馬庫斯先生……現在還沒痊癒？{wait}
	}
	TextWait
	TextTalk char[7] {
		嗯……
		雖然傷得
		不算很嚴重……{wait}
	}
	TextWait
	TextTalk char[7] {
		但再怎麼說，也是被咬到了腿，
		還是不要硬撐比較好吧。{wait}
	}
	TextWait
	TextTalk char[5] {
		是啊……真讓人擔心啊。{wait}
	}
	TextWait
	TextTalk char[5] {
		……你也要小心哦。{wait}
	}
	TextWait
	TextTalk char[7] {
		哈哈，沒問題。
		我可是礦山長呢。{wait}
	}
	TextWait
	TextTalk char[5] {
		說點正經話啊……{wait}
	}
	TextWait
	FlagSet flag[3]
	Return

fn[12]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if flag[834]:
		if !flag[3]:
			Call fn[0,11]
		else:
			TextTalk self {
				因為這個人過於拼命，
				所以很讓人擔心呢……{wait}
			}
			TextWait
	else:
		TextTalk self {
			呼，我老公可真是的，
			回來得好晚啊……{wait}
		}
		TextWait
	CharSetChipPattern self 0
	TextEnd self
	Return

fn[13]:
	TextStart self
	if !flag[1250]:
		Call fn[0,14]
	elif !flag[4]:
		TextTalk self {
			我要是不進入礦山，
			晚上都睡不著覺呢。{wait}
		}
		TextWait
		TextTalk self {
			……可惡。
			如果沒有被魔獸襲擊
			就好了啊……{wait}
		}
		TextWait
		FlagSet flag[4]
	else:
		TextTalk self {
			啊……
			再這樣下去的話，
			身體都要變遲鈍了。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[14]:
	TextTalk self {
		啊……夜晚好漫長啊……{wait}
	}
	TextWait
	TextTalk self {
		買來的書
		也都讀完了……{wait}
	}
	TextWait
	TextTalk self {
		……有興趣的話，你也讀讀看如何？
		這本書就送給你好了。{wait}
	}
	TextWait
	FadeOut 300ms 0x00000000 100
	TextSetPos -1 -1 -1 -1
	TextSetName ""
	SoundPlay sound[17] 0 100 0
	TextMessage null {
		收下了{item[712]}{color 0}。{wait}
	}
	TextWait
	TextClose 0
	FadeIn 300ms 0x00000000
	TextSetPos -1 280 60 3
	_59
	ItemAdd item[712] 1
	FlagSet flag[1250]
	Return

fn[15]:
	TextStart self
	TextTalk self {
		我的丈夫
		從白天開始就一直很沮喪。{wait}
	}
	TextWait
	TextTalk self {
		……希望他的身體能早日康復……{wait}
	}
	TextWait
	TextEnd self
	Return
