fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	Return

fn[2]:
	if flag[1333]:
	elif flag[1330]:
		CharFlagsUnset char[4] 0x0080
		CharFlagsUnset char[5] 0x0080
		CharFlagsUnset char[2] 0x0080
		CharFlagsUnset char[3] 0x0080
	elif flag[1329]:
		CharFlagsUnset char[1] 0x0080
		CharFlagsUnset char[4] 0x0080
		CharFlagsUnset char[5] 0x0080
		CharFlagsUnset char[9] 0x0080
		CharFlagsUnset char[10] 0x0080
		CharFlagsUnset char[11] 0x0080
	elif flag[1320]:
		CharFlagsUnset char[0] 0x0080
		CharFlagsUnset char[4] 0x0080
		CharFlagsUnset char[5] 0x0080
		CharFlagsUnset char[6] 0x0080
		CharFlagsUnset char[7] 0x0080
		CharFlagsUnset char[8] 0x0080
	if (system[0] == 102 | system[0] == 103) && flag[1321] && flag[1324] && flag[1325] && flag[1326] && flag[1327] && flag[1328] && !flag[1329]:
		if system[0] == 102:
			Event fn[0,18]
		else:
			Event fn[0,17]
	elif flag[1338] && !flag[1339]:
		Event fn[0,22]
	if flag[736]:
		FlagUnset flag[736]
		Event fn[0,16]
	elif flag[737]:
		FlagUnset flag[737]
		Event fn[0,19]
	elif flag[738]:
		FlagUnset flag[738]
		Event fn[0,20]
	elif flag[739]:
		FlagUnset flag[739]
		Event fn[0,21]
	elif flag[740]:
		FlagUnset flag[740]
		Event fn[0,23]
	Return

fn[3]:
	if flag[1333]:
	EntranceSetFunc entrance[0] fn[255,65535]
	if flag[1320] && !flag[1329]:
		EntranceSetFunc entrance[0] fn[0,26]
	if flag[1329] && !flag[1330]:
		EntranceSetFunc entrance[0] fn[0,26]
	if flag[1330]:
		EntranceSetFunc entrance[0] fn[0,26]
	SoundPlay sound[124] 1 80 0
	Return

fn[4]:
	TextStart self
	if flag[1333]:
	elif flag[1330]:
		TextTalk self {
			哎呀……二位有事嗎？{wait}
		}
		TextWait
		TextTalk self {
			拍賣即將開始，
			請儘快入座等待。{wait}
		}
		TextWait
	elif flag[1329]:
	elif flag[1320]:
		if !flag[0]:
			TextTalk self {
				拍賣會將於晚上九點
				在那邊正面的大廳裡
				舉行。{wait}
			}
			TextWait
			TextTalk self {
				在此之前，左手邊的沙龍裡
				設有宴席，
				請盡情享用美酒佳餚。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				如果您需要在客房休息，
				請儘管吩咐。{wait}
			}
			TextWait
			TextTalk self {
				我會立即
				為您準備好房間。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[5]:
	TextStart self
	TextTalk self {
		正好有
		單獨來的客人，
		真是太好了。{wait}
	}
	TextWait
	TextTalk self {
		詹姆斯先生
		聲名顯赫……
		現在這個人又如何呢？{wait}
	}
	TextWait
	TextEnd self
	Return

fn[6]:
	TextStart self
	TextTalk self {
		我先生說，作為和好的證明，
		要特別給我拍個
		漂亮的珠寶首飾。{wait}
	}
	TextWait
	TextTalk self {
		呵呵……真是期待呢。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[7]:
	TextStart self
	if !flag[1]:
		_Char4A char[2] 255
		TextTalk char[3] {
			……剛才嚮導過來的時候，
			要是讓他幫我占個位置就好了。{wait}
		}
		TextWait
		CharTurnToChar char[2] char[3] 500deg/s
		TextTalk char[2] {
			哎呀，為什麼呢？{wait}
		}
		TextWait
		TextTalk char[3] {
			（因為萬一和妮姬妲
			　坐得很近，
			　那可就尷尬了啊……）{wait}
		}
		TextWait
		CharTurnTo char[2] 0deg 0deg/s
		_Char4B char[2] 255
		FlagSet flag[1]
	else:
		TextTalk char[3] {
			算、算了，
			總之先進
			會場吧。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[8]:
	TextStart self
	if flag[1333]:
	elif flag[1330]:
		if !flag[2]:
			TextTalk self {
				客人……
				您怎麼了？{wait}
			}
			TextWait
			TextTalk self {
				這樣隨便走動可不太好啊。{wait}
			}
			TextWait
			TextTalk name[0] {
				#5101F（黑衣人們似乎
				　還沒注意到異常啊……）{wait}
			}
			TextWait
			TextTalk name[80] {
				#5703F（呵呵，這不是正好嗎？
				　要調查的話，還是在出現騷動
				　之前進行為好哦。）{wait}
			}
			TextWait
			TextTalk name[0] {
				#5101F（是啊……趁現在
				　把宅邸都轉一遍吧。）{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			TextTalk self {
				……您忘了什麼在房間裡嗎？{wait}
			}
			TextWait
			TextTalk self {
				拍賣會的開場
				是不等人的，
				請您儘快吧。{wait}
			}
			TextWait
	elif flag[1329]:
		TextTalk self {
			拍賣會即將開始，
			請進會場。{wait}
		}
		TextWait
	elif flag[1320]:
		TextTalk self {
			宅邸內的安全，
			我們會負責保衛的。{wait}
		}
		TextWait
		TextTalk self {
			請放心
			享受吧。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[9]:
	TextStart self
	if flag[1333]:
	elif flag[1330]:
		CharTurnTo self 180deg 0deg/s
		TextTalk self {
			我們準備了足夠的座位，
			請您隨意尋找空位就坐。{wait}
		}
		TextWait
		TextTalk self {
			雖然是站席，
			但二樓也可以使用哦。{wait}
		}
		TextWait
	elif flag[1329]:
		if !flag[3]:
			TextTalk self {
				二位是瑪利亞貝爾小姐的友人嗎？
				嚮導吩咐過我了。{wait}
			}
			TextWait
			TextTalk self {
				已經為各位準備了
				最後一排的席位，
				請入內跟隨嚮導就坐。{wait}
			}
			TextWait
			TextTalk name[55] {
				#2900F別客氣。
				……來，進去吧。{wait}
			}
			TextWait
			FlagSet flag[3]
		else:
			TextTalk self {
				二位是瑪利亞貝爾小姐的友人嗎？
				已經為各位準備了最後排的席位。{wait}
			}
			TextWait
	elif flag[1320]:
		TextTalk self {
			會場內正在進行
			拍賣會的準備工作。{wait}
		}
		TextWait
		TextTalk self {
			請您耐心等候開場。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[10]:
	TextStart self
	TextTalk self {
		我這是第一次跟我先生
		來議長宅邸。{wait}
	}
	TextWait
	TextTalk self {
		一想到即將舉行的拍賣會，
		我就期待萬分呢。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[11]:
	TextStart self
	TextTalk self {
		我太太平時很嫺靜。
		我想讓她感受點刺激的場面，
		所以就帶她來了。{wait}
	}
	TextWait
	TextTalk self {
		為了在社交界生存，
		必須學學與貴婦人
		的身份相符合的言行舉止。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[12]:
	TextStart self
	if !flag[4]:
		TextTalk self {
			雖然我在帝國也有宅邸，
			但和這幢大宅比起來
			可就遜色多了。{wait}
		}
		TextWait
		TextTalk self {
			豪華絢爛這種詞彙，形容的就是這裡啊……{wait}
		}
		TextWait
		FlagSet flag[4]
	else:
		TextTalk self {
			我在帝國的宅邸
			雖然也很大……
			不過和這幢大宅就不能比了。{wait}
		}
		TextWait
		TextTalk self {
			真是讓人羨慕啊。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[13]:
	TextStart self
	if !flag[5]:
		TextTalk self {
			拍賣會終於快開始了啊……{wait}
		}
		TextWait
		TextTalk self {
			我一定要拍下
			羅贊貝爾克工房的人偶。{wait}
		}
		TextWait
		Emote name[55] 0mm 2000mm 38 38 250ms 1
		Sleep 1000ms
		TextTalk name[55] {
			#2905F哎呀……
			出現競爭對手了呢。{wait}
		} {
			#2900F我的目標也是那個哦，
			呵呵……我可不會輸的。{wait}
		}
		TextWait
		CharTurnToChar self name[55] 500deg/s
		TextTalk self {
			哦哦……真是好膽量啊，小姐。
			請手下留情哦。{wait}
		}
		TextWait
		FlagSet flag[5]
	else:
		TextTalk self {
			想要的東西近在眼前，
			我也不能退讓啊。{wait}
		}
		TextWait
		CharTurnToChar self name[55] 500deg/s
		TextTalk self {
			小姐，
			還請手下留情哦。{wait}
		}
		TextWait
		TextTalk name[55] {
			#2900F呵呵……彼此彼此。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[14]:
	TextStart self
	TextTalk self {
		我先生真是的，隨著開始時間的臨近，
		好像越來越興奮了。{wait}
	}
	TextWait
	TextTalk self {
		等到入席之後，
		必須得讓他冷靜一下才行啊。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[15]:
	TextStart self
	TextTalk self {
		（這位女性剛才
		　向我搭訕，
		　所以就決定一起參加拍賣會了。）{wait}
	}
	TextWait
	TextTalk self {
		（如果沒有同伴，
		　還是有點沒面子呢。
		　呵呵，有個正合適的女人，真是得救了。）{wait}
	}
	TextWait
	TextEnd self
	Return

fn[16]:
	EventBegin 0
	FadeOut 0ms 0x00000000 255
	CharSetPos name[0] (500, 500, 6800) 0deg
	CharSetPos party[1] (-500, 500, 6800) 0deg
	CharColor name[0] 0x00FFFFFF 0ms
	CharColor party[1] 0x00FFFFFF 0ms
	CharFlagsUnset char[0] 0x0080
	CharFlagsUnset char[4] 0x0080
	CharFlagsUnset char[5] 0x0080
	CharFlagsUnset char[6] 0x0080
	CharFlagsUnset char[7] 0x0080
	CharFlagsUnset char[8] 0x0080
	CharFlagsSet char[0] 0x8000
	CharFlagsSet char[4] 0x8000
	CharFlagsSet char[5] 0x8000
	CharFlagsSet char[6] 0x8000
	CharFlagsSet char[7] 0x8000
	CharFlagsSet char[8] 0x8000
	FadeIn 1000ms 0x00000000
	CamSetDistance -4530 2300 17580 0ms
	ED7CamRotate 326deg 9deg 0deg 0ms
	CamPers 500 0ms
	CamZoom 19400 0ms
	CamSetDistance 5540 2300 24020 10000ms
	CamWait 1
