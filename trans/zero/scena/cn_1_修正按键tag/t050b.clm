fn[2]:
	while 1:
		CharTurnToChar self char[0] 100deg/s
		Sleep 10ms
	Return

fn[3]:
	if flag[736]:
		FlagUnset flag[736]
		Event fn[0,7]
	elif flag[737]:
		FlagUnset flag[737]
		Event fn[0,20]
	if !flag[834]:
		CharFlagsUnset char[0] 0x0080
	Return

fn[4]:
