	TextTalk name[0] {
		#11100691V#0000F#12P……真不好意思，
		麻煩您特意送我們回去。{wait}
	}
	TextWait
	TextTalk char[0] {
		#11100692V#3609F#5P哈哈，不用客氣，
		只是順路罷了。{wait}
	}
	TextWait
	TextTalk name[3] {
		#11100693V#0302F#11P不過，能擁有自己的車子，
		可真是很厲害啊。{wait}
	} {
		#11100694V這一定非常貴吧？{wait}
	}
	TextWait
	TextTalk name[2] {
		#11100695V#0203F#11P這種級別的私家車，
		價格應該在八十萬米拉左右。{wait}
	}
	TextWait
	TextTalk name[0] {
		#11100696V#0005F#12P八十萬米拉……真的很昂貴呢。{wait}
	}
	TextWait
	TextTalk char[0] {
		#11100697V#3604F#5P呵呵，作為貿易商人，
		這也算是生意工具吧。{wait}
	} {
		#11100698V#3600F雖然也可以乘坐巴士，
		但在很多時候，
		時間並不允許呢……{wait}
	} {
		#11100699V於是，我在去年下定決心，
		咬牙買了下來。{wait}
	}
	TextWait
	TextTalk name[1] {
		#11100700V#0104F#11P呵呵，除了工作原因之外，
		好像還有其它理由吧？{wait}
	} {
		#11100701V#0102F比如說，想儘早見到
		等待自己回家的妻子和兒子。{wait}
	}
	TextWait
	Emote char[0] 0mm 1700mm 2 7 80ms 1
	SoundPlay sound[28] 0 100 0
	Sleep 1000ms
	TextTalk char[0] {
		#11100702V#3609F#5P哈哈……被妳說中了呢。{wait}
	}
	TextWait
	TextTalk name[3] {
		#11100703V#0302F#11P原來如此，好像還精心
		準備了禮物呢。{wait}
	}
	TextWait
	TextTalk name[2] {
		#11100704V#0202F#11P……這就是所謂的
		顧家好男人吧。{wait}
	}
	TextWait
	TextTalk char[0] {
		#11100705V#3604F#5P哎呀……哪裡的話。{wait}
	} {
		#11100706V#3600F我平時總是要東奔西跑，
		所以經常會冷落
		妻子和兒子……{wait}
	}
	TextWait
	TextTalk name[0] {
		#11100707V#0000F#12P您的兒子今年多大呢？{wait}
	}
	TextWait
	TextTalk char[0] {
		#11100708V#3609F#5P今年五歲了。{wait}
	} {
		#11100709V雖然還不能去主日學校上學，
		但好奇心非常旺盛……{wait}
	} {
		#11100710V#3600F那種對任何事物都充滿好奇心的性格，
		真是給妻子添了不少麻煩呢。{wait}
	}
	TextWait
	TextTalk name[0] {
		#11100711V#0002F#12P是嗎……{wait}
	}
	TextWait
	TextTalk name[1] {
		#11100712V#0102F#11P呵呵，聽起來是很幸福的一家人呢。{wait}
	}
	TextWait
	TextTalk char[0] {
		#11100713V#3609F#5P哈哈……那當然。{wait}
	} {
		#11100714V#3608F#30W而且我──我們
		必須要幸福。{wait}
	}
