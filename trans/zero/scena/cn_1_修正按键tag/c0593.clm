fn[11]:
	EventBegin 0
	ED7_E0 1
	CrossFade 1000ms
	CamSetDistance 0 700 69500 0ms
	ED7CamRotate 45deg 28deg 0deg 0ms
	CamPers 440 0ms
	CamZoom 22000 0ms
	CharSetPos name[0] (0, 0, 68500) 0deg
	CharSetPos name[1] (-200, 0, 67300) 0deg
	CharSetPos name[2] (-1300, 0, 67300) 0deg
	CharSetPos name[3] (900, 0, 67300) 0deg
	CharSetPos name[9] (-1300, 0, 68500) 45deg
	CharFlagsUnset field_party[4] 0x0080
	CharFlags2Unset field_party[4] 0x8000
	FadeWait
	CrossFade 250ms
	ED7_76_0 object[255] "key_red" 1
	FadeWait
	FadeOut 300ms 0x00000000 100
	TextSetPos -1 -1 -1 -1
	TextSetName ""
	SoundPlay sound[17] 0 100 0
	TextMessage null {
		獲得了{item[814]}{color 0}。{wait}
	}
	TextWait
	TextClose 0
	FadeIn 300ms 0x00000000
	TextSetPos -1 280 60 3
	_59
	ItemAdd item[814] 1
	QuestTaskSet quest[76] 22
	if flag[1571] && !flag[1577]:
		TextTalk name[0] {
			#14300343V#0000F#11P好大的鑰匙，
			難道說……{wait}
		}
		TextWait
		TextTalk name[2] {
			#14300344V#12P#0202F嗯，應該是用來
			解除客廳機關的吧。{wait}
		}
		TextWait
	elif flag[1571] && flag[1577]:
		QuestTaskSet quest[76] 22
		TextTalk name[0] {
			#14300345V#0000F#11P第二把鑰匙嗎……{wait}
		}
		TextWait
		TextTalk name[2] {
			#14300346V#12P#0202F看起來，客廳的機關
			應該可以解除了吧。{wait}
		}
		TextWait
	elif !flag[1571] && flag[1577]:
		QuestTaskSet quest[76] 23
		TextTalk name[0] {
			#14300347V#0000F#11P又發現了
			相似的鑰匙啊……{wait}
		}
		TextWait
		TextTalk name[1] {
			#14300348V#12P#0100F也許會在其它地方
			派上用場吧……{wait}
		}
		TextWait
		TextTalk name[9] {
			#14300349V#6P#0603F──武器庫也大致調查過了。{wait}
		} {
			#14300350V#0600F或許應該回去一趟，
			再調查一遍
			魯巴徹的大廳。{wait}
		}
		TextWait
	else:
		TextTalk name[0] {
			#14300351V#0005F#11P好大的鑰匙，
			是用來做什麼的呢……？{wait}
		}
		TextWait
		TextTalk name[1] {
			#14300352V#12P#0101F總之，先拿著吧。{wait}
		}
		TextWait
	TextClose 0
	_59
	CharSetPos field_party[0] (0, 0, 68000) 180deg
	CharFlagsSet field_party[4] 0x0080
	CharFlags2Set field_party[4] 0x8000
	LookPointFlagsSet look_point[1] 0x0001
	FlagSet flag[1583]
	ED7_E0 0
	EventEnd 5
	Return
