calmare zero_k scena
scena:
	name "t053b" "t053b" "t053b"
	town town[64]
	bgm bgm[513]
	flags 8192
	item_use fn[0,255]
	unk 255 0

entry:
	pos (0, 0, -1000)
	unk1 0
	cam_from (0, 0, 34000)
	cam_pers 262
	unk2 30
	cam_deg 45deg
	cam_limit 0deg 360deg
	cam_at (0, 0, 0)
	unk3 0
	unk4 0
	flags 0x0001
	town town[64]
	init fn[0,1]
	reinit fn[0,2]

chip[0] "chr/ch23400.itc"
chip[1] "chr/ch23900.itc"
chip[2] "chr/ch22700.itc"

npc char[0]:
	name "貝卡萊"
	pos (-129, 0, 3640)
	angle 225deg
	flags 0x0105
	unk2 0
	chip chip[0]
	init fn[0,0]
	talk fn[0,4]
	unk4 255

npc char[1]:
	name "琦咪"
	pos (-2009, 0, 2130)
	angle 45deg
	flags 0x0105
	unk2 0
	chip chip[1]
	init fn[0,0]
	talk fn[0,5]
	unk4 255

look_point[0]:
	pos (-40, 0, 2120)
	radius 1000
	bubble_pos (-130, 1500, 3640)
	unk1 126
	unk2 0
	function fn[0,3]
	unk3 0
	unk4 0

fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	Return

fn[2]:
	Return

fn[3]:
	Call fn[0,4]
	Return

fn[4]:
	TextStart char[0]
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"對話" // 0
			"購物" // 1
			"放棄" // 2
		MenuWait var[0]
		if var[0] != 1:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			if flag[1280]:
				ShopOpen shop[86]
			elif flag[1024]:
				ShopOpen shop[85]
			elif flag[768]:
				ShopOpen shop[87]
			else:
				ShopOpen shop[85]
			var[0] = 99
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			if !flag[0]:
				TextTalk char[0] {
					……哦，這麼晚過來，
					膽子不小嘛。{wait}
				}
				TextWait
				TextTalk char[0] {
					喂，說說你想要的東西吧。
					要是敢耍我，可饒不了你。{wait}
				}
				TextWait
				FlagSet flag[0]
			else:
				TextTalk char[0] {
					喂，說你想要的東西吧，快說。{wait}
				}
				TextWait
				TextTalk char[0] {
					既然打擾了我和女兒的寶貴時間，
					要是敢耍我，可饒不了你。{wait}
				}
				TextWait
	TextEnd char[0]
	Return

fn[5]:
	TextStart self
	if !flag[1]:
		CharTurnTo self 45deg 0deg/s
		_Char4A char[0] 255
		TextTalk self {
			爸爸，
			都已經這麼晚了啊。{wait}
		}
		TextWait
		TextTalk self {
			今天晚飯吃什麼呢～？{wait}
		}
		TextWait
		TextTalk char[0] {
			哦，今天就做琦咪
			喜歡吃的肉餅吧。{wait}
		}
		TextWait
		TextTalk self {
			哇～！最喜歡爸爸做的肉餅了！{wait}
		}
		TextWait
		_Char4B char[0] 255
		FlagSet flag[1]
	else:
		CharTurnToChar self field_party[0] 0deg/s
		TextTalk self {
			爸爸雖然對鎮上的人很嚴厲，
			但是對琦咪卻非常溫柔哦。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[6]:
	Return
