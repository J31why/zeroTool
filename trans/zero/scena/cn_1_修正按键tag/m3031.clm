fn[4]:
	SystemFlagsSet 0x08000000
	if flag[1965]:
		TextStart null
		TextSetName ""
		TextMessage null {
			{color 5}拉杆已經被扳下了。{wait}
		}
		TextWait
		TextClose 0
		_59
		SystemFlagsUnset 0x08000000
		TextEnd null
	else:
		EventBegin 1
		TextMessage null {
			{color 5}有一個拉杆。
			要操作嗎？{wait}
		}
		Menu menu[0] -1 -1 1
			"是" // 0
			"否" // 1
		MenuWait var[0]
		MenuClose menu[0]
		TextClose 0
		_59
		if var[0] == 0:
			CrossFade 500ms
			CharSetPos field_party[0] (184570, 0, 16470) 89deg
			CharSetPos field_party[1] (183000, 0, 17440) 89deg
			CharSetPos field_party[2] (183000, 0, 15470) 89deg
			CharSetPos field_party[3] (181500, 0, 16440) 89deg
			CamSetDistance 184180 1800 17890 0ms
			ED7CamRotate 45deg 26deg 0deg 0ms
			CamPers 600 0ms
			CamZoom 26000 0ms
			FadeWait
			SoundPlay sound[143] 0 100 0
			ED7ObjPlay object[6] 120 150 0 0
			ObjWait object[6]
			Sleep 500ms
			SoundPlay sound[155] 0 100 0
			ED7ObjPlay object[3] 0 30 0 0
			ObjWait object[3]
			SoundPlay sound[149] 0 100 0
			Shake 0 300 3000 200ms
			Sleep 500ms
			FlagSet flag[1965]
		SystemFlagsUnset 0x08000000
		EventEnd 5
	Return
