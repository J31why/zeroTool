fn[6]:
	if system[4] == 3:
		EntranceSetDisabled entrance[0] 0
		EntranceSetDisabled entrance[1] 1
	else:
		EntranceSetDisabled entrance[0] 1
		EntranceSetDisabled entrance[1] 0
	if flag[1037] && !flag[1038]:
		MapColor 0x00C8D2FF 0ms
	elif flag[1792]:
		MapColor 0x00C8D2FF 0ms
	else:
	if flag[1554] && !flag[1560]:
		if !flag[1640]:
			Emote char[2] 0mm 1700mm 24 27 250ms 0
	if !flag[1536] && flag[1342]:
		Emote char[4] 0mm 1700mm 24 27 250ms 0
	Return

fn[7]:
	TextStart self
	if flag[1560]:
		if flag[0]:
			TextTalk char[0] {
				嘖，那個可惡的專務，
				竟然說我的態度傲慢？{wait}
			}
			TextWait
			TextTalk char[0] {
				也不想想是多虧了誰，
				公司才能度過危機的！？{wait}
			}
			TextWait
		else:
			TextTalk char[0] {
				啊？你們有什麼事嗎……{wait}
			}
			TextWait
			TextTalk char[0] {
				現在我正火大。
				你們快點給我出去。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1554]:
		if flag[0]:
			TextTalk char[0] {
				哎呀……我是不是太厲害了？{wait}
			}
			TextWait
			TextTalk char[0] {
				哈哈，算了算了，反正那些
				廢物都一樣無能，哈哈哈！{wait}
			}
			TextWait
		else:
			TextTalk char[0] {
				哈哈，那些白癡……
				那支股票不出三天就會跌。{wait}
			}
			TextWait
			TextTalk char[0] {
				連這也看不出來嗎？{wait}
			}
			TextWait
			TextTalk char[0] {
				克洛斯貝爾通訊社的經濟雜誌
				也不行了啊，哈哈哈哈……！{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1536]:
		if flag[0]:
			TextTalk char[0] {
				錢我有的是……
				我正在想要不要
				去買一輛導力車。{wait}
			}
			TextWait
		else:
			TextTalk char[0] {
				嗯，好像不錯。
				沒白拿這本產品目錄啊。{wait}
			}
			TextWait
			TextTalk char[0] {
				這輛導力車的外形
				真是令人神往。{wait}
			}
			TextWait
			TextTalk char[0] {
				哈哈，身為證券經理，
				確實也應該要有一輛導力車啊。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1342]:
	elif flag[1055]:
	elif flag[1040]:
	elif flag[1031]:
		if flag[0]:
			Emote char[0] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Sleep 1000ms
			TextTalk char[0] {
				妻子像那樣斬釘截鐵地斷言後，
				我都不懂她在想什麼了。{wait}
			}
			TextWait
			TextTalk char[0] {
				她就不能直接告訴我
				希望我怎麼做嗎？{wait}
			}
			TextWait
		else:
			TextTalk char[0] {
				……我老婆出身很好。{wait}
			}
			TextWait
			TextTalk char[0] {
				所以，並不太瞭解工作的事情。{wait}
			}
			TextWait
			TextTalk char[0] {
				但我還是希望她能給我一個明確的建議，
				像是去或不去這種簡單的回答就可以了……{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1024]:
		if flag[0]:
			TextTalk char[0] {
				這是一個絕佳的機會……{wait}
			}
			TextWait
			TextTalk char[0] {
				不不不，還是得去
				問問老婆的意見啊……{wait}
			}
			TextWait
		else:
			TextTalk char[0] {
				我們公司的業績正蒸蒸日上哦。{wait}
			}
			TextWait
			TextTalk char[0] {
				下個月準備在
				帝國東部的克魯琴州
				也開個分公司。{wait}
			}
			TextWait
			TextTalk char[0] {
				…………………………
				……怎麼辦啊………{wait}
			}
			TextWait
			TextTalk char[0] {
				上面在問我要不要
				過去當分公司的社長……{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[801]:
	elif flag[777]:
	elif flag[768]:
	elif flag[533]:
	elif flag[0]:
		TextTalk char[0] {
			我老婆是一個悠閒自在的人。{wait}
		}
		TextWait
		TextTalk char[0] {
			真沒辦法啊……
			我自己去泡杯紅茶吧。{wait}
		}
		TextWait
	else:
		TextTalk char[0] {
			工作也能暫時喘口氣了。
			我想讓老婆給我泡杯紅茶……{wait}
		}
		TextWait
		TextTalk char[0] {
			但她竟然不在。{wait}
		}
		TextWait
		TextTalk char[0] {
			應該又去澆花了吧。{wait}
		}
		TextWait
		FlagSet flag[0]
	TextEnd self
	Return

fn[8]:
	if (QuestTaskGet quest[8] 1 | QuestTaskGet quest[8] 2) && !QuestTaskGet quest[8] 7:
		Call fn[0,15]
		Return
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if flag[1342]:
		EmoteStop char[4]
		if !flag[0]:
			TextTalk self {
				……真糟糕，居然發生了這種事……{wait}
			}
			TextWait
			TextTalk self {
				我只在紀念慶典裡休息了一天，
				那一天就出現了損失！{wait}
			}
			TextWait
			TextTalk self {
				這真是糟糕了……　
				那可是一個老主顧的股票啊……{wait}
			}
			TextWait
			TextTalk self {
				在事情暴露之前，
				我得想辦法補上那筆損失……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				我們可是最重視信用的證券公司……
				這事可不能暴露了……{wait}
			}
			TextWait
			TextTalk self {
				不管怎麼樣，在這星期內
				必須補上那筆損失……{wait}
			}
			TextWait
		Emote char[4] 0mm 1700mm 24 27 250ms 0
	elif flag[1362]:
		TextTalk char[4] {
			啊，肚子好餓……{wait}
		}
		TextWait
		TextTalk char[4] {
			老婆和女兒都還沒回來，
			我叫份披薩吧……{wait}
		}
		TextWait
	elif flag[1292]:
		TextTalk char[4] {
			萊恩福爾特公司的股票……{wait}
		}
		TextWait
		TextTalk char[4] {
			現在股票市場一片欣欣向榮，
			正是這種時候才充滿機遇。{wait}
		}
		TextWait
		TextTalk char[4] {
			我身為一個證券經理，可不能放鬆注意。{wait}
		}
		TextWait
	elif flag[1282]:
		if flag[0]:
			TextTalk char[4] {
				今年經濟的起步要比
				預想中更高。{wait}
			}
			TextWait
			TextTalk char[4] {
				接下來可是證券經理的
				關鍵時刻。
				必須慎重地關注情況。{wait}
			}
			TextWait
		else:
			TextTalk char[4] {
				紀念慶典期間，
				無論哪檔股票都大漲了。{wait}
			}
			TextWait
			TextTalk char[4] {
				彩虹劇團可以說是大獲成功，
				米修拉姆的主題樂園也生意興隆。{wait}
			}
			TextWait
			TextTalk char[4] {
				也聽說有不少飯店
				和飲食業都客滿，
				這些股票都讓我感興趣。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1280]:
		if flag[0]:
			TextTalk char[4] {
				老婆和女兒都不在，一個人挺寂寞的，
				但我還是會努力工作的。{wait}
			}
			TextWait
		else:
			TextTalk char[4] {
				老婆看起來好像很無聊，
				所以我就叫她出去外面走走。{wait}
			}
			TextWait
			TextTalk char[4] {
				她一聽到就馬上開心地去準備，{wait}
			}
			TextWait
			TextTalk char[4] {
				就那麼想
				去參觀慶典嗎……{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1055]:
		if flag[0]:
			TextTalk char[4] {
				對證券經理來說，
				紀念慶典期間可是關鍵時刻。{wait}
			}
			TextWait
			TextTalk char[4] {
				……當然不能休息了，
				每天都必須認真工作。{wait}
			}
			TextWait
		else:
			TextTalk char[4] {
				創立紀念慶典期間，
				各支股票的價格指數都會浮動。{wait}
			}
			TextWait
			TextTalk char[4] {
				因為大家都瞄準著紀念慶典
				這個投資機會，所以造成了投資過熱。{wait}
			}
			TextWait
			TextTalk char[4] {
				克洛斯貝爾證券市場
				應該會反復出現
				大幅度的震盪吧……{wait}
			}
			TextWait
			TextTalk char[4] {
				可不能放鬆警惕啊。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1040]:
		if flag[0]:
			TextTalk char[4] {
				就算不去做帝國的分公司社長，
				我也能接到很多大生意。{wait}
			}
			TextWait
			TextTalk char[4] {
				因為放不下家人，
				所以決定留在克洛斯貝爾工作。{wait}
			}
			TextWait
		else:
			TextTalk char[4] {
				至於帝國分公司社長一職……
				最後我還是拒絕了。{wait}
			}
			TextWait
			TextTalk char[4] {
				既然我老婆是那種態度，
				我也只能對她妥協了。{wait}
			}
			TextWait
			TextTalk char[4] {
				雖然這對證券經理來說
				是一個絕佳的機會……{wait}
			}
			TextWait
			TextTalk char[4] {
				但仔細想想，
				就算不去帝國，
				我也能接到很多生意。{wait}
			}
			TextWait
			FlagSet flag[0]
