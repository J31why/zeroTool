	Sleep 300ms
	TextTalk name[2] {
		#11P#0200F不過，羅伊德前輩，
		警察連這些事
		也要親力親為嗎？{wait}
	} {
		#0203F總覺得我們好像
		在途中就變成了遊擊士一樣……{wait}
	}
	TextWait
	CharTurnTo name[0] 135deg 400deg/s
	Sleep 300ms
	TextTalk name[0] {
		#6P#0012F哈哈，對哦。
		好像是變得在助人為樂了呢。{wait}
	} {
		#0000F不過我們是
		『特務支援課』哦，
		偶爾做做助人為樂的事也不錯啊。{wait}
	}
	TextWait
	Fork field_party[0] fork[1]:
		CharTurnTo self 0deg 500deg/s
	Fork field_party[1] fork[1]:
		CharTurnTo self 0deg 500deg/s
	Fork field_party[2] fork[1]:
		CharTurnTo self 0deg 500deg/s
	Fork field_party[3] fork[1]:
		CharTurnTo self 0deg 500deg/s
	Sleep 500ms
	TextTalk name[0] {
		#0000F#6P我們先走吧，
		別打擾人家了。{wait}
	}
	TextWait
	TextTalk name[3] {
		#0304F#11P嘿，也對。{wait}
	}
	TextWait
	_59
	FadeOut 1000ms 0x00000000 255
	FadeWait
	SoundPlay sound[9] 0 100 0
	TextSetPos -1 -1 -1 -1
	TextSetName ""
	TextMessage null {
		{color 2}任務【尋找小貓的飼主】{color 0}完成！{wait}
	}
	TextWait
	TextClose 0
	TextSetPos -1 280 60 3
	_59
	ForkQuit char[2] fork[2]
	CharSetPos field_party[0] (-200, 0, -1320) 180deg
	CharSetPos char[2] (5250, 4000, 8250) 180deg
	CharSetPos char[3] (5180, 4000, 5560) 315deg
	CharSetPos char[4] (40, 4150, 18170) 90deg
	CharFlagsSet char[0] 0x0080
	CharFlagsUnset char[4] 0x0080
	CharFlagsSet char[2] 0x0010
	CharFlagsUnset char[2] 0x0040
	_Char4B char[2] 255
	_Char4B char[3] 255
	QuestFlagsSet quest[8] 0x10
	QuestTaskSet quest[8] 9
	Sc_C4Unset 4096
	Sleep 500ms
	EventEnd 5
	Return

fn[17]:
	while 1:
		Emote char[2] 0mm 1700mm 38 39 250ms 2
		Sleep 1500ms
	Return
