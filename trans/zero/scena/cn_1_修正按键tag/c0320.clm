			很有可能是去ＩＢＣ呢。{wait}
		}
		TextWait
		TextTalk name[2] {
			#6P#0200F那我們就去ＩＢＣ吧，
			她也許還在那裡呢。{wait}
		}
		TextWait
		TextTalk name[0] {
			#12P#0000F是啊，儘量加快腳步吧！{wait}
		}
		TextWait
	else:
		if var[0] == 0:
			TextTalk name[0] {
				#12P#0000F是大教堂嗎？{wait}
			} {
				信仰堅定的人
				是有可能會去那裡的吧。{wait}
			}
			TextWait
			TextTalk name[1] {
				#11P#0108F是啊……但我想卡拉小姐
				對教會的信仰並不是很堅定。{wait}
			}
			TextWait
		else:
			TextTalk name[0] {
				#12P#0000F是市政廳嗎？{wait}
			} {
				比如說，果斷去提交了
				遷居申請之類的。{wait}
			}
			TextWait
			TextTalk name[1] {
				#11P#0108F是啊……但我懷疑突然奔出家門
				的卡拉小姐會不會有那麼冷靜……{wait}
			}
			TextWait
		Emote name[2] 0mm 2000mm 24 27 250ms 1
		Sleep 1000ms
		TextTalk name[2] {
			#6P#0203F因為是突發性的離家出走，{wait}
		} {
			#0200F所以身上現金不多的
			可能性也很高吧？{wait}
		}
		TextWait
		Emote name[0] 0mm 2000mm 38 38 250ms 1
		Emote name[3] 0mm 2000mm 38 38 250ms 1
		Emote name[1] 0mm 2000mm 38 38 250ms 1
		Sleep 500ms
		Fork name[0] fork[1]:
			CharTurnToChar self name[2] 400deg/s
		Fork name[3] fork[1]:
			CharTurnToChar self name[2] 400deg/s
		Fork name[1] fork[1]:
			CharTurnToChar self name[2] 400deg/s
		Sleep 300ms
		TextTalk name[0] {
			#12P#0005F是嗎，是去ＩＢＣ
			取離家出走的資金了吧……！{wait}
		}
		TextWait
		TextTalk name[3] {
			#5P#0303F這麼一想，
			的確是離家出走的常見套路呢。{wait}
		} {
			#0300F好，就去一趟ＩＢＣ吧！{wait}
		}
		TextWait
		TextTalk name[1] {
			#11P#0100F嗯，儘量
			加快腳步吧！{wait}
		}
		TextWait
	if var[3] >= 2 && flag[1681]:
		QuestBonusBp quest[45] 2
	FadeOut 1000ms 0x00000000 255
	FadeWait
	CharSetPos field_party[0] (45270, 60, 2680) 152deg
	QuestTaskSet quest[45] 5
	Sleep 500ms
	EventEnd 5
	Return

fn[13]:
