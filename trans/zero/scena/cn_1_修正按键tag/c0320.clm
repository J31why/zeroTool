calmare zero_k scena
scena:
	name "c0320" "c0320" "c0320"
	town town[45]
	bgm bgm[100]
	flags 8192
	item_use fn[0,255]
	unk 255 0

entry:
	pos (0, 0, -1000)
	unk1 0
	cam_from (0, 0, 34000)
	cam_pers 262
	unk2 30
	cam_deg 45deg
	cam_limit 0deg 360deg
	cam_at (0, 0, 0)
	unk3 0
	unk4 0
	flags 0x0001
	town town[45]
	init fn[0,3]
	reinit fn[0,4]

chip[0] "chr/ch27702.itc"
chip[1] "chr/ch27800.itc"
chip[2] "chr/ch27802.itc"
chip[3] "chr/ch33200.itc"
chip[4] "chr/ch34500.itc"

npc char[0]:
	name "坎貝爾議員"
	pos (0, 250, 46110)
	angle 180deg
	flags 0x01D5
	unk2 0
	chip chip[0]
	init fn[255,255]
	talk fn[0,5]
	unk4 255

npc char[1]:
	name "共和國派議員"
	pos (-2490, 0, 48869)
	angle 45deg
	flags 0x0185
	unk2 0
	chip chip[1]
	init fn[0,1]
	talk fn[0,6]
	unk4 255

npc char[2]:
	name "共和國派議員"
	pos (2299, 250, 43630)
	angle 270deg
	flags 0x0155
	unk2 0
	chip chip[2]
	init fn[255,255]
	talk fn[0,7]
	unk4 255

npc char[3]:
	name "卡拉"
	pos (43490, 59, 3440)
	angle 135deg
	flags 0x0185
	unk2 0
	chip chip[3]
	init fn[0,2]
	talk fn[0,8]
	unk4 255

npc char[4]:
	name "瑪夏"
	pos (-44409, 0, 10199)
	angle 0deg
	flags 0x0185
	unk2 0
	chip chip[4]
	init fn[0,0]
	talk fn[0,9]
	unk4 255

look_point[0]:
	pos (45950, 60, 1790)
	radius 1500
	bubble_pos (46410, 1000, 1270)
	unk1 124
	unk2 0
	function fn[0,13]
	unk3 0
	unk4 0

fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharIdle self (-2690, null, 49630) (-4100, null, 46250) 1000mm/s
		Sleep 300ms
	Return

fn[2]:
	while 1:
		CharIdle self (44630, null, 3440) (41760, null, 1660) 1000mm/s
		Sleep 300ms
	Return

fn[3]:
	if flag[1792]:
		if QuestTaskGet quest[45] 14:
			CharFlagsUnset char[4] 0x0080
	elif flag[1566]:
		CharFlagsSet char[2] 0x0080
		CharFlagsUnset char[1] 0x0080
		CharFlagsUnset char[4] 0x0080
	elif flag[1554]:
		CharFlagsUnset char[0] 0x0080
		CharSetChipPattern char[2] 2
		if QuestFlagsGet quest[45] 0x10:
			CharFlagsUnset char[4] 0x0080
	if QuestTaskGet quest[45] 14:
		CharFlagsUnset char[3] 0x0080
	Return

fn[4]:
	char[0].51 = 1200
	char[2].51 = 1200
	LookPointFlagsSet look_point[0] 0x0001
	if QuestTaskGet quest[45] 1 && !QuestFlagsGet quest[45] 0x10 && !QuestFlagsGet quest[45] 0x40:
		LookPointFlagsUnset look_point[0] 0x0001
	if system[4] == 3:
		EntranceSetDisabled entrance[0] 0
		EntranceSetDisabled entrance[7] 1
	else:
		EntranceSetDisabled entrance[0] 1
		EntranceSetDisabled entrance[7] 0
	if flag[1792]:
		MapColor 0x00C8D2FF 0ms
	else:
	Return

fn[5]:
	if QuestTaskGet quest[45] 0 && !QuestTaskGet quest[45] 1 && !QuestFlagsGet quest[45] 0x10 && !QuestFlagsGet quest[45] 0x40:
		Call fn[0,10]
		Return
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if QuestFlagsGet quest[45] 0x10:
		if QuestTaskGet quest[45] 14:
			TextTalk self {
				……對於將小女帶回一事，
				我姑且表示感謝。{wait}
			}
			TextWait
			TextTalk self {
				哼，僅此而已，
				你們可以回去了。{wait}
			}
			TextWait
		else:
			TextTalk self {
				哼……警察果然
				不值得依靠。{wait}
			}
			TextWait
			TextTalk self {
				算了，只要知道她在哪裡，
				再強行帶回即可。
				怎樣都有辦法將她帶回來……{wait}
			}
			TextWait
	elif !flag[0]:
		TextTalk self {
			今天由於議會政務和黑月事件，
			從早晨開始就忙碌不堪……{wait}
		}
		TextWait
		TextTalk self {
			但剛過中午時因為有事
			而回來了一趟。{wait}
		}
		TextWait
		TextTalk self {
			然而無論我怎麼叫，
			女兒和女僕也沒有出來。{wait}
		}
		TextWait
		TextTalk self {
			在我覺得奇怪時，
			就發現了女兒留下的字條。{wait}
		}
		TextWait
		if !QuestTaskGet quest[45] 2:
			TextTalk name[3] {
				#0301F（這個議員似乎平時就很目中無人啊。）{wait}
			}
			TextWait
			TextTalk name[0] {
				#0006F（看樣子，
				　他好像連女兒的去處
				　也毫無頭緒。）{wait}
			}
			TextWait
			QuestTaskSet quest[45] 2
			if QuestTaskGet quest[45] 4 && QuestTaskGet quest[45] 3:
				TextTalk name[2] {
					#0200F（情報都搜集完了……
					　先回到卡拉小姐的房間，
					　再重新開始推理吧。）{wait}
				}
				TextWait
				TextTalk name[0] {
					#0000F（嗯，就這麼辦吧。）{wait}
				}
				TextWait
		FlagSet flag[0]
	else:
		TextTalk self {
			剛過中午時，我因為有事而回來之後，
			就發現女兒和女僕都不見了。{wait}
		}
		TextWait
		TextTalk self {
			……小女的事就拜託各位了。
			若這樣下去，這件事可能會被
			帝國派當成攻擊材料。{wait}
		}
		TextWait
		TextTalk name[1] {
			#0108F（他難道都
			　不擔心卡拉小姐嗎……）{wait}
		}
		TextWait
	CharSetChipPattern self 0
	TextEnd self
	Return

fn[6]:
	TextStart self
	if !flag[1]:
		TextTalk self {
			議員秘書的受賄嫌疑，
			以及在那座議長宅邸所發生的神秘事件……{wait}
		}
		TextWait
		TextTalk self {
			唔，要用哪件事對帝國派進行攻擊
			才是最有效的呢？{wait}
		}
		TextWait
		TextTalk self {
			預算會議也漸入佳境，
			必須快點做出了結，然後
			去協助坎貝爾議員呢。{wait}
		}
		TextWait
		FlagSet flag[1]
	else:
		TextTalk self {
			在坎貝爾議員
			參加議會時，
			我就在為了戰鬥而收集情報。{wait}
		}
		TextWait
		TextTalk self {
			因為議會打的就是情報戰啊。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[7]:
	if QuestTaskGet quest[45] 0 && !QuestTaskGet quest[45] 1 && !QuestFlagsGet quest[45] 0x10 && !QuestFlagsGet quest[45] 0x40:
		Call fn[0,10]
		Return
	if flag[1792]:
		field_party[0].5 = self.4
		self.5 = self.4
		TextStart self
		CharFlagsUnset self 0x0010
		CharTurnToChar self field_party[0] 0deg/s
		self.4 = (self.4 + 360) % 360
		self.4 = self.4 + 360 - self.5
		self.5 = self.4 / 180
		if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
		elif self.5 < 1:
			self.8 = 2
		elif self.5 > 2:
			self.8 = 1
		else:
			self.8 = self.5
		self.4 = field_party[0].5
		field_party[0].5 = 0
		self.5 = 0
		CharFlagsSet self 0x0010
		if !flag[1]:
			TextTalk self {
				就在不久之前，
				自治州議會終於結束了。{wait}
			}
			TextWait
			TextTalk self {
				……嗯，
				今年會期真是延長了很久啊。{wait}
			}
			TextWait
			TextTalk self {
				哈哈……
				因為我們共和國派
				就是堅持到底，不肯妥協。{wait}
			}
			TextWait
			FlagSet flag[1]
		elif QuestTaskGet quest[45] 14:
			TextTalk self {
				咳咳……話說回來，
				小姐能回來，
				真是太好了啊。{wait}
			}
			TextWait
			TextTalk self {
				因為，如果女僕不在的話，
				就連茶都沒人給泡了啊。{wait}
			}
			TextWait
		else:
			TextTalk self {
				話說回來……
				茶還沒泡好嗎。{wait}
			}
			TextWait
			TextTalk self {
				這裡的女僕從剛才開始
				就不見人影，
				到底是在幹些什麼呢……？{wait}
			}
			TextWait
		CharSetChipPattern self 0
		TextEnd self
	elif flag[1554]:
		TextStart self
		field_party[0].5 = self.4
		self.5 = self.4
		TextStart self
		CharFlagsUnset self 0x0010
		CharTurnToChar self field_party[0] 0deg/s
		self.4 = (self.4 + 360) % 360
		self.4 = self.4 + 360 - self.5
		self.5 = self.4 / 180
		if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
		elif self.5 < 1:
			self.8 = 2
		elif self.5 > 2:
			self.8 = 1
		else:
			self.8 = self.5
		self.4 = field_party[0].5
		field_party[0].5 = 0
		self.5 = 0
		CharFlagsSet self 0x0010
		if QuestFlagsGet quest[45] 0x10:
			if QuestTaskGet quest[45] 14:
				if !flag[1]:
					TextTalk self {
						哎呀，真是太好了。
						這樣一來，這件事就不會
						被帝國派發現了吧。{wait}
					}
					TextWait
					TextTalk self {
						呵呵……這下可以安心
						專注於制定議會上的對策了。{wait}
					}
					TextWait
					FlagSet flag[1]
				else:
					TextTalk self {
						話說回來，議員竟會方寸大亂，
						這還真是少見啊……{wait}
					}
					TextWait
					TextTalk self {
						莫非真的是在擔心小姐嗎？
						……才不可能吧，哈哈哈！{wait}
					}
					TextWait
			elif !flag[1]:
				TextTalk self {
					哎？沒能將
					小姐帶回來嗎？{wait}
				}
				TextWait
				TextTalk self {
					哎呀哎呀……
					算了，只要不被帝國派發現，
					怎樣都無所謂。{wait}
				}
				TextWait
				TextTalk self {
					我們可是在忙著應對黑月和
					制定議會上的對策呢，
					可以請你們回去了嗎？{wait}
				}
				TextWait
				FlagSet flag[1]
			else:
				TextTalk self {
					我們正忙著應對黑月和
					制定議會上的對策，
					請你們回去吧。{wait}
				}
				TextWait
		elif !flag[1]:
			TextTalk self {
				議員是一個
				很有講究的人。{wait}
			}
			TextWait
			TextTalk self {
				例如，早飯一定要
				與家人一起吃，就是這樣。{wait}
			}
			TextWait
			TextTalk self {
				雖然也跟大小姐說過
				要遵守這個規矩了，
				但她似乎很不情願呢。{wait}
			}
			TextWait
			Emote field_party[0] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Emote field_party[1] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Emote field_party[2] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Emote field_party[3] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Sleep 1000ms
			if !QuestTaskGet quest[45] 3:
				TextTalk name[2] {
					#0203F……是這樣啊。{wait}
				}
				TextWait
				TextTalk self {
					兩人不和的原因
					也許就出在那裡吧。{wait}
				}
				TextWait
				TextTalk self {
					……總之，小姐今天早上
					至少是來吃了早餐的。{wait}
				}
				TextWait
				TextTalk self {
					因為我也
					一起叨擾了，
					肯定不會有錯。{wait}
				}
				TextWait
				if QuestTaskGet quest[45] 4 && QuestTaskGet quest[45] 2:
					TextTalk name[2] {
						#0200F（情報都搜集完了……
						　先回到卡拉小姐的房間，
						　再重新開始推理吧。）{wait}
					}
					TextWait
					TextTalk name[0] {
						#0000F（嗯，就這麼辦吧。）{wait}
					}
					TextWait
				QuestTaskSet quest[45] 3
			FlagSet flag[1]
		else:
			TextTalk self {
				總之我們這邊已經因為議會對策
				和黑月事件而忙得不可開交了。{wait}
			}
			TextWait
			TextTalk self {
				你們在進行調查時，
				一定要儘量隱秘，
				給我注意不要讓帝國派發現了！{wait}
			}
			TextWait
		CharSetChipPattern self 2
		TextEnd self
	Return

fn[8]:
	TextStart self
	if flag[1792]:
		if !flag[2]:
			TextTalk self {
				聽說預算會議已經結束了呢，
				這樣的話，父親也能提早回來吧。{wait}
			}
			TextWait
			TextTalk self {
				……真沒辦法……
				我就勉為其難地陪他共進晚餐吧。{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			TextTalk self {
				……這次可不是因為
				他要求我這麼做，
				只是我正好有心情而已。{wait}
			}
			TextWait
			TextTalk self {
				因為，我心裡也不是真的
				討厭父親。{wait}
			}
			TextWait
	elif flag[1566]:
		if !flag[2]:
			TextTalk self {
				今天我準備和瑪夏
				一起去購物。{wait}
			}
			TextWait
			TextTalk self {
				呵呵……父親他也
				不再囉囉嗦嗦了，
				感覺變得好自由呢。{wait}
			}
			TextWait
			TextTalk self {
				這都是多虧了各位。{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			TextTalk self {
				今天我準備和瑪夏
				一起去購物。{wait}
			}
			TextWait
			TextTalk self {
				呵呵……父親他也
				不再囉囉嗦嗦了，
				感覺變得好自由呢。{wait}
			}
			TextWait
	elif flag[1554]:
		if !flag[2]:
			TextTalk self {
				果然還是自己家最好了。{wait}
			}
			TextWait
			TextTalk self {
				……艾莉小姐，還有各位，
				今天真是受你們多方照顧了。{wait}
			}
			TextWait
			TextTalk name[1] {
				#0100F請不必在意。
				比起那個……請你平時
				多和令尊溝通溝通吧。{wait}
			}
			TextWait
			TextTalk self {
				嗯，放心吧，沒問題了，
				因為我已經有了自信。{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			TextTalk self {
				……艾莉小姐，還有各位，
				今天真是受你們多方照顧了。{wait}
			}
			TextWait
			TextTalk self {
				請再來玩哦。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[9]:
	TextStart self
	if flag[1792]:
		TextTalk self {
			今晚準備了
			豪華的晚餐。{wait}
		}
		TextWait
		TextTalk self {
			呵呵……如果小姐和老爺
			能高興就好了。{wait}
		}
		TextWait
	elif flag[1566]:
		if QuestTaskGet quest[45] 14:
			TextTalk self {
				小姐她，露出了
				很燦爛的笑容呢。{wait}
			}
			TextWait
			TextTalk self {
				呵呵……我很期待今天
				和小姐一起去購物。{wait}
			}
			TextWait
		else:
			TextTalk self {
				……小姐她…………{wait}
			}
			TextWait
			TextTalk self {
				離家出走後就孤身一人……
				不要緊嗎……{wait}
			}
			TextWait
	elif flag[1554]:
		if QuestTaskGet quest[45] 14:
			if !flag[3]:
				TextTalk self {
					各位，我真的不知道
					該如何感謝你們才好……{wait}
				}
				TextWait
				TextTalk self {
					果然還是應該找各位商量呀，
					幸好當時沒有盲目服從小姐……{wait}
				}
				TextWait
				TextTalk name[0] {
					#0000F如果發生什麼的話，歡迎再來
					找我們『特務支援課』商談。{wait}
				}
				TextWait
				TextTalk self {
					好、好的。
					一定會的！{wait}
				}
				TextWait
				FlagSet flag[3]
			else:
				TextTalk self {
					各位，真的非常感謝。
					我真慶幸自己拿出了勇氣。{wait}
				}
				TextWait
		else:
			TextTalk self {
				今天將工作都
				擱下了……{wait}
			}
			TextWait
			TextTalk self {
				……如果不快點準備，
				就來不及做飯了……{wait}
			}
			TextWait
	TextEnd self
	Return

fn[10]:
	EventBegin 0
	FadeOut 1000ms 0x00000000 255
	FadeWait
	CamSetDistance 440 1000 42830 0ms
	ED7CamRotate 54deg 20deg 0deg 0ms
	CamPers 390 0ms
	CamZoom 22640 0ms
	CharSetPos name[0] (500, 0, 40660) 0deg
	CharSetPos name[1] (-500, 0, 40660) 0deg
	CharSetPos name[2] (-500, 60, 39200) 0deg
	CharSetPos name[3] (500, 60, 39200) 0deg
	FadeIn 1000ms 0x00000000
	FadeWait
	TextTalk char[0] {
		#5P可惡，竟然給我惹出這種麻煩……！{wait}
	}
	TextWait
	TextTalk char[2] {
		#11P但是議員，我們必須
		快點制定對策……{wait}
	}
	TextWait
	TextTalk name[0] {
		#12P#0000F那個，抱歉打擾了，
		我們是因為支援請求前來拜訪的。{wait}
	}
	TextWait
	Emote char[0] 0mm 2000mm 38 38 250ms 1
	Emote char[2] 0mm 2000mm 38 38 250ms 1
	Sleep 500ms
	CharSetChipPattern char[2] 1
	CrossFade 300ms
	CharSetPos char[2] (1900, 60, 43630) 270deg
	CharSetChipBase char[2] chip[1]
