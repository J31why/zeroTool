fn[5]:
	if flag[3]:
		TextTalk char[0] {
			這條街最西邊的建築
			是一棟名為洋槐莊園的公寓。{wait}
		}
		TextWait
		TextTalk char[0] {
			沒記錯的話，應該有一間房一直空著。
			你們要找的應該就是那裡吧？{wait}
		}
		TextWait
	elif flag[4]:
		if global[3] == 5:
			if !flag[0]:
				TextTalk char[0] {
					羅伊德團員，你聽說過這個傳聞嗎？{wait}
				}
				TextWait
				TextTalk char[0] {
					在克洛斯貝爾，棲息著傳說中的魚王
					──『霸王蛇魚』。{wait}
				}
				TextWait
				TextTalk char[0] {
					牠們以艾魯姆湖為主要棲息地，
					性情可謂兇殘非常，
					據說在從前，連漁民都懼怕牠們。{wait}
				}
				TextWait
				TextTalk char[0] {
					但是，最近這十幾年來，
					卻幾乎沒有人目擊過牠們……{wait}
				}
				TextWait
				TextTalk char[0] {
					如果能把這傢伙釣上來，
					毫無疑問就能得到榮譽勳章了……{wait}
				}
				TextWait
				FlagSet flag[0]
			else:
				TextTalk char[0] {
					『霸王蛇魚』簡直是
					魚王中的魚王……
					釣到那傢伙可是我們釣公師團的共同夢想。{wait}
				}
				TextWait
				TextTalk char[0] {
					雖然這十幾年來都沒有人目擊過牠們，
					但如果是已經成為『特級釣師』的你，
					說不定還真有可能將它釣上來吧……{wait}
				}
				TextWait
		elif !flag[0]:
			TextTalk char[0] {
				不愧是羅伊德團員，
				都成了『釣聖』還這麼謙虛。{wait}
			}
			TextWait
			TextTalk char[0] {
				哇哈哈，我非常欣賞你！
				今天晚上不如去夜釣吧。{wait}
			}
			TextWait
			TextTalk char[0] {
				我們分部在舉辦聯歡會時，
				就經常會去夜釣！{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F哈哈，不好意思。
				今天晚上稍微有些不方便……{wait}
			} {
				下次如果有機會，
				我絕對樂意奉陪到底。{wait}
			}
			TextWait
			TextTalk char[0] {
				哇哈哈哈，連拒絕的方式都這麼謙遜有禮！{wait}
			}
			TextWait
			TextTalk char[0] {
				好吧！那等你有空時，就來和我說。
				到時候連同慶祝會一起，舉辦一場釣魚大賽吧。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				一定要慶祝羅伊德團員
				取得了『釣聖』的稱號啊。{wait}
			}
			TextWait
			TextTalk char[0] {
				到時候把你釣到霸王蛇魚的神勇經過
				慢慢說給我聽吧，哇哈哈哈！{wait}
			}
			TextWait
	elif flag[1792]:
		TextTalk char[0] {
			太陽下山了啊……
			不然就去市外的
			什麼地方逛逛吧。{wait}
		}
		TextWait
		TextTalk char[0] {
			我感覺今晚的夜釣
			會遇到前所未聞的
			大傢伙哦。{wait}
		}
		TextWait
	elif flag[1566]:
		TextTalk char[0] {
			奇怪了……
			聯絡不上約亞西姆大師。{wait}
		}
		TextWait
