fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	Return

fn[2]:
	ED7_1D_0 0 1 0 (-6000, -1000, 16000) 5000 5000 0
	ObjFlagsSet object[7] 0x0004
	ObjFlagsSet object[8] 0x0004
	Return

fn[3]:
	Call fn[0,4]
	Return

fn[4]:
	TextStart char[0]
	if flag[1552]:
		if flag[0]:
			TextTalk char[0] {
				你們和岡茲先生說過話了吧……
				他的直覺確實變得敏銳異常呢。{wait}
			}
			TextWait
			TextTalk char[0] {
				真是的……他到底是在什麼地方，
				接受了怎樣的直覺訓練啊。{wait}
			}
			TextWait
		else:
			TextTalk char[0] {
				呀，各位，情況如何啊？
				見到了岡茲先生了嗎？{wait}
			}
			TextWait
			TextTalk name[0] {
				#0003F唔，算是吧……
				雖然覺得和預想中的不太一樣，但總算是見到了。{wait}
			} {
				#0000F多謝您的幫忙。{wait}
			}
			TextWait
			TextTalk name[3] {
				#0301F話說回來，最讓人費解的
				還是他那驚人的能力。{wait}
			} {
				#0306F為什麼我就
				得不到那種能力啊！{wait}
			}
			TextWait
			TextTalk name[1] {
				#0106F呼，你還在糾結這個問題啊。{wait}
			}
			TextWait
			TextTalk name[2] {
				#0211F……………………………………{wait}
			}
			TextWait
			FlagSet flag[0]
	else:
		TextTalk char[0] {
			岡茲先生是我們這裡的常客哦。
			不會搞錯的。{wait}
		}
		TextWait
		TextTalk char[0] {
			他現在應該暫時住在
			千禧飯店頂層的
			豪華客房中。{wait}
		}
		TextWait
		TextTalk char[0] {
			有事的話，就去那裡找他吧。{wait}
		}
		TextWait
	TextEnd char[0]
	Return

fn[5]:
	Call fn[0,6]
	Return

fn[6]:
	TextStart char[1]
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"對話" // 0
			"兌換" // 1
			"放棄" // 2
		MenuWait var[0]
		if var[0] != 1:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			FlagSet flag[879]
			if flag[1280]:
				ShopOpen shop[63]
			else:
				ShopOpen shop[62]
			var[0] = 99
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			if flag[1]:
				TextTalk char[1] {
					岡茲先生
					最近運勢當頭呢～{wait}
				}
				TextWait
				TextTalk char[1] {
					跟以前比起來，簡直就是判若兩人～{wait}
				}
				TextWait
			else:
				TextTalk char[1] {
					說起來，岡茲先生
					最近樣子有些奇怪呢～{wait}
				}
				TextWait
				TextTalk char[1] {
					態度變得特別囂張蠻橫～
					而且不斷取勝～{wait}
				}
				TextWait
				TextTalk char[1] {
					跟以前比起來，簡直就是判若兩人～{wait}
				}
				TextWait
				FlagSet flag[1]
	TextEnd char[1]
	Return

fn[7]:
	Call fn[0,8]
	Return

fn[8]:
	TextStart char[2]
	if flag[2]:
		TextTalk char[2] {
			以前玩牌的時候，他很少能獲勝，
			最近為什麼會有這麼好的運氣呢……{wait}
		}
		TextWait
	else:
		TextTalk char[2] {
			每次和岡茲先生較量，
			他總是能抽到上等好牌。{wait}
		}
		TextWait
		TextTalk char[2] {
			不過，可以確定的是，
			他並沒有耍詐……{wait}
		}
		TextWait
		TextTalk char[2] {
			他的手氣為什麼會如此好，
			實在是想不通。{wait}
		}
		TextWait
		FlagSet flag[2]
	TextEnd char[2]
	Return

fn[9]:
	Call fn[0,10]
	Return

fn[10]:
	TextStart char[3]
	TextTalk char[3] {
		岡茲先生的運氣和直覺
		都不同尋常啊……{wait}
	}
	TextWait
	TextTalk char[3] {
		我也第一次嘗到了
		連續敗北的滋味。{wait}
	}
	TextWait
	TextEnd char[3]
	Return

fn[11]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if flag[3]:
		TextTalk char[4] {
			我也曾和他比試過一次呢。{wait}
		}
		TextWait
		TextTalk char[4] {
			但是他根本就不像是
			技巧平庸的傢伙啊。{wait}
		}
		TextWait
	else:
		TextTalk char[4] {
			聽說，那個叫岡茲的男人
			原來只是個技巧
			非常差的傢伙……{wait}
		}
		TextWait
		TextTalk char[4] {
			這是真的嗎，
			實在是讓人無法想像啊。{wait}
		}
		TextWait
		FlagSet flag[3]
	CharSetChipPattern self 0
	TextEnd self
	Return

fn[12]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
