fn[11]:
	EventBegin 0
	CrossFade 1000ms
	CamSetDistance 1260 300 7490 0ms
	ED7CamRotate 45deg 20deg 0deg 0ms
	CamPers 500 0ms
	CamZoom 18060 0ms
	CamZoom 17060 2000ms
	CharSetPos name[0] (1890, -1000, 8970) 225deg
	CharSetPos name[1] (2920, -1000, 8620) 225deg
	CharSetPos name[2] (2580, -1000, 7410) 270deg
	CharSetPos name[3] (3530, -1000, 7820) 270deg
	CharSetChipPattern char[0] 2
	CamWait 16
	FadeWait
	TextTalk char[0] {
		#13500260V#3404F#6P米修拉姆……
		真是個讓人深感興趣的地方呢。{wait}
	} {
		#13500261V#3400F如果時間再充裕一點的話，
		本來還想去主題樂園看看呢。{wait}
	}
	TextWait
	Emote name[0] 0mm 2000mm 38 38 250ms 1
	Emote name[1] 0mm 2000mm 38 38 250ms 1
	Emote name[2] 0mm 2000mm 38 38 250ms 1
	Emote name[3] 0mm 2000mm 38 38 250ms 1
	Sleep 1000ms
	TextTalk name[0] {
		#13500262V#0005F#5P那個……原來您不是
		要去主題樂園啊？{wait}
	}
	TextWait
	TextTalk char[0] {
		#13500263V#3404F#6P不是哦，因為還有些瑣事要辦呢。{wait}
	} {
		#13500264V#3400F算了，反正這也不是
		最後一次來克洛斯貝爾……{wait}
	} {
		#13500265V等以後有機會再去慢慢玩吧。{wait}
	}
	TextWait
	TextTalk name[1] {
		#13500266V#0109F#5P呵呵，請一定要再來啊。{wait}
	}
	TextWait
	TextTalk name[3] {
		#13500267V#0300F#11P說起來……
		您覺得彩虹劇團
		的新劇怎麼樣呢？{wait}
	} {
		#13500268V昨天應該去看過了吧？{wait}
	}
	TextWait
	TextTalk char[0] {
		#13500269V#3404F#6P嗯，看的是夜場。{wait}
	} {
		#13500270V#3402F我也曾經欣賞過
		各式各樣的舞臺演出……{wait}
	} {
		#13500271V但也許從沒見過
		哪個舞臺，
		能保持著那種奇跡般的平衡感。{wait}
	}
	TextWait
	TextTalk name[2] {
		#13500272V#0205F#11P奇跡般的平衡感嗎……{wait}
	}
	TextWait
	TextTalk char[0] {
		#13500273V#3400F#6P腳本、導演、服裝、音樂……{wait}
	} {
		#13500274V再加上豪華的舞臺設備，
		以及各種高難度的特技表演……{wait}
	} {
		#13500275V雖然每一項的水準都非常高，
		但與其它那些著名劇團相比，
		倒也沒有強到鶴立雞群的程度。{wait}
	} {
		#13500276V#3404F可是，伊莉雅・普拉提耶……{wait}
	} {
		#13500277V當以她的存在為核心，
		各個要素被緊密結合到一起時，
		舞臺仿佛就變得有了生命一般呢。{wait}
	} {
		#13500278V#3402F讓我感覺，簡直就像是
		見證了一個生命的誕生啊。{wait}
	}
	TextWait
	TextTalk name[0] {
		#13500279V#0002F#5P原來如此……{wait}
	}
	TextWait
	TextTalk name[1] {
		#13500280V#0104F#5P生命的誕生……
		這確實可以算得上是奇跡吧。{wait}
	}
	TextWait
	TextTalk name[3] {
		#13500281V#0309F#11P呀～！
		真不愧是演藝界的製作人啊！{wait}
	} {
		#13500282V聽您這麼一說，
		感覺確實就是這麼一回事呢！{wait}
	}
	TextWait
	TextTalk char[0] {
		#13500283V#3404F#6P呵呵……{wait}
	} {
		#13500284V只是，在這次的新劇中，
		締造奇跡的還另有人在哦。{wait}
	} {
		#13500285V#3400F飾演『月之姬』的超級新星
		──莉夏・毛。{wait}
	} {
		#13500286V渾身散發著死亡氣息的她，
		使舞臺表演的效果又上了一層樓。{wait}
	}
	TextWait
	Emote name[0] 0mm 2000mm 38 38 250ms 1
	Emote name[1] 0mm 2000mm 38 38 250ms 1
	Emote name[2] 0mm 2000mm 38 38 250ms 1
	Emote name[3] 0mm 2000mm 38 38 250ms 1
	Sleep 1000ms
	TextTalk name[0] {
		#13500287V#0005F#5P莉夏她……？{wait}
	}
	TextWait
	TextTalk name[1] {
		#13500288V#0105F#5P死亡的氣息……嗎？{wait}
	}
