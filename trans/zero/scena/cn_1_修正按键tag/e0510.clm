fn[0]:
	var[0] = random % 100
	if var[0] > 75:
		Sleep 600ms
	elif var[0] > 50:
		Sleep 400ms
	elif var[0] > 25:
		Sleep 200ms
	while 1:
		CharSetChipPattern self 0
		Sleep 100ms
		CharSetChipPattern self 1
		Sleep 100ms
		CharSetChipPattern self 2
		Sleep 100ms
		CharSetChipPattern self 1
		Sleep 100ms
		CharSetChipPattern self 0
		Sleep 100ms
		CharSetChipPattern self 3
		Sleep 100ms
		CharSetChipPattern self 4
		Sleep 100ms
		CharSetChipPattern self 3
		Sleep 100ms
	Return

fn[1]:
	if global[2] == 12 && !flag[1312]:
		Event fn[0,12]
	if flag[736]:
		FlagUnset flag[736]
		Event fn[0,10]
	Return

fn[2]:
	SoundPlay sound[480] 1 100 0
	Return

fn[3]:
	if flag[1309] && !flag[1311]:
		Call fn[0,11]
	else:
		field_party[0].5 = char[0].4
		char[0].5 = char[0].4
		TextStart char[0]
		CharFlagsUnset char[0] 0x0010
		CharTurnToChar char[0] field_party[0] 0deg/s
		char[0].4 = (char[0].4 + 360) % 360
		char[0].4 = char[0].4 + 360 - char[0].5
		char[0].5 = char[0].4 / 180
		if char[0].4 <= 45 | char[0].4 >= 315 && char[0].4 <= 405 | char[0].4 >= 675:
		elif char[0].5 < 1:
			char[0].8 = 2
		elif char[0].5 > 2:
			char[0].8 = 1
		else:
			char[0].8 = char[0].5
		char[0].4 = field_party[0].5
		field_party[0].5 = 0
		char[0].5 = 0
		CharFlagsSet char[0] 0x0010
		if !flag[0]:
			TextTalk char[0] {
				#3404F呵呵，抱歉，突然說起了
				難懂的話題呢。{wait}
			} {
				#3400F難得要去遊憩區……
				我雖然還有些瑣事要處理，
				但希望你們能盡情享受哦。{wait}
			}
			TextWait
			TextTalk name[3] {
				#0309F這是當然的啦！{wait}
			}
			TextWait
			TextTalk name[2] {
				#0211F（……蘭迪前輩，你難道忘了
				　我們此行的目的嗎？）{wait}
			}
			TextWait
			TextTalk name[3] {
				#0306F（我、我知道啦～
				　別用那種目光看我啦，小緹……）{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				#3400F難得要去遊憩區……
				希望你們能盡情享受哦。{wait}
			}
			TextWait
		CharSetChipPattern char[0] 0
		TextEnd char[0]
	Return

fn[4]:
	TextStart self
	if !flag[1]:
		TextTalk self {
			客人，您是第一次
			乘坐水上巴士嗎？{wait}
		}
		TextWait
		TextTalk self {
			距離到達米修拉姆還需要一點時間，
			請您先暫時享受一下這趟
			在波濤中穩穩行進的旅途吧。{wait}
		}
		TextWait
		FlagSet flag[1]
		if !flag[1450]:
			FlagSet flag[1450]
			global[2] = global[2] + 1
	else:
		TextTalk self {
			……莫非您
			暈船了嗎？{wait}
		}
		TextWait
		TextTalk self {
			我們這裡常備有止暈藥，
			如果感到不舒服，
			請儘管向我們索取。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[5]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if !flag[2]:
		TextTalk self {
			今天終於要去期待已久的米修拉姆了㈱{wait}
		}
		TextWait
		TextTalk self {
			一定要去時裝店和珠寶店
			盡情購物一番㈱{wait}
		}
		TextWait
		FlagSet flag[2]
		if !flag[1451]:
			FlagSet flag[1451]
			global[2] = global[2] + 1
	else:
		TextTalk self {
			我的男朋友今天好像
			帶了很多米拉呢。{wait}
		}
		TextWait
		TextTalk self {
			呵呵，要玩個痛快哦～㈱{wait}
		}
		TextWait
	CharSetChipPattern self 0
	TextEnd self
	Return

