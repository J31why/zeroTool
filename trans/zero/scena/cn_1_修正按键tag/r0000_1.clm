calmare zero_k scena
scena:
	name "r0000" "r0000" "r0000_1"
	town town[94]
	bgm bgm[204]
	flags 0
	item_use fn[0,255]
	unk 255 0

entry:
	pos (0, 0, -1000)
	unk1 0
	cam_from (0, 2500, 34000)
	cam_pers 262
	unk2 30
	cam_deg 45deg
	cam_limit 0deg 360deg
	cam_at (1100, 0, -3500)
	unk3 0
	unk4 0
	flags 0x0001
	town town[94]
	init fn[0,1]
	reinit fn[0,2]

// NB: the first five sepith sets are seemingly junk data.
sepith[0] 100 1 2 3 70 89 99 0
sepith[1] 100 5 1 5 1 5 1 0
sepith[2] 100 5 1 5 1 5 1 0
sepith[3] 100 5 0 5 0 5 0 0
sepith[4] 100 5 0 5 0 5 0 0

