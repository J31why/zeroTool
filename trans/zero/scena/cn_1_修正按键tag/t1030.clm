fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if flag[1333]:
	elif flag[1330]:
	elif flag[1329]:
	elif flag[1320]:
	elif flag[1319]:
	elif flag[1318]:
		CharFlagsUnset char[5] 0x0080
		CharFlagsUnset char[6] 0x0080
		CharFlagsUnset char[7] 0x0080
	elif flag[1312]:
		CharFlagsUnset char[3] 0x0080
		CharFlagsUnset char[4] 0x0080
		CharFlagsUnset char[2] 0x0080
		CharFlagsUnset char[8] 0x0080
		CharFlagsUnset char[9] 0x0080
		CharFlagsUnset char[10] 0x0080
		CharFlagsUnset char[11] 0x0080
	elif flag[1307]:
	Return

fn[2]:
	TriggerFlagsSet trigger[0] 0x0080
	TriggerFlagsUnset trigger[1] 0x0080
	if flag[1312] && !flag[1314]:
		TriggerFlagsUnset trigger[0] 0x0080
	if flag[1318] && !flag[1342]:
		MapColor 0x00B4BEFF 0ms
		ED7_76_0 object[255] "t1030_sky" 1
		ED7_76_1 object[255] "t1030_sky_y" 1
	else:
		ED7_76_1 object[255] "t1030_sky" 1
		ED7_76_0 object[255] "t1030_sky_y" 1
	LookPointFlagsSet look_point[2] 0x0001
	if QuestFlagsGet quest[36] 0x02 && !QuestTaskGet quest[36] 3:
		EffLoad eff[1] "event\\eva00_00.eff"
		EffPlay eff[1] eff_instance[1] null 0 (4180, 4250, -9540) 0 0 0 1000 1000 1000 null (0, 0, 0) 0ms
		LookPointFlagsUnset look_point[2] 0x0001
	SoundPlayContinuously sound[885] (37600, 4000, 17620) 90000 60000 100 0
	ED7_E1 (-2490, 4000, 10240)
	ED7_E1 (-77760, 4000, 18030)
	Return

fn[3]:
	TextStart self
	if flag[1333]:
	elif flag[1330]:
	elif flag[1329]:
	elif flag[1320]:
	elif flag[1319]:
	elif flag[1318]:
		TextTalk self {
			為了參加主題樂園的夜場
			而在這個時間入園的客人
			也非常多。{wait}
		}
		TextWait
		TextTalk self {
			充滿浪漫氣氛的夜場，
			非常受情侶們歡迎哦。{wait}
		}
		TextWait
	elif flag[1312]:
		if !flag[0]:
			TextTalk self {
				歡迎來到米修拉姆
				引以為傲的主題樂園。{wait}
			}
			TextWait
			TextTalk self {
				請問您有門票嗎？{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F不……這次還有要事。
				不好意思，就不進去了。{wait}
			}
			TextWait
			TextTalk self {
				哦哦，是嗎……
				那可真遺憾。{wait}
			}
			TextWait
			TextTalk self {
				期待您下次前來時
				入園遊玩。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				您這次似乎
				不打算進入主題樂園……
				真是遺憾。{wait}
			}
			TextWait
			TextTalk self {
				不過，米修拉姆還有其它很多
				值得一去的好地方。{wait}
			}
			TextWait
			TextTalk self {
				入夜後，就算在園外，
				應該也可以看到煙火，
				請不要錯過哦。{wait}
			}
			TextWait
	elif flag[1307]:
	TextEnd self
	Return

fn[4]:
	TextStart self
	if flag[1333]:
	elif flag[1330]:
	elif flag[1329]:
	elif flag[1320]:
	elif flag[1319]:
	elif flag[1318]:
		if !flag[1]:
			TextTalk self {
				園內除了各種遊樂設施之外，
				還有販賣咪西
				周邊產品的商店哦。{wait}
			}
			TextWait
			TextTalk self {
				其中最推薦的是
				『咪西貓耳頭飾』！{wait}
			}
			TextWait
			TextTalk self {
				在園內特有的熱烈氣氛中，
				體驗一下徹底放鬆的感覺如何呢。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				園內除了各種遊樂設施之外，
				還有販賣咪西
				周邊產品的商店哦。{wait}
			}
			TextWait
			TextTalk self {
				除了『咪西貓耳頭飾』之外，
				還有掛繩等小裝飾，
				各種周邊應有盡有哦。{wait}
			}
			TextWait
	elif flag[1312]:
		if !flag[1]:
			TextTalk self {
				剛才進去的旅行者……
				真是很有趣的人呢。{wait}
			}
			TextWait
			TextTalk self {
				說著『要確認一下
				主題樂園裡
				有沒有另一隻咪西！』{wait}
			}
			TextWait
			TextTalk self {
				……感覺氣勢十足哦。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0006F（是雷克多先生吧……）{wait}
			}
			TextWait
			TextTalk name[1] {
				#0106F（他到底在幹什麼呢……）{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				呵呵，不必擔心。
				咪西是不可能
				出現第二隻的。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0003F（嗯～因為扮演人員的值班日程
				　一定排得很緊吧。）{wait}
			}
			TextWait
			TextTalk name[2] {
				#0211F（……請不要說這種
				　破壞別人夢想的話。）{wait}
			}
			TextWait
			TextTalk name[0] {
				#0011F（對、對不起。）{wait}
			}
			TextWait
	elif flag[1307]:
	TextEnd self
	Return

fn[5]:
	TextStart self
	if !flag[5]:
		TextTalk self {
			{color 10}大家好！
			歡迎來到奇幻樂園。{color 0}{wait}
		}
		TextWait
		TextTalk self {
			{color 10}咪嘻嘻，要玩得開心哦～！{color 0}{wait}
		}
		TextWait
		TextTalk name[2] {
			#0201F……真的咪西……！！{wait}
		}
		TextWait
		TextTalk name[0] {
			#0005F緹、緹歐？{wait}
		}
		TextWait
		TextTalk name[2] {
			#0203F……咳，
			沒什麼。{wait}
		}
		TextWait
		FlagSet flag[5]
	else:
		TextTalk self {
			{color 10}大家好！
			歡迎來到奇幻樂園。{color 0}{wait}
		}
		TextWait
		TextTalk self {
			{color 10}咪嘻嘻，要玩得開心哦～！{color 0}{wait}
		}
		TextWait
	TextEnd self
	Return

fn[6]:
	TextStart self
	TextTalk self {
		哇……
		這就是主題樂園啊。{wait}
	}
	TextWait
	TextTalk self {
		……真是好大啊，
		要是能玩個遍就好了……{wait}
	}
	TextWait
	TextEnd self
	Return

fn[7]:
	TextStart self
	TextTalk self {
		哇！
		我早就想來這裡了！{wait}
	}
	TextWait
	TextEnd self
	Return

fn[8]:
	TextStart self
	CharTurnTo self 180deg 0deg/s
	TextTalk self {
		爸爸～快進去吧～！{wait}
	}
	TextWait
	TextEnd self
	Return

fn[9]:
	TextStart self
	if !flag[2]:
		CharTurnTo self 0deg 0deg/s
		TextTalk char[5] {
			爸爸～！
			你在幹什麼～？
			快點進去啦！{wait}
		}
		TextWait
		TextTalk self {
			好好，知道了，知道了，
			稍微等一下。{wait}
		}
		TextWait
		FlagSet flag[2]
	else:
		TextTalk self {
			話說，小孩子還真是
			喜歡這種地方啊。
			都已經傍晚了，竟然還那麼精神。{wait}
		}
		TextWait
		TextTalk self {
			要是不管他的話，一定會
			玩到精疲力盡為止吧。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[10]:
	TextStart self
	TextTalk self {
		雖然剛剛傍晚，不過還是趁著
		開始擁擠之前先回飯店吧。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[11]:
	TextStart self
	if flag[4]:
		TextTalk char[8] {
			其實我還有工作沒做完。{wait}
		}
		TextWait
		TextTalk char[8] {
			不能一直玩啊……
			算、算了……{wait}
		}
		TextWait
	else:
		TextTalk char[8] {
			偶爾也要照顧到家人的情緒……
			……雖然這麼想。{wait}
		}
		TextWait
		TextTalk char[8] {
			但她們兩個的熱情也太高漲了吧……
			算、算了……{wait}
		}
		TextWait
		FlagSet flag[4]
	TextEnd self
	Return

fn[12]:
	TextStart self
