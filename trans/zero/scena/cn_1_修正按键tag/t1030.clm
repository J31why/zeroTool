fn[15]:
	EventBegin 0
	if flag[1333]:
	elif flag[1330]:
	elif flag[1329]:
	elif flag[1320]:
	elif flag[1319]:
	elif flag[1318]:
		if !flag[3]:
			TextTalk name[80] {
				#5705F……現在要去
				主題樂園玩嗎？{wait}
			} {
				#5702F買套咪西的玩偶服，
				然後穿去參加拍賣會
				似乎也挺有趣的呢。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0006F但那未免也太詭異了吧……{wait}
			} {
				#0000F總、總而言之，
				現在還是先去時裝店吧。{wait}
			}
			TextWait
			FlagSet flag[3]
		else:
			TextTalk name[0] {
				#0000F現在不需要去主題樂園，
				先去時裝店買正裝吧。{wait}
			}
			TextWait
	elif flag[1312]:
		TextTalk name[0] {
			#0003F這次的目標是『黑之拍賣會#10RSchwarz Auction#』，
			主題樂園只好放棄了吧……{wait}
		}
		TextWait
		if !flag[3]:
			TextTalk name[2] {
				#0208F…………………………{wait}
			}
			TextWait
			TextTalk name[0] {
				#0011F（果、果然還是……覺得有些遺憾嗎？）{wait}
			}
			TextWait
			FlagSet flag[3]
	elif flag[1307]:
	CharSetPos field_party[0] (0, 4400, -1250) 180deg
	EventEnd 5
	Return

