		CharFlagsUnset char[6] 0x0008
		CharFlagsUnset char[7] 0x0008
		ObjFlagsUnset object[15] 0x0004
	Return

fn[3]:
	ED7_F2 1
	SystemFlagsSet 0x08000000
	FadeOut 300ms 0x00000000 100
	if !flag[2131]:
		SoundPlay sound[14] 0 100 0
		ED7ObjPlay object[15] 0 30 0 0
		Sleep 500ms
		ObjFrame object[15] 30
		SoundPlay sound[17] 0 100 0
		TextSetPos -1 -1 -1 -1
		SepithAdd 0 20
		SepithAdd 1 20
		SepithAdd 2 20
		SepithAdd 3 20
		SepithAdd 4 20
		SepithAdd 5 20
		SepithAdd 6 20
		TextMessage null {
			獲得了{color 2}#56I地之耀晶石×２０{color 0}
			{color 2}#57I水之耀晶石×２０{color 0}
			{color 2}#58I火之耀晶石×２０{color 0}
			{color 2}#59I風之耀晶石×２０{color 0}
			{color 2}#60I時之耀晶石×２０{color 0}
			{color 2}#61I空之耀晶石×２０{color 0}
			{color 2}#62I幻之耀晶石×２０{color 0}。{wait}
		}
		TextWait
		TextClose 0
		TextSetPos -1 280 60 3
		FlagSet flag[2131]
		ED7_DE 6
	else:
		TextMessage name[742] {
			{0x06}{color 5}寶箱內空無一物。{wait}
		}
		TextWait
		TextClose 0
	FadeIn 300ms 0x00000000
	TextEnd null
	SystemFlagsUnset 0x08000000
	Return

