fn[2]:
	if system[0] != 103 && system[0] != 104:
		CharFlagsSet char[4] 0x0008
	else:
		CharFlagsUnset char[4] 0x0008
	if system[0] != 105 && system[0] != 106:
		CharFlagsSet char[5] 0x0008
		ObjFlagsSet object[17] 0x0004
	else:
		CharFlagsUnset char[5] 0x0008
		ObjFlagsUnset object[17] 0x0004
	if system[0] != 109 && system[0] != 110 && system[0] != 122 && system[0] != 125:
		ObjFlagsSet object[16] 0x0004
	else:
