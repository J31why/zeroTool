fn[0]:
	if system[0] == 0:
		if global[0] == 12:
			global[0] = 0
			Event fn[0,9]
		elif global[0] == 14:
			global[0] = 0
			Event fn[0,11]
		elif global[0] == 9:
			global[0] = 0
			Event fn[0,13]
	if system[0] == 129 && flag[518] && !flag[519]:
		Event fn[0,15]
	elif system[0] == 109 && flag[515] && !flag[518]:
		Event fn[0,14]
	Return

