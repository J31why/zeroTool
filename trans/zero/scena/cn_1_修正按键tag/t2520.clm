		一般是體驗不到的呢。{wait}
	}
	TextWait
	TextTalk name[1] {
		#6P#0109F嗯……
		這次演習也給了我們很多啟發。{wait}
	}
	TextWait
	if QuestTaskGet quest[15] 3:
		QuestBonusBp quest[15] 3
		TextTalk name[3] {
			#6P#0309F能打贏現役警備隊員
			真的很痛快啊。{wait}
		}
		TextWait
		TextTalk name[2] {
			#6P#0203F你不是很囂張地
			說要給人家當陪練嗎，
			要是輸了豈不是很沒面子。{wait}
		} {
			#0200F取勝之後，
			蘭迪前輩不是也可以安心了嗎？{wait}
		}
		TextWait
	elif QuestTaskGet quest[15] 2:
		QuestBonusBp quest[15] 1
		TextTalk name[3] {
			#6P#0309F能打贏現役警備隊員
			真的很痛快啊。{wait}
		}
		TextWait
		TextTalk name[2] {
			#6P#0203F不過，在諾艾兒小姐
			指揮時確實是輸了。{wait}
		} {
			#0200F平時總是擺出一副老資格的
			蘭迪前輩也覺得很丟人吧？{wait}
		}
		TextWait
	else:
		TextTalk name[3] {
			#6P#0300F竟然被現役警備隊員打敗了，
			這讓我有點接受不了啊。{wait}
		}
		TextWait
		TextTalk name[2] {
			#6P#0203F因為你很囂張地
			說要給人家當陪練，
			結果卻輸了呢。{wait}
		} {
			#0200F今晚蘭迪前輩一定會
			一個人孤寂地哭濕枕頭吧。{wait}
		}
		TextWait
	TextTalk name[3] {
		#6P#0306F小緹，妳啊……{wait}
	}
	TextWait
	TextTalk char[0] {
		#5P#0509F啊、啊哈哈……
		前輩被說得啞口無言了呢。{wait}
	}
	TextWait
	TextTalk char[1] {
		#11P#2004F呵呵……{wait}
	} {
		#2000F你們也
		繼續努力吧。{wait}
	} {
		我們需要幫助時，
		會向你們提出支援請求的。{wait}
	} {
		對於特務支援課的活動，
		我們會在心裡默默為你們加油的。{wait}
	}
	TextWait
	TextTalk name[0] {
		#6P#0000F……是，十分感謝！{wait}
	}
	TextWait
	FadeOut 300ms 0x00000000 100
	SoundPlay sound[9] 0 100 0
	TextSetPos -1 -1 -1 -1
	TextSetName ""
	TextMessage null {
		{color 2}任務【關於參加警備隊演習的請求】{color 0}完成！{wait}
	}
	TextWait
	TextClose 0
	FadeIn 300ms 0x00000000
	TextSetPos -1 280 60 3
	FadeOut 1000ms 0x00000000 255
	FadeWait
	CharSetPos field_party[0] (3000, 0, 0) 90deg
	CharSetPos field_party[1] (3000, 0, 0) 90deg
	CharSetPos field_party[2] (3000, 0, 0) 90deg
	CharSetPos field_party[3] (3000, 0, 0) 90deg
	CamSetDistance 3000 900 0 0ms
	ED7CamRotate 45deg 25deg 0deg 0ms
	CamPers 350 0ms
	CamZoom 25500 0ms
	CharTurnTo char[0] 270deg 0deg/s
	_Char4B char[0] 255
