fn[10]:
	TextStart self
	TextTalk self {
		幸好貝爾達因醫生在這裡。
		只有護理師的話，
		實在無法讓患者安心呢。{wait}
	}
	TextWait
	TextTalk self {
		雖然很想去其它病房
		確認一下狀況……
		但現在也只能忍一忍了。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[11]:
	TextStart self
	if !flag[1]:
		TextTalk self {
			在事態徹底平息之前，
			我還是專心安撫患者們吧。{wait}
		}
		TextWait
		TextTalk self {
			你們也要小心啊。{wait}
		}
		TextWait
		FlagSet flag[1]
	else:
		CharTurnToChar self char[13] 0deg/s
		TextTalk self {
			……好啦，冷靜一點，放鬆放鬆。
			再亂動的話，縫合的傷口就該裂開了哦。{wait}
		}
		TextWait
		TextTalk self {
			別擔心，只要在這裡安靜等待，應該是很安全的。{wait}
		}
		TextWait
	TextEnd self
	Return

