fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharIdle self (-1290, null, 53230) (1240, null, 55710) 1000mm/s
		Sleep 400ms
	Return

fn[2]:
	ForkFunc char[4] fork[0] fn[0,1]
	if system[0] == 105 && flag[1804] && !flag[1810]:
		Event fn[0,20]
	elif system[0] == 102 && flag[1804] && !flag[1808]:
		Event fn[0,17]
	elif flag[1804] && !flag[1807]:
		Event fn[0,15]
	Return

fn[3]:
	char[6].51 = 1000
	char[7].51 = 1000
	char[8].51 = 1000
	char[11].51 = 1000
	char[12].51 = 1000
	char[13].51 = 2000
	ED7_76_0 object[255] "BED04" 1
	ED7_76_0 object[255] "BED06" 1
	if flag[1807] && !flag[1822]:
		Call fn[0,16]
	if flag[1809] && !flag[1822]:
		Call fn[0,19]
	TriggerFlagsSet trigger[0] 0x0080
	if flag[1804] && !flag[1809]:
		TriggerFlagsUnset trigger[0] 0x0080
	ObjFlagsUnset object[0] 0x0010
	Return

fn[4]:
	TextStart self
	TextSetName ""
	TextMessage null {
		{color 5}黑手黨成員失去了意識。{color 0}{wait}
	}
	TextWait
	TextClose 0
	_59
	TextEnd self
	Return

fn[5]:
	TextStart self
	TextTalk self {
		我們為了避免患者們
		受到不良影響，
		所以都聚集在這裡。{wait}
	}
	TextWait
	TextTalk self {
		警察弟弟，各位，
		請救救醫院裡的人！{wait}
	}
	TextWait
	TextEnd self
	Return

fn[6]:
	TextStart self
	if !flag[0]:
		TextTalk self {
			嗯、嗯嗯……
			在這種時候，精神上的力量
			要比醫療技術更加強大。{wait}
		}
		TextWait
		TextTalk self {
			為了讓患者們安心，
			我們必須要努力露出笑臉……{wait}
		}
		TextWait
		FlagSet flag[0]
	else:
		TextTalk self {
			必須要冷靜……必須要冷靜……
			必須要冷靜……必須要冷靜……{wait}
		}
		TextWait
		TextTalk self {
			……啊，不行！
			越是這麼想，
			就越平靜不下來……！{wait}
		}
		TextWait
	TextEnd self
	Return

fn[7]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	TextTalk self {
		雖然早就到了
		睡覺時間……
		但卻清醒得很……{wait}
	}
	TextWait
	CharSetChipPattern self 0
	TextEnd self
	Return

