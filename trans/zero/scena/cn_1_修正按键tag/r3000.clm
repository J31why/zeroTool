fn[0]:
	while 1:
		if !flag[1489]:
			if random % 100 < 50:
				Sleep 20000ms
			else:
				Sleep 40000ms
			FlagSet flag[1489]
			MapColor 0x00B4B4B4 3000ms
			Sleep 2000ms
			EffPlay eff[0] eff_instance[0] null 0 (0, 0, 0) 0 0 0 1000 1000 1000 null (0, 0, 0) 0ms
		else:
			MapColor 0x00B4B4B4 0ms
			EffPlay eff[0] eff_instance[0] null 0 (0, 0, 0) 0 0 0 1000 1000 1000 null (0, 0, 0) 1000ms
		SoundPlay sound[131] 1 100 0
		Sleep 10000ms
		Sleep 10000ms
		Sleep 10000ms
		Sleep 10000ms
		MapColor 0x00FFFFFF 3000ms
		EffStop eff_instance[0] 2
		Sleep 1000ms
		SoundStop sound[131]
		FlagUnset flag[1489]
	Return

fn[1]:
	if QuestTaskGet quest[31] 0 && !QuestTaskGet quest[31] 1:
		SystemFlagsSet 0x10000000
		Event fn[0,8]
	Return

