fn[15]:
	TextStart self
	if QuestFlagsGet quest[29] 0x10:
		if !flag[1474]:
			TextTalk self {
				事情我聽說了。
				你們似乎順利解決了呢！{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F嗯，算是吧……{wait}
			}
			TextWait
			TextTalk name[2] {
				#0200F雖然事態的發展
				有點出乎意料。{wait}
			}
			TextWait
			TextTalk self {
				哈哈，說得是啊。
				伊莉雅總是強人所難……{wait}
			}
			TextWait
			TextTalk self {
				對了，拉莉夏
				加入劇團的時候也是……
				（絮絮叨叨）……{wait}
			}
			TextWait
			TextTalk name[3] {
				#0305F哎呀，已經進入
				回憶模式了啊。{wait}
			}
			TextWait
			TextTalk name[1] {
				#0100F伊莉雅小姐似乎總是讓
				劇團長很頭痛呢。{wait}
			}
			TextWait
			FlagSet flag[1474]
		else:
			TextTalk self {
				總、總而言之，謝謝你們了。
				這樣就能放心地
				舉行公演了。{wait}
			}
			TextWait
			TextTalk self {
				必須要向你們道謝才是……
				稍後再送你們一張票如何？{wait}
			}
			TextWait
			TextTalk name[3] {
				#0309F那可太令人高興了。
				我就感恩戴德地收下了！{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F哈哈哈……{wait}
			}
			TextWait
	TextEnd self
	Return

