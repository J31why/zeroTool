fn[7]:
	_Char4A char[0] 255
	_Char4A char[1] 255
	_Char4A char[4] 255
	TextTalk char[4] {
		哈哈，真沒想到
		莉夏能做得這麼好啊。{wait}
	}
	TextWait
	TextTalk char[0] {
		#1709F是啊，今天的表演
		是至今以來最好的一次。{wait}
	} {
		#1702F呵呵，雖說也是因為
		全體成員的演技都日漸純熟……{wait}
	} {
		不過，莉夏好像也漸漸掌握了
		公演的節奏吧？{wait}
	}
	TextWait
	TextTalk char[1] {
		#1809F啊哈哈……一天演出兩場，
		比預想中還要辛苦……{wait}
	} {
		#1802F不過，剛才的演出，
		感覺十分暢快呢。
		從中途開始，身體就變得好輕盈……{wait}
	}
	TextWait
	TextTalk char[0] {
		#1709F對對，就是這樣。
		要好好珍惜這種感覺哦！{wait}
	}
	TextWait
	if flag[1297]:
		TextTalk name[95] {
			#3305F（這就是伊莉雅・普拉提耶……？
			　嗯～感覺好像很普通啊。）{wait}
		}
		TextWait
		TextTalk name[0] {
			#0012F（感覺普通嗎……）{wait}
		} {
			#0000F（伊莉雅小姐可是『天才』哦。
			　只不過，好像僅限於舞臺之上呢。）{wait}
		}
		TextWait
		TextTalk name[95] {
			#3304F（嘻嘻……原來如此。
			　那可真是有趣的『天才』啊。）{wait}
		} {
			#3302F（那位看起來像東方人的姊姊
			　似乎也有點意思……）{wait}
		} {
			（蕾恩要不要也來看一次
			　彩虹劇團的演出呢。）{wait}
		}
		TextWait
	FlagSet flag[2]
	_Char4B char[0] 255
	_Char4B char[1] 255
	_Char4B char[4] 255
	Return

fn[8]:
	TextStart self
	if flag[1428]:
		if flag[2]:
			_Char4A char[0] 255
			_Char4A char[1] 255
			_Char4A char[4] 255
			TextTalk char[1] {
				#1810F紀念慶典到明天就是最終日了吧。{wait}
			} {
				#1804F……好吧。
				要調整好狀態，努力表演才行……{wait}
			}
			TextWait
			TextTalk name[0] {
