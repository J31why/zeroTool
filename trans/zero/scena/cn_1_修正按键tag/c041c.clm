fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if flag[1294] && !flag[1295]:
		SystemFlagsSet 0x10000000
		Event fn[0,20]
	if flag[1307] && !flag[1482]:
		Event fn[0,19]
	elif flag[1294]:
	elif flag[1362] && !flag[1481]:
		Event fn[0,18]
	elif flag[1292] && !flag[1480]:
		Event fn[0,17]
	elif flag[1282]:
		if QuestFlagsGet quest[29] 0x10:
			CharSetPos char[2] (-3460, 0, 2440) 0deg
			CharFlagsUnset char[9] 0x0080
	elif !flag[1479]:
		Event fn[0,16]
	if flag[1294]:
		CharFlagsUnset char[0] 0x0080
		CharFlagsUnset char[1] 0x0080
		CharFlagsUnset char[4] 0x0080
		CharFlagsUnset char[5] 0x0080
		CharFlagsUnset char[6] 0x0080
		CharFlagsUnset char[7] 0x0080
		CharSetPos char[8] (-90300, 0, 4960) 270deg
		if flag[1428]:
			CharFlagsSet char[1] 0x0010
	Return

fn[2]:
	EntranceSetFunc entrance[3] fn[255,65535]
	TriggerFlagsSet trigger[0] 0x0080
	if flag[1282] && !flag[1294]:
		TriggerFlagsUnset trigger[0] 0x0080
		EntranceSetFunc entrance[3] fn[0,24]
	Return

fn[3]:
	TextStart self
	if flag[1294]:
		if flag[0]:
			TextTalk char[2] {
				看起來，似乎
				不在劇場內……{wait}
			}
			TextWait
			TextTalk char[2] {
				如果發現他的話，
				我會立即聯絡警察的。{wait}
			}
			TextWait
		else:
			TextTalk char[2] {
				羅伊德警官，事情我聽說了。
				你們好像在尋找一個小男孩吧。{wait}
			}
			TextWait
			TextTalk char[2] {
				看起來，似乎
				不在劇場內……{wait}
			}
			TextWait
			TextTalk char[2] {
				不過請放心。
				如果發現他的話，
				我會立即聯絡警察的。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif QuestFlagsGet quest[29] 0x10:
		if !flag[0]:
			TextTalk self {
				原以為是跟蹤狂的犯人，
				竟然是個年輕的少女嗎……{wait}
			}
			TextWait
			TextTalk self {
				總之，現在正依照伊莉雅小姐的要求
				辦理接收手續。{wait}
			}
			TextWait
			TextTalk self {
				這沒什麼，只要伊莉雅小姐開口，
				入團也不是什麼問題吧。{wait}
			}
			TextWait
			TextTalk self {
				那位莉夏小姐
				也是這樣的。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				莉夏小姐原本
				也是被伊莉雅小姐硬拉進來的呢。{wait}
			}
			TextWait
			TextTalk self {
				劇團長一開始
				也不太同意，
				不過她確實擁有出色的才能。{wait}
			}
			TextWait
			TextTalk self {
				伊莉雅小姐的眼光是不會出錯的。
				我當然是熱烈歡迎了。{wait}
			}
			TextWait
	elif QuestTaskGet quest[29] 0:
		if !flag[0]:
			TextTalk self {
				事情我聽說了……{wait}
			}
			TextWait
			TextTalk self {
				沒錯，這次有跟蹤狂
				盯上了伊莉雅小姐……{wait}
			}
			TextWait
			TextTalk self {
				呼，還請各位
				多多幫忙啊。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				還請各位
				多多幫忙啊。{wait}
			}
			TextWait
	else:
		TextTalk char[2] {
			呀……是各位啊，
			歡迎光臨。{wait}
		}
		TextWait
		TextTalk char[2] {
			找伊莉雅小姐有事嗎？
			她和劇團長，還有莉夏小姐
			都在舞臺那邊呢。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[4]:
	Call fn[0,5]
	Return

fn[5]:
	TextStart char[3]
	if flag[1294]:
		if flag[1]:
			TextTalk char[3] {
				各位在找的小男孩
				似乎不在劇場內。{wait}
			}
			TextWait
			TextTalk char[3] {
				等晚上的公演開始之後，
				我也多留意一下吧。{wait}
			}
			TextWait
		else:
			TextTalk char[3] {
				經過接待處的客人，
				我基本都會看到……{wait}
			}
			TextWait
			TextTalk char[3] {
				不過，好像所有的孩子
				都有監護人同行。{wait}
			}
			TextWait
			TextTalk char[3] {
				幫不上忙，實在抱歉。{wait}
			}
			TextWait
			FlagSet flag[1]
	elif QuestFlagsGet quest[29] 0x10:
		TextTalk char[3] {
			哦，我不是
			太清楚……
			是有新團員要加入了嗎？{wait}
		}
		TextWait
		TextTalk char[3] {
			伊莉雅小姐看中的人，
			一定是相當厲害的天才吧。
			真期待呢。{wait}
		}
		TextWait
	elif flag[1]:
		TextTalk char[3] {
			如此說來，昨晚的公演結束後，
			伊莉雅小姐和莉夏小姐還有劇團長
			長談了很久……{wait}
		}
		TextWait
		TextTalk char[3] {
			不知道在說什麼呢。{wait}
		}
		TextWait
	else:
		TextTalk char[3] {
			本日是彩虹劇團的
			休演日。{wait}
		}
		TextWait
		TextTalk char[3] {
			不過……
			伊莉雅小姐和莉夏小姐
			都來劇團了哦。{wait}
		}
		TextWait
		TextTalk char[3] {
			她們兩人都很熱衷於排練呢。{wait}
		}
		TextWait
		FlagSet flag[1]
	TextEnd char[3]
	Return

fn[6]:
	TextStart self
	if flag[2]:
		_Char4A char[0] 255
		_Char4A char[1] 255
		_Char4A char[4] 255
		TextTalk char[0] {
			#1700F莉夏似乎也已經習慣了
			公演的節奏呢。{wait}
		} {
			#1709F嗯嗯，感覺不錯。
			今天剩下的部分也要加油哦～！{wait}
		}
		TextWait
		_Char4B char[0] 255
		_Char4B char[1] 255
		_Char4B char[4] 255
	else:
		Call fn[0,7]
	TextEnd self
