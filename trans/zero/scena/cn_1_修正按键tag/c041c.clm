fn[13]:
	TextStart self
	if flag[5]:
		TextTalk char[7] {
			竟然會被伊莉雅小姐表揚……
			好、好開心哦……{wait}
		}
		TextWait
		TextTalk char[7] {
			…………………………㈱{wait}
		}
		TextWait
	else:
		TextTalk char[7] {
