		} {
			那個小男孩
			還沒有找到嗎？{wait}
		}
		TextWait
		if flag[1298]:
			TextTalk name[0] {
				#0006F嗯，現在還沒……{wait}
			} {
				#0000F不過已經有了目擊情報，
				我想很快就能找到的。
				請不用太擔心。{wait}
			}
			TextWait
		else:
			TextTalk name[0] {
				#0006F嗯，現在還沒……{wait}
			} {
				#0000F不過，搜尋才剛剛開始呢，
				不用太擔心啦。{wait}
			}
			TextWait
		TextTalk char[1] {
			#1806F……好的。{wait}
		} {
			#1810F不好意思，
			要是我沒有演出的話，
			就可以幫忙了。{wait}
		}
		TextWait
		CharTurnTo char[1] 225deg 0deg/s
		CharFlagsSet char[1] 0x0010
		FlagSet flag[1428]
	TextEnd self
	Return

