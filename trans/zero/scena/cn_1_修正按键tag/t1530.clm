	pos (65800, 0, 2430)
	radius 1200
	bubble_pos (65800, 1500, 2430)
	unk1 124
	unk2 0
	function fn[0,17]
	unk3 0
	unk4 0

fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		ED7CharAnimation self 1200ms
	Return

fn[2]:
	while 1:
		CharWalkToPos self (7400, 0, -1600) 1500mm/s 0
		CharWalkToPos self (7400, 0, 1420) 1500mm/s 0
		CharWalkToPos self (10380, 0, 4530) 1500mm/s 0
		CharWalkToPos self (13330, 0, 4550) 1500mm/s 0
		CharWalkToPos self (16420, 0, 1470) 1500mm/s 0
		CharWalkToPos self (16420, 0, -1430) 1500mm/s 0
		CharWalkToPos self (13440, 0, -4490) 1500mm/s 0
		CharWalkToPos self (10540, 0, -4490) 1500mm/s 0
	Return

fn[3]:
	while 1:
		CharIdle self (6450, null, 5260) (7610, null, 3530) 1000mm/s
		Sleep 400ms
	Return

fn[4]:
	while 1:
		CharIdle self (9940, null, 3020) (13550, null, 9050) 1000mm/s
		Sleep 300ms
	Return

fn[5]:
	if system[0] == 102 && flag[761]:
		FlagUnset flag[761]
		Call fn[0,6]
	if flag[1566]:
		CharSetPos char[2] (16050, 0, -5480) 180deg
		CharFlagsUnset char[3] 0x0080
		CharFlagsUnset char[13] 0x0080
		CharSetPos char[13] (56790, 0, 5200) 180deg
		CharFlagsUnset char[6] 0x0080
		CharFlagsUnset char[8] 0x0080
		CharSetPos char[8] (57420, 0, -56730) 180deg
