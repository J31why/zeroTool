fn[0]:
	Return

fn[1]:
	if flag[1954]:
		ObjFrame object[13] 30
	else:
		ObjFrame object[13] 0
	if flag[1955]:
		ObjFrame object[14] 30
	else:
		ObjFrame object[14] 0
	if flag[1954] && flag[1955]:
		ObjFrame object[12] 98
		ObjFlagsUnset object[12] 0x0002
	elif !flag[1954] && !flag[1955]:
		ObjFrame object[12] 0
		ObjFlagsSet object[12] 0x0002
	else:
		ObjFrame object[12] 50
		ObjFlagsSet object[12] 0x0002
	if system[0] == 108 | system[0] == 109 | system[0] == 110 | system[0] == 111:
		SoundPlay sound[129] 1 100 0
	else:
		SoundStop sound[129]
	Return

fn[2]:
	ED7_F2 2
	FadeOut 300ms 0x00000000 100
	TextMessage name[742] {
		{color 5}設有可回復導力器的裝置。{color 0}{wait}
	}
	Menu menu[0] -1 -1 1
		"在此地休息" // 0
		"放棄" // 1
	MenuWait var[0]
	MenuClose menu[0]
	TextClose 0
	if var[0] == 0:
		FadeIn 100ms 0x00000000
		Sleep 500ms
		SoundLoad sound[13]
		ED7_74 object[15] 0 30
		SoundPlay sound[7] 0 100 0
		ObjFrame object[15] 0
		ED7ObjPlay object[15] 0 30 0 0
		ObjWait object[15]
		ED7ObjPlay object[15] 31 390 0 32
		Sleep 1000ms
		BgmStop 3000ms
		FadeOut 1000ms 0x00000000 255
		Sleep 700ms
		SoundPlay sound[13] 0 100 0
		FadeWait
		PartySetAttr name[255] 254 0
		CamLookChar field_party[0] 0ms
		ED7_31 1
		Sleep 3500ms
		ObjFrame object[15] 0
		BgmResume
		FadeIn 1000ms 0x00000000
		TextClose 0
		TextEnd null
		Return
	elif var[0] != 0:
		FadeIn 300ms 0x00000000
		TextEnd null
		Return
	Return
	Return

fn[3]:
	SystemFlagsSet 0x08000000
	if flag[1954]:
		TextStart null
		TextSetName ""
		TextMessage null {
			{color 5}拉杆好像已經不能動了。{wait}
		}
		TextWait
		TextClose 0
		_59
		SystemFlagsUnset 0x08000000
		TextEnd null
	else:
		EventBegin 1
		TextMessage null {
			{color 5}有一個拉杆。
			扳動它嗎？{wait}
		}
		Menu menu[0] -1 -1 1
			"是" // 0
			"否" // 1
		MenuWait var[0]
		MenuClose menu[0]
		TextClose 0
		_59
		if var[0] == 0:
			CrossFade 500ms
			CharSetPos field_party[0] (-177540, -125000, 7320) 89deg
			CharSetPos field_party[1] (-179090, -125000, 8210) 89deg
			CharSetPos field_party[2] (-179330, -125000, 5940) 89deg
			CharSetPos field_party[3] (-180460, -125000, 6800) 89deg
			CamSetDistance -176830 -124000 7360 0ms
			ED7CamRotate 45deg 25deg 0deg 0ms
			CamPers 340 0ms
			CamZoom 30000 0ms
			FadeWait
			SoundPlay sound[143] 0 100 0
			ED7ObjPlay object[13] 0 30 0 0
			ObjWait object[13]
			Sleep 500ms
			FlagSet flag[1954]
			Call fn[0,5]
		SystemFlagsUnset 0x08000000
		EventEnd 5
	Return

