fn[14]:
	TextStart self
	if flag[1]:
		TextTalk char[7] {
			咳、咳咳……
			不要告訴
			我太太哦。{wait}
		}
		TextWait
	else:
		Call fn[0,8]
	TextEnd self
	Return

