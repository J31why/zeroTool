fn[62]:
	if flag[1550] && !flag[1552]:
		TextTalk name[0] {
			#0001F岡茲先生似乎
			就住在這附近的
			高級飯店裡……{wait}
		} {
			現在還是先去那邊看看吧。{wait}
		}
		TextWait
	if flag[1552] && !flag[1554]:
		TextTalk name[0] {
			#0000F太陽都下山了啊……{wait}
		} {
			琪雅還在等我們，
			就不要繞道了，趕快回去吧。{wait}
		}
		TextWait
		if system[10] == 1:
			TextTalk name[1] {
				#0100F是呀，工作
				差不多也告一段落了。{wait}
			}
			TextWait
		elif system[10] == 2:
			TextTalk name[2] {
				#0200F是啊，回去吧。{wait}
			}
			TextWait
		elif system[10] == 3:
			TextTalk name[3] {
				#0300F是啊，趕緊回去，
				看看小琪的小臉吧。{wait}
			}
			TextWait
	Return
