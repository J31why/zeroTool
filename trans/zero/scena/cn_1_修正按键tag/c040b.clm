fn[4]:
	if system[0] == 107:
		if global[7] == 4 | global[7] == 5 | global[7] == 11:
			CharSetPos field_party[0] (21040, 0, 11840) 270deg
			CharSetPos field_party[1] (21040, 0, 11840) 270deg
			CharSetPos field_party[2] (21040, 0, 11840) 270deg
			CharSetPos field_party[3] (21040, 0, 11840) 270deg
			if system[15] != 255:
				CharSetPos field_party[4] (21040, 0, 11840) 270deg
				CharSetPos field_party[5] (21040, 0, 11840) 270deg
			elif system[14] != 255:
				CharSetPos field_party[4] (21040, 0, 11840) 270deg
		elif global[7] == 2 | global[7] == 7:
			CharSetPos field_party[0] (-39280, 0, 12420) 90deg
			CharSetPos field_party[1] (-39280, 0, 12420) 90deg
			CharSetPos field_party[2] (-39280, 0, 12420) 90deg
			CharSetPos field_party[3] (-39280, 0, 12420) 90deg
			if system[15] != 255:
				CharSetPos field_party[4] (-39280, 0, 12420) 90deg
				CharSetPos field_party[5] (-39280, 0, 12420) 90deg
			elif system[14] != 255:
				CharSetPos field_party[4] (-39280, 0, 12420) 90deg
		else:
			CharSetPos field_party[0] (13270, 0, -19100) 315deg
			CharSetPos field_party[1] (13270, 0, -19100) 315deg
			CharSetPos field_party[2] (13270, 0, -19100) 315deg
			CharSetPos field_party[3] (13270, 0, -19100) 315deg
			if system[15] != 255:
				CharSetPos field_party[4] (13270, 0, -19100) 315deg
				CharSetPos field_party[5] (13270, 0, -19100) 315deg
			elif system[14] != 255:
				CharSetPos field_party[4] (13270, 0, -19100) 315deg
	global[7] = 6
	if flag[1550] && !flag[1551]:
		Event fn[0,43]
	if flag[736]:
		FlagUnset flag[736]
		Event fn[0,36]
	elif flag[737]:
		FlagUnset flag[737]
		Event fn[0,42]
	elif flag[738]:
		FlagUnset flag[738]
		Event fn[0,44]
	if flag[1]:
		CharFlagsUnset char[1] 0x0010
		CharFlagsUnset char[7] 0x0010
	Return

fn[5]:
	if flag[1060]:
		ED7_76_0 object[255] "ka01" 1
		ED7_76_1 object[255] "ka02" 1
	else:
		ED7_76_1 object[255] "ka01" 1
		ED7_76_0 object[255] "ka02" 1
	TriggerFlagsSet trigger[0] 0x0080
	if flag[1550] && !flag[1552]:
		TriggerFlagsUnset trigger[0] 0x0080
	EntranceSetFunc entrance[1] fn[255,65535]
	EntranceSetFunc entrance[2] fn[255,65535]
	if flag[1550] && !flag[1554]:
		EntranceSetFunc entrance[1] fn[0,59]
		EntranceSetFunc entrance[2] fn[0,60]
	EntranceSetFunc entrance[0] fn[255,65535]
	if flag[1550] && !flag[1552]:
		EntranceSetFunc entrance[0] fn[0,61]
	Return

fn[6]:
	TextStart self
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"對話" // 0
			"購物" // 1
			"放棄" // 2
		MenuWait var[0]
		if var[0] != 1:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			ShopOpen shop[126]
			var[0] = 99
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			if flag[0]:
				TextTalk char[0] {
					做生意真辛苦啊～
					這就是所謂的命運嗎～{wait}
				}
				TextWait
			else:
				TextTalk char[0] {
					夜晚的克洛斯貝爾真美啊～{wait}
				}
				TextWait
				TextTalk char[0] {
					要是我不用做生意的話，
					就可以到處去玩了～{wait}
				}
				TextWait
				FlagSet flag[0]
	TextEnd self
	Return

fn[7]:
	TextStart self
	if flag[1]:
		TextTalk self {
			啊，你們也是出來玩的嗎？
			在我們這裡可以喝到美酒哦。{wait}
		}
		TextWait
		TextTalk self {
			嘿嘿，四個人的話，
			還可以打個團體折呢。
			怎麼樣？考慮考慮吧！{wait}
		}
		TextWait
	else:
		Call fn[0,8]
	TextEnd self
	Return

fn[8]:
	_Char4A char[1] 255
	_Char4A char[7] 255
	TextTalk char[7] {
		真、真的沒問題嗎？{wait}
	}
	TextWait
	TextTalk char[7] {
		那個，雖然我有點興趣，
		不過好像有點可怕呢……{wait}
	}
	TextWait
	TextTalk char[1] {
		啊哈哈哈哈哈哈……！{wait}
	}
	TextWait
	TextTalk char[1] {
		沒關係啦，
		我可不是什麼壞人。{wait}
	}
	TextWait
	CharFlagsUnset char[1] 0x0010
	CharFlagsUnset char[7] 0x0010
	FlagSet flag[1]
	_Char4B char[1] 255
	_Char4B char[7] 255
	Return

fn[9]:
	TextStart self
	TextTalk char[2] {
		呀，就快到公演時間了呢！
		心跳得好厲害哦～！{wait}
	}
	TextWait
	TextEnd self
	Return

fn[10]:
	TextStart self
	TextTalk char[3] {
		夜晚的歡樂街真令人緊張興奮啊……{wait}
	}
	TextWait
	TextTalk char[3] {
		可惡，要是有票的話，
		就可以盡情欣賞
		彩虹劇團的舞臺表演了……{wait}
	}
	TextWait
