	TextTalkNamed char[5] "穿西裝的巨漢" {
		#12100007V#5P#3100F──法比奧，莫蘭。{wait}
	} {
		#12100008V讓你們吃了苦頭的
		也是那些小鬼嗎……？{wait}
	}
