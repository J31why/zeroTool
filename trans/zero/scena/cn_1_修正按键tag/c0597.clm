	}
	TextWait
	TextTalkNamed char[5] "穿西裝的巨漢" {
		#12100006V#11P#3103F哼……
		是叫『特務支援課』嗎？{wait}
	}
	TextWait
	CharTurnTo char[5] 225deg 500deg/s
