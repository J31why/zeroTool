	TextSetName "穿西裝的巨漢"
	TextMessage null {
		#12100002V為了把你們保釋出來，
		你們知道我一共花了多少米拉嗎……{wait}
	} {
		#12100003V想疏通那群議員們，
		代價可不小啊……{wait}
	}
