fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		ED7CharAnimation self 1000ms 0 1 2 3 4 3 2 1
	Return

fn[2]:
	while 1:
		ED7CharAnimation self 1500ms 0 1 2 3 4
	Return

fn[3]:
	if system[0] == 102 && flag[1585] && !flag[1586]:
		Event fn[0,15]
	if flag[736]:
		FlagUnset flag[736]
		Event fn[0,11]
	elif flag[737]:
		FlagUnset flag[737]
		Event fn[0,12]
	elif flag[738]:
		FlagUnset flag[738]
		Event fn[0,14]
	Return

fn[4]:
	if flag[760]:
		system[1] = 0
		FlagUnset flag[760]
	TriggerFlagsSet trigger[0] 0x0080
	if flag[1584] && !flag[1585]:
		TriggerFlagsUnset trigger[0] 0x0080
	LookPointFlagsSet look_point[0] 0x0001
	LookPointFlagsSet look_point[1] 0x0001
	if flag[1586] && !flag[1792]:
		LookPointFlagsUnset look_point[0] 0x0001
		LookPointFlagsUnset look_point[1] 0x0001
	if flag[1792]:
		ObjFrame object[17] 10
	ObjFlagsSet object[19] 0x0004
	if flag[1792]:
		LookPointFlagsSet look_point[3] 0x0001
		ObjFlagsSet object[16] 0x0010
	else:
		LookPointFlagsUnset look_point[3] 0x0001
		ObjFlagsUnset object[16] 0x0010
	EntranceSetFunc entrance[2] fn[255,65535]
	if flag[1586] && !flag[1792]:
		EntranceSetFunc entrance[2] fn[0,21]
	Return

fn[5]:
	ED7_F2 2
	FadeOut 300ms 0x00000000 100
	TextMessage name[742] {
		{color 5}設有可回復導力器的裝置。{color 0}{wait}
	}
	Menu menu[0] -1 -1 1
		"在此地休息" // 0
		"放棄" // 1
	MenuWait var[0]
	MenuClose menu[0]
	TextClose 0
	if var[0] == 0:
		FadeIn 100ms 0x00000000
		Sleep 500ms
		SoundLoad sound[13]
		ED7_74 object[18] 0 30
		SoundPlay sound[7] 0 100 0
		ObjFrame object[18] 0
		ED7ObjPlay object[18] 0 30 0 0
		ObjWait object[18]
		ED7ObjPlay object[18] 31 390 0 32
		Sleep 1000ms
		BgmStop 3000ms
		FadeOut 1000ms 0x00000000 255
		Sleep 700ms
		SoundPlay sound[13] 0 100 0
		FadeWait
		PartySetAttr name[255] 254 0
		CamLookChar field_party[0] 0ms
		ED7_31 1
		Sleep 3500ms
		ObjFrame object[18] 0
		BgmResume
		FadeIn 1000ms 0x00000000
		TextClose 0
		TextEnd null
		Return
	elif var[0] != 0:
		FadeIn 300ms 0x00000000
		TextEnd null
		Return
	Return
	Return

fn[6]:
	EventBegin 0
	CrossFade 1000ms
	CamSetDistance 0 1000 116100 0ms
	ED7CamRotate 45deg 26deg 0deg 0ms
	CamPers 440 0ms
	CamZoom 21500 0ms
	CharSetPos name[0] (0, 0, 115100) 0deg
	FadeWait
	SoundPlay sound[810] 0 100 0
	TextSetName ""
	TextMessage null {
		{color 5}寶箱被牢牢鎖了起來。{color 0}{wait}
	}
	TextWait
	TextClose 0
	_59
	if flag[1588] && !flag[1792]:
		FadeOut 300ms 0x00000000 100
		FadeWait
		Menu menu[0] -1 -1 0
			"使用寶箱鑰匙" // 0
			"放棄" // 1
		MenuWait var[0]
		MenuClose menu[0]
		FadeIn 300ms 0x00000000
		FadeWait
		switch var[0]:
			case 0:
				Call fn[0,19]
				break
			case 1:
				CharSetPos field_party[0] (0, 0, 114700) 180deg
				EventEnd 5
				break
	else:
		if flag[4]:
			TextTalk name[0] {
				#14300435V#0001F#11P（需要鑰匙才能打開啊……
				　先調查一下房間吧。）{wait}
			}
			TextWait
		else:
			TextTalk name[0] {
				#14300433V#0003F#11P（看來很難用
				　開鎖道具打開呢。）{wait}
			} {
				#14300434V#0000F（既然如此……
				　就在房間中找一找鑰匙吧。）{wait}
			}
			TextWait
			FlagSet flag[4]
		TextClose 0
		_59
		CharSetPos field_party[0] (0, 0, 114700) 180deg
		FlagSet flag[1587]
		EventEnd 5
	Return

fn[7]:
	TextStart self
	if flag[0]:
		TextTalk self {
			#14300426V#0306F從萊恩福爾特到烏爾努，
			買的都是最新型的武器啊……{wait}
		} {
			#14300427V#0301F這傢伙到底擁有
			多少財產啊。{wait}
		}
		TextWait
		FlagUnset flag[0]
	else:
		TextTalk self {
			#14300423V#0308F這裡有關於武器
			走私管道的文件……{wait}
		} {
			#14300424V#0303F連我所知道的管道，
			也基本都網羅在其中了……{wait}
		} {
			#14300425V#0300F應該都是加爾西亞大叔
			在獵兵時期累積下的人脈吧。{wait}
		}
		TextWait
		FlagSet flag[0]
	TextEnd self
	Return

fn[8]:
	TextStart self
	if flag[1]:
		TextTalk char[11] {
			#14300421V#0105F這邊也有今年的目錄，
			不過業績似乎不怎麼樣呢……{wait}
		} {
			#14300422V#0106F有種奇特的心虛感，
			算了，這也是自作自受啊。{wait}
		}
		TextWait
		FlagUnset flag[1]
	else:
		TextTalk char[11] {
			#14300417V#0108F有那個『黑之拍賣會#10RSchwarz Auction#』的
			目錄清單呢……{wait}
		} {
			#14300418V裡面詳細記錄著商品的進貨管道
			與得標者的情報……{wait}
		} {
			#14300419V#0106F真沒想到，連傳聞被『怪盜Ｂ』
			盜走的那副稀世名畫也在其中……{wait}
		} {
			#14300420V#0101F如果將這份清單公開於世的話，
			周邊諸國恐怕也會陷入巨大的騷亂吧……{wait}
		}
		TextWait
		FlagSet flag[1]
	TextEnd self
	Return

fn[9]:
	TextStart self
	if flag[2]:
		TextTalk char[12] {
			#14300431V#0205F啊，在最近的記錄上，
			似乎還有警察局長和共和國派
			議員的名字呢。{wait}
		} {
			#14300432V#0206F這樣看來，一課會被施加如此大的壓力，
			可以說是理所當然的吧。{wait}
		}
		TextWait
		FlagUnset flag[2]
	else:
		TextTalk char[12] {
			#14300428V#0208F這裡還有向克洛斯貝爾財政界
			人士行賄的詳細記錄呢。{wait}
		} {
			#14300429V#0203F不僅是那位議長先生，
			帝國派議員、局長級的政府官員，
			連警備隊的司令都包括在內嗎……{wait}
		} {
			#14300430V#0211F此外，由於用暴力解決了很多
			糾紛，因此還從不少企業那裡
			收取了大額的謝禮呢。{wait}
		}
		TextWait
		FlagSet flag[2]
	TextEnd self
	Return

fn[10]:
	TextStart self
	if flag[3]:
		TextTalk self {
			#14300415V#0603F這裡記錄的是
			與走私有關的證據……{wait}
		} {
			#14300416V#0610F哼……
			可惡，要是有正式搜查令的話……！{wait}
		}
		TextWait
		FlagUnset flag[3]
	else:
		TextTalk self {
			#14300412V#0608F這些都是和走私
			相關的檔案啊……{wait}
		} {
			#14300413V#0606F雖然我們已經大致摸清狀況了，
			但沒想到規模竟然如此龐大……{wait}
		} {
			#14300414V#0610F哼，要是有正式搜查令的話，
			絕對能判他們個
			一百年監禁……！{wait}
		}
		TextWait
		FlagSet flag[3]
	TextEnd self
	Return

