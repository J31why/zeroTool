calmare zero_k scena
scena:
	name "t1530" "t1530" "t1530_1"
	town town[79]
	bgm bgm[123]
	flags 8192
	item_use fn[0,255]
	unk 255 0

entry:
	pos (0, 0, -1000)
	unk1 0
	cam_from (0, 2500, 34000)
	cam_pers 262
	unk2 30
	cam_deg 45deg
	cam_limit 0deg 360deg
	cam_at (0, 0, 0)
	unk3 0
	unk4 0
	flags 0x0001
	town town[79]
	init fn[0,255]
	reinit fn[0,255]

fn[0]:
	Call fn[1,1]
	Return

fn[1]:
	if flag[783] && !flag[784]:
		Call fn[0,9]
	elif flag[1562] && !flag[1563]:
		Call fn[0,14]
	elif QuestFlagsGet quest[22] 0x02 && !QuestTaskGet quest[22] 0:
		Call fn[1,76]
	else:
		TextStart char[0]
		if flag[1566]:
			if !flag[0]:
				TextTalk char[0] {
					今天早上，黑月貿易公司的諸位
					都自行出院了。{wait}
				}
				TextWait
				TextTalk char[0] {
					明明還沒有痊癒呢，
					只是剛剛能行走，就堅持要……{wait}
				}
				TextWait
				if PartyPosition name[9] != -1:
					TextTalk name[9] {
						#0603F哼……該說不愧是曹的部下嗎，
						看來都經受過相當嚴酷的體能訓練啊。{wait}
					}
					TextWait
				FlagSet flag[0]
			else:
				TextTalk char[0] {
					今天早上，黑月貿易公司的諸位
					都自行出院了。{wait}
				}
				TextWait
				TextTalk char[0] {
					我本來是想阻止的，
					因為他們的槍傷還沒有治好……{wait}
				}
				TextWait
		elif flag[1565]:
			TextTalk char[0] {
				看來你們已經和約亞西姆醫生談過了啊，
				這真是再好不過了。{wait}
			}
			TextWait
			TextTalk char[0] {
				隨時都歡迎諸位再來哦。{wait}
			}
			TextWait
		elif flag[1554]:
			TextTalk char[0] {
				約亞西姆醫生正在研究區四樓的
				研究室裡等候各位。{wait}
			}
			TextWait
			TextTalk char[0] {
				……最好趁他還沒有偷懶出去玩，
				趕快過去找他吧。{wait}
			}
			TextWait
		elif flag[1536]:
			if !flag[1733]:
				TextTalk char[0] {
					歡迎來到聖烏爾斯拉醫院。
					您今天有何貴幹呢？{wait}
				}
				TextWait
				TextTalk name[8] {
					#0500F真是很久都沒來
					烏爾斯拉醫院了啊。{wait}
				} {
					從那場狼型魔獸事件以後，
					最多也就是巡邏時路過這裡而已。{wait}
				}
				TextWait
				TextTalk name[0] {
					#0000F哈哈，這麼說也許有些失禮，
					不過，上士好像從不會生病啊。{wait}
				}
				TextWait
				TextTalk name[8] {
					#0504F嗯，那當然啦。{wait}
				} {
					#0500F自從進了警備隊，
					我就一直很注重保持身體健康，
					儘量讓自己連小病也不要得。{wait}
				}
				TextWait
				TextTalk char[0] {
					呵呵，真厲害啊。
					儘量不要讓自己生病就醫，
					這可比什麼都重要。{wait}
				}
				TextWait
				TextTalk char[0] {
					不過，身體一旦真的出現了什麼問題，
					也還是應該立刻來醫院的。
					因為有些事情，光靠自己是無法解決的。{wait}
				}
				TextWait
				FlagSet flag[1733]
			else:
				TextTalk char[0] {
					調理好自己的身體，保持健康，
					儘量不來醫院，比什麼都重要呢。{wait}
				}
				TextWait
				TextTalk char[0] {
					呵呵，這位警備隊員的健康理念
					是非常正確的。{wait}
				}
				TextWait
		elif flag[1351]:
			Call fn[1,26]
		elif flag[1346]:
			TextTalk char[0] {
				約亞西姆醫生的研究室
				就在研究區的四樓。{wait}
			}
			TextWait
			TextTalk char[0] {
				只要去院區的屋頂，
				就很容易看到研究區的位置了。{wait}
			}
			TextWait
		elif flag[1307]:
			if !flag[0]:
				TextTalk char[0] {
					歡迎光臨烏爾斯拉醫院。{wait}
				}
				TextWait
				TextTalk char[0] {
					各位教授今天都出差
					參加教授會議去了。{wait}
				}
				TextWait
				TextTalk char[0] {
					在確認過主治醫生之後，
					請辦理診察手續。{wait}
				}
				TextWait
				FlagSet flag[0]
			else:
				TextTalk char[0] {
					各位教授今天都出差
					參加教授會議去了。{wait}
				}
				TextWait
				TextTalk char[0] {
					在確認過主治醫生之後，
					請辦理診察手續。{wait}
				}
				TextWait
		elif flag[1292]:
			if !flag[0]:
				TextTalk char[0] {
					今天好像有遊客
					前來接受身體檢查。{wait}
				}
				TextWait
				TextTalk char[0] {
					我雖然也能理解他們很想體驗
					最先進醫療設備的心情……{wait}
				}
				TextWait
				TextTalk char[0] {
					但那樣做的話，就可能會耽誤
					重病患者的檢查。
					總覺得有些不太好呢。{wait}
				}
				TextWait
				FlagSet flag[0]
			else:
				TextTalk char[0] {
					好像有一些遊客前來
					做健康檢查之類的。{wait}
				}
				TextWait
				TextTalk char[0] {
					……既然是外來的客人，
					我們就不能怠慢……
					但一想到他們的動機，心情還是很複雜。{wait}
				}
				TextWait
		elif flag[1282]:
			CharTurnTo char[0] 266deg 0deg/s
			_Char4A char[15] 255
			TextTalk char[0] {
				啊，迪塔總裁……{wait}
			}
			TextWait
			TextTalk char[0] {
				真是十分感謝您
				今年也能光臨本院。{wait}
			}
			TextWait
			TextTalk char[0] {
				患者們一定也會很高興吧。{wait}
			}
			TextWait
			TextTalk char[15] {
				#2804F哪裡的話，別那麼客氣。{wait}
			} {
				這只是我的個人行為而已。{wait}
			}
			TextWait
			_Char4B char[15] 255
		elif flag[1280]:
			if QuestFlagsGet quest[22] 0x10 && !flag[0]:
				TextTalk char[0] {
					聽說賽西兒小姐和其他護理師們
					順利地分配好工作，安排出假期。{wait}
				}
				TextWait
				TextTalk char[0] {
					真是羨慕她們啊。
					事務部門這邊的人手比較少，
					所以幾乎都沒有休假。{wait}
				}
				TextWait
			elif QuestFlagsGet quest[22] 0x10:
				TextTalk char[0] {
					如果今後再有什麼問題，
					歡迎隨時光臨本院。{wait}
				}
				TextWait
				TextTalk char[0] {
					我們一定會誠心誠意地
					為您服務。{wait}
				}
				TextWait
			elif QuestTaskGet quest[22] 0:
				TextTalk char[0] {
					必須讓約亞西姆醫生
					快點回來……{wait}
				}
				TextWait
				TextTalk char[0] {
					諸位，一切都拜託你們了。{wait}
				}
				TextWait
			elif QuestFlagsGet quest[22] 0x02:
		elif flag[1040]:
			if !flag[0]:
				TextTalk char[0] {
					職員宿舍的琪秀宿舍長和
					瑪洛妮雖然算是
					克拉克事務長的部下，不過……{wait}
				}
				TextWait
				TextTalk char[0] {
					你可不要把這些話告訴別人哦，
					其實事務長在琪秀宿舍長
					的面前很恭順呢。{wait}
				}
				TextWait
				FlagSet flag[0]
			else:
				TextTalk char[0] {
					你可不要告訴別人哦，
					其實克拉克事務長在琪秀宿舍長
					的面前很恭順呢。{wait}
				}
				TextWait
		elif flag[1024]:
			if !flag[0]:
				TextTalk char[0] {
					院長一直都巡遊於各個國家之間，
					進行技術交流並挖掘人才，
					很少會出現在醫院裡。{wait}
				}
				TextWait
				TextTalk char[0] {
					其實，這麼一說，
					連我也沒有見到過院長……
					到底是個怎樣的人呢？{wait}
				}
				TextWait
				FlagSet flag[0]
			else:
				TextTalk char[0] {
					院長十分忙碌，
					幾乎都不會
					出現在醫院裡。{wait}
				}
				TextWait
				TextTalk char[0] {
					實際上，醫院的經營是
					交由教授們來負責的。{wait}
				}
				TextWait
		elif flag[799]:
			TextTalk char[0] {
				今天的來訪者接待就到此為止了。{wait}
			}
			TextWait
			TextTalk char[0] {
				如果太晚的話，也會不安全，
				請前來探病的客人抓緊時間。{wait}
			}
			TextWait
		elif flag[793]:
			TextTalk char[0] {
				臨近傍晚，外來的患者及訪客
				也逐漸散去了。{wait}
			}
			TextWait
			TextTalk char[0] {
				之前發生過利頓醫生受傷的事情，
				所以一定要趁天還沒黑之前，
				讓大家都回到市裡呢。{wait}
			}
			TextWait
		elif flag[784]:
			if !flag[0]:
				TextTalk char[0] {
					……那個，賽西兒小姐。{wait}
				}
				TextWait
				TextTalk char[0] {
					再怎麼說，這裡也是工作場所，
					是不是也該稍微收斂一點，
					不要在別人面前進行太親密的身體接觸呢。{wait}
				}
				TextWait
				TextTalk name[0] {
					#0006F……真不好意思。{wait}
				}
				TextWait
				TextTalk name[53] {
					#1305F哎呀，羅伊德有什麼
					好道歉的啊？{wait}
				} {
					#1309F呵呵……榭拉小姐，
					你是在羨慕我吧？
					我有個這～麼可愛的弟弟。{wait}
				}
				TextWait
				TextTalk char[0] {
					唉……隨妳去好了。{wait}
				}
				TextWait
				FlagSet flag[0]
			else:
				TextTalk char[0] {
					……反正我已經不想阻止妳了，
					你們想繼續抱在一起也好，
					還是怎樣也好，都請隨意吧。{wait}
				}
				TextWait
				TextTalk name[0] {
					#0006F（啞口無言……）{wait}
				}
				TextWait
		elif flag[777]:
		TextEnd char[0]
	Return

fn[2]:
	Call fn[1,3]
	Return

fn[3]:
	TextStart char[1]
	if flag[1566]:
		TextTalk char[1] {
			雖然院長一直不在，
			但醫院的經營狀況卻非常不錯。{wait}
		}
		TextWait
		TextTalk char[1] {
			長年以來，在市民中累積的深厚信賴感
			也起到了很大作用。{wait}
		}
		TextWait
	elif flag[1565]:
		TextTalk char[1] {
			榭拉負責接待以及院內聯絡的工作，
			她做得非常努力。{wait}
		}
		TextWait
		TextTalk char[1] {
			單看工作量的話，
			甚至都不會輸給賽西兒小姐呢。{wait}
		}
		TextWait
	elif flag[1554]:
		TextTalk char[1] {
			只要是送來的患者，就一定要救助。
			這就是烏爾斯拉醫院的座右銘。{wait}
		}
		TextWait
		TextTalk char[1] {
			即使是面對十惡不赦的壞人，
			本院也會貫徹這個原則。{wait}
		}
		TextWait
	elif flag[1536]:
		TextTalk char[1] {
			雖然本醫院從各國的各機關
			領取資金。
			但在經營方針上，仍然是推崇節儉。{wait}
		}
		TextWait
		TextTalk char[1] {
			要把資金儘量都用於補貼
			那些負擔不起醫療費用
			的患者們。{wait}
		}
		TextWait
	elif flag[1351]:
		TextTalk char[1] {
			既然在這間醫院工作，
			我們便不是普通的業務人員，
			而是為了救助患者而工作。{wait}
		}
		TextWait
		TextTalk char[1] {
			如果患者能面帶笑容地出院，
			我就會感到很幸福呢。{wait}
		}
		TextWait
	elif flag[1346]:
		TextTalk char[1] {
			教授們既要搞研究，又要指導實習醫生，
			還要兼任複診的工作，
			所以非常繁忙。{wait}
		}
		TextWait
		TextTalk char[1] {
			不過，約亞西姆醫生例外，
			他好像一直都不怎麼忙呢。{wait}
		}
		TextWait
	elif flag[1307]:
		if !flag[1]:
			TextTalk char[1] {
				我負責管理這間醫院的
				一切事務。{wait}
			}
			TextWait
			TextTalk char[1] {
				從設備的預算分配，
				到導力網路的調整……{wait}
			}
			TextWait
			TextTalk char[1] {
				雖然工作多到讓人頭痛，
				但是很有挑戰性啊。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk char[1] {
				尤其是導力網路的調整，真是非常辛苦。
				因為醫院裡除了我之外，
				再沒有會操作的人了。{wait}
			}
			TextWait
			TextTalk char[1] {
				如果可以的話，真希望能從
				克洛斯貝爾市那邊調來一位技師呢。{wait}
			}
			TextWait
	elif flag[1292]:
		CharTurnTo char[1] 180deg 0deg/s
		CharTurnTo char[58] 15deg 0deg/s
		_Char4A char[58] 255
		TextTalk char[1] {
			您想做健康診斷嗎？
			那麼，請在這邊的
			文件上簽名。{wait}
		}
		TextWait
		TextTalk char[1] {
			因為是初診，
			所以可能會多花一些時間。
			您可以等待一下嗎？{wait}
		}
		TextWait
		TextTalk char[58] {
			嗯，沒問題。{wait}
		}
		TextWait
		_Char4B char[58] 255
	elif flag[1282]:
		TextTalk char[1] {
			迪塔總裁每年都會
			送來很多禮物，就算分給
			全部患者也是足夠的。{wait}
		}
		TextWait
		TextTalk char[1] {
			哎呀，真是位了不起的人啊。{wait}
		}
		TextWait
	elif flag[1280]:
		if !flag[1]:
			TextTalk char[1] {
				我們正在商討，是否應該
				在接待處實行卡片制度。{wait}
			}
			TextWait
			TextTalk char[1] {
				預先準備好記載著
				個人資訊的卡片鑰匙，
				這樣就可以大大縮減接待處的手續量了。{wait}
			}
			TextWait
			TextTalk char[1] {
				只是，由於目前還存在著卡片量產體制，
				以及個人情報保護工作等問題，
				新制度的實行還很艱難呢。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk char[1] {
				我們正在商討，是否應該
				在接待處實行卡片制度。{wait}
			}
			TextWait
			TextTalk char[1] {
				不過，也有不少問題
				阻礙了新制度的施行……
				看來在短時間之內還難以實現。{wait}
			}
			TextWait
	elif flag[1040]:
		if !flag[1]:
			TextTalk char[1] {
				我本來在宿舍的食堂吃午飯，
				結果宿舍長說『職員不要在中午過來』，
				然後就把我趕出來了。{wait}
			}
			TextWait
			TextTalk char[1] {
				哎呀呀……
				琪秀宿舍長真是
				讓人敬畏啊。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk char[1] {
				哎呀呀……
				琪秀宿舍長真是
				讓人敬畏啊。{wait}
			}
			TextWait
			TextTalk char[1] {
				……這就是所謂的女強人吧。{wait}
			}
			TextWait
	elif flag[1024]:
		if !flag[1]:
			TextTalk char[1] {
				導力網路將烏爾斯拉醫院
				與克洛斯貝爾市緊密聯繫在了一起。{wait}
			}
			TextWait
			TextTalk char[1] {
				市民還可以透過導力網路
				進行預約服務，
				雖然目前還在試驗階段。{wait}
			}
			TextWait
			TextTalk char[1] {
				不過，因為普及率的問題，
				它並沒有被廣泛利用。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk char[1] {
				如果在導力網路上進行事先
				預約服務，就可以免去等待
				時間，順利進行診察。{wait}
			}
			TextWait
			TextTalk char[1] {
				不過，因為普及率的問題，
				它並沒有被廣泛利用。{wait}
			}
			TextWait
	elif flag[799]:
		TextTalk char[1] {
			警察局的諸位……
			感謝你們幫助
			安置防護欄。{wait}
		}
		TextWait
		TextTalk char[1] {
			但願這樣就能讓
			魔獸無法再進來……{wait}
		}
		TextWait
	elif flag[793]:
		TextTalk char[1] {
			警察局的諸位……
			你們的調查有什麼進展了嗎？{wait}
		}
		TextWait
	elif flag[784]:
		TextTalk char[1] {
			實在是不願意相信有魔獸
			闖入了醫院……
			如果那是真的，事情可就嚴重了。{wait}
		}
		TextWait
		TextTalk char[1] {
			關於利頓是否真的遭到了魔獸襲擊，
			我希望你們能找出確鑿的證據。{wait}
		}
		TextWait
	elif flag[777]:
