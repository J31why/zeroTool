			Emote field_party[3] 0mm 2000mm 38 38 250ms 1
			Sleep 500ms
			TextTalk name[0] {
				#0005F哎，這不是那位遊擊士嗎……{wait}
			}
			TextWait
			TextTalk name[1] {
				#0101F難道是……
				發生了什麼事情嗎？{wait}
			}
			TextWait
			TextTalk self {
				嗯，有位旅行者鑽入密林，
				似乎是被毒蛇之類的東西
				咬傷了呢。{wait}
			}
			TextWait
			TextTalk self {
				我們急忙趕了過去，
				然後就把他送來了。{wait}
			}
			TextWait
			TextTalk self {
				還好，艾歐莉雅已經為他
				做了適當處理，應該不會有什麼大礙。{wait}
			}
			TextWait
			TextTalk name[3] {
				#0305F處理嗎……
				遊擊士竟然連
				這種技術都會啊？{wait}
			}
			TextWait
			TextTalk self {
				是艾歐莉雅比較特殊啦。{wait}
			}
			TextWait
			TextTalk self {
				她出身於醫療發達國家雷米菲利亞，
				而且好像還擁有醫生資格證呢。{wait}
			}
			TextWait
			TextTalk name[2] {
				#0211F……真難想像現在說的這個人，
				就是每次見面時都要粘著我的那位遊擊士啊。{wait}
			}
			TextWait
			TextTalk self {
				哈哈，雖然她平時那個樣子，
				但其實是個非常厲害的人呢。{wait}
			}
			TextWait
			FlagSet flag[18]
		else:
			TextTalk self {
				艾歐莉雅出身於雷米菲利亞，
				而且還持有醫生資格證。{wait}
			}
			TextWait
			TextTalk self {
				雖然平時對可愛的東西沒有抵抗力，
				但其實是個非常厲害的人呢。{wait}
			}
			TextWait
	TextEnd self
	Return

