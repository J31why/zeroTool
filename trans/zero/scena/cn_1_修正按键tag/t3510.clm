fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharIdle self (-2300, null, -1930) (3510, null, -7740) 1000mm/s
		Sleep 300ms
	Return

fn[2]:
	while 1:
		CharIdle self (1030, null, -7790) (-1030, null, -9790) 1000mm/s
		Sleep 100ms
	Return

fn[3]:
	Return

fn[4]:
	if flag[736]:
		FlagUnset flag[736]
		Event fn[0,25]
	if flag[1792]:
		CharFlagsUnset char[12] 0x0080
		CharFlagsUnset char[13] 0x0080
		CharFlagsUnset char[14] 0x0080
	elif flag[1554]:
		CharFlagsUnset char[9] 0x0080
		CharFlagsUnset char[10] 0x0080
		CharFlagsUnset char[11] 0x0080
		CharFlagsSet char[10] 0x0010
		CharFlagsUnset char[15] 0x0080
		CharFlagsUnset char[16] 0x0080
	elif flag[1307]:
		CharFlagsUnset char[3] 0x0080
		CharFlagsUnset char[4] 0x0080
		CharFlagsSet char[3] 0x0010
		CharFlagsSet char[4] 0x0010
		CharFlagsUnset char[5] 0x0080
		CharFlagsUnset char[6] 0x0080
		CharFlagsUnset char[7] 0x0080
		CharFlagsUnset char[8] 0x0080
		CharFlagsSet char[7] 0x0010
		ForkFunc char[11] fork[0] fn[0,2]
	if !flag[1682]:
		if flag[1792]:
		elif flag[1536]:
			SystemFlagsSet 0x10000000
			Event fn[0,29]
		else:
			SystemFlagsSet 0x10000000
			Event fn[0,28]
	Return

fn[5]:
	if flag[1793]:
		system[1] = 203
	ObjFlagsSet object[0] 0x0004
	ObjFlagsSet object[1] 0x0004
	ObjFlagsSet object[2] 0x0004
	if flag[1792]:
		Emote char[14] 0mm 2000mm 24 27 250ms 0
	elif flag[1554]:
		ObjFlagsUnset object[1] 0x0004
		ObjFlagsUnset object[2] 0x0004
	elif flag[1307]:
		ObjFlagsUnset object[0] 0x0004
	if flag[1792]:
		MapColor 0x00C8D2FF 0ms
	else:
	if flag[1844]:
		SoundStop sound[134]
	else:
		SoundPlayContinuously sound[134] (5840, 0, 9630) 5000 200000 100 0
	Return

fn[6]:
	Call fn[0,7]
	Return

fn[7]:
	if QuestTaskGet quest[45] 8 && !QuestTaskGet quest[45] 9 && !QuestFlagsGet quest[45] 0x40:
		Call fn[0,32]
		Return
	TextStart char[0]
	if flag[1792]:
		if !flag[0]:
			TextTalk char[0] {
				已經拜託警察將機場內的
				所有角落都仔細搜索過了。{wait}
			}
			TextWait
			TextTalk char[0] {
				據那些搜查官判斷，那個炸彈恐嚇資訊
				應該是假的……{wait}
			}
			TextWait
			TextTalk char[0] {
				……總之，
				必須快點恢復
				飛行船的運行。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				雖然不知道對方是出於何種目的
				而發出虛假炸彈恐嚇的……{wait}
			}
			TextWait
			TextTalk char[0] {
				現在必須
				快點恢復
				飛行船的運行。{wait}
			}
			TextWait
	elif flag[1554]:
		if QuestFlagsGet quest[45] 0x10:
			TextTalk char[0] {
				飛往利貝爾的定期航班
				『卡拉布利亞號』即將起航。{wait}
			}
			TextWait
			TextTalk char[0] {
				請各位乘客
				儘快登上飛行船。{wait}
			}
			TextWait
		else:
			TextTalk char[0] {
				雖然不是很清楚……
				但卡拉小姐好像
				並沒有光臨本機場啊。{wait}
			}
			TextWait
			TextTalk char[0] {
				期待您的
				再次光臨。{wait}
			}
			TextWait
	elif flag[1307]:
		if !flag[0]:
			TextTalk char[0] {
				從這裡出發的飛行船，
				主要飛往北方的雷米菲利亞公國，
				和南方的利貝爾王國。{wait}
			}
			TextWait
			TextTalk char[0] {
				雖然也有飛往埃雷波尼亞帝國和
				卡爾瓦德共和國的飛行船，
				但和其它航班相比，乘客會比較少。{wait}
			}
			TextWait
			TextTalk char[0] {
				看來，對於平民而言，
				鐵路還是主流的交通工具吧。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				從這裡出發的飛行船，
				主要飛往北方的雷米菲利亞公國，
				和南方的利貝爾王國。{wait}
			}
			TextWait
			TextTalk char[0] {
				雖然也有飛往帝國和共和國的航班，
				但要前往這兩個地方，
				鐵路還是主流的交通工具。{wait}
			}
			TextWait
	TextEnd char[0]
	Return

fn[8]:
	Call fn[0,9]
	Return

fn[9]:
	TextStart char[1]
	if flag[1792]:
		if !flag[1]:
			TextTalk char[1] {
				當聽說有人發出炸彈恐嚇時，
				我的後背直冒冷汗。{wait}
			}
			TextWait
			TextTalk char[1] {
				雖然最嚴重的情況並沒有出現，
				但今日的航班
				已經完全停止運行了……{wait}
			}
			TextWait
			TextTalk char[1] {
				本次事件給乘客們帶來了麻煩，
				我們實在深感歉意。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk char[1] {
				本日航班全部停止運行，
				這使許多乘客的
				行程安排都大幅度延遲了。{wait}
			}
			TextWait
			TextTalk char[1] {
				我對犯人實在是恨之入骨啊。{wait}
			}
			TextWait
	elif flag[1554]:
		if !flag[1]:
			TextTalk char[1] {
				這裡是辦理出入境手續
				以及托運行李的櫃檯。{wait}
			}
			TextWait
			TextTalk char[1] {
				我們會負責將行李
				安全運至目的地，
				所以請您放心。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk char[1] {
				托運行李的手續
				在本櫃檯辦理。{wait}
			}
			TextWait
			TextTalk char[1] {
				隨身攜帶大件行李的乘客，
				請自由使用本項服務。{wait}
			}
			TextWait
	elif flag[1307]:
		if !flag[1]:
			TextTalk char[1] {
				有這麼多的遊客，
				辦理入境手續實在很辛苦。{wait}
			}
			TextWait
			TextTalk char[1] {
				好想拋開這一切，
				去盡情享受
				紀念慶典啊。{wait}
			}
			TextWait
			TextTalk char[1] {
				……這當然是不可能的啦，
				必須要對工作盡職盡責。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk char[1] {
				這份工作實在太忙了，
				所以產生想要逃避的念頭
				也是人之常情吧。{wait}
			}
			TextWait
			TextTalk char[1] {
				……不，還是不能逃避。
				必須對工作
				盡職盡責才行。{wait}
			}
			TextWait
	TextEnd char[1]
	Return

fn[10]:
	if QuestTaskGet quest[34] 3 && !QuestTaskGet quest[34] 5 && !QuestFlagsGet quest[34] 0x40:
		Call fn[0,30]
		Return
	TextStart self
	if flag[7]:
		TextTalk self {
			我真是嚇了一跳啊。
			這張卡片神不知鬼不覺地就出現了……{wait}
		}
		TextWait
		TextTalk self {
			剛才運輸公司的人
			把行李交給我時
			應該還沒有的。{wait}
		}
		TextWait
	elif flag[1792]:
		if !flag[2]:
			TextTalk self {
				話說，警察也很不容易啊。
				他們好像是暫時將重要任務擱在一邊，
				然後來這裡進行調查的。{wait}
			}
			TextWait
			TextTalk self {
				……對他們來說，
				這次不是等於白跑一趟嗎？{wait}
			}
			TextWait
			TextTalk self {
				算啦，至少確認了一切安全，
				僅是如此就已經不錯了。{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			TextTalk self {
				我也和警察一起搜遍了
				機場的每一個角落，
				已經累得不行了。{wait}
			}
			TextWait
			TextTalk self {
				……算啦，至少確認了一切安全，
				僅是如此就已經不錯了。{wait}
			}
			TextWait
	elif flag[1554]:
		if !flag[2]:
			TextTalk self {
				生活富裕的乘客
				有時還會帶著寵物去旅遊。{wait}
			}
			TextWait
			TextTalk self {
				就是把寵物放在專門的籠子裡，
				然後當成行李來托運……
				不過那些寵物們在到達之後就開始又吼又叫。{wait}
			}
			TextWait
			TextTalk self {
				雖然並不是反對，
				但我個人還是不喜歡這樣。{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			TextTalk self {
				雖然寵物和主人
				都沒有過錯……{wait}
			}
			TextWait
			TextTalk self {
				但我個人還是不喜歡
				托運寵物。{wait}
			}
			TextWait
	elif flag[1307]:
		if !flag[2]:
			TextTalk self {
				現在來了一家
				新開的運輸公司，叫『卡普亞特急便』哦。{wait}
			}
			TextWait
			TextTalk self {
				聽說這家公司以前好像是做黑道生意的，
				在不久之前剛轉業為運輸公司。{wait}
			}
			TextWait
			TextTalk self {
				雖然社長一臉凶相，
				說話也很粗魯，
				但公司的人都挺好相處的。{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			TextTalk self {
				話說，他們所駕駛的
				飛行船『山貓號』
				性能好像很強大哦。{wait}
			}
			TextWait
			TextTalk self {
				聽他們說，
				那飛行船的速度似乎不遜色於
				高速巡洋船『埃爾賽尤』哦……{wait}
			}
			TextWait
			TextTalk self {
				不過，那種事再怎麼說
				我也不會相信的。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[11]:
	TextStart self
	if !flag[3]:
		TextTalk self {
			喂，這個拜託你了！{wait}
		}
		TextWait
		TextTalk self {
			機場外面有家叫萊姆斯運送的
			當地運輸公司，
			快去把這個交給他們！{wait}
		}
		TextWait
		FlagSet flag[3]
	else:
		TextTalk self {
			喂，快去！{wait}
		}
		TextWait
		TextTalk self {
			不快一點的話，
			會被大小姐教訓的！{wait}
		}
		TextWait
	TextEnd self
	Return

fn[12]:
	TextStart self
	if !flag[4]:
		TextTalk self {
			是是，知道啦。{wait}
		}
		TextWait
		TextTalk self {
			真是，總是把麻煩的工作
			推給我。{wait}
		}
		TextWait
		FlagSet flag[4]
	else:
		TextTalk self {
			對了，那兩個人好像也到
			克洛斯貝爾來了啊。{wait}
		}
		TextWait
		TextTalk self {
			要是工作不忙的話，
			大小姐應該會想見見他們吧。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[13]:
	TextStart self
	TextTalk self {
		那些人，
		似乎是運輸公司的員工……
		但看起來不大像啊。{wait}
	}
	TextWait
	TextTalk self {
		……算了，不關我的事，
		粗獷的感覺也挺帥氣的。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[14]:
	TextStart self
	TextTalk self {
		哈哈，快看遠處，
		飛行船快起飛了哦～{wait}
	}
	TextWait
	TextTalk char[8] {
		哇～好厲害好厲害！
		好帥啊～！{wait}
	}
	TextWait
	TextEnd self
	Return

fn[15]:
	TextStart self
	TextTalk self {
		我馬上就能乘坐飛行船了～
		好期待啊～{wait}
	}
	TextWait
	TextEnd self
	Return

fn[16]:
	TextStart self
	TextTalk self {
		空中旅行也
		變得很舒適了啊。{wait}
	}
	TextWait
	TextTalk self {
		天空是女神的居所，
		在旅程中或許會
		得到某種祝福呢。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[17]:
	TextStart self
	TextTalk self {
		我說，動作快點！{wait}
	}
	TextWait
	TextTalk self {
		要是不趕快辦好搭乘手續，
		就會錯過飛行船了！{wait}
	}
	TextWait
	TextEnd self
	Return

fn[18]:
	TextStart self
	TextTalk self {
		嘖，我還想在克洛斯貝爾
		再多玩一段時間啊。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[19]:
	TextStart self
	if !flag[5]:
		TextTalk self {
			喲，是你們啊。{wait}
		}
		TextWait
		TextTalk self {
			總之，機場情況沒有異常。{wait}
		}
		TextWait
		TextTalk self {
			哎呀哎呀，雖然不知道是誰幹的好事，
			不過真是給人添了很大麻煩。{wait}
		}
		TextWait
		TextTalk name[0] {
			#0000F……各位辛苦了。{wait}
		}
		TextWait
		TextTalk self {
			噢，真的很累啊。{wait}
		}
		TextWait
		TextTalk self {
			真是的，到底是哪個混蛋做的啊！{wait}
		}
		TextWait
		FlagSet flag[5]
	else:
		TextTalk self {
			接下來就交給一課吧。{wait}
		}
		TextWait
		TextTalk self {
			現在得回總部寫報告書了。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[20]:
	TextStart self
	TextTalk self {
		又得寫報告書了，
		饒了我吧，真不想寫啊～{wait}
	}
	TextWait
	TextEnd self
	Return

fn[21]:
	TextStart self
	EmoteStop self
	TextTalk self {
		是、是……{wait}
	}
	TextWait
	TextTalk self {
		我知道了，我們會試著查明
		炸彈恐嚇信的寄出地。{wait}
	}
	TextWait
	TextTalk self {
		達德利長官，你們那邊也請多加小心。{wait}
	}
	TextWait
	TextEnd self
	Emote char[14] 0mm 2000mm 24 27 250ms 0
	Return

fn[22]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if flag[1307]:
		if !flag[1438]:
			Call fn[0,26]
		elif flag[1465] && !flag[1442]:
			Call fn[0,27]
		else:
			TextTalk self {
				#1403F……紀念慶典的最後一天
				容易發生一些出人意料的事故。{wait}
			} {
				#1400F不到最後絕不能放鬆警惕。{wait}
			}
			TextWait
	CharSetChipPattern self 0
	TextEnd self
	Return

fn[23]:
	TextStart self
	if QuestTaskGet quest[42] 0 && !QuestFlagsGet quest[42] 0x10:
		if flag[6]:
			TextTalk self {
				在利貝爾被殘酷地甩了，
				在克洛斯貝爾被溫柔地甩了……{wait}
			}
			TextWait
			TextTalk self {
				我說，利庫斯，
				我從今以後
				到底該怎麼辦啊……{wait}
			}
			TextWait
		else:
			TextTalk name[0] {
				#0000F啊……
				安敦先生。{wait}
			}
			TextWait
			TextTalk self {
				……是你們啊。
				昨天我等了你們一天……{wait}
			}
			TextWait
			TextTalk name[2] {
				#0200F（……完全忘記了。）{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F那個……
				真是十分抱歉。{wait}
			} {
				因為昨天有一個調查任務，
				實在是脫不開身……{wait}
			}
			TextWait
			TextTalk self {
				……結果，昨天我自己
				去見芙蘭小姐了。{wait}
			}
			TextWait
			TextTalk self {
				本來想試著約她
				一起吃個飯的……
				但還是被拒絕了。{wait}
			}
			TextWait
			TextTalk self {
				她……已經有
				喜歡的人了。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F這、這樣啊……
				那真是令人遺憾啊。{wait}
			}
			TextWait
			TextTalk name[3] {
				#0300F（……小芙蘭
				　喜歡的人是誰啊？
				　讓人有點在意啊。）{wait}
			}
			TextWait
			TextTalk self {
				沒關係，你們不用管我，
				我已經習慣這種事了。{wait}
			}
			TextWait
			TextTalk self {
				看到她說到喜歡的人時
				那燦爛的笑臉……
				我就徹底死心了。{wait}
			}
			TextWait
			TextTalk self {
				我現在就要回利貝爾，
				找尋一個新的自己。{wait}
			}
			TextWait
			TextTalk name[1] {
				#0100F（嗯……
				　沒有完成答應人家的事，
				　果然不太好啊。）{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F（對啊……）{wait}
			} {
				（不過，反正我們也幫不上什麼忙了，
				　就讓他一個人靜一靜吧。）{wait}
			}
			TextWait
			FlagSet flag[6]
	elif QuestFlagsGet quest[42] 0x10:
		if flag[6]:
			TextTalk self {
				在利貝爾被殘酷地甩了，
				在克洛斯貝爾被溫柔地甩了……{wait}
			}
			TextWait
			TextTalk self {
				我說，利庫斯，
				我從今以後
				到底該怎麼辦啊……{wait}
			}
			TextWait
		else:
			TextTalk self {
				……啊，是你們啊，
				昨天真是謝謝了。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F安敦先生……
				你這就要回國了嗎？{wait}
			}
			TextWait
			TextTalk self {
				嗯……反正也被
				芙蘭小姐拒絕了。{wait}
			}
			TextWait
			TextTalk name[2] {
				#0200F……真是令人同情。{wait}
			}
			TextWait
			TextTalk self {
				沒關係，你們不用管我，
				我已經習慣這種事了。{wait}
			}
			TextWait
			TextTalk self {
				看到她說到喜歡的人時
				那燦爛的笑臉……
				我就徹底死心了。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F（其實芙蘭『喜歡的人』是上士，
				　要不要把這件事告訴他啊……？）{wait}
			}
			TextWait
			TextTalk name[3] {
				#0300F（算了吧。
				　要是說出來，搞不好
				　事情會變得很麻煩的。）{wait}
			}
			TextWait
			TextTalk name[1] {
				#0100F（也是，不說比較好吧。
				　雖然他有點可憐……）{wait}
			}
			TextWait
			FlagSet flag[6]
	elif flag[6]:
		TextTalk self {
			在利貝爾被殘酷地甩了，
			在克洛斯貝爾被溫柔地甩了……{wait}
		}
		TextWait
		TextTalk self {
			我說，利庫斯，
			我從今以後
			到底該怎麼辦啊……{wait}
		}
		TextWait
	else:
		TextTalk self {
			好不容易找到了……
			幫我找回錢包的那個女孩，
			結果還是被拒絕了。{wait}
		}
		TextWait
		TextTalk self {
			她說她已經有了
			喜歡的人了啊……{wait}
		}
		TextWait
		FlagSet flag[6]
	TextEnd self
	Return

fn[24]:
	TextStart self
	TextTalk self {
		透過這次失戀，是會獲得成長，
		還是陷入無盡的悲傷不可自拔……
		這都取決於安敦自己。{wait}
	}
	TextWait
	TextTalk self {
		我作為朋友，今後所能做的
		也就只有在一旁默默守護而已。{wait}
	}
	TextWait
	TextEnd self
	Return

