	elif flag[1330]:
		TextTalk self {
			必須在拍賣會結束前
			把晚宴的準備工作
			給做好才行。{wait}
		}
		TextWait
		TextTalk self {
			這邊的掃除也
			必須要儘快做完……{wait}
		}
		TextWait
	elif flag[1329]:
		TextTalk self {
			這裡是接待室……
			為了款待貴賓而準備的場所。{wait}
		}
		TextWait
		TextTalk self {
			今天並不準備投入使用，
			請您儘量不要進來。{wait}
		}
		TextWait
	elif flag[1320]:
		TextTalk self {
			……在那二位安靜下來之前，
			只有放棄打掃了。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[12]:
