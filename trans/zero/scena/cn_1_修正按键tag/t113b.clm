	elif flag[1320]:
		CharFlagsUnset char[0] 0x0080
		CharFlagsUnset char[1] 0x0080
		CharFlagsUnset char[2] 0x0080
		CharFlagsUnset char[4] 0x0080
		CharFlagsUnset char[5] 0x0080
		if !flag[1325]:
			CharFlagsUnset char[3] 0x0080
	if flag[1320] && !flag[1325]:
		Event fn[0,14]
	Return

fn[5]:
	if flag[1333]:
	Return

fn[6]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if !flag[0]:
		TextTalk char[0] {
			#5702F呵呵……稍後再見。{wait}
		} {
			#5709F這場爭吵想必還會繼續吧，
			我會暫時待在這裡。{wait}
		}
		TextWait
		if flag[1353]:
			TextTalk name[1] {
				#5306F你……
				剛才明明是你煽動起來的，
				現在卻說得好像事不關己一樣……{wait}
			}
			TextWait
		elif flag[1354]:
			TextTalk name[2] {
				#5411F……說得好像事不關己一樣呢。{wait}
			}
			TextWait
		elif flag[1355]:
			TextTalk name[3] {
				#5602F你剛才還說要和人家尋求刺激，
				現在卻像個沒事人一樣，
				這種不負責任的話虧你說得出口啊……{wait}
			}
			TextWait
		TextTalk name[0] {
			#5106F好、好啦……瓦奇你也適可而止吧？{wait}
		}
		TextWait
		FlagSet flag[0]
	else:
		TextTalk char[0] {
			#5702F呵呵……稍後再見。{wait}
		} {
			等到他們兩個人吵完了，
			我就會去會場。{wait}
		}
		TextWait
	CharSetChipPattern self 0
	TextEnd self
	Return

fn[7]:
	TextStart self
	if !flag[1]:
		Call fn[0,9]
	else:
		CharTurnToChar char[1] char[2] 0deg/s
		TextTalk char[1] {
			事情就是這樣！
			讓我道歉多少次都可以！{wait}
		}
		TextWait
		TextTalk char[1] {
			所以，艾維琳……
			請原諒我吧！{wait}
		}
		TextWait
	TextEnd self
	Return

fn[8]:
