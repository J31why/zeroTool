fn[9]:
	_Char4A char[1] 255
	_Char4A char[2] 255
	CharTurnToChar char[1] char[2] 0deg/s
	CharTurnToChar char[2] char[1] 0deg/s
	TextTalk char[1] {
		啊啊，艾維琳，等等！
		是我不好……
		請不要再說什麼回娘家了。{wait}
	}
	TextWait
	TextTalk char[1] {
		我和妮姬妲，那個……
		是我一時昏了頭……{wait}
	}
	TextWait
	TextTalk char[2] {
		你還敢說這麼厚顏無恥的話……！{wait}
	}
	TextWait
	TextTalk char[2] {
		真是受夠了！
		我一定會向婆婆大人
		報告這次的事情！{wait}
	}
	TextWait
	TextTalk char[1] {
		怎、怎麼可以！
		只有這件事，請妳饒了我吧……！{wait}
	}
	TextWait
	_Char4B char[1] 255
	_Char4B char[2] 255
	FlagSet flag[1]
	Return

fn[10]:
	TextStart self
	if flag[1333]:
		if !flag[2]:
			TextTalk self {
				哎呀，那個孩子是……？{wait}
			}
			TextWait
			TextTalkNamed name[0] "琪雅" {
				#5810F我叫琪雅！{wait}
			}
			TextWait
			TextTalk self {
				那、那個……？
				（客人中也有這麼小的孩子嗎……）{wait}
			}
			TextWait
			TextTalk name[0] {
				#0001F對、對不起，我們還有急事！{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			TextTalk self {
				（客人中也有這麼小的孩子嗎……）{wait}
			}
			TextWait
	elif flag[1330]:
		TextTalk self {
			啊啊，好忙……{wait}
		}
		TextWait
	elif flag[1329]:
		if !flag[2]:
			TextTalk self {
				呼……剛才那對吵架的夫妻
				終於平靜下來了。{wait}
			}
			TextWait
			TextTalk self {
				我還在想，要是出現流血場面的話，
				可該如何是好呢……{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			TextTalk self {
				總之，終於可以
				開始打掃了。{wait}
			}
			TextWait
			TextTalk self {
				已經耽誤了不少時間，
				趕快繼續吧。{wait}
			}
			TextWait
	elif flag[1320]:
		TextTalk self {
			在這種地方吵架，害得我沒法
			打掃，真是頭痛。{wait}
		}
		TextWait
		TextTalk self {
			而且，看現在的氣氛，
			外人也很難介入勸架……{wait}
		}
		TextWait
	TextEnd self
	Return

fn[11]:
	TextStart self
	if flag[1333]:
		TextTalk self {
			魯巴徹商會的人
			突然交代說
			不許離開這裡……{wait}
		}
		TextWait
		TextTalk self {
			害得我很緊張呢，
			大概是發生了什麼事吧……{wait}
		}
