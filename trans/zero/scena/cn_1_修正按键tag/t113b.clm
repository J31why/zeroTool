	elif flag[1329]:
		CharFlagsUnset char[4] 0x0080
		CharSetPos char[4] (3020, 0, -13010) 360deg
		ForkFunc char[4] fork[0] fn[0,1]
		CharFlagsUnset char[5] 0x0080
