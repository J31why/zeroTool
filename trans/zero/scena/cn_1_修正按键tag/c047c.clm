fn[12]:
	TextStart char[3]
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"對話" // 0
			"玩輪盤" // 1
			"放棄" // 2
		MenuWait var[0]
		if var[0] != 1:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			FadeOut 300ms 0x00000000 255
			FadeWait
			Minigame 18 0 0 0 0 0 0 0 0
			TextClose 0
			FadeIn 300ms 0x00000000
			TextEnd char[3]
			Return
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			if flag[1307]:
				if flag[3]:
					TextTalk char[3] {
						紀念慶典也到了最終日，
						說不定會有什麼好事發生呢。{wait}
					}
					TextWait
					TextTalk char[3] {
						……呵呵，雖然沒什麼根據。
						要不要玩一把試試？{wait}
					}
					TextWait
				else:
					TextTalk char[3] {
						歡迎光臨。
						要不要玩輪盤？{wait}
					}
					TextWait
					TextTalk char[3] {
						紀念慶典也到了最終日，
						說不定會有什麼好事發生呢。{wait}
					}
					TextWait
					FlagSet flag[3]
			elif flag[1362]:
				TextTalk char[3] {
					呵呵，您玩得開心嗎？{wait}
				}
				TextWait
			elif flag[1292]:
				TextTalk char[3] {
					歡迎光臨。
					歡迎來到賭場《巴魯卡》。{wait}
				}
				TextWait
				TextTalk char[3] {
					正好有空桌台。
					客人，您要不要也來玩一把呢？{wait}
				}
				TextWait
			elif flag[1282]:
				TextTalk char[3] {
