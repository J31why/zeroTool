	CharTurnToChar char[6] char[7] 0deg/s
	char[6].4 = (char[6].4 + 360) % 360
	char[6].4 = char[6].4 + 360 - char[6].5
	char[6].5 = char[6].4 / 180
	if char[6].4 <= 45 | char[6].4 >= 315 && char[6].4 <= 405 | char[6].4 >= 675:
	elif char[6].5 < 1:
		char[6].8 = 2
	elif char[6].5 > 2:
		char[6].8 = 1
	else:
		char[6].8 = char[6].5
	char[6].4 = char[7].5
	char[7].5 = 0
	char[6].5 = 0
	CharFlagsSet char[6] 0x0010
	CharTurnToChar char[7] char[6] 0deg/s
	TextTalk char[6] {
