					還有空位呢。{wait}
				}
				TextWait
	TextEnd char[3]
	Return

fn[13]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if flag[1307]:
		TextTalk char[4] {
			哎呀……那不是帝國的
			卡萊爾伯爵嘛。{wait}
		}
		TextWait
		TextTalk char[4] {
			他是帝國東部的權威貴族哦。{wait}
		}
		TextWait
		TextTalk char[4] {
			聽說他每年都會來紀念慶典，
			看來是真的呢。{wait}
		}
		TextWait
	elif flag[1362]:
		TextTalk char[4] {
			彩虹劇團的公演，
			今天也是場面火爆啊。{wait}
		}
		TextWait
		TextTalk char[4] {
			我真想
			再去看一次呢。{wait}
		}
		TextWait
		TextTalk char[4] {
			呵呵，
			從哪裡能弄到票呢。{wait}
		}
		TextWait
	elif flag[1292]:
		if flag[4]:
			TextTalk char[4] {
				莫非連事務類工作
				也是自己做的嗎？{wait}
			}
			TextWait
			TextTalk char[4] {
				市長先生也真是辛苦呢。{wait}
			}
			TextWait
		else:
			TextTalk char[4] {
				麥克道爾市長似乎連日
				都受邀參加會談和祝賀會呢。{wait}
			}
			TextWait
			TextTalk char[4] {
				以市長的立場來說，
				這也是沒辦法的事……{wait}
			}
			TextWait
			TextTalk char[4] {
				不過，我記得市長秘書
				被逮捕了吧，
				事務類工作要怎麼辦呢？{wait}
			}
			TextWait
			FlagSet flag[4]
	elif flag[1282]:
		if flag[4]:
			TextTalk char[4] {
				現在這個時期，似乎會有
				『假貨販子』在克洛斯貝爾出沒哦。{wait}
			}
			TextWait
			TextTalk char[4] {
				呵呵，他們的買賣是
				瞄準了平民對名牌的欲望呢。{wait}
			}
			TextWait
		else:
			TextTalk char[4] {
				這麼說來……
				你們知道嗎？{wait}
			}
			TextWait
			TextTalk char[4] {
				現在這個時期，會有
				『假貨販子』在克洛斯貝爾出沒哦。{wait}
			}
			TextWait
			TextTalk char[4] {
				聽說，他們曾經還試圖
				向時代百貨兜售假貨……{wait}
			}
			TextWait
			TextTalk char[4] {
				呵呵，真是
				不可不防的壞人啊。{wait}
			}
			TextWait
			FlagSet flag[4]
	else:
		TextTalk char[4] {
			伊莉雅・普拉提耶……
			她的表演的確比傳聞中更震撼人心呢。{wait}
		}
		TextWait
		TextTalk char[4] {
			呵呵，難怪
			票價定得那麼高呢。{wait}
		}
		TextWait
	CharSetChipPattern self 0
	TextEnd self
	Return

