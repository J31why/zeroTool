fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if flag[1795] && !flag[1796]:
		SystemFlagsSet 0x10000000
		Event fn[0,17]
	elif system[0] == 106 && flag[1796] && !flag[1797]:
		Event fn[0,20]
	elif system[0] == 108 && flag[1796] && !flag[1798]:
		Event fn[0,21]
	Return

fn[2]:
	char[10].51 = 1000
	char[11].51 = 1000
	ED7_76_0 object[255] "BED01" 1
	ED7_76_0 object[255] "BED03" 1
	ED7_76_0 object[255] "BED05" 1
	ED7_76_0 object[255] "BED06" 1
	ED7_76_0 object[255] "BED07" 1
	ED7_76_0 object[255] "BED08" 1
	if flag[1796] && !flag[1822]:
		Call fn[0,19]
	TriggerFlagsSet trigger[0] 0x0080
	if flag[1792] && !flag[1797] && !flag[1798]:
		TriggerFlagsUnset trigger[0] 0x0080
	Return

fn[3]:
	TextStart self
	TextSetName ""
	TextMessage null {
		{color 5}黑手黨成員失去了意識。{color 0}{wait}
	}
	TextWait
	TextClose 0
	_59
	TextEnd self
	Return

fn[4]:
	TextStart self
	if !flag[0]:
		TextTalk self {
			和院區那邊
			完全聯絡不上。{wait}
		}
		TextWait
		TextTalk self {
			事務長和榭拉他們
			都沒事吧……{wait}
		}
		TextWait
		FlagSet flag[0]
	else:
		TextTalk self {
			和院區那邊
			完全聯絡不上。{wait}
		}
		TextWait
		TextTalk self {
			事務長他們沒事吧……{wait}
		}
		TextWait
	TextEnd self
	Return

fn[5]:
	TextStart self
	TextTalk self {
		可惡，
		我那在住院的朋友沒事吧……{wait}
	}
	TextWait
	TextEnd self
	Return

fn[6]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	TextTalk self {
		還好你們來了……{wait}
	}
	TextWait
	TextTalk self {
		被關在這種地方，
		都不知道會被怎樣對待……{wait}
	}
	TextWait
	CharSetChipPattern self 0
	TextEnd self
	Return

fn[7]:
	TextStart self
	TextTalk self {
		那、那些穿黑衣的人……
		眼神很不正常。{wait}
	}
	TextWait
	TextTalk self {
		好像完全感覺不到一絲生氣……
		總有種令人恐怖的寂靜感。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[8]:
	TextStart self
	TextTalk self {
		可惡……為什麼會變成這樣！{wait}
	}
	TextWait
	TextTalk self {
		我到底做了什麼！？{wait}
	}
	TextWait
	TextEnd self
	Return

fn[9]:
	TextStart self
	TextTalk self {
		巴士的司機不要緊吧……{wait}
	}
	TextWait
	TextTalk self {
		好像正在隔壁的房間接受治療……{wait}
	}
	TextWait
	TextEnd self
	Return

fn[10]:
	TextStart self
	if flag[1800]:
		if !flag[1]:
			TextTalk self {
				哦哦，那不是黑衣人
				從我這裡搶走的鑰匙嗎！{wait}
			}
			TextWait
			TextTalk self {
				有這個的話，
				應該就能進入院區了。{wait}
			}
			TextWait
			TextTalk self {
				那邊就交給你們了。
				救救賽西兒
				和大家吧。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				有那把鑰匙的話，
				應該就能進入院區了。{wait}
			}
			TextWait
			TextTalk self {
				那邊就交給你們了。
				救救賽西兒
				和大家吧。{wait}
			}
			TextWait
	elif flag[1845]:
		if !flag[1]:
			TextTalk self {
				什麼，院區的入口
				上鎖了……？{wait}
			}
			TextWait
			TextTalk self {
				嘖，那些黑衣人，
				竟然從裡面鎖了門……！{wait}
			}
			TextWait
			TextTalk self {
				……院區的鑰匙
				本來是我拿著的……
				可是被黑衣人搶走了。{wait}
			}
			TextWait
			TextTalk self {
				現在只能找出拿著鑰匙的傢伙，
				然後搶回來了吧。{wait}
			}
			TextWait
			FlagSet flag[1921]
			FlagSet flag[1]
		else:
			TextTalk self {
				我拿著的院區鑰匙
				被黑衣人搶走了。{wait}
			}
			TextWait
			TextTalk self {
				黑衣人直接
				上了宿舍樓梯，
				所以我想他們多半還在樓內。{wait}
			}
			TextWait
			TextTalk self {
				只能想辦法把他們找出來，
				將鑰匙奪回了。{wait}
			}
			TextWait
	elif !flag[1]:
		TextTalk self {
			那些黑衣人……
			對我們的職員和病人
			做得太過分了。{wait}
		}
		TextWait
		TextTalk self {
			我也拼命抵抗過，
			但是立刻就被打倒了。{wait}
		}
		TextWait
		TextTalk self {
			……院區那邊就交給你們了，
			救救賽西兒
			和大家吧。{wait}
		}
		TextWait
		FlagSet flag[1]
	else:
		TextTalk self {
			院區那邊就交給你們了，
			救救賽西兒
			和大家吧。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[11]:
	TextStart self
	if !flag[2]:
		CharTurnToChar self char[10] 0deg/s
		TextTalk self {
			喂，東尼先生，你振作點！{wait}
		}
		TextWait
		TextTalk self {
			你想啊，多虧有你，
			駕駛員先生才不至於
			被射中第二槍呢！{wait}
		}
		TextWait
		TextTalk self {
			幸好兩人都沒有生命危險，
			你可要堅強點啊！{wait}
		}
		TextWait
		FlagSet flag[2]
	else:
		TextTalk self {
			唉唉，傷腦筋啊。
			這裡設備不足，
			只能做做應急處理。{wait}
		}
		TextWait
		TextTalk self {
			其他病人也發燒了，
			人手完全不夠啊……{wait}
		}
		TextWait
	TextEnd self
	Return

fn[12]:
	TextStart self
	if !flag[3]:
		TextTalk self {
			……你、你們……
			竟然這種時候來醫院，
			也真是夠倒楣啊。{wait}
		}
		TextWait
		TextTalk self {
			那位駕駛員先生
			和我一起反抗那些傢伙，
			結果被他們用槍打傷了。{wait}
		}
		TextWait
		TextTalk self {
			……可惡！
			我這警備員到底有什麼用啊……！{wait}
		}
		TextWait
		FlagSet flag[3]
	else:
		TextTalk self {
			我身為警備員……
			竟然會讓他們如此輕易地入侵進來。{wait}
		}
		TextWait
		TextTalk self {
			我真是太沒用了啊……{wait}
		}
		TextWait
	TextEnd self
	Return

fn[13]:
	TextStart self
	TextTalk self {
		好痛……！
		……嗚嗚，沒想到會被槍擊……{wait}
	}
	TextWait
	TextTalk self {
		槍口指向我的時候，
		還以為徹底完蛋了……{wait}
	}
	TextWait
	TextEnd self
	Return

fn[14]:
	TextStart self
	TextTalk self {
		……剛預約了傍晚的診斷，
		竟然就被捲進這種事件中……{wait}
	}
	TextWait
	TextEnd self
	Return

fn[15]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	TextTalk self {
		這是在做夢，一定是做夢……{wait}
	}
