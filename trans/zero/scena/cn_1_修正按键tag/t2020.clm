calmare zero_k scena
scena:
	name "t2020" "t2020" "t2020"
	town town[89]
	bgm bgm[126]
	flags 8192
	item_use fn[0,255]
	unk 255 0

entry:
	pos (0, 0, -1000)
	unk1 0
	cam_from (0, 2500, 34000)
	cam_pers 262
	unk2 30
	cam_deg 45deg
	cam_limit 0deg 360deg
	cam_at (0, 0, 0)
	unk3 0
	unk4 0
	flags 0x0001
	town town[89]
	init fn[0,3]
	reinit fn[0,4]

chip[0] "chr/ch32600.itc"
chip[1] "chr/ch31200.itc"
chip[2] "chr/ch23000.itc"

npc char[0]:
	name "米蕾優准尉"
	pos (-1309, 0, 42250)
	angle 0deg
	flags 0x0105
	unk2 0
	chip chip[0]
	init fn[0,0]
	talk fn[0,6]
	unk4 255

npc char[1]:
	name "布魯德隊員"
	pos (40889, 0, -30579)
	angle 315deg
	flags 0x0105
	unk2 0
	chip chip[1]
	init fn[0,2]
	talk fn[0,8]
	unk4 255

fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharWalkToPos self (-890, 0, 5100) 2000mm/s 0
		CharWalkToPos self (12780, 0, 5100) 2000mm/s 0
		CharWalkToPos self (12780, 0, 3300) 2000mm/s 0
		CharWalkToPos self (860, 0, 3300) 2000mm/s 0
		CharWalkToPos self (860, 0, -10930) 2000mm/s 0
		CharWalkToPos self (-890, 0, -10930) 2000mm/s 0
	Return

fn[2]:
	while 1:
		CharIdle self (39330, null, -31860) (42170, null, -29120) 1000mm/s
		Sleep 300ms
	Return

fn[3]:
	ED7_76_0 object[255] "main03" 1
	if flag[1536]:
		ED7_76_1 object[255] "main03" 1
	if flag[1282] && !flag[1536]:
		CharSetPos char[0] (-40640, 0, 1570) 135deg
	elif flag[1280] && !flag[1282]:
		if QuestFlagsGet quest[25] 0x10:
			CharFlagsSet char[0] 0x0080
		elif QuestFlagsGet quest[25] 0x02:
			CharSetPos char[0] (-35130, 0, 4170) 0deg
			CharFlagsSet char[0] 0x0010
		else:
			CharSetPos char[0] (-40640, 0, 1570) 135deg
	else:
	if flag[1280] && !flag[1536]:
		CharFlagsSet char[1] 0x0080
	if !flag[1280] && system[0] == 106 && !flag[895]:
		Event fn[0,12]
	Return

fn[4]:
	Return

fn[5]:
	CharTurnToChar self name[3] 0deg/s
	TextTalk self {
		啊，你……你不是蘭迪嗎！{wait}
	}
	TextWait
	TextTalk name[3] {
		#0300F哦哦，這不是米蕾優上士嗎，
		你最近還好嗎？{wait}
	}
	TextWait
	TextTalk self {
		還、還是和以前一樣不懂禮節啊……{wait}
	}
	TextWait
	TextTalk self {
		而且，我現在已經晉升為准尉了！
		叫我的時候，能不能不要這麼隨便啊？{wait}
	}
	TextWait
	TextTalk name[3] {
		#0300F哈哈，是嗎？
		抱歉抱歉。{wait}
	} {
		#0304F不過呢……
		反正我已經脫離了警備隊，
		頭銜對我來說已經沒有什麼意義了。{wait}
	} {
		#0309F今後也允許我輕鬆自然地稱呼你吧，
		米蕾優准尉大人。{wait}
	}
	TextWait
	TextTalk self {
		……真是的！！
		隨便你好了！！{wait}
	}
	TextWait
	FlagSet flag[1121]
	Return

fn[6]:
	TextStart self
