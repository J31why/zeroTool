				好像是醉得不輕啊。{wait}
			}
			TextWait
			TextTalk name[0] {
				#12P#0006F該、該怎麼說呢……
				能醉到那種程度，也真不是一般人啊。{wait}
			}
			TextWait
			TextTalk name[3] {
				#6P#0301F真沒辦法啊。{wait}
			}
			TextWait
			TextTalk name[1] {
				#6P#0101F那麼……看樣子，鑰匙應該是在
				剛才提到過的那些地點中弄丟的吧。{wait}
			} {
				#0103F既然如此，我想鑰匙
				應該還在貝爾加德門之內。{wait}
			}
			TextWait
			TextTalk name[0] {
				#12P#0003F嗯，確實是這樣。{wait}
			} {
				#0000F好，那麼……
				我們就去那些地方調查一下吧。{wait}
			} {
				說不定能發現什麼
				新線索呢。{wait}
			}
			TextWait
			TextTalk name[2] {
				#6P#0200F米蕾優准尉
				要和我們一起搜尋嗎？{wait}
			}
			TextWait
			TextTalk char[0] {
				#11P不……既然已經決定了搜尋方針，
				我跟你們去也只是添亂罷了。{wait}
			}
			TextWait
			TextTalk char[0] {
				#11P我要把這間司令室
				徹底檢查一遍。{wait}
			}
			TextWait
			TextTalk name[3] {
				#6P#0304F嗯，剩下的就交給我們吧，
				大家破釜沉舟，
				一心向敵吧！{wait}
			}
			TextWait
			TextTalk char[0] {
				#11P真是的……拜託你認真一點啊。{wait}
			}
			TextWait
			TextTalk name[0] {
				#12P#0000F總之，搜尋任務開始。{wait}
			} {
				先去調查一下那輛
				新型裝甲車吧。{wait}
			}
			TextWait
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[80] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextSetName ""
			TextMessage null {
				{color 2}任務【搜尋重要遺失物】{color 0}開始！{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			TextSetPos -1 280 60 3
			QuestTaskSet quest[25] 2
			break
		case 1:
			MenuClose menu[0]
			TextTalk name[0] {
				#12P#0006F十分抱歉……
				我們還有些重要的工作在身……{wait}
			}
			TextWait
			TextTalk char[0] {
				#11P這樣啊……
				那也沒辦法啊。{wait}
			}
			TextWait
			TextTalk char[0] {
				#11P那就等你們把
				其它事情解決之後
				再來找我吧。{wait}
			}
			TextWait
			TextTalk char[0] {
				#11P總之，拜託各位了。{wait}
			}
			TextWait
			break
		default:
			var[0] = 255
			break
	var[0] = 0
	FadeOut 1000ms 0x00000000 255
	FadeWait
	CharTurnTo char[0] 0deg 0deg/s
	CharSetPos field_party[0] (-34470, 0, 200) 90deg
	Sleep 500ms
	EventEnd 5
	Return

