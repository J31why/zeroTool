fn[4]:
	field_party[0].5 = char[0].4
	char[0].5 = char[0].4
	TextStart char[0]
	CharFlagsUnset char[0] 0x0010
	CharTurnToChar char[0] field_party[0] 0deg/s
	char[0].4 = (char[0].4 + 360) % 360
	char[0].4 = char[0].4 + 360 - char[0].5
	char[0].5 = char[0].4 / 180
	if char[0].4 <= 45 | char[0].4 >= 315 && char[0].4 <= 405 | char[0].4 >= 675:
	elif char[0].5 < 1:
		char[0].8 = 2
	elif char[0].5 > 2:
		char[0].8 = 1
	else:
		char[0].8 = char[0].5
	char[0].4 = field_party[0].5
	field_party[0].5 = 0
	char[0].5 = 0
	CharFlagsSet char[0] 0x0010
	if flag[1566]:
	elif flag[1565]:
		if !flag[1634]:
			Call fn[0,5]
		else:
			TextTalk char[0] {
				#1500F明天爸爸會來接我，
				今天要早點睡才行呢。{wait}
			} {
				#1502F呵呵……太期待了，
				可能會睡不著呢。{wait}
			}
			TextWait
	elif flag[1554]:
		if !flag[1634]:
			Call fn[0,5]
		else:
			TextTalk char[0] {
				#1502F明天的外出日，
				我打算順便去找琪雅。{wait}
			} {
				呵呵……好期待哦。{wait}
			}
			TextWait
	elif flag[1536]:
		if !flag[1632]:
			Call fn[0,15]
		elif QuestFlagsGet quest[44] 0x10:
			if !flag[0]:
				TextTalk char[0] {
					#1500F各位，真是
					謝謝你們了。{wait}
				} {
					#1508F感覺好像
					把多餘的東西給了你們，
					真有點對不起大家……{wait}
				}
				TextWait
				TextTalk name[0] {
					#0000F哈哈，沒那回事啦。
					我們會好好珍惜的。{wait}
				}
				TextWait
				TextTalk char[0] {
					#1500F這樣的話，
					我也會……非常開心。{wait}
				}
				TextWait
				FlagSet flag[0]
			else:
				TextTalk char[0] {
					#1500F做好的禮物，
					爸爸一定
					也會喜歡的。{wait}
				} {
					各位，真是
					謝謝你們了。{wait}
				}
				TextWait
		elif QuestTaskGet quest[44] 0 && QuestTaskGet quest[44] 1 && QuestTaskGet quest[44] 2 && QuestTaskGet quest[44] 3 && QuestTaskGet quest[44] 4:
			Call fn[0,25]
		elif QuestFlagsGet quest[44] 0x02:
			TextTalk char[0] {
				#1508F各位，真抱歉，
				突然說這種
				任性的話……{wait}
			} {
				拜託大家……
				麻煩你們費心了。{wait}
			} {
				#1508F那個……真的只要
				在空閒的時候幫我就可以了。{wait}
			}
			TextWait
		else:
			TextTalk char[0] {
				#1500F琪雅對我來說也是
				非常重要的朋友。{wait}
			} {
				#1502F呵呵，真不可思議呢。
				才剛剛認識，
				就可以成為朋友。{wait}
			} {
				好期待下次再見呀……{wait}
			}
			TextWait
	elif flag[1351]:
	elif flag[1346]:
	elif flag[1307]:
		if !flag[0]:
			TextTalk char[0] {
				#1500F今天賽西兒小姐
				要帶我出去散步。{wait}
			} {
				雖然我的眼睛看不見，
				但是有她陪著我，
				所以一定會很開心。{wait}
			} {
				#1502F呵呵……好羨慕羅伊德警官
				有那樣的姊姊哦。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				#1500F賽西兒小姐
				要帶我出去散步。{wait}
			} {
				呵呵，希望她能早點來呢。{wait}
			}
			TextWait
	elif flag[1292]:
		if !flag[0]:
			TextTalk char[0] {
				#1500F爸爸今天似乎
				也要去很多地方。{wait}
			} {
				最近他經常
				去外國出差……{wait}
			} {
				#1505F……啊，那個……
				我並沒有覺得寂寞哦。{wait}
			} {
				#1502F不如說，大家都很信賴爸爸，
				所以讓我覺得很自豪呢。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				#1500F爸爸今天似乎
				也要去很多地方。{wait}
			} {
				呵呵，爸爸很受歡迎嘛，
				沒辦法呀。{wait}
			}
			TextWait
	elif flag[1282]:
		Call fn[0,13]
	elif flag[1280]:
		if !flag[0]:
			TextTalk char[0] {
				#1505F啊，羅伊德警官，是你們……{wait}
			} {
				#1508F……現在是紀念慶典吧，
				可我好像沒什麼現實感……{wait}
			} {
				明明身邊發生著很多令人開心的事，
				卻感覺那些似乎離我很遙遠……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				#1502F……對不起，
				你們難得來一趟，
				我卻說這種喪氣話。{wait}
			} {
				我沒事的，
				請大家不要放在心上哦。{wait}
			}
			TextWait
	elif flag[1040]:
		if !flag[1127]:
			TextTalk char[0] {
				#1505F啊……莫非……
				是特務支援課的各位？{wait}
			}
			TextWait
			TextTalk name[0] {
				#0005F哎！？
				我們還沒出聲，
				你就知道了啊。{wait}
			}
			TextWait
			TextTalk char[0] {
				#1500F呵呵，我覺得
				腳步聲好像有點熟悉嘛。{wait}
			} {
				像賽西兒小姐和羅伊德警官你們
				這種有特色的腳步聲，我很容易記住的。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0005F腳步聲……
				光憑這個就能判斷來人是誰，
				真的很了不起啊。{wait}
			}
			TextWait
			TextTalk char[0] {
				#1500F嘿嘿……{wait}
			} {
				#1500F不過，每個人的腳步聲
				其實都有所差別哦。{wait}
			} {
				比如說……經常來看我的
				遊擊士哥哥姊姊，還有爸爸，
				走起路時，那種毫無破綻的感覺更加強烈呢。{wait}
			}
			TextWait
			Emote field_party[0] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Emote field_party[1] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Emote field_party[2] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Emote field_party[3] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Sleep 1000ms
			TextTalk name[3] {
				#0306F……原來我們有很多破綻啊。{wait}
			}
			TextWait
			TextTalk name[2] {
				#0206F有點受打擊。{wait}
			}
			TextWait
			TextTalk name[1] {
				#0100F好啦好啦……
				和亞里歐斯先生相比的話，
				誰都不可能得到太高的評價吧。{wait}
			}
			TextWait
			FlagSet flag[1127]
		else:
			TextTalk char[0] {
				#1508F哎，那個……
				我好像說了什麼
				失禮的話……？{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F不，沒有沒有，你不用介意。
				我們的實力確實
				還遠遠不夠呢。{wait}
			}
			TextWait
			TextTalk char[0] {
				#1505F？{wait}
			}
			TextWait
	elif flag[1024]:
		if !flag[1126]:
			TextTalk char[0] {
				#1500F啊，羅伊德警官，是你們……
				午安。{wait}
			} {
				之前我聽賽西兒小姐
				說了大家的光榮事蹟。{wait}
			} {
				聽說是羅伊德警官你們
