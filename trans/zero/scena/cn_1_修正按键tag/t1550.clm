fn[16]:
	TextStart char[5]
	CharTurnToChar char[5] char[3] 0deg/s
	CharSetChipPattern char[3] 1
	_Char4A char[5] 255
	if !flag[3]:
		TextTalk char[3] {
			妳……是昨天
			在我的床單上弄了
			番茄醬的護理師吧。{wait}
		}
		TextWait
		TextTalk char[3] {
			怎麼，是來謝罪的嗎？{wait}
		}
		TextWait
		TextTalk char[5] {
			嗯……是的，
			真是十分抱歉。{wait}
		}
		TextWait
		TextTalk char[5] {
			弄髒的床單也洗好了，
			順便幫您換上吧。{wait}
		}
		TextWait
		TextTalk char[5] {
			……啊哈哈，弄髒的
			地方留下印跡了。
			就好像尿床了一樣～{wait}
		}
		TextWait
		TextTalk char[3] {
			瞧、瞧不起我嗎……？
			這種時候，一般
			都應該拿新的來吧！{wait}
		}
		TextWait
		FlagSet flag[3]
	else:
		TextTalk char[5] {
			啊哈哈，看這床單啊～
			好像尿床了一樣～{wait}
		}
		TextWait
		TextTalk char[3] {
			可、可惡，不准笑！
			被人聽見的話，
			不知會怎麼想我呢！{wait}
		}
		TextWait
	CharSetChipPattern char[3] 0
	_Char4B char[5] 255
	TextEnd char[5]
	Return

fn[17]:
	TextStart self
	if flag[1536]:
	elif flag[1351]:
		TextTalk self {
			好痛好痛……
			被一個小女孩撞倒，
			摔了個四腳朝天。{wait}
		}
		TextWait
		TextTalk self {
			真是的，那孩子在幹什麼呀……{wait}
		}
		TextWait
	elif flag[1346]:
		if !flag[4]:
			Call fn[0,11]
		else:
			TextTalk self {
				（呵呵……本來還被蠻不講理的大叔惹得
				　滿腔怨氣，但聽了這孩子的話之後，
				　一下就平靜下來了。）{wait}
			}
			TextWait
			TextTalk self {
				（謝謝了，小姑娘。）{wait}
			}
			TextWait
			TextTalk name[82] {
				#1100F嗯？嘿嘿……
				雖然不太明白，不過真是太好了呢。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[18]:
