				#1500F要是特務支援課
				繼續這樣努力下去……{wait}
			} {
				呵呵……
				羅伊德警官，你們是不是
				也會變得跟爸爸一樣強呢？{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F好、好像相當困難，
				不過我們會加油的。{wait}
			}
			TextWait
	elif flag[799]:
		if !flag[0]:
			TextTalk char[0] {
				#1500F自從眼睛失明之後，
				我的聽覺好像就變得很靈敏了……
				我確實聽到過聲音的。{wait}
			} {
				#1508F可是，那聲奇怪的『嘰──』
				到底是什麼，
				我就不知道了……{wait}
			} {
				#1505F……對不起。
