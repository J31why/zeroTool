			}
			TextWait
			TextTalk char[0] {
				#1502F啊……那我就很開心了。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				#1500F請大家加油調查吧。{wait}
			} {
				我聽到的聲音……
				這條線索要是能幫上忙就好了……{wait}
			}
			TextWait
	elif flag[793]:
	elif flag[784]:
	elif flag[777]:
