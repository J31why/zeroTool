fn[4]:
	TextStart self
	if flag[1566]:
		if !flag[0]:
			TextTalk self {
				我已從鎮長夫人那裡聽說了事情的經過……{wait}
			}
			TextWait
			TextTalk self {
				這下也就可以理解
				鎮長為什麼沒能馬上帶岡茲回來了。{wait}
			}
			TextWait
			TextTalk self {
				……雖然不想相信有什麼奇怪的藥……
				不過，竟敢引誘我重要的部下，
				絕對不可原諒。{wait}
			}
			TextWait
			TextTalk self {
				竟然會被那種東西誘惑，
				岡茲那小子也得
				好好吃我一頓拳頭才行。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				引誘岡茲的傢伙
				絕對不可原諒。{wait}
			}
			TextWait
			TextTalk self {
				但是，岡茲竟然那麼輕易就上鉤，
				也真是個丟人的傢伙啊。{wait}
			}
			TextWait
			TextTalk self {
				等那小子回來之後，
				少不了要挨我一頓揍。{wait}
			}
			TextWait
	elif flag[1554]:
		TextTalk self {
			岡茲那小子，好像在
			賭場連續贏了大量米拉啊。{wait}
		}
		TextWait
		TextTalk self {
			嘖，所以就被金錢衝昏頭腦，
			玩起失蹤了嗎？{wait}
		}
		TextWait
		TextTalk self {
			回來之後，一定要狠狠罵他一頓才行。{wait}
		}
		TextWait
	elif flag[1547]:
	elif flag[1544]:
		TextTalk self {
			老婆剛才給我送來了飯，
			我又精神百倍了啊。{wait}
		}
		TextWait
		TextTalk self {
			好～今天只剩下最後的衝刺了，
			鼓足幹勁吧！{wait}
		}
		TextWait
	elif flag[1536]:
		TextTalk self {
			岡茲那傢伙……
			到底上哪裡晃悠去了。{wait}
		}
		TextWait
		TextTalk self {
			哼，算了，
			我們只管挖洞就是。{wait}
		}
		TextWait
	elif flag[1040]:
		if !flag[0]:
			TextTalk self {
				話說，現在這時代
				還真是方便啊。{wait}
			}
			TextWait
			TextTalk self {
				上代礦山長在任的時候，
				連導力燈都沒有呢。
				往深處走一點就有生命危險。{wait}
			}
			TextWait
			TextTalk self {
				礦工的工作和以前比起來
				也安全多了啊。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				礦工的工作和以前比起來
				也安全多了。
				今後也會繼續發展導力化吧。{wait}
			}
			TextWait
			TextTalk self {
				不過，我也不知道這座礦山
				能不能一直存續到將來呢。{wait}
			}
			TextWait
	elif flag[1024]:
		if !flag[0]:
			TextTalk self {
				馬庫斯的傷終於治好了。
				我馬上讓他回來工作了。{wait}
			}
			TextWait
			TextTalk self {
				這下終於
				能恢復原來的步調了。{wait}
			}
			TextWait
			TextTalk self {
				好，今天也要
				鼓足幹勁挖礦啊！{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				馬庫斯那傢伙
				也回來了……
				今天也要鼓足幹勁挖礦啊！{wait}
			}
			TextWait
	elif flag[813]:
	elif flag[812]:
	elif flag[801]:
	TextEnd self
	Return

fn[5]:
	TextStart self
	if flag[1566]:
		TextTalk self {
			在我被魔獸襲擊受傷期間，
			大家都很照顧我。{wait}
		}
		TextWait
		TextTalk self {
			就當作是對那時的報恩吧。
			……要讓大家看看我身為礦工的潛力！{wait}
		}
		TextWait
	elif flag[1554]:
		TextTalk self {
			聽說岡茲那傢伙
			好像賺了很多米拉嘛。{wait}
		}
		TextWait
		TextTalk self {
			作為讓大家擔心的懲罰，
			他至少也得出錢辦一場宴會才行啊，
			哈哈哈。{wait}
		}
		TextWait
	elif flag[1547]:
	elif flag[1544]:
		TextTalk self {
			哦……管子上有個洞啊，
			是被老鼠咬了吧……{wait}
		}
		TextWait
		TextTalk self {
			趁早堵上吧。{wait}
		}
		TextWait
	elif flag[1536]:
		TextTalk self {
			都過了兩個星期了嗎……{wait}
		}
