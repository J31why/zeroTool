fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if flag[1814]:
		CharFlagsUnset char[6] 0x0080
	else:
		CharFlagsUnset char[5] 0x0080
	if flag[1815]:
		CharFlagsUnset char[7] 0x0080
		CharFlagsUnset char[8] 0x0080
	if flag[1818]:
		CharFlagsUnset char[9] 0x0080
		CharFlagsUnset char[10] 0x0080
		CharFlagsUnset char[11] 0x0080
	if system[0] == 103 && !flag[1812] && !flag[1846]:
		FlagSet flag[1846]
	elif system[0] == 103 && flag[1812] && !flag[1815] && !flag[1813]:
		Event fn[0,18]
	elif system[0] == 105 && flag[1804] && !flag[1812]:
		Event fn[0,17]
	if flag[736]:
		FlagUnset flag[736]
		Event fn[0,27]
	Return

fn[2]:
	char[4].51 = 1000
	char[8].51 = 1500
	if !flag[1815]:
		ED7_76_0 object[255] "BED01" 1
	ED7_76_0 object[255] "BED03" 1
	ED7_76_0 object[255] "BED04" 1
	TriggerFlagsSet trigger[0] 0x0080
	if flag[1804] && !flag[1811]:
		TriggerFlagsUnset trigger[0] 0x0080
	if flag[1811] && !flag[1822]:
		Call fn[0,16]
	ObjFlagsUnset object[0] 0x0010
	LookPointFlagsSet look_point[1] 0x0001
	if flag[1815]:
		LookPointFlagsUnset look_point[1] 0x0001
	TriggerFlagsSet trigger[1] 0x0080
	if flag[1792] && (!flag[1812] | !flag[1813]):
		TriggerFlagsUnset trigger[1] 0x0080
	Return

fn[3]:
	TextStart self
	TextSetName ""
	TextMessage null {
		{color 5}黑手黨成員失去了意識。{color 0}{wait}
	}
	TextWait
	TextClose 0
	_59
	TextEnd self
	Return

fn[4]:
	TextStart self
	if flag[1814]:
		if !flag[0]:
			TextTalk self {
				蓋巴爾先生剛才回來了～{wait}
			}
			TextWait
			TextTalk self {
				我還以為他一定會為
				床位被占的事情而大發雷霆呢，
				結果看上去卻很消沉……{wait}
			}
			TextWait
			TextTalk self {
				看到他那麼鬱悶，
				真是有點同情呢。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				蓋巴爾先生回到病房以後
				就一直那樣沮喪。{wait}
			}
			TextWait
			TextTalk self {
				到底遇到了什麼
				可怕的事情呢……{wait}
			}
			TextWait
	else:
		TextTalk self {
			在這種時候，蓋巴爾先生
			到底去了哪裡呢？{wait}
		}
		TextWait
	TextEnd self
	Return

fn[5]:
	TextStart self
	if flag[1814]:
		TextTalk self {
			本想讓戴森先生
			早點接受
			正式的治療……{wait}
		}
		TextWait
		TextTalk self {
			可是這間病房的
			設備實在是太匱乏了……{wait}
		}
		TextWait
	else:
		TextTalk self {
			總之，情況暫時穩定下來了……
			但好像發燒了。{wait}
		}
		TextWait
		TextTalk self {
			暫時還要痛苦一陣子吧，
			好可憐……{wait}
		}
		TextWait
	TextEnd self
	Return

fn[6]:
	TextStart self
	TextTalk self {
		……嗚、嗚嗚………………{wait}
	}
	TextWait
	TextEnd self
	Return

fn[7]:
	if flag[1812] && !flag[1814]:
		Call fn[0,25]
	Return

fn[8]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if !flag[1]:
		TextTalk self {
			啊啊……
			我到底該怎麼辦好呢……{wait}
		}
		TextWait
		TextTalk self {
			竟然實行了這麼大膽的暗殺行動，
			一定無處可逃了……{wait}
		}
		TextWait
		TextTalk name[2] {
			#0200F（在和妄想作戰呢……）{wait}
		}
		TextWait
		TextTalk name[1] {
			#0103F（要是知道
			　哈爾特曼議長人後的一面，
			　這種反應也不是不可理解……）{wait}
		} {
			#0108F（……可憐的人……）{wait}
		}
		TextWait
		FlagSet flag[1]
	else:
		TextTalk self {
			……唉，既然如此，
			乾脆就向哈爾特曼議長掀起反旗吧……！{wait}
		}
		TextWait
		TextTalk self {
			只要公開這個暗殺事件，
			輿論就會站在我這邊………………{wait}
		}
		TextWait
		TextTalk self {
			…………不行。
			這點小事，哈爾特曼議長
			一定可以完全抹消掉吧……{wait}
		}
		TextWait
	CharSetChipPattern self 0
	TextEnd self
	Return

fn[9]:
	TextStart self
	if !flag[1895]:
		Call fn[0,10]
	elif !flag[1896] && system[10] == 5:
		TextTalk char[7] {
			#1302F那個……你也在
			協助羅伊德他們吧。{wait}
		} {
			#1309F剛才真是謝謝你了。
			多虧了你，我們才能得救。{wait}
		}
		TextWait
		TextTalk name[5] {
			{color 3}#0702F……呵……
			我不過是順應形勢，才會助他們一臂之力。{wait}
		} {
			要道謝的話，還是謝他們吧。{wait}
		}
		TextWait
		TextTalk char[7] {
			#1305F（……哎呀，
			　這個人，好像曾在哪裡……？）{wait}
		} {
			#1300F（……不，
			　應該只是心理作用吧。）{wait}
		}
		TextWait
		FlagSet flag[1896]
	elif !flag[2]:
		TextTalk char[7] {
			#1301F話說回來……
			雖然已經聽羅伊德說了，
			但我直到現在都還難以相信呢。{wait}
		} {
			沒想到那個約亞西姆醫生
			竟然會做出這麼瘋狂的事情……{wait}
		} {
			#1303F雖然他玩心很重，又愛偷懶，
			但我一直都覺得他是個
			深受病人愛戴的好醫生……{wait}
		}
		TextWait
		FlagSet flag[2]
	else:
		TextTalk char[7] {
			#1303F沒想到那個約亞西姆醫生
			竟然會做出這麼瘋狂的事情……{wait}
		} {
			#1308F他在醫院裡的種種表現，
			難道全都是在演戲嗎……{wait}
		}
		TextWait
	TextEnd self
	Return

fn[10]:
	EventBegin 0
	CrossFade 500ms
	CamSetDistance 5950 1000 -48900 0ms
	ED7CamRotate 45deg 28deg 0deg 0ms
	CamPers 440 0ms
	CamZoom 17000 0ms
	CharSetPos name[0] (5000, 0, -48900) 45deg
	CharSetPos name[1] (4130, 0, -49060) 45deg
	CharSetPos name[2] (3790, 0, -48130) 90deg
	CharSetPos name[3] (3320, 0, -47550) 90deg
	CharSetPos name[5] (5890, 0, -50380) 0deg
	CharTurnTo char[7] 0deg 0deg/s
	CharSetChipPattern char[7] 0
	CharFlagsUnset field_party[4] 0x0080
	CharFlags2Unset field_party[4] 0x8000
	FadeWait
	TextTalk char[7] {
		#1302F……呼……
		米海爾服下的藥似乎發揮效用了，
		已經熟睡了呢。{wait}
	}
	TextWait
	TextTalk name[0] {
		#0000F是嗎，太好了……{wait}
	}
	TextWait
	Emote name[0] 0mm 2000mm 38 38 250ms 1
	Sleep 1000ms
	CharTurnToChar name[0] char[7] 400deg/s
	TextTalk name[0] {
		#0005F（對了，大哥的警徽……）{wait}
	} {
		#0008F（取回了大哥的遺物這件事，
		　是不是也該告訴賽西兒姊姊……）{wait}
	}
	TextWait
	Emote name[0] 0mm 2000mm 24 27 250ms 0
	Sleep 2000ms
	EmoteStop name[0]
	TextTalk name[0] {
		#0006F（……不對，我在想什麼呢！）{wait}
	} {
		（大家現在都已經精疲力盡了，
		　不能再加重她的負擔。）{wait}
	} {
		#0008F（等這件事情結束以後，
		　再慢慢和賽西兒姊姊說吧……）{wait}
	}
	TextWait
	CharTurnToChar char[7] name[0] 400deg/s
	TextTalk char[7] {
		#1305F……羅伊德，怎麼了？{wait}
	}
	TextWait
	TextTalk name[0] {
		#0000F……不，沒什麼啦。{wait}
	}
	TextWait
	CharSetPos field_party[0] (5000, 0, -48900) 45deg
	CharFlagsSet field_party[4] 0x0080
	CharFlags2Set field_party[4] 0x8000
	FlagSet flag[1895]
	EventEnd 5
	Return

fn[11]:
	TextStart char[8]
	TextTalk char[8] {
		呼……呼……{wait}
	}
	TextWait
	TextSetName ""
	TextMessage null {
		{color 5}因為藥物作用，似乎睡得很熟。{wait}
	}
	TextWait
	TextEnd char[8]
	Return

fn[12]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if !flag[3]:
		TextTalk self {
			……的確，在約亞西姆的履歷中，
			有幾個很不透明的地方。{wait}
		}
		TextWait
		TextTalk self {
			出身於雷米菲利亞公國，
			在藥物學・神經科的研究中獲得了重大成果……
			……然後呢……？{wait}
		}
		TextWait
		TextTalk self {
			……仔細想想的話，關於他的事情，
			我們似乎毫無瞭解。{wait}
		}
		TextWait
		FlagSet flag[3]
	else:
		TextTalk self {
			約亞西姆的才能、人品……{wait}
		}
		TextWait
		TextTalk self {
			我們或許只看到了
			他的表面而已。{wait}
		}
		TextWait
	CharSetChipPattern self 0
	TextEnd self
	Return

fn[13]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if !flag[4]:
		TextTalk self {
			話說回來……
			研究區裡彌漫的
			那股渾濁的空氣究竟是什麼？{wait}
		}
		TextWait
		TextTalk self {
			要是擴散到院區來的話，
			難保不會加重患者們的病情啊。{wait}
		}
		TextWait
		FlagSet flag[4]
	else:
		TextTalk self {
			研究區裡彌漫的
			那股渾濁的空氣到底是……{wait}
		}
		TextWait
		TextTalk self {
			雖然每天從早到晚地研究，
			但難以理解的事情還是有很多啊……{wait}
		}
		TextWait
	CharSetChipPattern self 0
	TextEnd self
	Return

fn[14]:
	TextStart self
	if !flag[5]:
		TextTalk self {
			帶著魔獸的人
			登上了研究區的四樓。{wait}
		}
		TextWait
		TextTalk self {
			他沒有穿黑衣服，
			我想大概不是黑手黨。{wait}
		}
		TextWait
		TextTalk self {
			但若無其事地帶領魔獸的樣子
			實在是很詭異……{wait}
		}
		TextWait
		FlagSet flag[5]
	else:
		TextTalk self {
			上了研究區四樓的那個人……
			我想大概不是黑手黨。{wait}
		}
		TextWait
		TextTalk self {
			但若無其事地帶領魔獸的樣子
			實在是很詭異……{wait}
		}
		TextWait
	TextEnd self
	Return

