	} {
		#15100697V#0001F他還在研究區裡嗎？{wait}
	}
	TextWait
	TextTalk char[7] {
		#15100698V#1303F#11P這倒不清楚……{wait}
	} {
		#15100699V#1301F不過，可能還有其他幾名教授
		留在研究區裡呢。{wait}
	} {
		#15100700V因為那些黑衣人帶出來的
		全都是實習醫生。{wait}
	}
	TextWait
	TextTalk name[0] {
		#15100701V#0003F#6P是嗎……{wait}
	}
