fn[29]:
	EventBegin 1
	if !flag[1812]:
		if !flag[6]:
			if PartyPosition name[2] < 4:
				Emote name[2] 0mm 2000mm 2 7 80ms 1
				SoundPlay sound[28] 0 100 0
				Sleep 1000ms
			TextTalk name[2] {
				#0200F……稍等一下，
				剛才在左邊的房間中感覺到了人的氣息。{wait}
			}
			TextWait
			if PartyPosition name[0] < 4:
				Emote name[0] 0mm 2000mm 38 38 250ms 1
			if PartyPosition name[1] < 4:
				Emote name[1] 0mm 2000mm 38 38 250ms 1
			if PartyPosition name[3] < 4:
				Emote name[3] 0mm 2000mm 38 38 250ms 1
			if PartyPosition name[5] < 4:
				Emote name[5] 0mm 2000mm 38 38 250ms 1
			Sleep 1000ms
			if PartyPosition name[0] < 4:
				Fork name[0] fork[2]:
					CharTurnToPos self (-17530, null, 8880) 500deg/s
			if PartyPosition name[1] < 4:
				Fork name[1] fork[2]:
					CharTurnToPos self (-17530, null, 8880) 500deg/s
			if PartyPosition name[2] < 4:
				Fork name[2] fork[2]:
					CharTurnToPos self (-17530, null, 8880) 500deg/s
			if PartyPosition name[3] < 4:
				Fork name[3] fork[2]:
					CharTurnToPos self (-17530, null, 8880) 500deg/s
			if PartyPosition name[5] < 4:
				Fork name[5] fork[2]:
					CharTurnToPos self (-17530, null, 8880) 500deg/s
			Sleep 1000ms
			CrossFade 500ms
			CamSetDistance -16780 1000 8490 0ms
			ED7CamRotate 45deg 28deg 0deg 0ms
			CamPers 440 0ms
			CamZoom 24000 0ms
			FadeWait
			TextTalk name[0] {
				#0005F左邊的房間……是那個房間嗎？{wait}
			}
			TextWait
			TextTalk name[1] {
				#0101F羅伊德，趕快去確認一下吧。{wait}
			}
			TextWait
			FlagSet flag[6]
		else:
			TextTalk name[0] {
				#0001F３０２號室裡好像有人……
				先去那邊確認一下吧。{wait}
			}
			TextWait
	else:
		TextTalk name[0] {
			#0001F……賽西兒姊姊
			也許在３０１號室。
			趕快去看看吧！{wait}
		}
		TextWait
	Sleep 50ms
	CharSetPos field_party[0] (-8930, 0, 17770) 180deg
	EventEnd 4
	Return
