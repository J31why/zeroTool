fn[6]:
	TextStart self
	if QuestTaskGet quest[52] 0:
		if flag[0]:
			TextTalk char[0] {
				供水管道的管理是在Ｂ區塊進行的，
				另外此處還集中有淨水設施。{wait}
			}
			TextWait
			TextTalk char[0] {
				如果Ｂ區塊發生了異常狀況，
				城市機能將有可能陷入癱瘓……
				請查明發生異常的原因！{wait}
			}
			TextWait
		else:
			TextTalk char[0] {
				地下區域根據各自機能的不同，
				被劃分為四個區域。{wait}
			}
			TextWait
			TextTalk char[0] {
				例如，Ａ區塊負責控制
				所有的排氣、換氣工作……{wait}
			}
			TextWait
			TextTalk char[0] {
				Ｂ區塊負責供水管道的管理
				以及淨水設施。{wait}
			}
			TextWait
			TextTalk char[0] {
				如果Ｂ區塊發生了異常狀況，
				城市機能將有可能陷入癱瘓……{wait}
			}
			TextWait
			TextTalk char[0] {
				請各位務必查明
				發生異常的原因！{wait}
			}
			TextWait
			FlagSet flag[0]
	elif QuestFlagsGet quest[52] 0x02:
		Call fn[0,7]
	else:
		TextTalk char[0] {
			真頭痛啊……
			在這種時候，協會的遊擊士
			卻全部出去執行任務了。{wait}
		}
		TextWait
		TextTalk char[0] {
			雖然也向警察局那邊
			發送了支援請求……{wait}
		}
		TextWait
		TextTalk char[0] {
			唉，但不知道他們
			能否注意到呢……{wait}
		}
		TextWait
		if !flag[0]:
			TextTalk name[0] {
				#0005F（向警察局發出了請求……
				　莫非是發給我們了嗎？）{wait}
			}
			TextWait
			TextTalk name[2] {
				#0200F（看來還是去檢查一下
				　支援課的終端為好吧。）{wait}
			}
			TextWait
			FlagSet flag[0]
	TextEnd self
	Return

