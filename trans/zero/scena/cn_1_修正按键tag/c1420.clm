		LookPointFlagsUnset look_point[0] 0x0001
	Return

fn[7]:
	TextStart self
	if flag[7]:
		TextTalk char[0] {
			#1601F就算是慶典，
			也不能忘乎所以吧。{wait}
		} {
			#1607F你們在我的
			座位後面幹什麼啊。
			嗯……？{wait}
		}
		TextWait
		TextTalk name[0] {
			#0003F不，我們並沒有做什麼
			會給你添麻煩的事。{wait}
		} {
			#0005F（說起來，那裡是瓦魯多的座位後面啊。
			　……竟然能在瓦魯多毫無察覺的情況下，
			　把卡片貼在上面嗎……）{wait}
		}
		TextWait
		TextTalk name[1] {
			#0100F話說回來，你們也不要在
			慶典中鬧得太過火啊。{wait}
		}
		TextWait
	elif flag[1792]:
		if flag[0]:
			TextTalk char[0] {
				#1601F嘁……
				一個一個，全都是這種德性……{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F（久留無益啊……）{wait}
			}
			TextWait
		else:
			Emote char[0] 0mm 2000mm 38 38 250ms 1
			CharTurnToChar char[0] field_party[0] 750deg/s
			Sleep 750ms
			TextTalk char[0] {
				#1600F喂……{wait}
			} {
				#1607F想打架嗎？
				啊？嗯？{wait}
			}
			TextWait
			TextTalk name[0] {
				#0001F等、等一下啊！{wait}
			}
			TextWait
			TextTalk name[3] {
				#0306F喂喂……
				幹什麼啊，怎麼突然就生氣了。{wait}
			}
			TextWait
			TextTalk name[1] {
				#0101F（……他好像相當焦躁呢，
				　還是不要在此久留了。）{wait}
			}
			TextWait
			TextTalk name[2] {
				#0200F（瓦奇先生應該會設法處理的，
				　就交給他好了。）{wait}
			}
			TextWait
			CharTurnTo char[0] 45deg 0deg/s
			FlagSet flag[0]
	elif flag[1307]:
		Call fn[0,12]
	elif flag[1138]:
		TextTalk char[0] {
			#1603F那些黑衣人，最近好像
			一直在鬼鬼祟祟地幹些什麼呢。{wait}
		} {
			#1604F呵呵，我也讓我的部下們
			出去巡邏了……{wait}
		} {
			#1602F只要敢踏進這舊市街一步，
			就要他們好看。{wait}
		}
		TextWait
	else:
		TextTalk char[0] {
			#1600F那些黑衣人最近給人的感覺很奇怪。{wait}
		} {
			所以我也讓部下們
			出去巡邏了。{wait}
		}
		TextWait
		TextTalk name[3] {
			#0305F黑衣人……是魯巴徹的傢伙們嗎？{wait}
		} {
			#0303F說起來，他們最近
			的活動好像很頻繁呢。{wait}
		}
		TextWait
		TextTalk char[0] {
			#1603F嘁，之前來的時候，
			態度囂張得惹人不爽，現在
			卻又鬼鬼祟祟地行動。{wait}
		} {
			#1602F……要是被我抓到，一定把他們當沙袋打。
			呵呵，真是期待啊。{wait}
		}
		TextWait
		TextTalk name[0] {
			#0006F喂喂……
			儘量適可而止啊。{wait}
		}
		TextWait
		TextTalk name[1] {
			#0101F不過，最近這段時間，
			重大事件的數量明顯有所增加……{wait}
		} {
			黑手黨組織之間的爭鬥，
			確實也開始變得激烈
			起來了呢……{wait}
		}
		TextWait
		FlagSet flag[1138]
	TextEnd self
	Return

fn[8]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if flag[1569]:
		Call fn[0,9]
	elif flag[1566]:
		if flag[1644]:
			TextTalk char[7] {
				#1601F你們在搞什麼……
				別在這裡轉來轉去，太礙眼了！{wait}
			}
			TextWait
		else:
			Call fn[0,11]
	elif flag[1560]:
		if flag[0]:
			TextTalk char[7] {
				#1601F……趕快從我眼前消失。
				不然我就打碎你們的腦殼！{wait}
			}
