calmare zero_k scena
scena:
	name "t119b" "t119b" "t119b"
	town town[148]
	bgm bgm[125]
	flags 8192
	item_use fn[0,255]
	unk 255 0

entry:
	pos (0, 0, -1000)
	unk1 0
	cam_from (0, 0, 34000)
	cam_pers 262
	unk2 30
	cam_deg 45deg
	cam_limit 0deg 360deg
	cam_at (0, 0, 0)
	unk3 0
	unk4 0
	flags 0x0001
	town town[148]
	init fn[0,1]
	reinit fn[0,2]

chip[0] "chr/ch26800.itc"

npc char[0]:
	name "妮姬妲"
	pos (67760, 0, 17290)
	angle 0deg
	flags 0x0191
	unk2 0
	chip chip[0]
	init fn[0,0]
	talk fn[0,3]
	unk4 255

fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if flag[736]:
		FlagUnset flag[736]
		Event fn[0,5]
	elif flag[737]:
		FlagUnset flag[737]
		Event fn[0,7]
	if flag[1329]:
	elif flag[1325]:
		CharFlagsUnset char[0] 0x0080
	Return

fn[2]:
	if flag[1333]:
	EntranceSetFunc entrance[2] fn[255,65535]
	if flag[1333] && !flag[1335]:
		EntranceSetFunc entrance[2] fn[0,8]
	EntranceSetFunc entrance[0] fn[255,65535]
	if flag[1334] && !flag[1335]:
		EntranceSetFunc entrance[0] fn[0,4]
	elif flag[1335] && !flag[1342]:
		EntranceSetFunc entrance[0] fn[0,10]
	EntranceSetFunc entrance[1] fn[255,65535]
	if flag[1336] && !flag[1338] && !flag[1337]:
		EntranceSetFunc entrance[1] fn[0,6]
	elif flag[1337] && !flag[1338]:
		EntranceSetFunc entrance[1] fn[0,11]
	EntranceSetFunc entrance[3] fn[255,65535]
	if flag[1338] && !flag[1342]:
		EntranceSetFunc entrance[3] fn[0,9]
	Return

fn[3]:
	TextStart self
	if !flag[0]:
		TextTalk self {
			說什麼為我
			拍得寶石，
			到最後還是失敗了啊。{wait}
		}
		TextWait
		TextTalk self {
			現在開始，必須要努力尋找
			其他沒有伴的客人了。{wait}
		}
		TextWait
		TextTalk self {
			呼，真是的……
			所以說，男人就是這麼沒用。{wait}
		}
		TextWait
		FlagSet flag[0]
	else:
		TextTalk self {
			詹姆斯先生今後也必須
			更加機靈一些才行啊。{wait}
		}
		TextWait
		TextTalk self {
			唉……
			現在開始，必須要努力尋找
			其他沒有伴的客人了。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[4]:
	EventBegin 0
	CrossFade 1000ms
	CamSetDistance 57500 1400 16000 0ms
	ED7CamRotate 45deg 26deg 0deg 0ms
	CamPers 500 0ms
	CamZoom 17750 0ms
	CamZoom 17000 1500ms
	CharSetPos name[0] (57310, 0, 16379) 270deg
	CharSetPos party[1] (58340, 0, 15070) 270deg
	CharSetPos name[4] (59150, 0, 16640) 270deg
	CharSetPos name[50] (61160, 0, 16030) 270deg
	FadeWait
	Emote name[0] 0mm 2000mm 2 7 80ms 1
	SoundPlay sound[28] 0 100 0
	Sleep 1000ms
	FadeOut 500ms 0x00000000 255
	FadeWait
	FlagSet flag[738]
	NewScene "scena/t111b.bin" 0 0 0
	Hcf
	Return

fn[5]:
	EventBegin 0
