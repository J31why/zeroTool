		}
		TextWait
	elif flag[1355]:
		TextTalk name[3] {
			#13501595V#0306F#11P（看樣子，想從正門逃走
			　是不太可能了啊……）{wait}
		}
		TextWait
	TextClose 0
	FadeOut 1000ms 0x00000000 255
	FadeWait
	CharSetPos field_party[0] (56900, 0, 16200) 270deg
	FlagSet flag[1335]
	QuestTaskSet quest[71] 16
