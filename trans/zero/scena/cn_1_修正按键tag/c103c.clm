fn[9]:
	if flag[1307]:
		if !flag[1]:
			TextTalk char[1] {
				哎呀，今年還真是發生了不少事呢。{wait}
			}
			TextWait
			TextTalk char[1] {
				這是珊珊開始在店裡幫忙後
				第一次碰上紀念慶典……{wait}
			}
			TextWait
			TextTalk char[1] {
				多虧如此，客人數量大大增加了㈱{wait}
			}
			TextWait
			TextTalk char[1] {
				不過店長好像
				一直都很擔心呢。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk char[1] {
				珊珊是從今年開始
				在店裡幫忙的。{wait}
			}
			TextWait
			TextTalk char[1] {
				店長總是大驚小怪，擔心這個擔心那個，
				很有趣的。{wait}
			}
			TextWait
	elif flag[1362]:
		if !flag[1]:
			TextTalk char[1] {
				好啦，坐到那裡吧～{wait}
			}
			TextWait
			TextTalk char[1] {
				站在這裡的話很礙事啊。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk char[1] {
				我們店現在忙得不可開交了。
				想點餐的話就去和老闆說吧～！{wait}
			}
			TextWait
			TextTalk char[1] {
				不過他現在臉色很不好呢。
				哈哈哈哈……！{wait}
			}
			TextWait
	elif flag[1292]:
		if !flag[1]:
			TextTalk char[1] {
				噢！你們是警察吧？
				工作辛苦啦！{wait}
			}
			TextWait
			TextTalk char[1] {
				今天的工作很繁忙吧～
				要吃點什麼嗎？{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk char[1] {
				老闆從昨天開始
				就一直很激動焦躁的樣子。{wait}
			}
			TextWait
			TextTalk char[1] {
				哈，那也難怪啊。
				珊珊那麼可愛，實在是太過惹眼了。{wait}
			}
			TextWait
	elif flag[1282]:
		if !flag[1]:
			TextTalk char[1] {
				聽說舊市街那邊
				昨天好像鬧得很過火啊。{wait}
			}
			TextWait
			TextTalk char[1] {
				客人們聊得很興奮呢。
				到底發生了什麼事呢？{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk char[1] {
				聽說舊市街那邊
				昨天好像鬧得很過火啊。{wait}
			}
			TextWait
			TextTalk char[1] {
				客人也都說很有趣，
				到底發生了什麼事呢？{wait}
			}
			TextWait
	elif flag[1280]:
		if !flag[1]:
			TextTalk char[1] {
				四萬、五萬、
				六萬米拉……{wait}
			}
			TextWait
			TextTalk char[1] {
				哇哈哈，
				真是賺了不少呀～{wait}
			}
			TextWait
			TextTalk char[1] {
				紀念慶典生意就是源源不絕啊～！{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk char[1] {
				喲，歡迎光臨我們這個遠離城區的小店！{wait}
			}
			TextWait
			TextTalk char[1] {
				『離東出口最近的店』
				就是我們這裡了，
				今後也請多加關照啦～！{wait}
			}
			TextWait
	Return

fn[10]:
	TextStart self
	if flag[1307]:
		TextTalk self {
			（忙忙碌碌）……
			今天就是創立紀念慶典的最終日了。{wait}
		}
		TextWait
		TextTalk self {
			客人們也都吃得很帶勁呢，
			這就是所謂的最後大享樂呀。{wait}
		}
		TextWait
	elif flag[1362]:
		if !flag[2]:
			TextTalk self {
				爸爸今天讓我
				打掃客房。{wait}
			}
			TextWait
			TextTalk self {
				爸爸好奇怪，為什麼要讓我來打掃啊？
				好像也沒有什麼特別需要打掃的地方啊……{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			TextTalk self {
				客房不是都已經
				打掃完了嗎……{wait}
			}
			TextWait
			TextTalk self {
				呼，真想去看遊行啊……
				不過都已經結束了吧……{wait}
			}
			TextWait
	elif flag[1292]:
		if !flag[2]:
			TextTalk self {
				莉夏現在正在
				為公演努力吧～{wait}
			}
			TextWait
			TextTalk self {
				呵呵，一定會有無數觀眾
				給她鼓掌叫好呢。{wait}
			}
			TextWait
			TextTalk self {
				我也不能輸呀。
				必須要努力工作才行♪{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			TextTalk self {
				今天的客房已經滿員了哦。{wait}
			}
			TextWait
			TextTalk self {
				（忙忙碌碌）……
				必須要打掃得乾乾淨淨呢。{wait}
			}
			TextWait
	elif flag[1282]:
		TextTalk self {
			爸爸真是的，
			又在嚇唬客人了……{wait}
		}
		TextWait
		TextTalk self {
			這可不行啊，對待客人
			必須要一直保持微笑。{wait}
		}
		TextWait
	elif flag[1280]:
		if !flag[2]:
			TextTalk self {
				啊，歡迎光臨～！{wait}
			}
			TextWait
			TextTalk self {
				呼，客人這麼多，真讓人吃驚。
				應付點餐也相當累人呢。{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			Emote self 0mm 2000mm 40 43 100ms 3
			Sleep 1200ms
			TextTalk self {
				嗚嗚……人手不足啊～{wait}
			}
			TextWait
	TextEnd self
	Return

fn[11]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if flag[1307]:
		if !flag[3]:
			TextTalk self {
				（嚼嚼）……
				大家都很興奮嘛。{wait}
			}
			TextWait
			TextTalk self {
				我今天也是一樣，
				要開車去共和國。{wait}
			}
			TextWait
			TextTalk self {
				幹運輸業的人是沒有休假的～{wait}
			}
			TextWait
			FlagSet flag[3]
		else:
			TextTalk self {
				（嚼嚼）……
				真羨慕那些輕鬆玩樂的傢伙們啊。{wait}
			}
			TextWait
	elif flag[1362]:
		if !flag[3]:
			TextTalk self {
				哎呀呀，這麼多的人，
				想在主幹道上開車恐怕都難了。{wait}
			}
			TextWait
			TextTalk self {
				擔心出事故，
				不然就從小巷那邊把車開出去好了。{wait}
			}
			TextWait
			FlagSet flag[3]
		else:
			TextTalk self {
				哎呀呀，今天的運送
				似乎會遲到很久啊。{wait}
			}
			TextWait
	elif flag[1292]:
		if !flag[3]:
			TextTalk self {
				聽說今天有遊行呢。{wait}
			}
			TextWait
			TextTalk self {
