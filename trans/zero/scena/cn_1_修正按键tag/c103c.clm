look_point[0]:
	pos (14590, 0, 4630)
	radius 1000
	bubble_pos (16030, 1500, 6050)
	unk1 126
	unk2 0
	function fn[0,5]
	unk3 0
	unk4 0

fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharWalkToPos self (7200, 0, 370) 1000mm/s 0
		CharWalkToPos self (7280, 30, 1390) 1000mm/s 0
		CharTurnTo self 45deg 500deg/s
		Sleep 1300ms
		CharWalkToPos self (5850, 0, 1930) 1000mm/s 0
		CharWalkToPos self (4730, 0, 3700) 1000mm/s 0
		CharWalkToPos self (4840, 0, 5570) 1000mm/s 0
		CharTurnTo self 315deg 500deg/s
		Sleep 1500ms
		CharWalkToPos self (5660, 0, 5540) 1000mm/s 0
		CharWalkToPos self (10470, 0, 10350) 1000mm/s 0
		CharTurnTo self 0deg 500deg/s
		Sleep 1200ms
		CharWalkToPos self (12980, 0, 7230) 1000mm/s 0
		CharWalkToPos self (12730, 0, 2100) 1000mm/s 0
		CharWalkToPos self (13200, 0, 1420) 1000mm/s 0
		CharTurnTo self 90deg 500deg/s
		Sleep 1600ms
		CharWalkToPos self (12280, 0, 680) 1000mm/s 0
		CharWalkToPos self (11230, 0, 110) 1000mm/s 0
		CharWalkToPos self (8930, 30, -1570) 1000mm/s 0
		Sleep 1400ms
		CharWalkToPos self (8720, 0, -510) 1000mm/s 0
	Return

fn[2]:
	while 1:
		CharIdle self (-49010, null, -53000) (-51420, null, -56470) 1000mm/s
		Sleep 300ms
	Return

fn[3]:
	if flag[1307]:
		CharFlagsUnset char[9] 0x0080
		CharFlagsUnset char[10] 0x0080
	elif flag[1362]:
		CharSetPos char[0] (16030, 0, 6050) 270deg
		CharSetPos char[1] (12310, 0, -1990) 225deg
		ForkFunc char[1] fork[0] fn[0,1]
		CharSetPos char[2] (-49600, 30, -55300) 135deg
		ForkFunc char[2] fork[0] fn[0,2]
		CharFlagsUnset char[7] 0x0080
		CharFlagsUnset char[8] 0x0080
	elif flag[1292]:
		CharSetPos char[0] (16030, 0, 6050) 270deg
		CharSetPos char[1] (12310, 0, -1990) 225deg
		ForkFunc char[1] fork[0] fn[0,1]
		CharSetPos char[2] (-53960, 0, -55210) 180deg
		ForkFunc char[2] fork[0] fn[0,0]
	elif flag[1282]:
		CharTurnTo char[0] 180deg 0deg/s
		CharFlagsSet char[0] 0x0010
	elif flag[1280]:
	Return

fn[4]:
	if flag[1307]:
		FlagSet flag[8]
	elif flag[1362]:
		FlagSet flag[7]
	elif flag[1292]:
		FlagSet flag[7]
	elif flag[1282]:
		FlagSet flag[8]
	elif flag[1280]:
		FlagSet flag[8]
	Return

fn[5]:
	if flag[1307]:
		Call fn[0,8]
	elif flag[1362]:
		Call fn[0,6]
	elif flag[1292]:
		Call fn[0,6]
	elif flag[1282]:
		Call fn[0,8]
	elif flag[1280]:
		Call fn[0,8]
	Return

fn[6]:
	TextStart char[0]
	if flag[7]:
		var[0] = 99
		while var[0] == 99:
			FadeOut 300ms 0x00000000 100
			Menu menu[0] -1 -1 1
				"對話" // 0
				"購物" // 1
				"休息" // 2
				"放棄" // 3
			MenuWait var[0]
			if var[0] < 1 | var[0] > 2:
				MenuClose menu[0]
				FadeIn 300ms 0x00000000
				FadeWait
			if var[0] == 1:
				ShopOpen shop[52]
				var[0] = 99
			elif var[0] == 2:
				ShopOpen shop[50]
				var[0] = 99
			elif var[0] != 0:
			elif var[0] == 0:
				var[0] = 99
				Call fn[0,7]
	else:
		Call fn[0,7]
	TextEnd char[0]
	Return

fn[7]:
	if flag[1307]:
		if !flag[0]:
			TextTalk char[0] {
				特製炒飯兩份，久等了！{wait}
			}
			TextWait
			TextTalk char[0] {
				……今天的客人數沒有那麼多了。{wait}
			}
			TextWait
			TextTalk char[0] {
				看來似乎能撐過去啊。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				這種來客量也只到今天而已。
				從明天開始，又要恢復到只有幾位常客的營業了。{wait}
			}
			TextWait
			TextTalk char[0] {
				……看來似乎能撐過去啊。{wait}
			}
			TextWait
	elif flag[1362]:
		if !flag[0]:
			TextTalk char[0] {
				啊，客人！您要點些什麼？{wait}
			}
			TextWait
			TextTalk char[0] {
				嗯？嗯嗯？
				要吃什麼呢……嗯！？{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				房間的入住手續
				從晚上五點才開始辦理哦。{wait}
			}
			TextWait
			TextTalk char[0] {
				在那之前是不能
				入住房間的。
				……聽清了嗎？{wait}
			}
			TextWait
	elif flag[1292]:
		if !flag[0]:
			TextTalk char[0] {
				……要吃點什麼嗎？{wait}
			}
			TextWait
			TextTalk char[0] {
				嗯？想吃點什麼啊……嗯！？{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				我讓珊珊去裡面了。{wait}
			}
			TextWait
			TextTalk char[0] {
				讓她在那麼多男人面前拋頭露面，
				果然還是不放心啊。{wait}
			}
			TextWait
	elif flag[1282]:
		if !flag[0]:
			CharTurnToChar char[0] char[6] 300deg/s
			TextTalk char[0] {
				……那桌的那個男人，
				竟敢三番五次盯著珊珊看。{wait}
			}
			TextWait
			TextTalk char[0] {
				………（瞪）…………………{wait}
			}
			TextWait
			TextTalk char[6] {
				奇、奇怪啊……
				怎麼突然感到一陣寒氣……{wait}
			}
			TextWait
			CharFlagsUnset char[0] 0x0010
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				如果敢對珊珊出手的話，
				我絕對饒不了他。{wait}
			}
			TextWait
			TextTalk char[0] {
				最好給我記住。{wait}
			}
			TextWait
	elif flag[1280]:
		if !flag[0]:
			Emote char[0] 0mm 2000mm 14 15 250ms 2
			SoundPlay sound[23] 0 100 0
			Sleep 1200ms
			TextTalk char[0] {
				紀念慶典期間果然很喧鬧啊……{wait}
			}
			TextWait
			TextTalk char[0] {
				我比較喜歡安靜的店。
				……客人之類的不來也罷。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				……太過喧鬧的話，
				總會讓我想起東方人街。{wait}
			}
			TextWait
			TextTalk char[0] {
				那裡總是這麼喧囂。{wait}
			}
			TextWait
	Return

