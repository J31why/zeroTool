	if QuestTaskGet quest[22] 2 && !QuestFlagsGet quest[22] 0x10:
		EventBegin 1
		if !flag[5]:
			TextTalk name[0] {
				#0000F哦……{wait}
			} {
				比賽規則是禁止離開沙洲，
				去其它地方補給。{wait}
			} {
				為了把約亞西姆醫生帶回去，
				必須要堂堂正正地比一場才行。{wait}
			}
			TextWait
			FlagSet flag[5]
		else:
			TextTalk name[0] {
				#0000F在贏得釣魚比賽之前，
				還不能離開沙洲啊。{wait}
			}
			TextWait
		Sleep 50ms
		CharSetPos field_party[0] (-17740, -1390, -15870) 156deg
		EventEnd 4
		Return
	else:
		Call fn[0,28]
	Return

