fn[16]:
	TextStart self
	if flag[1536]:
		if flag[1566]:
			TextTalk self {
				唔……{wait}
			}
			TextWait
			TextTalk self {
				我的水準
				果然也只能達到
				業餘釣師的程度吧……{wait}
			}
			TextWait
			TextTalk self {
				雖然不甘心，但是
				完全沒有魚上鉤的感覺呢。{wait}
			}
			TextWait
		elif flag[1554]:
			TextTalk self {
				在這一帶應該
				可以釣到大魚的啊。{wait}
			}
			TextWait
			TextTalk self {
				唔……{wait}
			}
			TextWait
			TextTalk self {
				總是無法像約亞西姆醫生
				那樣順利釣到魚呢。{wait}
			}
			TextWait
		elif flag[1536]:
			TextTalk self {
				你聽說了嗎？{wait}
			}
			TextWait
			TextTalk self {
				約亞西姆團員昨天
				在這一帶釣到了大魚哦。{wait}
			}
			TextWait
			TextTalk self {
				呼，我也不能輸給他。
				必須要再加把勁才行。{wait}
			}
			TextWait
