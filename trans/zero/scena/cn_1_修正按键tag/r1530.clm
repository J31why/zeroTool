					什麼時候不見了？{wait}
				}
				TextWait
				TextTalk self {
					好奇怪啊，
					他明明宣稱今天放假，
					不用工作的……{wait}
				}
				TextWait
		elif QuestTaskGet quest[22] 2:
			TextTalk self {
				約亞西姆醫生在釣公師團裡
				也算是水準相當厲害的呢。{wait}
			}
			TextWait
			TextTalk self {
				他身為醫生，工作那麼忙，
				卻還能精進到如此地步，
				真是令人佩服啊。{wait}
			}
			TextWait
		else:
			TextTalk self {
				呀，好久沒在
				這個沙洲釣魚了。{wait}
			}
			TextWait
			TextTalk self {
				在郊外釣魚的話，必須要算好時機，
				在沒有魔獸的時候出來才行，
				所以很少有機會能來呢。{wait}
			}
			TextWait
	TextEnd self
	Return

