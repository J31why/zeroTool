	TextTalk char[13] {
		#1400F──計畫已經瞭解了。{wait}
	} {
		那麼，周邊的警備工作
		就拜託你們了。{wait}
	}
	TextWait
	TextTalk char[2] {
		#0600F哼，知道了。{wait}
	} {
		#0603F其實按照原定計劃，有我們一課
		就已經足夠了。{wait}
	}
	TextWait
	TextTalk char[13] {
		#1404F呵呵……
		別介意，只是分工合作而已。{wait}
	} {
		#1400F在研討會的出席者中，
		也有很多國外要人。{wait}
	} {
		政府只是希望能有遊擊士協會這個保證
		來讓他們安心，僅此而已。{wait}
	}
	TextWait
	TextTalk char[2] {
		#0603F哼，不用你說，
