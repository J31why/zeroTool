	talk fn[255,255]
	unk4 255

fn[0]:
	var[0] = random % 100
	if var[0] > 75:
		Sleep 600ms
	elif var[0] > 50:
		Sleep 400ms
	elif var[0] > 25:
		Sleep 200ms
	while 1:
		CharSetChipPattern self 0
		Sleep 100ms
		CharSetChipPattern self 1
		Sleep 100ms
		CharSetChipPattern self 2
		Sleep 100ms
		CharSetChipPattern self 1
		Sleep 100ms
		CharSetChipPattern self 0
		Sleep 100ms
		CharSetChipPattern self 3
		Sleep 100ms
		CharSetChipPattern self 4
		Sleep 100ms
		CharSetChipPattern self 3
		Sleep 100ms
	Return

fn[1]:
	if flag[736]:
		FlagUnset flag[736]
		Event fn[0,7]
	elif flag[737]:
		FlagUnset flag[737]
		Event fn[0,5]
	elif system[0] == 100:
		if flag[1282] && !flag[1292] && !flag[1391]:
			Event fn[0,10]
	Return

fn[2]:
	if flag[1072] && !flag[1280]:
		system[1] = 0
	elif flag[1844]:
		system[1] = 0
	Return

fn[3]:
	while 1:
		var[0] = random % 100
		if var[0] < 20:
			Sleep 500ms
		elif var[0] < 40:
			Sleep 200ms
		elif var[0] < 60:
			Sleep 300ms
		elif var[0] < 80:
			Sleep 400ms
		else:
			Sleep 600ms
		EffPlay eff[0] eff_instance[255] self 192 (0, 1200, 400) 0 0 0 1000 1000 1000 null (0, 0, 0) 0ms
		SoundPlay sound[817] 0 80 0
	Return

fn[4]:
	while 1:
		var[0] = random % 100
		if var[0] < 20:
			Sleep 500ms
		elif var[0] < 40:
			Sleep 1000ms
		elif var[0] < 60:
			Sleep 1500ms
		elif var[0] < 80:
			Sleep 2000ms
		else:
			Sleep 2500ms
		EffPlay eff[0] eff_instance[255] self 192 (0, 1200, 400) 0 0 0 1000 1000 1000 null (0, 0, 0) 0ms
		SoundPlay sound[817] 0 80 0
	Return

