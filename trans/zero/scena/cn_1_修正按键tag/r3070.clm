fn[7]:
	SystemFlagsSet 0x08000000
	if flag[1488]:
		TextStart null
		TextSetName ""
		TextMessage null {
			{color 5}拉杆被固定了。{wait}
		}
		TextWait
		TextClose 0
		_59
		SystemFlagsUnset 0x08000000
		TextEnd null
	else:
		EventBegin 1
		TextMessage null {
			{color 5}有一個拉杆。
			要操作嗎？{wait}
		}
		Menu menu[0] -1 -1 1
			"是" // 0
			"否" // 1
		MenuWait var[0]
		MenuClose menu[0]
		TextClose 0
		_59
		if var[0] == 0:
			CrossFade 500ms
			CharSetPos field_party[0] (-22420, 3000, -9750) 15deg
			CharSetPos field_party[1] (-21420, 3000, -11500) 15deg
			CharSetPos field_party[2] (-23180, 3000, -11500) 15deg
			CharSetPos field_party[3] (-22340, 3000, -13150) 15deg
			CamSetDistance -21140 3600 -3130 0ms
			ED7CamRotate 62deg 35deg 0deg 0ms
			CamPers 470 0ms
			CamZoom 34000 0ms
			FadeWait
			SoundPlay sound[142] 0 100 0
			ED7ObjPlay object[5] 0 100 0 0
			ObjWait object[5]
			SoundPlay sound[155] 2 100 0
			ED7ObjPlay object[4] 0 120 0 0
			ObjWait object[4]
			SoundStop sound[155]
			SoundPlay sound[149] 0 100 0
			Shake 0 300 3000 200ms
			Sleep 1000ms
			FlagSet flag[1488]
		SystemFlagsUnset 0x08000000
		EventEnd 5
	Return
