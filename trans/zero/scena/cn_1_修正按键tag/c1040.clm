			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				唉，這就是單身就任最大的痛苦之處……{wait}
			}
			TextWait
	elif flag[801]:
		TextTalk self {
			瑪因茲出產的七耀石，
			其交易價格最近稍有下滑呢……{wait}
		}
		TextWait
		TextTalk self {
			嗯，七耀石的交易狀況也會
			影響到我們公司的行情呢。
			必須提前將原因調查清楚啊。{wait}
		}
		TextWait
	elif flag[777]:
		TextTalk self {
			街上實在太吵鬧了，
			連午覺都睡不好……{wait}
		}
		TextWait
		TextTalk self {
			這座公寓的牆真是很薄，
			都不能隔音啊……{wait}
		}
		TextWait
	elif flag[768]:
		if !flag[0]:
			TextTalk self {
				就在最近，隔壁搬來了
