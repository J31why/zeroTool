			}
			TextWait
	elif flag[526]:
		if !flag[0]:
			TextTalk self {
				我在埃雷波尼亞帝國的
				證券公司上班。{wait}
			}
			TextWait
			TextTalk self {
				這次是單身就任，來主要業務點
