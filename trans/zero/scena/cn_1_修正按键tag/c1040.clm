			}
			TextWait
			TextTalk self {
				那些被牽連進來的公司真是不幸呢……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				大概是因為最近的負面事件太多了吧，
				股票的價格波動情況實在是不能令人滿意。{wait}
			}
			TextWait
			TextTalk self {
				不過，應該很快就會恢復吧，
				那些被牽連進來的公司也真是不幸呢。{wait}
			}
			TextWait
	elif flag[1024]:
		if !flag[0]:
			TextTalk self {
				偶爾也想放個假，
				回去見見家人……{wait}
			}
			TextWait
			TextTalk self {
				但我們的公司從事證券相關業務，
