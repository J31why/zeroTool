fn[5]:
	if system[4] == 3:
		EntranceSetDisabled entrance[0] 0
		EntranceSetDisabled entrance[11] 1
	else:
		EntranceSetDisabled entrance[0] 1
		EntranceSetDisabled entrance[11] 0
	if flag[1037] && !flag[1038]:
		MapColor 0x00C8D2FF 0ms
	elif flag[1792]:
		MapColor 0x00C8D2FF 0ms
	else:
	LookPointFlagsSet look_point[0] 0x0001
	ObjFlagsSet object[1] 0x0010
	if flag[525] && !flag[768]:
		LookPointFlagsUnset look_point[0] 0x0001
		ObjFlagsUnset object[1] 0x0010
	LookPointFlagsSet look_point[1] 0x0001
	if flag[1342] && !flag[1536] && flag[1461]:
		LookPointFlagsUnset look_point[1] 0x0001
	if flag[1536] && !flag[1554]:
		LookPointFlagsUnset look_point[1] 0x0001
	Return

fn[6]:
	TextStart self
	if flag[7]:
		TextTalk self {
			住我家對面的那位鄰居
			大約在半個月之前搬走了。
			現在那間房空了下來。{wait}
		}
		TextWait
		TextTalk self {
			說起來……那個人的性格
			還真是散漫隨性呢。{wait}
		}
		TextWait
	elif flag[1792]:
		TextTalk self {
			說起來……
			不知預算會議結果如何了。{wait}
		}
		TextWait
		TextTalk self {
			預算的下撥計畫對股價
			也有著相當大的影響。{wait}
		}
		TextWait
	elif flag[1566]:
		TextTalk self {
			克洛斯貝爾時報周刊……
			對了，是明天發行啊。{wait}
		}
		TextWait
		TextTalk self {
			嗯～因為臨時休刊了，
			都有點搞不清發行時間呢。{wait}
		}
		TextWait
	elif flag[1554]:
		TextTalk self {
			港灣區那裡好像發生了
			重大事件呢。{wait}
		}
		TextWait
		TextTalk self {
			說到港灣區，
			離這裡沒幾步遠吧？
			真、真是好危險呢……{wait}
		}
		TextWait
	elif flag[1536]:
		if !flag[0]:
			TextTalk self {
				我寄給家人的紀念慶典照片，
				他們都已經收到了呢。{wait}
			}
			TextWait
			TextTalk self {
				在導力通訊中通話時，孩子們
				甚至開心地說謝謝呢。{wait}
			}
			TextWait
			TextTalk self {
				……（抽泣）
				已經很久都沒聽到過家人的聲音了……
				鄉愁真是催人落淚啊。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				不行不行，現在可不是
				想家思鄉的時候。{wait}
			}
			TextWait
			TextTalk self {
				單身赴任，責任在身，
				必須要把要做的事情完成啊。{wait}
			}
			TextWait
	elif flag[1342]:
	elif flag[1307]:
		if !flag[0]:
			TextTalk self {
				啊，導力相機的導力
				好像已經用完了呢。{wait}
			}
			TextWait
			TextTalk self {
				本來還想拍攝煙火的……
				算了，到晚上應該就能恢復了吧。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				導力器中的導力
				經過一段時間就會自行恢復，
				真是非常方便哦。{wait}
			}
			TextWait
	elif flag[1362]:
		TextTalk self {
			遊行真是太壯觀了啊……{wait}
		}
		TextWait
		TextTalk self {
			雖然我還是第一次使用相機，
			但一定拍下了很棒的照片。{wait}
		}
		TextWait
	elif flag[1292]:
		if !flag[0]:
			TextTalk self {
				我和家人約好了，要拍攝
				遊行的照片給他們看。{wait}
			}
			TextWait
			TextTalk self {
				再、再不趕快把工作完成就來不及了……！{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				啊啊，再不快點的話，
				遊行就要開始了……！{wait}
			}
			TextWait
	elif flag[1282]:
		TextTalk self {
			總公司發來了緊急指示。{wait}
		}
		TextWait
		TextTalk self {
			嗚嗚，看來今天
			是沒機會出門逛了。{wait}
		}
		TextWait
	elif flag[1280]:
		TextTalk self {
			好，拿好錢包，還有……{wait}
		}
		TextWait
		TextTalk self {
			……如果可以的話，真希望和
			居住在帝國的家人們一起去參觀啊。{wait}
		}
		TextWait
	elif flag[1055]:
		TextTalk self {
			嗯……下個月
			會不會放假呢。{wait}
		}
		TextWait
		TextTalk self {
			如果可能的話，真想和家人
			一起參觀創立紀念慶典啊。{wait}
		}
		TextWait
	elif flag[1040]:
		if !flag[0]:
			TextTalk self {
				ＩＢＣ集團的證券公司
				是全世界最大的證券公司。{wait}
			}
			TextWait
			TextTalk self {
				對於我們公司來說，
				算是有力的競爭對手，不過……
				我們也會進行合作。{wait}
			}
			TextWait
			TextTalk self {
				也就是證券的互相持有，
				我們公司的一部分證券
