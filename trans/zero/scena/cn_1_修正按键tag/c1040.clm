				這一帶都是東方風格的建築啊……{wait}
			}
			TextWait
			TextTalk self {
				對帝國人來說，總覺得有些稀奇，
				不是很適應，但是也無可奈何呢。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[7]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if flag[1342]:
		if !flag[0]:
			TextTalk self {
				我接下來就要將在紀念慶典期間
				拍攝的照片寄給居住在帝國的家人們。{wait}
			}
			TextWait
			TextTalk self {
				我拍到了不少很有觀賞性的照片呢。
				這樣一來，孩子們也會很高興吧。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				對了，都忘了還要寫封信，
				到時和照片一起寄過去。{wait}
			}
			TextWait
			TextTalk self {
				嗯～『你們都還好嗎』，這樣……{wait}
			}
			TextWait
	CharSetChipPattern self 0
	TextEnd self
	Return

fn[8]:
