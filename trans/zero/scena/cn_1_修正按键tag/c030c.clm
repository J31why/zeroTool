	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if !flag[1423]:
		CharSetChipPattern self 0
		TextTalk self {
			#0600F呼……{wait}
		}
		TextWait
		Emote field_party[0] 0mm 2000mm 2 7 80ms 1
		SoundPlay sound[28] 0 100 0
		Emote field_party[1] 0mm 2000mm 2 7 80ms 1
		SoundPlay sound[28] 0 100 0
		Emote field_party[2] 0mm 2000mm 2 7 80ms 1
		SoundPlay sound[28] 0 100 0
		Emote field_party[3] 0mm 2000mm 2 7 80ms 1
		SoundPlay sound[28] 0 100 0
		Sleep 1000ms
		TextTalk name[0] {
			#0005F達、達德利搜查官！？{wait}
		}
		TextWait
		TextTalk name[1] {
			#0105F您怎麼會在這裡……{wait}
		}
		TextWait
		field_party[0].5 = self.4
		self.5 = self.4
		TextStart self
		CharFlagsUnset self 0x0010
		CharTurnToChar self field_party[0] 0deg/s
		self.4 = (self.4 + 360) % 360
		self.4 = self.4 + 360 - self.5
		self.5 = self.4 / 180
		if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
		elif self.5 < 1:
			self.8 = 2
		elif self.5 > 2:
			self.8 = 1
		else:
			self.8 = self.5
		self.4 = field_party[0].5
		field_party[0].5 = 0
		self.5 = 0
		CharFlagsSet self 0x0010
		TextTalk self {
			#0601F是支援課啊……{wait}
		} {
			#0603F……只是稍微休息一下而已，
			不必管我。{wait}
		}
		TextWait
		TextTalk name[0] {
			#0000F是、是……{wait}
		}
		TextWait
		TextTalk name[2] {
			#0203F（似乎相當疲倦呢。）{wait}
		}
		TextWait
		TextTalk name[3] {
			#0300F（雖然他愛擺架子，
			　不過也確實在努力工作呢。）{wait}
		}
		TextWait
		FlagSet flag[1423]
	else:
		CharSetChipPattern self 0
		TextTalk self {
			#0603F話說回來，
			今天好像有那個吧……{wait}
		} {
			還是和歷年一樣，
			只有形式上的監視嗎……{wait}
		} {
			#0601F哼……
			……等著瞧吧……{wait}
		}
		TextWait
		if !flag[6]:
			Emote field_party[0] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Emote field_party[1] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Emote field_party[2] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Emote field_party[3] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Sleep 1000ms
			TextTalk name[2] {
				#0200F（似乎很不爽呢。）{wait}
			}
			TextWait
			TextTalk name[1] {
				#0100F（他看上去好像挺疲倦的，
				　還是不要打擾他了吧。）{wait}
			}
			TextWait
			FlagSet flag[6]
	CharSetChipPattern self 0
	TextEnd self
	Return

