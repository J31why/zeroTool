fn[4]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if flag[1362]:
		if flag[0]:
			TextTalk char[0] {
				聽說那些遊擊士在紀念慶典期間
				也連日表現活躍呢。{wait}
			}
			TextWait
			TextTalk char[0] {
				呵呵，果然厲害呢。{wait}
			}
			TextWait
		else:
			TextTalk char[0] {
				聽說那些遊擊士在紀念慶典期間
				也表現活躍呢。{wait}
			}
			TextWait
			TextTalk char[0] {
				呵呵，真不愧是
				『支援之手甲』──遊擊士協會呀。{wait}
			}
			TextWait
			TextTalk char[0] {
				無論何時
				都是市民的夥伴……
				再沒有比他們更可靠的人了……{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1292]:
		TextTalk char[0] {
			唔……送披薩的人
			剛才路過了這裡。{wait}
		}
		TextWait
		TextTalk char[0] {
			竟然有人在紀念慶典時
			還待在家裡
			吃披薩嗎？{wait}
		}
		TextWait
	elif flag[1282]:
		if flag[0]:
			TextTalk char[0] {
				朋友邀請我
				去參加宴會，
				差不多該走了。{wait}
			}
			TextWait
			TextTalk char[0] {
				哎呀呀，雖然是
				每年的例行公事，但還真麻煩呀。{wait}
			}
			TextWait
		else:
			TextTalk char[0] {
				好，走吧。{wait}
			}
			TextWait
			TextTalk char[0] {
				今年也有人
				邀請我參加宴會。
				差不多該走了。{wait}
			}
			TextWait
			TextTalk char[0] {
				唉，真是的……
				雖然是每年的例行公事，但還真麻煩呀。{wait}
			}
			TextWait
			FlagSet flag[0]
	else:
		TextTalk char[0] {
			紀念慶典，很好很好。{wait}
		}
		TextWait
		TextTalk char[0] {
			市長似乎也平安無事，
			沒有比這更值得慶賀的了。{wait}
		}
		TextWait
		TextTalk char[0] {
			稍後我也去
			逛一圈吧。{wait}
		}
		TextWait
	CharSetChipPattern self 0
	TextEnd self
	Return

fn[5]:
	TextStart self
	if flag[1307]:
		TextTalk char[1] {
			慶典到今天也該收場了。{wait}
		}
		TextWait
		TextTalk char[1] {
			今天想到的事請
			就必須要在今天全部做完。{wait}
		}
		TextWait
	elif flag[1362]:
		TextTalk char[1] {
			糟了，忘記
			帶相機了……{wait}
		}
		TextWait
		TextTalk char[1] {
			算了，反正
			明天的克洛斯貝爾時報周刊
			也會登照片的吧。{wait}
		}
		TextWait
	elif flag[1292]:
		if flag[1]:
			TextTalk char[1] {
				唔，我也去
				找個好地方吧。{wait}
			}
			TextWait
		else:
			TextTalk char[1] {
				遊行是從警察局總部的
				旁邊開始的。{wait}
			}
			TextWait
			TextTalk char[1] {
				唔，大概還要過一陣
				才能走到這邊吧。{wait}
			}
			TextWait
			TextTalk char[1] {
				……我也先去
				找個好地方吧。{wait}
			}
			TextWait
			FlagSet flag[1]
	elif flag[1282]:
		TextTalk char[1] {
			聽說有扒手
			混在人群裡
			為非作歹呢。{wait}
		}
		TextWait
		TextTalk char[1] {
			警官剛才提醒大家小心了，
			你們也當心點吧。{wait}
		}
		TextWait
	else:
		TextTalk char[1] {
			……紀念慶典真是華麗壯觀。{wait}
		}
		TextWait
		TextTalk char[1] {
			……願克洛斯貝爾輝煌永存。{wait}
		}
		TextWait
		TextTalk char[1] {
			唔，慶典真不錯啊。
			只要是克洛斯貝爾人，
			都會覺得激動不已的。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[6]:
	TextStart self
	if flag[1362]:
		Emote char[2] 0mm 2000mm 38 39 250ms 2
		Sleep 500ms
		TextTalk char[2] {
			遊行好精彩啊～！{wait}
		}
		TextWait
		TextTalk char[2] {
			來看遊行
			真是來對了～！{wait}
		}
		TextWait
	elif flag[1292]:
		TextTalk char[2] {
			今天的遊行
			好像會經過住宅區呢。{wait}
		}
		TextWait
		TextTalk char[2] {
			呵呵，好期待哦～{wait}
		}
		TextWait
	elif flag[1282]:
		TextTalk char[2] {
			今天打算
			去歡樂街那邊。{wait}
		}
		TextWait
		TextTalk char[2] {
			我先生讓我們
			出去玩玩，
			一定要玩個痛快呢。{wait}
		}
		TextWait
	elif flag[2]:
		TextTalk char[2] {
			我先生時不時
			就會說些令人開心的話。{wait}
		}
		TextWait
		TextTalk char[2] {
			呵呵，他怎麼知道
			我在想什麼呢？{wait}
		}
		TextWait
	else:
		TextTalk char[2] {
			我先生讓我帶女兒
			出去逛一圈。{wait}
		}
		TextWait
		TextTalk char[2] {
			他那個人呀……
			時不時就會說些
			體貼人的話呢。{wait}
		}
		TextWait
		TextTalk char[2] {
			呵呵，機會難得嘛，
			我就恭敬不如從命了吧。{wait}
		}
		TextWait
		FlagSet flag[2]
	TextEnd self
	Return

fn[7]:
	TextStart self
	if flag[1362]:
		_Char4A char[2] 255
		TextTalk char[3] {
			咳咳，媽媽，
			您別太興奮了，
			很丟人啊。{wait}
		}
		TextWait
		_Char4B char[2] 255
	elif flag[1292]:
		_Char4A char[2] 255
		Emote char[3] 0mm 1700mm 40 43 100ms 0
		Sleep 500ms
		TextTalk char[3] {
			媽媽，再不快一點的話，
			遊行就要開始了！{wait}
		}
		TextWait
		EmoteStop char[3]
		_Char4B char[2] 255
	elif flag[1282]:
		if flag[3]:
			TextTalk char[3] {
				瑪麗還小，
				父親又有工作嘛。
				……桑妮塔會忍耐的。{wait}
			}
			TextWait
		else:
			TextTalk char[3] {
				既然要出去逛，
				要是瑪麗和爸爸
				也一起去就好了……{wait}
			}
			TextWait
			TextTalk char[3] {
				當、當然了，桑妮塔
				是不會提出這麼任性的要求的。{wait}
			}
			TextWait
			FlagSet flag[3]
	else:
		_Char4A char[2] 255
		TextTalk char[3] {
			媽媽，桑妮塔
			想吃手工冰淇淋呢。{wait}
		}
		TextWait
		TextTalk char[3] {
			今天請給我一些零用錢吧。{wait}
		}
		TextWait
		_Char4B char[2] 255
	TextEnd self
	Return

fn[8]:
