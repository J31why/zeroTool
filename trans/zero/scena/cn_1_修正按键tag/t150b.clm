	}
	TextWait
	TextTalk char[9] {
		#15101066V#1304F#11P呵呵……{wait}
	} {
		#15101067V#1302F我想，最重要的是，
		你們要守護什麼，怎樣去守護。{wait}
	} {
		#15101068V只要不迷失這一點，
		就一定能找到答案的。{wait}
	} {
		#15101069V#1309F沒問題……
		你們一定能做到的。{wait}
	}
	TextWait
	TextTalk name[0] {
