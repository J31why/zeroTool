	}
	TextWait
	TextTalk char[7] {
		#15101072V#2004F#11P呵呵，我想說的話
		基本都被說完了呢。{wait}
	} {
		#15101073V#2001F──拘留所那邊也遭到了襲擊，
		警備隊似乎也相當混亂……{wait}
	} {
		#15101074V我們準備聯同貝爾加德門的部隊
