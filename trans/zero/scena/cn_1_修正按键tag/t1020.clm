fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharIdle self (97550, null, 16140) (102740, null, 18340) 1000mm/s
		Sleep 150ms
	Return

fn[2]:
	while 1:
		CharIdle self (940, null, 10450) (4860, null, 14310) 1000mm/s
		Sleep 300ms
	Return

fn[3]:
	if system[0] == 107 && flag[1313] && flag[1314] && flag[1315] && !flag[1316]:
