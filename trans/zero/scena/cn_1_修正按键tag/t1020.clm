		LookPointFlagsUnset look_point[1] 0x0001
	ObjFlagsUnset object[2] 0x0010
	Return

fn[5]:
	TextStart self
	if flag[1333]:
	elif flag[1330]:
	elif flag[1329]:
	elif flag[1320]:
	elif flag[1319]:
	elif flag[1318]:
		if !flag[0]:
			Call fn[0,8]
		else:
			TextTalk self {
				……真是的，一點教養都沒有的遊客。{wait}
			}
			TextWait
	elif flag[1312]:
		TextTalk self {
			呼……真是的，
			這裡無論何時都很混亂啊。{wait}
		}
		TextWait
		TextTalk self {
			想買個東西都那麼辛苦。{wait}
		}
		TextWait
	elif flag[1307]:
	TextEnd self
	Return

fn[6]:
