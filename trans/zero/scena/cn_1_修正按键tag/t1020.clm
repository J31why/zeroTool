fn[9]:
	TextStart self
	if !flag[1]:
		TextTalk self {
			這裡是餐廳《幸運》……
			嗯，果然是家
			豪華的餐廳啊。{wait}
		}
		TextWait
		TextTalk self {
			……但重點是料理的味道！
			身為美食家的我，
			是不會被餐廳的裝修迷惑的。{wait}
		}
		TextWait
		FlagSet flag[1]
	else:
