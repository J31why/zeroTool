	TextTalk name[0] {
		#14200231V#12P#0006F……真是服了他們。{wait}
	}
	TextWait
	TextTalk name[1] {
		#14200232V#5P#0106F是啊，雖然很感謝他
		能告訴我們這麼多……{wait}
	} {
		#14200233V#0101F但真沒想到，竟會那麼露骨地暗示
		他們準備認真開戰啊……{wait}
	}
	TextWait
	TextTalk name[3] {
		#14200234V#0303F#5P再這樣下去，
		真有可能會演變為慘烈的血戰呢。{wait}
	} {
		#14200235V#0301F搞不好的話，下次就有可能直接在市中心開戰了。{wait}
	}
	TextWait
	TextTalk name[2] {
		#14200236V#6P#0206F而且，還有從『黑月』總部
		派來增援的可能性……{wait}
	} {
		#14200237V#0211F火藥味真是相當濃烈啊。{wait}
	}
	TextWait
	Emote name[0] 0mm 2000mm 24 27 250ms 0
	Sleep 2000ms
	EmoteStop name[0]
	TextTalk name[0] {
		#14200238V#12P#0003F……不過，既然曹先生那樣說，
		他們目前應該也還有些猶豫吧。{wait}
	} {
		#14200239V#0013F總而言之，關於魯巴徹
		這次的襲擊，疑點實在是太多了。{wait}
	} {
		#14200240V在黑月發起正式反擊之前，
		我們還是努力多調查一下為好。{wait}
	}
	TextWait
	TextTalk name[1] {
		#14200241V#5P#0101F嗯，是啊。{wait}
	}
	TextWait
	TextTalk name[2] {
		#14200242V#6P#0205F也就是說，今天也
		要去各處打探嗎？{wait}
	}
	TextWait
	TextTalk name[0] {
		#14200243V#12P#0003F不……{wait}
	} {
		#14200244V#0000F──在如今這種情況下，
		還是直接去魯巴徹一趟吧？{wait}
	}
