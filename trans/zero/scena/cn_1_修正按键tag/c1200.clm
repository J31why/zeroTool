	TextTalk name[3] {
		#14200245V#0305F#5P你認真的嗎……！？{wait}
	}
	TextWait
	TextTalk name[1] {
		#14200246V#5P#0106F雖、雖然以前也
		曾去拜訪過……{wait}
	}
	TextWait
	TextTalk name[2] {
		#14200247V#6P#0201F但是畢竟發生過那起拍賣會事件，
		直接過去的話，終究還是太過魯莽了吧？{wait}
	}
	TextWait
	TextTalk name[0] {
		#14200248V#12P#0006F……嗯。
		所謂的和解，也僅限於琪雅
		那一件事情而已。{wait}
	} {
		#14200249V#0008F只是，有件事情，
		我實在是非常在意……{wait}
	}
	TextWait
	TextTalk name[2] {
		#14200250V#6P#0205F非常在意的事是指……？{wait}
	}
	TextWait
	TextTalk name[0] {
		#14200251V#12P#0001F加爾西亞的動向。{wait}
	} {
		#14200252V交手的這幾次看起來，
		那個人絕不是愚蠢無謀之輩。{wait}
	} {
		#14200253V而且，他還給人一種很能服眾，
		統率能力極強的感覺。{wait}
	}
	TextWait
	TextTalk name[3] {
		#14200254V#0303F#5P的確，因為他原本就是
		一個有名獵兵團的部隊長呢。{wait}
	} {
		#14200255V#0301F從常理來說，這種人絕不會
		輕易發動毫無意義的襲擊……{wait}
	}
