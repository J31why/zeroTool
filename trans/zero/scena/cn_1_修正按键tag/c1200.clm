		這個食譜就送給你們好了。{wait}
	}
	TextWait
	FadeOut 300ms 0x00000000 100
	TextSetPos -1 -1 -1 -1
	TextSetName ""
	SoundPlay sound[17] 0 100 0
	TextMessage null {
		學習了{item[401]}{color 0}的做法。{wait}
	}
	TextWait
	TextMessage null {
