fn[76]:
	TextStart null
	FadeOut 300ms 0x00000000 100
	TextSetName ""
	TextSetPos -1 -1 -1 -1
	TextMessage null {
		{color 5}前往『克洛斯貝爾市』的水上巴士・時刻表
		※期待著您的
		下次乘坐！{wait}
	}
	TextWait
	TextClose 0
	FadeIn 300ms 0x00000000
	_59
	TextSetPos -1 280 60 3
	TextEnd null
	Return
