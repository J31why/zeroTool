fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if flag[1341] && !flag[1342]:
		Event fn[0,9]
	if flag[736]:
		FlagUnset flag[736]
		Event fn[0,38]
	CharFlagsUnset char[0] 0x0080
	CharFlagsUnset char[1] 0x0080
	CharFlagsUnset char[2] 0x0080
	CharFlagsUnset char[3] 0x0080
	CharFlagsUnset char[4] 0x0080
	Return

fn[2]:
	if flag[1333]:
	ObjFlagsSet object[1] 0x0004
	if 1:
		LookPointFlagsSet look_point[0] 0x0001
	else:
		EffLoad eff[8] "eff\\mgm03_02.eff"
		EffPlay eff[8] eff_instance[8] null 0 (-24490, -6000, -38830) 0 0 0 1000 1000 1000 null (0, 0, 0) 0ms
	ObjFlagsSet object[12] 0x0004
	ObjFlagsSet object[13] 0x0004
	ObjFlagsSet object[14] 0x0004
	if flag[1319] && !flag[1320]:
		ObjFlagsUnset object[12] 0x0004
		ObjFlagsUnset object[13] 0x0004
		ObjFlagsUnset object[14] 0x0004
	SoundPlay sound[126] 1 80 0
	Return

fn[3]:
	TextStart self
	if !flag[0]:
		TextTalk self {
			駛往克洛斯貝爾市的水上巴士
			已經到達。{wait}
		}
		TextWait
		TextTalk self {
			回程的乘客
			請在這邊稍等片刻～{wait}
		}
		TextWait
		FlagSet flag[0]
	else:
		TextTalk self {
			返回克洛斯貝爾市的乘客
			請在這邊排隊～{wait}
		}
		TextWait
	TextEnd self
	Return

fn[4]:
	TextStart self
	TextTalk self {
		本想來這裡找個
		出身名門的女朋友……{wait}
	}
	TextWait
	TextTalk self {
		但我根本搞不定這裡的女人。
		關於這一點，我總算是得到深刻教訓了……{wait}
	}
	TextWait
	TextEnd self
	Return

fn[5]:
	TextStart self
	TextTalk self {
		哼……終於到了。{wait}
	}
	TextWait
	TextTalk self {
		離拍賣會開始，沒有多少時間了啊……
		稍微抓緊一點吧。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[6]:
	TextStart self
	TextTalk self {
		我和朋友一整天
		都在主題樂園遊玩。{wait}
	}
	TextWait
	TextTalk self {
		回過神的時候，都已經是晚上了，
		真是嚇了一大跳呢。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[7]:
	TextStart self
	TextTalk self {
		不好，船好像都要開了！
		快走吧！{wait}
	}
	TextWait
	TextEnd self
	Return

fn[8]:
	EventBegin 1
	SoundPlay sound[1094] 255 100 0
	TextTalk name[0] {
		#0000F這裡的話似乎可以釣到魚。{wait}
	}
	TextWait
	CamSetDistance -23140 -2400 -43580 1500ms
	ED7CamRotate 315deg 36deg 0deg 1500ms
	CamPers 200 1500ms
	CamZoom 50000 1500ms
	Sleep 1000ms
	TextSetName ""
	TextMessage null {
		{color 5}要釣魚嗎？{color 0}{wait}
	}
	Menu menu[0] -1 -1 1
		"釣魚" // 0
		"放棄" // 1
	MenuWait var[0]
	MenuClose menu[0]
	TextClose 0
	_59
	CamWait 1
	if var[0] == 0:
		ED7_E0 2
		Minigame 6 3 -24500 -4000 -46830 0 -24490 -6000 -38830
	ED7_E0 2
	EventEnd 4
	Return

