fn[2]:
	if system[0] != 100 && system[0] != 101:
		CharFlagsSet char[0] 0x0008
		CharFlagsSet char[1] 0x0008
		ObjFlagsSet object[9] 0x0004
	else:
		CharFlagsUnset char[0] 0x0008
		CharFlagsUnset char[1] 0x0008
		ObjFlagsUnset object[9] 0x0004
	if system[0] != 102 && system[0] != 103 && system[0] != 104 && system[0] != 105 && system[0] != 106 && system[0] != 107 && system[0] != 108 && system[0] != 109:
		CharFlagsSet char[2] 0x0008
		CharFlagsSet char[3] 0x0008
	else:
		CharFlagsUnset char[2] 0x0008
		CharFlagsUnset char[3] 0x0008
	if system[0] != 111:
		CharFlagsSet char[5] 0x0008
		ObjFlagsSet object[7] 0x0004
	else:
		CharFlagsUnset char[5] 0x0008
		ObjFlagsUnset object[7] 0x0004
	if system[0] != 113:
		CharFlagsSet char[4] 0x0008
	else:
		CharFlagsUnset char[4] 0x0008
	Return

fn[3]:
	ED7_F2 1
	SystemFlagsSet 0x08000000
	if !flag[2275]:
		SoundPlay sound[14] 0 100 0
		ED7ObjPlay object[7] 0 30 0 0
		Sleep 500ms
		if ItemAdd item[417] 1:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextSetName ""
			TextMessage name[742] {
				{color 0}已取得{item[417]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			TextSetPos -1 280 60 3
			FadeIn 300ms 0x00000000
			FlagSet flag[2275]
			ED7_DE 6
		else:
			FadeOut 300ms 0x00000000 100
			TextSetName ""
			TextMessage name[742] {
				寶箱內裝著{item[417]}{color 0}。
				但因持有物品已滿而放棄{item[417]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			SoundPlay sound[15] 0 100 0
			ED7ObjPlay object[7] 30 0 0 0
	else:
		FadeOut 300ms 0x00000000 100
		TextSetPos -1 -1 -1 -1
		TextSetName ""
		TextMessage name[742] {
			{0x06}{color 5}寶箱內空無一物。{color 0}{wait}
		}
		TextWait
		TextClose 0
		FadeIn 300ms 0x00000000
	Sleep 30ms
	TextEnd null
	SystemFlagsUnset 0x08000000
	Return

