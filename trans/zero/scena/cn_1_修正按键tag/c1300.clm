fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if system[0] == 102:
		CharSetPos field_party[0] (-230, -1450, -33980) 0deg
		CharSetPos field_party[1] (-230, -1450, -33980) 0deg
		CharSetPos field_party[2] (-230, -1450, -33980) 0deg
		CharSetPos field_party[3] (-230, -1450, -33980) 0deg
		if system[15] != 255:
			CharSetPos field_party[4] (-230, -1450, -33980) 0deg
			CharSetPos field_party[5] (-230, -1450, -33980) 0deg
		elif system[14] != 255:
			CharSetPos field_party[4] (-230, -1450, -33980) 0deg
		system[0] = 100
	global[7] = 11
	if flag[736]:
		FlagUnset flag[736]
		Event fn[0,6]
	if flag[1040] && !flag[1041]:
		SystemFlagsSet 0x10000000
		Event fn[0,8]
	elif flag[1047] && !flag[1049]:
		Event fn[0,9]
	elif !flag[666]:
		FlagSet flag[666]
	CharFlagsSet char[1] 0x0080
	if flag[1792]:
		CharSetPos char[0] (-2040, 0, -21950) 0deg
		CharFlagsSet char[0] 0x0010
		CharFlagsUnset char[1] 0x0080
	elif flag[1566]:
	elif flag[1554]:
	elif flag[1536]:
		CharSetPos char[0] (2610, 0, 2230) 160deg
	elif flag[1342]:
		CharSetPos char[0] (-180, 0, -22030) 180deg
	elif flag[1055]:
	elif flag[1040]:
	elif flag[1031]:
	elif flag[1024]:
	elif flag[801]:
	elif flag[768]:
	elif flag[777]:
	else:
		CharSetPos char[0] (-180, 0, -22030) 180deg
	if !flag[768] && !flag[572]:
		SystemFlagsSet 0x10000000
		Event fn[0,7]
	Return

fn[2]:
	if flag[1040] && !flag[1049]:
		system[1] = 111
	if flag[1037] && !flag[1038]:
		MapColor 0x00B4BEFF 0ms
		ED7_76_0 object[255] "sky" 1
		ED7_76_1 object[255] "sky1" 1
		ED7_76_0 object[255] "sd_mul" 1
	elif flag[1792]:
		MapColor 0x00B4BEFF 0ms
		ED7_76_0 object[255] "sky" 1
		ED7_76_1 object[255] "sky1" 1
		ED7_76_0 object[255] "sd_mul" 1
	else:
		ED7_76_1 object[255] "sky" 1
		ED7_76_0 object[255] "sky1" 1
		ED7_76_1 object[255] "sd_mul" 1
	ObjFlagsSet object[2] 0x0004
	LookPointFlagsSet look_point[1] 0x0001
	if !flag[1554] && flag[1536]:
		ObjFlagsUnset object[2] 0x0004
		ED7_76_0 object[2] "light" 1
		LookPointFlagsUnset look_point[1] 0x0001
	if flag[1536] && !flag[1554]:
	ObjFlagsUnset object[1] 0x0010
	ObjFrame object[1] 20
	if flag[525] && !flag[768]:
		ObjFrame object[1] 0
	if flag[1342] && !flag[1536]:
		ObjFrame object[1] 0
	if flag[1792]:
		ObjFrame object[1] 0
	if flag[1537] && !flag[1542] && global[1] == 1:
	else:
		ZeroMap_3 29 1
	Return

fn[3]:
	TextStart self
	if flag[1792]:
		if flag[0]:
			TextTalk self {
				不好意思啊，ＩＢＣ的營業時間
				只到四點半哦。{wait}
			}
			TextWait
			TextTalk self {
				衷心期待您的再次光臨。{wait}
			}
			TextWait
		else:
			TextTalk self {
				門鎖ＯＫ。{wait}
			}
			TextWait
			TextTalk self {
				門鎖沒有異常，完畢～！{wait}
			}
			TextWait
			FlagSet flag[0]
			CharFlagsUnset char[0] 0x0010
	elif flag[1566]:
		if flag[0]:
			TextTalk self {
				我們的保安部門十分優秀哦。
				關於市內的事件，我們也接到了報告。{wait}
			}
			TextWait
			TextTalk self {
				但是，出現失蹤人員這種事情，
				畢竟還是警察的工作吧。{wait}
			}
			TextWait
		else:
			TextTalk self {
				從保安部門那裡
				接到了令人在意的報告。{wait}
			}
			TextWait
			TextTalk self {
				市內好像接連出現了
				失蹤者呢……{wait}
			}
			TextWait
			TextTalk self {
				嗯，但那些畢竟
				都是警察的工作啊。
				至少ＩＢＣ這邊今天還是很平靜。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1554]:
		if flag[0]:
			TextTalk self {
				港灣區那邊剛剛
				發生過槍擊事件，
				警備工作也不能鬆懈大意啊。{wait}
			}
			TextWait
		else:
			TextTalk self {
				之前接到了報告，港灣區
				似乎發生了槍擊事件呢。{wait}
			}
			TextWait
			TextTalk self {
				聽說好像是黑手黨
				之間的爭鬥……{wait}
			}
			TextWait
			TextTalk self {
				今天比平時增加了
				更多的警備力量哦。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1536]:
		if flag[0]:
			TextTalk self {
				好像聊得莫名地很起勁呢。{wait}
			}
			TextWait
			TextTalk self {
				從打扮來看，似乎像是個遊手好閒的傢伙，
				……但卻是總裁的熟人嗎？{wait}
			}
			TextWait
		else:
			TextTalk self {
				庫羅伊斯總裁回來了呢，
				我像往常一樣走上前迎接……{wait}
			}
			TextWait
			TextTalk self {
				嗯～那個年輕人到底是誰呢？
				是總裁的熟人嗎……{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1342]:
		if flag[0]:
			TextTalk self {
				順便一說，總裁去國外出差了，
				瑪利亞貝爾小姐
				也出門了。{wait}
			}
			TextWait
			TextTalk self {
				說是在行政區那邊
				有些事情要處理。{wait}
			}
			TextWait
		else:
			TextTalk self {
				哎呀，是客人嗎？
				不好意思，今天是銀行的休息日哦。{wait}
			}
			TextWait
			TextTalk self {
				從原則上說，除了相關人員之外，
				都是禁止進入的。
				呵，請諒解啊。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1055]:
		if flag[0]:
			TextTalk self {
				聽說，好像有人透過導力網路的線路
				進行入侵。{wait}
			}
			TextWait
			TextTalk self {
				哎呀呀，那可是我們的警備範圍之外啊。
				技術部的那些傢伙們
				必須要再努力些才行啊。{wait}
			}
			TextWait
		else:
			TextTalk self {
				ＩＢＣ總部大樓的
				警備體制沒有任何問題。{wait}
			}
			TextWait
			TextTalk self {
				因為我們保安部門的人
				二十四小時都在值班哦。{wait}
			}
			TextWait
			TextTalk self {
				可是……像駭客這種我們不太瞭解
				的東西，可就沒法防範了啊。{wait}
			}
			TextWait
			TextTalk self {
				哎呀呀，這就在警備範圍之外了啊。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1040]:
		if flag[0]:
			TextTalk self {
				有事情要辦的話就請去裡面。{wait}
			}
			TextWait
			TextTalk self {
				大廳的正面有綜合接待櫃檯哦。{wait}
			}
			TextWait
		else:
			FlagSet flag[0]
			TextTalk self {
				您好，
				今天也是個好天氣啊。{wait}
			}
			TextWait
			TextTalk self {
				這裡與市區有一定距離，
				早上的空氣非常清新。{wait}
			}
			TextWait
			TextTalk self {
				能讓人精神十足，努力一整天啊。{wait}
			}
			TextWait
	elif flag[1031]:
		if flag[0]:
			TextTalk self {
				我們警備員
				絕不干涉顧客的私事。{wait}
			}
			TextWait
			TextTalk self {
				……這也是出自於保全面的考量。{wait}
			}
			TextWait
		else:
			TextTalk self {
				今天有一位
				非常沮喪的客人呢。{wait}
			}
			TextWait
			TextTalk self {
				大概是做生意失敗了吧。{wait}
			}
			TextWait
			TextTalk self {
				……算啦，我畢竟是警備員。
				總不能去和他搭話啊。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1024]:
		if flag[0]:
			TextTalk self {
				迎接庫羅伊斯總裁
				是我的任務。{wait}
			}
			TextWait
			TextTalk self {
				順便一說，在市內活動的時候，
				總裁都會駕駛他那輛紅色的豪華轎車。{wait}
			}
			TextWait
		else:
			TextTalk self {
				ＩＢＣ集團的首席人物
				庫羅伊斯總裁是個
				非常忙碌的人呢。{wait}
			}
			TextWait
			TextTalk self {
				平時總是飛往國外，
				難得回來一趟。{wait}
			}
			TextWait
			TextTalk self {
				當他偶爾回來時，
				就必須充滿誠意地去迎接呢。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[801]:
		if flag[0]:
			TextTalk self {
				這裡地勢很高，視野非常好，
				很適合進行警備工作。{wait}
			}
			TextWait
			TextTalk self {
				真是個毫無缺陷的工作地點啊，
				而在大樓內工作的職員們
				也都很中意這個地方呢。{wait}
			}
			TextWait
		else:
			TextTalk self {
				我經常這麼想，
				ＩＢＣ的建造地點真不錯呢。{wait}
			}
			TextWait
			TextTalk self {
				可以對市內一覽無餘的高層建築，
				以及緩緩流淌的河水。{wait}
			}
			TextWait
			TextTalk self {
				附近的綠化工作也做得很好，
				真是個毫無缺陷的工作地點呢。{wait}
			}
			TextWait
			TextTalk self {
				這裡的視野非常不錯，
				所以就保全而言安全性也很高。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[777]:
		if flag[0]:
			TextTalk self {
				對了對了，當年正好趕上了
				五年一度的市長選舉。{wait}
			}
			TextWait
			TextTalk self {
				對當時還身為新人的我來說，
				真是非常忙碌的一年啊。{wait}
			}
			TextWait
		else:
			TextTalk self {
				從我被安排到保安部門算起，
				到現在都已經十年了。{wait}
			}
			TextWait
			TextTalk self {
				當時這幢大樓正好剛竣工，{wait}
			}
			TextWait
			TextTalk self {
				那年真是忙得不得了呢。
				到任之後，立刻就要開始
				向總部大樓轉移的工作。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[768]:
		if flag[0]:
			TextTalk self {
				歡迎光臨ＩＢＣ總部大樓。
				有什麼要事嗎？{wait}
			}
			TextWait
			TextTalk self {
				請您隨意吩咐。{wait}
			}
			TextWait
		else:
			TextTalk self {
				您好，
				歡迎光臨ＩＢＣ總部大樓。{wait}
			}
			TextWait
			TextTalk self {
				哈哈，吃了一驚嗎？
				這確實是座氣派的大樓吧。{wait}
			}
			TextWait
			TextTalk self {
				初次來訪的人大多都會很驚訝的。
				不過，要是在這裡工作，很快就會習慣的。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[0]:
		TextTalk self {
			ＩＢＣ今天
			暫停營業。{wait}
		}
		TextWait
		TextTalk self {
			從原則上說，除了相關人員之外，
			都是禁止進入的。{wait}
		}
		TextWait
	else:
		TextTalk self {
			您好，今天的天氣真不錯啊。{wait}
		}
		TextWait
		TextTalk self {
			ＩＢＣ今天
			暫停營業。{wait}
		}
		TextWait
		TextTalk self {
			如果是來提款的，那可就不巧啦。
			請改天再來吧。{wait}
		}
		TextWait
		FlagSet flag[0]
	TextEnd self
	Return

fn[4]:
	TextStart self
	if flag[1]:
		TextTalk self {
			我正在檢查
			大門的門鎖呢。{wait}
		}
		TextWait
		TextTalk self {
			不好意思，能不能不要打擾我呢？{wait}
		}
		TextWait
	else:
		TextTalk self {
			哎呀，已經到關門時間了。{wait}
		}
		TextWait
		TextTalk self {
			客人也都已經回去了。
			如果想提款，
			就請明天再來吧。{wait}
		}
		TextWait
		FlagSet flag[1]
	TextEnd self
	Return

fn[5]:
	TextStart null
	if !flag[1695] && !flag[2]:
