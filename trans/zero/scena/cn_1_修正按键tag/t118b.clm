fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharIdle self (-1590, null, -70940) (1110, null, -66450) 1000mm/s
		Sleep 300ms
	Return

fn[2]:
	while 1:
		CharIdle self (-1150, null, -16830) (990, null, -3730) 1000mm/s
		Sleep 300ms
	Return

fn[3]:
	while 1:
		ED7CharAnimation self 2000ms 0 1 2 3 4
	Return

fn[4]:
	if flag[1333]:
	elif flag[1330]:
		CharFlagsUnset char[4] 0x0080
		ForkFunc char[4] fork[0] fn[0,2]
	elif flag[1329]:
	elif flag[1320]:
		CharFlagsUnset char[0] 0x0080
		CharFlagsUnset char[1] 0x0080
		ForkFunc char[1] fork[0] fn[0,1]
		CharFlagsUnset char[2] 0x0080
		CharFlagsUnset char[3] 0x0080
	Return

fn[5]:
	if flag[1333]:
	if flag[1342]:
	elif flag[1336]:
		if system[0] == 101 | system[0] == 107:
			if random % 100 < 50:
				Event fn[0,11]
	Return

fn[6]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if !flag[0]:
		TextTalk self {
			據說，今天展出的重頭商品
			是一個做工非常精巧的人偶。{wait}
		}
		TextWait
		TextTalk self {
			說到做工精巧，
			當然首推羅贊貝爾克工房製造的人偶啦。{wait}
		}
		TextWait
		TextTalk self {
			哎呀，好期待拍賣會開場啊。{wait}
		}
		TextWait
		FlagSet flag[0]
	else:
		TextTalk self {
			羅贊貝爾克工房製造的人偶
			仿佛擁有生命一樣，
			散發著難以言喻的魅力。{wait}
		}
		TextWait
		TextTalk self {
			哎呀，好期待拍賣會開場啊。{wait}
		}
		TextWait
	CharSetChipPattern self 0
	TextEnd self
	Return

fn[7]:
	TextStart self
	if !flag[1]:
		TextTalk self {
			我老公一提到關於人偶的事情，
			就會變得非常激動呢。{wait}
		}
		TextWait
		TextTalk self {
			一開始，我還覺得人偶
			這種東西很平常……{wait}
		}
		TextWait
		TextTalk self {
			不過，一旦感受到了它的魅力，
			我也產生興趣了。{wait}
		}
		TextWait
		FlagSet flag[1]
	else:
		TextTalk self {
			感受到人偶的魅力之後，
			我們夫婦二人便開始
			齊心協力地收集了。{wait}
		}
		TextWait
		TextTalk self {
			花費多少米拉都無所謂，
			就想讓它們陪在自己的身邊……
			人偶就是有這樣的魅力。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[8]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	TextTalk self {
		連座位都沒有的餐會嗎，
		那種活動實在是沒興趣參加。{wait}
	}
	TextWait
	TextTalk self {
		用餐的時候，一定要有女僕
		把料理送到面前才行。{wait}
	}
	TextWait
	CharSetChipPattern self 0
	TextEnd self
	Return

fn[9]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	TextTalk self {
		偶然從朋友那裡
		得到了邀請函……
		但我好像不太適合這種環境啊。{wait}
	}
	TextWait
	TextTalk self {
		在拍賣會開始之前，
		還是在這裡等著吧。{wait}
	}
	TextWait
	CharSetChipPattern self 0
	TextEnd self
	Return

fn[10]:
	TextStart self
	TextTalk self {
		……嗯……
		本來想參觀一下宅邸的……{wait}
	}
	TextWait
	TextTalk self {
		看樣子，好像是迷路了呢。{wait}
	}
	TextWait
	TextTalk self {
		真頭痛啊……
		拍賣會
		馬上就要開始了。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[11]:
	EventBegin 0
	FadeOut 0ms 0x00000000 255
	var[3] = system[0]
	system[0] = 100
	ED7LoadChip "chr/ch00050.itc" chip[30]
	if PartyPosition name[1] > -1:
		ED7LoadChip "chr/ch00150.itc" chip[31]
	elif PartyPosition name[2] > -1:
		ED7LoadChip "chr/ch00250.itc" chip[31]
	else:
		ED7LoadChip "chr/ch00350.itc" chip[31]
	ED7LoadChip "chr/ch00450.itc" chip[32]
	CharSetChipBase name[0] chip[30]
	CharSetChipBase party[1] chip[31]
	CharSetChipBase name[4] chip[32]
	CharSetChipPattern name[0] 0
	CharSetChipPattern party[1] 0
	CharSetChipPattern name[4] 0
	CharFlagsUnset name[50] 0x0080
	CharFlags2Unset name[50] 0x8000
	CharFlagsSet char[5] 0x8000
	CharFlagsSet char[6] 0x8000
	char[5].36 = 216
	char[6].36 = 216
	char[5].7 = 2000
	char[6].7 = 2000
	ForkFunc char[5] fork[1] fn[0,3]
	Sleep 50ms
	ForkFunc char[6] fork[1] fn[0,3]
	CharFlagsUnset char[5] 0x0080
	CharFlags2Unset char[5] 0x8000
	CharFlagsUnset char[6] 0x0080
	CharFlags2Unset char[6] 0x8000
	if var[3] == 101:
		CamSetDistance 0 1200 -6000 0ms
		ED7CamRotate 315deg 30deg 0deg 0ms
		CamPers 420 0ms
		CamZoom 22000 0ms
		CharSetPos name[0] (0, 0, -6000) 0deg
		CharSetPos party[1] (-750, 0, -7000) 0deg
		CharSetPos name[4] (750, 0, -7750) 0deg
		CharSetPos name[50] (0, 0, -9000) 0deg
		CharSetPos char[5] (0, 0, 0) 180deg
		CharSetPos char[6] (1250, 0, 1000) 180deg
	else:
		CamSetDistance 0 1200 -16000 0ms
		ED7CamRotate 315deg 30deg 0deg 0ms
		CamPers 420 0ms
		CamZoom 22000 0ms
		CharSetPos name[0] (0, 0, -16000) 0deg
		CharSetPos party[1] (-750, 0, -17000) 0deg
		CharSetPos name[4] (750, 0, -17750) 0deg
		CharSetPos name[50] (0, 0, -19000) 0deg
		CharSetPos char[5] (0, 0, -10000) 180deg
		CharSetPos char[6] (1250, 0, -9000) 180deg
	Fork char[5] fork[2]:
		_Char91 char[5] 0 0 -4500 5000 0
	Sleep 50ms
	Fork char[6] fork[2]:
		_Char91 char[6] 0 0 -4500 5000 0
	FadeIn 500ms 0x00000000
	FadeWait
	ForkWait char[5] fork[2]
	ED7Battle battle[0] null 0 0 16 null
	FadeOut 0ms 0x00000000 255
	EventBegin 0
	CharSetChipBase name[0] chip[255]
	CharSetChipBase party[1] chip[255]
	CharSetChipBase name[4] chip[255]
	CharSetChipPattern name[0] 0
	CharSetChipPattern party[1] 0
	CharSetChipPattern name[4] 0
	CharFlagsSet name[50] 0x0080
	CharFlags2Set name[50] 0x8000
	ForkQuit char[5] fork[1]
	ForkQuit char[6] fork[1]
	ForkQuit char[5] fork[2]
	ForkQuit char[6] fork[2]
	CharFlagsSet char[5] 0x0080
	CharFlags2Set char[5] 0x8000
	CharFlagsSet char[6] 0x0080
	CharFlags2Set char[6] 0x8000
	if var[3] == 101:
		CamSetDistance 0 1200 -6000 0ms
		ED7CamRotate 315deg 30deg 0deg 0ms
		CamPers 420 0ms
		CamZoom 25000 0ms
		CharSetPos name[0] (0, 0, -6000) 0deg
		CharSetPos party[1] (0, 0, -6000) 0deg
		CharSetPos name[4] (0, 0, -6000) 0deg
	else:
		CamSetDistance 0 1200 -16000 0ms
		ED7CamRotate 315deg 30deg 0deg 0ms
		CamPers 420 0ms
		CamZoom 25000 0ms
		CharSetPos name[0] (0, 0, -16000) 0deg
		CharSetPos party[1] (0, 0, -16000) 0deg
		CharSetPos name[4] (0, 0, -16000) 0deg
	FadeIn 500ms 0x00000000
	FadeWait
	EventEnd 5
	Return
