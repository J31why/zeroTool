calmare zero_k scena
scena:
	name "e0000" "e0000" "e0000"
	town town[0]
	bgm bgm[0]
	flags 8192
	item_use fn[0,255]
	unk 255 0

entry:
	pos (0, 0, -1000)
	unk1 0
	cam_from (0, 0, 34000)
	cam_pers 262
	unk2 30
	cam_deg 45deg
	cam_limit 0deg 360deg
	cam_at (0, 0, 0)
	unk3 0
	unk4 0
	flags 0x0001
	town town[1]
	init fn[0,0]
	reinit fn[0,1]

fn[0]:
	Event fn[0,2]
	Return

fn[1]:
	Return

fn[2]:
	TextSetName ""
	TextMessage null {
		{color 5}閱覽事件
		{color 0}{wait}
	}
	TextWait
	TextClose 0
	Return
