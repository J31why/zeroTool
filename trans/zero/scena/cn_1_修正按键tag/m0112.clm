fn[0]:
	while 1:
		ED7CharAnimation self 1000ms 0 1 2 3 4 3 2 1
	Return

fn[1]:
	while 1:
		ED7CharAnimation self 1000ms 0 1 2 3 4 5
	Return

fn[2]:
	if system[0] == 0:
		if global[0] == 11:
			global[0] = 0
			Event fn[0,16]
		elif global[0] == 12:
			global[0] = 0
			Event fn[0,18]
	if flag[1792]:
		if flag[724]:
			if QuestTaskGet quest[52] 1:
			elif QuestTaskGet quest[52] 0 && system[0] == 103:
				Event fn[0,9]
	if flag[691]:
		CharFlagsSet char[9] 0x0080
	if flag[692]:
		CharFlagsSet char[10] 0x0080
	if flag[693]:
		CharFlagsSet char[11] 0x0080
	if flag[694]:
		CharFlagsSet char[12] 0x0080
	if flag[695]:
		CharFlagsSet char[13] 0x0080
	Return

fn[3]:
	if flag[691]:
		ED7_76_2 object[13] "m01gim05" "off_kp"
		ObjFlagsUnset object[13] 0x0002
		ED7_76_2 object[255] "simo00" "off_kp"
		ED7_76_2 object[255] "simo00ice02_add" "off_kp"
		TriggerFlagsSet trigger[0] 0x0080
	else:
