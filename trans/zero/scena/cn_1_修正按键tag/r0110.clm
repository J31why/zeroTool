fn[23]:
	TextStart null
	if !flag[1195]:
		if !flag[1024]:
			TextTalk name[0] {
				#0005F話說回來……
				從剛才開始，我就注意到了。{wait}
			} {
				#0001F這個是什麼啊？
				好像在警察局總部
				也有類似的東西……{wait}
			}
			TextWait
			TextTalk name[3] {
				#0305F哦哦，我也一直很在意啊。{wait}
			} {
				#0300F裡面好像擺放了很多果汁
				和咖啡啊。{wait}
			}
			TextWait
			TextTalk name[2] {
				#0202F這是『導力式自動販賣機』。
				兩位是第一次見到嗎？{wait}
			} {
				#0204F只要投入米拉硬幣，
				就可以買到相應
				價格的飲料哦。{wait}
			} {
				這原本是由愛普斯泰恩財團所開發的，
				所以在財團的
				研究設施中經常能看到……{wait}
			} {
				#0202F如今似乎也在克洛斯貝爾
				投入了實驗性使用呢。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F哎，原來如此啊……{wait}
			}
			TextWait
			TextTalk name[3] {
				#0305F大小姐，妳知道嗎？{wait}
			}
			TextWait
			TextTalk name[1] {
				#0104F不，我也是第一次見到。{wait}
			} {
				#0100F不過，由愛普斯泰恩財團
				所研發的裝置
				還真是遍佈各處呢……{wait}
			}
			TextWait
			TextTalk name[2] {
				#0203F聽說是因為有
				實力雄厚的投資者提供資金……{wait}
			} {
				#0200F……各位如果想要使用，
				就請投入硬幣吧。
				因為這種機器無法識別紙幣。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F知、知道了。
				（這個裝置挺少見的……
				　就用一次看看吧。）{wait}
			}
			TextWait
		else:
			FadeOut 300ms 0x00000000 100
			TextSetName ""
			TextMessage null {
				{color 5}有一台導力式自動販賣機。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			_59
			TextTalk name[0] {
				#0005F這個……我記得好像投入硬幣
				就能買到飲料吧。{wait}
			}
			TextWait
			if PartyPosition name[2] > -1:
				TextTalk name[2] {
					#0200F嗯，這是由愛普斯泰恩財團開發的
					自動販賣機。{wait}
				} {
					在克洛斯貝爾
					也投入了實驗性使用。{wait}
				}
				TextWait
			elif PartyPosition name[1] > -1:
				TextTalk name[1] {
					#0100F這個好像是由愛普斯泰恩財團開發的
					自動販賣機……{wait}
				} {
					據緹歐說，
					是財團在克洛斯貝爾
					將其投入實驗性使用的。{wait}
				}
				TextWait
			elif PartyPosition name[3] > -1:
				TextTalk name[3] {
					#0300F這個好像是由愛普斯泰恩財團開發的
					自動販賣機……應該沒記錯吧。{wait}
				} {
					聽小緹說，
					這東西是財團在克洛斯貝爾
					為了試驗而設置的。{wait}
				}
				TextWait
			TextTalk name[0] {
				#0000F真不愧是克洛斯貝爾……
				果然有很多稀奇的東西。{wait}
			}
			TextWait
		FlagSet flag[1195]
	else:
		FadeOut 300ms 0x00000000 100
		FadeWait
		ShopOpen shop[250]
		FadeIn 300ms 0x00000000
		FadeWait
	TextEnd null
	Return
