		} {
			#0100F要注意確認
			拍攝對象有沒有被收入取景框中，
			還要構思攝影角度……{wait}
		} {
			而且受到天氣和風的影響，
			照片所呈現出的感覺也會有很大不同。{wait}
		} {
			有時只要錯過那一瞬的時機，
			就再也拍不到
			那麼好的風景了。{wait}
		}
		TextWait
