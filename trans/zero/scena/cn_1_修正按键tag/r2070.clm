fn[9]:
	EventBegin 0
	FadeOut 0ms 0x00000000 255
	ED7_E0 1
	CamSetDistance 2800 600 -400 0ms
	ED7CamRotate 45deg 21deg 0deg 0ms
	CamPers 510 0ms
	CamZoom 23500 0ms
	CharSetPos name[0] (2200, 0, -1000) 270deg
	CharSetPos name[1] (2200, 0, 300) 270deg
	CharSetPos name[2] (3500, 0, -1000) 270deg
	CharSetPos name[3] (3500, 0, 300) 270deg
	FadeIn 1000ms 0x00000000
	FadeWait
	TextTalk name[0] {
		#11200370V#0005F這邊是……{wait}
	}
	TextWait
	TextTalk name[3] {
		#11200371V#0301F好像是條小道，
		似乎不是通往礦山鎮的吧？{wait}
	}
	TextWait
	TextTalk name[1] {
		#11200372V#0101F嗯……
		地圖上也沒有任何標注呢。{wait}
	}
	TextWait
	TextTalk name[2] {
		#11200373V#0203F總之，聲音
		並不是從這邊傳來的。{wait}
	} {
		#11200374V#0200F還是原路回去為好吧？{wait}
	}
	TextWait
	TextTalk name[0] {
		#11200375V#0003F明白了……原路返回吧。{wait}
	}
	TextWait
	FadeOut 1000ms 0x00000000 255
