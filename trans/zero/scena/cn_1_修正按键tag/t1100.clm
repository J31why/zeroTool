fn[11]:
	EventBegin 1
	if flag[1312] && !flag[1318]:
		TextTalk name[0] {
			#0001F現在還是儘量避開
			魯巴徹那些傢伙吧。{wait}
		} {
			雖然有邀請卡，
			但好像並不是那麼簡單
			就能混進去的……{wait}
		}
		TextWait
	if flag[1318] && !flag[1320]:
		if !flag[0]:
			TextTalk name[80] {
				#5705F……哎，不是要去
				時裝店嗎？{wait}
			} {
				#5702F不過，如果就這樣直接進去，
				然後被黑手黨的那幫傢伙發現，
				好像也挺有趣的呢。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0006F啊，不……
				還是不要那麼做了。{wait}
			} {
				#0001F為了不暴露身份，
				先去時裝店換上正裝吧。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk name[0] {
				#0001F門口有人在看守……
				進入會場之前，還是先到
				時裝店換上正裝吧。{wait}
			}
			TextWait
	Sleep 50ms
	CharSetPos field_party[0] (0, 200, -1700) 180deg
	EventEnd 4
	CamSetDistance 0 1600 -1700 0ms
	CharFlagsSet char[0] 0x8000
	CharFlagsSet char[1] 0x8000
	Return
