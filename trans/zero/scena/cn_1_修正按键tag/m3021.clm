fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		ED7CharAnimation self 1500ms 0 1 2 3 4
	Return

fn[2]:
	while 1:
		ED7CharAnimation self 1500ms 0 1 2 3 4 5
	Return

fn[3]:
	while 1:
		ED7CharAnimation self 1500ms 0 1 2 3 4 5
	Return

fn[4]:
	if flag[1837] && !flag[1838]:
		Event fn[0,21]
	elif system[0] == 105 && flag[1842] && !flag[1843]:
		Event fn[0,25]
	if flag[1843]:
		CharSetPos char[8] (32500, -66000, 2000) 180deg
	if flag[1839] && flag[1840]:
		CharSetPos char[0] (980, 0, 204950) 225deg
		CharSetPos char[1] (2390, 0, 196530) 225deg
		CharSetPos char[2] (740, 0, 195430) 45deg
		CharSetPos char[3] (-5420, 0, 196800) 0deg
		CharSetPos char[4] (-3950, 0, 202880) 180deg
		CharSetPos char[5] (3840, 0, 201430) 270deg
		CharSetPos char[6] (7860, 0, 177060) 225deg
		if flag[1915]:
			CharSetPos char[7] (8560, 0, 175050) 270deg
		else:
			CharSetPos char[7] (8560, 0, 175050) 135deg
		CharFlagsSet char[2] 0x0010
	if flag[736]:
		FlagUnset flag[736]
		Event fn[0,28]
	Return

fn[5]:
	ObjFlagsUnset object[10] 0x0010
	ObjFlagsUnset object[11] 0x0010
	ObjFlagsUnset object[12] 0x0010
	ObjFlagsUnset object[13] 0x0010
	ObjFlagsUnset object[14] 0x0010
	ObjFlagsUnset object[15] 0x0010
	if flag[1839]:
		LookPointFlagsSet look_point[0] 0x0001
		ObjFrame object[16] 30
		ObjFrame object[10] 50
		ObjFrame object[11] 50
		ObjFrame object[12] 50
	if flag[1840]:
		LookPointFlagsSet look_point[1] 0x0001
		ObjFrame object[17] 30
		ObjFrame object[13] 50
		ObjFrame object[14] 50
		ObjFrame object[15] 50
	ObjFlagsUnset object[19] 0x0010
	if flag[1962]:
		ObjFrame object[19] 30
	else:
		ObjFrame object[19] 0
	ObjFlagsUnset object[20] 0x0010
	if flag[1965]:
		ObjFrame object[20] 30
	else:
		ObjFrame object[20] 0
	if flag[1915]:
		ObjFrame object[25] 1
	if system[0] == 100 | system[0] == 101 | system[0] == 102 | system[0] == 103:
		SystemFlagsSet 0x00002000
		ED7_E0 0
	else:
		SystemFlagsUnset 0x00002000
	if !flag[2127]:
		ObjFrame object[0] 0
	else:
		ObjFrame object[0] 30
	if !flag[2152]:
		ObjFrame object[1] 0
	else:
		ObjFrame object[1] 30
	if !flag[2153]:
		ObjFrame object[18] 0
	else:
		ObjFrame object[18] 30
	if !flag[2154]:
		ObjFrame object[24] 0
	else:
		ObjFrame object[24] 30
	EntranceSetFunc entrance[0] fn[255,65535]
	EntranceSetFunc entrance[1] fn[255,65535]
	EntranceSetFunc entrance[2] fn[255,65535]
	EntranceSetFunc entrance[3] fn[255,65535]
	if flag[1792] && (!flag[1839] | !flag[1840]):
		EntranceSetFunc entrance[0] fn[0,30]
		EntranceSetFunc entrance[1] fn[0,31]
		EntranceSetFunc entrance[2] fn[0,32]
		EntranceSetFunc entrance[3] fn[0,33]
	Return

fn[6]:
	SystemFlagsSet 0x08000000
	if !flag[2127]:
		SoundPlay sound[14] 0 100 0
		ED7ObjPlay object[0] 0 30 0 0
		Sleep 500ms
		if !flag[951]:
			CharColor char[12] 0x00FFFFFF 0ms
			CharTurnToChar char[12] field_party[0] 0deg/s
			_Char91 char[12] 0 1000 0 0 0
			Fork char[12] fork[1]:
				_Char91 self 0 -1000 0 1000 0
			Fork char[12] fork[2]:
				CharColor self 0xFFFFFFFF 1000ms
			CharFlagsUnset char[12] 0x0080
			CharFlagsSet char[12] 0x8000
			TextMessage name[742] {
				{color 5}魔獸出現了！{color 0}{wait}
			}
			TextWait
			TextClose 0
			ForkWait char[12] fork[1]
			ED7Battle battle[1] null 0 0 0 null
			CharFlagsSet char[12] 0x0080
			CharFlagsUnset char[12] 0x8000
			switch system[3]:
				case 0:
					FlagSet flag[951]
					ObjFrame object[0] 30
					Sleep 500ms
					break
				case 2:
					ObjFrame object[0] 0
					TextEnd null
					SystemFlagsUnset 0x08000000
					Return
				case 1:
					ReturnToTitle 0
					Return
		if ItemAdd item[1051] 1:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextMessage name[742] {
				{color 0}已取得{item[1051]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			TextSetPos -1 280 60 3
			FadeIn 300ms 0x00000000
			FlagSet flag[2127]
			ED7_DE 6
		else:
			FadeOut 300ms 0x00000000 100
			TextMessage name[742] {
				寶箱內裝著{item[1051]}{color 0}。
				但因持有物品已滿而放棄{item[1051]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			SoundPlay sound[15] 0 100 0
			ED7ObjPlay object[0] 30 0 0 0
	else:
		FadeOut 300ms 0x00000000 100
		TextMessage name[742] {
			{0x06}{color 5}寶箱內空無一物。{color 0}{wait}
		}
		TextWait
		TextClose 0
		FadeIn 300ms 0x00000000
	Sleep 30ms
	TextEnd null
	SystemFlagsUnset 0x08000000
	Return

fn[7]:
	ED7_F2 1
	SystemFlagsSet 0x08000000
	if !flag[2152]:
		SoundPlay sound[14] 0 100 0
		ED7ObjPlay object[1] 0 30 0 0
		Sleep 500ms
