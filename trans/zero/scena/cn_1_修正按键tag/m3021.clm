fn[10]:
	TextStart self
	if flag[1839] && flag[1840]:
		if flag[0]:
			TextTalk self {
				我現在只想早點
				回到瑪因茲啊。{wait}
			}
			TextWait
			TextTalk self {
				你們幾個，拜託了！
				把我們從這個地方救出去吧！{wait}
			}
			TextWait
		else:
			TextTalk self {
				喂，我說，
				救援應該很快就會來吧！？{wait}
			}
			TextWait
			TextTalk self {
				我、我也……我也好好反省過
				那個時候的事情了。{wait}
			}
			TextWait
			TextTalk self {
				自從服用了那個藥之後，
				不管做什麼都能稱心如意……
				態度也自然變得蠻橫自大……{wait}
			}
			TextWait
			TextTalk self {
				……真是給鎮長
				添了很多麻煩啊……{wait}
			}
			TextWait
			FlagSet flag[0]
	else:
		TextTalk self {
			得、得救了。
			這樣一來，我就可以回去了吧！？{wait}
		}
		TextWait
		TextTalk self {
			趕快帶我回去啊！！{wait}
		}
		TextWait
		Call fn[0,18]
	TextEnd self
	Return

fn[11]:
	TextStart self
	if flag[1839] && flag[1840]:
		if flag[1]:
			TextTalk self {
				我雖然是個自暴自棄，
				只能依靠藥物來實現願望
				的廢物……{wait}
			}
			TextWait
			TextTalk self {
				但是，我已經下定決心，
				至少要保護好這個女孩子……{wait}
			}
			TextWait
		else:
			TextTalk self {
				在和她談話的時候得知……
				她好像並不記得自己
				主動服用過這種藥。{wait}
			}
			TextWait
			TextTalk self {
				似乎只是服用了烏爾斯拉醫院
				開出的內服處方藥而已……{wait}
			}
			TextWait
			TextTalk self {
				總、總之，待在這種地方，
				她肯定會覺得非常不安。
				我決定要好好保護她。{wait}
			}
			TextWait
			FlagSet flag[1]
	else:
		TextTalk self {
			太好了……這樣一來，
			總算是恢復自由了。
			我們也可以回到市裡啦！{wait}
		}
		TextWait
		Call fn[0,18]
	TextEnd self
	Return

fn[12]:
	TextStart self
	if flag[1839] && flag[1840]:
		if flag[2]:
			CharTurnToChar self field_party[0] 0deg/s
