fn[0]:
	while 1:
		ED7CharAnimation self 1000ms 0 1 2 3 4 5
	Return

fn[1]:
	while 1:
		if flag[0]:
			SoundPlay sound[148] 0 100 0
			Sleep 900ms
		else:
			Sleep 30ms
	Return

fn[2]:
	if system[0] == 0:
		if global[0] == 11:
			global[0] = 0
			Event fn[0,9]
		elif global[0] == 13:
			global[0] = 0
			Event fn[0,11]
	if system[0] == 101 && flag[1288] && !flag[1289]:
		Event fn[0,15]
	Return

fn[3]:
	FlagUnset flag[0]
	ForkFunc char[1] fork[0] fn[0,1]
	ED7_1D_0 0 1 0 (0, 0, 94000) 4000 2000 0
	if flag[674]:
		ED7_1D_2 0 1
		ED7_76_2 object[10] "m01gim01" "off_kp"
		ED7_76_2 object[13] "m00gim01" "stop_kp"
	else:
		ED7_1D_3 0 1
		ED7_76_2 object[10] "m01gim01" "on_kp"
		ED7_76_2 object[13] "m00gim01" "rotate"
		if system[0] == 101 | system[0] == 104:
			FlagSet flag[0]
	ED7_1D_0 1 1 0 (-200000, 0, 285500) 4000 2000 0
	ED7_1D_0 2 1 0 (-200000, 0, 297500) 4000 2000 0
	ED7_1D_0 3 1 0 (-200000, 0, 302500) 4000 2000 0
	if flag[675]:
		ED7_1D_2 1 1
		ED7_1D_2 2 1
		ED7_1D_2 3 1
		ED7_76_2 object[11] "m01gim01" "off_kp"
		ED7_76_2 object[14] "m00gim01" "stop_kp"
		ED7_76_2 object[15] "m00gim01" "stop_kp"
	else:
		ED7_1D_3 1 1
		ED7_1D_3 2 1
		ED7_1D_3 3 1
		ED7_76_2 object[11] "m01gim01" "on_kp"
		ED7_76_2 object[14] "m00gim01" "rotate"
		ED7_76_2 object[15] "m00gim01" "rotate"
		if system[0] == 109 | system[0] == 110 | system[0] == 134 | system[0] == 139:
			FlagSet flag[0]
	ED7_1D_0 4 1 0 (200000, 0, 314000) 4000 2000 0
	if flag[676]:
		ED7_1D_2 4 1
		ED7_76_2 object[12] "m01gim01" "off_kp"
		ED7_76_2 object[16] "m00gim01" "stop_kp"
		ED7_76_2 object[17] "m00gim01" "stop_kp"
	else:
		ED7_1D_3 4 1
		ED7_76_2 object[12] "m01gim01" "on_kp"
		ED7_76_2 object[16] "m00gim01" "rotate"
		ED7_76_2 object[17] "m00gim01" "rotate"
		if system[0] == 125 | system[0] == 126:
			FlagSet flag[0]
	ED7_76_2 object[8] "m00ele00" "down_kp"
	ED7_76_2 object[9] "m00ele00" "down_kp"
	ED7_76_0 object[0] "sign01" 1
