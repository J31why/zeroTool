fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharIdle self (1860, null, 7120) (-2300, null, 2860) 1000mm/s
		Sleep 300ms
	Return

fn[2]:
	if flag[1558] && !flag[1559]:
		SystemFlagsSet 0x10000000
		Event fn[0,23]
	elif !flag[1024] && !flag[877]:
		Event fn[0,19]
	if flag[736]:
		FlagUnset flag[736]
		SystemFlagsSet 0x10000000
		Event fn[0,21]
	if flag[1792]:
		CharSetPos char[5] (50, 4050, 18950) 0deg
	elif flag[1566]:
	elif flag[1554]:
		if flag[1559]:
			CharFlagsUnset char[9] 0x0080
		else:
			CharFlagsSet char[0] 0x0080
	elif flag[1550]:
		CharFlagsSet char[0] 0x0080
		CharFlagsSet char[1] 0x0080
		CharFlagsSet char[2] 0x0080
		CharFlagsSet char[3] 0x0080
		CharFlagsSet char[4] 0x0080
		CharFlagsSet char[5] 0x0080
	elif flag[1342]:
	elif flag[1280]:
		CharFlagsSet char[0] 0x0080
		CharFlagsSet char[1] 0x0080
		CharFlagsSet char[2] 0x0080
		CharFlagsSet char[3] 0x0080
		CharFlagsSet char[4] 0x0080
		CharFlagsSet char[5] 0x0080
	elif flag[1040]:
		CharFlagsUnset char[7] 0x0080
	elif flag[1037]:
		CharFlagsUnset char[8] 0x0080
		CharSetChipPattern char[8] 1
		CharSetChipPattern char[4] 2
	elif flag[1024]:
		CharFlagsUnset char[7] 0x0080
	elif flag[777]:
		CharFlagsUnset char[6] 0x0080
	else:
		CharFlagsUnset char[6] 0x0080
	Return

fn[3]:
	if !flag[1551] && flag[1550]:
		EntranceSetDisabled entrance[0] 0
		EntranceSetDisabled entrance[3] 1
	else:
		EntranceSetDisabled entrance[0] 1
		EntranceSetDisabled entrance[3] 0
	ED7_1D_0 0 1 0 (-6000, -1000, 16000) 5000 5000 0
	ObjFlagsSet object[7] 0x0004
	ObjFlagsSet object[8] 0x0004
	EntranceSetFunc entrance[0] fn[255,65535]
	if flag[1547] && !flag[1550]:
		EntranceSetFunc entrance[0] fn[0,29]
	LookPointFlagsSet look_point[5] 0x0001
	if flag[1792]:
		LookPointFlagsUnset look_point[5] 0x0001
	elif flag[1566]:
	elif flag[1560]:
	elif flag[1554]:
		if flag[1559]:
		else:
			LookPointFlagsSet look_point[0] 0x0001
	elif flag[1550]:
		LookPointFlagsSet look_point[0] 0x0001
		LookPointFlagsSet look_point[1] 0x0001
		LookPointFlagsSet look_point[2] 0x0001
		LookPointFlagsSet look_point[3] 0x0001
	elif flag[1342]:
	elif flag[1280]:
		LookPointFlagsSet look_point[0] 0x0001
		LookPointFlagsSet look_point[1] 0x0001
		LookPointFlagsSet look_point[2] 0x0001
		LookPointFlagsSet look_point[3] 0x0001
	Return

fn[4]:
	TextStart self
	if flag[1792]:
	elif flag[1566]:
	elif flag[1559]:
	elif flag[1550]:
	elif flag[1536]:
	elif flag[1342]:
	elif flag[1055]:
	elif flag[1040]:
	elif flag[1037]:
	elif flag[1031]:
	elif flag[1024]:
	elif flag[801]:
	elif flag[777]:
	else:
	TextEnd self
	Return

fn[5]:
	Call fn[0,6]
	Return

fn[6]:
	if flag[1549] && !flag[1550]:
		Call fn[0,22]
	else:
		TextStart char[0]
		if flag[1792]:
			TextTalk char[0] {
				岡茲先生好像還是
				沒有光臨本店呢。{wait}
			}
			TextWait
			TextTalk char[0] {
				嗯……本店
				也覺得十分遺憾。{wait}
			}
			TextWait
			TextTalk char[0] {
				希望他能忘記昨天的事，
				下次再來這裡享樂。{wait}
			}
			TextWait
		elif flag[1566]:
			if flag[1654]:
				if flag[0]:
					TextTalk char[0] {
						雷克多先生昨晚
						發牢騷說，
						帝國已經通知他回去了。{wait}
					}
					TextWait
					TextTalk char[0] {
						他還留話說，
						祝願各位旗開得勝。{wait}
					}
					TextWait
				else:
					TextTalk char[0] {
						說起來……
						雷克多先生
						今天沒來呢。{wait}
					}
					TextWait
					TextTalk char[0] {
						昨天好像聽他說過，
						要回帝國什麼的。{wait}
					}
					TextWait
					TextTalk name[0] {
						#0005F哎……
						也就是說，他已經回國了嗎？{wait}
					}
					TextWait
					TextTalk char[0] {
						是的，聽說有什麼
						麻煩得要死，但非得他
						親自出馬的事情。{wait}
					}
					TextWait
					TextTalk name[0] {
						#0003F是這樣啊……{wait}
					}
					TextWait
					TextTalk name[1] {
						#0101F還以為
						他應該知道些什麼的。{wait}
					}
					TextWait
					TextTalk name[2] {
						#0206F算了，反正他那種人
						就算知道些什麼，
						也不會老老實實說出來的。{wait}
					}
					TextWait
					if PartyPosition name[9] > -1:
						TextTalk name[9] {
							#0605F（……在說誰呢………？）{wait}
						}
						TextWait
					FlagSet flag[1666]
					FlagSet flag[0]
			else:
				TextTalk char[0] {
					您找岡茲先生嗎，
					他今天沒來呢。{wait}
				}
				TextWait
				TextTalk char[0] {
					因為昨天發生了那種事嘛，
					可能是不好意思再露面了吧。{wait}
				}
				TextWait
				TextTalk name[0] {
					#0001F嗯，倒也並沒指望在這裡找到他……{wait}
				}
				TextWait
				Emote char[0] 0mm 2000mm 0 1 250ms 2
				SoundPlay sound[29] 0 100 0
				Sleep 1000ms
				TextTalk name[3] {
					#0303F其實……稍微出現了一些意外情況。{wait}
				} {
					#0300F老闆，要是看到
					那位老兄的話，
					就請聯絡我們支援課吧。{wait}
				} {
					我們有點事找他。{wait}
				}
				TextWait
				TextTalk char[0] {
					好的，沒問題……
					是不是跟什麼犯罪事件有關啊。{wait}
				}
				TextWait
				FlagSet flag[1654]
		elif flag[1559]:
			if flag[1653]:
				TextTalk char[0] {
					我去跟服務員們說說，
					讓他們不要把岡茲先生發瘋
					的事情外傳。{wait}
				}
				TextWait
				TextTalk char[0] {
					雖然多少還會傳出一些流言蜚語……
					算了，這裡終究是流言橫行的歡樂街嘛。
					這種話題很快就會被遺忘的。{wait}
				}
				TextWait
			else:
				TextTalk char[0] {
					剛才真是謝謝你們了。
					請容我再次表示謝意。{wait}
				}
				TextWait
				TextTalk name[3] {
					#0306F運氣還算不錯啊。
					要是放著不管，還不知道會發生什麼事……{wait}
				}
				TextWait
				TextTalk name[0] {
					#0003F是啊，倚仗著那種怪力，
					恐怕不是把人打傷
					就可以了結的……{wait}
				} {
					#0001F老闆，如果可以的話，
					今天發生的事情，能否暫時不要聲張出去？{wait}
				} {
					因為我們還在
					整理整個事件的經過……{wait}
				}
				TextWait
				TextTalk char[0] {
					好的，對我們來說，
					這也不是什麼好事。{wait}
				}
				TextWait
				TextTalk char[0] {
					雖然多少也會流出去一些傳言吧，
					但我會儘量勸說服務員們，
					讓他們不要隨便亂講。{wait}
				}
				TextWait
				FlagSet flag[1653]
		elif flag[1550]:
			TextTalk char[0] {
				岡茲先生是我們的老顧客了，
				不可能會認錯的。{wait}
			}
			TextWait
			TextTalk char[0] {
				他應該住在千禧飯店
				最頂層的
				豪華套房裡。{wait}
			}
			TextWait
			TextTalk char[0] {
				如果您有事，可以去那裡找他。{wait}
			}
			TextWait
		elif flag[1536]:
			if flag[0]:
				TextTalk char[0] {
					蘭迪，稍微玩兩把倒是沒問題，
					但不要太得意忘形哦。{wait}
				}
				TextWait
				TextTalk char[0] {
					這種東西，
					不管運氣有多好，總有一天
					也都會連本帶利全部還回去的。{wait}
				}
				TextWait
				TextTalk name[3] {
					#0306F知道知道，這些我都清楚啊。
					（……老闆好像
					　有點緊張啊。）{wait}
				}
				TextWait
			else:
				TextTalk name[3] {
					#0300F老闆，好久不見，
					我又來玩啦！{wait}
				}
				TextWait
				TextTalk char[0] {
					……蘭迪，怎麼又是你。
					去去去，你還是別來為好啊。{wait}
				}
				TextWait
				TextTalk char[0] {
					多虧你最近沒來玩，
					我們這裡的營業額也……{wait}
				}
				TextWait
				TextTalk char[0] {
					………………………………{wait}
				}
				TextWait
				Emote field_party[0] 0mm 2000mm 0 1 250ms 2
				SoundPlay sound[29] 0 100 0
				Emote field_party[1] 0mm 2000mm 0 1 250ms 2
				SoundPlay sound[29] 0 100 0
				Emote field_party[2] 0mm 2000mm 0 1 250ms 2
				SoundPlay sound[29] 0 100 0
				Emote field_party[3] 0mm 2000mm 0 1 250ms 2
				SoundPlay sound[29] 0 100 0
				Sleep 1000ms
				TextTalk name[3] {
					#0305F怎麼了嗎？{wait}
				}
				TextWait
				TextTalk char[0] {
					……沒有啦。
					沒什麼大不了的。{wait}
				}
				TextWait
				TextTalk char[0] {
					算了，要玩的話，
					也記得要適可而止啊。{wait}
				}
				TextWait
				TextTalk char[0] {
					這種東西，
					不管運氣有多好，總有一天
					也都會連本帶利全部還回去的。{wait}
				}
				TextWait
				FlagSet flag[0]
		elif flag[1342]:
			if flag[0]:
				TextTalk char[0] {
					各位，一定不要隨便插手
					魯巴徹商會之類的事情啊。{wait}
				}
				TextWait
				TextTalk char[0] {
					請多加小心。{wait}
				}
				TextWait
			else:
				if PartyPosition name[3] > -1:
					CharTurnToChar char[0] name[3] 0deg/s
					TextTalk char[0] {
						蘭迪，聽說你跑到魯巴徹商會
						的地盤上去了？{wait}
					}
					TextWait
					TextTalk char[0] {
						哼，竟然又去插手
						這種危險的事情啊。
						不是都說過，叫你不要去管他們了嗎……{wait}
					}
					TextWait
					TextTalk name[3] {
						#0306F啊，那只是順勢去一趟而已啦。
						不過，確實是發生了一點小麻煩呢。{wait}
					}
					TextWait
					TextTalk char[0] {
						哼……不是警備隊就是警察，
						你就只會選這種危險的工作啊。{wait}
					}
					TextWait
					TextTalk char[0] {
						蘭迪，現在也不晚，
						還是趕快轉行，找個安穩的工作吧。{wait}
					}
					TextWait
					TextTalk name[0] {
						#0000F（哈哈……老闆
						　好像很瞭解你呢。）{wait}
					}
					TextWait
					TextTalk name[3] {
						#0300F（……從我剛剛來到
						　克洛斯貝爾的時候，
						　就常來這裡玩了。）{wait}
					}
					TextWait
				else:
					TextTalk char[0] {
						聽說各位跟蘭迪一起
						跑到魯巴徹商會
						的地盤上了……？{wait}
					}
					TextWait
					TextTalk char[0] {
						你們要小心一點啊。
						如果跟那些傢伙扯上關係，可是沒有什麼好下場的。{wait}
					}
					TextWait
					TextTalk char[0] {
						你們也好好教訓一下蘭迪吧。
						那傢伙……不是警備隊就是警察，
						就會選這種危險的工作。{wait}
					}
					TextWait
					TextTalk name[0] {
						#0000F哈哈，讓您擔心了……{wait}
					}
					TextWait
					if PartyPosition name[1] > -1:
						TextTalk name[1] {
							#0100F老闆，您好像和蘭迪
							很熟啊。{wait}
						}
						TextWait
					elif PartyPosition name[2] > -1:
						TextTalk name[2] {
							#0200F老闆對蘭迪前輩
							的事情好像很熟悉呢。{wait}
						}
						TextWait
					TextTalk char[0] {
						嗯，是啊……{wait}
					}
					TextWait
					TextTalk char[0] {
						因為蘭迪從剛來到
						克洛斯貝爾的時候開始，
						就常來我這裡玩了。{wait}
					}
					TextWait
					TextTalk char[0] {
						雖然沒有太深入的瞭解……
						不過，那傢伙總有些
						讓人放不下心的地方呢。{wait}
					}
					TextWait
				FlagSet flag[0]
		elif flag[1055]:
			if flag[0]:
				TextTalk char[0] {
					據說，在一個叫做什麼導力網路的東西上，
					有人在做著『情報商』的生意……{wait}
