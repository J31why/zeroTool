	CharSetPos name[3] (-20270, 0, 45630) 65deg
	FadeIn 500ms 0x00000000
	FadeWait
	TextTalk name[1] {
		#6P#0100F古道邊的田園風景……
		這麼一看，真是很漂亮呢。{wait}
	}
	TextWait
	TextTalk name[3] {
		#12P#0300F是啊。
		上次來消滅魔獸的時候，
		沒能好好欣賞……{wait}
	}
	TextWait
	TextTalk name[2] {
		#12P#0200F在這裡吃便當的話，
		食物似乎也會變得很美味呢。{wait}
	} {
		雖然因為有魔獸在，
		所以估計不會吃得很順利……{wait}
	}
	TextWait
	TextTalk name[0] {
		#6P#0000F不過，這裡的風景對於
		開車兜風來說，真是再合適不過了。{wait}
	} {
		像哈羅德先生那樣
		經常要跑遍整個自治州的商人，
		應該會覺得這種風景相當親切吧。{wait}
	}
	TextWait
	TextTalk name[1] {
		#6P#0100F嗯，一定是那樣沒錯吧。{wait}
	}
	TextWait
	TextTalk name[0] {
		#6P#0000F嗯，格蕾絲小姐委託我們拍攝的照片，
		在這裡似乎能拍到很不錯的呢。{wait}
	}
	TextWait
	if !QuestTaskGet quest[24] 2 && !QuestTaskGet quest[24] 3 && !QuestTaskGet quest[24] 4 && !QuestTaskGet quest[24] 5 && !QuestTaskGet quest[24] 6 && !QuestTaskGet quest[24] 7 && !QuestTaskGet quest[24] 8 && !QuestTaskGet quest[24] 9 && !QuestTaskGet quest[24] 10:
		CharTurnToChar name[0] name[1] 500deg/s
		TextTalk name[0] {
			#6P#0000F那麼艾莉，
			可以拜託你來拍照嗎？{wait}
		}
		TextWait
		CharTurnToChar name[1] name[0] 500deg/s
		TextTalk name[1] {
			#6P#0108F哎，好的。
			雖然我沒什麼自信……{wait}
		}
		TextWait
		CharTurnToChar name[3] name[2] 500deg/s
		TextTalk name[3] {
			#12P#0300F哪裡哪裡，應該沒問題吧。{wait}
		} {
			只要看看鏡頭，
			然後哢嚓一下拍下來
			不就搞定了嘛。{wait}
		}
		TextWait
		CharTurnToChar name[1] name[3] 500deg/s
		TextTalk name[1] {
			#6P#0106F我說你啊……
			要拍出好照片，
			可沒有那麼簡單哦。{wait}
		} {
			#0100F要注意確認
			拍攝對象有沒有被收入取景框中，
			還要構思攝影角度……{wait}
		} {
			而且受到天氣和風的影響，
			照片所呈現出的感覺也會有很大不同。{wait}
		} {
			有時只要錯過那一瞬的時機，
			就再也拍不到
			那麼好的風景了。{wait}
		}
		TextWait
		TextTalk name[2] {
			#12P#0200F外行和專家所拍出的照片，
			差別可是一目了然的。{wait}
		} {
			#0203F不過，某些粗神經的人
			大概無法理解這種細緻的工作吧。{wait}
		}
		TextWait
		TextTalk name[3] {
			#12P#0306F唔……
			你在說誰啊。{wait}
		}
		TextWait
		TextTalk name[0] {
			#6P#0000F好啦好啦，
			總之就交給艾莉吧。{wait}
		}
		TextWait
		TextTalk name[1] {
			#6P#0100F那麼……
			我來試試看吧。{wait}
		}
		TextWait
		_59
		CharTurnTo name[1] 65deg 500deg/s
		CharTurnTo name[0] 65deg 500deg/s
		CharTurnTo name[2] 65deg 500deg/s
		CharTurnTo name[3] 65deg 500deg/s
		CrossFade 1000ms
		CharSetChipBase name[1] chip[30]
		CharSetChipPattern name[1] 0
		FadeWait
		SoundPlay sound[817] 0 100 0
		EffPlay eff[0] eff_instance[255] name[1] 192 (0, 1200, 400) 0 0 0 1000 1000 1000 null (0, 0, 0) 0ms
		Sleep 1000ms
		SoundPlay sound[817] 0 100 0
		EffPlay eff[0] eff_instance[255] name[1] 192 (0, 1200, 400) 0 0 0 1000 1000 1000 null (0, 0, 0) 0ms
		Sleep 1000ms
		SoundPlay sound[817] 0 100 0
		EffPlay eff[0] eff_instance[255] name[1] 192 (0, 1200, 400) 0 0 0 1000 1000 1000 null (0, 0, 0) 0ms
		Sleep 1000ms
		TextTalk name[1] {
			#6P#0103F……呼，
			為了保險起見，我多拍了幾張。{wait}
		}
		TextWait
		TextTalk name[0] {
			#6P#0000F看樣子，似乎已經拍好了呢。{wait}
		} {
			感覺怎麼樣啊？{wait}
		}
		TextWait
		TextTalk name[1] {
			#6P#0100F在沒有實際顯像出來之前，
			還無法確定……{wait}
		} {
			不過，我覺得至少
			不會很差吧。{wait}
		}
		TextWait
		TextTalk name[2] {
			#12P#0200F艾莉前輩似乎
			找回感覺了呢。{wait}
		}
		TextWait
		TextTalk name[3] {
			#12P#0300F哼……
			反正只有我完全搞不懂。{wait}
		}
		TextWait
		TextTalk name[0] {
			#6P#0000F如果發現了這種風景漂亮的地方，
