		CharSetPos name[1] (8160, 2390, -7190) 180deg
		ForkFunc name[1] fork[1] fn[0,19]
		Sleep 2000ms
		ForkQuit name[1] fork[1]
	elif PartyPosition name[2] > -1:
		CharSetPos name[2] (8160, 2390, -7190) 180deg
		ForkFunc name[2] fork[1] fn[0,19]
		Sleep 2000ms
		ForkQuit name[2] fork[1]
	elif PartyPosition name[3] > -1:
		CharSetPos name[3] (8160, 2390, -7190) 180deg
		ForkFunc name[3] fork[1] fn[0,19]
		Sleep 2000ms
		ForkQuit name[3] fork[1]
	ForkQuit name[0] fork[1]
	FadeWait
	TextTalk name[0] {
		#5P#0005F哎……好奇怪啊。{wait}
	} {
		噴泉廣場的果汁店，
		應該就在這一帶吧？{wait}
	}
	TextWait
	if PartyPosition name[1] > -1:
		CharTurnToChar name[1] name[0] 500deg/s
		TextTalk name[1] {
			#12P#0105F嗯，我覺得也是……{wait}
		} {
			#0103F不過，莫非是
			搬到別處去了嗎？{wait}
		}
		TextWait
	elif PartyPosition name[2] > -1:
		CharTurnToChar name[2] name[0] 500deg/s
		TextTalk name[2] {
			#12P#0203F嗯，我記得也是如此。{wait}
		} {
			#0200F很可能是搬到
			其它地方了吧。{wait}
		}
		TextWait
	elif PartyPosition name[3] > -1:
		CharTurnToChar name[3] name[0] 500deg/s
		TextTalk name[3] {
			#12P#0303F是啊，我之前約會時來過那家店，
			不會有錯的。{wait}
		} {
			#0301F大概已經搬到其它什麼地方了吧？{wait}
		}
		TextWait
	CharTurnToChar name[82] name[0] 500deg/s
	TextTalk name[82] {
		#11P#1112F哎～那麼，
		我們就不能給老爺爺
		買慰問品了嗎～？{wait}
	}
	TextWait
	CharTurnToChar name[0] name[82] 500deg/s
	TextTalk name[0] {
		#5P#0003F不，應該還沒有
		搬到市外……{wait}
	} {
		#0000F既然都已經接下了委託，
		就在市內好好找找吧。{wait}
	}
	TextWait
	TextTalk name[82] {
		#11P#1100F嗯！{wait}
	}
	TextWait
	TriggerFlagsSet trigger[0] 0x0080
	CharSetPos field_party[0] (8100, 2390, -5930) 225deg
	QuestTaskSet quest[38] 2
	EventEnd 5
	Return

