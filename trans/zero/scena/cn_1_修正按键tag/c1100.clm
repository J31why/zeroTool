			TextTalk name[0] {
				#0012F哈哈……果然是
				那個道理嗎。{wait}
			}
			TextWait
			TextTalk self {
				嗯，該說真不愧是
				賽爾蓋的部下嗎……{wait}
			}
			TextWait
			TextTalk self {
				算了，總之，儘量不要被人盯上啊。{wait}
			}
			TextWait
			TextTalk self {
				如果你們的行為太過惹眼，
				可就要做好心理準備，隨時遭受
				副局長那類人的刁難了。{wait}
			}
			TextWait
			Emote field_party[0] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Emote field_party[1] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Emote field_party[2] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Emote field_party[3] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Sleep 1000ms
			TextTalk name[2] {
				#0200F那個……{wait}
			}
			TextWait
			TextTalk name[3] {
				#0306F唉，饒了我吧……{wait}
			}
			TextWait
			FlagSet flag[6]
		elif !flag[7]:
			TextTalk self {
				竟然能在一課的地盤中
				摻上一腳……{wait}
			}
			TextWait
			TextTalk self {
				賽爾蓋的部下嗎……
				呵呵，說不定你們也算是
				繼承了那傢伙的某些特點呢。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0005F……？{wait}
			}
			TextWait
			TextTalk self {
				算了，總之，一定注意不要
				顯眼到被副局長盯上了。{wait}
			}
			TextWait
			FlagSet flag[7]
		else:
			TextTalk self {
				……（啪啪）…………
				話說回來，雷蒙德那傢伙
				怎麼磨磨蹭蹭的？{wait}
			}
			TextWait
			TextTalk self {
				再這麼磨蹭下去，去詢問案情之前，
				我都已經要把香煙抽完了。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[16]:
	TextStart self
	if !flag[8]:
		TextTalk self {
			真想在紀念慶典的時候
			和戀人一起出去玩啊～{wait}
		}
		TextWait
		TextTalk self {
			比如說，到米修拉姆
			度過一個愉快的假期～{wait}
		}
		TextWait
		TextTalk self {
			……算了，根本就不可能的。{wait}
		}
		TextWait
		FlagSet flag[8]
	else:
		TextTalk self {
			呵呵……
			我們搜查官，在紀念慶典時期
			是不可能放假的～{wait}
		}
		TextWait
	TextEnd self
	Return

fn[17]:
	EventBegin 0
	CrossFade 500ms
	CamSetDistance 7330 3500 -6700 0ms
