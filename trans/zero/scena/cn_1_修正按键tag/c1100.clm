fn[5]:
	TextStart self
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"對話" // 0
			"購物" // 1
			"放棄" // 2
		MenuWait var[0]
		if var[0] != 1:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			ShopOpen shop[128]
			var[0] = 99
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			if flag[1792]:
				if !flag[0]:
					TextTalk self {
						啊……差不多
						也該打烊了哦。{wait}
					}
					TextWait
					TextTalk self {
						要買飲料的話，就抓緊最後的機會吧。
						想喝什麼，請隨便吩咐。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk self {
						要買飲料的話，就抓緊最後的機會吧。
						想喝什麼，請隨便吩咐。{wait}
					}
					TextWait
			elif flag[1566]:
				TextTalk self {
					今早好像有很多
					警察在晃來晃去呢。{wait}
				}
				TextWait
				TextTalk self {
					難道是發生了什麼事嗎……{wait}
				}
				TextWait
			elif flag[1554]:
				if !flag[0]:
					TextTalk self {
						啊呀，今天是個大晴天呢……{wait}
					}
					TextWait
					TextTalk self {
						一下雨就沒法做生意了，
						好天氣真是幫了我的大忙呢。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk self {
						今天天氣好像會很熱呢，
						生意應該會很紅火吧。{wait}
					}
					TextWait
			elif flag[1536]:
				if !flag[0]:
					TextTalk self {
						因為要召開議會，
						這一帶從早到晚都很熱鬧。{wait}
					}
					TextWait
					TextTalk self {
						可是……議員和媒體人士
						都不常來我這裡買東西呢……{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk self {
						我還是比較喜歡紀念慶典。{wait}
					}
					TextWait
					TextTalk self {
						議會之類的，
						實在是搞不懂……{wait}
					}
					TextWait
			elif flag[1342]:
				if flag[0]:
					TextTalk self {
						嗯～差不多也該
						換個地方了吧……{wait}
					}
					TextWait
					TextTalk self {
						必須要把握住那些在紀念慶典
						之後準備回國的客人啊。{wait}
					}
					TextWait
				else:
					TextTalk self {
						歡迎光臨～！
						要不要來一杯新鮮果汁～？{wait}
					}
					TextWait
					TextTalk self {
						……在市內觀光時要是累了的話，
						就來和姊姊我說吧。{wait}
					}
					TextWait
					TextTalk self {
						我可以賣給你們
						美味的果汁哦。{wait}
					}
					TextWait
					FlagSet flag[0]
			elif flag[1055]:
				if !flag[0]:
					TextTalk self {
						為了應對紀念慶典，
						我準備多訂購一些
						製作果汁用的水果。{wait}
					}
					TextWait
					TextTalk self {
						……說起來，
						媽媽好像也說過類似的話呢。{wait}
					}
					TextWait
					TextTalk self {
						嗯～我也不能輸啊。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk self {
						我媽媽在百貨
						負責食材專櫃。{wait}
					}
					TextWait
					TextTalk self {
						她對進貨流程非常熟悉……
						我也應該多向她學習一些這方面的竅門吧。{wait}
					}
					TextWait
			elif flag[1040]:
				TextTalk self {
					歡迎光臨。
					客人，您想點些什麼嗎？{wait}
				}
				TextWait
			elif flag[1031]:
				if !flag[0]:
					TextTalk self {
						我媽媽在百貨裡
						負責食材專櫃。{wait}
					}
					TextWait
					TextTalk self {
						她從以前開始就一直從事著進口食材的工作，
						曾經開過一家很有名氣的店呢。{wait}
					}
					TextWait
					TextTalk self {
						呵呵，我之所以會走上經商的道路，
						說不定也是受了母親的影響呢。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk self {
						我媽媽在百貨
						負責食材專櫃。{wait}
					}
					TextWait
					TextTalk self {
						在經營進口食材方面，也算是
						有著一定的信譽與好評。{wait}
					}
					TextWait
			elif flag[1024]:
				if !flag[0]:
					TextTalk self {
						我也想自己試著做些生意，
						於是就開始經營這家店了。{wait}
					}
					TextWait
					TextTalk self {
						不過……為了購買這架三輪貨車，
						我還貸款了呢。{wait}
					}
					TextWait
					TextTalk self {
						……必須要努力賺錢才行哦。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk self {
						因為我想嘗試著靠自己的力量來創業，
						所以沒有求助於母親，而是選擇了貸款。{wait}
					}
					TextWait
					TextTalk self {
						只有把生意做好，順利還清貸款，
						才能算是真正意義上的經商。
						……必須要更加努力才行呢。{wait}
					}
					TextWait
			elif flag[801]:
				if !RecipeLearn 22:
					Call fn[0,6]
				elif !flag[0]:
					TextTalk self {
						歡迎光臨～！
						要不要來點果汁呢～？{wait}
					}
					TextWait
					TextTalk self {
						……剛才有位遊擊士
						來和我搭話呢。{wait}
					}
					TextWait
