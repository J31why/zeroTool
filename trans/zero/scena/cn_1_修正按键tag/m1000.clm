	CharFlags2Unset field_party[4] 0x8000
	FadeWait
	TextTalk name[8] {
		#0505F啊，各位，
		要返回市裡嗎？{wait}
	} {
		#0500F抱歉，我必須要
		在這裡守衛，防止民間人士
		隨意入內。{wait}
	}
	TextWait
	TextTalk name[0] {
		#0005F噢，是嗎……
		我們是想先回去一趟，
		整理好裝備之後再回來的。{wait}
	}
	TextWait
	TextTalk name[3] {
		#0306F哈，既然是任務，那也沒辦法了啊。{wait}
	} {
		#0300F諾艾兒上士，我們就暫時分開行動吧。
		在我們補充好裝備之前，
		請你先在這裡稍等。{wait}
	}
	TextWait
	TextTalk name[8] {
		#0500F瞭解。
		我就在裝甲車旁邊待命，
		請各位多加小心！{wait}
	}
	TextWait
	TextTalk name[0] {
		#0000F嗯，諾艾兒你也要小心啊。{wait}
	}
	TextWait
	FadeOut 1000ms 0x00000000 255
	FadeWait
	if PartyGetAttr name[0] 2 < 1:
		PartySetAttr name[0] 252 1
		PartySetAttr name[0] 2 1
	if PartyGetAttr name[1] 2 < 1:
		PartySetAttr name[1] 252 1
		PartySetAttr name[1] 2 1
	if PartyGetAttr name[2] 2 < 1:
		PartySetAttr name[2] 252 1
		PartySetAttr name[2] 2 1
	if PartyGetAttr name[3] 2 < 1:
		PartySetAttr name[3] 252 1
		PartySetAttr name[3] 2 1
	PartySetAttr name[8] 252 0
	PartySetAttr name[8] 254 0
	PartyClear
	PartyAdd name[0] null 255
	PartyAdd name[1] null 255
	PartyAdd name[2] null 255
	PartyAdd name[3] null 255
	NextFrame
	CamSetDistance 34730 -11200 70340 0ms
	ED7CamRotate 35deg 19deg 0deg 0ms
	CamPers 510 0ms
	CamZoom 25000 0ms
	CharSetPos field_party[0] (34730, -13200, 70340) 170deg
	CharSetPos field_party[1] (34730, -13200, 70340) 170deg
	CharSetPos field_party[2] (34730, -13200, 70340) 170deg
	CharSetPos field_party[3] (34730, -13200, 70340) 170deg
