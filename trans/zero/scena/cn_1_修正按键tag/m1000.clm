fn[6]:
	TextStart self
	TextTalk char[0] {
		#0500F各位辛苦啦！
		……要立即重新開始
		對遺跡的探索嗎？{wait}
	}
	TextWait
	FadeOut 300ms 0x00000000 100
	Menu menu[0] -1 -1 0
		"重新開始" // 0
		"還要再準備一下" // 1
	MenuWait var[0]
	MenuClose menu[0]
	FadeIn 300ms 0x00000000
	FadeWait
	if var[0] == 0:
		TextTalk name[0] {
			#0000F嗯，差不多也該繼續去探索了。{wait}
		}
		TextWait
		TextTalk char[0] {
			#0500F瞭解。
			那我們就向『塔』
			的內部出發吧！{wait}
		}
		TextWait
		FadeOut 1000ms 0x00000000 255
		FadeWait
		CharFlagsSet char[0] 0x0080
		PartyAdd name[8] null 255
		NextFrame
		TriggerFlagsUnset trigger[2] 0x0080
		TriggerFlagsSet trigger[3] 0x0080
		FadeIn 250ms 0x00000000
		FadeWait
	else:
		TextTalk char[0] {
			#0503F是嗎。
			對手應該相當狡猾危險，
			還是先整理一下裝備比較好呢。{wait}
		} {
			#0501F我就在這裡待命，
			各位準備好之後，就來和我說吧。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[7]:
	EventBegin 0
	CrossFade 500ms
	CamSetDistance 34420 -11200 71170 0ms
	ED7CamRotate 37deg 20deg 0deg 0ms
	CamPers 500 0ms
	CamZoom 14220 0ms
	CharSetPos name[0] (34730, -13200, 70340) 350deg
