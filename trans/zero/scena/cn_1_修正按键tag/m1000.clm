	CamWait 121
	TextTalk name[0] {
		#6P#0001F星見之塔嗎……
		是和『銀』交戰過的場所呢。{wait}
	} {
		#0003F像這樣從外部眺望時，
		倒是個很美麗的地方……{wait}
	}
	TextWait
	TextTalk name[1] {
		#6P#0108F但一想到內部的樣子，
		就有點……{wait}
	}
	TextWait
	TextTalk name[2] {
		#12P#0200F這個場所，果然也應該
		徹底進行一次正式調查吧？{wait}
	} {
		#0203F那些不可理解的現象，
		如果就一直這麼放著不管，
		總覺得很不舒服。{wait}
	}
	TextWait
	TextTalk name[3] {
		#12P#0303F不過調查工作是
		警備隊的管轄範圍……
		恐怕很難把問題解決吧。{wait}
	} {
		#0301F畢竟警備隊的司令，
		是個只要對升官沒好處的事，
		就一概不管的傢伙。{wait}
	}
	TextWait
	TextTalk name[0] {
		#6P#0003F……問題真是堆積如山呢。{wait}
	} {
		#0000F總之……
		格蕾絲小姐委託我們拍攝的照片，
		在這裡似乎能拍到很不錯的呢。{wait}
	}
	TextWait
	if !QuestTaskGet quest[24] 2 && !QuestTaskGet quest[24] 3 && !QuestTaskGet quest[24] 4 && !QuestTaskGet quest[24] 5 && !QuestTaskGet quest[24] 6 && !QuestTaskGet quest[24] 7 && !QuestTaskGet quest[24] 8 && !QuestTaskGet quest[24] 9 && !QuestTaskGet quest[24] 10:
		CharTurnToChar name[0] name[1] 500deg/s
		TextTalk name[0] {
			#6P#0000F那麼艾莉，
			可以拜託你來拍照嗎？{wait}
		}
		TextWait
		CharTurnToChar name[1] name[0] 500deg/s
		TextTalk name[1] {
			#6P#0108F哎，好的。
			雖然我沒什麼自信……{wait}
		}
		TextWait
		CharTurnToChar name[3] name[1] 500deg/s
		TextTalk name[3] {
			#12P#0300F哪裡哪裡，應該沒問題吧。{wait}
		} {
			只要看看鏡頭，
			然後哢嚓一下拍下來
			不就搞定了嘛。{wait}
		}
		TextWait
		CharTurnToChar name[1] name[3] 500deg/s
		TextTalk name[1] {
			#6P#0106F我說你啊……
			要拍出好照片，
			可沒有那麼簡單哦。{wait}
		} {
			#0100F要注意確認
			拍攝對象有沒有被收入取景框中，
			還要構思攝影角度……{wait}
		} {
			而且受到天氣和風的影響，
			照片所呈現出的感覺也會有很大不同。{wait}
		} {
			有時只要錯過那一瞬的時機，
			就再也拍不到
			那麼好的風景了。{wait}
		}
		TextWait
		TextTalk name[2] {
			#12P#0200F外行和專家所拍出的照片，
			差別可是一目了然的。{wait}
		} {
			#0203F不過，某些粗神經的人
			大概無法理解這種細緻的工作吧。{wait}
