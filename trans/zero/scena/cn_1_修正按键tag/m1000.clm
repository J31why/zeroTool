			#0000F嗯，這是一座名叫『星見之塔』
			的中世紀建築哦。{wait}
		} {
			有些部分已經坍塌了，
			所以平時好像是禁止進入的。{wait}
		}
		TextWait
		TextTalk name[1] {
			#0100F我雖然聽說過這座塔，
			但也從沒來過呢。{wait}
		} {
			好像都已經封鎖
			將近十年了吧。{wait}
		}
		TextWait
		FlagSet flag[1084]
	else:
		TextSetName ""
		TextMessage null {
			{color 5}道路被路障
			封鎖了。{wait}
		} {
