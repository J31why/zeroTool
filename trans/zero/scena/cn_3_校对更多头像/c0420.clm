fn[7]:
	TextStart self
	if flag[1566]:
		TextTalk char[4] {
			就調整一下今天公演的
			角色分配，儘量撐過去吧。{wait}
		}
		TextWait
		TextTalk char[4] {
			……要是尼克魯
			能回來的話就
			最好了……{wait}
		}
		TextWait
	elif flag[1554]:
		Call fn[0,12]
	elif flag[1550]:
		if flag[0]:
			TextTalk char[4] {
				貴賓席的客人是
				是由我來領位的。{wait}
			}
			TextWait
			TextTalk char[4] {
				但是……今天有位
				很奇怪的客人呢……{wait}
			}
			TextWait
			TextTalk char[4] {
				年紀輕輕就能來到貴賓席……
				可能是在某些方面
				有什麼人脈吧？{wait}
			}
			TextWait
		else:
			_Char4A char[13] 255
			TextTalk char[13] {
				#3509F哦哦，好豪華～
				視野可真是太棒了啊。{wait}
			}
			TextWait
			TextTalk char[4] {
				哈哈哈……公演大約
				在十分鐘後開始。{wait}
			}
			TextWait
			TextTalk char[4] {
				請盡情欣賞
				『金之太陽、銀之月』吧。{wait}
			}
			TextWait
			CharFlagsUnset char[4] 0x0010
			FlagSet flag[0]
			_Char4B char[13] 255
	elif flag[1342]:
		_Char4A char[2] 255
		if flag[0]:
			TextTalk char[4] {
				我也沒有說過
				絕對不會去外國演出……{wait}
			}
			TextWait
			TextTalk char[4] {
				……巴爾薩摩，很抱歉，
				你可以再考慮一下這件事嗎？{wait}
			}
			TextWait
		else:
			TextTalk char[4] {
				嗯，演出的事啊……{wait}
			}
			TextWait
			TextTalk char[4] {
				我聽了霧香小姐的話，
				也有點動心了呢。{wait}
			}
			TextWait
			TextTalk char[4] {
				那個人似乎
				深刻理解了
				彩虹劇團的藝術性……{wait}
			}
			TextWait
			TextTalk char[4] {
				……巴爾薩摩，很抱歉，
				你可以再考慮一下嗎？
				不好意思，把這些事都推給你了。{wait}
			}
			TextWait
			FlagSet flag[0]
		_Char4B char[2] 255
	elif flag[1055]:
		if flag[0]:
			TextTalk char[4] {
				因為有伊莉雅的指導，
				莉夏的實力也大幅度提高了。{wait}
			}
			TextWait
			TextTalk char[4] {
				其他團員若是也能加把勁兒的話，
				肯定能演出一場完美的舞臺劇。{wait}
			}
			TextWait
		else:
			TextTalk char[4] {
				哎呀，是你們啊。{wait}
			}
			TextWait
			TextTalk char[4] {
				雖然發生了各式各樣的事情，大家都手忙腳亂的，
				但也得繼續排練啊。{wait}
			}
			TextWait
			TextTalk char[4] {
				莉夏的演技最近
				正在顯著提高……{wait}
			}
			TextWait
			TextTalk char[4] {
				其他人也得一起努力才行啊。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1040]:
		if flag[0]:
			TextTalk char[4] {
				（搜查一課的人來得很快呢，
				　一大早就開始進行案情調查了。）{wait}
			}
			TextWait
