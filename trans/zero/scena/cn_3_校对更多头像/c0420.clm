fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharIdle self (62680, null, 1330) (66890, null, 5550) 1000mm/s
		Sleep 300ms
	Return

fn[2]:
	while 1:
		CharWalkToPos self (-2550, 1250, 19700) 5000mm/s 0
		Sleep 300ms
		CharTurnTo self 90deg 750deg/s
		Sleep 300ms
		ForkFunc self fork[1] fn[0,53]
		_Char96 self (-2000, 1250, 19700) 300 1500
		_Char96 self (-1000, 1250, 19700) 500 1000
		ForkFunc self fork[1] fn[0,52]
		_Char96 self (2000, 1250, 19700) 700 700
		ForkQuit self fork[1]
		CharWalkToPos self (2550, 1250, 19700) 5000mm/s 0
		Sleep 300ms
		CharTurnTo self 270deg 750deg/s
		Sleep 300ms
		ForkFunc self fork[1] fn[0,53]
		_Char96 self (2000, 1250, 19700) 300 1500
		_Char96 self (1000, 1250, 19700) 500 1000
		ForkFunc self fork[1] fn[0,52]
		_Char96 self (-2000, 1250, 19700) 700 700
		ForkQuit self fork[1]
	Return

