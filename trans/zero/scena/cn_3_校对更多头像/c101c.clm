fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if flag[1307]:
		CharFlagsUnset char[2] 0x0080
		CharFlagsUnset char[3] 0x0080
	elif flag[1362]:
		CharFlagsUnset char[1] 0x0080
		CharFlagsUnset char[4] 0x0080
		CharFlagsUnset char[5] 0x0080
		CharFlagsSet char[0] 0x0010
	elif flag[1292]:
	elif flag[1282]:
	elif flag[1280]:
	Return

fn[2]:
	Return

fn[3]:
	Call fn[0,4]
	Return

fn[4]:
	TextStart char[0]
	if flag[1307]:
		if !flag[0]:
			TextTalk char[0] {
				#04000F啊，是你們幾個啊。
				又要出遠門了吧？{wait}
			}
			TextWait
			TextTalk name[0] {
				#0012F嗯，有些工作……{wait}
			}
			TextWait
			TextTalk char[0] {
				#04005F是嗎……{wait}
			} {
				#04003F……算啦。
				人家並沒有打算插手
				你們警察內部的事情。{wait}
			} {
				#04000F雖然不知道你們要去哪裡，
				但要努力做好自己分內的事哦。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0001F……是。{wait}
			}
			TextWait
			TextTalk name[2] {
				#0203F（似乎隱隱被察覺到什麼了呢……）{wait}
			}
			TextWait
			TextTalk name[3] {
				#0301F（呼，還真是敏銳啊……）{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				#04003F算啦，警察局內部也有很多隱情，
				人家沒有隨便插嘴的立場。{wait}
			} {
				#04000F總之就好好努力吧。
				只是，一定不要忘記自己的責任呀。{wait}
			}
			TextWait
	elif flag[1362]:
		if !flag[0]:
			Call fn[0,5]
		else:
			TextTalk char[0] {
				#04006F哎呀呀，其實是想讓亞里歐斯
				多休息一下的。{wait}
			} {
				#04008F……小滴她，
				是不是覺得很寂寞呢？{wait}
			}
			TextWait
	elif flag[1292]:
		if !flag[0]:
			TextTalk char[0] {
				#04004F差不多也該到遊客們
				前往市外的時候了。{wait}
			} {
				#04000F我們派艾絲蒂爾他們
				去烏爾斯拉醫院那邊了。{wait}
			} {
				#04000F呵，你們幾個也請
				多加小心吧。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				#04001F亞里歐斯正在對付通緝魔獸……{wait}
			} {
				#04003F那遊行方面就交給
				林她們吧……{wait}
			} {
				#04001F至於那件事就拜託斯克特來處理，
				讓溫蔡爾留守待命……{wait}
			} {
				#04006F啊啊，真是的！
				真希望人手能加倍啊。{wait}
			}
			TextWait
	elif flag[1282]:
		if !flag[1437]:
			TextTalk char[0] {
				#04000F你們幾個，昨天好像
				相當出風頭啊？{wait}
			} {
				#04009F竟然比艾絲蒂爾他們還領先一步，
				還真是出人意料的大冷門呢。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F哈哈……
				其實我們也有同感。{wait}
			}
			TextWait
			TextTalk name[3] {
				#0306F畢竟稍微用上了一點
				犯規手段嘛。{wait}
			}
			TextWait
			TextTalk char[0] {
				#04004F呵呵，就保持這種勢頭，繼續成長，
				然後減輕我們的負擔吧。{wait}
			} {
				#04000F對了……
				昨天晚上，亞里歐斯終於
				出差回來了。{wait}
			} {
				#04006F市政廳那邊傳來了請求，
				所以已經拜託他立刻去進行
				研討會的警備工作了。{wait}
			}
			TextWait
			Emote name[0] 0mm 2000mm 38 38 250ms 1
			Sleep 500ms
			TextTalk name[0] {
				#0005F哎，研討會的警備工作
				不是由警察來負責的嗎……{wait}
			}
			TextWait
			TextTalk name[2] {
				#0200F是啊，搜查一課應該也
				接到了這個任務才對。{wait}
			}
			TextWait
			TextTalk char[0] {
				#04003F呵，反正就是合作警備啦。{wait}
			} {
				#04000F因為外國的ＶＩＰ也會參加那個會議，
				所以要盡可能地保障會場安全，
				不是嗎？{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F原、原來如此……{wait}
			}
			TextWait
			TextTalk name[3] {
				#0300F是啊，如果有『風之劍聖』在場，
				那還真是絕對萬無一失了。{wait}
			}
			TextWait
			TextTalk name[1] {
				#0100F在這樣的場合下，
				警察和協會也會聯手合作呢。{wait}
			}
			TextWait
			FlagSet flag[1437]
		elif !flag[0]:
			TextTalk char[0] {
				#04005F說起來……
				艾絲蒂爾他們說是
				有些私事要辦。{wait}
			} {
				#04003F好像是去了某些
				比較偏遠的地方呢……{wait}
			} {
				#04012F算啦，反正亞里歐斯已經回來了，
				就讓他們稍微放鬆一下吧。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				#04003F亞里歐斯負責市政廳，
				艾絲蒂爾他們有私事……{wait}
			} {
				#04001F斯克特負責ＩＢＣ，
				林她們是負責大教堂呢……{wait}
			} {
				#04006F……呼，掌握成員們的行動
				也並不是一件輕鬆的工作呢。{wait}
			}
			TextWait
	elif flag[1280]:
		if !flag[0]:
			TextTalk char[0] {
				#04000F啊，小朋友們，辛苦啦。{wait}
			} {
				#04001F應總部請求出差在外的亞里歐斯
				推遲了回國日期啊。{wait}
			} {
				#04008F最後，都沒能趕上
				紀念慶典的第一天呢……{wait}
			} {
				#04001F人家也免不了要對總部的人
				大發牢騷啊。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				#04001F在紀念慶典期間，需要出差的任務
				基本上都會被取消，我們的慣例是
				傾全員之力處理慶典期間的委託。{wait}
			} {
				#04007F真是的……總部偏偏在這時候
				獨佔了亞里歐斯，人家可必須要
				好好對他們抱怨一番才行。{wait}
			}
			TextWait
	TextEnd char[0]
	Return

fn[5]:
	TextStart self
	if flag[1362]:
		if !flag[0]:
			_Char4A char[0] 255
			_Char4A char[1] 255
			TextTalk char[0] {
				#04000F雖然剛回來就讓你這麼辛苦，真是不好意思，
				但能否稍微佔用你一點時間呢？{wait}
			} {
				#04001F雷米菲利亞分部就在不久前
				發來了聯絡……{wait}
			}
			TextWait
			TextTalk char[1] {
				#1403F是關於那件事嗎……{wait}
			} {
				#1400F……明白了。
				將詳細情況告訴我吧。{wait}
			}
			TextWait
			_Char4B char[0] 255
			_Char4B char[1] 255
			CharFlagsUnset char[0] 0x0010
			CharFlagsUnset char[1] 0x0010
			FlagSet flag[0]
		else:
			TextTalk char[1] {
				#1403F……不用在意之前的事情。{wait}
			} {
				#1400F你們還有工作在身吧？
				按照自己的步調去努力就好了。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[6]:
	TextStart self
	if flag[1307]:
		if !flag[2]:
			_Char4A char[2] 255
			_Char4A char[3] 255
			TextTalk char[2] {
				#08409F如果能趁現在將接到的工作順利完成，
				下周你就可以不用出差了──
				蜜雪兒是這麼說的哦。{wait}
			} {
				#08405F溫蔡爾，莫非你……{wait}
			}
			TextWait
			TextTalk char[3] {
				#08504F偶爾也想一個人出趟差……
				我只是提出了這樣的請求而已。{wait}
			} {
				#08500F紀念慶典中最忙的時期也已經結束了。
				……你偶爾也要和未婚妻在一起度過嘛。{wait}
			}
			TextWait
			TextTalk char[2] {
				#08404F……多謝了，搭檔。{wait}
			}
			TextWait
			CharFlagsUnset char[2] 0x0010
			CharFlagsUnset char[3] 0x0010
			_Char4B char[2] 255
			_Char4B char[3] 255
			FlagSet flag[2]
		else:
			TextTalk self {
				#08400F下周就像溫蔡爾說的那樣……
				和帕爾在一起度過好啦。{wait}
			} {
				#08404F……也必須要儘早確認一下
				她那邊的日程啊。{wait}
			} {
				#08406F已經好久沒見面了，
				真有些緊張呢……{wait}
			}
			TextWait
	TextEnd self
	Return

fn[7]:
	TextStart self
	if flag[1307]:
		if !flag[2]:
			Call fn[0,6]
		else:
			TextTalk self {
				#08503F斯克特對工作太過拼命了，
				都已經好久沒有見過未婚妻了。{wait}
			} {
				#08500F偶爾創造一些只屬於兩個人的
				時間也是很重要的啊。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[8]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if flag[1362]:
		if !flag[3]:
			TextTalk self {
				#08606F遊行的警備工作
				終於結束了啊。{wait}
			} {
				#08606F在人山人海中工作，
				實在是累得要死啊。{wait}
			}
			TextWait
			TextTalk name[3] {
				#0300F噢噢……真是辛苦啦。{wait}
			}
			TextWait
			TextTalk self {
				#08609F嗯，謝謝。
				總之，我得先好好休息一下。{wait}
			}
			TextWait
			FlagSet flag[3]
		else:
			TextTalk self {
				#08605F說起來，在人潮之中，
				似乎看到過一張有些印象的面孔……{wait}
			} {
				#08603F不，大概只是我的錯覺吧。
				因為並沒有收到聯絡說
				那個人要來克洛斯貝爾啊……{wait}
			}
			TextWait
	CharSetChipPattern self 0
	TextEnd self
	Return

fn[9]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if flag[1362]:
		if !flag[4]:
			TextTalk self {
				#08702F……啊，那不是小緹歐嗎！
				果然好可愛好可愛啊……！！{wait}
			} {
				#08709F姊姊我工作得好累呢。
				能不能來給我治癒一下呀？{wait}
			}
			TextWait
			TextTalk name[2] {
				#0211F……可我並不清楚具體方法。{wait}
			}
			TextWait
			TextTalk self {
				#08712F只要讓我緊緊～地
				抱一抱就好啦！㈱{wait}
			}
			TextWait
			TextTalk name[2] {
				#0203F容我拒絕。{wait}
			}
			TextWait
			TextTalk self {
				#08706F（打擊）{wait}
			}
			TextWait
			FlagSet flag[4]
		else:
			TextTalk self {
				#08706F唉，好遺憾……
				沒辦法，我受到的心靈創傷
				就用外出買午餐吃來撫平吧。{wait}
			} {
				#08709F最近很喜歡『摩爾吉』的
				漢堡呢。{wait}
			}
			TextWait
	CharSetChipPattern self 0
	TextEnd self
	Return

