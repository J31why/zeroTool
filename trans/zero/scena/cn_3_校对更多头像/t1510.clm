fn[4]:
	TextStart char[0]
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"對話" // 0
			"購物" // 1
			"休息" // 2
			"放棄" // 3
		MenuWait var[0]
		if var[0] < 1 | var[0] > 2:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			if flag[1280]:
				ShopOpen shop[93]
			else:
				ShopOpen shop[92]
			var[0] = 99
		elif var[0] == 2:
			ShopOpen shop[90]
			var[0] = 99
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			if flag[1566]:
				TextTalk char[0] {
					您好，歡迎光臨！{wait}
				}
				TextWait
				TextTalk char[0] {
					醫院也才剛剛開始
					今天的營業。{wait}
				}
				TextWait
			elif flag[1565]:
				if !flag[0]:
					TextTalk char[0] {
						那群護理師們差不多
						該來取病號餐了吧。{wait}
					}
					TextWait
					TextTalk char[0] {
						最近的飯菜
						受到了住院患者們的好評呢。{wait}
					}
					TextWait
					TextTalk char[0] {
						雖然之前蓋巴爾議員
						任性地說過『再弄得豪華點』，
						讓我覺得很生氣……{wait}
					}
					TextWait
					TextTalk char[0] {
						不過也多虧了他，
						才讓我對菜式下了一番苦功夫，
						總之結果是好的啦。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[0] {
						最近的飯菜
						受到了住院患者們的好評呢。{wait}
					}
					TextWait
					TextTalk char[0] {
						這也可以說是蓋巴爾議員
						一味任性的結果吧。{wait}
					}
					TextWait
			elif flag[1554]:
				TextTalk char[0] {
					今天早上被抬進來的患者
					似乎是受了槍傷。{wait}
				}
				TextWait
				TextTalk char[0] {
					真可怕……
					希望不要把醫院
					捲進危險的事件裡啊。{wait}
				}
				TextWait
			elif flag[1536]:
				TextTalk char[0] {
					那兩位遊擊士經常
					來醫院幫忙。{wait}
				}
				TextWait
				TextTalk char[0] {
					我們平時總是受她們的關照，
					今天就由我來請她們吃飯好了。{wait}
				}
				TextWait
			elif flag[1351]:
				TextTalk char[0] {
					嗯，剛才和你們在一起的
					女孩子去哪裡了？{wait}
				}
				TextWait
				TextTalk char[0] {
					……什麼，走散了！？
					呼……你們到底在幹什麼啊？{wait}
				}
				TextWait
			elif flag[1346]:
				if !flag[0]:
					TextTalk char[0] {
						嗯，我聽到你們剛才的對話了……
						你就是賽西兒的弟弟
						的女兒吧？{wait}
					}
					TextWait
					TextTalk name[82] {
						#1105F咦，琪雅果然是羅伊德的孩子嗎？{wait}
					}
					TextWait
					TextTalk name[0] {
						#0011F不、不是啦……！
						都說了那是誤會啊！{wait}
					}
					TextWait
					TextTalk char[0] {
						啊哈哈，我只是開個玩笑而已。
						別當真～別當真。{wait}
					}
					TextWait
					TextTalk name[82] {
						#1111F嗯？{wait}
					}
					TextWait
					TextTalk name[0] {
						#0005F這樣啊……{wait}
					}
					TextWait
					if flag[1356]:
						TextTalk name[1] {
							#0102F（呵呵，雖然我早就看出來
							　他很好戲弄了……）{wait}
						}
						TextWait
					elif flag[1357]:
						TextTalk name[2] {
							#0202F（羅伊德前輩
							　就是那種
							　人見人欺的角色啊。）{wait}
						}
						TextWait
					elif flag[1358]:
						TextTalk name[3] {
							#0309F（哈哈哈，真是個可愛的傢伙。
							　羅伊德就該保持這樣。）{wait}
						}
						TextWait
					FlagSet flag[0]
				else:
					TextTalk char[0] {
						啊哈哈，開你玩笑，是我不好。{wait}
					}
					TextWait
					TextTalk char[0] {
						不過，說對不起好像也有點奇怪，
						就不要在意這種小事啦。{wait}
					}
					TextWait
			elif flag[1307]:
				TextTalk char[0] {
					啊，歡迎光臨。{wait}
				}
				TextWait
				TextTalk char[0] {
					市裡明明正在舉行紀念慶典，
					還特意跑到這種地方來啊。{wait}
				}
				TextWait
			elif flag[1292]:
				if !flag[0]:
					TextTalk char[0] {
						食堂以及病號餐的食材，
						都是從一個名叫哈羅德
						的商人那買來的。{wait}
					}
					TextWait
					TextTalk char[0] {
						只有他會以那麼便宜的價格，
						把新鮮又有益於身體健康
						的食材賣給我們。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[0] {
						醫院烹製料理的食材都是
						從哈羅德先生那買來的。{wait}
					}
					TextWait
			elif flag[1282]:
				TextTalk char[0] {
					在宿舍工作的瑪洛妮是
					我的侄女。{wait}
				}
				TextWait
				TextTalk char[0] {
					我看她在家裡幫忙做家務挺閑的，
					就讓她來這裡工作了。{wait}
				}
				TextWait
				TextTalk char[0] {
					那孩子的優點就只有愛乾淨了，
					因此很合適
					從事清潔工作。{wait}
				}
				TextWait
			elif flag[1280]:
				if !flag[0]:
					TextTalk char[0] {
						好不容易等到了紀念慶典，
						卻住院躺在病床上，
						這很讓人同情吧？{wait}
					}
					TextWait
					TextTalk char[0] {
						所以我想，
						至少在紀念慶典期間
						把住院膳食做得豪華一點。{wait}
					}
					TextWait
					TextTalk char[0] {
						話雖如此，
						但也不能讓飯菜的營養均衡失調。
						只能在創意上多下功夫了……{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[0] {
						至少在紀念慶典期間，
						我想把住院膳食做得
						豪華一點。{wait}
					}
					TextWait
					TextTalk char[0] {
						昨天的菜式新加了
						豆腐肉餅……
						很健康很不錯吧？{wait}
					}
					TextWait
			elif flag[1040]:
				if !flag[0]:
					TextTalk char[0] {
						這裡的實習醫生
						連吃飯的時候都在學習，
						都很努力呢。{wait}
					}
					TextWait
					TextTalk char[0] {
						嗯嗯，必須要趁著年輕時多學一些東西。
						畢竟關係到美好的未來嘛。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[0] {
						為了努力學習的實習醫生們，
						我來想想能夠補腦的
						特別食譜吧。{wait}
					}
					TextWait
					TextTalk char[0] {
						魚眼不知道行不行呢？{wait}
					}
					TextWait
			elif flag[1024]:
				TextTalk char[0] {
					來食堂吃飯的客人們
					都在談論彩虹劇團哦。{wait}
				}
				TextWait
				TextTalk char[0] {
					新的劇碼……
					名字是叫『金之太陽、銀之月』吧，
					我一定要去看看～{wait}
				}
				TextWait
			elif flag[799]:
				if !RecipeLearn 5:
					Call fn[0,5]
				elif !flag[0]:
					TextTalk char[0] {
						住院患者的食物
						也是我做的……{wait}
					}
					TextWait
					TextTalk char[0] {
						昨天住進了個人病房的
						蓋巴爾議員說出了『給我牛排』
						之類的夢話。{wait}
					}
					TextWait
					TextTalk char[0] {
						而我也忍不住反駁說
						『想吃牛排的話，
						就去餐廳吧』。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[0] {
						昨天住進了個人病房的
						蓋巴爾議員說出了『給我牛排』
						之類的夢話。{wait}
					}
					TextWait
					TextTalk char[0] {
						我在烹製料理的時候
						也是要考慮營養平衡的，
						那種任性的傢伙真是讓人頭痛呢。{wait}
					}
					TextWait
			elif flag[793]:
				if !RecipeLearn 5:
					Call fn[0,5]
				elif !flag[0]:
					TextTalk char[0] {
						午休也結束了，
						宿舍裡終於安靜下來了呢。{wait}
					}
					TextWait
					TextTalk char[0] {
						稍後我也
						幫瑪洛妮
						一起打掃吧。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[0] {
						啊……要是想點東西的話，
						不要客氣跟我說哦。{wait}
					}
					TextWait
			elif flag[784]:
				if !RecipeLearn 5:
					Call fn[0,5]
				elif !flag[0]:
					TextTalk char[0] {
						啊，賽西兒，
						休息的時間還沒有結束吧，
						這就要回去了嗎？{wait}
					}
					TextWait
					TextTalk char[0] {
						護理師本來就很忙的，
						所以能休息的時候就要好好休息哦。{wait}
					}
					TextWait
					TextTalk name[53] {
						#1302F呵呵，沒關係的。
						因為見到了羅伊德，
						所以疲勞早就消散了。{wait}
					} {
						#1300F宿舍長，謝謝你借
						地方給我。{wait}
					}
					TextWait
					TextTalk char[0] {
						哈哈，小事一樁。
						妳也住在我們宿舍嘛。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[0] {
						你們也是，別總是帶著賽西兒
						到處亂走。
						她的工作可是非常忙的。{wait}
					}
					TextWait
			elif flag[777]:
				if !RecipeLearn 5:
					Call fn[0,5]
				elif !flag[0]:
					TextTalk char[0] {
						您好，歡迎光臨。
						這裡是醫院職員們的宿舍。{wait}
					}
					TextWait
					TextTalk char[0] {
						有的醫生值夜班後在這裡睡覺，
						千萬不要把他們吵醒了。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[0] {
						食堂和宿舍都有
						向外來的客人開放。{wait}
					}
					TextWait
					TextTalk char[0] {
						要是想吃什麼的話，跟我說就行。
						我會拿出看家本領
						給你們做的。{wait}
					}
					TextWait
	TextEnd char[0]
	Return

fn[5]:
	TextTalk char[0] {
		這所醫院的食物充分考慮到了
		營養的平衡。{wait}
	}
	TextWait
	TextTalk char[0] {
		特別是我的拿手好菜
		手工燉牛肉。{wait}
	}
	TextWait
	TextTalk char[0] {
		我會告訴你們做法，
		如果方便的話，
		你們也試著做做吧。{wait}
	}
	TextWait
	FadeOut 300ms 0x00000000 100
	TextSetPos -1 -1 -1 -1
	TextSetName ""
	SoundPlay sound[17] 0 100 0
	TextMessage null {
		學習了{item[413]}{color 0}的做法。{wait}
	}
	TextWait
	TextMessage null {
		記住了{item[413]}{color 0}的食譜。{wait}
	}
	TextWait
	TextClose 0
	FadeIn 300ms 0x00000000
	TextSetPos -1 280 60 3
	_59
	RecipeLearn 5
	Return

fn[6]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if QuestTaskGet quest[40] 10 && !QuestFlagsGet quest[40] 0x10:
		if !flag[1]:
