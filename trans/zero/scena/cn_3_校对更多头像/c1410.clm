fn[5]:
	TextStart self
	if flag[0]:
		_Char4A char[1] 255
		TextTalk char[0] {
			#0404F阿巴斯，難得的好日子，
			我們就來乾一杯吧。{wait}
		} {
			#0400F呵呵，畢竟是歌頌
			克洛斯貝爾的重要節日啊。{wait}
		}
		TextWait
		_Char4B char[1] 255
	else:
		TextTalk char[0] {
			#0404F我們正在商量今天要不要
			一起去參觀紀念慶典呢。{wait}
		} {
			#0400F……對了，你們也一起來如何？
			肯定會很開心的。{wait}
		}
		TextWait
		TextTalk name[0] {
			#0003F還是免了，不好意思，因為我們正在執勤。{wait}
		} {
			#0001F對了，瓦奇，你是明知如此，
			還故意邀請我們的吧？{wait}
		}
		TextWait
		TextTalk char[0] {
			#0409F啊哈哈！
			你可真夠死腦筋的。{wait}
		}
		TextWait
		CharTurnTo char[0] 135deg 0deg/s
		CharFlagsSet char[0] 0x0010
		FlagSet flag[0]
	TextEnd self
	Return

fn[6]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if flag[10]:
		TextTalk char[6] {
			#0400F（關於阿巴斯這個人，
			　其實我也瞭解得不是很詳細。）{wait}
		} {
			（據說，他好像出身於
			　塞姆利亞大陸中東部。）{wait}
		} {
			（呵呵……
			　總之他很喜歡給自己找事，這倒是不用懷疑的。）{wait}
		}
		TextWait
	elif flag[1793]:
		if flag[0]:
			TextTalk char[6] {
				#0400F太陽都快下山了啊。{wait}
			} {
				雖然不知道你們要去哪，
				但還是早點出發比較好吧？{wait}
			}
			TextWait
		else:
			TextTalk char[6] {
				#0404F……………………………………{wait}
			}
			TextWait
			TextTalk name[0] {
				#0005F瓦奇，怎麼了？{wait}
			}
			TextWait
			TextTalk char[6] {
				#0400F……沒什麼，說起來，
				今晚好像是滿月呢。{wait}
			} {
				#0402F今天的天空很晴朗，
				應該能看到美麗的月亮吧？{wait}
			}
			TextWait
			TextTalk name[1] {
				#0100F是啊……{wait}
			}
			TextWait
			TextTalk name[2] {
				#0200F但月亮不是
				不吉利的象徵麼……{wait}
			}
			TextWait
			TextTalk name[3] {
				#0303F……在如今這種狀況下，
				實在是開心不起來呢。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1792]:
		if flag[0]:
			TextTalk char[6] {
				#0400F算了，至於劍蛇幫那邊，
				我們也會留意的。{wait}
			} {
				你們只要做好
				自己的工作就可以了。{wait}
			}
			TextWait
		else:
			TextTalk char[6] {
				#0403F瓦魯多好像也
				開始焦慮起來了呢。{wait}
			} {
				#0400F……他要是能把那種固執要強的性格稍微改改，
				這種時候也就能輕鬆一些了。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F瓦奇，你好像相當
				關心瓦魯多啊。{wait}
			} {
				#0005F其實，你從一開始就一直
				很擔心劍蛇幫那邊的情況吧……？{wait}
			}
			TextWait
			TextTalk char[6] {
				#0404F呵呵……怎麼說呢。{wait}
			} {
				#0402F只是，瓦魯多那個人嘛，
				有些方面確實是讓人放不下心。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1569]:
		if flag[1670]:
			TextTalk char[6] {
				#0400F呵呵，你們竟然在和
				一課的精英一起行動啊。{wait}
			} {
				正在做什麼呢……
				算了，有些事情還是不問為好。{wait}
			}
			TextWait
		else:
			Call fn[0,7]
	elif flag[1566]:
		if flag[1601]:
			TextTalk char[6] {
				#0400F如今，除了那個叫迪諾
				的少年之外，舊市街中似乎
				就沒有其他服用過那種藥物的人了。{wait}
			} {
				只是，那藥物究竟是誰散發出去的，
				現在還不清楚呢。
				我們這邊也會留意的。{wait}
			}
			TextWait
		else:
			TextTalk char[6] {
				#0402F……來了啊。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0001F瓦奇，能拜託你儘快……
				將情況告訴我們嗎？{wait}
			}
			TextWait
			TextTalk char[6] {
				#0404F我本來是想先要情報費的，
				不過這次就算了吧。{wait}
			} {
				#0406F畢竟，這件事和我們也不是完全無關……
				而且情況似乎相當嚴峻呢。{wait}
			}
			TextWait
			Emote field_party[0] 0mm 2000mm 0 1 250ms 2
			SoundPlay sound[29] 0 100 0
			Emote field_party[1] 0mm 2000mm 0 1 250ms 2
			SoundPlay sound[29] 0 100 0
			Emote field_party[2] 0mm 2000mm 0 1 250ms 2
			SoundPlay sound[29] 0 100 0
			Emote field_party[3] 0mm 2000mm 0 1 250ms 2
			SoundPlay sound[29] 0 100 0
			Sleep 1000ms
			Call fn[0,8]
	elif flag[1560]:
		if flag[0]:
