calmare zero_k scena
scena:
	name "c0100" "c0100" "c0100_1"
	town town[4]
	bgm bgm[100]
	flags 8192
	item_use fn[0,255]
	unk 255 0

entry:
	pos (0, 0, -1000)
	unk1 0
	cam_from (0, 2500, 34000)
	cam_pers 262
	unk2 30
	cam_deg 45deg
	cam_limit 0deg 360deg
	cam_at (1100, 0, -3500)
	unk3 0
	unk4 0
	flags 0x0001
	town town[4]
	init fn[0,5]
	reinit fn[0,6]

// NB: this line is meaningless, it's just here for roundtripping.
label blank

sepith[0] 0 0 0 0 0 0 0 0

fn[0]:
	TextStart self
	if flag[1792]:
		TextTalk self {
			今天的東西已經都買完了呢。{wait}
		}
		TextWait
		TextTalk self {
			按照預定計劃完成目標，
			心情真是不錯啊～{wait}
		}
		TextWait
	elif flag[1566]:
		TextTalk self {
			呼啊……早安啊～{wait}
		}
		TextWait
		TextTalk self {
			希望今天也是不錯的一天啊。{wait}
		}
		TextWait
	elif flag[1554]:
		if !flag[0]:
			TextTalk self {
				港灣區那邊人山人海啊。{wait}
			}
			TextWait
			TextTalk self {
				連警察都來了，
				總覺得氣氛好像有點恐怖，
				是不是發生什麼事了啊～？{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				港灣區那裡好像出了什麼事，
				……希望不是什麼恐怖的事件啊～{wait}
			}
			TextWait
	elif flag[1550]:
	elif flag[1536]:
		TextTalk self {
			不知怎麼回事，預算會議
			好像要延長了呢～{wait}
		}
		TextWait
		TextTalk self {
			算了，反正好像每年
			都會像這樣推延……
			大家都已經不會很在意了。{wait}
		}
		TextWait
	elif flag[1342]:
		if !flag[0]:
			TextTalk self {
				紀念慶典最終日的時候，
				我在米修拉姆看了煙火哦，
				真漂亮呀～{wait}
			}
			TextWait
			TextTalk self {
				不過，聽說那天晚上發生了騷亂，
				真是夠危險的啊。{wait}
			}
			TextWait
			TextTalk self {
				拿不出在米修拉姆住宿的錢，
				反而算是走運呢～{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				聽說在紀念慶典最終日那晚，
				米修拉姆發生了騷亂。{wait}
			}
			TextWait
			TextTalk self {
				我在那之前就回去了，或許算是幸運的呢～{wait}
			}
			TextWait
	elif flag[1055]:
		if !flag[0]:
			TextTalk self {
				麥克道爾市長
				給人的感覺是個非常
				嚴肅正派的老爺爺啊。{wait}
			}
			TextWait
			TextTalk self {
				雖然是政治家，但卻很親切，
				而且好像還很有活力呢。{wait}
			}
			TextWait
			TextTalk self {
				不過……他一直都拄著
				根拐杖呢。
				身體果然還是不太好嗎～{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				爸爸說麥克道爾市長今年
				就要退休了……{wait}
			}
			TextWait
			TextTalk self {
				但那是真的嗎～？{wait}
			}
			TextWait
	elif flag[1040]:
		if !flag[0]:
			TextTalk self {
				今年的紀念慶典將會
				是什麼樣子的呢～{wait}
			}
			TextWait
			TextTalk self {
				所有的店鋪好像都在
				為慶典做準備呢，
				呵呵，真是期待呀～{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				克洛斯貝爾最盛大的慶典活動──
				創立紀念慶典已經臨近了……{wait}
			}
			TextWait
			TextTalk self {
				呵呵，好期待啊～{wait}
			}
			TextWait
	elif flag[1037]:
		TextTalk self {
			買完東西後才發現天已經快黑了。{wait}
		}
		TextWait
		TextTalk self {
			我只要一進入商店，
			就會不知不覺逛上很長時間呢～{wait}
		}
		TextWait
	elif flag[1031]:
		TextTalk self {
			今天看到了好多警察啊……{wait}
		}
		TextWait
		TextTalk self {
			從早上到現在就遇到了五六個。{wait}
		}
		TextWait
		TextTalk self {
			似乎也沒有什麼事件
			發生啊……
			到底是怎麼了呢？{wait}
		}
		TextWait
	elif flag[1024]:
		if !flag[0]:
			TextTalk self {
				唉～最後也還是沒能弄到
				彩虹劇團的門票。{wait}
			}
			TextWait
			TextTalk self {
				我和朋友兩個人都已經
				很努力地排隊了～{wait}
			}
			TextWait
			TextTalk self {
				就在只剩下五個人就排到我們時，
				票便全部賣光了。{wait}
			}
			TextWait
			TextTalk self {
				嗚嗚，真是很受打擊啊。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				啊啊啊！光是回憶一下就好不甘心～！{wait}
			}
			TextWait
			TextTalk self {
				而且那裡的門票
				未免太貴了吧！{wait}
			}
			TextWait
			TextTalk self {
				就算把零用錢全部都貼進去
				好像也不夠。{wait}
			}
			TextWait
	elif flag[801]:
		TextTalk self {
			據說阿爾摩利卡村產的蔬菜
			對健康大有益助呢，{wait}
		}
		TextWait
		TextTalk self {
			能讓皮膚變得潤滑透亮，
			我也吃吃看好了。{wait}
		}
		TextWait
	elif flag[777]:
		if !flag[0]:
			TextTalk self {
				今天準備去西側大道的親戚
				家裡玩。{wait}
			}
			TextWait
			TextTalk self {
				不過市內沒有
				巴士可以坐啊。{wait}
			}
			TextWait
			TextTalk self {
				真是不方便。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				克洛斯貝爾市很廣闊的，
				我覺得市內也應該通車
				才對。{wait}
			}
			TextWait
	elif flag[768]:
		TextTalk self {
			剛才看到一輛綠色的大車開過去了。{wait}
		}
		TextWait
		TextTalk self {
			車身還印有克洛斯貝爾警備隊的徽章呢，
			車上的是不是警備隊的人呢～{wait}
		}
		TextWait
	elif flag[533]:
		if !flag[0]:
			TextTalk self {
				本來想和朋友找個
				公寓住的……{wait}
			}
			TextWait
			TextTalk self {
				但是都沒有找到便宜的
				房子啊～{wait}
			}
			TextWait
			TextTalk self {
				看來還是要和父母一起住，
				暫時就別想獨立了。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				最近的經濟很景氣，
				房租也都變得很高。{wait}
			}
			TextWait
			TextTalk self {
				呼，實在不行的話，
				是不是要考慮找人分租了呢。{wait}
			}
			TextWait
	elif flag[526]:
		if !flag[0]:
			TextTalk self {
				我的爸爸在大公司裡
				上班……{wait}
			}
			TextWait
			TextTalk self {
				說是公司裡最近設置了
				叫做『導力網路』的東西。{wait}
			}
			TextWait
			TextTalk self {
				不過爸爸弄不懂使用方法，
				每天都很鬱悶呢。{wait}
			}
			TextWait
			TextTalk self {
				真是的，爸爸好沒用哦～{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				『導力網路』這種東西，好像
				是種非常便利的裝置……{wait}
			}
			TextWait
			TextTalk self {
				但要是不知道使用方法，
				那不還是和沒有一樣嘛～{wait}
			}
			TextWait
	TextEnd self
	Return

fn[1]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if flag[1792]:
		TextTalk self {
			聽說延遲了很久的預算會議
			總算是結束了啊。{wait}
		}
		TextWait
		TextTalk self {
			後天要向市民發表結果……
			哎呀呀，最後會是如何呢～{wait}
		}
		TextWait
		TextTalk self {
			和去年相比，希望至少也能
			通過一些浪費比較少的
			預算案啊。{wait}
		}
		TextWait
	elif flag[1566]:
		TextTalk self {
			預算會議好像在今天
			就能結束了啊。{wait}
		}
		TextWait
		TextTalk self {
			今年似乎比往年
			拖得都要長呢。{wait}
		}
		TextWait
	elif flag[1554]:
		TextTalk self {
			你們聽說了嗎，黑手黨之間開戰的傳聞……{wait}
		}
		TextWait
		TextTalk self {
			真是令人厭惡啊……
			在以前，如果發生了這種事件，
			往往都會死人的。{wait}
		}
		TextWait
		TextTalk self {
			本以為克洛斯貝爾多少也都
			變得和平一些了，
			但看來還是不能安心啊……{wait}
		}
		TextWait
	elif flag[1550]:
	elif flag[1536]:
		if !flag[1]:
			TextTalk self {
				通向瑪因茲礦山鎮的隧道內有條岔路，
				岔路的盡頭有個遺跡。{wait}
			}
			TextWait
			TextTalk self {
				傳說每到滿月之夜，那裡就會響起
				美妙的鐘聲哦。{wait}
			}
			TextWait
			TextTalk self {
				那處遺跡好像是在中世紀建造的建築，
				除此之外就一無所知了。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				通向瑪因茲礦山鎮的隧道內有條岔路，
				岔路的盡頭有個遺跡。{wait}
			}
			TextWait
			TextTalk self {
				傳說每到滿月之夜，那裡就會響起
				美妙的鐘聲哦。{wait}
			}
			TextWait
	elif flag[1342]:
		if !flag[1]:
			TextTalk self {
				從明天開始，預算會議就要在
				市政廳召開了。{wait}
			}
			TextWait
			TextTalk self {
				那是決定克洛斯貝爾的各種公共事業
				預算的重要會議……{wait}
			}
			TextWait
			TextTalk self {
				但是每年都沒法在
				預定的結束日順利得出結論。
				今年又會如何呢……{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				克洛斯貝爾的預算會議
				每年都遲遲得不出結論。{wait}
			}
			TextWait
			TextTalk self {
				大概是市長與議長的對立
				延遲了決議吧。
				今年又會如何呢……{wait}
			}
			TextWait
	elif flag[1055]:
		if !flag[1]:
			TextTalk self {
				位於克洛斯貝爾市南部的
				『星見之塔』據說是個建造於
				中世紀的建築。{wait}
			}
			TextWait
			TextTalk self {
				克洛斯貝爾似乎從那時開始就是個
				充斥著交易與戰亂的地區。{wait}
			}
			TextWait
			TextTalk self {
				傳聞說，那是當時的掌權者
				為了進行占星術
				而下令建造的。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				據說『星見之塔』是中世紀時
				為了占星術而建造的。{wait}
			}
			TextWait
			TextTalk self {
				不過，這種說法並沒有
				什麼實際依據，
				連真偽都無法斷定。{wait}
			}
			TextWait
	elif flag[1040]:
		TextTalk self {
			ＩＢＣ的總裁迪塔先生，
			一直都是支撐著克洛斯貝爾的
			經濟界第一人。{wait}
		}
		TextWait
		TextTalk self {
			他並不只會賺錢，
			對公共事業和慈善・支援機關
			也積極捐款。{wait}
		}
		TextWait
		TextTalk self {
			雖說是人無完人……
			但感覺迪塔先生好像
			真的是個非常完美的人啊。{wait}
		}
		TextWait
	elif flag[1037]:
		TextTalk self {
			那麼，我差不多也該回去了。{wait}
		}
		TextWait
		TextTalk self {
			總是在這種地方待著，
			說不定會感冒呢。{wait}
		}
		TextWait
	elif flag[1031]:
		TextTalk self {
			彩虹劇團那傳聞中的新劇，
			聽說第二主角會由新人出演。{wait}
		}
		TextWait
		TextTalk self {
			如果那新人真如傳聞所說，是被
			那個伊莉雅・普拉提耶親自發掘的，
			那應該是個具有相當實力的人吧。{wait}
		}
		TextWait
	elif flag[1024]:
		TextTalk self {
			住在克洛斯貝爾的人
			最喜歡熱鬧場面。{wait}
		}
		TextWait
		TextTalk self {
			特別是像慶典這樣的活動，
			無論老少，全都會因此而熱情高漲。{wait}
		}
		TextWait
		TextTalk self {
			下個月舉辦的將是７０周年的創立紀念慶典。
			今年到底會熱鬧到什麼程度呢？我非常期待啊。{wait}
		}
		TextWait
	elif flag[801]:
		TextTalk self {
			《彩虹劇團》可是克洛斯貝爾
			引以為傲的明星集團。{wait}
		}
		TextWait
		TextTalk self {
			在國外的名流階層中都很受歡迎，
			聽說偷偷潛入自治州來欣賞的人
			也都不在少數呢。{wait}
		}
		TextWait
	elif flag[777]:
		if !flag[1]:
			TextTalk self {
				前段時間，我在小巷那邊
				發現了一家
				詭異的古董店。{wait}
			}
			TextWait
			TextTalk self {
				店裡陳列著各種奇怪的商品，
				店主老婆婆也給人一種
				很奇怪的感覺。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				前段時間，我在小巷那邊
				發現了一家
				詭異的古董店。{wait}
			}
			TextWait
			TextTalk self {
				唔……以前有那樣
				一家店嗎。{wait}
			}
			TextWait
	elif flag[768]:
		if !flag[1]:
			TextTalk self {
				克洛斯貝爾的人
				最喜歡各種小道傳聞了。{wait}
			}
			TextWait
			TextTalk self {
				光是每天出門散散步，
				就能聽到不少消息呢。{wait}
			}
			TextWait
			TextTalk self {
				從事件的背後隱情
				到外國的經濟動向……{wait}
			}
			TextWait
			TextTalk self {
				在克洛斯貝爾，
				能打聽到所有情報，
				這麼說都不過分。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				克洛斯貝爾的人
				最喜歡各種小道傳聞了。{wait}
			}
			TextWait
			TextTalk self {
				呵，畢竟是一直都從事著貿易業的
				人民啊。{wait}
			}
			TextWait
	elif flag[533]:
		if !flag[1]:
			TextTalk self {
				魯巴徹商會的那群傢伙
				在很早以前就在克洛斯貝爾紮根了。{wait}
			}
			TextWait
			TextTalk self {
				……也就是所謂的黑手黨啊。{wait}
			}
			TextWait
			TextTalk self {
				可悲的是，警察根本就
				沒有辦法將他們取締。
				你們還是不要和他們扯上關係為好。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				連警察都制裁不了
				魯巴徹商會，
				……你們還是不要和他們扯上關係為好。{wait}
			}
			TextWait
	elif flag[526]:
		if !flag[1]:
			TextTalk self {
				百貨的翻修，
				還有全新的導力商店……{wait}
			}
			TextWait
			TextTalk self {
				克洛斯貝爾的街道格局
				可真是日新月異啊。{wait}
			}
			TextWait
			TextTalk self {
				這雖然是好事，
				但也讓人看得眼花繚亂，
				似乎一不小心就會迷路呢。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				街道的格局變化如此之大，
				連我這種土生土長的克洛斯貝爾人
				一不小心都會迷路呢。{wait}
			}
			TextWait
	CharSetChipPattern self 0
	TextEnd self
	Return

fn[2]:
	TextStart self
	if flag[1792]:
		TextTalk self {
			剛才有警察從機場那邊
			撤離呢。{wait}
		}
		TextWait
		TextTalk self {
			好像在說什麼
			爆炸物之類的東西……
			嗯嗯，果然是很危險啊……{wait}
		}
		TextWait
	elif flag[1566]:
		if !flag[2]:
			TextTalk self {
				警車慌慌張張地
				往機場那邊駛去了。{wait}
			}
			TextWait
			TextTalk self {
