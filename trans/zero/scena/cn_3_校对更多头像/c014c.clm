fn[9]:
	TextTalk char[1] {
		#08100FＯＫ。
		想問哪方面的問題呢？{wait}
	}
	TextWait
	var[3] = 0
	while var[3] != 255:
		FadeOut 300ms 0x00000000 100
		Menu menu[1] -1 -1 1
			"關於戰術導力器" // 0
			"關於結晶迴路" // 1
			"關於插槽" // 2
			"關於導力魔法" // 3
			"放棄" // 4
		MenuWait var[3]
		MenuClose menu[1]
		FadeIn 300ms 0x00000000
		_59
		switch var[3]:
			case 0:
				TextTalk char[1] {
					#08100F所謂的『戰術導力器』，
					就是一種專門用於個人戰鬥的
					可攜式小型導力器。{wait}
				} {
					#08102F不僅能強化使用者的能力，
					還可以用來發動導力魔法。{wait}
				} {
					#08110F一般情況下，我們就把它
					簡稱為『導力器』啦。{wait}
				} {
					#08100F你們所使用的，
					就是其中的最新型號──
					名為『ＥＮＩＧＭＡ』的導力器。{wait}
				} {
					#08104F為了配合每個人的具體情況與使用習慣，
					我們會對導力器進行完美的微調，
					所以其構造會因人而異。{wait}
				} {
					#08100F像限定屬性的插槽啦，連接插槽的
					結晶孔形狀啦，都會有所不同。
					各位可以自行比較一下每個人的導力器。{wait}
				}
				TextWait
				break
			case 1:
				TextTalk char[1] {
					#08100F所謂結晶迴路，就是將耀晶石進行精煉後
					所製造出的，戰術導力器專用的『結晶迴路』。{wait}
				} {
					#08102F如果攜帶有足夠數量的耀晶石，
					就可以在我們這裡進行合成。{wait}
				} {
					#08100F每種結晶迴路都有各自的特性效果，
					同一條結晶孔上的結晶迴路屬性值達到一定數值後，
					就可以使用特定的導力魔法了。{wait}
				} {
					#08110F如果你們賺夠了耀晶石，可以進行多種嘗試呢。{wait}
				}
				TextWait
				break
			case 2:
				TextTalk char[1] {
					#08100F導力器的插槽，
					在最初時幾乎都是未解鎖的狀態。{wait}
				} {
					#08104F所以如果想要鑲嵌結晶迴路，
					首先需要解鎖插槽。{wait}
				} {
					#08102F多解鎖一些插槽，
					不僅可以鑲嵌更多的結晶迴路，
					同時也能提升最大ＥＰ值。{wait}
				} {
					#08110F解鎖雖然需要使用耀晶石，
					但後續會非常便利。
					所以建議多加利用哦。{wait}
				}
				TextWait
				break
			case 3:
				TextTalk char[1] {
					#08100F利用戰術導力器發動的魔法
					統稱為導力魔法。{wait}
				} {
					#08110F在多數情況下，我們習慣將它簡稱為『魔法』。{wait}
				} {
					#08104F其實，魔法是由安置在導力器內部的機械裝置
					和結晶迴路與使用者產生連鎖共鳴，
					從而引發的現象……{wait}
				} {
					#08111F算了，這種細節知識不說也罷。{wait}
				} {
					#08100F而可發動的魔法，是由
					『每條結晶孔上所鑲嵌的結晶迴路屬性總值』
					所決定的。{wait}
				} {
					#08105F這個稍微有些複雜，怎麼說好呢……
					對了，舉個例子吧。{wait}
				} {
					#08104F在處於同一條結晶孔上的
					插槽中鑲嵌結晶迴路，
					如果地屬性的總值超過了２……{wait}
				} {
					#08110F就可以使用『地震波』
					這個魔法了。{wait}
				} {
					#08102F鑲嵌的結晶迴路數越多，
					可使用的魔法種類
					也就越多。{wait}
				} {
					#08109F至於發動其它魔法所需的屬性值，
					應該都記錄在魔法清單中了。
					請隨時參考吧。{wait}
				}
				TextWait
				break
			default:
				var[3] = 255
				break
	var[3] = 0
	Return

