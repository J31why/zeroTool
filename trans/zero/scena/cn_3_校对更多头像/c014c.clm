				Call fn[0,6]
				var[0] = 99
			elif var[0] == 1:
				MenuClose menu[0]
				Call fn[0,5]
				var[0] = 99
		TextEnd char[0]
	else:
		TextStart char[0]
		Call fn[0,6]
		TextEnd char[0]
	Return

