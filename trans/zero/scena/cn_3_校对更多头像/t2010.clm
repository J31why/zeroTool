	TextStart char[3]
	if flag[1280] && !flag[1282]:
		if QuestTaskGet quest[25] 3 && !QuestTaskGet quest[25] 4:
			Call fn[0,44]
			Return
	var[0] = 99
	while var[0] == 99:
