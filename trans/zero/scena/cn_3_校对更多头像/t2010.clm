fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharWalkToPos self (16079, 0, 3700) 2000mm/s 0
		CharTurnTo self 90deg 400deg/s
		Sleep 2000ms
		CharTurnTo self 225deg 400deg/s
		Sleep 100ms
		CharWalkToPos self (9170, 0, -4250) 2000mm/s 0
		CharTurnTo self 180deg 400deg/s
		Sleep 2000ms
		CharTurnTo self 270deg 400deg/s
		Sleep 100ms
		CharWalkToPos self (-9020, 0, -3100) 2000mm/s 0
		CharTurnTo self 270deg 400deg/s
		Sleep 2000ms
		CharTurnTo self 45deg 400deg/s
		Sleep 100ms
		CharWalkToPos self (8720, 0, 4400) 2000mm/s 0
	Return

fn[2]:
	while 1:
		CharWalkToPos self (16079, 0, 3700) 2000mm/s 0
		CharTurnTo self 90deg 400deg/s
