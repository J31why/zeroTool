fn[5]:
	TextStart char[0]
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"對話" // 0
			"購物" // 1
			"放棄" // 2
		MenuWait var[0]
		if var[0] != 1:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			ShopOpen shop[102]
			var[0] = 99
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			if !flag[0]:
				TextTalk char[0] {
					晚餐中供應的是
					從帝國直送過來的上等葡萄酒，
					『艾爾・沃瓦魯』，請享用。{wait}
				}
				TextWait
				TextTalk char[0] {
					該紅酒價格不菲，其芳醇的香氣
					與著名的『格蘭・夏利拿』相比，
					也是毫不遜色。{wait}
				}
				TextWait
				if !flag[1353]:
					TextTalk name[1] {
						#0103F『格蘭・夏利拿』……
						那好像是利貝爾王國釀造的
						上等葡萄酒哦。{wait}
					} {
						#0100F幾年前曾在利貝爾王國內拍賣，
						最後以五十萬米拉的價格成交。{wait}
					}
					TextWait
				else:
					TextTalk name[1] {
						#5303F『格蘭・夏利拿』……
						那好像是利貝爾王國釀造的
						上等葡萄酒哦。{wait}
					} {
						#5300F幾年前曾在利貝爾王國內拍賣，
						最後以五十萬米拉的價格成交。{wait}
					}
					TextWait
				TextTalk name[0] {
					#5005F五、五十萬米拉……！？
					一瓶葡萄酒竟然這麼值錢……{wait}
				}
				TextWait
				if !flag[1354]:
					TextTalk name[2] {
						#0203F難以理解的世界。{wait}
					}
					TextWait
				else:
					TextTalk name[2] {
						#5403F難以理解的世界。{wait}
					}
					TextWait
				if !flag[1355]:
					TextTalk name[3] {
						#0304F如果真有這等美酒，
						那可一定要嘗嘗看啊。{wait}
					} {
						#0309F怎麼樣，我先來一杯……{wait}
					}
					TextWait
				else:
					TextTalk name[3] {
						#5604F如果真有這等美酒，
						那可一定要嘗嘗看啊。{wait}
					} {
						#5609F怎麼樣，我先來一杯……{wait}
					}
					TextWait
				if !flag[1354]:
					TextTalk name[2] {
						#0211F…………………………{wait}
					}
					TextWait
				else:
					TextTalk name[2] {
						#5411F…………………………{wait}
					}
					TextWait
				if !flag[1355]:
					TextTalk name[3] {
						#0306F……我、我開個玩笑啦！{wait}
					}
					TextWait
				else:
					TextTalk name[3] {
						#5606F……我、我開個玩笑啦！{wait}
					}
					TextWait
				TextTalk name[0] {
					#5003F明白就好。{wait}
				}
				TextWait
				FlagSet flag[0]
			else:
				TextTalk char[0] {
					『艾爾・沃瓦魯』是一種
					與『格蘭・夏利拿』相比
					也毫不遜色的上等葡萄酒。{wait}
				}
				TextWait
				TextTalk char[0] {
					不嫌棄的話，請在晚餐時盡情享用。{wait}
				}
				TextWait
	TextEnd char[0]
	Return

fn[6]:
	TextStart self
	TextTalk self {
		說起來……
		紀念慶典到今天就該結束了吧。{wait}
	}
	TextWait
	TextTalk self {
		看起來，市裡好像
		也相當熱鬧呢……
		嗚嗚……好想去啊。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[7]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if !flag[1]:
		TextTalk self {
			（狼吞虎嚥）……{wait}
		}
		TextWait
		TextTalk self {
			（大吃大喝）……{wait}
		}
		TextWait
		TextTalk self {
			嗯！這料理簡直太棒了！{wait}
		}
		TextWait
		TextTalk self {
			買不到寶石的憤怒
			立刻就煙消雲散了！{wait}
		}
		TextWait
		FlagSet flag[1]
	else:
		TextTalk self {
			唔唔……真好吃。{wait}
		}
		TextWait
		CharSetChipPattern self 2
		TextTalk self {
			……不好意思，
			再給我來一份㈱{wait}
		}
		TextWait
	CharSetChipPattern self 0
	TextEnd self
	Return

