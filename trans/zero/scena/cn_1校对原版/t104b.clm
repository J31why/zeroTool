fn[13]:
	TextStart char[7]
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"對話" // 0
			"購物" // 1
			"放棄" // 2
		MenuWait var[0]
		if var[0] != 1:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			ShopOpen shop[105]
			var[0] = 99
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			if !flag[4]:
				TextTalk char[7] {
					客人，這套衣服真是非常適合您啊。{wait}
				}
				TextWait
				TextTalk char[7] {
					這是採用了最近的流行元素，
					並經過精心搭配的
					典雅樣式……{wait}
				}
				TextWait
				TextTalk char[7] {
					瓦奇先生的衣著品味
					讓身為專家的我都自愧不如呢。{wait}
				}
				TextWait
				TextTalk name[0] {
					#5005F（那傢伙……到底是什麼人呢……？）{wait}
				}
				TextWait
				FlagSet flag[4]
			else:
				TextTalk char[7] {
					瓦奇先生的衣著品味
					讓身為專家的我都自愧不如呢。{wait}
				}
				TextWait
	TextEnd char[7]
	Return

fn[14]:
	TextStart self
	CharTurnToChar char[8] char[9] 0deg/s
	if !flag[5]:
		Call fn[0,16]
	else:
		TextTalk self {
			不知客人是否中意……{wait}
		}
		TextWait
		TextTalk self {
			不然，我們就換一種風格，
			您看這頂帽子怎麼樣？{wait}
		}
		TextWait
	TextEnd self
	Return

fn[15]:
	TextStart self
	CharTurnTo self 270deg 0deg/s
	if !flag[5]:
		Call fn[0,16]
	else:
		TextTalk self {
			（真、真麻煩啊……
			　本來想隨便敷衍幾句
			　就趕快回去的……）{wait}
		}
		TextWait
		TextTalk self {
			（被如此熱情地推薦，
			　不買點東西就離開的話，
			　良心上也過不去吧……！）{wait}
		}
		TextWait
	TextEnd self
	Return

