fn[4]:
	TriggerFlagsSet trigger[0] 0x0080
	TriggerFlagsSet trigger[1] 0x0080
	if flag[1323] && !flag[1324]:
		TriggerFlagsUnset trigger[0] 0x0080
	if flag[1324] && !flag[1329]:
		TriggerFlagsUnset trigger[1] 0x0080
	if flag[1333]:
	Return

fn[5]:
	CharFlagsSet char[11] 0x0080
	CharFlagsUnset char[12] 0x0080
	CharFlagsSet char[12] 0x0010
	CharSetPos char[9] (-3200, 0, 280) 315deg
	CharFlagsSet char[9] 0x0010
	CharSetPos char[13] (-2040, 0, 1320) 315deg
	CharFlagsSet char[13] 0x0010
	CharSetPos char[14] (-1700, 0, 3200) 270deg
	CharFlagsSet char[14] 0x0010
	CharTurnTo char[15] 180deg 0deg/s
	Return

fn[6]:
	if flag[1322] && !flag[1323]:
		Call fn[0,24]
	else:
		field_party[0].5 = char[0].4
		char[0].5 = char[0].4
		TextStart char[0]
		CharFlagsUnset char[0] 0x0010
		CharTurnToChar char[0] field_party[0] 0deg/s
		char[0].4 = (char[0].4 + 360) % 360
		char[0].4 = char[0].4 + 360 - char[0].5
		char[0].5 = char[0].4 / 180
		if char[0].4 <= 45 | char[0].4 >= 315 && char[0].4 <= 405 | char[0].4 >= 675:
		elif char[0].5 < 1:
			char[0].8 = 2
		elif char[0].5 > 2:
			char[0].8 = 1
		else:
			char[0].8 = char[0].5
		char[0].4 = field_party[0].5
		field_party[0].5 = 0
		char[0].5 = 0
		CharFlagsSet char[0] 0x0010
		if flag[1324]:
			TextTalk char[0] {
				#3401F唔……
				那就是哈爾特曼議長……{wait}
			} {
				看來是個很棘手的人物呢。{wait}
			}
			TextWait
		else:
			TextTalk char[0] {
				#3400F擊潰這個黑之拍賣會
				的契機……
				說不定就近在咫尺。{wait}
			} {
				多觀察觀察，自行感受吧。
				這樣做一定會對你們有所幫助。{wait}
			}
			TextWait
		CharSetChipPattern char[0] 0
		TextEnd char[0]
	Return

fn[7]:
	TextStart self
	if flag[1333]:
	elif flag[1330]:
		TextTalk self {
			沙龍的收拾善後，
			這樣就算是告一段落了。{wait}
		}
		TextWait
		TextTalk self {
			還要商量晚宴的相關事宜，
			先到接待室
			集合吧。{wait}
		}
		TextWait
	elif flag[1329]:
		TextTalk self {
			哎呀……客人，
			您有什麼事嗎？{wait}
		}
		TextWait
		TextTalk self {
			老爺和其他賓客
			都已經前往
			拍賣會場了哦。{wait}
		}
		TextWait
	elif flag[1324]:
		TextTalk self {
			哎呀，客人。
			您是要額外點些什麼菜嗎？{wait}
		}
		TextWait
		TextTalk self {
			如有需要，
			敬請吩咐……{wait}
		}
		TextWait
	elif flag[1320]:
		TextTalk self {
			各餐台的料理
			都是由哈爾特曼府專職廚師
			精心烹製的最高級菜肴。{wait}
		}
		TextWait
		TextTalk self {
			如果有什麼需要，請不必客氣，儘管吩咐。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[8]:
	TextStart self
	if flag[1333]:
	elif flag[1330]:
		if !flag[0]:
			TextTalk self {
				這話可別說出去……
				安排在院子裡的看門狗
				非常可怕。{wait}
			}
			TextWait
			TextTalk self {
				雖說是用於警備，
				但畢竟是魯巴徹商會的軍犬……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				安排在院子裡的看門狗
				非常可怕。{wait}
			}
			TextWait
			TextTalk self {
				萬一不小心被咬到的話……
				(發抖）……{wait}
			}
			TextWait
	elif flag[1329]:
		TextTalk self {
			拍賣會即將開始，
			站食餐會到此結束。{wait}
		}
		TextWait
		TextTalk self {
			拍賣會結束之後，
			將在庭院內舉辦晚宴。
			請各位務必賞光出席。{wait}
		}
		TextWait
	elif flag[1324]:
		TextTalk self {
			再過片刻，
			拍賣會便將開場。{wait}
		}
		TextWait
		TextTalk self {
			隨著拍賣會的開場，
			站食餐會也將結束，
			請趁現在盡情享用美食。{wait}
		}
		TextWait
	elif flag[1320]:
		TextTalk self {
			今晚的餐會
			出於老爺的一番好意，
			所有料理全部免費提供。{wait}
		}
		TextWait
		TextTalk self {
			請不必客氣，
			盡情享用美食。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[9]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if !flag[1394]:
		if flag[665]:
			TextTalk self {
				哎呀哎呀……
				這張臉……好像曾在哪裡見過呢。
				嘻哈哈……{wait}
			}
			TextWait
			if QuestTaskGet quest[10] 0:
				TextTalk name[0] {
					#5105F伊美黛夫人！？{wait}
				}
				TextWait
			else:
				TextTalk name[0] {
					#5105F您是……
					那家古董店的……！？{wait}
				}
				TextWait
			if flag[1353]:
				TextTalk name[1] {
					#5305F您怎麼會在這裡……！？{wait}
				}
				TextWait
			elif flag[1354]:
				TextTalk name[2] {
					#5405F……您為何會在這裡？{wait}
				}
				TextWait
			elif flag[1355]:
				TextTalk name[3] {
					#5606F喂喂！
					老婆婆，你怎麼會在這種地方……{wait}
				}
				TextWait
			TextTalk self {
				我透過某條門路得到了邀請函。
				然後出於興趣，就來看看了。{wait}
			}
			TextWait
			TextTalk name[0] {
				#5106F（還是老樣子，真是個可疑的老婆婆啊……）{wait}
			}
			TextWait
		else:
			TextTalk self {
				哎呀哎呀……
				你們莫非
				是警察局的人嗎？{wait}
			}
			TextWait
			Emote field_party[0] 0mm 2000mm 2 7 80ms 1
			SoundPlay sound[28] 0 100 0
			Emote field_party[1] 0mm 2000mm 2 7 80ms 1
			SoundPlay sound[28] 0 100 0
			Sleep 1000ms
			TextTalk name[0] {
				#5105F您怎麼會知……！？{wait}
			}
			TextWait
			TextTalk self {
				嘻哈哈……
				果然是啊。{wait}
			}
			TextWait
			TextTalk self {
				我啊，
				在克洛斯貝爾市
				經營古董店哦。{wait}
			}
			TextWait
			TextTalk self {
				在克洛斯貝爾時報周刊上
				看到過你們的报道呢。{wait}
			}
			TextWait
			TextTalk name[0] {
				#5106F即、即使如此，
				您又為何會在這種地方……{wait}
			}
			TextWait
			TextTalk self {
				我透過某條門路得到了邀請函。
				然後出於興趣，就來看看了。{wait}
			}
			TextWait
			TextTalk name[0] {
				#5106F（真是個超級可疑的老婆婆啊……）{wait}
			}
			TextWait
		TextTalk name[0] {
			#5101F……那、那個，
			關於我們的事情……{wait}
		}
		TextWait
		TextTalk self {
			嘻哈哈……
			不用擔心，我不會告密的。{wait}
		}
		TextWait
		TextTalk self {
			在四處都是惡黨的地方
			有幾個你們這樣的人，
			也挺有意思的哦。{wait}
		}
		TextWait
		FlagSet flag[1394]
	elif flag[1324]:
		TextTalk self {
			瑪律克尼那小子，每次見他，
			都覺得更有壞狸貓的樣子了。{wait}
		}
		TextWait
		TextTalk self {
			不光是行為舉止，
			連外表都和狸貓一模一樣嘛。
			嘻哈哈……{wait}
		}
		TextWait
	else:
		TextTalk self {
			因為有想要的拍賣品，
			所以就來看看了……{wait}
		}
		TextWait
		TextTalk self {
			看來事情會變得很有趣呢。
			嘻哈哈……{wait}
		}
		TextWait
	CharSetChipPattern self 0
	TextEnd self
	Return

fn[10]:
	TextStart self
	if flag[1324]:
		TextTalk self {
			（老大和哈爾特曼議長
			　似乎心情很好……）{wait}
		}
		TextWait
		TextTalk self {
			（如果能這麼順利結束，就最好不過了……）{wait}
		}
		TextWait
	else:
	TextEnd self
	Return

fn[11]:
	TextStart self
	if flag[1324]:
		TextTalk self {
			（盯著看）………………{wait}
		}
		TextWait
		TextTalk self {
			……失禮了。
			為了確保萬無一失，
			我正在全力進行安保工作。{wait}
		}
		TextWait
	else:
	TextEnd self
