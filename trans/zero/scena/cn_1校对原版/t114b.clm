fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharIdle self (-830, null, -860) (2190, null, 2180) 1000mm/s
		Sleep 300ms
	Return

fn[2]:
	while 1:
		Sleep 2000ms
		CharTurnTo self 180deg 400deg/s
		Sleep 100ms
		CharWalkToPos self (-110, 0, -9870) 2000mm/s 0
		CharTurnTo self 90deg 400deg/s
		Sleep 1600ms
		CharTurnTo self 180deg 400deg/s
		Sleep 100ms
		CharWalkToPos self (-940, 0, -14060) 2000mm/s 0
		CharTurnTo self 180deg 400deg/s
		Sleep 2000ms
		CharTurnTo self 0deg 400deg/s
		Sleep 100ms
		CharWalkToPos self (820, 0, -5350) 2000mm/s 0
		CharTurnTo self 315deg 400deg/s
	Return

fn[3]:
