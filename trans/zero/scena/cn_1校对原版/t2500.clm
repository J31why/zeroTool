fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharIdle self (-25280, null, -15860) (-21020, null, -9020) 1000mm/s
		Sleep 250ms
	Return

fn[2]:
	if flag[1090]:
		Call fn[0,3]
	if !flag[1040] && flag[1024]:
		CharFlagsUnset char[5] 0x0080
		if flag[736]:
			FlagUnset flag[736]
			Event fn[0,30]
	if !flag[1090]:
		SystemFlagsSet 0x10000000
		Event fn[0,29]
		FlagSet flag[1090]
	else:
		if flag[1008]:
			FlagUnset flag[1008]
			Event fn[0,8]
		if flag[1009]:
			FlagUnset flag[1009]
			global[1] = 6
			Event fn[0,10]
	Return

fn[3]:
	if flag[1566]:
		CharFlagsUnset char[13] 0x0080
	elif flag[1554]:
		CharFlagsUnset char[12] 0x0080
	elif flag[1536]:
		CharFlagsSet char[3] 0x0080
		CharFlagsUnset char[4] 0x0080
	elif flag[1307]:
		CharFlagsUnset char[10] 0x0080
		CharFlagsUnset char[11] 0x0080
		ForkFunc char[11] fork[0] fn[0,1]
	elif flag[1292]:
		CharFlagsUnset char[9] 0x0080
	elif flag[1282]:
		if QuestFlagsGet quest[27] 0x10:
			CharFlagsUnset char[8] 0x0080
		elif QuestTaskGet quest[27] 13:
			CharFlagsSet char[8] 0x0080
			CharFlagsUnset char[23] 0x0080
		else:
	elif flag[1280]:
		CharFlagsUnset char[6] 0x0080
		CharFlagsUnset char[7] 0x0080
	elif flag[1040]:
	elif flag[1024]:
	if flag[1280] && !flag[1536]:
		CharFlagsUnset char[14] 0x0080
		CharFlagsUnset char[15] 0x0080
	Return

fn[4]:
	ObjFlagsSet object[4] 0x0004
	ED7_76_0 object[2] "light" 1
	ED7_76_0 object[3] "light" 1
	ED7_76_0 object[4] "light" 1
	ED7_76_0 object[4] "chukin" 1
	TriggerFlagsSet trigger[0] 0x0080
	TriggerFlagsSet trigger[1] 0x0080
	if flag[1566]:
	elif flag[1554]:
	elif flag[1536]:
	elif flag[1307]:
	elif flag[1292]:
		ObjFlagsUnset object[4] 0x0004
	elif flag[1282]:
		if QuestTaskGet quest[27] 13 && !QuestFlagsGet quest[27] 0x10:
			LookPointFlagsSet look_point[0] 0x0001
			TriggerFlagsUnset trigger[0] 0x0080
			TriggerFlagsUnset trigger[1] 0x0080
			CharFlagsUnset char[22] 0x0080
			ObjFlagsUnset object[5] 0x0004
			ObjFlagsSet object[5] 0x0002
			ED7_78 object[5] char[22]
			ED7_76_0 object[5] "light" 1
			CharSetPos char[22] (-26910, 0, 24000) 0deg
			Sc_D1 char[22] 0 0 0 0ms
			ObjFlagsSet object[5] 0x1000
			ED7ObjPlay object[5] 30 30 0 0
			ED7_74 object[5] 0 30
	elif flag[1280]:
	elif flag[1040]:
	elif flag[1024]:
		if flag[736]:
			FlagUnset flag[736]
	LookPointFlagsSet look_point[2] 0x0001
	if flag[1537] && !flag[1542] && global[1] == 6:
		ObjFlagsUnset object[2] 0x0004
		ED7_78 object[2] char[24]
		ObjFlagsSet object[2] 0x1000
		ED7_76_0 object[2] "light" 1
		CharSetPos char[24] (-40000, 0, 2500) 0deg
		Sc_D1 char[24] 0 270000 0 0ms
		ED7_74 object[2] 0 30
		ObjFrame object[2] 0
		LookPointFlagsUnset look_point[2] 0x0001
	else:
		ZeroMap_3 3 1
	if flag[1537] && !flag[1542] && global[1] != 6:
		ObjFlagsSet object[2] 0x0004
	if flag[1056] && !flag[1280]:
		ObjFlagsSet object[2] 0x0004
	if !flag[2205]:
		ObjFrame object[6] 0
	else:
		ObjFrame object[6] 30
	Return

fn[5]:
	ED7_F2 1
	SystemFlagsSet 0x08000000
	if !flag[2205]:
		SoundPlay sound[14] 0 100 0
		ED7ObjPlay object[6] 0 30 0 0
		Sleep 500ms
		if ItemAdd item[1506] 1:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextSetName ""
			TextMessage name[742] {
				{color 0}已取得{item[1506]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			TextSetPos -1 280 60 3
			FadeIn 300ms 0x00000000
			FlagSet flag[2205]
			ED7_DE 6
		else:
			FadeOut 300ms 0x00000000 100
			TextSetName ""
			TextMessage name[742] {
				寶箱內裝著{item[1506]}{color 0}。
				但因持有物品已滿而放棄{item[1506]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			SoundPlay sound[15] 0 100 0
			ED7ObjPlay object[6] 30 0 0 0
	else:
		FadeOut 300ms 0x00000000 100
		TextSetPos -1 -1 -1 -1
		TextSetName ""
		TextMessage name[742] {
			{0x06}{color 5}寶箱內空無一物。{color 0}{wait}
		}
		TextWait
		TextClose 0
		FadeIn 300ms 0x00000000
	Sleep 30ms
	TextEnd null
	SystemFlagsUnset 0x08000000
	Return

fn[6]:
	EventBegin 1
	SystemFlagsSet 0x08000000
	TextMessage null {
		{color 5}有一個巴士車站。
		要乘坐巴士嗎？{wait}
	}
	Menu menu[0] -1 -1 1
		"克洛斯貝爾市東出口" // 0
		"阿爾摩利卡村" // 1
		"巴士站（三叉路）" // 2
		"放棄" // 3
	MenuWait var[0]
	MenuClose menu[0]
	TextClose 0
	_59
	if var[0] == 0:
		Call fn[0,7]
		SystemFlagsUnset 0x08000000
		NewScene "scena/r0000.bin" 0 0 0
		Hcf
	elif var[0] == 1:
		Call fn[0,7]
		SystemFlagsUnset 0x08000000
		NewScene "scena/t0000.bin" 0 0 0
		Hcf
	elif var[0] == 2:
		Call fn[0,7]
		SystemFlagsUnset 0x08000000
		NewScene "scena/r0030.bin" 0 0 0
		Hcf
	SystemFlagsUnset 0x08000000
	EventEnd 5
	Return

fn[7]:
	CrossFade 1000ms
	CamSetDistance -27530 1000 24550 0ms
	ED7CamRotate 45deg 26deg 0deg 0ms
	CamPers 570 0ms
	CamZoom 24000 0ms
	ED7_E0 1
	CharSetPos field_party[0] (-32119, 0, 25500) 89deg
	CharSetPos field_party[1] (-32119, 0, 24000) 89deg
	CharSetPos field_party[2] (-32119, 0, 22500) 89deg
	CharSetPos field_party[3] (-32119, 0, 21000) 89deg
	CharFlagsUnset char[22] 0x0080
	ObjFlagsUnset object[5] 0x0004
	ED7_78 object[5] char[22]
	ED7_76_0 object[5] "light" 1
	NextFrame
	CharSetPos char[22] (-27000, 0, 4810) 0deg
	Sc_D1 char[22] 0 500 0 0ms
	ObjFlagsSet object[5] 0x1000
	ED7_74 object[5] 0 30
	FadeWait
	ED7ObjPlay object[5] 121 180 0 32
	Fork char[22] fork[1]:
		CharWalkToPos self (-27000, 0, 23850) 4000mm/s 0
	SoundPlay sound[466] 0 100 0
	SoundPlay sound[467] 0 100 0
	ForkWait char[22] fork[1]
	ED7ObjPlay object[5] 91 120 0 0
	ObjWait object[5]
	Sleep 1000ms
	FadeOut 1000ms 0x00000000 255
	FadeWait
	FlagSet flag[1008]
	Return

fn[8]:
	EventBegin 1
	FadeOut 0ms 0x00000000 255
	CamWait 1
	Sleep 1ms
	CharSetPos field_party[0] (-31260, 0, 26050) 89deg
	CharSetPos field_party[1] (-31260, 0, 26050) 89deg
	CharSetPos field_party[2] (-31260, 0, 26050) 89deg
	CharSetPos field_party[3] (-31260, 0, 26050) 89deg
	CamSetDistance -31260 1000 26050 0ms
	ED7CamRotate 45deg 21deg 0deg 0ms
	CamPers 510 0ms
	CamZoom 23500 0ms
	CamWait 1
	Sleep 1ms
	FadeIn 500ms 0x00000000
	FadeWait
	EventEnd 5
	Return

fn[9]:
	EventBegin 1
	SystemFlagsSet 0x08000000
	SoundPlay sound[1499] 255 100 0
	Sleep 500ms
	var[0] = 99
	while var[0] == 99:
		Menu menu[0] 32 26 1
			"使用警備隊車輛進行移動" // 0
			"在此處休息" // 1
			"放棄" // 2
		MenuWait var[0]
		if var[0] == 0:
			SoundPlay sound[1500] 255 100 0
			ED7MenuNew menu[1]
			if var[3] == 1:
				ED7MenuAdd menu[1] "★克洛斯貝爾市・中央廣場"
				ED7MenuSetDisabled menu[1] 0
			else:
				ED7MenuAdd menu[1] "　克洛斯貝爾市・中央廣場"
			if var[3] == 2:
				ED7MenuAdd menu[1] "★克洛斯貝爾市・東出口"
				ED7MenuSetDisabled menu[1] 1
