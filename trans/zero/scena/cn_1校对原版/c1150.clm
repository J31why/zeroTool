fn[44]:
	var[1] = 1
	while var[1] != 255:
		if flag[11] && flag[12] && flag[13] && flag[14]:
			Menu menu[1] -1 -1 0
				"【支援請求指的是？】" // 0
				"【在哪裡進行確認？】" // 1
				"【怎樣提交報告？】" // 2
				"【搜查官階級指的是？】" // 3
				"沒什麼特別想要問的" // 4
			MenuWait var[1]
		else:
			Menu menu[1] -1 -1 0
				"【支援請求指的是？】" // 0
				"【在哪裡進行確認？】" // 1
				"【怎樣提交報告？】" // 2
				"【搜查官階級指的是？】" // 3
			MenuWait var[1]
		MenuClose menu[1]
		if !QuestFlagsGet quest[1] 0x10:
			FadeIn 300ms 0x00000000
			FadeWait
		elif var[1] != 4:
			FadeIn 300ms 0x00000000
			FadeWait
		switch var[1]:
			case 0:
				TextTalk char[0] {
					#5P支援請求是指各處向特務支援課提出的
					各式各樣的『委託』。{wait}
				}
				TextWait
				TextTalk char[0] {
					#5P從簡單的幫助到正式的案件調查，
					以及消滅魔獸等，
					委託的內容多種多樣。{wait}
				}
				TextWait
				TextTalk char[0] {
					#5P除了少數幾種特殊情況外，
					要不要接受委託，
					各位都可以自行決定……{wait}
				}
				TextWait
				TextTalk char[0] {
					#5P但如果不在期限內完成的話，委託便會自動失效，
					關於這點，還請各位多加注意。{wait}
				}
				TextWait
				FlagSet flag[11]
				break
			case 1:
				TextTalk char[0] {
					#5P對於目前能夠接受的支援請求，
					各位可以使用特務支援課的終端
					進行確認。{wait}
				}
				TextWait
				TextTalk char[0] {
					#5P一經確認，支援請求
					便會記錄在搜查手冊上，
					這一點也請各位注意查看。{wait}
				}
				TextWait
				TextTalk char[0] {
					#5P支援請求的追加更新
					每天僅有一次。{wait}
				}
				TextWait
				TextTalk char[0] {
					#5P所以建議各位每天都去
					支援課的終端進行確認。{wait}
				}
				TextWait
				FlagSet flag[12]
				break
			case 2:
				TextTalk char[0] {
					#5P當『完成』支援請求後，
					請各位使用特務支援課的終端
					提交『報告』。{wait}
				}
				TextWait
				TextTalk char[0] {
					#5P透過導力網路，
					我們可即時對其進行評定。{wait}
				}
				TextWait
				TextTalk char[0] {
					#5P根據委託內容，我們有時還會
					發放特別獎勵，希望各位能
					注意經常提交報告。{wait}
				}
				TextWait
				FlagSet flag[13]
				break
			case 3:
				TextTalk char[0] {
					#5P各位可以借由解決普通的調查任務
					以及完成支援請求
					以提高成績。{wait}
				}
				TextWait
				TextTalk char[0] {
					#5P此成績會以『ＤＰ（調查點數）』來表示，
					根據各任務與支援請求期間各位的表現情況，
					有時還會追加獎勵點數。{wait}
				}
				TextWait
				TextTalk char[0] {
					#5P──在ＤＰ達到一定數值後，
					『搜查官階級』便會上升。{wait}
				}
				TextWait
				TextTalk char[0] {
					#5P此階級目前分為１５級，
					每次提高階級都會得到獎勵物品，
					所以十分值得爭取。{wait}
				}
				TextWait
				FlagSet flag[14]
				break
			case 4:
				var[1] = 255
				break
			default:
				break
		if var[1] != 255:
			FadeOut 300ms 0x00000000 100
			FadeWait
	var[1] = 0
	Return

