			TextSetName ""
			TextMessage null {
				{color 5}有一台導力式自動販賣機。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			_59
			TextTalk name[0] {
				#0005F這個……我記得好像投入硬幣
				就能買到飲料吧。{wait}
			}
			TextWait
			if PartyPosition name[2] > -1:
				TextTalk name[2] {
					#0200F嗯，這是由愛普斯泰恩財團開發的
					自動販賣機。{wait}
				} {
					在克洛斯貝爾
					也投入了實驗性使用。{wait}
				}
				TextWait
			elif PartyPosition name[1] > -1:
				TextTalk name[1] {
					#0100F這個好像是由愛普斯泰恩財團開發的
					自動販賣機……{wait}
				} {
					據緹歐說，
					是財團在克洛斯貝爾
					將其投入實驗性使用的。{wait}
				}
				TextWait
			elif PartyPosition name[3] > -1:
				TextTalk name[3] {
					#0300F這個好像是由愛普斯泰恩財團開發的
					自動販賣機……應該沒記錯吧。{wait}
				} {
					聽小緹說，
					這東西是財團在克洛斯貝爾
					為了試驗而設置的。{wait}
				}
				TextWait
			TextTalk name[0] {
				#0000F真不愧是克洛斯貝爾……
				果然有很多稀奇的東西。{wait}
			}
			TextWait
		FlagSet flag[1195]
	else:
		FadeOut 300ms 0x00000000 100
		FadeWait
		ShopOpen shop[250]
		FadeIn 300ms 0x00000000
		FadeWait
	TextEnd null
	Return
