fn[0]:
	var[3] = random % 8
	switch var[3]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharIdle self (-31480, null, 9420) (-27710, null, 10380) 1000mm/s
		Sleep 300ms
	Return

fn[2]:
	while 1:
		CharWalkToPos char[10] (-57300, 0, 20000) 2000mm/s 0
		Sleep 500ms
		CharTurnTo char[10] 180deg 750deg/s
		Sleep 500ms
		CharWalkToPos char[10] (-57300, 0, 16000) 2000mm/s 0
		Sleep 500ms
		CharTurnTo char[10] 0deg 750deg/s
		Sleep 500ms
	Return

fn[3]:
	if flag[1792]:
		CharFlagsSet char[2] 0x0080
		CharFlagsSet char[3] 0x0080
		CharSetPos char[5] (-125380, 0, 19520) 0deg
		CharFlagsSet char[6] 0x0080
	elif flag[1566]:
		if !flag[1569]:
			CharTurnTo char[0] 90deg 0deg/s
			CharSetPos char[1] (1970, 0, 15610) 270deg
		CharFlagsSet char[2] 0x0080
		CharFlagsSet char[3] 0x0080
		CharSetPos char[6] (-57640, 0, 18750) 270deg
		CharSetPos char[5] (-57640, 0, 17260) 270deg
		CharFlagsUnset char[11] 0x0080
		CharFlagsUnset char[12] 0x0080
		CharFlagsUnset char[13] 0x0080
	elif flag[1554]:
		CharTurnTo char[0] 90deg 0deg/s
		CharSetPos char[1] (1970, 0, 15610) 270deg
		CharFlagsSet char[2] 0x0080
		CharFlagsSet char[3] 0x0080
		CharSetPos char[5] (-58050, 0, 15900) 90deg
		CharFlagsSet char[6] 0x0080
	elif flag[1536]:
		CharSetPos char[2] (-11040, 0, 13810) 90deg
		CharSetPos char[3] (-125380, 0, 19520) 0deg
		CharSetPos char[5] (-58050, 0, 15900) 90deg
		CharFlagsSet char[6] 0x0080
	elif flag[1342]:
		CharFlagsSet char[1] 0x0080
		CharSetPos char[2] (-12850, 0, 7690) 90deg
		CharSetPos char[3] (-11260, 0, 7690) 270deg
		CharFlagsSet char[5] 0x0080
		CharFlagsSet char[6] 0x0080
		CharFlagsUnset char[8] 0x0080
	elif flag[1055]:
		CharFlagsSet char[2] 0x0080
		CharFlagsSet char[3] 0x0080
		CharSetPos char[5] (-123350, 0, 19180) 0deg
		CharFlagsSet char[6] 0x0080
		if !QuestFlagsGet quest[21] 0x10:
			CharSetPos char[10] (-57300, 0, 18000) 0deg
			ForkFunc char[10] fork[0] fn[0,2]
			CharFlagsUnset char[10] 0x0040
			CharFlagsUnset char[10] 0x0080
	elif flag[1040]:
		CharFlagsSet char[2] 0x0080
		CharSetPos char[3] (-125380, 0, 19520) 0deg
		CharSetPos char[5] (-29870, 0, 9900) 90deg
		ForkFunc char[5] fork[0] fn[0,1]
		CharSetPos char[6] (-11040, 0, 13810) 90deg
		if !QuestFlagsGet quest[21] 0x10:
			CharSetPos char[10] (-57300, 0, 18000) 0deg
			ForkFunc char[10] fork[0] fn[0,2]
			CharFlagsUnset char[10] 0x0040
			CharFlagsUnset char[10] 0x0080
			CharFlagsSet char[10] 0x0010
	elif flag[1031]:
		CharFlagsSet char[2] 0x0080
		CharFlagsSet char[3] 0x0080
		CharSetPos char[5] (-57630, 0, 17300) 135deg
		CharFlagsUnset char[9] 0x0080
		ForkFunc char[9] fork[0] fn[0,0]
	elif flag[1024]:
		CharSetPos char[2] (-125380, 0, 19520) 0deg
		CharSetPos char[3] (-123490, 0, 18220) 180deg
		CharSetPos char[5] (-58050, 0, 15900) 90deg
		CharFlagsSet char[6] 0x0080
	elif flag[801]:
		CharSetPos char[2] (-11040, 0, 13810) 90deg
		CharSetPos char[3] (-12290, 0, 12530) 45deg
		CharSetPos char[5] (-125380, 0, 19520) 0deg
		CharFlagsSet char[6] 0x0080
	elif flag[777]:
		CharSetPos char[2] (-121660, 0, 18190) 90deg
		CharSetPos char[3] (-125380, 0, 19520) 0deg
		CharSetPos char[5] (-58050, 0, 15900) 180deg
		CharFlagsSet char[6] 0x0080
		CharFlagsUnset char[7] 0x0080
		CharSetPos char[7] (-58050, 30, 14700) 0deg
	elif flag[768]:
		CharSetPos char[2] (-125380, 0, 19520) 0deg
		CharSetPos char[3] (-11040, 0, 13810) 90deg
		CharSetPos char[6] (-57420, 0, 18000) 270deg
		CharSetPos char[7] (-57270, 0, 16580) 270deg
		CharSetPos char[5] (-59320, 30, 21250) 180deg
		CharFlagsUnset char[4] 0x0080
		CharFlagsUnset char[7] 0x0080
	elif flag[533]:
		CharSetPos char[2] (-125380, 0, 19520) 0deg
		CharSetPos char[3] (-11040, 0, 13810) 90deg
		CharFlagsSet char[5] 0x0080
		CharFlagsSet char[6] 0x0080
		CharFlagsUnset char[7] 0x0080
		CharSetPos char[7] (-56940, 0, 19650) 90deg
	elif flag[526]:
		CharSetPos char[2] (-126060, 0, 19340) 90deg
		CharSetPos char[3] (-124880, 0, 19200) 270deg
		CharFlagsUnset char[7] 0x0080
		CharFlagsUnset char[5] 0x0080
		CharSetPos char[7] (-57420, 0, 16239) 90deg
		CharSetPos char[5] (-57020, 0, 17260) 135deg
		CharFlagsSet char[6] 0x0080
		if QuestFlagsGet quest[1] 0x10 && !QuestFlagsGet quest[1] 0x20:
			CharSetPos char[1] (900, 0, 15400) 180deg
		elif !QuestFlagsGet quest[1] 0x10:
			CharFlagsSet char[1] 0x0010
			CharFlagsSet char[0] 0x0010
	else:
		CharSetPos char[1] (-100, 0, 15400) 180deg
		CharFlagsSet char[0] 0x0080
		CharFlagsSet char[2] 0x0080
		CharFlagsSet char[3] 0x0080
		CharFlagsSet char[4] 0x0080
		CharFlagsSet char[5] 0x0080
		CharFlagsSet char[6] 0x0080
		CharFlagsSet char[7] 0x0080
		CharFlagsSet char[8] 0x0080
		CharFlagsSet char[11] 0x0080
		CharFlagsSet char[12] 0x0080
		CharFlagsSet char[13] 0x0080
	if flag[736]:
		FlagUnset flag[736]
		Event fn[0,33]
	elif flag[737]:
		FlagUnset flag[737]
		Event fn[0,40]
	elif flag[738]:
		FlagUnset flag[738]
		Event fn[0,31]
	Return

fn[4]:
	if flag[514]:
		system[1] = 111
	LookPointFlagsSet look_point[2] 0x0001
	LookPointFlagsSet look_point[3] 0x0001
	if flag[1792]:
	elif flag[1566]:
		if !flag[1569]:
			LookPointFlagsSet look_point[1] 0x0001
			LookPointFlagsUnset look_point[2] 0x0001
	elif flag[1554]:
		LookPointFlagsSet look_point[1] 0x0001
		LookPointFlagsUnset look_point[2] 0x0001
	elif flag[1536]:
	elif flag[1342]:
		LookPointFlagsSet look_point[1] 0x0001
	if flag[526]:
		if QuestFlagsGet quest[1] 0x10 && !QuestFlagsGet quest[1] 0x20:
			LookPointFlagsSet look_point[1] 0x0001
			LookPointFlagsSet look_point[2] 0x0001
			LookPointFlagsUnset look_point[3] 0x0001
	else:
		LookPointFlagsSet look_point[1] 0x0001
		LookPointFlagsSet look_point[2] 0x0001
	if flag[1342] && !flag[1536]:
		ED7_76_0 object[255] "tanmatu_add" 1
	ObjFlagsSet object[3] 0x0004
	ObjFlagsSet object[4] 0x0004
	ObjFlagsSet object[5] 0x0004
	ObjFlagsSet object[6] 0x0004
	ObjFlagsSet object[7] 0x0004
	ObjFlagsSet object[8] 0x0004
	if flag[1037] && !flag[1038]:
		MapColor 0x00C8D2FF 0ms
	elif flag[1792]:
		MapColor 0x00C8D2FF 0ms
	else:
	EntranceSetFunc entrance[0] fn[255,65535]
	TriggerFlagsSet trigger[0] 0x0080
	if flag[513] && !flag[525]:
		EntranceSetFunc entrance[0] fn[0,46]
		TriggerFlagsUnset trigger[0] 0x0080
	TriggerFlagsUnset trigger[1] 0x0080
	ObjFlagsUnset object[2] 0x0010
	Return

fn[5]:
	if flag[526]:
		Call fn[0,6]
	else:
		Call fn[0,9]
	Return

fn[6]:
	if flag[526] && !flag[533] && !QuestFlagsGet quest[1] 0x10:
		Call fn[0,43]
		Return
	TextStart char[0]
	if !QuestFlagsGet quest[53] 0x10 && !flag[600]:
		if QuestFlagsGet quest[1] 0x20:
			TextTalk char[0] {
				呵呵，辛苦了。{wait}
			}
			TextWait
			TextTalk char[0] {
				追加的支援請求
				重新確認過了嗎？{wait}
			}
			TextWait
			TextTalk name[1] {
				#0100F嗯，確認過了，沒問題。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F我們打算立刻前去
				解決通緝魔獸。{wait}
			}
			TextWait
			TextTalk char[0] {
				這樣啊……{wait}
			}
			TextWait
			TextTalk char[0] {
				通緝魔獸應該在地下區域Ａ區塊，
				靠近終點的那一帶。{wait}
			}
			TextWait
			TextTalk char[0] {
				除此之外，也經常有
				其它魔獸出沒，
				因此請多加小心。{wait}
			}
			TextWait
			FlagSet flag[641]
		else:
			TextTalk char[0] {
				這樣一來，
				【支援請求的補充說明】任務
				就完成了。{wait}
			}
			TextWait
			TextTalk char[0] {
				請各位先回支援課一趟，
				試著利用終端提交一下報告。{wait}
			}
			TextWait
		TextTalk char[0] {
			還有……關於支援請求的流程
			今天隨時都可以為大家說明。{wait}
		}
		TextWait
		TextTalk char[0] {
			如果各位還有其它想要確認的事，
			請不要客氣，儘管提出來。{wait}
		}
		TextWait
		FlagSet flag[600]
	elif QuestFlagsGet quest[53] 0x10 && !flag[642]:
		if system[4] == 0:
			TextTalk char[0] {
				關於通緝魔獸的討伐，
				辛苦大家了。{wait}
			}
			TextWait
		TextTalk char[0] {
			對了，各位知道嗎？
			克洛斯貝爾警察正在進行
			魔獸的情報調查。{wait}
		}
		TextWait
		TextTalk name[0] {
			#0005F情報調查……嗎？{wait}
		}
		TextWait
		TextTalk char[0] {
			嗯，我想各位應該知道
			在戰鬥手冊裡記錄著
			有關魔獸的項目吧。{wait}
		}
		TextWait
		TextTalk char[0] {
			各位曾經遭遇過的魔獸
			都會被記錄在戰鬥手冊裡哦。{wait}
		}
		TextWait
		TextTalk char[0] {
			當情報累積到一定程度時，
			就請拿來給我看一下。{wait}
		}
		TextWait
		TextTalk char[0] {
			因為各位所收集的情報對
			警局內制定安全對策
			很有幫助。{wait}
		}
		TextWait
		if PartyPosition name[1] > -1:
			TextTalk name[1] {
				#0100F原來如此……警察局也
				很下功夫啊。{wait}
			}
			TextWait
		elif PartyPosition name[2] > -1:
			TextTalk name[2] {
				#0200F原來如此……警察局也
				很下功夫啊。{wait}
			}
			TextWait
		elif PartyPosition name[3] > -1:
			TextTalk name[3] {
				#0300F原來如此……警察局也
				很下功夫啊。{wait}
			}
			TextWait
		TextTalk char[0] {
			嗯，這也是為了保衛
			市民的安全。{wait}
		}
		TextWait
		TextTalk char[0] {
			各位在向我提交魔獸情報時，
			局內會多少支付一些報酬的，
			所以請不要客氣，隨時過來。{wait}
		}
		TextWait
		FlagSet flag[642]
		FlagSet flag[16]
	if !flag[642]:
		var[0] = 99
		while var[0] == 99:
			FadeOut 300ms 0x00000000 100
			Menu menu[0] -1 -1 1
				"對話" // 0
				"詢問關於支援請求的事" // 1
