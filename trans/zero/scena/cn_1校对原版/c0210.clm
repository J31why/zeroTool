fn[29]:
	EventBegin 0
	FadeOut 1000ms 0x00000000 255
	FadeWait
	CamSetDistance 53470 1500 1600 0ms
	ED7CamRotate 36deg 20deg 0deg 0ms
	CamPers 420 0ms
	CamZoom 20740 0ms
