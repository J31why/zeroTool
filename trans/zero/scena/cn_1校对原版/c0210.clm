	CharFlagsSet char[3] 0x0080
	CharFlags2Set char[3] 0x8000
	FadeIn 1000ms 0x00000000
	FadeWait
	TextTalk char[0] {
		#11P喲，羅伊德，
		今天也來了啊。{wait}
	}
	TextWait
	TextTalk char[0] {
		#11P哇哈哈，要不要吃點麵包啊？{wait}
	}
	TextWait
	TextTalk name[0] {
		#5P#0006F這種時候，該說的並不是什麼
		『要不要吃點麵包』吧……？{wait}
	} {
		#0000F奧斯卡，你不是向支援課
		提出委託了嗎？{wait}
	}
	TextWait
	TextTalk char[0] {
		#11P哎，有這種事嗎？{wait}
	}
	TextWait
	Emote field_party[0] 0mm 2000mm 16 19 250ms 1
	SoundPlay sound[23] 0 100 0
	Emote field_party[1] 0mm 2000mm 16 19 250ms 1
	SoundPlay sound[23] 0 100 0
	Emote field_party[2] 0mm 2000mm 16 19 250ms 1
	SoundPlay sound[23] 0 100 0
	Emote field_party[3] 0mm 2000mm 16 19 250ms 1
	SoundPlay sound[23] 0 100 0
	Sleep 1200ms
	TextTalk name[2] {
		#6P#0200F支援課這裡的確
		是收到了委託……{wait}
	}
	TextWait
	TextTalk name[0] {
		#5P#0003F拜託，奧斯卡……
		我們是為工作而來的。{wait}
	}
	TextWait
	TextTalk char[0] {
		#11P哦，對了，我想起來啦。{wait}
	}
	TextWait
	TextTalk char[0] {
		#11P我就是想讓你們幫我
		收集用於製作新品麵包的食材。{wait}
	}
	TextWait
	TextTalk char[0] {
		#11P其實，我拜託的商家
		好像因故而延遲送貨了。
		所以材料似乎有些不足。{wait}
	}
	TextWait
	TextTalk name[3] {
		#6P#0300F原來如此，所以你才
		希望我們幫忙收集食材啊。{wait}
	}
	TextWait
	TextTalk name[1] {
		#6P#0100F的確，沒有食材的話，
		就做不成麵包了呢。{wait}
	}
	TextWait
	TextTalk char[0] {
		#11P就是這樣，
		你們願意接受嗎？{wait}
	}
	TextWait
	TextTalk name[0] {
		#5P#0000F嗯，只是收集食材的話，
		就交給我們吧。{wait}
	} {
		那麼……具體需要
		什麼食材呢？{wait}
	}
	TextWait
	TextTalk char[0] {
		#11P這個嘛，小麥粉和奶油
		倒是沒問題……{wait}
	}
	TextWait
	TextTalk char[0] {
		#11P我希望你們收集的是
		四個『魔獸魚肉』
		和三個『魔獸之蛋』。{wait}
	}
	TextWait
	TextTalk name[3] {
		#6P#0304F嗯，這兩種東西的話，
		只要出了城，都能輕鬆弄到呢。{wait}
	}
	TextWait
	TextTalk name[0] {
		#5P#0000F明白了，我們處理其它任務時
		順便收集一下吧。{wait}
	}
	TextWait
	FadeOut 300ms 0x00000000 100
	SoundPlay sound[80] 0 100 0
	TextSetPos -1 -1 -1 -1
	TextSetName ""
	TextMessage null {
		{color 2}任務【收集食材的委託】{color 0}開始！{wait}
	}
	TextWait
	TextClose 0
