fn[3]:
	char[12].45 = 1050
	char[12].46 = 1050
	char[12].47 = 1050
	if system[4] == 3:
		EntranceSetDisabled entrance[0] 0
		EntranceSetDisabled entrance[2] 1
		EntranceSetDisabled entrance[1] 0
		EntranceSetDisabled entrance[3] 1
	else:
		EntranceSetDisabled entrance[0] 1
		EntranceSetDisabled entrance[2] 0
		EntranceSetDisabled entrance[1] 1
		EntranceSetDisabled entrance[3] 0
	if flag[1037] && !flag[1038]:
		MapColor 0x00C8D2FF 0ms
	elif flag[1792]:
		MapColor 0x00C8D2FF 0ms
	else:
	Return

fn[4]:
	if flag[1566] | !flag[1554]:
		Call fn[0,5]
	else:
		Call fn[0,8]
	Return

fn[5]:
	if QuestFlagsGet quest[6] 0x02 && !QuestTaskGet quest[6] 0 && !QuestFlagsGet quest[6] 0x40:
		_Char4A char[0] 255
		CharTurnToChar field_party[0] char[0] 0deg/s
		Call fn[0,29]
		Return
	TextStart char[0]
	if QuestTaskGet quest[6] 0 && !QuestFlagsGet quest[6] 0x10 && ItemHas item[301] 0 >= 4 && ItemHas item[303] 0 >= 3 && !QuestFlagsGet quest[6] 0x40:
		TextTalk char[0] {
			羅伊德，收集食材的事情
			怎麼樣了？{wait}
		}
		TextWait
		var[0] = 0
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 0
			"【交出收集的食材】" // 0
			"【放棄】" // 1
		MenuWait var[0]
		FadeIn 300ms 0x00000000
		MenuClose menu[0]
		_59
		switch var[0]:
			case 0:
				Call fn[0,30]
				TextEnd char[0]
				Return
			case 1:
				TextTalk char[0] {
					那就下次吧，
					等你辦妥之後再來找我。
					拜託你們啦！{wait}
				}
				TextWait
				break
	if flag[1566] | !flag[1554]:
		if QuestTaskGet quest[6] 0 && !QuestFlagsGet quest[6] 0x10 && !QuestFlagsGet quest[6] 0x40:
			var[0] = 99
			while var[0] == 99:
				FadeOut 300ms 0x00000000 100
				Menu menu[0] -1 -1 1
					"對話" // 0
					"購物" // 1
					"詢問委託的事情" // 2
					"放棄" // 3
				MenuWait var[0]
				if var[0] != 1:
					MenuClose menu[0]
					FadeIn 300ms 0x00000000
					FadeWait
				if var[0] == 1:
					if flag[1792]:
						ShopOpen shop[206]
					elif flag[1536]:
						ShopOpen shop[205]
					elif flag[1342]:
						ShopOpen shop[204]
					elif flag[1280]:
						ShopOpen shop[203]
					elif flag[1024]:
						ShopOpen shop[202]
					elif flag[768]:
						ShopOpen shop[201]
					else:
						ShopOpen shop[200]
					var[0] = 99
				elif var[0] == 2:
					TextTalk char[0] {
						我希望你們收集的是
						四個『魔獸魚肉』
						和三個『魔獸之蛋』。{wait}
					}
					TextWait
					TextTalk char[0] {
						食材好像不太夠啊，
						忙其它事情的時候順便
						幫我收集一下就可以啦。{wait}
					}
					TextWait
					if !flag[911]:
						TextTalk name[3] {
							#0304F『魔獸魚肉』一般可以在
							魚形魔獸的身上得到。{wait}
						} {
							而『魔獸之蛋』則會從
							鳥形或蛇形的魔獸身上掉落。{wait}
						}
						TextWait
						TextTalk name[0] {
							#0000F哦，蘭迪果然對這些
							很熟悉啊。
							真不愧是原警備隊員。{wait}
						}
						TextWait
						TextTalk name[3] {
							#0300F哈哈，戰鬥之類的事情，
							我早就習慣啦。{wait}
						}
						TextWait
						TextTalk name[1] {
							#0100F魔獸所掉落的食材，
							也能用於製作料理哦。{wait}
						} {
							趁這個機會記住，
							以後探索時也會輕鬆許多。{wait}
						}
						TextWait
						FlagSet flag[911]
					elif !(ItemHas item[301] 0 >= 4 && ItemHas item[303] 0 >= 3):
						TextTalk name[3] {
							#0300F『魔獸魚肉』是魚形魔獸掉落的，
							『魔獸之蛋』可以從鳥形或蛇形的魔獸
							身上得到。{wait}
						}
						TextWait
						TextTalk name[0] {
							#0000F總之，只要在郊外多繞繞，
							就能收集到這些東西。{wait}
						} {
							#0004F好，那我們這就
							開始收集吧。{wait}
						}
						TextWait
						TextTalk char[0] {
							哇哈哈，那就拜託你們啦！{wait}
						}
						TextWait
					var[0] = 99
				elif var[0] != 0:
				elif var[0] == 0:
					var[0] = 99
					Call fn[0,6]
		else:
			var[0] = 99
			while var[0] == 99:
				FadeOut 300ms 0x00000000 100
				Menu menu[0] -1 -1 1
					"對話" // 0
					"購物" // 1
					"放棄" // 2
				MenuWait var[0]
				if var[0] != 1:
					MenuClose menu[0]
					FadeIn 300ms 0x00000000
					FadeWait
				if var[0] == 1:
					if flag[1792]:
						ShopOpen shop[206]
					elif flag[1536]:
						ShopOpen shop[205]
					elif flag[1342]:
						ShopOpen shop[204]
					elif flag[1280]:
						ShopOpen shop[203]
					elif flag[1024]:
						ShopOpen shop[202]
					elif flag[768]:
						ShopOpen shop[201]
					else:
						ShopOpen shop[200]
					var[0] = 99
				elif var[0] != 0:
				elif var[0] == 0:
					var[0] = 99
					Call fn[0,6]
	else:
		Call fn[0,6]
	TextEnd char[0]
	Return

fn[6]:
	if flag[13]:
		TextTalk char[0] {
			今天真是得救了。
			你們就順便嘗嘗
			我烤的麵包吧。{wait}
		}
		TextWait
		TextTalk char[0] {
			呵呵，免費贈送哦。{wait}
		}
		TextWait
		TextTalk name[0] {
			#0000F謝啦，那就讓我選一點吧。{wait}
		}
		TextWait
	elif flag[1792]:
		if !flag[1898]:
			TextTalk char[0] {
				喲，羅伊德，
				你還在調查什麼案子嗎？{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F嗯，差不多吧。{wait}
			} {
				#0001F……奧斯卡，為求謹慎，
				我想問你這附近
				有沒有發生什麼奇怪的事？{wait}
			} {
				比如看見一些黑衣人什麼的……{wait}
			}
			TextWait
			TextTalk char[0] {
				奇怪的事啊……嗯～{wait}
			}
			TextWait
			TextTalk char[0] {
				其實，貝奈特剛才
				突然很生氣，
				然後就跑出去了。{wait}
			}
			TextWait
			TextTalk char[0] {
				到底發生了什麼事呢？{wait}
			}
			TextWait
			if !flag[1897]:
				Emote field_party[0] 0mm 2000mm 16 19 250ms 1
				SoundPlay sound[23] 0 100 0
				Emote field_party[1] 0mm 2000mm 16 19 250ms 1
				SoundPlay sound[23] 0 100 0
				Emote field_party[2] 0mm 2000mm 16 19 250ms 1
				SoundPlay sound[23] 0 100 0
				Emote field_party[3] 0mm 2000mm 16 19 250ms 1
				SoundPlay sound[23] 0 100 0
				Sleep 1000ms
				TextTalk name[0] {
					#0006F你啊，真是的，
					對這方面太遲鈍了吧。{wait}
				}
				TextWait
				TextTalk name[1] {
					#0100F西側大道附近好像
					沒什麼事件發生吧。{wait}
				}
				TextWait
			else:
				Emote name[0] 0mm 2000mm 16 19 250ms 1
				SoundPlay sound[23] 0 100 0
				Sleep 1000ms
				TextTalk name[0] {
					#0000F不、不太清楚呢……{wait}
				} {
					但說不定是奧斯卡的錯吧？
					你有時的確很遲鈍……{wait}
				}
				TextWait
				TextTalk char[0] {
					哎，是嗎？{wait}
				}
				TextWait
				TextTalk name[1] {
					#0100F（嗯，西側大道一帶好像
					　沒發生什麼特別的事件。）{wait}
				}
				TextWait
			FlagSet flag[1898]
		else:
			TextTalk char[0] {
				貝奈特今天
				烤了很美味的麵包
				給我吃呢。{wait}
			}
			TextWait
			TextTalk char[0] {
				然後，我坦率地說出了想法後，
				她就突然生氣地跑出去了。{wait}
			}
			TextWait
			TextTalk char[0] {
				唔，到底是怎麼了啊？{wait}
			}
			TextWait
	elif flag[1566]:
		if !flag[0]:
			TextTalk char[0] {
				昨天，在港灣區那邊
				好像發生了槍擊事件吧？{wait}
			}
			TextWait
			TextTalk char[0] {
				黑手黨如果認真起來，
				就會毫無顧忌地展開爭鬥，
				將市民都牽連進去……{wait}
			}
			TextWait
			TextTalk char[0] {
				真是群棘手的傢伙啊。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				難得店裡的營業額
				剛剛有起色呢。{wait}
			}
			TextWait
			TextTalk char[0] {
				希望不要碰到麻煩事。{wait}
			}
			TextWait
	elif flag[1554]:
		if !flag[0]:
			CharTurnTo char[0] 90deg 0deg/s
			TextTalk char[0] {
				那個，毛毯在哪裡啊……？{wait}
			}
			TextWait
			CharTurnToChar char[0] field_party[0] 500deg/s
			TextTalk char[0] {
				貝奈特為了研究新麵包的烤製方法，
				幾乎都沒有睡過覺。{wait}
			}
			TextWait
			TextTalk char[0] {
				哈哈，還真是費事啊，
				就像小時候那個一直
				被賽西兒小姐照顧的羅伊德一樣。{wait}
