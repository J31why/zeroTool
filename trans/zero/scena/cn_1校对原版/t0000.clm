fn[41]:
	EventBegin 0
	FadeOut 0ms 0xFFFFFFFF 0
	FadeOut 500ms 0x00000000 255
	FadeWait
	FadeIn 0ms 0xFFFFFFFF
	CamSetDistance -18160 4700 64330 0ms
	ED7CamRotate 339deg 10deg 0deg 0ms
	CamPers 600 0ms
	CamZoom 18530 0ms
	ED7LoadChip "apl/ch50387.itc" chip[30]
	EffLoad eff[0] "event\\eva02_00.eff"
	CharSetPos name[0] (-17500, 3500, 60470) 330deg
	CharSetPos name[1] (-19270, 3500, 61620) 15deg
	CharSetPos name[2] (-15110, 3500, 62020) 330deg
	CharSetPos name[3] (-15900, 3500, 59800) 330deg
	FadeIn 500ms 0x00000000
	FadeWait
	TextTalk name[0] {
		#6P#0000F是阿爾摩利卡村的花田，
		還放置了養蜂箱呢。{wait}
	}
	TextWait
	TextTalk name[2] {
		#12P#0200F克洛斯貝爾唯一的農村……{wait}
	} {
		我覺得在觀光指南上介紹
		一下這樣的風景應該不錯。{wait}
	}
	TextWait
	TextTalk name[3] {
		#12P#0300F哦～這風景的確不錯啊。{wait}
	}
	TextWait
	TextTalk name[1] {
		#6P#0100F因為空氣清新，
		所以可以看得很遠呢。{wait}
	} {
		在克洛斯貝爾自治州內，
		說不定只有在這裡才能
		看到如此美麗的遠景吧。{wait}
	} {
		要是沒有人在幹農活的話，
		畫面應該會更加適合欣賞吧……
		但似乎不會有那麼巧呢。{wait}
	}
	TextWait
	TextTalk name[0] {
		#6P#0000F不過……
		格蕾絲小姐委託我們拍攝的照片，
		在這裡似乎能拍到很不錯的呢。{wait}
	}
	TextWait
	if !QuestTaskGet quest[24] 2 && !QuestTaskGet quest[24] 3 && !QuestTaskGet quest[24] 4 && !QuestTaskGet quest[24] 5 && !QuestTaskGet quest[24] 6 && !QuestTaskGet quest[24] 7 && !QuestTaskGet quest[24] 8 && !QuestTaskGet quest[24] 9 && !QuestTaskGet quest[24] 10:
		CharTurnToChar name[0] name[1] 500deg/s
		TextTalk name[0] {
			#6P#0000F那麼艾莉，
			可以拜託你來拍照嗎？{wait}
		}
		TextWait
		CharTurnToChar name[1] name[0] 500deg/s
		TextTalk name[1] {
			#6P#0108F哎，好的。
			雖然我沒什麼自信……{wait}
		}
		TextWait
		TextTalk name[3] {
			#12P#0300F哪裡哪裡，應該沒問題吧。{wait}
		} {
			只要看看鏡頭，
			然後哢嚓一下拍下來
			不就搞定了嘛。{wait}
		}
		TextWait
		CharTurnToChar name[1] name[3] 500deg/s
		TextTalk name[1] {
			#6P#0103F我說你啊……
			要拍出好照片，
			可沒有那麼簡單哦。{wait}
		} {
			#0100F要注意確認
			拍攝對象有沒有被收入取景框中，
			還要構思攝影角度……{wait}
		} {
			而且受到天氣和風的影響，
			照片所呈現出的感覺也會有很大不同。{wait}
		} {
			有時只要錯過那一瞬的時機，
			就再也拍不到
			那麼好的風景了。{wait}
		}
		TextWait
		TextTalk name[2] {
			#12P#0203F外行和專家所拍出的照片，
			差別可是一目了然的。{wait}
		} {
			#0200F不過，某些粗神經的人
			大概無法理解這種細緻的工作吧。{wait}
		}
		TextWait
		CharTurnToChar name[3] name[2] 500deg/s
		TextTalk name[3] {
			#12P#0306F唔……
			你在說誰啊，說誰啊。{wait}
		}
		TextWait
		TextTalk name[0] {
			#6P#0000F好啦好啦，
			總之就交給艾莉吧。{wait}
		}
		TextWait
		TextTalk name[1] {
			#6P#0100F那麼……
			我來試試看吧。{wait}
		}
		TextWait
		_59
		CharTurnTo name[1] 15deg 500deg/s
		CharTurnTo name[0] 330deg 500deg/s
		CharTurnTo name[2] 330deg 500deg/s
		CharTurnTo name[3] 330deg 500deg/s
		CrossFade 1000ms
		CharSetChipBase name[1] chip[30]
		CharSetChipPattern name[1] 0
		FadeWait
		SoundPlay sound[817] 0 100 0
		EffPlay eff[0] eff_instance[255] name[1] 192 (0, 1200, 400) 0 0 0 1000 1000 1000 null (0, 0, 0) 0ms
		Sleep 1000ms
		SoundPlay sound[817] 0 100 0
		EffPlay eff[0] eff_instance[255] name[1] 192 (0, 1200, 400) 0 0 0 1000 1000 1000 null (0, 0, 0) 0ms
		Sleep 1000ms
		SoundPlay sound[817] 0 100 0
		EffPlay eff[0] eff_instance[255] name[1] 192 (0, 1200, 400) 0 0 0 1000 1000 1000 null (0, 0, 0) 0ms
		Sleep 1000ms
		TextTalk name[1] {
			#6P#0103F……呼，
			為了保險起見，我多拍了幾張。{wait}
		}
		TextWait
		TextTalk name[0] {
			#6P#0000F看樣子，似乎已經拍好了呢。{wait}
		} {
			感覺怎麼樣啊？{wait}
		}
		TextWait
		TextTalk name[1] {
			#6P#0100F在沒有實際顯像出來之前，
			還無法確定……{wait}
		} {
			不過，我覺得至少
			不會很差吧。{wait}
		}
		TextWait
		TextTalk name[2] {
			#12P#0200F艾莉前輩似乎
			找回感覺了呢。{wait}
		}
		TextWait
		TextTalk name[3] {
			#12P#0300F哼……
			反正只有我完全搞不懂。{wait}
		}
		TextWait
		TextTalk name[0] {
			#6P#0000F如果發現了這種風景漂亮的地方，
			就再拍些照片吧。{wait}
		} {
			那麼，我們走吧。{wait}
		}
		TextWait
	else:
		CharTurnToChar name[0] name[1] 500deg/s
		TextTalk name[0] {
			#6P#0000F那麼……
			艾莉，麻煩你拍照了哦。{wait}
		}
		TextWait
		TextTalk name[1] {
			#6P#0100F嗯，知道了。{wait}
		}
		TextWait
		_59
		CharTurnTo name[1] 15deg 500deg/s
		CharTurnTo name[0] 330deg 500deg/s
		CharTurnTo name[2] 330deg 500deg/s
		CharTurnTo name[3] 330deg 500deg/s
		CrossFade 1000ms
		CharSetChipBase name[1] chip[30]
		CharSetChipPattern name[1] 0
		FadeWait
		SoundPlay sound[817] 0 100 0
		EffPlay eff[0] eff_instance[255] name[1] 192 (0, 1200, 400) 0 0 0 1000 1000 1000 null (0, 0, 0) 0ms
		Sleep 1000ms
		SoundPlay sound[817] 0 100 0
		EffPlay eff[0] eff_instance[255] name[1] 192 (0, 1200, 400) 0 0 0 1000 1000 1000 null (0, 0, 0) 0ms
		Sleep 1000ms
		SoundPlay sound[817] 0 100 0
		EffPlay eff[0] eff_instance[255] name[1] 192 (0, 1200, 400) 0 0 0 1000 1000 1000 null (0, 0, 0) 0ms
		Sleep 1000ms
		TextTalk name[1] {
			#6P#0103F……呼，
			大概就這樣吧。{wait}
		}
		TextWait
		var[4] = 0
		if QuestTaskGet quest[24] 2:
			var[4] += 1
		if QuestTaskGet quest[24] 3:
			var[4] += 1
		if QuestTaskGet quest[24] 4:
			var[4] += 1
		if QuestTaskGet quest[24] 5:
			var[4] += 1
		if QuestTaskGet quest[24] 6:
			var[4] += 1
		if QuestTaskGet quest[24] 7:
			var[4] += 1
		if QuestTaskGet quest[24] 8:
			var[4] += 1
		if QuestTaskGet quest[24] 9:
			var[4] += 1
		if QuestTaskGet quest[24] 10:
			var[4] += 1
		if var[4] == 4:
			TextTalk name[0] {
				#6P#0000F辛苦了，
				看來已經順利拍好了啊。{wait}
			} {
				這樣一來，就拍完了格蕾絲小姐
				所要求的五張照片了。
				現在隨時都可以去交付了啊。{wait}
			}
			TextWait
		else:
			TextTalk name[0] {
				#6P#0000F辛苦了，
				看來已經順利拍好了啊。{wait}
			} {
				那麼，我們走吧。{wait}
			}
			TextWait
	FadeOut 1000ms 0x00000000 255
	FadeWait
	CharSetPos field_party[0] (-16320, 3500, 61370) 330deg
	CharSetChipBase name[1] chip[255]
	CharSetChipPattern name[1] 0
	UnloadChip chip[30]
	QuestTaskSet quest[24] 3
	Sleep 500ms
	LookPointFlagsSet look_point[3] 0x0001
	EventEnd 5
	Return

fn[42]:
	EventBegin 0
	CrossFade 500ms
	CamSetDistance 7350 1500 -13970 0ms
	ED7CamRotate 6deg 25deg 0deg 0ms
	CamPers 350 0ms
	CamZoom 23390 0ms
	CharSetPos name[0] (7060, 0, -13810) 45deg
	CharSetPos name[1] (5760, 0, -14490) 45deg
	CharSetPos name[2] (7000, 0, -15130) 45deg
	CharSetPos name[3] (5890, 0, -13280) 45deg
	CharTurnToChar char[0] name[0] 0deg/s
	_Char4A char[0] 255
	CharSetChipPattern char[0] 0
	if PartyPosition name[8] > -1:
		CharSetPos name[8] (8160, 0, -14550) 0deg
		CharFlagsUnset field_party[4] 0x0080
		CharFlags2Unset field_party[4] 0x8000
	elif PartyPosition name[9] > -1:
		CharSetPos name[9] (8160, 0, -14550) 0deg
		CharFlagsUnset field_party[4] 0x0080
		CharFlags2Unset field_party[4] 0x8000
	FadeWait
	TextTalk name[0] {
		#6P#0000F請問……
		您是艾爾琴先生吧？{wait}
	}
	TextWait
	TextTalk char[0] {
		#11P嗯？找我有什麼事嗎？{wait}
	}
	TextWait
	TextTalk name[0] {
		#6P#0000F我們是克洛斯貝爾警察局的人，
		有點事要問您……{wait}
	}
	TextWait
	TextSetName ""
	TextMessage null {
		{color 5}羅伊德說明了回收
		逾期未還圖書的事由。{color 0}{wait}
	}
	TextWait
	TextClose 0
	_59
	TextTalk char[0] {
		#11P啊……我的確借過那本書。{wait}
	}
	TextWait
	TextTalk name[1] {
		#6P#0100F那您現在帶著那本書嗎……？{wait}
	}
	TextWait
	TextTalk char[0] {
		#11P這個，其實啊……{wait}
	}
	TextWait
	TextTalk char[0] {
		#11P我……我又借給別人了。{wait}
	}
	TextWait
	Emote name[0] 0mm 2000mm 2 7 80ms 1
	SoundPlay sound[28] 0 100 0
	Emote name[1] 0mm 2000mm 2 7 80ms 1
	SoundPlay sound[28] 0 100 0
	Emote name[3] 0mm 2000mm 2 7 80ms 1
	SoundPlay sound[28] 0 100 0
	Emote name[2] 0mm 2000mm 2 7 80ms 1
	SoundPlay sound[28] 0 100 0
	if PartyPosition name[8] > -1:
		Emote name[8] 0mm 2000mm 2 7 80ms 1
		SoundPlay sound[28] 0 100 0
	Sleep 1000ms
	TextTalk name[0] {
		#6P#0005F不、不是吧……？{wait}
	}
	TextWait
	TextTalk name[3] {
		#5P#0306F三重轉借啊……
		這情況真是不得了。{wait}
	}
	TextWait
	if PartyPosition name[8] > -1:
		TextTalk name[8] {
			#12P#0505F這可真令人驚訝……{wait}
		}
		TextWait
	elif PartyPosition name[9] > -1:
		TextTalk name[9] {
			#12P#0603F………………………………{wait}
		}
		TextWait
	TextTalk name[1] {
		#6P#0100F話說回來……
		這麼多人都想借的書，
		到底是本什麼樣的書啊？{wait}
	}
	TextWait
	TextTalk char[0] {
		#11P實、實在抱歉啊！！{wait}
	}
	TextWait
	TextTalk char[0] {
		#11P因為人家很有誠意，
		不斷懇求我，所以我
		忍不住就借出去啦！{wait}
	}
	TextWait
	TextTalk char[0] {
		#11P我本以為讓他
		馬上歸還就沒問題了……！{wait}
	}
	TextWait
	TextTalk name[0] {
		#6P#0005F請、請冷靜一下！
		既然都已經借出去了，
		那也沒辦法了！{wait}
	}
	TextWait
	TextTalk name[2] {
		#6P#0205F那麼，您接下來又借給誰了……？{wait}
	}
	TextWait
	TextTalk char[0] {
		#11P……咳咳。{wait}
	}
	TextWait
	TextTalk char[0] {
		#11P嗯，這個嘛……
		是農夫多納爾德。{wait}
	}
	TextWait
	TextTalk char[0] {
		#11P他應該在雷歐魯雜貨店
		隔壁的民居裡。{wait}
	}
	TextWait
	TextTalk name[0] {
		#6P#0006F呼……
		沒辦法，過去找他拿回圖書吧。{wait}
	}
	TextWait
	if PartyPosition name[8] > -1 | PartyPosition name[9] > -1:
		CharFlagsSet field_party[4] 0x0080
		CharFlags2Set field_party[4] 0x8000
	CharSetPos field_party[0] (7060, 0, -13810) 45deg
	CharTurnTo char[0] 0deg 0deg/s
	_Char4B char[0] 255
	QuestTaskSet quest[40] 3
	EventEnd 5
	Return

fn[43]:
	EventBegin 1
	if flag[773] && !flag[776]:
		TextTalk name[0] {
			#0005F啊，得向村裡所有人
			都打聽一遍才行啊。{wait}
		} {
			#0000F說不定有人
			知道魔獸的事。{wait}
		}
		TextWait
	if flag[776] && !flag[1024]:
		TextTalk name[0] {
			#0004F……唔，回去時就乘坐巴士吧。{wait}
		} {
			#0000F只要前往巴士站，
			應該就能查到下班車的發車時間了。{wait}
		}
		TextWait
	Sleep 50ms
	CharSetPos field_party[0] (17090, 0, -25640) 321deg
	EventEnd 4
	Return
