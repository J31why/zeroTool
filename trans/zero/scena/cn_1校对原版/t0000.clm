					case 9:
						NewScene "scena/t0500.bin" 0 0 0
						Hcf
						break
					case 10:
						NewScene "scena/r2050.bin" 0 0 0
						Hcf
						break
					case 11:
						NewScene "scena/m1000.bin" 0 0 0
						Hcf
						break
			else:
				var[0] = 99
		elif var[0] == 1:
			MenuClose menu[0]
			TextClose 0
			BgmStop 3000ms
			FadeOut 1000ms 0x00000000 255
			FadeWait
			_59
			SoundPlay sound[13] 0 100 0
			PartySetAttr name[255] 254 0
			CamLookChar field_party[0] 0ms
			Sleep 3500ms
			BgmResume
			FadeIn 1000ms 0x00000000
			TextClose 0
		else:
			MenuClose menu[0]
			TextClose 0
			Sleep 500ms
			_59
			var[0] = 0
	SystemFlagsUnset 0x08000000
	EventEnd 5
	Return

