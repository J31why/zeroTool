	EventEnd 5
	Return

fn[34]:
	EventBegin 1
	if !flag[0]:
		if system[10] == 0:
			TextTalk name[1] {
				#0100F羅伊德，難道不去找
				另外一個孩子嗎……？{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F也、也是啊。
				如果他發生什麼意外，可就來不及了……{wait}
			} {
				現在趕快去找另一個孩子吧。
				他多半就在下層區塊。{wait}
			}
			TextWait
		elif system[10] == 1:
			TextTalk name[0] {
				#0000F……等一下。
				現在必須要去尋找另一個孩子。{wait}
			}
			TextWait
			TextTalk name[1] {
				#0100F是啊，從目前的狀況來看，
				他應該就在下層區塊中……{wait}
			} {
				現在趕快去找他吧。{wait}
			}
			TextWait
		elif system[10] == 2:
			TextTalk name[0] {
				#0000F……等一下。
				現在必須要去尋找另一個孩子。{wait}
			}
			TextWait
			TextTalk name[2] {
				#0200F是啊。
				根據如今的狀況來看，
				他應該就在下層區塊中……{wait}
			} {
				現在趕快去找他吧。{wait}
			}
			TextWait
		elif system[10] == 3:
			TextTalk name[0] {
				#0000F……等一下。
				現在必須要去尋找另一個孩子。{wait}
			}
			TextWait
			TextTalk name[3] {
				#0300F啊，說的對。
				按照現在的狀況來看，
				他應該就在下層區塊裡吧……{wait}
			} {
				現在趕快去找他吧。{wait}
			}
			TextWait
		FlagSet flag[0]
	else:
		TextTalk name[0] {
			#0000F現在必須要趕快
			去找另一個孩子……{wait}
		} {
			去下層區塊展開搜索吧。{wait}
		}
		TextWait
	Sleep 50ms
	CharSetPos field_party[0] (-100000, 0, -4500) 0deg
	EventEnd 4
	Return

