fn[5]:
	if flag[812] && !flag[813]:
		Call fn[0,17]
	else:
		TextStart char[0]
		var[0] = 99
		while var[0] == 99:
			FadeOut 300ms 0x00000000 100
			Menu menu[0] -1 -1 1
				"對話" // 0
				"購物" // 1
				"休息" // 2
				"放棄" // 3
			MenuWait var[0]
			if var[0] < 1 | var[0] > 2:
				MenuClose menu[0]
				FadeIn 300ms 0x00000000
				FadeWait
			if var[0] == 1:
				ShopOpen shop[82]
				var[0] = 99
			elif var[0] == 2:
				ShopOpen shop[80]
				var[0] = 99
			elif var[0] != 0:
			elif var[0] == 0:
				var[0] = 99
				if flag[1566]:
					TextTalk char[0] {
						岡茲先生失蹤的原因，
						以及鎮長還沒回來的理由……
						我們直到現在都還一無所知。{wait}
					}
					TextWait
					TextTalk char[0] {
						唉，好擔心啊……{wait}
					}
					TextWait
				elif flag[1554]:
					TextTalk char[0] {
						我當時看到了
						正打算上巴士的鎮長，
						他的表情似乎很陰沉呢。{wait}
					}
					TextWait
					TextTalk char[0] {
						岡茲先生出了什麼事嗎？{wait}
					}
					TextWait
				elif flag[1547]:
					TextTalk char[0] {
						幾個月前的魔獸騷動也好，
						這次的礦工失蹤也罷……{wait}
					}
					TextWait
					TextTalk char[0] {
						總覺得在短短時間內
						發生了好多事啊。{wait}
					}
					TextWait
					TextTalk char[0] {
						希望這不是什麼
						壞事即將發生的徵兆……{wait}
					}
					TextWait
				elif flag[1544]:
					TextTalk char[0] {
						你們看起來好像很累啊，
						要不要住宿呢？{wait}
					}
					TextWait
				elif flag[1536]:
					TextTalk char[0] {
						感覺最近總是提不起勁呢……{wait}
					}
					TextWait
					TextTalk char[0] {
						是不是因為喝酒最豪爽
						的那位沒來呢……{wait}
					}
					TextWait
				elif flag[1307]:
					if !flag[0]:
						TextTalk char[0] {
							我們這裡的酒
							都是從一位名叫哈羅德
							的商人那裡進的貨哦。{wait}
						}
						TextWait
						TextTalk char[0] {
							他穿得那麼體面，
							拿來的酒果然
							也都是好酒。{wait}
						}
						TextWait
						TextTalk char[0] {
							麥酒最近差不多
							都快被礦工們喝光了……
							他下次再來的時候，得再訂一些貨呢。{wait}
						}
						TextWait
						FlagSet flag[0]
					else:
						TextTalk char[0] {
							哈羅德先生賣給我們的酒
							大多都是好酒呢。{wait}
						}
						TextWait
						TextTalk char[0] {
							對我們來說，真是必不可少的。{wait}
						}
						TextWait
				elif flag[1292]:
					if !flag[0]:
						TextTalk char[0] {
							女招待琉卡總是
							一臉不高興的樣子。
							只會說些刻薄的話呢。{wait}
						}
						TextWait
						TextTalk char[0] {
							……下次要不要給她灌點酒呢。{wait}
						}
						TextWait
						TextTalk char[0] {
							那孩子的酒量非常非常小，
							喝醉時的表情特別好玩哦。{wait}
						}
						TextWait
						Emote field_party[0] 0mm 2000mm 16 19 250ms 1
						SoundPlay sound[23] 0 100 0
						Emote field_party[1] 0mm 2000mm 16 19 250ms 1
						SoundPlay sound[23] 0 100 0
						Emote field_party[2] 0mm 2000mm 16 19 250ms 1
						SoundPlay sound[23] 0 100 0
						Emote field_party[3] 0mm 2000mm 16 19 250ms 1
						SoundPlay sound[23] 0 100 0
						Sleep 1000ms
						TextTalk name[1] {
							#0106F這算不算輕度犯罪啊……{wait}
						}
						TextWait
						FlagSet flag[0]
					else:
						TextTalk char[0] {
							……下次要不要給琉卡灌點酒呢。{wait}
						}
						TextWait
						TextTalk char[0] {
							那孩子的酒量非常非常小，
							喝醉時的表情特別好玩哦。{wait}
						}
						TextWait
				elif flag[1282]:
					TextTalk char[0] {
						畢竟是創立７０周年嘛。
						今年的遊客比去年多了不少，
						真是太好了。{wait}
					}
					TextWait
					TextTalk char[0] {
						紀念慶典期間，礦工們都去市裡玩了，
						酒館完全賺不到錢呢。{wait}
					}
					TextWait
				elif flag[1280]:
					if !flag[0]:
						TextTalk char[0] {
							昨天，全體礦工在這開了個宴會。{wait}
						}
						TextWait
						TextTalk char[0] {
							雖然很忙碌，
							但能讓他們那麼開心，
							就算是酒館最大的幸福了。{wait}
						}
						TextWait
						FlagSet flag[0]
					else:
						TextTalk char[0] {
							說起來，礦工羅基
							完全醉倒了呢。
							沒辦法，只好讓他在店裡睡下了。{wait}
						}
						TextWait
						TextTalk char[0] {
							真是的，年紀輕輕，
							竟然這麼沒出息呢。{wait}
						}
						TextWait
				elif flag[1055]:
					TextTalk char[0] {
						今天來的客人好像很年輕，
						但聽說是遊擊士呢。{wait}
					}
					TextWait
					TextTalk char[0] {
						……氣氛好像很沉重，
						是出了什麼事嗎？{wait}
					}
					TextWait
				elif flag[1040]:
					if !flag[0]:
						TextTalk char[0] {
							這家店在白天
							還真是閒啊。{wait}
						}
						TextWait
						TextTalk char[0] {
							……好吧，反正也很閒，
							就告訴你們一個秘密吧。{wait}
						}
						TextWait
						TextTalk char[0] {
							女招待琉卡
							雖然總是一臉不高興的表情……{wait}
						}
						TextWait
						TextTalk char[0] {
							但笑起來時可是超級可愛的。
							我要是男人的話，
							一定會迷上她哦。{wait}
						}
						TextWait
						FlagSet flag[0]
					else:
						TextTalk char[0] {
							琉卡雖然總是一臉不高興的樣子，
							但笑容可是超級可愛的哦。{wait}
						}
						TextWait
						TextTalk char[0] {
							不過她很少露出
							那種笑容，
							還真是很可惜呢。{wait}
						}
						TextWait
				elif flag[1024]:
					if !flag[0]:
						TextTalk char[0] {
							魔獸騷動平息了，
							我們鎮子也恢復了平靜。{wait}
						}
						TextWait
						TextTalk char[0] {
							雖然礦工們
							老是抱怨什麼『不能提早回家了』
							之類的胡話。{wait}
						}
						TextWait
						TextTalk char[0] {
							總而言之，
							不會再遭遇危險，
							真是太好了。{wait}
						}
						TextWait
						FlagSet flag[0]
					else:
						TextTalk char[0] {
							魔獸騷動平息了，
							礦工和鎮上的人
							也不會再受到襲擊了。{wait}
						}
						TextWait
						TextTalk char[0] {
							這都多虧了你們，
							真是太謝謝了。{wait}
						}
						TextWait
				elif flag[812]:
					if !flag[0]:
						TextTalk char[0] {
							嗯，要出門嗎？{wait}
						}
						TextWait
						TextTalk char[0] {
							最近鎮上有些不太平靜，
							所以最好早點回來哦。{wait}
						}
						TextWait
						FlagSet flag[0]
					else:
						TextTalk char[0] {
							要不就來喝點酒，
							暖暖身子吧？{wait}
						}
						TextWait
						TextTalk char[0] {
							……雖然已經滿座了。{wait}
						}
						TextWait
				elif flag[801]:
					if !flag[820]:
						FlagSet flag[820]
						global[2] = global[2] + 1
					if !flag[0]:
						TextTalk char[0] {
							哎呀，你們看上去很面生呢。
							是從克洛斯貝爾市來的嗎？{wait}
						}
						TextWait
						TextTalk char[0] {
							話說回來，
							你們來的時機真是不巧啊。{wait}
						}
						TextWait
						TextTalk char[0] {
							最近有狼型魔獸
							在這一帶肆虐呢。{wait}
						}
						TextWait
						TextTalk char[0] {
							不久前，我們這裡的糧倉也被破壞了。
							真是的，太可惡了。{wait}
						}
						TextWait
						FlagSet flag[0]
					else:
						TextTalk char[0] {
							對了對了，
							不嫌棄的話，要不要吃點什麼？{wait}
						}
						TextWait
						TextTalk char[0] {
							要是想好好休息一下的話，
							最好趁現在休息哦。{wait}
						}
						TextWait
						TextTalk char[0] {
							到了晚上，
							收工回來的礦工們
							就會把席位都占滿的。{wait}
						}
						TextWait
		TextEnd char[0]
	Return

fn[6]:
	TextStart self
	if flag[1566]:
		TextTalk self {
			我感覺岡茲先生失蹤
			事件的背後……
			隱藏著巨大的謎團。{wait}
		}
		TextWait
		TextTalk self {
			……是懸疑小說
			看多了嗎……{wait}
		}
		TextWait
	elif flag[1554]:
		TextTalk self {
			既然找到岡茲先生了……
			很可能會再開一場慶祝宴會吧。{wait}
		}
		TextWait
		TextTalk self {
			唉……收拾殘局又會很辛苦呢。{wait}
		}
		TextWait
	elif flag[1547]:
		TextTalk self {
			岡茲先生好像真的
			很不擅長賭博呢。{wait}
		}
		TextWait
		TextTalk self {
			在這裡喝醉的時候，
			大概都是在抱怨輸錢。{wait}
		}
		TextWait
	elif flag[1544]:
		TextTalk self {
			嗯，打掃得差不多了吧。{wait}
		}
		TextWait
		TextTalk self {
			只是少了岡茲先生一個人，
			打掃就變得簡單多了。{wait}
		}
		TextWait
	elif flag[1536]:
		if !flag[1]:
			TextTalk self {
				好了～要趁客人不在時快點打掃才行。{wait}
			}
			TextWait
			TextTalk self {
				話說回來，最近好像
				都不怎麼開宴會了呢。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				最近一直沒什麼宴會，
				所以打掃很輕鬆呢。{wait}
			}
			TextWait
	elif flag[1307]:
		TextTalk self {
			紀念慶典在今天就要結束了啊。{wait}
		}
		TextWait
		TextTalk self {
			遊客們也許要走了，
			不過礦工們也該回來了。{wait}
		}
		TextWait
		TextTalk self {
			唉唉～好忙好忙。{wait}
		}
		TextWait
	elif flag[1292]:
		TextTalk self {
			算啦，雖然有點忙……
			不過，你們要不要也喝點什麼？{wait}
		}
		TextWait
		TextTalk self {
			……但就算你們因此搞砸了工作，我也不負責哦。{wait}
		}
		TextWait
	elif flag[1282]:
		TextTalk self {
			在舉辦紀念慶典的時候
			特地跑到這種冷清之地的
			遊客嗎……{wait}
		}
		TextWait
		TextTalk self {
			……不過，心情也可以理解吧。
			我也很討厭人山人海。{wait}
		}
		TextWait
	elif flag[1280]:
		if !flag[1]:
			TextTalk self {
				真是的，每天都快累死了。{wait}
			}
			TextWait
			TextTalk self {
				……酒這種東西，到底好在哪裡啊？
				我完全不能喝酒，所以真是不明白它有什麼吸引人的。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0006F以、以酒館女招待的身份來說，
				這種發言還真是意外呢……{wait}
			}
			TextWait
			TextTalk self {
				你好煩啊，客人。
				這是我的自由吧。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				真是的，酒這種東西，到底好在哪裡啊。{wait}
			}
			TextWait
			TextTalk self {
				……之前因為好奇而喝了一點，
				但現在已經完全不記得當時的情況了，
