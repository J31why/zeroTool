calmare zero_k scena
scena:
	name "t1540" "t1540" "t1540_1"
	town town[81]
	bgm bgm[123]
	flags 8192
	item_use fn[0,255]
	unk 255 0

entry:
	pos (0, 0, -1000)
	unk1 0
	cam_from (0, 2500, 34000)
	cam_pers 262
	unk2 30
	cam_deg 45deg
	cam_limit 0deg 360deg
	cam_at (0, 0, 0)
	unk3 0
	unk4 0
	flags 0x0001
	town town[81]
	init fn[0,1]
	reinit fn[0,3]

fn[0]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if flag[1566]:
	elif flag[1565]:
	elif flag[1554]:
	elif flag[1536]:
	elif flag[1351]:
	elif flag[1346]:
	elif flag[1307]:
	elif flag[1292]:
	elif flag[1282]:
	elif flag[1280]:
	elif flag[1040]:
	elif flag[1024]:
	elif flag[799]:
		if !flag[0]:
			TextTalk self {
				對了，
				約亞西姆醫生說
				我明天應該就可以出院了……{wait}
			}
			TextWait
			TextTalk self {
				嗚啊～工作一定堆積如山了。
				還想再睡一下啊……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				唉，難得明天可以出院了，
				但一想到工作還真鬱悶啊……{wait}
			}
			TextWait
	elif flag[793]:
		if !flag[0]:
			TextTalk self {
				啊，我說你們幾個。
				屋頂調查得怎麼樣了？{wait}
			}
			TextWait
			TextTalk name[0] {
				#0001F嗯，雖然還殘留著一些謎團……
				不過已經發現了魔獸去過的痕跡。{wait}
			}
			TextWait
			TextTalk self {
				真、真的嗎！？{wait}
			}
			TextWait
			TextTalk self {
				嗯～那果然
				不是我在做夢啊………………{wait}
			}
			TextWait
			TextTalk self {
				……嗯，謝謝你們了。
				光是確定了這一點，
				對我來說，就算是有收穫了。{wait}
			}
			TextWait
			TextTalk name[1] {
				#0100F不用客氣。{wait}
			}
			TextWait
			TextTalk name[2] {
				#0200F那麼……
				去向賽西兒小姐
				報告吧。{wait}
			}
			TextWait
			if flag[796]:
				TextTalk name[3] {
					#0300F她好像去了院區
					三樓的單人間吧。
					趕快過去看看吧。{wait}
				}
				TextWait
			else:
				TextTalk name[3] {
					#0300F去護理師中心那裡問問，
					應該就能知道她在哪裡了。
					趕快過去看看吧。{wait}
				}
				TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				那果然不是我在做夢啊……{wait}
			}
			TextWait
	elif flag[784]:
		if !flag[0]:
			TextTalk self {
				嗯……那果然
				是我的幻覺嗎……{wait}
			}
			TextWait
			TextTalk self {
				如果真的只是夢就好了，
				可我全身都受了傷……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				……總之，調查就拜託你們了。
				無論是夢還是現實，
				我都想知道受傷的原因呢。{wait}
			}
			TextWait
	elif flag[777]:
	CharSetChipPattern self 0
	TextEnd self
	Return

fn[1]:
	TextStart self
	if flag[1566]:
		if !flag[1]:
			Call fn[1,2]
		else:
			CharTurnToChar char[4] char[1] 0deg/s
			_Char4A char[4] 255
			TextTalk self {
				嘿嘿，又失敗了。{wait}
			}
			TextWait
			TextTalk self {
				不要介意，不要介意。
				人生在世，
				孰能無過嘛。{wait}
			}
			TextWait
			TextTalk char[4] {
				但你的過失也太多了。{wait}
			}
			TextWait
			_Char4B char[4] 255
	elif flag[1565]:
	elif flag[1554]:
	elif flag[1536]:
	elif flag[1351]:
	elif flag[1346]:
	elif flag[1307]:
	elif flag[1292]:
		if !flag[1]:
			Call fn[1,2]
		else:
			TextTalk self {
				米海爾和艾妲
				出去散步了～{wait}
			}
			TextWait
			TextTalk self {
				大概在水邊吧？{wait}
			}
			TextWait
	elif flag[1282]:
	elif flag[1280]:
	elif flag[1040]:
		if !flag[1]:
			Call fn[1,3]
		else:
			TextTalk self {
				呵呵……
				有這麼多體溫計的話，
				再怎麼失敗也不怕了。{wait}
			}
			TextWait
	elif flag[1024]:
		if !flag[1]:
			Call fn[1,3]
		else:
			TextTalk self {
				呵呵，失敗失敗。
				原來體溫計放在
				這邊的口袋裡了。{wait}
			}
			TextWait
	elif flag[799]:
	elif flag[793]:
	elif flag[784]:
		if !flag[1]:
			Call fn[1,2]
		else:
			TextTalk self {
				呼……
				梅菲爾真是
				愛生氣。{wait}
			}
			TextWait
			TextTalk self {
				待會還要去
				蓋巴爾先生那裡啊。{wait}
			}
			TextWait
	elif flag[777]:
	TextEnd self
	Return

fn[2]:
	CharTurnToChar char[1] char[4] 0deg/s
	CharTurnToChar char[4] char[1] 0deg/s
	_Char4A char[1] 255
	_Char4A char[4] 255
	if flag[1566]:
		TextTalk char[4] {
			希蓉，你啊……
			連杯咖啡也泡不好嗎？{wait}
		}
		TextWait
		TextTalk char[4] {
			為什麼咖啡裡
			會有紅茶的香味啊？{wait}
		}
		TextWait
		TextTalk char[1] {
			嗯～大概是因為……
			我可能把咖啡
			和紅茶放在一起泡了。{wait}
		}
		TextWait
		TextTalk char[4] {
			這我知道！
			所以我才想問你為什麼總是這樣……{wait}
		}
		TextWait
		TextTalk char[4] {
			……唉，真是累死人了……{wait}
		}
		TextWait
	elif flag[1565]:
	elif flag[1554]:
	elif flag[1536]:
	elif flag[1351]:
	elif flag[1346]:
	elif flag[1307]:
	elif flag[1292]:
		TextTalk char[1] {
			那個～梅菲爾，
			米海爾得的到底是什麼病？{wait}
		}
		TextWait
		TextTalk char[4] {
			嗯……是很難治的病，
			想痊癒的話，似乎必須要動手術。{wait}
		}
		TextWait
		TextTalk char[4] {
			但是，外科手術給人感覺很恐怖吧？
			米海爾似乎也不例外，
			總是無法下定決心，接受手術呢。{wait}
		}
		TextWait
		TextTalk char[1] {
			呼，是這樣啊……{wait}
		}
		TextWait
		TextTalk char[1] {
			只要有接受手術的勇氣，
			米海爾的病也是能治好的。{wait}
		}
		TextWait
		TextTalk char[1] {
			要是能有什麼讓他產生勇氣的
			契機就好了～{wait}
		}
		TextWait
		TextTalk char[4] {
			你啊……偶爾也會
			說兩句正經話呢……{wait}
		}
		TextWait
	elif flag[1282]:
	elif flag[1280]:
	elif flag[1040]:
	elif flag[1024]:
	elif flag[799]:
	elif flag[793]:
	elif flag[784]:
		TextTalk char[4] {
			聽說妳昨天……把番茄醬
			灑到蓋巴爾先生的床單上了？{wait}
		}
		TextWait
		TextTalk char[1] {
			是呀～
			真是嚇我一跳。{wait}
		}
		TextWait
		TextTalk char[1] {
			偶然來查房的醫生
			誤以為是大出血而嚇得昏倒……{wait}
		}
		TextWait
		TextTalk char[4] {
			妳、妳這人啊……{wait}
		}
		TextWait
		TextTalk char[4] {
			總之，床單算是
			洗乾淨了……{wait}
		}
		TextWait
		TextTalk char[4] {
			妳可要把乾淨的
			新床單拿過去，
			並向蓋巴爾先生好好道歉哦。{wait}
		}
		TextWait
		TextTalk char[1] {
			哎……可是我不太喜歡
			那個大叔哎……{wait}
		}
		TextWait
		TextTalk char[4] {
			不准發牢騷！{wait}
		}
		TextWait
	elif flag[777]:
	FlagSet flag[1]
	FlagSet flag[2]
	_Char4B char[1] 255
	_Char4B char[4] 255
	Return

fn[3]:
	CharTurnToChar char[1] char[19] 0deg/s
	CharSetChipPattern char[19] 2
	_Char4A char[1] 255
	if flag[1280]:
	elif flag[1040]:
		TextTalk char[1] {
			來～到了今天量體溫的時間了哦。
			要夾體溫計了哦。{wait}
		}
		TextWait
		TextTalk char[19] {
			……護、護理師小姐。
			要量體溫是沒問題……
			但妳為什麼拿著十支體溫計？{wait}
		}
		TextWait
		TextTalk char[1] {
			因為，有這麼多的話，就算量的時候
			斷掉幾根，至少應該也有一根能正常量出來嘛！{wait}
		}
		TextWait
		TextTalk char[19] {
			（好、好不安……）{wait}
		}
		TextWait
	elif flag[1024]:
		TextTalk char[1] {
			來～到了量體溫的時間了哦。
			要夾體溫計了哦。{wait}
		}
		TextWait
		TextTalk char[19] {
			……護、護理師小姐。
			妳沒有像昨天一樣，
			錯把注射器拿來吧？{wait}
		}
		TextWait
		TextTalk char[1] {
			討厭，沒有啦。
			就算是我，也不會重複
			同樣的錯誤啊……{wait}
		}
		TextWait
		TextTalk char[1] {
			…………啊。{wait}
		}
		TextWait
		TextTalk char[19] {
			…………………………{wait}
		}
		TextWait
	FlagSet flag[1]
	CharSetChipPattern char[19] 0
	_Char4B char[1] 255
	Return

fn[4]:
	Call fn[1,5]
	Return

fn[5]:
	if flag[793] && !flag[796]:
		Call fn[0,11]
	else:
		TextStart char[2]
		if flag[1566]:
			if !flag[3]:
				TextTalk char[2] {
					再過幾天，就是久違的假日了。{wait}
				}
				TextWait
				TextTalk char[2] {
					呵呵，蘭迪先生……
					下次大家再一起去玩吧！{wait}
				}
				TextWait
				TextTalk name[3] {
					#0300F好，等你們哦！{wait}
				}
				TextWait
				if PartyPosition name[9] != -1:
					TextTalk name[9] {
						#0603F……執行任務時，竟敢當著我的面
						約定出遊，真是好大的膽子啊。{wait}
					} {
						#0600F如果你是一課的成員，
						回去以後就得給我
						拼死寫檢討書了。{wait}
					}
					TextWait
					TextTalk name[3] {
						#0305F呃……！？{wait}
					}
					TextWait
				FlagSet flag[3]
			else:
				TextTalk char[2] {
					自紀念慶典以來，終於
					可以請到假了。{wait}
				}
				TextWait
				TextTalk char[2] {
					我會把蘭恩和艾妲也約上，
					下次再一起去玩吧～{wait}
				}
				TextWait
		elif flag[1565]:
			TextTalk char[2] {
				差不多快到晚飯的時間了呢～{wait}
			}
			TextWait
			TextTalk char[2] {
				要去琪秀宿舍長那裡
				給病人們取餐點才行～{wait}
			}
			TextWait
		elif flag[1554]:
			TextTalk char[2] {
				今天送來的那些傷患，
				輕傷的那位躺在
				２０１號室哦～{wait}
			}
			TextWait
		elif flag[1536]:
			if !flag[3]:
				TextTalk char[2] {
					那個叫蓋巴爾的議員大叔
					住在三樓的單人病房……{wait}
				}
				TextWait
				TextTalk char[2] {
					有一次，他喝得大醉，
					然後闖進了護理站，
					還說什麼來人給他倒酒呢～{wait}
				}
				TextWait
				TextTalk char[2] {
					之後護理師長很快就趕了回來，
					把他轟走了……{wait}
				}
				TextWait
				TextTalk char[2] {
					真是的，該不會是把護理師
					當成公關小姐之類的吧～{wait}
				}
				TextWait
				FlagSet flag[3]
			else:
				TextTalk char[2] {
					偶爾也會有蓋巴爾議員
					那種給人添麻煩的患者呢。{wait}
				}
				TextWait
				TextTalk char[2] {
					要麼就是在醫院裡住得很舒服，賴著不出院，
					要麼就是對護理師們進行騷擾……{wait}
				}
				TextWait
				TextTalk char[2] {
					真是的，感覺好討厭啊～{wait}
				}
				TextWait
		elif flag[1351]:
			TextTalk char[2] {
				有個臉蛋漲得通紅的小女孩
				往樓下跑去了。{wait}
			}
			TextWait
			TextTalk char[2] {
				好像在生氣鬧彆扭的樣子……
				不過還真是可愛啊～㈱{wait}
			}
			TextWait
		elif flag[1346]:
			TextTalk char[2] {
				啊，這不是警察弟弟嘛。{wait}
			}
			TextWait
			TextTalk char[2] {
				賽西兒前輩
				去３０１號室了哦～{wait}
			}
			TextWait
		elif flag[1307]:
			TextTalk char[2] {
				醫生不在的話，
				總是會覺得不安呢～{wait}
			}
			TextWait
			TextTalk char[2] {
				雖然聽說各位實習醫生也是很優秀的，
				但還是比不上教授呀～{wait}
			}
			TextWait
		elif flag[1292]:
			if !flag[3]:
				TextTalk char[2] {
					肚子餓了……{wait}
				}
				TextWait
				TextTalk char[2] {
					護理師的午休是輪流制，
					所以經常會錯過
					午飯時間呢～{wait}
				}
				TextWait
				TextTalk char[2] {
					給病人量體溫的時候，肚子突然叫起來，
					會很難為情的啊～{wait}
				}
				TextWait
				FlagSet flag[3]
			else:
				TextTalk char[2] {
					（咕……）{wait}
				}
				TextWait
				TextTalk char[2] {
					唉……好想早點午休啊。{wait}
				}
				TextWait
		elif flag[1282]:
			if !flag[3]:
				TextTalk char[2] {
					明天真想再多休息一天呀，
					哪怕只多一天也好～{wait}
				}
				TextWait
				TextTalk char[2] {
					因為明天會有遊行哦。
					不觀賞那個的話，
					就不能算是參加了紀念慶典呀～{wait}
				}
				TextWait
				TextTalk char[2] {
					好羨慕當警察的各位呀。
					可以以工作為借口，
					去看遊行吧？{wait}
				}
				TextWait
				TextTalk name[0] {
					#0006F我、我們才不會
					做那樣的事……{wait}
				}
				TextWait
				FlagSet flag[3]
			else:
				TextTalk char[2] {
					雖然很想看明天的遊行……
					唉，但畢竟要工作，也沒辦法呢～{wait}
				}
				TextWait
		elif flag[1280]:
			TextTalk char[2] {
				昨天值班的梅菲爾
				和希蓉今天休息～{wait}
			}
			TextWait
			TextTalk char[2] {
				我們昨天玩得很開心呢，
				所以今天一天可得努力工作才行～{wait}
			}
			TextWait
		elif flag[1040]:
			if !flag[3]:
				TextTalk char[2] {
					那個伊莉雅・普拉提耶的朋友
					竟然就在我的身邊，真是令人吃驚呢～{wait}
				}
				TextWait
				TextTalk char[2] {
					……能不能拜託
					賽西兒前輩
					向伊莉雅小姐要個簽名呢？{wait}
				}
				TextWait
				TextTalk name[0] {
					#0000F（伊莉雅小姐的崇拜者……
					　還真多啊。）{wait}
				}
				TextWait
				FlagSet flag[3]
			else:
				TextTalk char[2] {
					……能不能拜託
					賽西兒前輩
					向伊莉雅小姐要個簽名呢？{wait}
				}
				TextWait
				TextTalk char[2] {
					下次找個機會
					問問看吧……{wait}
				}
				TextWait
		elif flag[1024]:
			TextTalk char[2] {
				唉～唉，結果還是沒有
				弄到彩虹劇團的票啊～{wait}
			}
			TextWait
			TextTalk char[2] {
				護理師長雖然很得意地說她以前看過，
				但現在的彩虹劇團
				肯定已經更厲害了。{wait}
			}
			TextWait
		elif flag[799]:
			TextTalk char[2] {
				３６度６……很正常呢～{wait}
			}
			TextWait
			TextTalk char[2] {
				接下來是利頓醫生了吧～{wait}
			}
			TextWait
		elif flag[793]:
			TextTalk char[2] {
				……瑪薩護理師長是順風耳，
				真有點怕她呢。{wait}
			}
			TextWait
			TextTalk char[2] {
				不知道她會不會躲在某處聽到
				我們談話，可要小心才行……{wait}
			}
			TextWait
		elif flag[784]:
			if !flag[849]:
				TextTalk char[2] {
					啊，賽西兒前輩。
					辛苦了～{wait}
				}
				TextWait
				TextTalk char[2] {
					休息時間很快
					就要結束了……
					妳在幹什麼呢？{wait}
				}
				TextWait
				TextTalk name[53] {
					#1300F我在幫他們做點事情。
					抱歉哦，我馬上就回來。{wait}
				}
				TextWait
				TextTalk char[2] {
