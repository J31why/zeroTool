fn[10]:
	TextStart self
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"對話" // 0
			"購物" // 1
			"放棄" // 2
		MenuWait var[0]
		if var[0] != 1:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			ShopOpen shop[57]
			var[0] = 99
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			if QuestTaskGet quest[2] 0 && !QuestTaskGet quest[2] 2 && !QuestFlagsGet quest[2] 0x40:
				if !flag[3]:
					if !flag[17]:
						TextTalk name[0] {
							#0003F（東側大道的市場……
							　這裡是遺失了物品的特倫特先生
							　途中經過的地方。）{wait}
						}
						TextWait
						FlagSet flag[17]
					TextTalk name[0] {
						#0000F不好意思，請問您在這附近
						撿到過什麼失物嗎？{wait}
					}
					TextWait
					TextTalk self {
						失物啊……？{wait}
					}
					TextWait
					TextTalk self {
						沒有，沒見過。{wait}
					}
					TextWait
					TextTalk self {
						我每天都會打掃店前，
						從來沒見過什麼失物。{wait}
					}
