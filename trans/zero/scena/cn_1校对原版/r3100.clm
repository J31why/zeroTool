calmare zero_k scena
scena:
	name "r3100" "r3100" "r3100"
	town town[102]
	bgm bgm[203]
	flags 0
	item_use fn[0,255]
	unk 255 0

entry:
	pos (0, 0, -1000)
	unk1 0
	cam_from (0, 2500, 34000)
	cam_pers 262
	unk2 30
	cam_deg 45deg
	cam_limit 0deg 360deg
	cam_at (-8500, 0, -4500)
	unk3 0
	unk4 0
	flags 0x0001
	town town[102]
	init fn[0,0]
	reinit fn[0,1]

look_point[0]:
	pos (-4500, 13100, -4750)
	radius 1200
	bubble_pos (-4500, 14100, -4750)
	unk1 124
	unk2 0
	function fn[0,2]
	unk3 0
	unk4 0

fn[0]:
	Return

fn[1]:
	if !flag[2112]:
		ObjFrame object[0] 0
	else:
		ObjFrame object[0] 30
	Return

fn[2]:
	ED7_F2 1
	SystemFlagsSet 0x08000000
	if !flag[2112]:
		SoundPlay sound[14] 0 100 0
		ED7ObjPlay object[0] 0 30 0 0
		Sleep 500ms
		if ItemAdd item[508] 1:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextSetName ""
			TextMessage name[742] {
				{color 0}已取得{item[508]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			TextSetPos -1 280 60 3
			FadeIn 300ms 0x00000000
			FlagSet flag[2112]
			ED7_DE 6
		else:
			FadeOut 300ms 0x00000000 100
			TextSetName ""
			TextMessage name[742] {
				寶箱內裝著{item[508]}{color 0}。
				但因持有物品已滿而放棄{item[508]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			SoundPlay sound[15] 0 100 0
			ED7ObjPlay object[0] 30 0 0 0
	else:
		FadeOut 300ms 0x00000000 100
		TextSetPos -1 -1 -1 -1
		TextSetName ""
		TextMessage name[742] {
			{0x06}{color 5}寶箱內空無一物。{color 0}{wait}
		}
		TextWait
		TextClose 0
		FadeIn 300ms 0x00000000
	Sleep 30ms
	TextEnd null
	SystemFlagsUnset 0x08000000
	Return
