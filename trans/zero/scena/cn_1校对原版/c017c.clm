			}
			TextWait
			TextTalk name[0] {
				#0000F是嗎……
				謝謝妳們了。{wait}
			}
			TextWait
			FlagSet flag[1374]
			global[2] = global[2] + 1
			Call fn[0,25]
			CharTurnTo char[1] 225deg 0deg/s
			_Char4B char[1] 255
		else:
			TextTalk char[0] {
				來我們百貨的孩子們
				應該都有父母帶著。{wait}
			}
			TextWait
			TextTalk char[0] {
				好像沒看見
				你們在找的孩子哦。{wait}
			}
			TextWait
	elif flag[1362]:
		if !flag[0]:
			_Char4A char[1] 255
			TextTalk char[0] {
