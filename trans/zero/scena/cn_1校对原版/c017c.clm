			_Char4A char[1] 255
			TextTalk char[0] {
				……看到前輩
				歎氣的瞬間了。{wait}
			}
			TextWait
			TextTalk char[0] {
				嗯～像前輩這種成熟的女性，
				果然是性感非常啊。{wait}
			}
			TextWait
			CharTurnToChar char[1] char[0] 500deg/s
			TextTalk char[1] {
				對、對客人說什麼呢，
				帕爾……{wait}
			}
			TextWait
			CharTurnTo char[1] 225deg 0deg/s
