			FlagSet flag[0]
		else:
			TextTalk char[0] {
				像前輩這種成熟的女性，
				哪怕只是歎口氣，
				也都性感非常啊。{wait}
			}
			TextWait
			TextTalk char[0] {
				為什麼男人們不來追求前輩呢～{wait}
			}
			TextWait
	elif flag[1294]:
