			_Char4A char[1] 255
			TextTalk name[0] {
				#0001F（嗯，她們兩位
				　可能知道些什麼吧……）{wait}
			}
			TextWait
			TextMessage null {
				{color 5}羅伊德出示了柯林的照片，
				並詢問對方是否有什麼線索。{color 0}{wait}
			}
			TextWait
			TextClose 0
			_59
			Emote char[0] 0mm 2000mm 38 38 250ms 1
			Sleep 1000ms
			TextTalk char[0] {
				是走失的孩子嗎……？{wait}
			}
			TextWait
			CharTurnToChar char[1] field_party[0] 500deg/s
			TextTalk char[1] {
				哎呀，走失的孩子啊……
				那可真令人擔心呢。{wait}
			}
			TextWait
			TextTalk char[1] {
				可是我好像
				沒有什麼頭緒呢。{wait}
			}
			TextWait
			Fork char[0] fork[2]:
				CharTurnToChar char[0] char[1] 500deg/s
			Fork char[1] fork[2]:
				CharTurnToChar char[1] char[0] 500deg/s
			ForkWait char[0] fork[2]
