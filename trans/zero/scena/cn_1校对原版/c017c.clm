				帕爾……{wait}
			}
			TextWait
			CharTurnTo char[1] 225deg 0deg/s
			_Char4B char[1] 255
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				像前輩這種成熟的女性，
				哪怕只是歎口氣，
