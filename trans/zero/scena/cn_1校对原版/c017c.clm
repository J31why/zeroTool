			我以前總是大男子主義，
			就愛裝腔作勢，
			真是慚愧呀。{wait}
		}
		TextWait
		TextTalk self {
			今後也時不時地
			送她點禮物吧。{wait}
		}
		TextWait
	elif flag[1362]:
		TextTalk self {
			唔唔……傷腦筋。
			我實在是沒有什麼送禮物的經驗，
			搞不清該選什麼啊。{wait}
		}
		TextWait
	elif flag[1292]:
		TextTalk self {
			那麼……到底送什麼，
			才能讓老伴開心呢。{wait}
		}
		TextWait
	elif flag[1286]:
		TextTalk self {
			還是應該送正統的戒指吧。{wait}
		}
		TextWait
		TextTalk self {
			可是，如果送老伴這個，
			就會想起求婚時的情景，
			實在是難為情呢……{wait}
		}
		TextWait
	elif flag[1282]:
		TextTalk self {
			難得的紀念慶典，
			我正在選購很早以前就計畫
			送給老伴的禮物。{wait}
		}
		TextWait
		TextTalk self {
			唔……該送什麼好呢？{wait}
		}
		TextWait
	elif flag[1280]:
		TextTalk self {
			在昨天的典禮上，
			聽到了麥克道爾市長
			的精彩演講。{wait}
		}
		TextWait
		TextTalk self {
			他好像和那個
			哈爾特曼議長是對立關係，
			希望他今後也多加努力啊。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[25]:
	if global[2] == 7:
		TextTalk name[95] {
			#3300F（中央廣場的探聽
			　就到此為止吧？）{wait}
		}
		TextWait
		TextTalk name[0] {
			#0000F（嗯，應該足夠了。）{wait}
		} {
			（接下來就去
			　站前大道探聽吧。）{wait}
		}
		TextWait
		global[2] = 0
		FlagSet flag[1485]
		QuestTaskSet quest[70] 7
	Return

