			}
			TextWait
			TextTalk char[0] {
				為什麼男人們不來追求前輩呢～{wait}
			}
			TextWait
	elif flag[1292]:
		TextTalk char[0] {
			經理的那些企劃，
			對員工來說，
			有不少實施起來都比較有難度。{wait}
		}
		TextWait
		TextTalk char[0] {
			即使如此，大家也都會追隨他，
