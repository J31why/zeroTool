				#0203F……一眼就看出我們不是會員了嗎。{wait}
			}
			TextWait
		else:
			TextTalk name[2] {
				#5403F……一眼就看出我們不是會員了嗎。{wait}
			}
			TextWait
		if !flag[1355]:
			TextTalk name[3] {
				#0310F#12P感、感覺真不爽啊……！{wait}
			}
			TextWait
		else:
			TextTalk name[3] {
				#5610F#12P感、感覺真不爽啊……！{wait}
			}
			TextWait
		TextTalk name[0] {
			#5003F#3P總、總之……
			進不去的話也沒辦法，
			就先放棄吧。{wait}
		}
		TextWait
		_59
		FlagSet flag[1393]
		TriggerFlagsSet trigger[1] 0x0080
		EventEnd 5
	else:
