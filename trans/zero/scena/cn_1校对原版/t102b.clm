fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharIdle self (97550, null, 16140) (102740, null, 18340) 1000mm/s
		Sleep 150ms
	Return

fn[2]:
	if flag[1333] && !flag[1342]:
	else:
		CharFlagsUnset char[0] 0x0080
		CharFlagsUnset char[1] 0x0080
		CharFlagsUnset char[2] 0x0080
		CharFlagsUnset char[3] 0x0080
		CharFlagsUnset char[4] 0x0080
		CharFlagsUnset char[5] 0x0080
		CharFlagsUnset char[6] 0x0080
		CharFlagsUnset char[7] 0x0080
		CharFlagsUnset char[8] 0x0080
		ForkFunc char[3] fork[0] fn[0,1]
	Return

fn[3]:
	TriggerFlagsSet trigger[0] 0x0080
	if flag[1340] && !flag[1341]:
		TriggerFlagsUnset trigger[0] 0x0080
	if flag[1341]:
		Call fn[0,13]
	if flag[1333]:
	TriggerFlagsSet trigger[2] 0x0080
	ObjFlagsUnset object[2] 0x0010
	TriggerFlagsSet trigger[1] 0x0080
	if flag[1312] && !flag[1320]:
		TriggerFlagsUnset trigger[1] 0x0080
	EntranceSetFunc entrance[5] fn[255,65535]
	EntranceSetFunc entrance[7] fn[255,65535]
	TriggerFlagsSet trigger[3] 0x0080
	if flag[1333] && !flag[1342]:
		ObjFlagsUnset object[3] 0x0010
		EntranceSetFunc entrance[5] fn[0,35]
		EntranceSetFunc entrance[7] fn[0,37]
		TriggerFlagsUnset trigger[1] 0x0080
		TriggerFlagsUnset trigger[3] 0x0080
	Return

fn[4]:
	TextStart self
	TextTalk self {
		哎呀，遊客也
		差不多該回來了。{wait}
	}
	TextWait
	TextTalk self {
		……？
		那些往住宅區方向去的人
		到底要做什麼呢？{wait}
	}
	TextWait
	TextEnd self
	Return

fn[5]:
	TextStart self
	TextTalk self {
		那麼，差不多也該
		出發前往議長宅邸了。{wait}
	}
	TextWait
	TextTalk self {
		哈哈哈……
		看來，今晚會充滿樂趣。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[6]:
	TextStart self
	TextTalk self {
		這個人說，今天要為我
		拍到飾品呢。{wait}
	}
	TextWait
	TextTalk self {
		真是對不起他的夫人哦。
		呵呵……{wait}
	}
	TextWait
	TextEnd self
	Return

fn[7]:
	TextStart self
	if !flag[0]:
		TextTalk self {
			哎呀，滿足，太滿足了。{wait}
		}
		TextWait
		TextTalk self {
			主題樂園中最奇妙的
			樂趣──『踢咪西』
			也已經體驗過了。{wait}
		}
		TextWait
		TextTalk self {
			……雖然險些被
			工作人員趕走。{wait}
		}
		TextWait
		FlagSet flag[0]
	else:
		TextTalk self {
			『踢咪西』是
			只屬於孩子的特權。{wait}
		}
		TextWait
		TextTalk self {
			不過，我真是相當滿足，
			已經徹底沒有遺憾了啊。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[8]:
	TextStart self
	TextTalk self {
		雖然在主題樂園玩過了……
		但最後也沒有去成珠寶店。{wait}
	}
	TextWait
	TextTalk self {
		嗚嗚，好遺憾啊……{wait}
	}
	TextWait
	TextEnd self
	Return

fn[9]:
	TextStart self
	TextTalk self {
		媽媽……
		水上巴士要開走了，
		快點去乘坐吧。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[10]:
	TextStart self
	TextTalk self {
		哎呀，今天真開心！{wait}
	}
	TextWait
	TextTalk self {
		克洛斯貝爾７０周年，萬歲！{wait}
	}
	TextWait
	TextEnd self
	Return

fn[11]:
	TextStart self
	TextTalk self {
		呵呵，還想再來呢。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[12]:
	ED7_F2 2
	FadeOut 300ms 0x00000000 100
	TextMessage name[742] {
		{color 5}設有可回復導力器的裝置。{color 0}{wait}
	}
	Menu menu[0] -1 -1 1
		"在此地休息" // 0
		"放棄" // 1
	MenuWait var[0]
	MenuClose menu[0]
	TextClose 0
	if var[0] == 0:
		FadeIn 100ms 0x00000000
		Sleep 500ms
		SoundLoad sound[13]
		ED7_74 object[7] 0 30
		SoundPlay sound[7] 0 100 0
		ObjFrame object[7] 0
		ED7ObjPlay object[7] 0 30 0 0
		ObjWait object[7]
		ED7ObjPlay object[7] 31 390 0 32
		Sleep 1000ms
		BgmStop 3000ms
		FadeOut 1000ms 0x00000000 255
		Sleep 700ms
		SoundPlay sound[13] 0 100 0
		FadeWait
		PartySetAttr name[255] 254 0
		CamLookChar field_party[0] 0ms
		ED7_31 1
		Sleep 3500ms
		ObjFrame object[7] 0
		BgmResume
		FadeIn 1000ms 0x00000000
		TextClose 0
		TextEnd null
		Return
	elif var[0] != 0:
		FadeIn 300ms 0x00000000
		TextEnd null
		Return
	Return
	Return

