		}
		TextWait
		TextTalk char[8] {
			#11P歡迎來到
			珠寶店『亮飾』。{wait}
		}
		TextWait
		TextTalk char[8] {
			#11P……不好意思，這位客人。
			請問您持有的是
			誰的介紹信？{wait}
		}
		TextWait
		if !flag[1353]:
			TextTalk name[1] {
				#0105F#6P那個……
				必須要持有介紹信嗎？{wait}
			}
			TextWait
		else:
			TextTalk name[1] {
				#5305F#6P那個……
				必須要持有介紹信嗎？{wait}
			}
			TextWait
		TextTalk char[8] {
			#11P正是。{wait}
		}
		TextWait
		TextTalk char[8] {
			#11P本店實行會員制，
			非會員謝絕入內。{wait}
		}
		TextWait
		TextTalk char[8] {
			#11P那麼，很抱歉……{wait}
		}
		TextWait
		CharTurnTo char[8] 0deg 500deg/s
