			想必也很手忙腳亂吧。{wait}
		} {
			#10401001V#0001F接下來，雙方才終於確信
			此次暗算是對方下的手了。
			然後事態便發展至如今的狀況──大概就是這樣了。{wait}
		}
		TextWait
	else:
		TextTalk name[0] {
			#10401002V#5P#0003F嗯，所以兩起事件即使是在同一夜發生，
			雙方應該也無法立刻得知對方成員遇襲。{wait}
		} {
			#10401003V#0000F接下來，雙方才終於確信
			此次暗算是對方下的手了。
			然後事態便發展至如今的狀況──大概就是這樣了。{wait}
		}
		TextWait
	TextTalk name[3] {
		#10401004V#6P#0306F嗯……這樣一來，
		果然只能理解為，有第三勢力插手吧。{wait}
	} {
		#10401005V#0301F雙方成員都沒有
		事先統一過口徑，在此情況下，
		恐怕任何一方都沒有作案的可能吧。{wait}
	}
	TextWait
	TextTalk name[0] {
		#10401006V#5P#0000F嗯……以現階段的情報為基礎，
		暫時先把兩起案件都假設為
		是第三者所為吧。{wait}
	}
	TextWait
	TextTalk name[1] {
		#10401007V#12P#0104F是啊……
		不把握住每一點可能性的話，
		推理也就無法繼續進展了。{wait}
	} {
		#10401008V#0101F──那麼，關於那個第三者，
		我們應該已經可以想到那個名字了吧。{wait}
	}
	TextWait
	TextTalk name[0] {
		#10401009V#5P#0003F是啊。{wait}
	} {
		#10401010V#0001F『魯巴徹商會』，
		他們是掌控著克洛斯貝爾
		黑道勢力的黑手黨。{wait}
	} {
		#10401011V根據格蕾絲小姐的情報，
		大約在半個月之前，曾有人在
		舊市街目擊到了他們的成員。{wait}
	} {
		#10401012V#0006F我們現在並沒有時間去
		確認這個情報的真假，不過……{wait}
	} {
		#10401013V#0001F暫且就先假定這兩起傷害
		事件都是『魯巴徹』所為，然後
		以這個假設為前提繼續推理下去吧。{wait}
	}
	TextWait
	TextTalk name[2] {
		#10401014V#6P#0203F……這樣一來……{wait}
	} {
		#10401015V#0201F接下來的問題果然就是『動機』了吧。{wait}
	}
	TextWait
	TextTalk name[0] {
		#10401016V#5P#0003F嗯，那正是關鍵問題。{wait}
	} {
		#10401017V#0001F……反過來說，
		如果不把這個問題弄清，
		推理說不定還會回到原點。{wait}
	}
	TextWait
	TextTalk name[3] {
		#10401018V#6P#0303F嗯～動機嘛……{wait}
	} {
		#10401019V#0308F黑手黨和兩個不良分子，
		這三方之間應該也扯不上什麼利害關係……{wait}
	}
	TextWait
	TextTalk name[1] {
		#10401020V#12P#0103F連接三『點』，
		應該就能結成一『線』……{wait}
	} {
		#10401021V#0100F──那個，羅伊德，
		你心裡應該已經大致有數了吧？{wait}
	}
	TextWait
	TextTalk name[0] {
		#10401022V#5P#0004F哈哈，雖然還不能
		完全確信吧……{wait}
	} {
		#10401023V#0000F連接三『點』，結成一『線』。
		這樣的話，應該考慮的是──{wait}
	}
	TextWait
	FadeOut 300ms 0x00000000 100
	FadeWait
	Menu menu[0] -1 -1 0
		"【瓦奇的經歷】" // 0
		"【瓦魯多的過去】" // 1
		"【黑月的存在】" // 2
	MenuWait var[0]
	MenuClose menu[0]
	FadeIn 300ms 0x00000000
	FadeWait
	switch var[0]:
		case 0:
			QuestBonusBp quest[62] 1
			global[6] += 1
			TextTalk name[0] {
				#10401024V#5P#0003F這也許是個比較荒謬的
				想法，不過……{wait}
			} {
				#10401025V#0001F兩年前出現在舊市街的
				瓦奇，有可能正是那條『線』。{wait}
			} {
				#10401026V比如說，他有可能是魯巴徹首領的
				兒子什麼的。{wait}
			}
			TextWait
			Emote name[1] 0mm 1700mm 2 7 80ms 1
			SoundPlay sound[28] 0 100 0
			Sleep 50ms
			Emote name[3] 0mm 1700mm 2 7 80ms 1
			SoundPlay sound[28] 0 100 0
			Sleep 50ms
			Emote name[2] 0mm 1700mm 2 7 80ms 1
			SoundPlay sound[28] 0 100 0
			Sleep 1000ms
			TextTalk name[1] {
				#10401027V#12P#0105F然、然後呢……！？{wait}
			}
			TextWait
			TextTalk name[3] {
				#10401028V#6P#0301F喂喂，這是真的嗎！？{wait}
			}
			TextWait
			TextTalk name[0] {
				#10401029V#5P#0006F可能性，只是可能性而已啦。{wait}
			} {
				#10401030V#0000F在這種情況下，首領為了
				將離家出走的兒子帶回去，
				就在舊市街設計了那兩起事件。{wait}
			} {
				#10401031V#0012F不過，假設到這個份上，
				與其說是推理，倒更像是在幻想了……{wait}
			}
			TextWait
			TextTalk name[3] {
				#10401032V#6P#0306F喂喂……{wait}
			}
			TextWait
			break
		case 1:
			TextTalk name[0] {
				#10401033V#5P#0003F雖然這僅僅是一種可能性……{wait}
			} {
				#10401034V#0001F也許那個瓦魯多過去
				曾經得罪過黑手黨中的
				某個成員。{wait}
			} {
				#10401035V於是招來怨恨與報復，
				從而引發了這次的事件……{wait}
			}
			TextWait
			TextTalk name[1] {
				#10401036V#12P#0106F嗯……
				這種情況確實也不能排除。{wait}
			}
			TextWait
			TextTalk name[3] {
				#10401037V#6P#0301F但是，就為了這種程度的小事，
				再怎麼說也不會如此大費周折吧？{wait}
			}
			TextWait
			TextTalk name[0] {
				#10401038V#5P#0006F……確實如此，果然是想錯了呢。{wait}
			}
			TextWait
			break
		case 2:
			QuestBonusBp quest[62] 3
			global[6] += 3
			TextTalk name[0] {
				#10401039V#5P#0003F說到可能性的話……
				比較實際的也就是『黑月』了。{wait}
			}
			TextWait
			TextTalk name[3] {
				#10401040V#6P#0305F哦哦，是那位大鬍子律師
				和我們說的那個組織嗎？{wait}
			}
			TextWait
			TextTalk name[1] {
				#10401041V#12P#0103F確實，在各種可能性之中，
				這個大概是最接近真相的……{wait}
			} {
				#10401042V#0101F不過，如果是這樣的話，
				要怎樣才能把事件連成一條線呢……？{wait}
			}
			TextWait
			TextTalk name[2] {
				#10401043V#6P#0203F如果想把各個點連接成一條線，
				就需要某種程度的『必然性』……{wait}
			} {
				#10401044V#0200F也就是說，『黑月』與
				黑手黨襲擊兩組不良分子這件事
				之間，存在著某些『必然性』的聯繫吧。{wait}
			}
			TextWait
			break
	if var[0] == 0 | var[0] == 1:
		Emote name[2] 0mm 1700mm 24 27 250ms 0
		Sleep 2000ms
		EmoteStop name[2]
		TextTalk name[2] {
			#10401045V#6P#0200F……那個，羅伊德前輩。{wait}
		} {
			#10402001V『黑月』才是那條線──難道就沒有
			這個可能性嗎……？{wait}
		}
		TextWait
