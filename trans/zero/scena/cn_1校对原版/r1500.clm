					} {
						#0000F哈哈，算了。
						……去跟釣公師團的分部長報告的話，
						他一定會很開心的。{wait}
					}
					TextWait
					FadeOut 1000ms 0x00000000 255
					FadeWait
					CharFlagsUnset field_party[1] 0x0008
					CharFlagsUnset field_party[2] 0x0008
					CharFlagsUnset field_party[3] 0x0008
					CharSetPos field_party[1] (52120, 900, -104140) 101deg
					CharSetPos field_party[2] (52120, 900, -104140) 101deg
					CharSetPos field_party[3] (52120, 900, -104140) 101deg
					CharSetPos field_party[4] (52120, 900, -104140) 101deg
					CharSetPos field_party[5] (52120, 900, -104140) 101deg
					CharSetChipBase field_party[0] chip[255]
					CharSetChipPattern field_party[0] 0
					CharFlagsUnset field_party[0] 0x0002
					NextFrame
					UnloadChip chip[40]
					ED7_37
					FlagSet flag[844]
	ED7_E0 2
	EventEnd 4
	Return

