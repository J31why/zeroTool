			}
			TextWait
			TextTalk self {
				嗯，請放心吧！{wait}
			}
			TextWait
			FlagSet flag[6]
		else:
			TextTalk self {
				辛苦了，
				我們這邊正在進行周邊排查。{wait}
			}
			TextWait
			TextTalk self {
				搜查二課也出動了，
				再有三個小時應該就能弄清楚了。{wait}
			}
			TextWait
	else:
