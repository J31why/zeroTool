	TextTalk self {
		感冒好像惡化了。{wait}
	}
	TextWait
	TextTalk self {
		咳咳……
		嗯～因為最近經常
		熬夜工作吧……{wait}
	}
	TextWait
	TextEnd self
	Return

fn[40]:
	TextStart self
	TextTalk self {
		我今天要陪公公
		去醫院。{wait}
	}
	TextWait
	TextTalk self {
		真是的……
		我明明和他說過，
		讓他早點去醫院的。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[41]:
	TextStart self
	TextTalk self {
		真讓人頭痛啊……
		探病時間是到五點半為止。{wait}
	}
	TextWait
	TextTalk self {
		這樣下去的話，
		剛到那裡就得直接回頭了。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[42]:
	TextStart self
	if flag[1792]:
		TextTalkNamed self "市民" {
			喂～巴士怎麼還沒個影啊～{wait}
		}
		TextWait
		TextTalkNamed self "市民" {
			這到底怎麼回事啊～！{wait}
		}
		TextWait
	elif flag[1569]:
		if system[10] == 9:
			TextTalk self {
				達德利搜查官，您辛苦了。{wait}
			}
			TextWait
			TextTalk self {
				自那以來，高層也是一言不發，
				我們很難把握情況……{wait}
			}
			TextWait
			TextTalk self {
				機場這邊的事情就交給我們吧，
				日落之前會解決好的。{wait}
			}
			TextWait
		else:
			TextTalk self {
				……機場現在
				被我們搜查一課封鎖了。{wait}
			}
			TextWait
			TextTalk self {
				特務支援課，你們不要多管閒事，
				拖我們後腿啊。{wait}
			}
			TextWait
	else:
		TextTalk self {
			這裡由我們
			搜查一課管轄。{wait}
		}
		TextWait
		TextTalk self {
			禁止擅自入內。{wait}
		}
		TextWait
		FlagSet flag[1694]
	TextEnd self
	Return

fn[43]:
	TextStart self
	if flag[1792]:
		if !flag[1]:
			TextTalk self {
				真是的，
				又要去向
				市政廳投訴了。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				真是的……
				今天還是別等了，直接回去吧。{wait}
			}
			TextWait
	else:
		TextTalk self {
			我們是要去
			探望一個朋友……{wait}
		}
		TextWait
		TextTalk self {
			到底發生什麼事了呢？{wait}
		}
		TextWait
	TextEnd self
	Return

fn[44]:
	TextStart self
