fn[2]:
	ED7_F2 1
	SystemFlagsSet 0x08000000
	if !flag[2119]:
		SoundPlay sound[14] 0 100 0
		ED7ObjPlay object[0] 0 30 0 0
		Sleep 500ms
		if ItemAdd item[88] 1:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextSetName ""
			TextMessage name[742] {
				{color 0}已取得{item[88]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			TextSetPos -1 280 60 3
			FadeIn 300ms 0x00000000
			FlagSet flag[2119]
			ED7_DE 6
		else:
			FadeOut 300ms 0x00000000 100
			TextSetName ""
			TextMessage name[742] {
				寶箱內裝著{item[88]}{color 0}。
				但因持有物品已滿而放棄{item[88]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			SoundPlay sound[15] 0 100 0
			ED7ObjPlay object[0] 30 0 0 0
	else:
		FadeOut 300ms 0x00000000 100
		TextSetPos -1 -1 -1 -1
		TextSetName ""
		TextMessage name[742] {
			{0x06}{color 5}寶箱內空無一物。{color 0}{wait}
		}
		TextWait
		TextClose 0
		FadeIn 300ms 0x00000000
	Sleep 30ms
	TextEnd null
	SystemFlagsUnset 0x08000000
	Return

fn[3]:
	EventBegin 0
	SystemFlagsSet 0x08000000
	CrossFade 1000ms
	CamSetDistance -44520 -26000 137730 0ms
	ED7CamRotate 40deg 23deg 0deg 0ms
	CamPers 400 0ms
	CamZoom 21520 0ms
	CharSetPos name[0] (-44800, -27000, 136500) 0deg
	CharSetPos name[1] (-43800, -27000, 136500) 0deg
	CharSetPos name[2] (-44300, -27000, 138000) 0deg
	CharSetPos name[3] (-44300, -27000, 135400) 0deg
	CharSetPos name[6] (-46400, -27000, 137300) 45deg
	CharSetPos name[7] (-46300, -27000, 136400) 45deg
	CharFlagsUnset field_party[4] 0x0080
	CharFlags2Unset field_party[4] 0x8000
	CharFlagsUnset field_party[5] 0x0080
	CharFlags2Unset field_party[5] 0x8000
	FadeWait
	if !flag[1956]:
		ED7ObjPlay object[2] 0 150 0 0
		SoundPlay sound[72] 0 100 0
		Sleep 2000ms
		SoundPlay sound[967] 0 100 0
		Sleep 900ms
		SoundPlay sound[967] 0 100 0
		Sleep 1400ms
		SoundPlay sound[967] 0 100 0
		ObjWait object[2]
		ED7ObjPlay object[2] 150 210 0 32
		Sleep 500ms
		FlagSet flag[1956]
	if !flag[1833]:
		TextTalk name[6] {
			#15300232V#6P#0800F啟動了……！{wait}
		}
		TextWait
		TextTalk name[2] {
			#15300233V#11P#0203F是數年前，由財團開發出的
			情報處理系統呢。{wait}
		} {
			#15300234V#0201F雖然現在已經屬於舊型號了，
			但當時應該是相當昂貴的東西。{wait}
		}
		TextWait
		TextTalk name[1] {
			#15300235V#0106F#12P採購這些東西所花銷的米拉，
			多半是由哈爾特曼議長提供的吧……{wait}
		}
		TextWait
		TextTalk name[0] {
			#15300236V#12P#0003F嗯……總有一天，也有必要
			徹底調查一下他那邊呢。{wait}
		} {
			#15300237V#0001F緹歐，還有別的發現嗎？{wait}
		}
		TextWait
		TextTalk name[2] {
			#15300238V#11P#0201F是的……{wait}
		}
		TextWait
		SoundPlay sound[849] 0 100 0
		Sleep 1000ms
		TextTalk name[2] {
			#15300239V#11P#0205F──操作這個終端似乎可以
			解除隔離壁的鎖，
			還可以閱覽情報。{wait}
		} {
			#15300240V#0206F不過，情報好像
			只剩下了一部分……{wait}
		}
		TextWait
		TextTalk name[0] {
			#15300241V#12P#0000F足夠了……
			趕快調查一下吧。{wait}
		}
		TextWait
		FlagSet flag[1833]
	var[0] = 0
	while var[0] != 255:
		FadeOut 300ms 0x00000000 100
		FadeWait
		TextSetPos -1 40 -1 -1
		TextSetName ""
		TextMessage null {
			{color 5}{0x06}{0x18}#1K情報終端０１{color 0}{wait}
		}
		Menu menu[0] -1 -1 0
			"【閱覽情報】" // 0
			"【解鎖】" // 1
			"【什麼都不做】" // 2
		MenuWait var[0]
		MenuClose menu[0]
		TextClose 0
		FadeIn 300ms 0x00000000
		FadeWait
		TextSetPos -1 280 60 3
		switch var[0]:
			case 0:
				FadeOut 300ms 0x00000000 100
				TextSetPos -1 -1 36 -1
				TextSetName ""
				TextMessage null {
					{color 2}#2S『關於教團』

					──我的名字是約亞西姆・瓊塔。
					隸屬於『Ｄ∴Ｇ教團』的幹部祭司。
					六年前，在眾多勢力與遊擊士共同聯手之下，
					我們的教團被毀滅了。
					但是，唯有我逃了出來，
					並來到了這片■■之地。
					在偉大的『■』的引導下，
					為了完成教團的偉業，我努力堅持了下來。
					那一刻終將到來──
					為了留下書寫新時代聖典所用的資料，
					我決定把這些資料保存在各個終端之上。{color 0}{wait}
				}
				TextWait
				TextClose 0
				TextSetName ""
				TextMessage null {
					{color 2}#2S首先，從我們教團的成立說起吧。
					關於這件事，有必要回顧一下
					塞姆利亞大陸那段駭人聽聞的歷史。
					──經歷了大約在一千兩百年前發生的
					『大崩壞』，大陸失去了高度的文明與秩序，
					迎來了被戰爭與貧困支配的『黑暗時代』。
					最終，精疲力盡的人們
					犯下了巨大的錯誤。
					被突然出現的愚蠢之人的花言巧語迷惑，
					接受了那些人創造的，
					毫無道理的秩序。{color 0}{wait}
				}
				TextWait
				TextClose 0
				TextSetName ""
				TextMessage null {
					{color 2}#2S即──愚蠢的■■■■
					與象徵著其信仰的『■之■■』。
					他們創造的秩序使『黑暗時代』終結，
					但這種信仰也散播到了大陸各處……
					可是，請仔細想一想。
					如果『■■』真的存在，
					每個人不是應該都能得到平等的救贖嗎？
					然而，差距這種概念並沒有消失，
					依然不斷有人因為災難與不幸而喪命。
					『■■』在賜予救贖時，難道是有選擇性的嗎？
					這未免也太過愚蠢可笑了吧。{color 0}{wait}
				}
				TextWait
				TextClose 0
				TextSetName ""
				TextMessage null {
					{color 2}#2S其實，那不過就是■■■■為了得到權勢，
					而人為創造出來的虛幻存在罷了。
					『■■』這種東西，是不可能存在的。
					我們那些終於尋得真理的前輩們，
					為了與『■■■■』相遇，踏上了漫長的旅途。
					時代不斷變遷，當中世紀來臨時，
					他們終於發現了……
					在這地底深處，■■■■■■■■■■
					■■■■■■■■■■■■■■■……
					『■』──便是其名字。{color 0}{wait}
				}
				TextWait
				TextClose 0
				FadeIn 300ms 0x00000000
				_59
				TextSetPos -1 280 60 3
				if !flag[1929]:
					TextTalk name[0] {
						#15300242V#0008F#11P這是……
						約亞西姆醫生留下的嗎？{wait}
					}
					TextWait
					TextTalk name[1] {
						#15300243V#0108F#12P好像留下了一些
						關於教團的概要……{wait}
					}
					TextWait
					TextTalk name[3] {
						#15300244V#0301F#12P但是有的地方無法閱讀。{wait}
					}
					TextWait
					TextTalk name[2] {
						#15300245V#0203F#5P恐怕是故意
						刪除掉的。{wait}
					} {
						#15300246V#0201F想恢復資料
						也許很困難。{wait}
					}
					TextWait
					TextTalk name[6] {
						#15300247V#0801F#6P不過，那些被刪除的部分，
						應該都是『七耀教會』或『空之女神#8R愛德斯#』之類的字眼吧？{wait}
					} {
						#15300248V#0806F好像是在堂堂正正地
						否定女神#4R愛德斯#的存在呢……{wait}
					}
					TextWait
					TextTalk name[7] {
						#15300249V#0903F#6P嗯，應該沒錯。{wait}
					} {
						#15300250V#0901F除此之外，敏感的詞語
						好像也被刪除了……{wait}
					}
					TextWait
					FlagSet flag[1929]
				break
			case 1:
				if !flag[1834]:
					TextSetName ""
					TextMessage null {
						{color 5}進行解鎖所需的操作。{wait}
					}
					TextWait
					TextClose 0
					_59
					FlagSet flag[1834]
					QuestTaskSet quest[79] 3
					Call fn[0,4]
					var[0] = 255
				elif flag[1835] && flag[1836]:
					TextSetName ""
					TextMessage null {
						{color 5}隔離壁已經打開了。{wait}
					}
					TextWait
					TextClose 0
					_59
				else:
					TextSetName ""
					TextMessage null {
						{color 5}對應的門鎖已經解除了。{wait}
					}
					TextWait
					TextClose 0
					_59
				break
			case 2:
				var[0] = 255
				break
			default:
				var[0] = 255
				break
	CharSetPos field_party[0] (-45000, -27000, 136400) 180deg
	CharFlagsSet field_party[4] 0x0080
	CharFlags2Set field_party[4] 0x8000
	CharFlagsSet field_party[5] 0x0080
	CharFlags2Set field_party[5] 0x8000
	SystemFlagsUnset 0x08000000
	EventEnd 5
	Return

