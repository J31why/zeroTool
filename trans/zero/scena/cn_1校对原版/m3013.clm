		SoundPlay sound[116] 0 100 0
		ObjFrame object[1] 90
		ObjFlagsUnset object[1] 0x0002
	elif var[2] == 2:
		ED7ObjPlay object[1] 10 20 0 0
		SoundPlay sound[140] 0 100 0
		ObjWait object[1]
		ObjFrame object[1] 20
		ObjFlagsSet object[1] 0x0002
	elif var[2] == 1:
		ED7ObjPlay object[1] 0 10 0 0
		SoundPlay sound[140] 0 100 0
		ObjWait object[1]
		ObjFrame object[1] 10
		ObjFlagsSet object[1] 0x0002
	else:
		ObjFrame object[1] 0
		ObjFlagsSet object[1] 0x0002
	Sleep 1000ms
	Return
