fn[5]:
	Call fn[0,6]
	Return

fn[6]:
	if flag[1049] && !flag[1050]:
		Call fn[0,24]
	elif QuestFlagsGet quest[3] 0x02 && !QuestTaskGet quest[3] 1 && !QuestFlagsGet quest[3] 0x40:
		_Char4A char[0] 255
		CharTurnToChar field_party[0] char[0] 0deg/s
		if !QuestTaskGet quest[3] 0:
			Call fn[0,26]
		else:
			Call fn[0,27]
	elif QuestTaskGet quest[3] 2 && QuestTaskGet quest[3] 5 && QuestTaskGet quest[3] 7 && !QuestFlagsGet quest[3] 0x10 && !QuestFlagsGet quest[3] 0x40:
		_Char4A char[0] 255
		CharTurnToChar field_party[0] char[0] 0deg/s
		Call fn[0,29]
	else:
		TextStart char[0]
		if flag[7]:
			if !flag[0]:
				TextTalk char[0] {
					今天實在是
					太感謝了。{wait}
				}
				TextWait
				TextTalk char[0] {
					特務支援課……嗎，
					據說是為了向市民提供服務
					而設立的部門……{wait}
				}
				TextWait
				TextTalk char[0] {
					不過，連我們都沾光受助了，
					真是十分感謝啊。{wait}
				}
				TextWait
				TextTalk name[0] {
					#0009F哈哈哈……
					（被這麼稱讚，還真是不好意思啊。）{wait}
				}
				TextWait
				TextTalk name[1] {
					#0100F如果以後再有什麼事情，
					請不用客氣，隨時提出委託哦。{wait}
				}
				TextWait
				FlagSet flag[0]
			else:
				TextTalk char[0] {
					今天實在是
					太感謝了。{wait}
				}
				TextWait
				TextTalk char[0] {
					特務支援課……嗎，
					據說是為了向市民提供服務
					而設立的部門……{wait}
				}
				TextWait
				TextTalk char[0] {
					不過，連我們都沾光受助了，
					真是十分感謝啊。{wait}
				}
				TextWait
		elif QuestTaskGet quest[3] 1 && !QuestFlagsGet quest[3] 0x10 && !QuestFlagsGet quest[3] 0x40:
			TextTalk char[0] {
				三處空房都確認完畢之後，
				就請來通知我吧。{wait}
			}
			TextWait
			TextTalk char[0] {
				文件的內容也許會有
				一些遺漏或錯誤之處，
				還請多加注意啊。{wait}
			}
			TextWait
		elif flag[1792]:
			if !flag[0]:
				TextTalk char[0] {
					自治州議會在不久前
					總算結束了。{wait}
				}
				TextWait
				TextTalk char[0] {
					這樣一來，財務課的各位
					也就可以安心回家了。{wait}
				}
				TextWait
				TextTalk char[0] {
					不過……市長今天似乎也像往常一樣，
					準備一直加班到深夜。{wait}
				}
				TextWait
				TextTalk char[0] {
					好像是急著把預算方面的文件整理完……
					真希望他不要太勉強自己啊。{wait}
				}
				TextWait
				FlagSet flag[0]
			else:
				TextTalk char[0] {
					市長今天似乎也像往日一樣，
					準備一直加班到深夜。{wait}
				}
				TextWait
				TextTalk char[0] {
					他真是位一絲不苟的人……
					好擔心他的身體呢。{wait}
				}
				TextWait
		elif flag[1566]:
			if !flag[0]:
				TextTalk char[0] {
					從今天早上開始，就不斷有人來詢問
					機場被封鎖的事情。{wait}
				}
				TextWait
				TextTalk char[0] {
					真是麻煩啊，因為警察局的人
					說過要暫時保密，穩定事態，
					所以我只能敷衍說是要臨時進行設備檢查……{wait}
				}
				TextWait
				TextTalk char[0] {
					這種理由到底能撐到什麼時候呢……{wait}
				}
				TextWait
				if !flag[1569]:
					Emote field_party[0] 0mm 2000mm 0 1 250ms 2
					SoundPlay sound[29] 0 100 0
					Emote field_party[1] 0mm 2000mm 0 1 250ms 2
					SoundPlay sound[29] 0 100 0
					Emote field_party[2] 0mm 2000mm 0 1 250ms 2
					SoundPlay sound[29] 0 100 0
					Emote field_party[3] 0mm 2000mm 0 1 250ms 2
					SoundPlay sound[29] 0 100 0
					Sleep 1000ms
					TextTalk name[0] {
						#0005F（機場那邊似乎是發生了什麼事啊。）{wait}
					}
					TextWait
				else:
					TextTalk name[2] {
						#0203F（對外公佈的官方消息
						　好像是『對設備進行臨時檢查』。）{wait}
					}
					TextWait
					TextTalk name[0] {
						#0001F（市政府這邊也很難辦呢。）{wait}
					}
					TextWait
				FlagSet flag[0]
			else:
				TextTalk char[0] {
					從今天早上開始，就不斷有人來詢問
					機場被封鎖的事情。{wait}
				}
				TextWait
				TextTalk char[0] {
					唉，這種敷衍的理由到底能撐到什麼時候呢……{wait}
				}
				TextWait
		elif flag[1554]:
			if !flag[0]:
				TextTalk char[0] {
					自治州議會今天好像也
					糾紛不斷呢。{wait}
				}
				TextWait
				TextTalk char[0] {
					呼……議員先生們那種難看的樣子，
					無論如何也不能被市民們看到啊。{wait}
				}
				TextWait
				TextTalk char[0] {
					大家的態度都十分惡劣，
					互相謾罵的場面此起彼伏。{wait}
				}
				TextWait
				Emote field_party[0] 0mm 2000mm 16 19 250ms 1
				SoundPlay sound[23] 0 100 0
				Emote field_party[1] 0mm 2000mm 16 19 250ms 1
				SoundPlay sound[23] 0 100 0
				Emote field_party[2] 0mm 2000mm 16 19 250ms 1
				SoundPlay sound[23] 0 100 0
				Emote field_party[3] 0mm 2000mm 16 19 250ms 1
				SoundPlay sound[23] 0 100 0
				Sleep 1000ms
				TextTalk name[3] {
					#0303F（……那種場面，確實是不想看見啊。）{wait}
				}
				TextWait
				TextTalk name[1] {
					#0108F（這就是議會的現實啊……）{wait}
				}
				TextWait
				FlagSet flag[0]
			else:
				TextTalk char[0] {
					自治州議會今天好像也
					糾紛不斷呢。{wait}
				}
				TextWait
				TextTalk char[0] {
					呼……議員先生們那種難看的樣子，
					無論如何也不能被市民們看到啊。{wait}
				}
				TextWait
		elif flag[1536]:
			if !flag[0]:
				TextTalk char[0] {
					這裡是克洛斯貝爾
					市政廳的接待處……{wait}
				}
				TextWait
				Emote char[0] 0mm 2000mm 38 38 250ms 1
				Sleep 1000ms
				if QuestFlagsGet quest[3] 0x10 | QuestFlagsGet quest[38] 0x10:
					TextTalk char[0] {
						啊，是各位啊。{wait}
					}
					TextWait
				else:
					TextTalk char[0] {
						啊，各位是……警察局的人吧。{wait}
					}
					TextWait
				TextTalk char[0] {
					呼，我還以為是來
