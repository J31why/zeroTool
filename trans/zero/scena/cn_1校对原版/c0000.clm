fn[56]:
	if !flag[525]:
		EventBegin 1
		TextTalk name[0] {
			#0000F這次的任務
			姑且也算是實戰測試……{wait}
		} {
			還是不要繞道了，
			快點去地下區域的
			深處看看吧。{wait}
		}
		TextWait
		if system[10] == 1:
			TextTalk name[1] {
				#0100F明白，專心執行任務吧。{wait}
			}
			TextWait
		elif system[10] == 2:
			TextTalk name[2] {
				#0200F說得也是。
				集中精神來執行任務吧。{wait}
			}
			TextWait
		elif system[10] == 3:
			TextTalk name[3] {
				#0300F嗯，就這麼辦吧。{wait}
			}
			TextWait
		Sleep 50ms
		CharSetPos field_party[0] (-13150, -5000, 17120) 270deg
		EventEnd 4
	Return

