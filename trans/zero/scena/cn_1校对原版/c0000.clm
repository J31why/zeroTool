fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharTurnTo self 180deg 500deg/s
		Sleep 300ms
		CharWalkToPos self (-1830, 0, -9000) 2000mm/s 0
		Sleep 300ms
		CharTurnTo self 0deg 500deg/s
		Sleep 300ms
		CharWalkToPos self (-1830, 0, 13000) 2000mm/s 0
		Sleep 300ms
	Return

fn[2]:
	while 1:
		CharWalkToPos self (-1830, 0, -23430) 2000mm/s 0
		Sleep 800ms
		CharSetPos self (-1830, 0, 25870) 180deg
	Return

