fn[0]:
	if flag[736]:
		FlagUnset flag[736]
		Event fn[0,3]
	elif flag[737]:
		FlagUnset flag[737]
		Event fn[0,6]
	Return

fn[1]:
	if !flag[2088]:
		ObjFrame object[1] 0
	else:
		ObjFrame object[1] 30
	Return

fn[2]:
	ED7_F2 1
	SystemFlagsSet 0x08000000
	if !flag[2088]:
		SoundPlay sound[14] 0 100 0
		ED7ObjPlay object[1] 0 30 0 0
		Sleep 500ms
		if ItemAdd item[507] 1:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextSetName ""
			TextMessage name[742] {
				{color 0}已取得{item[507]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			TextSetPos -1 280 60 3
			FadeIn 300ms 0x00000000
			FlagSet flag[2088]
			ED7_DE 6
		else:
			FadeOut 300ms 0x00000000 100
			TextSetName ""
			TextMessage name[742] {
				寶箱內裝著{item[507]}{color 0}。
				但因持有物品已滿而放棄{item[507]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			SoundPlay sound[15] 0 100 0
			ED7ObjPlay object[1] 30 0 0 0
	else:
		FadeOut 300ms 0x00000000 100
		TextSetPos -1 -1 -1 -1
		TextSetName ""
		TextMessage name[742] {
			{0x06}{color 5}寶箱內空無一物。{color 0}{wait}
		}
		TextWait
		TextClose 0
		FadeIn 300ms 0x00000000
	Sleep 30ms
	TextEnd null
	SystemFlagsUnset 0x08000000
	Return

