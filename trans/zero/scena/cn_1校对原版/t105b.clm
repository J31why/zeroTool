fn[8]:
	TextStart char[0]
	TextTalk char[0] {
		瓦奇先生帶來的客人們……
		要出門嗎？{wait}
	}
	TextWait
	TextTalk char[0] {
		如果準備享用晚餐的話，
		推薦去商店街裡面那家名為
		《幸運》的餐廳哦。{wait}
	}
	TextWait
	TextEnd char[0]
	Return

fn[9]:
	TextStart self
	TextTalk self {
		啊，瓦奇先生
		不知跑到哪裡去了……{wait}
	}
	TextWait
	TextTalk self {
		我還想再好好欣賞一下
		他那美麗的面孔呢㈱{wait}
	}
	TextWait
	TextEnd self
	Return

fn[10]:
	TextStart self
	TextTalk self {
		要申請
		客房服務嗎？{wait}
	}
	TextWait
	TextTalk self {
		請您稍等，
		稍後會為您送上
		葡萄酒與小吃。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[11]:
	TextStart self
	TextTalk self {
		呼……
		還好訂到房間了……{wait}
	}
	TextWait
	TextTalk self {
		哎呀，一直堅持下來，
		等待別人取消預訂，
		總算是有回報了。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[12]:
