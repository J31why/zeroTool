fn[7]:
	if system[0] == 104:
		CharSetPos field_party[0] (0, 0, 21840) 180deg
		CharSetPos field_party[1] (0, 0, 21840) 180deg
		CharSetPos field_party[2] (0, 0, 21840) 180deg
		CharSetPos field_party[3] (0, 0, 21840) 180deg
		if system[15] != 255:
			CharSetPos field_party[4] (0, 0, 21840) 180deg
			CharSetPos field_party[5] (0, 0, 21840) 180deg
		elif system[14] != 255:
			CharSetPos field_party[4] (0, 0, 21840) 180deg
		system[0] = 100
	global[7] = 9
	if flag[1291] && !flag[1292]:
		Event fn[0,27]
	elif flag[1298] && !flag[1300]:
		SystemFlagsSet 0x10000000
		Event fn[0,28]
	elif QuestFlagsGet quest[22] 0x10 && !flag[1281]:
		SystemFlagsSet 0x10000000
		Event fn[0,30]
	if flag[736]:
		FlagUnset flag[736]
	elif flag[737]:
		FlagUnset flag[737]
		Event fn[0,31]
	if flag[1307]:
		CharFlagsSet char[0] 0x0080
		CharFlagsUnset char[14] 0x0080
		CharFlagsUnset char[15] 0x0080
	elif flag[1294]:
		CharFlagsSet char[0] 0x0080
		CharFlagsUnset char[10] 0x0080
		CharFlagsUnset char[11] 0x0080
		CharFlagsSet char[10] 0x0010
		CharTurnTo char[10] 0deg 0deg/s
		CharSetPos char[11] (2650, 0, -2050) 0deg
	elif flag[1362]:
		CharFlagsUnset char[10] 0x0080
		CharFlagsUnset char[11] 0x0080
		CharFlagsSet char[10] 0x0010
		CharTurnTo char[10] 0deg 0deg/s
		CharSetPos char[11] (2650, 0, -2050) 0deg
		CharFlagsSet char[0] 0x0080
	elif flag[1292]:
		CharFlagsUnset char[10] 0x0080
		CharFlagsUnset char[11] 0x0080
		CharFlagsSet char[10] 0x0010
		CharFlagsSet char[11] 0x0010
	elif flag[1286]:
		CharFlagsUnset char[6] 0x0080
		CharFlagsUnset char[7] 0x0080
		CharFlagsSet char[6] 0x0010
		CharFlagsSet char[7] 0x0010
	elif flag[1282]:
		CharFlagsUnset char[4] 0x0080
		CharFlagsUnset char[5] 0x0080
	elif flag[1280]:
		CharFlagsUnset char[2] 0x0080
		CharFlagsUnset char[3] 0x0080
	if system[0] == 102 && flag[777] && !(flag[1286] && !flag[1292]):
		Sc_C4Unset 4096
	Return

fn[8]:
	if flag[1291] && !flag[1292]:
		system[1] = 102
	if flag[1307]:
	elif flag[1294]:
	LookPointFlagsSet look_point[0] 0x0001
	if flag[1294] && !flag[1307]:
		LookPointFlagsUnset look_point[0] 0x0001
		ObjFlagsUnset object[0] 0x0010
	TriggerFlagsSet trigger[0] 0x0080
	if flag[1280] && !flag[1294]:
		TriggerFlagsUnset trigger[0] 0x0080
	if flag[1294] && !flag[1307]:
		TriggerFlagsUnset trigger[0] 0x0080
	if flag[1307] && !flag[1342]:
		TriggerFlagsUnset trigger[0] 0x0080
	EntranceSetFunc entrance[3] fn[255,65535]
	if flag[1286] && !flag[1292]:
		EntranceSetFunc entrance[3] fn[0,35]
	if flag[1294] && !flag[1307]:
		EntranceSetFunc entrance[3] fn[0,35]
	EntranceSetFunc entrance[0] fn[255,65535]
	if flag[1294] && !flag[1486]:
		EntranceSetFunc entrance[0] fn[0,36]
	EffLoad eff[7] "event\\ev308_02.eff"
	EffPlay eff[7] eff_instance[255] null 0 (0, -4000, 15000) 0 0 0 1000 1000 1000 null (0, 0, 0) 0ms
	EffPlay eff[7] eff_instance[255] null 0 (0, -4000, -10000) 0 0 0 1000 1000 1000 null (0, 0, 0) 0ms
	Return

fn[9]:
	TextStart self
	if flag[1362]:
	elif flag[1292]:
		TextTalk self {
			明天又要去貝爾加德門
			送貨了。{wait}
		}
		TextWait
		TextTalk self {
			唉……那裡的貨
			總是多到
			需要用搬運車呢。{wait}
		}
		TextWait
		TextTalk self {
			……真麻煩啊……{wait}
		}
		TextWait
	elif flag[1286]:
		TextTalk self {
			呼，總算收到貨物了。{wait}
		}
		TextWait
		TextTalk self {
			……呃，都這麼晚了嗎！
			再不快點的話，就沒法準時送到了！{wait}
		}
		TextWait
	elif flag[1282]:
		TextTalk self {
			遊客的確是增加了不少，
			不過好在貨物量並沒有增加呢。{wait}
		}
		TextWait
		TextTalk self {
			只不過，領取貨物
			所需的時間變得更長了，
			真讓人頭痛啊……{wait}
		}
		TextWait
	elif flag[1280]:
		TextTalk self {
			唉……
			車站裡似乎很擁擠呢。{wait}
		}
		TextWait
		TextTalk self {
			這下領取貨物
			又要多花時間了啊……{wait}
		}
		TextWait
	TextEnd self
	Return

fn[10]:
	TextStart self
	if flag[1307]:
		TextTalk self {
			列車運行班次增加的時段
			已經到了最後一天了……{wait}
		}
		TextWait
		TextTalk self {
			幹完今天的活，
			就到那座橋上
			眺望列車往來吧……{wait}
		}
		TextWait
	elif flag[1294]:
		TextTalk self {
			你知道嗎？
			圖書館裡有本
			和鐵道有關的書。{wait}
		}
		TextWait
		TextTalk self {
			其實，那本書裡的某幾頁
			關於鐵道的專欄，是我寫的哦。{wait}
		}
		TextWait
		TextTalk self {
			我本來寫了三百頁呢，
			結果被刪減了好多。
			實在是遺憾啊。{wait}
		}
		TextWait
	elif flag[1362]:
		TextTalk self {
			像我這樣，
			覺得鐵道很有浪漫感覺的人
			一定不在少數。{wait}
		}
		TextWait
		TextTalk self {
			然而，在克洛斯貝爾
			很難碰到
			志趣相投的人啊。{wait}
		}
		TextWait
		TextTalk self {
			唉，哪天才能遇見
			可以一起暢所欲言的朋友呢……{wait}
		}
		TextWait
	elif flag[1292]:
		if !flag[1]:
			TextTalk self {
				像我這樣的鐵道迷，
				對列車的感情已經近乎於愛情了。{wait}
			}
			TextWait
			TextTalk self {
				甚至想給月臺上停靠的
				每一台列車都取上女性的名字，
				然後好好愛護它們啊。{wait}
			}
			TextWait
			TextTalk name[2] {
				#0200F……世界上真是
				什麼樣的人都有啊。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F（好像也可以理解……）{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				我給馳騁在大陸鐵道上的兩輛列車
				取了很好聽的名字哦。{wait}
			}
			TextWait
			TextTalk self {
				……哎，你們沒興趣聽？
				是嗎，好可惜……{wait}
			}
			TextWait
	elif flag[1286]:
		TextTalk self {
			在警備隊駐紮的兩座國境門那裡，
			設有專用的貨運專線。{wait}
		}
		TextWait
		TextTalk self {
			據說，警備隊員和警界相關人士
			只要遞交申請書就能乘坐呢……
			真是羨慕啊！{wait}
		}
		TextWait
	elif flag[1282]:
		if !flag[1]:
			TextTalk self {
				大陸鐵道公司舉辦過
				『集印章拉力賽』這樣的活動哦。{wait}
			}
			TextWait
			TextTalk self {
				就是在專用的紙上
				收集設置在特定車站的印章，
				是兼具娛樂性的旅遊活動哦。{wait}
			}
			TextWait
			TextTalk self {
				嗯～不愧是鐵道公司，
				懂得怎麼撩動愛好者的心呢。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				我也很想參加
				集印章拉力賽呢。{wait}
			}
			TextWait
			TextTalk self {
				一邊玩遊戲，一邊享受旅行的樂趣，
				真是太棒啦！{wait}
			}
			TextWait
	elif flag[1280]:
		if !flag[1]:
			TextTalk self {
				因為來了大批遊客，
				列車可是大顯身手了啊。{wait}
			}
			TextWait
			TextTalk self {
				而且，聽說今年的
				乘客數遠超往年……{wait}
			}
			TextWait
			TextTalk self {
				在這段時期內，竟然要特別
				增加列車運行班次哦！{wait}
			}
			TextWait
			TextTalk self {
				嗯～對鐵道迷來說，
				沒有比這更開心的事了！{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				增加運行班次，
				就等於增加了觀賞
				列車馳騁英姿的機會。{wait}
			}
			TextWait
			TextTalk self {
				嗯～對鐵道迷來說，
				沒有比這更開心的事了！{wait}
			}
			TextWait
	TextEnd self
	Return

fn[11]:
	TextStart self
	TextTalk self {
		呀，你們是克洛斯貝爾市的人？{wait}
	}
	TextWait
	TextTalk self {
		如果可以的話，
		請推薦一些觀光點給我吧！{wait}
	}
	TextWait
	TextEnd self
	Return

fn[12]:
	TextStart self
	TextTalk self {
		那邊是中央廣場吧。{wait}
	}
	TextWait
	TextTalk self {
		難得的慶典，
		一定要去熱鬧的地方才行呢！{wait}
	}
	TextWait
	TextEnd self
	Return

fn[13]:
