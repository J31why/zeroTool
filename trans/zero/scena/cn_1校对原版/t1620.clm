calmare zero_k scena
scena:
	name "t1620" "t1620" "t1620"
	town town[85]
	bgm bgm[123]
	flags 8192
	item_use fn[0,255]
	unk 255 0

entry:
	pos (0, 0, -1000)
	unk1 0
	cam_from (0, 0, 34000)
	cam_pers 262
	unk2 30
	cam_deg 45deg
	cam_limit 0deg 360deg
	cam_at (0, 0, 0)
	unk3 0
	unk4 0
	flags 0x0001
	town town[85]
	init fn[0,1]
	reinit fn[0,2]

chip[0] "chr/ch29400.itc"
chip[1] "chr/ch29200.itc"

