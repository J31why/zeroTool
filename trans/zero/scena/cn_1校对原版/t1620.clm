	unk3 0
	unk4 0

fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if system[0] == 114 && QuestTaskGet quest[40] 8 && !QuestTaskGet quest[40] 9:
		Event fn[0,3]
	Return

fn[2]:
	if flag[1564] && !flag[1566]:
		MapColor 0x00C8D2FF 0ms
	EntranceSetFunc entrance[14] fn[0,17]
	Return

fn[3]:
	EventBegin 0
	FadeOut 0ms 0x00000000 255
	CamSetDistance 250 1000 52660 0ms
	ED7CamRotate 45deg 28deg 0deg 0ms
	CamPers 440 0ms
	CamZoom 20000 0ms
	CharSetPos name[0] (0, 0, 52500) 0deg
	CharSetPos name[1] (1200, 0, 52500) 0deg
	CharSetPos name[2] (0, 0, 51300) 0deg
	CharSetPos name[3] (1200, 0, 51300) 0deg
	if PartyPosition name[8] > -1:
		CharSetPos name[8] (-1200, 0, 51900) 0deg
		CharFlagsUnset field_party[4] 0x0080
		CharFlags2Unset field_party[4] 0x8000
	elif PartyPosition name[9] > -1:
		CharSetPos name[9] (-1200, 0, 51900) 0deg
		CharFlagsUnset field_party[4] 0x0080
		CharFlags2Unset field_party[4] 0x8000
	FadeIn 500ms 0x00000000
	FadeWait
	TextTalk name[0] {
		#12P#0000F這裡就是資料室嗎……{wait}
	} {
		芙蘿拉小姐好像是
		不小心將逾期未還的書籍
		放到這裡的書架上了啊。{wait}
	}
	TextWait
	CamSetDistance 2900 1000 60120 4000ms
	ED7CamRotate 45deg 19deg 0deg 4000ms
	CamPers 440 4000ms
	CamZoom 28640 4000ms
	CamWait 121
	CrossFade 500ms
	CamSetDistance 250 1000 52660 0ms
	ED7CamRotate 45deg 28deg 0deg 0ms
	CamPers 440 0ms
	CamZoom 20000 0ms
	FadeWait
	Emote name[0] 0mm 2000mm 16 19 250ms 1
	SoundPlay sound[23] 0 100 0
	Emote name[1] 0mm 2000mm 16 19 250ms 1
	SoundPlay sound[23] 0 100 0
	Emote name[3] 0mm 2000mm 16 19 250ms 1
	SoundPlay sound[23] 0 100 0
	Emote name[2] 0mm 2000mm 16 19 250ms 1
	SoundPlay sound[23] 0 100 0
	if PartyPosition name[8] > -1:
		Emote name[8] 0mm 2000mm 16 19 250ms 1
		SoundPlay sound[23] 0 100 0
	Sleep 1000ms
	TextTalk name[0] {
		#12P#0006F嗯，嗯……
		這麼一看，數量還真是不少。{wait}
	}
	TextWait
	TextTalk name[1] {
		#12P#0106F是啊……
		確實是個累人的差事呢。{wait}
	}
	TextWait
	TextTalk name[2] {
		#12P#0200F真麻煩。{wait}
	}
	TextWait
	TextTalk name[3] {
		#12P#0300F算了，現在只有一本不漏地
		仔細調查了。{wait}
	}
	TextWait
	TextTalk name[0] {
		#12P#0000F是啊……
		雖然很辛苦，但還是耐心一點，
		認真找找看吧。{wait}
	}
	TextWait
	if PartyPosition name[8] > -1:
		TextTalk name[8] {
			#6P#0501F我也來幫忙吧！{wait}
		}
		TextWait
	elif PartyPosition name[9] > -1:
		TextTalk name[9] {
			#6P#0603F………………………………{wait}
		}
		TextWait
	if PartyPosition name[8] > -1 | PartyPosition name[9] > -1:
		CharFlagsSet field_party[4] 0x0080
		CharFlags2Set field_party[4] 0x8000
	CharSetPos field_party[0] (0, 0, 52500) 0deg
	QuestTaskSet quest[40] 9
	EventEnd 5
	Return

fn[4]:
	TextStart null
	FadeOut 300ms 0x00000000 100
	TextSetPos -1 -1 -1 -1
	TextSetName ""
	SoundPlay sound[17] 0 100 0
	TextMessage null {
		獲得了{item[728]}{color 0}。{wait}
	}
	TextWait
	TextClose 0
	FadeIn 300ms 0x00000000
	TextSetPos -1 280 60 3
	_59
	ItemAdd item[728] 1
	EventBegin 0
	CrossFade 500ms
	CamSetDistance 4520 1000 62040 0ms
	ED7CamRotate 54deg 30deg 0deg 0ms
	CamPers 440 0ms
	CamZoom 19850 0ms
	CharSetPos name[0] (4140, 0, 61890) 90deg
	CharSetPos name[1] (3110, 0, 62550) 90deg
	CharSetPos name[2] (2910, 0, 60910) 45deg
	CharSetPos name[3] (4100, 0, 63510) 135deg
	if PartyPosition name[8] > -1:
		CharSetPos name[8] (4030, 0, 60190) 0deg
		CharFlagsUnset field_party[4] 0x0080
		CharFlags2Unset field_party[4] 0x8000
	elif PartyPosition name[9] > -1:
		CharSetPos name[9] (4030, 0, 60190) 0deg
		CharFlagsUnset field_party[4] 0x0080
		CharFlags2Unset field_party[4] 0x8000
	FadeWait
	TextTalk name[0] {
		#5P#0005F啊，難道這本就是……！{wait}
	} {
		#0000F嗯，蓋有圖書館的印章。
		沒錯，應該就是芙蘿拉小姐
		從圖書館借的書了。{wait}
	}
	TextWait
	if PartyPosition name[8] > -1:
		TextTalk name[8] {
			#12P#0500F太好了，各位！{wait}
		}
		TextWait
	if var[4] >= 10:
		TextTalk name[1] {
			#6P#0106F終、終於找到了啊……{wait}
		}
		TextWait
		TextTalk name[2] {
			#12P#0211F……我都快要
			厭惡書架這種東西了。{wait}
		}
		TextWait
	elif var[4] >= 4:
		TextTalk name[1] {
			#6P#0100F總算找到了，
			太好了。{wait}
		}
		TextWait
		TextTalk name[2] {
			#12P#0206F……我都有點累了。{wait}
		}
		TextWait
	else:
		TextTalk name[1] {
			#6P#0100F這麼快就能找到，
			真幸運啊。{wait}
		}
		TextWait
		TextTalk name[2] {
			#12P#0203F不用展開地毯式搜索，
			實在是萬幸呢。{wait}
		}
		TextWait
	TextTalk name[3] {
		#5P#0300F不管怎麼說，
		總算是找到了啊。{wait}
	}
	TextWait
	CharTurnTo name[0] 270deg 500deg/s
	TextTalk name[0] {
		#0000F嗯，
		我們也差不多該離開這裡啦。{wait}
	}
	TextWait
	if PartyPosition name[9] > -1:
		TextTalk name[9] {
			#12P#0606F（真是的，竟然在這種地方
			　浪費時間……）{wait}
		}
		TextWait
	QuestTaskSet quest[40] 10
	if QuestTaskGet quest[40] 5 && QuestTaskGet quest[40] 7 && QuestTaskGet quest[40] 10:
		QuestTaskSet quest[40] 31
	FadeIn 500ms 0x00000000
	FadeWait
	if PartyPosition name[8] > -1 | PartyPosition name[9] > -1:
		CharFlagsSet field_party[4] 0x0080
		CharFlags2Set field_party[4] 0x8000
	NewScene "scena/t1600.bin" 104 0 0
	Hcf
	Return

fn[5]:
	TextStart null
	if !flag[0]:
		TextSetName ""
		TextMessage null {
			{color 5}把書架上的書籍
			全部調查了一遍。{wait}
		} {
			……這個書架上
			好像沒有芙蘿拉
			逾期未還的書。{wait}
		}
		TextWait
		TextClose 0
		_59
		FlagSet flag[0]
		var[4] += 1
	else:
		TextSetName ""
		TextMessage null {
			{color 5}這個書架上沒有逾期未還的書。{wait}
		}
		TextWait
		TextClose 0
		_59
	TextEnd null
	Return

