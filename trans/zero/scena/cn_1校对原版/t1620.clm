fn[17]:
	EventBegin 1
	var[3] = 0
	ED7MenuNew menu[0]
	ED7MenuAdd menu[0] "【離開研究大樓】"
	FadeOut 300ms 0x00000000 100
	FadeWait
	ED7MenuAdd menu[0] "放棄"
	ED7MenuShow menu[0] 65535 65535 0
	MenuWait var[0]
	MenuClose menu[0]
	FadeIn 300ms 0x00000000
	FadeWait
	switch var[0]:
		case 0:
			var[3] = 1
			break
		case 1:
			if var[3] == 0:
				var[3] = 2
			else:
				var[3] = 0
			break
		case 2:
			var[3] = 2
			break
	switch var[3]:
		case 0:
			if flag[1554] && !flag[1563]:
				TextTalk name[0] {
					#0005F對了……不能保證
					約亞西姆醫生是否在研究區中，
					還是先去接待處確認一下吧。{wait}
				} {
					#0000F而且，那裡也不是無關人員
					可以隨意進去的地方。{wait}
				}
				TextWait
				CharSetPos field_party[0] (0, 0, 50500) 0deg
				EventEnd 4
				break
			else:
				FadeOut 1000ms 0x00000000 255
				FadeWait
				if flag[1349] && !flag[1350]:
					FlagSet flag[736]
					NewScene "scena/t1650.bin" 101 0 0
					Hcf
				elif flag[1563] && !flag[1564]:
					FlagSet flag[737]
					NewScene "scena/t1650.bin" 101 0 0
					Hcf
				else:
					EventEnd 5
					NewScene "scena/t1650.bin" 101 0 0
					Hcf
			break
		case 1:
			FadeOut 1000ms 0x00000000 255
			FadeWait
			EventEnd 5
			NewScene "scena/t1600.bin" 104 0 0
			Hcf
			break
		case 2:
			Sleep 50ms
			CharSetPos field_party[0] (0, 0, 50500) 0deg
			EventEnd 4
			break
	Return
