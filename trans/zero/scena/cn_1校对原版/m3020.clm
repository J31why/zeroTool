	CharFlagsSet name[2] 0x0008
	CharFlagsSet name[3] 0x0008
	CharFlagsSet name[6] 0x0008
	CharFlagsSet name[7] 0x0008
	CamSetDistance 6500 0 -6000 7000ms
	ED7CamRotate 20deg 19deg 0deg 7000ms
	CamZoom 23000 7000ms
	FadeIn 2000ms 0x00000000
	FadeWait
	CamWait 121
	CrossFade 500ms
	Fog 0xFF4636B1 15 50 0
	CamSetDistance 1800 600 1000 0ms
	ED7CamRotate 40deg 23deg 0deg 0ms
	CamPers 500 0ms
	CamZoom 20500 0ms
	CharFlagsUnset name[0] 0x0008
	CharFlagsUnset name[1] 0x0008
	CharFlagsUnset name[2] 0x0008
	CharFlagsUnset name[3] 0x0008
	CharFlagsUnset name[6] 0x0008
	CharFlagsUnset name[7] 0x0008
	FadeWait
	TextTalk name[0] {
		#15300267V#6P#0010F這是……！？{wait}
	}
	TextWait
	TextTalk name[1] {
		#15300268V#6P#0108F難、難道是血池……！？{wait}
	}
	TextWait
	TextTalk name[3] {
		#15300269V#6P#0303F不，這味道聞起來並不像血。{wait}
	} {
		#15300270V#0301F看樣子，是很古怪的液體……{wait}
	}
	TextWait
	TextTalk name[7] {
		#15300271V#0908F……也許是某種裝置的
		排水道吧。{wait}
	} {
		#15300272V#0903F在這之上，好像正巧是
		大量製造『真知』
		的場所呢。{wait}
	}
	TextWait
	TextTalk name[2] {
		#15300273V#6P#0203F的確，顏色雖然不同，
		但是味道和那個藥很相似……{wait}
	} {
		#15300274V#0201F似乎並沒有很強的毒性，
		但最好還是不要接觸它。{wait}
	}
	TextWait
	Fork name[0] fork[2]:
		CharTurnToChar self name[2] 500deg/s
	Sleep 50ms
	Fork name[1] fork[2]:
		CharTurnToChar self name[2] 500deg/s
	Sleep 50ms
	Fork name[3] fork[2]:
		CharTurnToChar self name[2] 500deg/s
	Sleep 50ms
	Fork name[6] fork[2]:
		CharTurnTo self 180deg 500deg/s
	Sleep 50ms
	Fork name[7] fork[2]:
		CharTurnTo self 180deg 500deg/s
	Sleep 150ms
	TextTalk name[0] {
		#15300275V#11P#0001F知道了，
		看來要小心腳下啊。{wait}
	}
	TextWait
	TextTalk name[1] {
		#15300276V#11P#0106F是、是啊……
		這麼大的量，應該不可能是血……{wait}
	}
	TextWait
	TextTalk name[6] {
		#15300277V#5P#0806F但看上去如此相似，
		精神上還是有些難以承受呢……{wait}
	} {
		#15300278V#0801F不過事到如今，也只能毫不畏懼地繼續前進啦！{wait}
	}
	TextWait
	Fork name[0] fork[2]:
		CharTurnTo self 0deg 500deg/s
	Sleep 50ms
	Fork name[1] fork[2]:
		CharTurnTo self 0deg 500deg/s
	Sleep 50ms
	Fork name[2] fork[2]:
		CharTurnToChar self name[6] 500deg/s
	Sleep 50ms
	Fork name[3] fork[2]:
		CharTurnToChar self name[6] 500deg/s
	Sleep 150ms
	TextTalk name[0] {
		#15300279V#12P#0007F是啊……！{wait}
	}
	TextWait
	TextClose 0
	_59
	CharSetPos field_party[0] (-500, 0, 1000) 90deg
	CharFlagsSet field_party[4] 0x0080
	CharFlags2Set field_party[4] 0x8000
	CharFlagsSet field_party[5] 0x0080
	CharFlags2Set field_party[5] 0x8000
