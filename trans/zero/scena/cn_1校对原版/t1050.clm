			的確是有點
			可憐……{wait}
		}
		TextWait
	TextTalk name[1] {
		#12P#0100F呵呵，那就這麼定了。{wait}
	} {
		#0105F那麼……關於弄丟的地點，
		你有沒有頭緒呢。{wait}
	}
	TextWait
	TextTalk char[6] {
