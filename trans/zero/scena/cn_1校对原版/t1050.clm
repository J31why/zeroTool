fn[3]:
	if system[0] == 104 && flag[1317] && !flag[1360]:
		FlagSet flag[1360]
		ObjFlagsUnset object[2] 0x0010
		ObjFrame object[2] 10
		CharFlagsUnset self 0x0080
		CharFlags2Unset self 0x8000
		CharSetPos self (-100040, 0, 13630) 0deg
		_94 0 self 0deg 1500 2000mm/s 0
		CharColor self 0x00FFFFFF 500ms
		CharFlagsSet char[5] 0x0080
		CharFlags2Set char[5] 0x8000
		ED7ObjPlay object[2] 10 0 0 0
		SoundPlay sound[890] 0 100 0
		ObjWait object[2]
		ObjFlagsSet object[2] 0x0010
	Return

fn[4]:
	if system[0] == 107 && flag[1317] && !flag[1318]:
		Event fn[0,19]
	if flag[1333]:
	elif flag[1330]:
	elif flag[1329]:
	elif flag[1320]:
	elif flag[1319]:
	elif flag[1318]:
		CharSetPos char[1] (-93960, 0, 8260) 0deg
		ForkFunc char[1] fork[0] fn[0,1]
		CharSetPos char[2] (94190, 0, 11580) 0deg
		ForkFunc char[2] fork[0] fn[0,2]
	elif flag[1312]:
	elif flag[1307]:
	Return

fn[5]:
	LookPointFlagsSet look_point[2] 0x0001
	ObjFlagsSet object[2] 0x0010
	if flag[1312] && !flag[1317]:
		LookPointFlagsUnset look_point[2] 0x0001
		ObjFlagsUnset object[2] 0x0010
	if flag[1360]:
		ForkQuit char[5] fork[255]
		CharFlagsSet char[5] 0x0080
		CharFlags2Set char[5] 0x8000
	Return

fn[6]:
	ED7_F2 3
	TextStart null
	FadeOut 300ms 0x00000000 100
	Menu menu[0] -1 -1 1
		"在此地休息" // 0
		"放棄" // 1
	MenuWait var[0]
	MenuClose menu[0]
	TextClose 0
	if var[0] == 0:
		SoundLoad sound[13]
		BgmStop 3000ms
		FadeOut 1000ms 0x00000000 255
		Sleep 700ms
		SoundPlay sound[13] 0 100 0
		FadeWait
		PartySetAttr name[255] 254 0
		CamLookChar field_party[0] 0ms
		ED7_31 1
		Sleep 3500ms
		BgmResume
		FadeIn 1000ms 0x00000000
		TextClose 0
		TextEnd null
		Return
	elif var[0] != 0:
		FadeIn 300ms 0x00000000
		TextEnd null
		Return
	Return
	Return

fn[7]:
	Call fn[0,8]
	Return

fn[8]:
	if flag[1316] && !flag[1317]:
		Call fn[0,16]
	else:
		TextStart char[0]
		if flag[1333]:
		elif flag[1330]:
		elif flag[1329]:
		elif flag[1320]:
		elif flag[1319]:
		elif flag[1318]:
			if !flag[0]:
				CharTurnToChar char[0] name[80] 0deg/s
				TextTalk char[0] {
					瓦奇先生，您要出門嗎？{wait}
				}
				TextWait
				TextTalk char[0] {
					那麼，在此期間，
					我來為您
					整理床鋪吧。{wait}
				}
				TextWait
				TextTalk name[80] {
					#5700F是啊，大概會出去一段時間……
					那就拜託你了。{wait}
				}
				TextWait
				TextTalk char[0] {
					明白了。{wait}
				}
				TextWait
				FlagSet flag[0]
			else:
				TextTalk char[0] {
					那麼，
					在您外出期間，我會幫您
					整理好床鋪的。{wait}
				}
				TextWait
				TextTalk char[0] {
					請您慢走。{wait}
				}
				TextWait
		elif flag[1317]:
			TextTalk char[0] {
				客人是瓦奇先生的朋友嗎？{wait}
			}
			TextWait
			TextTalk char[0] {
				從左邊那扇門進去，
				右手邊就是瓦奇先生的房間了。{wait}
			}
			TextWait
		elif flag[1312]:
			if !flag[0]:
				TextTalk char[0] {
					歡迎，
					歡迎光臨翠雀飯店。{wait}
				}
				TextWait
				TextTalk char[0] {
					今天在本店住宿的
					客人實在不少。{wait}
				}
				TextWait
				TextTalk char[0] {
					在本店住宿的客人們
					似乎都出門
					觀光遊玩了。{wait}
				}
				TextWait
				FlagSet flag[0]
			else:
				TextTalk char[0] {
					今天在本店住宿的
					客人實在不少。{wait}
				}
				TextWait
				TextTalk char[0] {
					在本店住宿的客人們
					似乎都出門
					觀光遊玩了。{wait}
				}
				TextWait
		elif flag[1307]:
		TextEnd char[0]
	Return

fn[9]:
	TextStart self
	if flag[1333]:
	elif flag[1330]:
	elif flag[1329]:
	elif flag[1320]:
	elif flag[1319]:
	elif flag[1318]:
		if !flag[1]:
			CharTurnToChar self name[80] 0deg/s
			TextTalk self {
				啊，客人…………
				………………{wait}
			}
			TextWait
			TextTalk name[80] {
				#5705F……嗯？找我有事嗎？{wait}
			}
			TextWait
			TextTalk self {
				（啊啊……果然
				　長得好漂亮啊……）{wait}
			}
			TextWait
			TextTalk name[80] {
				#5702F……呵呵，真是個奇怪的女孩。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				啊……您要出門嗎？{wait}
			}
			TextWait
			TextTalk self {
				路上請小心，
				呵呵……{wait}
			}
			TextWait
	elif flag[1317]:
		CharTurnToChar self char[2] 0deg/s
		_Char4A char[2] 255
		TextTalk self {
			呀～怎麼辦！
			看到臉了！{wait}
		}
		TextWait
		TextTalk char[2] {
			好啦，你冷靜點。{wait}
		}
		TextWait
		_Char4B char[2] 255
	elif flag[1312]:
		if !flag[1]:
			Call fn[0,11]
		else:
			TextTalk self {
				那位辦理完登記入住手續之後
				就馬上外出的客人……{wait}
			}
			TextWait
			TextTalk self {
				長得真是
				好可愛哦。{wait}
			}
			TextWait
	elif flag[1307]:
	TextEnd self
	Return

fn[10]:
	TextStart self
	if flag[1333]:
	elif flag[1330]:
	elif flag[1329]:
	elif flag[1320]:
	elif flag[1319]:
	elif flag[1318]:
		TextTalk self {
			要是有什麼問題，
			請不要客氣，儘管告訴我。{wait}
		}
		TextWait
		TextTalk self {
			我會誠心誠意為您服務的。{wait}
		}
		TextWait
	elif flag[1317]:
		TextTalk self {
			這孩子真是的，
			在客人面前也太不成體統了……{wait}
		}
		TextWait
	elif flag[1312]:
		if !flag[1]:
			Call fn[0,11]
		else:
			TextTalk self {
				我說你啊，要是有時間閒聊，
				還不趕快去打掃下走廊。{wait}
			}
			TextWait
	elif flag[1307]:
	TextEnd self
	Return

fn[11]:
	_Char4A char[1] 255
	_Char4A char[2] 255
	CharTurnToChar char[1] char[2] 0deg/s
	CharTurnToChar char[2] char[1] 0deg/s
	TextTalk char[1] {
		那個，你看見了嗎？
		剛才的客人……{wait}
	}
	TextWait
	TextTalk char[1] {
		雖然長得超級可愛，
		不過是男孩子吧？{wait}
	}
	TextWait
	TextTalk char[2] {
		你又～來了……
		別說這種話了，
		趕快打掃完吧。{wait}
	}
	TextWait
	TextTalk char[1] {
		啊～好在意……{wait}
	}
	TextWait
	_Char4B char[1] 255
	_Char4B char[2] 255
	FlagSet flag[1]
	Return

fn[12]:
	TextStart self
	if QuestFlagsGet quest[36] 0x10:
		if flag[3]:
			TextTalk self {
				這樣應該就能
				實行我那在煙火下求婚
				的計畫了。{wait}
			}
			TextWait
			TextTalk self {
				謝謝，真不知道
				該怎麼感謝你們才好。{wait}
			}
			TextWait
			TextTalk self {
				好吧……為了晚上能順利求婚，
				要開始做心理準備了。{wait}
			}
			TextWait
		elif flag[1318]:
			if !flag[2]:
				TextTalk self {
					好、好的……接下來
					就要準備去主題樂園了。{wait}
				}
				TextWait
				TextTalk self {
					雖說已經定好了計畫，
					但是真的能求婚成功嗎。
					我開始緊張起來了……{wait}
				}
				TextWait
				TextTalk self {
					不、不行……難得你們
					幫我找到了戒指。
					我可不能打退堂鼓啊。{wait}
				}
				TextWait
				TextTalk self {
					總而言之，
					多重複幾次
					腦內模擬訓練吧……{wait}
				}
				TextWait
				FlagSet flag[2]
			else:
				TextTalk self {
					請和我結婚吧！
					……嗯。{wait}
				}
				TextWait
				TextTalk self {
					我們結婚吧！
					……這個也不錯啊。{wait}
				}
				TextWait
				TextTalk self {
					跟我結婚吧混帳！
					……這個不行吧。{wait}
				}
				TextWait
		else:
			TextTalk self {
				好吧……為了晚上能順利求婚，
				要開始做心理準備了。{wait}
			}
			TextWait
			TextTalk self {
				我覺得，阿爾維娜是否會
				接受我的求婚……
				也就決定了我的生死……！{wait}
			}
			TextWait
			TextTalk name[0] {
				#0006F這話也太誇張了……{wait}
			}
			TextWait
	elif QuestTaskGet quest[36] 9:
		Call fn[0,27]
	elif QuestTaskGet quest[36] 7:
		TextTalk self {
			總、總而言之，你們！
			能不能去高級住宅區
			那邊幫我看看！？{wait}
		}
		TextWait
		TextTalk self {
			戒指說不定
			還在那個長椅
			附近呢……！{wait}
		}
		TextWait
	elif QuestTaskGet quest[36] 1 && !QuestTaskGet quest[36] 2:
		Call fn[0,26]
	elif QuestTaskGet quest[36] 3 && !QuestTaskGet quest[36] 4:
		Call fn[0,26]
	elif QuestTaskGet quest[36] 5 && !QuestTaskGet quest[36] 6:
		Call fn[0,26]
	elif QuestFlagsGet quest[36] 0x02:
		TextTalk self {
			我完全不記得
			將戒指丟在哪裡了。{wait}
		}
		TextWait
		TextTalk self {
			不過可以確定的是……
			我和阿爾維娜來到這邊以後，
			基本上到處都逛了一遍。{wait}
		}
		TextWait
		TextTalk self {
			總、總而言之……
			要是你們撿到了類似的東西，
			就都拿來給我看看吧。{wait}
		}
		TextWait
	else:
		Call fn[0,25]
	TextEnd self
	Return

fn[13]:
	TextStart self
	if QuestFlagsGet quest[36] 0x10:
		if flag[3]:
			TextTalk self {
				托馬好像很開心呢。{wait}
			}
			TextWait
			TextTalk self {
				是不是有什麼
				好事呢？{wait}
			}
			TextWait
		elif flag[1318]:
			TextTalk self {
				托馬好像打算
				在主題樂園做什麼。{wait}
			}
			TextWait
			TextTalk self {
				呵呵，他有什麼心事，都馬上會顯露在臉上，
				真是太容易看穿了。{wait}
			}
			TextWait
		else:
			TextTalk self {
				別人經常問我，
				為什麼會和托馬
				交往……{wait}
			}
			TextWait
			TextTalk self {
				你們不覺得托馬
				看起來就很搞笑嗎？
				那就是他的魅力啦。{wait}
			}
			TextWait
	elif QuestTaskGet quest[36] 7:
		TextTalk self {
			托馬真是的……
			今天一會消沉沮喪，一會又大喊大叫的，
			好像不太對勁呢。{wait}
		}
		TextWait
		TextTalk self {
			哎，算了。
			反正他自己也說沒什麼事。{wait}
		}
		TextWait
	else:
		TextTalk self {
			今晚我要和托馬兩個人
			去夜晚的主題樂園。{wait}
		}
		TextWait
		TextTalk self {
			聽說到時候會放很多煙火，
			可以度過一個非常浪漫的
			夜晚呢。{wait}
		}
		TextWait
		TextTalk self {
			呵呵，好期待哦。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[14]:
	TextStart self
	TextTalk self {
		太陽也西沉了，
		今天就和我太太回來休息了。{wait}
	}
	TextWait
	TextTalk self {
		在房間裡一邊欣賞主題樂園的煙火，
		一邊品嘗葡萄酒，也別有一番風致吧。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[15]:
