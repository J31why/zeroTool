fn[0]:
	var[0] = random % 100
	if var[0] > 75:
		Sleep 600ms
	elif var[0] > 50:
		Sleep 400ms
	elif var[0] > 25:
		Sleep 200ms
	while 1:
		CharSetChipPattern self 0
		Sleep 100ms
		CharSetChipPattern self 1
		Sleep 100ms
		CharSetChipPattern self 2
		Sleep 100ms
		CharSetChipPattern self 1
		Sleep 100ms
		CharSetChipPattern self 0
		Sleep 100ms
		CharSetChipPattern self 3
		Sleep 100ms
		CharSetChipPattern self 4
		Sleep 100ms
		CharSetChipPattern self 3
		Sleep 100ms
	Return

fn[1]:
	while 1:
		ED7CharAnimation self 1000ms 0 1 2 3 4 5
		Sleep 1ms
	Return

fn[2]:
	if global[2] == 12 && !flag[1312]:
		Event fn[0,14]
	if flag[736]:
		FlagUnset flag[736]
		Event fn[0,10]
	Return

fn[3]:
	if flag[1309] && !flag[1310]:
		Call fn[0,4]
	SoundPlay sound[479] 1 100 0
	Return

fn[4]:
	CharSetChipBase char[0] chip[5]
	CharSetChipPattern char[0] 0
	ForkFunc char[0] fork[0] fn[0,1]
	Return

fn[5]:
	if flag[1309] && !flag[1310]:
		Call fn[0,11]
	else:
		TextStart char[0]
		if !flag[0]:
			TextTalk char[0] {
				#3506F話說回來，那個老頭子
				只和我說過代理出席
				拍賣會這件事而已。{wait}
			} {
				#3500F要是知道有什麼
				主題樂園，我肯定
				一大早就會來克洛斯貝爾了～{wait}
			}
			TextWait
			Emote field_party[0] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Emote field_party[1] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Emote field_party[2] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Emote field_party[3] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Sleep 1000ms
			TextTalk name[0] {
				#0012F骨子裡就是個遊手好閒的公子哥呢……{wait}
			}
			TextWait
			TextTalk char[0] {
				#3504F唔，這說法真是沒禮貌啊。
				我只是忠於自己的欲望而已。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				#3510F等到靠岸之後，
				我馬上就去傳說中的
				那個主題樂園看看。{wait}
			}
			TextWait
		TextEnd char[0]
	Return

fn[6]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if !flag[1]:
		TextTalk self {
			哇～哇～這就是水上巴士啊！
			好快，好快～呀！{wait}
		}
		TextWait
		FlagSet flag[1]
		if !flag[1456]:
			FlagSet flag[1456]
			global[2] = global[2] + 1
	else:
		TextTalk self {
			還要多久才能到達米修拉姆呢～？{wait}
		}
		TextWait
	CharSetChipPattern self 0
	TextEnd self
	Return

fn[7]:
	field_party[0].5 = self.4
