fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if flag[736]:
		FlagUnset flag[736]
		Event fn[0,18]
	if flag[1333]:
	elif flag[1330]:
	elif flag[1329]:
	elif flag[1320]:
	elif flag[1319]:
	elif flag[1318]:
		CharFlagsUnset char[1] 0x0080
		CharFlagsUnset char[2] 0x0080
		CharFlagsUnset char[6] 0x0080
		CharFlagsUnset char[7] 0x0080
		CharFlagsUnset char[8] 0x0080
		CharFlagsUnset char[9] 0x0080
		CharFlagsUnset char[10] 0x0080
	elif flag[1312]:
		CharFlagsUnset char[0] 0x0080
		CharFlagsUnset char[3] 0x0080
		CharFlagsUnset char[4] 0x0080
		CharFlagsUnset char[5] 0x0080
	elif flag[1307]:
	Return

fn[2]:
	if flag[1318] && !flag[1342]:
		MapColor 0x00B4BEFF 0ms
		ED7_76_0 object[255] "t1000_sky" 1
		ED7_76_1 object[255] "t1000_sky_y" 1
		ObjFlagsSet object[0] 0x0004
	else:
		ED7_76_1 object[255] "t1000_sky" 1
		ED7_76_0 object[255] "t1000_sky_y" 1
	ED7_76_0 object[0] "light" 1
	EffLoad eff[8] "eff\\mgm03_02.eff"
	EffPlay eff[8] eff_instance[8] null 0 (-24490, -5900, -38830) 0 0 0 1000 1000 1000 null (0, 0, 0) 0ms
	ObjFlagsSet object[4] 0x0004
	ObjFlagsSet object[5] 0x0004
	ObjFlagsSet object[6] 0x0004
	if flag[1312] && !flag[1318]:
		ObjFlagsUnset object[4] 0x0004
		ObjFlagsUnset object[5] 0x0004
		ObjFlagsUnset object[6] 0x0004
	LookPointFlagsSet look_point[2] 0x0001
	if QuestFlagsGet quest[36] 0x02 && !QuestTaskGet quest[36] 1:
		EffLoad eff[0] "event\\eva00_00.eff"
		EffPlay eff[0] eff_instance[0] null 0 (-30180, -4000, -47980) 0 0 0 1000 1000 1000 null (0, 0, 0) 0ms
		LookPointFlagsUnset look_point[2] 0x0001
	SoundPlay sound[126] 1 80 0
	Return

fn[3]:
	TextStart self
	if flag[1318]:
		TextTalk self {
			前往往克洛斯貝爾市的水上巴士
			剛剛已經出發。{wait}
		}
		TextWait
		TextTalk self {
			下一班很快就將到達，
			需要乘坐的客人，請稍候片刻。{wait}
		}
		TextWait
	elif flag[1312]:
		TextTalk self {
			水上巴士之旅讓大家辛苦了。{wait}
		}
		TextWait
		TextTalk self {
			請在米修拉姆
			度過夢幻般的時刻。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[4]:
	TextStart self
	CharTurnToChar char[1] char[2] 0deg/s
	if !flag[0]:
		Call fn[0,6]
	else:
		TextTalk self {
			哈哈哈……
			我跟我太太說我出差去了，
			不必擔心啦。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[5]:
	TextStart self
	if !flag[0]:
		CharTurnToChar char[2] char[1] 0deg/s
		Call fn[0,6]
	else:
		TextTalk self {
			那個拍賣會，
			我以前就很有興趣了。{wait}
		}
		TextWait
		TextTalk self {
			呵呵……能有人帶我來，
			真是幸運啊。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[6]:
	_Char4A char[1] 255
	_Char4A char[2] 255
	TextTalk char[1] {
		今晚要在議長宅邸舉行宴會。{wait}
	}
	TextWait
	TextTalk char[1] {
		就讓我為你拍個
		美麗的飾品吧。{wait}
	}
	TextWait
	TextTalk char[2] {
		呵呵……真是個壞人。
		明明都有妻子了。{wait}
	}
	TextWait
	TextTalk char[1] {
		哈哈哈……
		不是說好今晚不提這個的嗎？{wait}
	}
	TextWait
	_Char4B char[1] 255
	_Char4B char[2] 255
	FlagSet flag[0]
	Return

fn[7]:
	TextStart self
	if !flag[1]:
		TextTalk self {
			剛才下船的那個大哥哥
			以超快的速度跑掉了。{wait}
		}
		TextWait
		TextTalk self {
			他那麼期待啊～
			我也要好好玩個痛快！{wait}
		}
		TextWait
		FlagSet flag[1]
	else:
		TextTalk self {
			今天爸爸也在……
			我要好好玩個痛快！{wait}
		}
		TextWait
	TextEnd self
	Return

fn[8]:
	TextStart self
	TextTalk self {
		好～快點前往
		主題樂園吧。{wait}
	}
	TextWait
	TextTalk self {
		任何遊樂設施，爸爸今天
		都會陪你玩哦！{wait}
	}
	TextWait
	TextEnd self
	Return

fn[9]:
	TextStart self
	TextTalk self {
		哎呀呀，老公你真是的，
		這麼愛逞強。{wait}
	}
	TextWait
	TextTalk self {
		呵呵，那我就不客氣地
		去坐驚險刺激的遊樂設施啦。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[10]:
	TextStart self
	if !flag[2]:
		TextTalk self {
			我打算逛完紀念慶典之後
			再來這裡，
			結果就拖到傍晚了。{wait}
		}
		TextWait
		TextTalk self {
			沒辦法，
			去時裝店那邊隨便看看，
			然後就早點回去吧。{wait}
		}
		TextWait
		TextTalk self {
			要是被捲入回程大潮，
			可就太糟糕了呢。{wait}
		}
		TextWait
		FlagSet flag[2]
	else:
		TextTalk self {
			我來得太遲了呢，
			大概玩不到什麼東西了……{wait}
		}
		TextWait
		TextTalk self {
			去時裝店那邊隨便看看，
			然後就早點回去吧。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[11]:
	TextStart self
	TextTalk char[7] {
		哈哈，真愉快，
		今天全家人一起玩了個痛快呢。{wait}
	}
	TextWait
	TextTalk char[7] {
		偶爾這樣放鬆一下，
		感覺也不錯啊。{wait}
	}
	TextWait
	TextEnd self
