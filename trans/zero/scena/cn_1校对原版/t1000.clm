fn[15]:
	TextStart self
	if !flag[1736]:
		TextTalk self {
			哎呀，羅伊德團員
			也來釣魚嗎？{wait}
		}
		TextWait
		TextTalk self {
			呵呵，你果然也還沒從
			釣魚大賽的熱情中冷卻下來啊。{wait}
		}
		TextWait
		TextTalk self {
			對了，你帶著釣餌嗎？{wait}
		}
		TextWait
		FadeOut 300ms 0x00000000 100
		TextSetPos -1 -1 -1 -1
		TextSetName ""
		SoundPlay sound[17] 0 100 0
		TextMessage null {
			獲得了５個{item[391]}{color 0}。{wait}
		}
		TextWait
		TextClose 0
		FadeIn 300ms 0x00000000
		TextSetPos -1 280 60 3
		_59
		ItemAdd item[391] 5
		TextTalk self {
			分給你一點好了，雖然不多。{wait}
		}
		TextWait
		TextTalk self {
			呵呵，羅伊德團員
			也請加油哦。{wait}
		}
		TextWait
		FlagSet flag[1736]
		if QuestTaskGet quest[36] 8:
			FlagSet flag[1737]
	elif !flag[1737] && QuestTaskGet quest[36] 8 && ItemHas item[391] 0 == 0 && !QuestFlagsGet quest[36] 0x10 && !QuestFlagsGet quest[36] 0x40:
		TextTalk self {
			哎呀，羅伊德團員。
			莫非是
			釣餌不夠了嗎？{wait}
		}
		TextWait
		FadeOut 300ms 0x00000000 100
		TextSetPos -1 -1 -1 -1
		TextSetName ""
		SoundPlay sound[17] 0 100 0
		TextMessage null {
			獲得了２個{item[391]}{color 0}。{wait}
		}
		TextWait
		TextClose 0
		FadeIn 300ms 0x00000000
		TextSetPos -1 280 60 3
		_59
		ItemAdd item[391] 2
		TextTalk self {
			分給你一點好了，雖然不多。{wait}
		}
		TextWait
		TextTalk self {
			呵呵，羅伊德團員也很有熱情呢。{wait}
		}
		TextWait
		FlagSet flag[1737]
	elif flag[1318]:
		TextTalk self {
			哎呀，水流的情況似乎
			改變了呢……{wait}
		}
		TextWait
		TextTalk self {
			很遺憾，今天
			就到此為止吧。{wait}
		}
		TextWait
	elif flag[1312]:
		if !flag[4]:
			TextTalk self {
				這位羅伊德大師
				說也想到對岸來
				釣魚呢。{wait}
			}
			TextWait
			TextTalk self {
				呵呵，不愧是特級釣師，
				判斷力就是不同呢。{wait}
			}
			TextWait
			TextTalk self {
				今天的釣魚成果
				真是太棒了。{wait}
			}
			TextWait
			FlagSet flag[4]
		else:
			TextTalk self {
				不愧是特級釣師，
				判斷力真是太出色了啊。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[16]:
	TextStart self
	if flag[1318]:
		TextTalk self {
			唔，今天也就這樣了吧……{wait}
		}
		TextWait
		TextTalk self {
			釣到了大口鱸魚這樣的大魚，
			就算不錯了吧。{wait}
		}
		TextWait
	elif flag[1312]:
		TextTalk self {
			紀念慶典結束以後，
			我就打算回利貝爾了。{wait}
		}
		TextWait
		TextTalk self {
			在克洛斯貝爾能夠
			體驗到的釣魚方式，
			可要全部嘗試一次才行呢。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[17]:
	EventBegin 1
	SoundPlay sound[1094] 255 100 0
	TextTalk name[0] {
		#0000F這裡的話似乎可以釣到魚。{wait}
	}
	TextWait
	CamSetDistance -23140 -2400 -43580 1500ms
	ED7CamRotate 315deg 36deg 0deg 1500ms
	CamPers 200 1500ms
	CamZoom 50000 1500ms
	Sleep 1000ms
	TextSetName ""
	TextMessage null {
		{color 5}要釣魚嗎？{color 0}{wait}
	}
	Menu menu[0] -1 -1 1
		"釣魚" // 0
		"放棄" // 1
	MenuWait var[0]
	MenuClose menu[0]
	TextClose 0
	_59
	CamWait 1
	if var[0] == 0:
		ED7_E0 2
		Minigame 6 3 -24500 -4000 -46830 0 -24490 -5900 -38830
	ED7_E0 2
	EventEnd 4
	Return

fn[18]:
	EventBegin 0
	Sc_DA
	FadeOut 0ms 0x00000000 255
	ED7LoadChip "chr/ch07400.itc" chip[30]
	ED7LoadChip "chr/ch07300.itc" chip[31]
