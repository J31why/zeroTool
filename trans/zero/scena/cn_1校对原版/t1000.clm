fn[13]:
	TextStart self
	if flag[3]:
		TextTalk char[9] {
			爸爸和媽媽……
			以後會不會再帶我來呢……{wait}
		}
		TextWait
	else:
		TextTalk char[9] {
			因為爸爸還有工作，
			所以今天必須回去。{wait}
		}
		TextWait
		TextTalk char[9] {
			……而且
			瑪麗也累了，
			桑妮塔今天就先回去吧。{wait}
		}
		TextWait
		FlagSet flag[3]
	TextEnd self
