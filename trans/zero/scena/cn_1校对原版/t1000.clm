	} {
		#13500319V#0006F該怎麼說呢，真是比想像中
		更加奢華的地方……{wait}
	}
	TextWait
	TextTalk name[2] {
		#13500320V#0203F#5P這裡原本是個高級遊憩區，
		由ＩＢＣ著手開發為度假村……{wait}
	} {
		#13500321V#0200F飯店和主題樂園好像
		也是在兩年前才剛建成的呢。{wait}
	}
	TextWait
	TextTalk name[1] {
		#13500322V#0104F#5P嗯，從那以後，這裡就成為了
		與彩虹劇團齊名的觀光勝地。{wait}
	} {
		#13500323V#0100F正面是飯店，
		一樓是商店街。{wait}
	} {
		#13500324V其中有餐廳、時裝店、
		珠寶店等等。{wait}
	}
	TextWait
	TextTalk name[3] {
		#13500325V#0306F#5P但價格全都高得離譜，
		平民很難承受就是了～{wait}
	} {
		#13500326V#0300F我以前約會的時候，
		也只去過主題樂園
		和餐廳……{wait}
	} {
		#13500327V那麼，接下來該怎麼辦？{wait}
	}
