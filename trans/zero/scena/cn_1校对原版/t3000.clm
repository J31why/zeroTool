fn[0]:
	while 1:
		ED7CharAnimation self 1500ms 0 1 2 3 4
	Return

fn[1]:
	while 1:
		ED7CharAnimation self 1250ms 0 1 2 3 4 5
	Return

fn[2]:
	if flag[804] && !flag[805]:
		SystemFlagsSet 0x10000000
		Event fn[0,15]
	if flag[1282] && !flag[1292] && !flag[1466]:
		SystemFlagsSet 0x10000000
		Event fn[0,16]
	Return

fn[3]:
	ObjFlagsUnset object[0] 0x0010
	ObjFlagsUnset object[1] 0x0010
	TriggerFlagsSet trigger[0] 0x0080
	LookPointFlagsSet look_point[2] 0x0001
	if flag[1566]:
	elif flag[1560]:
		if flag[1692]:
		elif QuestTaskGet quest[48] 5:
			TriggerFlagsUnset trigger[0] 0x0080
			LookPointFlagsSet look_point[1] 0x0001
			LookPointFlagsUnset look_point[2] 0x0001
		elif QuestTaskGet quest[48] 1:
	Return

