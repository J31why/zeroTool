fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharIdle self (36100, null, -37250) (30720, null, -40660) 1000mm/s
		Sleep 300ms
	Return

fn[2]:
	while 1:
		CharWalkToPos self (5840, 0, -6890) 5000mm/s 0
		CharWalkToPos self (13450, -1420, -18510) 5000mm/s 0
		CharWalkToPos self (21750, -2500, -24790) 5000mm/s 0
		CharWalkToPos self (21750, -6500, -38390) 5000mm/s 0
		CharWalkToPos self (7790, -6320, -37990) 5000mm/s 0
		CharWalkToPos self (-3730, -3830, -27600) 5000mm/s 0
		CharWalkToPos self (-12250, -3030, -23600) 5000mm/s 0
		CharWalkToPos self (-12250, 0, -12120) 5000mm/s 0
		CharWalkToPos self (-10970, 0, -11360) 5000mm/s 0
		CharWalkToPos self (-5510, 0, -7900) 5000mm/s 0
	Return

fn[3]:
	if system[0] == 107:
		CharSetPos field_party[0] (2050, 0, 14590) 180deg
		CharSetPos field_party[1] (2050, 0, 14590) 180deg
		CharSetPos field_party[2] (2050, 0, 14590) 180deg
		CharSetPos field_party[3] (2050, 0, 14590) 180deg
		if system[15] != 255:
			CharSetPos field_party[4] (2050, 0, 14590) 180deg
			CharSetPos field_party[5] (2050, 0, 14590) 180deg
		elif system[14] != 255:
			CharSetPos field_party[4] (2050, 0, 14590) 180deg
		CamSetDistance 2050 2000 14590 0ms
		ED7CamRotate 45deg 34deg 0deg 0ms
		CamPers 500 0ms
		CamZoom 24500 0ms
		system[0] = 100
	global[7] = 8
	if flag[736]:
		FlagUnset flag[736]
		Event fn[0,25]
	elif flag[737]:
		FlagUnset flag[737]
		Event fn[0,74]
	elif flag[738]:
		FlagUnset flag[738]
		Event fn[0,83]
	if flag[1307]:
		CharFlagsSet char[12] 0x0080
		CharFlagsSet char[13] 0x0080
		CharFlagsUnset char[5] 0x0080
		CharFlagsUnset char[7] 0x0080
		CharFlagsUnset char[8] 0x0080
		CharFlagsUnset char[6] 0x0080
		CharSetPos char[0] (4620, 0, -5320) 315deg
		CharSetPos char[7] (1100, 0, -1620) 135deg
		CharSetPos char[8] (-310, 50, -1500) 135deg
		CharSetPos char[6] (44880, -2500, -20090) 225deg
		CharTurnTo char[9] 225deg 0deg/s
		CharFlagsSet char[10] 0x0010
		CharFlagsUnset char[2] 0x0004
		CharFlagsUnset char[3] 0x0004
		CharSetPos char[2] (5840, 0, -6890) 135deg
		CharSetPos char[3] (4760, 0, -5890) 135deg
		ForkFunc char[2] fork[0] fn[0,2]
		ForkFunc char[3] fork[0] fn[0,2]
	elif flag[1362]:
		CharFlagsSet char[0] 0x0080
		CharFlagsSet char[12] 0x0080
		CharFlagsSet char[13] 0x0080
		CharSetPos char[2] (1810, 0, 4550) 315deg
		CharSetPos char[3] (610, 0, 5750) 135deg
		CharFlagsUnset char[9] 0x0010
	elif flag[1292]:
		CharFlagsSet char[0] 0x0080
		CharFlagsSet char[12] 0x0080
		CharFlagsSet char[13] 0x0080
		CharTurnToChar char[9] char[10] 0deg/s
		CharTurnToChar char[10] char[9] 0deg/s
		CharFlagsSet char[11] 0x0010
		CharFlagsSet char[2] 0x0010
		CharFlagsSet char[3] 0x0010
	elif flag[1282]:
		CharFlagsUnset char[7] 0x0080
		CharFlagsUnset char[8] 0x0080
		CharSetPos char[2] (4670, 0, -5500) 180deg
		CharSetPos char[3] (4710, 0, -7160) 0deg
		CharSetPos char[12] (43330, -2500, -20060) 90deg
		CharSetPos char[13] (42420, -2500, -19200) 135deg
		CharTurnTo char[0] 270deg 0deg/s
		CharTurnToChar char[11] char[10] 0deg/s
		CharFlagsSet char[11] 0x0010
		CharFlagsSet char[2] 0x0010
		CharFlagsSet char[3] 0x0010
		CharFlagsSet char[12] 0x0010
		CharFlagsSet char[13] 0x0010
		if !flag[1]:
			CharFlagsSet char[0] 0x0010
		if flag[2]:
			CharFlagsUnset char[7] 0x0010
			CharFlagsUnset char[8] 0x0010
		if !flag[3]:
			CharFlagsSet char[10] 0x0010
	elif flag[1281]:
		CharSetPos char[13] (-18810, 0, -10220) 315deg
		CharFlagsSet char[0] 0x0080
	else:
		CharFlagsUnset char[6] 0x0080
		CharSetPos char[2] (2740, 0, -770) 315deg
		CharSetPos char[3] (960, 0, 870) 135deg
		CharFlagsSet char[6] 0x0010
		CharFlagsSet char[2] 0x0010
		CharFlagsSet char[3] 0x0010
	Return

