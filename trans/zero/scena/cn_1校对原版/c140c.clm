fn[82]:
	while 1:
		ED7CharAnimation self 1500ms 0 1 2 3 4 3 2 1
		var[0] = random % 100
		if var[0] < 20:
			Sleep 50ms
		elif var[0] < 40:
			Sleep 150ms
		elif var[0] < 60:
			Sleep 200ms
		elif var[0] < 80:
			Sleep 300ms
		else:
			Sleep 400ms
		Sleep 50ms
	Return

