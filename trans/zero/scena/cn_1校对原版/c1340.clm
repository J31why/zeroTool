			TextTalk char[1] {
				#2903F真是的，父親不在的時候，
				竟然發生了這種荒唐至極的騷亂……{wait}
			} {
				#2910F『魯巴徹』的行為
				實在是讓人難以置信！{wait}
			}
			TextWait
		else:
			TextTalk char[1] {
				#2910F真是的，我已經受夠了……！
				居然做下這種蠢事！{wait}
			}
			TextWait
			TextTalk name[0] {
				#0005F瑪利亞貝爾小姐……{wait}
			}
			TextWait
			TextTalk name[1] {
				#0101F看樣子……
				你好像已經知道了啊？{wait}
			}
			TextWait
			TextTalk char[1] {
				#2901F那當然了……！
				事情就發生在我的眼皮底下啊！{wait}
			} {
				#2903F竟然在ＩＢＣ大樓的附近
