		if random % 2 == 0:
			FlagSet flag[986]
		if random % 2 == 0:
			FlagSet flag[987]
		if random % 2 == 0:
			FlagSet flag[988]
		if random % 10 == 0:
			FlagSet flag[989]
		if random % 20 == 0:
			FlagSet flag[990]
		if random % 100 == 0:
			FlagSet flag[991]
		FlagUnset flag[992]
		FlagUnset flag[993]
		FlagUnset flag[994]
		FlagUnset flag[995]
		FlagUnset flag[996]
		FlagUnset flag[997]
		FlagUnset flag[998]
		FlagUnset flag[999]
		var[2] = random % 8
		if var[2] == 0:
			FlagSet flag[992]
		elif var[2] == 1:
			FlagSet flag[993]
		elif var[2] == 2:
			FlagSet flag[994]
		elif var[2] == 3:
			FlagSet flag[995]
		elif var[2] == 4:
			FlagSet flag[996]
		elif var[2] == 5:
			FlagSet flag[997]
		elif var[2] == 6:
			FlagSet flag[998]
		elif var[2] == 7:
			FlagSet flag[999]
	Call fn[0,8]
	Return

