		ED7ObjPlay object[1] 0 30 0 0
		Sleep 500ms
		ObjFrame object[1] 30
		SoundPlay sound[17] 0 100 0
		TextSetPos -1 -1 -1 -1
		SepithAdd 0 40
		SepithAdd 1 40
		SepithAdd 2 40
		SepithAdd 3 40
		SepithAdd 4 40
		SepithAdd 5 40
		SepithAdd 6 40
		TextMessage null {
			獲得了{color 2}#56I地之耀晶石×４０{color 0}
			{color 2}#57I水之耀晶石×４０{color 0}
			{color 2}#58I火之耀晶石×４０{color 0}
			{color 2}#59I風之耀晶石×４０{color 0}
			{color 2}#60I時之耀晶石×４０{color 0}
			{color 2}#61I空之耀晶石×４０{color 0}
			{color 2}#62I幻之耀晶石×４０{color 0}。{wait}
		}
		TextWait
		TextClose 0
		TextSetPos -1 280 60 3
