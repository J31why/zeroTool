fn[3]:
	if system[0] != 100 && system[0] != 101 && system[0] != 102 && system[0] != 103:
		ObjFlagsSet object[6] 0x0004
	else:
		ObjFlagsUnset object[6] 0x0004
	Return

fn[4]:
	SystemFlagsSet 0x08000000
	if !flag[2278]:
		SoundPlay sound[14] 0 100 0
		ED7ObjPlay object[5] 0 30 0 0
		Sleep 500ms
		if !flag[942]:
			CharColor char[0] 0x00FFFFFF 0ms
			CharTurnToChar char[0] field_party[0] 0deg/s
			_Char91 char[0] 0 1000 0 0 0
			Fork char[0] fork[1]:
				_Char91 self 0 -1000 0 1000 0
			Fork char[0] fork[2]:
				CharColor self 0xFFFFFFFF 1000ms
			CharFlagsUnset char[0] 0x0080
			CharFlagsSet char[0] 0x8000
			TextMessage name[742] {
				{color 5}魔獸出現了！{color 0}{wait}
			}
			TextWait
			TextClose 0
			ForkWait char[0] fork[1]
			ED7Battle battle[4] null 0 0 0 null
			CharFlagsSet char[0] 0x0080
			CharFlagsUnset char[0] 0x8000
			switch system[3]:
				case 0:
					FlagSet flag[942]
					ObjFrame object[5] 30
					Sleep 500ms
					break
				case 2:
					ObjFrame object[5] 0
					TextEnd null
					SystemFlagsUnset 0x08000000
					Return
				case 1:
					ReturnToTitle 0
					Return
		if ItemAdd item[1514] 1:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextMessage name[742] {
				{color 0}已取得{item[1514]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			TextSetPos -1 280 60 3
			FadeIn 300ms 0x00000000
			FlagSet flag[2278]
			ED7_DE 6
		else:
			FadeOut 300ms 0x00000000 100
			TextMessage name[742] {
				寶箱內裝著{item[1514]}{color 0}。
				但因持有物品已滿而放棄{item[1514]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			SoundPlay sound[15] 0 100 0
			ED7ObjPlay object[5] 30 0 0 0
	else:
		FadeOut 300ms 0x00000000 100
		TextSetPos -1 -1 -1 -1
		TextSetName ""
		TextMessage name[742] {
			{0x06}{color 5}寶箱內空無一物。{color 0}{wait}
		}
		TextWait
		TextClose 0
		FadeIn 300ms 0x00000000
	Sleep 30ms
	TextEnd null
	SystemFlagsUnset 0x08000000
	Return

