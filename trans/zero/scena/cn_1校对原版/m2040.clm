fn[6]:
	SystemFlagsSet 0x08000000
	if flag[1698]:
		TextStart null
		TextSetName ""
		TextMessage null {
			{color 5}門已經被打開了。{wait}
		}
		TextWait
		TextClose 0
		_59
		SystemFlagsUnset 0x08000000
		TextEnd null
	else:
		EventBegin 1
		TextMessage null {
			{color 5}門上掛著鎖。
			要打開嗎？{wait}
		}
		Menu menu[0] -1 -1 1
			"是" // 0
			"否" // 1
		MenuWait var[0]
		MenuClose menu[0]
		TextClose 0
		_59
