			的確也很厲害……{wait}
		}
		TextWait
		TextTalk self {
			但如果你們沒來，
			恐怕就真的有危險了。
			請容我表示謝意。{wait}
		}
		TextWait
		TextTalk self {
			對了……不嫌棄的話，
			要不要在巴士裡休息一下？{wait}
		}
		TextWait
		TextTalk self {
			那些空座位
			你們可以隨便坐。{wait}
		}
		TextWait
		Call fn[0,12]
		FlagSet flag[903]
	else:
		TextTalk self {
			如何，不嫌棄的話，
			要不要在巴士裡休息一下？{wait}
		}
		TextWait
		Call fn[0,12]
	TextEnd self
	Return

