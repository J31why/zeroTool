fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		ED7CharAnimation self 2000ms 0 1 2 1 0 3 4 3
	Return

fn[2]:
	if flag[736]:
		FlagUnset flag[736]
		Event fn[0,18]
	if flag[779] && !flag[782]:
		CharFlagsUnset char[2] 0x0080
		CharFlags2Unset char[2] 0x8000
		CharSetPos char[2] (-51450, 0, -96010) 315deg
		CharFlagsSet char[2] 0x0010
		CharFlagsUnset char[3] 0x0080
		CharFlags2Unset char[3] 0x8000
		CharSetPos char[3] (-52810, 0, -95050) 45deg
		CharFlagsSet char[3] 0x0010
		CharFlagsUnset char[1] 0x0080
		CharFlags2Unset char[1] 0x8000
		CharSetPos char[1] (-53470, 0, -94190) 45deg
		Call fn[0,10]
	var[3] = 0
	Call fn[0,9]
	Return

fn[3]:
	TriggerFlagsSet trigger[0] 0x0080
	TriggerFlagsSet trigger[1] 0x0080
	TriggerFlagsSet trigger[2] 0x0080
	if flag[778] && !flag[779]:
		TriggerFlagsUnset trigger[0] 0x0080
	if flag[1055] && !flag[1056]:
		TriggerFlagsUnset trigger[1] 0x0080
		TriggerFlagsUnset trigger[2] 0x0080
