fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if system[0] == 102:
		CharSetPos field_party[0] (-230, -1450, -33980) 0deg
		CharSetPos field_party[1] (-230, -1450, -33980) 0deg
		CharSetPos field_party[2] (-230, -1450, -33980) 0deg
		CharSetPos field_party[3] (-230, -1450, -33980) 0deg
		if system[15] != 255:
			CharSetPos field_party[4] (-230, -1450, -33980) 0deg
			CharSetPos field_party[5] (-230, -1450, -33980) 0deg
		elif system[14] != 255:
			CharSetPos field_party[4] (-230, -1450, -33980) 0deg
		system[0] = 100
	global[7] = 11
	Return

fn[2]:
	ObjFlagsUnset object[1] 0x0010
	ObjFrame object[1] 20
	Return

fn[3]:
	TextStart self
	if flag[1307]:
		if flag[0]:
			TextTalk self {
				明天是銀行的臨時休息日。
				如果要利用銀行業務，就要趁現在辦好了。{wait}
			}
			TextWait
		else:
			TextTalk self {
				明天是銀行的臨時休息日。{wait}
			}
			TextWait
			TextTalk self {
				雖然遲了點，但畢竟是紀念慶典，ＩＢＣ自然也要
				停業休息一天。{wait}
			}
			TextWait
			TextTalk self {
				想提款的話，就要趁現在啦。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1362]:
		if flag[0]:
			TextTalk self {
				當然了，屋頂
				是禁止外人上去的哦。{wait}
			}
			TextWait
			TextTalk self {
				因為那裡和總裁室很近，
				出於安全方面考慮，是不允許靠近的。{wait}
			}
			TextWait
		else:
			TextTalk self {
				總有人來詢問，
				是否能去ＩＢＣ的
				屋頂看看。{wait}
			}
			TextWait
			TextTalk self {
				哎呀呀，這裡又不是
				旅遊景點啊。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1292]:
		TextTalk self {
			今天好像有遊行活動呢。{wait}
		}
		TextWait
		TextTalk self {
			大概是因為這個緣故吧，從一大早開始，
			ＩＢＣ就來了很多人呢。{wait}
		}
		TextWait
	elif flag[1282]:
		if flag[0]:
			TextTalk self {
				紀念慶典期間，
				商務會談和宴會好像格外頻繁。{wait}
			}
			TextWait
			TextTalk self {
				真是的……
				只要待在自治州這個地方，
				就休想過上清靜悠閒的生活啊。{wait}
			}
			TextWait
		else:
			TextTalk self {
				庫羅伊斯總裁
				又出門了哦。{wait}
			}
			TextWait
			TextTalk self {
				看來今天的商務會談和宴會
				也安排得滿滿當當。{wait}
			}
			TextWait
			TextTalk self {
				就連待在自治州內的時候，
				總裁也會忙得團團轉啊。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[0]:
		TextTalk self {
			順便一說……在紀念慶典期間，
			來提款的人也特別多。{wait}
		}
		TextWait
		TextTalk self {
			ＩＢＣ真是一天
			都不能休息呢。{wait}
		}
		TextWait
	else:
		TextTalk self {
			啊，你們好啊。{wait}
		}
		TextWait
		TextTalk self {
			港灣區的公園好像在舉辦
			各式各樣的活動呢。{wait}
		}
		TextWait
		TextTalk self {
			熱鬧的歡呼聲
			都傳到這裡了呢。{wait}
		}
		TextWait
		FlagSet flag[0]
	TextEnd self
	Return

fn[4]:
	TextStart null
	FadeOut 300ms 0x00000000 100
	TextSetName ""
	TextSetPos -1 -1 -1 -1
	TextMessage null {
		{color 5}Ｉ．Ｂ．Ｃ
		International Bank of Crossbell

		{} 如果您想至本大樓
		{} 各公司咨询業務，
		{} 請先到一樓服務台询问。{wait}
	}
	TextWait
	TextClose 0
	FadeIn 300ms 0x00000000
	_59
	TextSetPos -1 280 60 3
	TextEnd null
	Return
