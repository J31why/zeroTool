fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharWalkToPos self (26860, -2000, 2200) 2000mm/s 0
		CharWalkToPos self (-4019, -1800, 2200) 2000mm/s 0
		CharWalkToPos self (-3510, -1800, -1500) 2000mm/s 0
		CharWalkToPos self (26860, -2000, -2060) 2000mm/s 0
	Return

fn[2]:
	while 1:
		CharWalkToPos self (-1970, -2000, 34720) 2000mm/s 0
		CharWalkToPos self (-1970, -2000, 8940) 2000mm/s 0
		CharWalkToPos self (2029, -2000, 8940) 2000mm/s 0
		CharWalkToPos self (2029, -2000, 34720) 2000mm/s 0
	Return

fn[3]:
	while 1:
		ED7CharAnimation self 2000ms 0 1 2 3 4
	Return

fn[4]:
	if flag[736]:
		FlagUnset flag[736]
		Event fn[0,22]
	if flag[1342]:
	elif flag[1340]:
		if system[0] == 100:
			if random % 100 < 50:
				Event fn[0,23]
	if flag[1333]:
		CharFlagsUnset char[2] 0x0080
		CharSetPos char[2] (-2450, -3800, -10800) 90deg
	else:
		CharFlagsUnset char[0] 0x0080
		CharFlagsUnset char[1] 0x0080
		CharFlagsUnset char[2] 0x0080
		CharFlagsUnset char[3] 0x0080
		CharFlagsUnset char[4] 0x0080
		ForkFunc char[2] fork[0] fn[0,1]
		ForkFunc char[3] fork[0] fn[0,2]
	Return

fn[5]:
	TriggerFlagsSet trigger[0] 0x0080
	if flag[1339] && !flag[1340]:
		TriggerFlagsUnset trigger[0] 0x0080
	if flag[1333]:
	SoundPlay sound[126] 1 80 0
	Return

fn[6]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if flag[1333]:
	elif flag[1330]:
	elif flag[1329]:
	elif flag[1320]:
	elif flag[1319]:
		if !flag[0]:
			Call fn[0,8]
		else:
			TextTalk self {
				瑟爾啊……
				只有紳士風度這方面還算合格。{wait}
			}
			TextWait
			TextTalk self {
				將來必須要讓他
				成為能配得上我的
				帥氣男人。{wait}
			}
			TextWait
	elif flag[1318]:
	elif flag[1312]:
	elif flag[1307]:
	CharSetChipPattern self 0
	TextEnd self
	Return

fn[7]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if flag[1333]:
	elif flag[1330]:
	elif flag[1329]:
	elif flag[1320]:
	elif flag[1319]:
		if !flag[0]:
			Call fn[0,8]
		else:
			TextTalk self {
				……？
				艾美，你怎麼滿臉通紅？
				難道發燒了嗎？{wait}
			}
			TextWait
	elif flag[1318]:
	elif flag[1312]:
	elif flag[1307]:
	CharSetChipPattern self 0
	TextEnd self
	Return

fn[8]:
	char[1].5 = char[0].4
	char[0].5 = char[0].4
	TextStart char[0]
	CharFlagsUnset char[0] 0x0010
	CharTurnToChar char[0] char[1] 0deg/s
	char[0].4 = (char[0].4 + 360) % 360
	char[0].4 = char[0].4 + 360 - char[0].5
	char[0].5 = char[0].4 / 180
	if char[0].4 <= 45 | char[0].4 >= 315 && char[0].4 <= 405 | char[0].4 >= 675:
	elif char[0].5 < 1:
		char[0].8 = 2
	elif char[0].5 > 2:
		char[0].8 = 1
	else:
		char[0].8 = char[0].5
	char[0].4 = char[1].5
	char[1].5 = 0
	char[0].5 = 0
	CharFlagsSet char[0] 0x0010
	char[0].5 = char[1].4
	char[1].5 = char[1].4
	TextStart char[1]
	CharFlagsUnset char[1] 0x0010
	CharTurnToChar char[1] char[0] 0deg/s
	char[1].4 = (char[1].4 + 360) % 360
	char[1].4 = char[1].4 + 360 - char[1].5
	char[1].5 = char[1].4 / 180
	if char[1].4 <= 45 | char[1].4 >= 315 && char[1].4 <= 405 | char[1].4 >= 675:
	elif char[1].5 < 1:
		char[1].8 = 2
	elif char[1].5 > 2:
		char[1].8 = 1
	else:
		char[1].8 = char[1].5
	char[1].4 = char[0].5
	char[0].5 = 0
	char[1].5 = 0
	CharFlagsSet char[1] 0x0010
	TextTalk char[0] {
		聽好了，瑟爾。
		你是我的未婚夫，
		所以必須關心我的身體。{wait}
	}
	TextWait
	TextTalk char[0] {
		……啊嚏。{wait}
	}
	TextWait
	TextTalk char[1] {
		艾美，你很冷吧？
		一整天都在水邊
		聊天……{wait}
	}
	TextWait
	TextTalk char[1] {
		回家喝點熱湯，
		暖暖身子吧。
		我送你回去。{wait}
	}
	TextWait
	TextTalk char[0] {
		…………（臉紅）{wait}
	}
	TextWait
	CharSetChipPattern char[0] 0
	CharSetChipPattern char[1] 0
	FlagSet flag[0]
	Return

fn[9]:
	TextStart self
	if flag[1333]:
		TextTalk self {
			啊、啊哇哇……！
			為什麼這裡會有魔獸……！？{wait}
		}
		TextWait
	elif flag[1330]:
	elif flag[1329]:
	elif flag[1320]:
	elif flag[1319]:
		TextTalk self {
			……哼。
			看樣子，穿戴
			很有品位嘛。{wait}
		}
		TextWait
		TextTalk self {
			難道你們也是
			哈爾特曼議長
			邀請的人嗎？{wait}
		}
		TextWait
	elif flag[1318]:
	elif flag[1312]:
	elif flag[1307]:
	TextEnd self
	Return

fn[10]:
	TextStart self
	if flag[1333]:
	elif flag[1330]:
	elif flag[1329]:
	elif flag[1320]:
	elif flag[1319]:
		TextTalk self {
			哈爾特曼議長宅邸前
			好像站著黑衣人。{wait}
		}
		TextWait
		TextTalk self {
			不愧是克洛斯貝爾的實際掌權者，
			宅邸的警備工作似乎也毫無紕漏呢。{wait}
		}
		TextWait
	elif flag[1318]:
	elif flag[1312]:
	elif flag[1307]:
	TextEnd self
	Return

fn[11]:
	TextStart self
	TextTalk self {
		嗯……必須得快點了。
		如果接受了人家邀請，最後卻遲到，
		那就太不像話了。{wait}
	}
	TextWait
	TextEnd self
	Return

