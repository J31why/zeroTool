fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if system[0] == 102 && flag[1034] && !flag[1035]:
		Event fn[0,4]
	elif system[0] == 102 && flag[1555] && !flag[1556]:
		Event fn[0,6]
	if flag[736]:
		FlagUnset flag[736]
		Event fn[0,5]
	if !flag[1040] && flag[1031]:
		CharFlagsUnset char[1] 0x0080
	Return

fn[2]:
	if !flag[1554]:
		ED7_76_0 object[255] "c122_tesri02" 1
		ED7_76_0 object[255] "tama00" 1
		ED7_76_0 object[255] "tama01" 1
		ED7_76_0 object[255] "kuro01" 1
		ED7_76_0 object[255] "ato" 1
		ObjFlagsSet object[4] 0x0004
		ObjFlagsSet object[5] 0x0004
		ObjFlagsUnset object[4] 0x0002
		ObjFlagsUnset object[5] 0x0002
	else:
		ED7_76_0 object[255] "c122_tesri01" 1
		ED7_76_0 object[255] "mae" 1
		ObjFlagsSet object[1] 0x0004
		ObjFlagsSet object[2] 0x0004
		ObjFlagsUnset object[1] 0x0002
		ObjFlagsUnset object[2] 0x0002
		LookPointFlagsSet look_point[0] 0x0001
		LookPointFlagsSet look_point[1] 0x0001
	Return

