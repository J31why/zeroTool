fn[25]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if flag[8]:
		TextTalk char[12] {
			#0106F雖然總是被副局長挖苦，
			沒有一點好的回憶……{wait}
		} {
			#0100F但他很怕老婆，又喝得酩酊大醉，
			好像也有很多苦衷啊。{wait}
		} {
			#0105F……你們兩個還不累嗎？
			暫時回去休息下也沒事哦。{wait}
		}
		TextWait
	else:
		TextTalk char[12] {
			#0100F怎麼樣，調查還順利嗎？{wait}
		}
		TextWait
		TextTalk name[0] {
			#0000F哈哈，還算順利……{wait}
		}
		TextWait
		TextTalk name[2] {
			#0203F雖然賽特的嗅覺很靈敏，
			但副局長的行動路線
			很難確定，所以比較麻煩……{wait}
		}
		TextWait
		TextTalk char[12] {
			#0106F果然很花時間啊。{wait}
		} {
			#0100F如果累了，暫時回去
			休息一下也沒事哦……{wait}
		}
		TextWait
		FlagSet flag[8]
	FadeOut 300ms 0x00000000 100
	Menu menu[0] -1 -1 0
		"【繼續調查】" // 0
		"【中斷調查】" // 1
	MenuWait var[0]
	MenuClose menu[0]
	FadeIn 300ms 0x00000000
	if var[0] != 0:
		TextTalk name[0] {
			#0006F嗯……的確累了，
			暫時回去休息下吧。{wait}
		}
		TextWait
		TextTalk name[2] {
			#0203F說得也是呢。{wait}
		} {
