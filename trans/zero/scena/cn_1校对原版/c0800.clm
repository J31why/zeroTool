fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if flag[736]:
		FlagUnset flag[736]
		Event fn[0,17]
	elif flag[737]:
		FlagUnset flag[737]
		Event fn[0,8]
	elif flag[738]:
		FlagUnset flag[738]
		Event fn[0,15]
	elif flag[739]:
		FlagUnset flag[739]
		FlagSet flag[2]
		FlagSet flag[3]
		Event fn[0,28]
	elif QuestTaskGet quest[45] 9 && !QuestFlagsGet quest[45] 0x10 && !QuestFlagsGet quest[45] 0x40:
		Event fn[0,24]
	if flag[1536]:
		if !QuestFlagsGet quest[45] 0x10:
		else:
			CharFlagsUnset char[0] 0x0080
	else:
		CharFlagsUnset char[0] 0x0080
		CharFlagsUnset char[1] 0x0080
		CharFlagsUnset char[2] 0x0080
		CharFlagsUnset char[3] 0x0080
		if QuestFlagsGet quest[9] 0x10:
		elif QuestTaskGet quest[9] 1:
			CharFlagsUnset char[4] 0x0080
	Return

fn[2]:
	if flag[2]:
		system[1] = 0
	ObjFlagsSet object[1] 0x1000
	if QuestFlagsGet quest[45] 0x10:
		CharFlagsUnset char[17] 0x0080
		ED7_78 object[1] char[17]
		CharSetPos char[17] (-2000, -1550, -8100) 0deg
		Sc_D1 char[17] 0 270000 0 0ms
		ObjFlagsSet object[0] 0x0004
		ObjFlagsSet object[1] 0x1000
	if QuestTaskGet quest[9] 1 && !flag[1024]:
		CharFlagsUnset char[17] 0x0080
		ED7_78 object[1] char[17]
		CharSetPos char[17] (-2000, -1550, -8100) 0deg
		Sc_D1 char[17] 0 270000 0 0ms
		ObjFlagsSet object[0] 0x0004
		ObjFlagsSet object[1] 0x1000
	if flag[3]:
		SoundStop sound[803]
	else:
		SoundPlay sound[803] 1 100 0
	Return

fn[3]:
	TextStart self
	if flag[1536]:
		if !QuestFlagsGet quest[45] 0x10:
		else:
			TextTalk self {
				哎呀，你們剛從
				共和國回來嗎？{wait}
			}
			TextWait
			TextTalk self {
				我也想去
				那裡旅行啊。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0003F（……我們可不是
				　去旅行的……）{wait}
			}
			TextWait
	elif !QuestFlagsGet quest[9] 0x10:
		if !flag[0]:
			TextTalk self {
				向警備隊運送物資的貨運列車
				都是從這個車站發車的。{wait}
			}
			TextWait
			TextTalk self {
				我剛剛才目送一輛前往
				貝爾加德門的列車駛出了車站。{wait}
			}
			TextWait
			TextTalk self {
				警備隊員並不是只要
				做好警備工作就行了，
				我們實在是很辛苦呢。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				剛才把貨物都裝上了
				開往貝爾加德門的貨運列車。{wait}
			}
			TextWait
			TextTalk self {
				３號月臺是貨運線專用的，
				可不能隨便進入哦。{wait}
			}
			TextWait
	else:
		TextTalk self {
			哦……開往帝國的列車的安檢
			也告一段落了。{wait}
		}
		TextWait
		TextTalk self {
			我也差不多該
			回貝爾加德門了。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[4]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if !QuestFlagsGet quest[9] 0x10:
		if !flag[1]:
			TextTalk self {
				他們不會對進入克洛斯貝爾的
				乘客進行安檢哦。{wait}
			}
			TextWait
			TextTalk self {
				只會檢查去帝國
				和共和國的乘客。{wait}
			}
			TextWait
			TextTalk self {
				就因為這樣，
				所以才會有那麼多人
				利用列車非法入境或走私。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				所以才會有那麼多人
				利用列車非法入境或走私。{wait}
			}
			TextWait
			TextTalk self {
				算了，反正跟我沒關係。{wait}
			}
			TextWait
	else:
		TextTalk self {
			那麼……休息結束，
			差不多也該走了。{wait}
		}
		TextWait
	CharSetChipPattern self 0
	TextEnd self
	Return

fn[5]:
	TextStart self
	if !QuestFlagsGet quest[9] 0x10:
		TextTalk self {
			有一個朋友要去帝國，
			我是來給他送行的。{wait}
		}
		TextWait
		TextTalk self {
			……還不發車嗎？{wait}
		}
		TextWait
	else:
		TextTalk self {
			嗯……
			還不發車嗎？{wait}
		}
		TextWait
		TextTalk self {
			我想快點把他送走，
			我好回去。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[6]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if !QuestFlagsGet quest[9] 0x10:
		TextTalk self {
			有個朋友會坐下一班列車過來。{wait}
		}
		TextWait
		TextTalk self {
			十年沒見了……真懷念啊。{wait}
		}
		TextWait
	else:
		TextTalk self {
			安檢官也出來了，
			差不多要發車了吧？{wait}
		}
		TextWait
		TextTalk self {
			等這班列車出站後，
			朋友乘坐的列車應該就會來了。{wait}
		}
		TextWait
	CharSetChipPattern self 0
	TextEnd self
	Return

fn[7]:
	TextStart self
	if QuestFlagsGet quest[9] 0x10:
	elif QuestTaskGet quest[9] 2:
		Call fn[0,10]
	elif QuestTaskGet quest[9] 1:
		Call fn[0,9]
	TextEnd self
	Return

fn[8]:
	EventBegin 0
	FadeOut 0ms 0x00000000 255
	SoundLoad sound[452]
	CharSetPos name[0] (0, 0, -30000) 0deg
	CharSetPos name[1] (0, 0, -30000) 0deg
	CharSetPos name[2] (0, 0, -30000) 0deg
	CharSetPos name[3] (0, 0, -30000) 0deg
	CharFlagsUnset char[17] 0x0080
	ED7_78 object[1] char[17]
	NextFrame
	CharSetPos char[17] (7000, -1550, -8100) 0deg
	Sc_D1 char[17] 0 270000 0 0ms
	ObjFlagsSet object[0] 0x0004
	ObjFlagsSet object[1] 0x1000
	CamSetDistance 61500 2500 -10500 0ms
	ED7CamRotate 60deg 15deg 0deg 0ms
	CamPers 780 0ms
	CamZoom 16000 0ms
	ED7_EE 0 1
	CamSetDistance 58500 2500 -11500 5000ms
	ED7CamRotate 45deg 20deg 0deg 5000ms
	CamZoom 24000 5000ms
	ObjFlagsUnset object[1] 0x0004
	ForkFunc char[17] fork[3] fn[0,18]
	FadeIn 2000ms 0x00000000
	FadeWait
	CamWait 121
	Sleep 500ms
	CrossFade 1000ms
	CamSetDistance 5500 4300 -8000 0ms
	ED7CamRotate 48deg -10deg 0deg 0ms
	CamPers 780 0ms
	CamZoom 14000 0ms
	CamSetDistance 5500 3300 -8000 4000ms
	FadeWait
	ForkWait char[17] fork[3]
	CamWait 1
	Sleep 1000ms
	FadeOut 1000ms 0x00000000 255
	FadeWait
	FlagSet flag[736]
	NewScene "scena/c0010.bin" 0 0 0
	Hcf
	Return

fn[9]:
	EventBegin 0
	CrossFade 500ms
	CharFlagsUnset char[17] 0x0080
	ED7_78 object[1] char[17]
	CharSetPos char[17] (-2000, -1550, -8100) 0deg
	Sc_D1 char[17] 0 270000 0 0ms
	ObjFlagsSet object[0] 0x0004
	ObjFlagsSet object[1] 0x1000
	CamSetDistance 5270 1500 -12980 0ms
	ED7CamRotate 29deg 22deg 0deg 0ms
	CamPers 500 0ms
	CamZoom 17840 0ms
	CharSetPos name[0] (5500, 0, -13000) 90deg
	CharSetPos name[1] (5250, 0, -12000) 90deg
	CharSetPos name[2] (4000, 0, -13000) 90deg
	CharSetPos name[3] (3700, 0, -12000) 90deg
	CharTurnTo char[4] 270deg 0deg/s
	CharSetChipPattern char[4] 0
	FadeWait
	TextTalk self {
		#11P……那麼，
		我來說明一下工作的內容。{wait}
	}
	TextWait
	TextTalk name[0] {
		#6P#0000F嗯，麻煩您了。{wait}
	}
	TextWait
	TextTalk self {
		#11P接下來，
		你們每個人負責一節車廂，
		對車廂內的人進行安檢。{wait}
	}
	TextWait
	TextTalk self {
		#11P具體來說，你們要和每個乘客對話，
		然後檢查他們的入境申請書和隨身攜帶的行李。{wait}
	}
	TextWait
	TextTalk self {
		#11P如果沒有入境申請書，
		或者攜帶有危險物品，
		就當場對其拘捕。{wait}
	}
	TextWait
	TextTalk name[0] {
		#6P#0003F原來如此……明白了。{wait}
	}
	TextWait
	TextTalk name[3] {
		#0303F嗯，雖然安檢工作還算沒問題……{wait}
	} {
		#0301F但如果乘客不在座位上的話，
		要怎麼辦啊？{wait}
	} {
		#0306F不管怎麼說，
		我們都還是新手，總覺得
		單靠我們幾個，沒法檢查全面……{wait}
	}
	TextWait
	TextTalk self {
		#11P嗯，這問題我們已經考慮到了。{wait}
	}
	TextWait
	TextTalk self {
		#11P我們規定，安檢一旦開始，
		到結束之前，乘客都不可以
		在車上走動。{wait}
	}
	TextWait
	TextTalk self {
		#11P因為有時候會有些人
		耍小聰明，意圖製造混亂
		來混過安檢。{wait}
	}
	TextWait
	TextTalk name[2] {
		#6P#0200F安檢工作果然很嚴謹啊。{wait}
	}
	TextWait
	TextTalk name[0] {
		#6P#0001F原來如此……
		我們知道該怎麼做了。{wait}
	} {
		#0003F嗯，不過……
		每人負責一節車廂嗎……{wait}
	} {
		#0000F我和蘭迪單獨一個人也沒問題，
		但艾莉和緹歐……{wait}
	}
	TextWait
	Fork name[1] fork[1]:
		CharTurnToChar name[1] name[0] 500deg/s
	Fork name[2] fork[1]:
		CharTurnToChar name[2] name[0] 500deg/s
	Fork name[3] fork[1]:
		CharTurnToChar name[3] name[0] 500deg/s
	ForkWait name[1] fork[1]
	ForkWait name[2] fork[1]
	ForkWait name[3] fork[1]
	TextTalk name[1] {
		#5P#0105F事到如今，
		還有必要擔心那種事嗎？{wait}
	} {
		#0104F身為一名警察，
		我也是會一些擒拿術的。{wait}
	}
	TextWait
	TextTalk name[2] {
		#6P#0203F我也一樣。{wait}
	} {
		#0200F就算有可疑的人想對我不利，
		我也不覺得他能打得贏我。{wait}
	}
	TextWait
	TextTalk name[3] {
		#5P#0309F哈哈，我們這邊的女生
		可都不是好欺負的啊。{wait}
	} {
		你也差不多該記住這點了吧，羅伊德。{wait}
	}
	TextWait
	CharTurnToChar name[0] name[3] 500deg/s
	TextTalk name[0] {
		#12P#0003F確、確實如此啊。{wait}
	}
	TextWait
	Fork name[0] fork[1]:
		CharTurnTo name[0] 90deg 500deg/s
	Fork name[1] fork[1]:
		CharTurnTo name[1] 90deg 500deg/s
	Fork name[2] fork[1]:
		CharTurnTo name[2] 90deg 500deg/s
	Fork name[3] fork[1]:
		CharTurnTo name[3] 90deg 500deg/s
	ForkWait name[0] fork[1]
	ForkWait name[1] fork[1]
