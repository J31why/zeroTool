	if QuestTaskGet quest[9] 11:
		QuestBonusBp quest[9] 2
		TextTalk char[4] {
			#11P……那傢伙在入境申請書上
			填寫了虛假的申報資料哦。{wait}
		}
		TextWait
		TextTalk name[0] {
			#6P#0005F虛假的申報資料……？{wait}
		}
		TextWait
		TextTalk name[2] {
			#6P#0200F是填寫了不真實的履歷嗎？{wait}
		}
		TextWait
		TextTalk char[4] {
			#11P那傢伙原本是共和國的詐騙犯。{wait}
		}
		TextWait
		TextTalk char[4] {
			#11P好像很喜歡旅行，以前也曾經隱瞞前科
			申報不實的資料，
			那次就是被我抓到的。{wait}
		}
		TextWait
		TextTalk char[4] {
			#11P這次已經是第二次被我逮到了……
			真是一個蠢蛋。{wait}
		}
		TextWait
		TextTalk name[3] {
			#5P#0301F原本是詐騙犯……？
			那他現在在做什麼啊？{wait}
		}
		TextWait
		TextTalk char[4] {
			#11P在共和國刑滿釋放後，
			好像一直過著正經日子。{wait}
		}
		TextWait
		TextTalk char[4] {
			#11P聽說那傢伙犯的詐騙案
			影響不那麼惡劣，
			所以沒有被判重罪。{wait}
		}
		TextWait
		TextTalk name[1] {
			#5P#0103F不過，『前科』這兩個字
			還是會陪伴他一生的……{wait}
		} {
			#0108F如果在入境申請書上寫明有過前科，
			那麼在旅行中的行動就會受到限制。
			他應該是想避免這點吧。{wait}
		}
		TextWait
		TextTalk char[4] {
			#11P雖然那傢伙有悔過之意，
			但為時已晚，
			這就叫自作自受。{wait}
		}
		TextWait
		TextTalk char[4] {
			#11P自己犯下的罪，必須由自己背負一生。
			所以千萬不能犯罪。{wait}
		}
		TextWait
		TextTalk name[0] {
			#6P#0001F……那名男子現在怎麼樣了？{wait}
		}
		TextWait
		TextTalk char[4] {
			#11P被拘留在我的辦公室裡。{wait}
		}
		TextWait
		TextTalk char[4] {
			#11P等我嚴厲警告他一下後，
			就把他遣送回共和國。{wait}
		}
		TextWait
		TextTalk char[4] {
			#11P畢竟也不是什麼嚴重的事。{wait}
		}
		TextWait
		TextTalk name[0] {
			#6P#0003F這樣啊……{wait}
		}
		TextWait
		TextTalk char[4] {
			#11P……總之，終於順利
			檢查完所有車廂了。{wait}
		}
		TextWait
		TextTalk char[4] {
			#11P雖然比預期要遲了點……
			但總算能讓列車順利發車了。{wait}
		}
		TextWait
		TextTalk char[4] {
			#11P感謝你們，
			特務支援課的各位……{wait}
		}
		TextWait
		TextTalk char[4] {
			#11P以後也請你們多多幫忙啊。{wait}
		}
		TextWait
		QuestTaskSet quest[9] 12
	else:
		TextTalk char[4] {
			#11P終於順利
			檢查完所有車廂了。{wait}
		}
		TextWait
		TextTalk char[4] {
			#11P多虧了你們，
			列車才能準時發車。{wait}
		}
		TextWait
		TextTalk char[4] {
			#11P感謝你們，
			特務支援課的各位……{wait}
		}
		TextWait
	TextTalk name[0] {
		#6P#0000F您客氣了，我們也藉此機會
		學會了不少東西。{wait}
	} {
		如果還有什麼需要，
		請隨時聯絡我們。{wait}
	}
	TextWait
	TextTalk char[4] {
		#11P嗯，那麼再見。{wait}
	}
	TextWait
