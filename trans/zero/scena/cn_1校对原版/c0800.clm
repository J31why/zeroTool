		#11P#0100F嗯，確實……{wait}
	} {
		#0106F不過，我們這些人裡，
		緹歐應該是最累的吧。{wait}
	}
	TextWait
	Emote name[0] 0mm 2000mm 0 1 250ms 2
	SoundPlay sound[29] 0 100 0
	Sleep 1000ms
	TextTalk name[0] {
		#12P#0005F……為什麼啊？{wait}
	}
	TextWait
	TextTalk name[3] {
		#5P#0309F不知是把她當成了『一日站長』還是什麼的，
		乘客們都很喜歡圍著她啊。{wait}
	}
	TextWait
	CharTurnToChar name[0] name[2] 500deg/s
	TextTalk name[0] {
		#12P#0005F一、一日站長……
		緹歐，你不要緊嗎？{wait}
	}
	TextWait
	TextTalk name[2] {
		#6P#0203F…………………………{wait}
	}
	TextWait
	TextTalk name[0] {
		#12P#0005F累得連說話的力氣
		都沒有了嗎……！？{wait}
	}
	TextWait
	TextTalk name[2] {
		#6P#0206F沒、沒有。
		只是精神上有些疲勞而已，
		沒什麼大問題。{wait}
	} {
		#0200F……我們走吧。{wait}
	}
	TextWait
	TextTalk name[0] {
		#12P#0003F這、這樣啊……
		總之，你可千萬不要勉強啊。{wait}
	}
	TextWait
