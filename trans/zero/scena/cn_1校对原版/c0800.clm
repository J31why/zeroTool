fn[33]:
	EventBegin 1
	if QuestTaskGet quest[45] 12:
		TextTalk name[0] {
			#0003F這是去其它
			月臺的通道。{wait}
		} {
			#0000F工作都做完了，
			我們直接回去吧。{wait}
		}
		TextWait
	elif QuestFlagsGet quest[9] 0x10:
		TextTalk name[0] {
			#0000F安檢都結束了……
			所以沒有必要去前往
			共和國方向列車的月臺。{wait}
		}
		TextWait
	else:
		TextTalk name[0] {
			#0003F這是去其它
			月臺的通道。{wait}
		} {
			#0001F必須在列車出發之前
			開始任務……{wait}
		}
		TextWait
	Sleep 50ms
	CharSetPos field_party[0] (54500, 0, -16000) 270deg
	EventEnd 4
	Return

