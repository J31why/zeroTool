fn[3]:
	if flag[1037] && !flag[1038]:
		MapColor 0x00C8D2FF 0ms
	elif flag[1792]:
		MapColor 0x00C8D2FF 0ms
	else:
	Return

fn[4]:
	Call fn[0,5]
	Return

fn[5]:
	TextStart char[24]
	if !flag[610]:
		TextTalk char[24] {
			嘿，歡迎光臨。
			雖然我是想這麼說……{wait}
		}
		TextWait
		TextTalk char[24] {
			不過，小子們，在克洛斯貝爾，
			如果沒有許可證的話，是不能買武器的。
			如果只是來閒逛的話，還是請回吧。{wait}
		}
		TextWait
		TextTalk name[0] {
			#0000F啊，不，我們
			是克洛斯貝爾警察局的人……{wait}
		}
		TextWait
		Emote char[24] 0mm 2000mm 0 1 250ms 2
		SoundPlay sound[29] 0 100 0
		Sleep 1000ms
		TextTalk char[24] {
			像你們這種小孩子會是警察……？{wait}
		}
		TextWait
		TextTalk char[24] {
			對了，你們就是賽爾蓋那傢伙
			之前說過的……{wait}
		}
		TextWait
		TextTalk char[24] {
			哼，我明白了。
			你們隨便看吧。{wait}
		}
		TextWait
		TextTalk char[24] {
			要買武器的時候，
			記得拿搜查手冊給我看啊。
			那個可以用來代替許可證。{wait}
		}
		TextWait
		FlagSet flag[610]
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"對話" // 0
			"購物" // 1
			"放棄" // 2
		MenuWait var[0]
		if var[0] != 1:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			if flag[1792]:
				ShopOpen shop[5]
			elif flag[1536]:
				ShopOpen shop[4]
			elif flag[1280]:
				ShopOpen shop[3]
			elif flag[1024]:
				ShopOpen shop[2]
			elif flag[768]:
				ShopOpen shop[1]
			else:
				ShopOpen shop[0]
			var[0] = 99
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			if !flag[611] && !flag[777] && !flag[869]:
				var[0] = 0
				Call fn[0,36]
			elif flag[1792]:
				if !flag[0]:
					TextTalk char[24] {
						嘿，歡迎光臨，
						雖然我是想這麼說……{wait}
					}
					TextWait
					TextTalk char[24] {
						但已經快到打烊時間了，
						要買東西就抓緊時間。{wait}
					}
					TextWait
					TextTalk name[3] {
						#0300F店主大叔還是老樣子，
						沒什麼做生意的幹勁啊。{wait}
					}
					TextWait
					TextTalk char[24] {
						沒錯，我可是一點幹勁都沒啊。{wait}
					}
					TextWait
					TextTalk char[24] {
						說來……機場那邊
						好像發生什麼事件了啊。{wait}
					}
					TextWait
					TextTalk char[24] {
						最近總感覺有些不太平呢。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[24] {
						機場那邊好像
						發生什麼事件了啊。{wait}
					}
					TextWait
					TextTalk char[24] {
						最近總感覺有些不太平呢。{wait}
					}
					TextWait
			elif flag[1569]:
				if !flag[0]:
					TextTalk char[24] {
						……這不是達德利嘛。{wait}
					}
					TextWait
					TextTalk char[24] {
						居然和支援課一起行動，還真是稀奇啊。
						難道是歲月不饒人，連你也需要幫手了？{wait}
					}
					TextWait
					TextTalk name[9] {
						#0603F這種話我可不能假裝沒聽見啊，店主。{wait}
					} {
						#0600F我並不是和這幫傢伙一起行動，
						而是在率領他們進行案件調查！{wait}
					} {
						……另外，這件事可
						不要隨意外傳啊。{wait}
					}
					TextWait
					TextTalk char[24] {
						是是，我知道啦。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[24] {
						不過，一課的王牌警官
						居然在和支援課一起行動啊……{wait}
					}
					TextWait
					TextTalk char[24] {
						這也真是稀奇的
						組合了。{wait}
					}
					TextWait
			elif flag[1566]:
				if !flag[0]:
					TextTalk char[24] {
						怎麼……一大早的
						就來買武器啊？{wait}
					}
					TextWait
					TextTalk char[24] {
						真是一幫不懂享受生活的傢伙。{wait}
					}
					TextWait
					TextTalk char[24] {
						要選武器的話，
						下午再來吧。{wait}
					}
					TextWait
					TextTalk name[2] {
						#0200F店主大叔其實
						只是想過得悠閒些吧……{wait}
					}
					TextWait
					TextTalk char[24] {
						哈，一語中的，
						就是這麼回事啦。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[24] {
						我上午就想看看雜誌，
						輕鬆悠閒地度過。{wait}
					}
					TextWait
					TextTalk char[24] {
						所以你們儘量別來打擾我啊。{wait}
					}
					TextWait
			elif flag[1554]:
				if !flag[0]:
					TextTalk char[24] {
						嘿，歡迎光臨。
						想要看點什麼嗎？{wait}
					}
					TextWait
					TextTalk char[24] {
						我可懶得賣東西，
						你們自己隨便看看吧。{wait}
					}
					TextWait
					TextTalk name[1] {
						#0100F啊，還是和往日一樣，
						沒有做生意的幹勁呢。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[24] {
						我可懶得賣東西，
						你們自己隨便看看吧。{wait}
					}
					TextWait
			elif flag[1550]:
				TextTalk char[24] {
					怎麼，這不是
					支援課的小鬼們嘛。
					都這種時間了還在工作嗎？{wait}
				}
				TextWait
				TextTalk char[24] {
					我已經關店了。
					好了，都給我回去吧！{wait}
				}
				TextWait
			elif flag[1536]:
				if !flag[0]:
					TextTalk char[24] {
						魯巴徹那群傢伙
						最近真是頻繁鬧事啊。{wait}
					}
					TextWait
					TextTalk char[24] {
						托他們的福，遊擊士們
						都在抱怨忙得不可開交呢。{wait}
					}
					TextWait
					TextTalk char[24] {
						你們這些警察，
						也應該再多努力
						一點才對吧？{wait}
					}
					TextWait
					TextTalk name[0] {
						#0000F哈哈哈……真是抱歉。{wait}
					}
					TextWait
					TextTalk name[3] {
						#0300F和黑手黨有關的事情，
						都是由搜查一課來負責的啊。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[24] {
						魯巴徹那群傢伙
						最近真是頻繁鬧事啊。{wait}
					}
					TextWait
					TextTalk char[24] {
						托他們的福，遊擊士們
						好像相當出風頭呢。{wait}
					}
					TextWait
			elif flag[1342]:
				if !flag[1639]:
					TextTalk char[24] {
						……是你們啊。{wait}
					}
