fn[11]:
	if QuestFlagsGet quest[41] 0x02 && !QuestTaskGet quest[41] 0 && !QuestFlagsGet quest[41] 0x40:
		Call fn[0,38]
		Return
	TextStart self
	if QuestTaskGet quest[41] 0 && !QuestFlagsGet quest[41] 0x10 && !QuestFlagsGet quest[41] 0x40:
		var[0] = 99
		while var[0] == 99:
			Menu menu[0] -1 -1 1
				"對話" // 0
				"交付料理" // 1
				"放棄" // 2
			MenuWait var[0]
			MenuClose menu[0]
			if var[0] == 0:
				var[0] = 99
				Call fn[0,12]
			elif var[0] == 1:
				Call fn[0,40]
				Call fn[0,41]
				if var[4] == 0:
					TextTalk self {
						……異想天開的料理……
						你們好像並沒有攜帶啊。{wait}
					}
					TextWait
					TextTalk self {
						收集到十種以上之後，
						再來找我吧，
						我會給你們回禮的！{wait}
					}
					TextWait
				elif var[4] < 10:
					TextTalk self {
						種類不夠啊，
						請你們至少提供十種。{wait}
					}
					TextWait
					TextTalk self {
						收集到十種以上之後，
						再來找我吧，
						我會給你們回禮的！{wait}
					}
					TextWait
				else:
					TextTalk self {
						現在要報告嗎？{wait}
					}
					TextWait
					Menu menu[1] -1 -1 1
						"【報告】" // 0
						"【放棄】" // 1
					MenuWait var[1]
					MenuClose menu[1]
					if var[1] == 0:
						Call fn[0,39]
						Return
					else:
						TextTalk self {
							是嗎……
							如果能儘量多收集一些，
							我也會很高興的。{wait}
						}
						TextWait
						TextTalk self {
							如果再收集到了料理，
							請一定拿來給我啊！{wait}
						}
						TextWait
				var[0] = 99
			else:
	else:
		Call fn[0,12]
	TextEnd self
	Return

