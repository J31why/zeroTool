fn[17]:
	field_party[0].5 = char[7].4
	char[7].5 = char[7].4
	TextStart char[7]
	CharFlagsUnset char[7] 0x0010
	CharTurnToChar char[7] field_party[0] 0deg/s
	char[7].4 = (char[7].4 + 360) % 360
	char[7].4 = char[7].4 + 360 - char[7].5
	char[7].5 = char[7].4 / 180
	if char[7].4 <= 45 | char[7].4 >= 315 && char[7].4 <= 405 | char[7].4 >= 675:
	elif char[7].5 < 1:
		char[7].8 = 2
	elif char[7].5 > 2:
		char[7].8 = 1
