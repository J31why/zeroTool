fn[9]:
	TextStart char[0]
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"對話" // 0
			"購物" // 1
			"放棄" // 2
		MenuWait var[0]
		if var[0] != 1:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			ShopOpen shop[8]
			var[0] = 99
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			if flag[1792]:
				TextTalk char[0] {
					賽爾提歐果然
					還差得遠啊……{wait}
				}
				TextWait
			elif flag[1566]:
				if !flag[1]:
					TextTalk char[0] {
						有客人投訴說，我們的廚師
						總是擅自端出一些亂七八糟的
						奇特料理……{wait}
					}
					TextWait
					TextTalk char[0] {
						……咳咳，十分抱歉，
						本店的廚師給您添麻煩了。{wait}
					}
					TextWait
					FlagSet flag[1]
				else:
					TextTalk char[0] {
						賽爾提歐要是能
						再稍微認真一點就好了……{wait}
					}
					TextWait
			elif flag[1554]:
				TextTalk char[0] {
					……賽爾提歐總是頻繁地
					從廚房跑出來呢。{wait}
				}
				TextWait
				TextTalk char[0] {
					而且好像還擅自
					給客人們上一些
					奇怪的菜……{wait}
				}
				TextWait
				TextTalk char[0] {
					那究竟是……{wait}
				}
				TextWait
			elif flag[1536]:
				if !flag[1]:
					TextTalk char[0] {
						我和本店的大廚布朗
						是交往了四十年的好友，
						還是一同修行的同伴。{wait}
					}
					TextWait
					TextTalk char[0] {
						但問題就是下一代。{wait}
					}
					TextWait
					TextTalk char[0] {
						賽爾提歐要是能努力修行，
						把手藝再提高一些就好了。{wait}
					}
					TextWait
					FlagSet flag[1]
				else:
					TextTalk char[0] {
						實在是想不出能讓
						賽爾提歐拿出幹勁
						的方法啊。{wait}
					}
					TextWait
			elif flag[1342]:
				TextTalk char[0] {
					在今年的紀念慶典期間，
					本店也獲得了最大利潤。{wait}
				}
				TextWait
				TextTalk char[0] {
					但慶典終歸是慶典……
					結束之後，就又要恢復沉寂了呢。{wait}
				}
				TextWait
			elif flag[1055]:
				if !flag[1]:
					TextTalk char[0] {
						儂諾的一句話
						竟然就讓賽爾提歐變得這麼賣力……{wait}
					}
					TextWait
					TextTalk char[0] {
						那句話，你猜是什麼呢。{wait}
					}
					TextWait
					TextTalk char[0] {
						『在紀念慶典時，
						會有很多女孩子來光顧哦。』
						……就是這樣。{wait}
					}
					TextWait
					TextTalk char[0] {
						雖然確實是很有效果，
						但反而覺得有效過了頭，真擔心啊。{wait}
					}
					TextWait
