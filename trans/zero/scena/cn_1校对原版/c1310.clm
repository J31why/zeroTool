fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if system[0] == 101 && flag[761]:
		FlagUnset flag[761]
		Event fn[0,2]
	CharFlagsSet char[7] 0x0080
	CharFlagsSet char[8] 0x0080
	CharFlagsSet char[6] 0x0080
	CharFlagsSet char[5] 0x0080
	if flag[1566]:
		if QuestFlagsGet quest[49] 0x10:
			CharFlagsUnset char[6] 0x0080
			CharSetPos char[6] (1080, 300, 29510) 0deg
			CharFlagsSet char[6] 0x0010
		CharFlagsSet char[4] 0x0080
	elif flag[1554]:
	elif flag[1536]:
	elif flag[1307]:
	elif flag[1362]:
		CharFlagsSet char[4] 0x0010
	elif flag[1292]:
		CharFlagsSet char[4] 0x0010
	elif flag[1282]:
		CharFlagsUnset char[9] 0x0080
		CharFlagsUnset char[10] 0x0080
	elif flag[1280]:
	elif flag[1055]:
		CharSetPos char[3] (7110, 300, 32759) 90deg
		CharFlagsSet char[3] 0x0010
	elif flag[1040]:
	elif flag[1031]:
		CharSetPos char[3] (7110, 300, 32759) 90deg
		CharFlagsSet char[3] 0x0010
	elif flag[1024]:
	elif flag[801]:
		CharSetPos char[3] (7110, 300, 32759) 90deg
		if flag[892]:
			if !flag[869]:
				CharFlagsUnset char[6] 0x0080
				CharFlagsSet char[6] 0x0010
				CharFlagsUnset char[5] 0x0080
				CharFlagsSet char[5] 0x0010
	elif flag[777]:
		if flag[892]:
			CharFlagsUnset char[6] 0x0080
			CharFlagsSet char[6] 0x0010
			CharFlagsUnset char[5] 0x0080
			CharFlagsSet char[5] 0x0010
		CharFlagsUnset char[8] 0x0080
		CharSetPos char[3] (7110, 300, 32759) 90deg
		CharFlagsSet char[3] 0x0010
	else:
		CharFlagsUnset char[7] 0x0080
		if flag[892]:
			CharFlagsUnset char[6] 0x0080
			CharFlagsUnset char[5] 0x0080
			CharFlagsSet char[5] 0x0010
		CharSetPos char[3] (7110, 300, 32759) 90deg
		CharFlagsSet char[3] 0x0010
		CharFlagsSet char[7] 0x0010
		CharFlagsSet char[4] 0x0010
	if QuestTaskGet quest[45] 5 && !QuestTaskGet quest[45] 6 && !QuestFlagsGet quest[45] 0x40:
		Event fn[0,23]
	Return

fn[2]:
	SoundPlay sound[160] 0 100 0
	Return

fn[3]:
	if system[4] == 3:
		EntranceSetDisabled entrance[0] 0
		EntranceSetDisabled entrance[2] 1
	else:
		EntranceSetDisabled entrance[0] 1
		EntranceSetDisabled entrance[2] 0
	if flag[1041] && !flag[1049]:
		system[1] = 111
	if flag[1037] && !flag[1038]:
		MapColor 0x00C8D2FF 0ms
	elif flag[1792]:
		MapColor 0x00C8D2FF 0ms
	else:
	TriggerFlagsSet trigger[0] 0x0080
	if flag[525] && !flag[1042]:
		TriggerFlagsUnset trigger[0] 0x0080
	if flag[768] && !flag[1024] && !flag[892]:
		EntranceSetFunc entrance[0] fn[0,13]
	Return

fn[4]:
	TextStart self
	if flag[1566]:
		TextTalk self {
			嗯……感覺今天的
			客人很少啊。{wait}
		}
		TextWait
		TextTalk self {
			大概是我的錯覺吧。{wait}
		}
		TextWait
	elif flag[1554]:
		if flag[0]:
			TextTalk self {
				避免讓客人感到不安，
				也是我們警備員的工作。{wait}
			}
			TextWait
			TextTalk self {
				雖然發生了槍擊事件，
				但ＩＢＣ還是絕對安全的。{wait}
			}
			TextWait
		else:
			TextTalk self {
				今天的警備員人數
				比平時增加了兩成左右。{wait}
			}
			TextWait
			TextTalk self {
				……因為聽說港灣公園那邊
				發生了暴力事件呢。
				還是小心一點為好。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1536]:
		if flag[0]:
			TextTalk self {
				我們保安部正在對
				全世界的主要都市進行
				治安等級的評定。{wait}
			}
			TextWait
			TextTalk self {
				為了保護好經常飛往世界
				各地的庫羅伊斯總裁，
				這是十分必要的。{wait}
			}
			TextWait
		else:
			TextTalk self {
				就在最近這兩三個星期，
				市內的治安等級有所惡化。{wait}
			}
			TextWait
			TextTalk self {
				按照我們保安部的評定標準，
				都已經降到Ｃ級了。{wait}
			}
			TextWait
			TextTalk self {
				像那些人煙稀少的小胡同是很危險的，
				希望市民們也能多加注意。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1307]:
		if flag[0]:
			TextTalk self {
				作為警備員，絕對不能疏忽大意。
				必須要時刻提高警惕。{wait}
			}
			TextWait
		else:
			TextTalk self {
				今天就是慶典的最終日了啊。{wait}
			}
			TextWait
			TextTalk self {
				正是在這種時候，
				才最容易發生麻煩呢。
				必須要提高警惕啊。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1362]:
		TextTalk self {
			聽說那些高層人員
			今天一整天都要開會。{wait}
		}
		TextWait
		TextTalk self {
			嗯，真令人同情啊。{wait}
		}
		TextWait
	elif flag[1292]:
		if flag[0]:
			TextTalk self {
				雖然表面上是一片慶典期間的歡慶景象，
				但克洛斯貝爾的治安仍然不能算很好。{wait}
			}
			TextWait
			TextTalk self {
				希望那些遊客不要迷路，
				然後被捲入什麼事件中啊。{wait}
			}
			TextWait
		else:
			TextTalk self {
				根據我們保安部的報告，
				克洛斯貝爾市內的治安等級
				好像再次下降了。{wait}
			}
			TextWait
			TextTalk self {
				唔……警察們都在幹什麼啊。{wait}
			}
			TextWait
			TextTalk self {
				如果惡化程度太過嚴重，
				我們也有必要強化保全體制了。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1282]:
		if flag[0]:
			TextTalk self {
				不管怎麼說，
				如果沒有認證卡片，
				就無法啟動升降機啊。{wait}
			}
			TextWait
		else:
			TextTalk self {
				之前有個陌生的客人
				想來乘坐升降機。{wait}
			}
			TextWait
			TextTalk self {
				哎呀哎呀，那些討厭的遊客。
				明明都和他們說過，
				這裡是禁止通行的。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1280]:
		TextTalk self {
			聽說港灣公園那邊
			相當擁擠啊。{wait}
		}
		TextWait
		TextTalk self {
			客人比平時更多……
			警備工作也要重視。{wait}
		}
		TextWait
	elif flag[1055]:
		TextTalk self {
			這座大樓的
			安全系統是
			完全獨立的。{wait}
		}
		TextWait
		TextTalk self {
			不管是遭受駭客入侵也好，
			還是別的什麼攻擊也好，
			應該都不會有問題的。{wait}
		}
		TextWait
	elif flag[1040]:
		if flag[1042]:
			TextTalk self {
				有事要去上層嗎？{wait}
			}
			TextWait
			TextTalk self {
				如果想乘坐升降機，
				只要使用認證卡片就好。{wait}
			}
			TextWait
		else:
			TextTalk self {
				嗯……上面的樓層
				是禁止無關人員前往的。{wait}
			}
			TextWait
			TextTalk self {
				如果有什麼事情，
				請先去綜合服務台申請許可吧。{wait}
			}
			TextWait
	elif flag[1031]:
		if !flag[0]:
			TextTalk self {
				嗯，克洛斯貝爾周邊地區
				的治安等級似乎開始下降了……{wait}
			}
			TextWait
			TextTalk self {
				目前雖然還沒有牽扯到
				那些重大的問題……{wait}
			}
			TextWait
			TextTalk self {
				但在這自治州，並沒有任何
				管制雇傭兵方面的法律。
				……所以任何事情都有可能發生呢……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			Emote char[0] 0mm 2000mm 24 27 250ms 1
			Sleep 1500ms
			TextTalk self {
				克洛斯貝爾市這片地區
				其實是非常複雜的。{wait}
			}
			TextWait
			TextTalk self {
				絕對稱不上是安全……
				我們也必須提高警惕啊……{wait}
			}
			TextWait
	elif flag[1024]:
		if flag[0]:
			TextTalk self {
				隨著公司規模的擴大，
				需要守衛的東西也會增加。{wait}
			}
			TextWait
			TextTalk self {
				每個企業好像都很辛苦呢。{wait}
			}
			TextWait
		else:
			TextTalk self {
				最近有外國企業來找
				我們保安部進行洽談。{wait}
			}
			TextWait
			TextTalk self {
				有些是想委託我們對ＶＩＰ進行護衛，
				有些是想請教警備工作的訣竅，
				總之什麼事情都有。{wait}
			}
			TextWait
			TextTalk self {
				不管是哪個公司，
				保全工作都是很辛苦的。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[801]:
		if flag[0]:
			TextTalk self {
				……你知道嗎？
				在這裡的地下一樓，
				有個很大的員工食堂呢……{wait}
			}
			TextWait
			TextTalk self {
				咳咳，不，沒什麼。
				現在還是執勤時間呢。{wait}
			}
			TextWait
		else:
			TextTalk self {
				我為了保持自己的體力充沛，
				每天早上都要跑１００塞爾矩。{wait}
			}
			TextWait
			TextTalk self {
				為了應對關鍵時刻，
				平時就必須保持鍛煉。{wait}
			}
			TextWait
			TextTalk self {
				……可是，一旦晨跑的話，
				肚子餓得就會很快……{wait}
			}
			TextWait
			TextTalk self {
				咳咳，不，沒什麼啦……{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[777]:
		if flag[0]:
			TextTalk self {
				這座大樓是整個大陸中
				安全係數最高的地方了。{wait}
			}
			TextWait
			TextTalk self {
				在裡面可以放心地
				談生意。{wait}
			}
			TextWait
		else:
			TextTalk self {
				這座大樓是整個大陸中
				安全係數最高的地方了，
				我們也引以為榮。{wait}
			}
			TextWait
			TextTalk self {
				這是一座重視防衛機能的近代建築。{wait}
			}
			TextWait
			TextTalk self {
				使用了以導力技術為基礎的
				最新安全系統。{wait}
			}
			TextWait
			TextTalk self {
				而且，我們這些保安部的人
				也都是受過正式訓練的專業人士。{wait}
			}
			TextWait
			TextTalk self {
				任何邪惡之徒
				都無法侵入這裡。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[0]:
		TextTalk self {
			ＩＢＣ大樓內的保全工作
			就交給我們吧。
			我們畢竟也是專業人士。{wait}
		}
		TextWait
	else:
		TextTalk self {
			哦，那個夾克……
			你們是警察局的人吧？{wait}
		}
		TextWait
		TextTalk self {
			我們是在ＩＢＣ集團
			任職的保安部人員。{wait}
		}
		TextWait
		TextTalk self {
			ＩＢＣ大樓內的保全工作
			就交給我們吧。{wait}
		}
		TextWait
		FlagSet flag[0]
	TextEnd self
	Return

fn[5]:
	TextStart self
	if flag[1566]:
		if flag[1]:
			TextTalk self {
				庫羅伊斯總裁和
				瑪利亞貝爾小姐今天都出差了。{wait}
			}
			TextWait
			TextTalk self {
				感覺稍微有點寂寞呢。{wait}
			}
			TextWait
		else:
			TextTalk self {
				瑪利亞貝爾小姐今天
				出差去國外了。{wait}
			}
			TextWait
			TextTalk self {
				她的出差次數
				好像也在逐年增加呢……{wait}
			}
			TextWait
			TextTalk self {
				越來越像她的父親了。{wait}
			}
			TextWait
			FlagSet flag[1]
	elif flag[1554]:
		TextTalk self {
			是我的心理作用嗎，
			感覺今天的客人好像變少了呢。{wait}
		}
		TextWait
		TextTalk self {
			呼……就算是我們，也不可能
			將警備工作延伸到大樓外面啊。{wait}
		}
		TextWait
	elif flag[1536]:
		if flag[1]:
			TextTalk self {
				是因為紀念慶典嗎，
				最近似乎有很多新企業前來駐紮。{wait}
			}
			TextWait
			TextTalk self {
				我也有些在意呢。{wait}
			}
			TextWait
		else:
			TextTalk self {
				萊恩福爾特公司的
				營業部就入駐在
				這座大樓中……{wait}
			}
			TextWait
			TextTalk self {
				但就在最近，他們的競爭對手
				烏爾努公司好像也準備在此
				設立分部，還前來商談了呢。{wait}
			}
			TextWait
			TextTalk self {
				嗯～早就聽說過這兩個公司
				處處都要對立競爭，現在一看，
				確實是互不相讓啊。{wait}
			}
			TextWait
			FlagSet flag[1]
	elif flag[1307]:
		if flag[1]:
			TextTalk self {
				雖然新聞媒體很少會报道……
				但克洛斯貝爾過去也曾
				發生過一些恐怖事件。{wait}
			}
			TextWait
			TextTalk self {
				紀念慶典要是能順利結束，
				那就再好不過了。{wait}
			}
			TextWait
		else:
			TextTalk self {
				紀念慶典今天要結束了啊……{wait}
			}
			TextWait
