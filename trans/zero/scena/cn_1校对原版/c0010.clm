// NB: this line is meaningless, it's just here for roundtripping.
label blank

fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharIdle self (19730, null, 1670) (16239, null, -2020) 1000mm/s
		Sleep 300ms
	Return

fn[2]:
	while 1:
		CharWalkToPos self (20920, 4000, -8210) 1000mm/s 0
		CharWalkToPos self (20920, 4000, 760) 1000mm/s 0
		CharTurnTo self 270deg 200deg/s
		Sleep 2500ms
		CharWalkToPos self (20920, 4000, -8210) 1000mm/s 0
		CharWalkToPos self (18700, 4000, -8210) 1000mm/s 0
		CharTurnTo self 315deg 200deg/s
		Sleep 4500ms
	Return

fn[3]:
	if flag[736]:
		FlagUnset flag[736]
		Event fn[0,33]
	elif !flag[547]:
		Event fn[0,28]
	if flag[1536]:
		if !QuestFlagsGet quest[45] 0x10:
			CharSetPos char[5] (18820, 0, 4500) 90deg
			CharSetPos char[4] (19970, 0, 4500) 270deg
			CharFlagsSet char[5] 0x0010
			CharFlagsSet char[4] 0x0010
		else:
			CharSetPos char[5] (19970, 0, -4490) 90deg
		CharFlagsUnset char[14] 0x0080
		CharFlagsUnset char[15] 0x0080
		CharFlagsUnset char[16] 0x0080
		CharFlagsUnset char[17] 0x0080
		CharFlagsSet char[16] 0x0010
		CharFlagsUnset char[8] 0x0080
		CharFlagsUnset char[9] 0x0080
	else:
		if !QuestFlagsGet quest[9] 0x10:
			CharFlagsSet char[5] 0x0010
			if !QuestTaskGet quest[9] 1:
			else:
				CharFlagsSet char[5] 0x0080
		else:
			CharFlagsSet char[5] 0x0080
			CharFlagsUnset char[6] 0x0080
			CharFlagsUnset char[7] 0x0080
		CharFlagsUnset char[10] 0x0080
		CharFlagsUnset char[11] 0x0080
		CharFlagsUnset char[12] 0x0080
		CharFlagsUnset char[13] 0x0080
	Return

fn[4]:
	ObjFlagsUnset object[2] 0x0010
	if QuestTaskGet quest[45] 9 && !QuestFlagsGet quest[45] 0x10 && !QuestFlagsGet quest[45] 0x40:
		ObjFlagsSet object[2] 0x0010
	ObjFlagsUnset object[1] 0x0010
	if flag[1024]:
	elif flag[801]:
		if QuestFlagsGet quest[9] 0x10:
			ObjFlagsSet object[1] 0x0010
		elif QuestTaskGet quest[9] 1:
			ObjFlagsSet object[1] 0x0010
			EntranceSetFunc entrance[0] fn[0,34]
	if QuestFlagsGet quest[45] 0x10 && !flag[1688]:
		ObjFlagsSet object[1] 0x0010
	Return

fn[5]:
	Call fn[0,6]
	Return

fn[6]:
	TextStart char[0]
	if flag[1536]:
		if !QuestFlagsGet quest[45] 0x10:
			if !flag[0]:
				TextTalk char[0] {
					在十幾年前的『百日戰役』中，
					帝國和共和國之間曾經是對立的關係。{wait}
				}
				TextWait
				TextTalk char[0] {
					當年，連鐵道的運營都停止了，
					所以來克洛斯貝爾旅行的人們
					只能被困在這裡。{wait}
				}
				TextWait
				TextTalk char[0] {
					現今，為了不讓這樣的事情再次發生，
					已經建立起了完備的體制。{wait}
				}
				TextWait
				FlagSet flag[0]
			else:
				TextTalk char[0] {
					在十幾年前的『百日戰役』中，
					這裡的鐵道曾被臨時停運，
					導致許多人都淪為難民。{wait}
				}
				TextWait
				TextTalk char[0] {
					現今，為了不讓這樣的事情再次發生，
					已經建立起了完備的體制。{wait}
				}
				TextWait
		else:
			TextTalk char[0] {
				麥克道爾市長出席
				在帝國或共和國舉辦的會議時，
				也會選擇乘坐列車呢。{wait}
			}
			TextWait
			TextTalk char[0] {
				雖然乘飛行船會比較快，
				但要花費不少米拉的。{wait}
			}
			TextWait
			TextTalk char[0] {
				哎呀，真是個廉潔的好市長啊。{wait}
			}
			TextWait
	elif !QuestFlagsGet quest[9] 0x10:
		TextTalk char[0] {
			感謝您今日光臨
			克洛斯貝爾車站。{wait}
		}
		TextWait
		TextTalk char[0] {
			列車到站時
			將會非常擁擠，
			請您注意安全。{wait}
		}
		TextWait
	else:
		TextTalk char[0] {
			鐵道是由『大陸鐵道公司』
			負責運營的。{wait}
		}
		TextWait
		TextTalk char[0] {
			另外，庫瓦特羅先生
			是帝國派來的安檢人員，
			不是公司的職員哦。{wait}
		}
		TextWait
	TextEnd char[0]
	Return

fn[7]:
	Call fn[0,8]
	Return

fn[8]:
	TextStart char[1]
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"對話" // 0
			"購物" // 1
			"放棄" // 2
		MenuWait var[0]
		if var[0] != 1:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			if flag[1792]:
				ShopOpen shop[137]
			elif flag[1536]:
				ShopOpen shop[136]
			elif flag[1342]:
				ShopOpen shop[135]
			elif flag[1307]:
				ShopOpen shop[134]
			elif flag[1280]:
				ShopOpen shop[133]
			elif flag[1024]:
				ShopOpen shop[132]
			elif flag[768]:
				ShopOpen shop[131]
			else:
				ShopOpen shop[130]
			var[0] = 99
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			if flag[1536]:
				if !QuestFlagsGet quest[45] 0x10:
					if !flag[1]:
						TextTalk char[1] {
							開往共和國的列車
							馬上就要從一號月臺發車了。{wait}
						}
						TextWait
						TextTalk char[1] {
							如需搭乘，請儘快上車，
							或者請等待下一班列車。{wait}
						}
						TextWait
						FlagSet flag[1]
					else:
						TextTalk char[1] {
							開往共和國的列車
							馬上就要從一號月臺發車了。{wait}
						}
						TextWait
						TextTalk char[1] {
							匆忙擠上車是很危險的，
							搭乘時請預留出充裕的時間。{wait}
						}
						TextWait
				elif !flag[1]:
					TextTalk char[1] {
						國境門那裡也有
						開往帝國和共和國的
						定期巴士。{wait}
					}
					TextWait
					TextTalk char[1] {
						雖然乘坐巴士比較花費時間，
						不過我們也提供利用這種方式
						回國的乘車指南。{wait}
					}
					TextWait
					TextTalk char[1] {
						萬一錯過了列車的乘車時間，
						還請隨時與我們聯絡。{wait}
					}
					TextWait
					FlagSet flag[1]
				else:
					TextTalk char[1] {
						我們也提供乘坐在國境門始發的巴士，
						由陸路回國的乘車指南。{wait}
					}
					TextWait
					TextTalk char[1] {
						萬一錯過了列車的乘車時間，
						還請隨時與我們聯絡。{wait}
					}
					TextWait
			elif !QuestFlagsGet quest[9] 0x10:
				if !flag[1]:
					TextTalk char[1] {
						啊……{wait}
					}
					TextWait
					Emote name[0] 0mm 1700mm 0 1 250ms 2
					SoundPlay sound[29] 0 100 0
					Emote name[1] 0mm 1700mm 0 1 250ms 2
					SoundPlay sound[29] 0 100 0
					Emote name[2] 0mm 1700mm 0 1 250ms 2
					SoundPlay sound[29] 0 100 0
					Emote name[3] 0mm 1700mm 0 1 250ms 2
					SoundPlay sound[29] 0 100 0
					Sleep 1000ms
					TextTalk char[1] {
						……不好意思。
						你們不就是《克洛斯貝爾時報周刊》
						最近报道過的……{wait}
					}
					TextWait
					TextTalk char[1] {
						今天是來處理
						委託的嗎？{wait}
					}
					TextWait
					TextTalk char[1] {
						要找庫瓦特羅先生的話，
						他就在樓上左邊的
						安檢室前等著呢。{wait}
					}
					TextWait
					FlagSet flag[1]
				else:
					TextTalk char[1] {
						今天是來處理
						委託的嗎？{wait}
					}
					TextWait
					TextTalk char[1] {
						要找庫瓦特羅先生的話，
						他就在樓上左邊的
						安檢室前等著呢。{wait}
					}
					TextWait
			elif !flag[1]:
				TextTalk char[1] {
					開往由警備隊駐守的東西國境門方向的
					貨物列車，也是從本站發車的。{wait}
				}
				TextWait
				TextTalk char[1] {
					由於可以直接運輸物資，
					所以警備隊十分仰賴這裡呢。{wait}
				}
				TextWait
				FlagSet flag[1]
			else:
				TextTalk char[1] {
					開往由警備隊駐守的東西國境門方向的
					貨物列車，也是從本站發車的。{wait}
				}
				TextWait
				TextTalk char[1] {
					普通乘客不能乘坐，
					還請多加注意。{wait}
				}
				TextWait
	TextEnd char[1]
	Return

fn[9]:
	Call fn[0,10]
	Return

fn[10]:
	TextStart char[2]
	if flag[1536]:
		if !QuestFlagsGet quest[45] 0x10:
			TextTalk char[2] {
				哎呀……您在趕時間嗎？{wait}
			}
			TextWait
			TextTalk char[2] {
				請不要在月臺上奔走，
				那樣很危險哦。{wait}
			}
			TextWait
		else:
			TextTalk char[2] {
				最近不太平的事情真多。{wait}
			}
			TextWait
			TextTalk char[2] {
				希望乘客們能在
				注意安全的前提下
				享受旅途的樂趣哦。{wait}
			}
			TextWait
	elif !QuestFlagsGet quest[9] 0x10:
		TextTalk char[2] {
			列車內也出售
			飲料和食品。{wait}
		}
		TextWait
		TextTalk char[2] {
			在長途旅行時，
			請多多利用。{wait}
		}
		TextWait
	else:
		TextTalk char[2] {
			在本站乘車的商務人士中，
			有不少人每天都往返於
			帝國和共和國之間。{wait}
		}
		TextWait
		TextTalk char[2] {
			每當想到是這些人
			支撐著克洛斯貝爾的經濟發展，
			就對他們充滿了欽佩之意。{wait}
		}
		TextWait
	TextEnd char[2]
	Return

fn[11]:
	Call fn[0,12]
	Return

fn[12]:
	TextStart char[3]
	if flag[1536]:
		if !QuestFlagsGet quest[45] 0x10:
			if !flag[3]:
				TextTalk char[3] {
					啊……不好意思，
					請稍等片刻。{wait}
				}
				TextWait
				TextSetPos -1 -1 -1 -1
				TextSetName ""
				TextMessage null {
					{0x18}{color 12}……乘客們請注意。{wait}
				} {
					當聽到列車發車的警鈴後，
					請退至安全線後。{wait}
				} {
					有列車駛過時，
					請勿探出身體，
					謝謝合作。{color 0}{wait}
				}
				TextWait
				TextClose 0
				_59
				TextSetPos -1 280 60 3
				FlagSet flag[3]
			else:
				TextTalk char[3] {
					那個……
					總之很危險，
					請不要把身子探出去哦。{wait}
				}
				TextWait
		else:
			TextTalk char[3] {
				我本來是個內向的人，
				但自從當上廣播員之後，
				就變得口齒伶俐了。{wait}
			}
			TextWait
			TextTalk char[3] {
				嘻嘻……
				能在適合自己的崗位上工作，
				實在是太好了。{wait}
			}
			TextWait
	elif !QuestFlagsGet quest[9] 0x10:
		if !flag[3]:
			TextTalk char[3] {
				感謝您
				今天光臨
				克洛斯貝爾車站。{wait}
			}
			TextWait
			TextTalk char[3] {
				除了出售車票，
				本站也提供其它指南服務。{wait}
			}
			TextWait
			TextTalk char[3] {
				如有不明白的地方，
