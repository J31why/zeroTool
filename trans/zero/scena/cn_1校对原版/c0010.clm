	self.5 = 0
	CharFlagsSet self 0x0010
	if !QuestFlagsGet quest[9] 0x10:
		TextTalk self {
			我是從共和國
			搭乘列車過來的，
			但卻把車票弄丟了……{wait}
		}
		TextWait
		TextTalk self {
			唉，不知道站員
			能不能通融一下……{wait}
		}
		TextWait
	else:
		TextTalk self {
			本以為把車票丟了，
			結果居然夾在座位的縫隙裡。{wait}
		}
		TextWait
		TextTalk self {
			呼，太好啦～
			這下就能放心地進入克洛斯貝爾啦～！{wait}
		}
		TextWait
	CharSetChipPattern self 0
	TextEnd self
	Return

fn[23]:
	TextStart self
