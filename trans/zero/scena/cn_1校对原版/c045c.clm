			在紀念慶典期間
			似乎住在米修拉姆的飯店呢。{wait}
		}
		TextWait
		TextTalk char[2] {
			我只是普通市民，
			實在是效仿不了呢。
			哈哈哈……{wait}
		}
		TextWait
	else:
		TextTalk char[2] {
			豪華客房在
			紀念慶典期間已經客滿了。{wait}
		}
		TextWait
		TextTalk char[2] {
			這種房間平時都沒有人住，
			但一到紀念慶典就不同了。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[11]:
