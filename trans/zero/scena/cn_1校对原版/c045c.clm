fn[12]:
	TextStart self
	if flag[1307]:
		TextTalk char[4] {
			計畫去看的彩虹劇團演出
			也看完了，今天打算
			和女兒悠閒地度過。{wait}
		}
		TextWait
	elif flag[1292]:
		TextTalk char[4] {
			我和女兒去看了
			彩虹劇團的公演。{wait}
		}
		TextWait
		TextTalk char[4] {
			觀賞了那場精彩的演出之後，
			我女兒從今早開始就一直沉浸在演出的餘韻中。{wait}
		}
		TextWait
	elif flag[1282]:
		TextTalk char[4] {
			我們明天要去看
			彩虹劇團的公演。{wait}
		}
		TextWait
		TextTalk char[4] {
			我女兒好像沒什麼興趣……
			不過，只要看過一次，
			她就一定會明白其精彩之處了。{wait}
		}
		TextWait
	elif flag[3]:
		TextTalk char[4] {
			彩虹劇團的舞臺表演實在是太棒了。
			真希望我女兒
			也能體會到那種震撼的感覺呢。{wait}
		}
		TextWait
	else:
		TextTalk char[4] {
			我們是趁著這次的紀念慶典
			來觀看彩虹劇團的
			公演的。{wait}
		}
		TextWait
		TextTalk char[4] {
			我以前也曾看過一次，
			那已經是三年前的事了……{wait}
		}
		TextWait
		TextTalk char[4] {
			這次他們上演了新劇碼，
			就帶女兒一起來看了。{wait}
		}
		TextWait
		FlagSet flag[3]
	TextEnd self
	Return

fn[13]:
	TextStart self
	if flag[1307]:
		TextTalk char[5] {
			我要和爸爸一起去逛歡樂街。{wait}
		}
		TextWait
		TextTalk char[5] {
			不知道有沒有伊莉雅小姐的周邊呢……{wait}
		}
		TextWait
	elif flag[1292]:
		TextTalk char[5] {
			伊莉雅大人……！{wait}
		}
		TextWait
		TextTalk char[5] {
			啊，真是太棒了……！{wait}
		}
		TextWait
	elif flag[1282]:
		TextTalk char[5] {
			克洛斯貝爾的歡樂街真是厲害呀，
			到處都是玩樂的地方。{wait}
		}
		TextWait
		TextTalk char[5] {
			稍微休息一下，
			再出去繼續玩吧！{wait}
		}
		TextWait
	else:
		TextTalk char[5] {
			爸爸一直說精彩精彩的。{wait}
		}
		TextWait
		TextTalk char[5] {
			不過是舞臺表演而已吧，
			能有那麼精彩嗎？{wait}
		}
		TextWait
	TextEnd self
	Return

fn[14]:
	TextStart self
	if flag[1307]:
		TextTalk char[6] {
			我終於回過神時……
			不知不覺，就在賭場
			花掉了相當多的米拉。{wait}
		}
		TextWait
		TextTalk char[6] {
			……那個地方太危險了。{wait}
		}
		TextWait
	elif flag[1292]:
		TextTalk char[6] {
			昨天去了賭場。{wait}
		}
		TextWait
		TextTalk char[6] {
			那種刺激感……
			我似乎明白
			為什麼會有那麼多人喜歡了。{wait}
		}
		TextWait
	elif flag[1282]:
		TextTalk char[6] {
			難得來到克洛斯貝爾，
			我想做些平時做不了的事。{wait}
		}
		TextWait
		TextTalk char[6] {
			賭場會不會很有趣呢？{wait}
		}
		TextWait
	else:
		TextTalk char[6] {
			能找到這麼漂亮的飯店，
			真是太好了。{wait}
		}
		TextWait
		TextTalk char[6] {
			東側大道的那種
			破舊旅店，
			實在是不符合我的個性嘛。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[15]:
	TextStart self
	if flag[1292]:
		if flag[4]:
			TextTalk char[7] {
				#3400F彩虹劇團的
				共和國公演嗎……{wait}
			} {
				要是能實現的話，
				一定會大受歡迎吧。{wait}
			} {
				我已經傳達過這邊的意向了，
				之後就看對方怎麼回應了。{wait}
			}
			TextWait
		else:
			TextTalk char[7] {
				#3400F彩虹劇團的公演
				的確十分精彩。{wait}
			} {
				連我也都
				看到入迷了……
				可以這麼說吧。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F哈哈哈……
				那麼，商談的事情
				怎麼樣了？{wait}
			}
			TextWait
			TextTalk char[7] {
				#3400F只是提了個建議而已，
				之後就看對方怎麼回應了。{wait}
			}
			TextWait
			FlagSet flag[4]
	elif flag[1282]:
		if flag[1469]:
			TextTalk char[7] {
				#3400F在接下來的工作方面，
				似乎還需要
				掌握各種資訊呢。{wait}
			} {
				……但最終還是
				要看對方怎麼回應……{wait}
			} {
				不過，事先做好充分的準備
				總是沒錯的。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F（似乎相當認真呢……）{wait}
			}
			TextWait
		else:
			TextTalk char[7] {
				#3400F哎呀，剛才承蒙關照了。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F霧香小姐……
				原來您住在這家飯店啊。{wait}
			}
			TextWait
			TextTalk name[3] {
				#0300F竟然住在高級飯店的套房，
				真是厲害啊～！{wait}
			}
			TextWait
			TextTalk name[2] {
				#0200F演藝界的職業人士果然層次不同。{wait}
			}
			TextWait
			TextTalk char[7] {
				#3400F呵呵，其實飯店的級別
				對我來說並不重要。{wait}
			} {
				只是這裡的位置
				剛好比較方便罷了。{wait}
			}
			TextWait
			TextTalk name[1] {
				#0100F啊……因為彩虹劇團
				就在眼前吧。{wait}
			}
			TextWait
			TextTalk char[7] {
				#3400F嗯，而且
				風景和視野都是最好的……{wait}
			} {
				明天的公演
				我會好好欣賞一番的。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F哈哈哈……
				請盡情欣賞。{wait}
			}
			TextWait
			FlagSet flag[1469]
	TextEnd self
	Return

fn[16]:
	if global[2] == 8:
		QuestTaskSet quest[70] 2
		TextTalk name[0] {
			#0000F（好，在歡樂街
			　應該探聽得差不多了。）{wait}
		} {
			（接下來是小巷……
			　用同樣方法，繼續探聽情報吧。）{wait}
		}
		TextWait
		global[2] = 0
		FlagSet flag[1483]
	Return
