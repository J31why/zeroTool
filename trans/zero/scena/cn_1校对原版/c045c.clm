fn[7]:
	TextStart char[3]
	if !flag[604]:
		TextTalk char[3] {
			歡迎光臨《千禧飯店》。{wait}
		}
		TextWait
		TextTalk char[3] {
			呵呵，本飯店
			為您提供多種多樣的服務。{wait}
		}
		TextWait
		TextTalk char[3] {
			可以讓您在歡樂之都克洛斯貝爾
			享受完美的一天。{wait}
		}
		TextWait
		_59
		FadeOut 300ms 0x00000000 100
		TextSetPos -1 -1 -1 -1
		SoundPlay sound[828] 0 100 0
		TextSetName ""
		TextMessage null {
			{color 5}在飯店或酒館裡休息
			可以回復ＣＰ。{wait}
		}
		TextWait
		TextMessage null {
			{color 5}在普通酒館裡可以回復ＣＰ１００，
			在高級飯店裡可以回復ＣＰ２００。{wait}
		}
		TextWait
		TextClose 0
		FadeIn 300ms 0x00000000
		TextSetPos -1 280 60 3
		_59
		FlagSet flag[604]
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"對話" // 0
			"休息" // 1
			"放棄" // 2
		MenuWait var[0]
		if var[0] != 1:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			ShopOpen shop[60]
			var[0] = 99
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			if flag[1307]:
				TextTalk char[3] {
					終於到了最終日……
					我們會以滿面笑容恭送
					退房的客人們。{wait}
				}
				TextWait
				TextTalk char[3] {
					衷心期待
					他們明年
					重遊此地。{wait}
				}
				TextWait
			elif flag[1296]:
				TextTalk char[3] {
					我聽到遊行隊伍
					通過時的音樂了。{wait}
				}
				TextWait
				TextTalk char[3] {
					雖然是從小就聽慣了的音樂，
					不過每次一聽到，就總是……
					忍不住興高采烈起來呢。{wait}
				}
				TextWait
				TextTalk char[3] {
					身為總管，雖然應該掩飾這種心情，
					不過，畢竟我身上也流著
					克洛斯貝爾市民的血呢。{wait}
				}
				TextWait
			elif flag[1294]:
				if flag[1364]:
					TextTalk char[3] {
						實在抱歉，
						他應該沒來過本前廳。{wait}
					}
					TextWait
					TextTalk char[3] {
						所有的客人
						我都確認過，
						應該不會弄錯的。{wait}
					}
					TextWait
				else:
					TextTalk name[0] {
						#0000F（嗯，這個人
						　可能知道些什麼吧……）{wait}
					}
					TextWait
					TextSetName ""
					TextMessage null {
						{color 5}羅伊德出示了柯林的照片，
						並詢問對方是否有什麼線索。{color 0}{wait}
					}
					TextWait
					TextClose 0
					_59
					TextTalk char[3] {
						哎呀，好可愛的
						小男孩啊。{wait}
					}
					TextWait
					TextTalk char[3] {
						不過，他應該沒有
						來過本前廳呢。{wait}
					}
					TextWait
					TextTalk name[0] {
						#0000F是這樣啊……
						謝謝您了。{wait}
					}
					TextWait
					FlagSet flag[1364]
					global[2] = global[2] + 1
					Call fn[0,16]
			elif flag[1362]:
				TextTalk char[3] {
					我聽到遊行隊伍
					通過時的音樂了。{wait}
				}
				TextWait
				TextTalk char[3] {
					雖然是從小就聽慣了的音樂，
					不過每次一聽到，就總是……
					忍不住興高采烈起來呢。{wait}
				}
				TextWait
				TextTalk char[3] {
					身為總管，雖然應該掩飾這種心情，
