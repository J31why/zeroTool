fn[10]:
	TextStart self
	if flag[1307]:
		TextTalk char[2] {
			客人退房之後，
			必須要儘快整理好房間。{wait}
		}
		TextWait
		TextTalk char[2] {
			為了順利迎接下一位客人，
			我們這些員工
			必須提高工作速度。{wait}
		}
		TextWait
	elif flag[1362]:
		TextTalk char[2] {
			……唔，朵莉絲似乎
			已經重新打掃過了。
			很不錯，很不錯。{wait}
		}
		TextWait
	elif flag[1292]:
		if flag[1]:
			TextTalk char[2] {
				為了讓客人
				住得舒心，
				美好的空間是必不可少的。{wait}
			}
			TextWait
			TextTalk char[2] {
				即使是紀念慶典也不可鬆懈，
				一定要好好
				提醒朵莉絲才行。{wait}
			}
			TextWait
		else:
			TextTalk char[2] {
				……走廊的掃除
				似乎有點不夠細緻啊。{wait}
			}
			TextWait
			TextTalk char[2] {
				為了讓客人
				住得舒心，
				美好的空間是必不可少的。{wait}
			}
			TextWait
			TextTalk char[2] {
				一定要好好
				提醒朵莉絲才行。{wait}
			}
			TextWait
			FlagSet flag[1]
	elif flag[1282]:
		TextTalk char[2] {
