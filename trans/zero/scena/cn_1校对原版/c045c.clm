				}
				TextWait
				TextTalk char[3] {
					也有出席者
					在本飯店
					預約了房間。{wait}
				}
				TextWait
			else:
				TextTalk char[3] {
					從紀念慶典的第一天開始，
					就有眾多客人入住呢。{wait}
				}
				TextWait
				TextTalk char[3] {
					對各位遊客來說，
					這條歡樂街也是
					值得矚目的景點呢。{wait}
				}
				TextWait
	TextEnd char[3]
	Return

