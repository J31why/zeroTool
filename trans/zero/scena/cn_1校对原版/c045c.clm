					克洛斯貝爾市民的血呢。{wait}
				}
				TextWait
			elif flag[1292]:
				TextTalk char[3] {
					今天的遊行隊伍
					會從頂層豪華客房的
					正下方經過。{wait}
				}
				TextWait
				TextTalk char[3] {
					每到這個時期，
					那裡總是比其它房間
					更早被訂掉呢。{wait}
				}
				TextWait
			elif flag[1282]:
				TextTalk char[3] {
					市政廳那邊
