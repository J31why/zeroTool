fn[7]:
	char[8].51 = 1000
	if system[4] == 3:
		EntranceSetDisabled entrance[0] 0
		EntranceSetDisabled entrance[13] 1
	else:
		EntranceSetDisabled entrance[0] 1
		EntranceSetDisabled entrance[13] 0
	if flag[1037] && !flag[1038]:
		MapColor 0x00C8D2FF 0ms
	elif flag[1792]:
		MapColor 0x00C8D2FF 0ms
	else:
	Return

fn[8]:
	TextStart self
	if flag[1307]:
		TextTalk self {
			今天就是紀念慶典的最後一天了呢。{wait}
		}
		TextWait
		TextTalk self {
			這個慶典本來的目的就是
			慶祝自治州的成立以及和平。{wait}
		}
		TextWait
		TextTalk self {
			今天真想悠閒地度過，
			再好好思考一些事情啊。{wait}
		}
		TextWait
	elif flag[1303]:
		CharTurnToChar self name[0] 0deg/s
		TextTalk self {
			羅伊德，找到
			走失的孩子了嗎？{wait}
		}
		TextWait
		TextTalk self {
			他的父母一定
			也很擔心吧。
			快點幫他們尋找吧。{wait}
		}
		TextWait
		if !flag[0]:
			TextTalk name[0] {
				#0000F嗯，沒關係的，所在地
				暫且也已經找到了……{wait}
			} {
				剛才的事謝謝您了，叔叔。{wait}
			}
			TextWait
		FlagSet flag[0]
	elif flag[1294]:
		if !flag[1385]:
			TextTalk name[0] {
				#0003F（邁爾斯叔叔應該去
				　看了遊行……
				　總之先問問看吧。）{wait}
			} {
				#0000F叔叔，稍微打擾一下可以嗎？
				有些事情想要問您。{wait}
			}
			TextWait
			TextMessage null {
				{color 5}羅伊德出示了柯林的照片，
				並詢問對方是否有什麼線索。{color 0}{wait}
			}
			TextWait
			TextClose 0
			_59
			TextTalk self {
				哎呀，這個孩子是？{wait}
			}
			TextWait
			TextTalk self {
				……果然沒錯呢，
				確實是我剛才遇見過的孩子。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0005F真的嗎……？！{wait}
			}
			TextWait
			TextTalk self {
				嗯，是在東側大道遇見的。
				他險些從後面
				撞到我。{wait}
			}
			TextWait
			TextTalk self {
				之後似乎是向北面
				跑去了。{wait}
			}
			TextWait
			TextTalk name[95] {
				#3308F從東側大道向北的話……
				就是港灣區一帶了呢。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0003F嗯，應該是那樣。{wait}
			} {
				#0000F……叔叔，謝謝您。
				您的情報相當有幫助。{wait}
			}
			TextWait
			FlagSet flag[1385]
			global[2] = global[2] + 1
			Call fn[0,24]
		else:
			TextTalk self {
				確實是我剛才遇到的
				那個活潑的小男孩。{wait}
			}
			TextWait
			TextTalk self {
				我是在東側大道的十字路口見到他的，
				但他之後似乎
				又向北邊跑去了。{wait}
			}
			TextWait
			TextTalk self {
				……走失的孩子啊，還真令人擔心呢……
				羅伊德，請儘快找到他吧。{wait}
			}
			TextWait
	elif flag[1362]:
		TextTalk self {
			哎呀，人真是好多呢。{wait}
		}
		TextWait
		TextTalk self {
			哈哈哈，我已經這麼大年紀了，
			當時都差點迷了路呢。{wait}
		}
		TextWait
	elif flag[1292]:
		TextTalk self {
			我們正準備
			出去看遊行呢。{wait}
		}
		TextWait
		TextTalk self {
			哈哈，約你們去的話，
			終究還是不太方便吧。{wait}
		}
		TextWait
		TextTalk self {
			……工作的時候要小心哦。{wait}
		}
		TextWait
		if !flag[0]:
			TextTalk name[0] {
				#0000F嗯，謝謝您了，叔叔。{wait}
			}
			TextWait
		FlagSet flag[0]
	elif flag[1280]:
		CharTurnToChar self name[0] 0deg/s
		if !flag[0]:
			TextTalk self {
				哦哦，這不是羅伊德嘛。{wait}
			}
			TextWait
			TextTalk self {
				是嗎，你們從今天開始
				就要重新開始工作了啊。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F嗯，因為我們也算是正式的警察啊。{wait}
			} {
				叔叔，
				您是從今天開始休假吧？{wait}
			}
			TextWait
			TextTalk self {
				是啊，我準備和你阿姨一起
				好好逛逛。{wait}
			}
			TextWait
			TextTalk self {
				賽西兒要是能一起去就好了，
				可那孩子非常忙呢。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				慶典期間人那麼多，還要維持秩序，
				警察們很辛苦吧。{wait}
			}
			TextWait
			TextTalk self {
				你們也要適當休息啊，
				可別累壞了。{wait}
			}
			TextWait
	elif flag[526]:
		CharTurnToChar self name[0] 0deg/s
		if !flag[623]:
			TextTalk name[0] {
				#0000F叔叔，
				好久不見。{wait}
			}
			TextWait
			TextTalk self {
				哦？你不是……
				以前住在隔壁的羅伊德嘛！{wait}
			}
			TextWait
			TextTalk self {
				哈哈哈，實在是吃了一驚啊！{wait}
			}
			TextWait
			TextTalk self {
				雖然聽說過你快回來了，……但沒想到你
				都長這麼大了，簡直讓人認不出來了。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0012F呵呵，只是身高長了，
				但內在還是很不成熟呢。{wait}
			}
			TextWait
			TextTalk self {
				沒那回事。
				你不是已經順利
				通過搜查官考試了嗎？{wait}
			}
			TextWait
			TextTalk self {
				蓋一定
				也會為你高興的。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0008F……會嗎？{wait}
			} {
				……如果真是那樣就好了。{wait}
			}
			TextWait
			TextTalk self {
				嗯，一定會的。{wait}
			}
			TextWait
			if !flag[624]:
				TextTalk self {
					對了，去廚房跟你阿姨
					打聲招呼吧。{wait}
				}
				TextWait
				TextTalk self {
					她一定會非常高興的。{wait}
				}
				TextWait
				TextTalk name[0] {
					#0000F哈哈哈……也是呢。
					那我這就去。{wait}
				}
				TextWait
			else:
				TextTalk self {
					我經常因為工作不在家，
					不過你阿姨一般都在。{wait}
				}
				TextWait
				TextTalk self {
					如果有什麼需要幫忙的，
					……就過去找她哦。{wait}
				}
				TextWait
				TextTalk name[0] {
					#0000F嗯，那又要麻煩兩位了。{wait}
				}
				TextWait
			FlagSet flag[623]
		elif !flag[0]:
			TextTalk self {
				你竟然都
				長這麼大啦……
				哈哈，我也上年紀了。{wait}
			}
			TextWait
			TextTalk self {
				你跟賽西兒聯絡過了嗎？{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F嗯，用導力通訊聯絡過了。{wait}
			} {
				本來我想趁著這次休假
				去見見她的……{wait}
			}
			TextWait
			TextTalk self {
				是嗎。
				嗯，那就好。{wait}
			}
			TextWait
			TextTalk self {
				不管怎樣，你對我們來說，就跟家人一樣。
				你回來我就放心了。{wait}
			}
			TextWait
			TextTalk self {
				我經常因為工作不在家，
				不過你阿姨一般都在。{wait}
			}
			TextWait
			TextTalk self {
				如果有什麼需要幫忙的，
				……就來找你阿姨哦。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				我們都把你當成家人，
				如果有什麼需要幫忙的，
				……就來找你阿姨哦。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[9]:
	TextStart self
	if !flag[768] && !flag[624]:
		Call fn[0,25]
		TextEnd self
		Return
	if flag[1024] && !flag[1280] && !flag[1150]:
		TextTalk name[0] {
			#0000F阿姨，好久不見了。{wait}
		} {
			#0006F……不好意思，最近我有點忙，
			好像很久沒來打招呼了。{wait}
		}
		TextWait
		TextTalk self {
			啊，這不是羅伊德嘛。{wait}
		}
		TextWait
		TextTalk self {
			聽說你們最近
			很活躍啊。{wait}
		}
		TextWait
