fn[4]:
	while 1:
		CharIdle self (-57640, null, 109480) (-58760, null, 108520) 300mm/s
		Sleep 1200ms
		var[2] = random % 5
		if var[2] == 0:
			Sleep 500ms
		elif var[2] == 1:
			Sleep 800ms
	Return

