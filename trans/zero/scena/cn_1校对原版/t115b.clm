fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharIdle self (-2140, null, -3060) (2250, null, 2240) 1000mm/s
		Sleep 300ms
	Return

fn[2]:
	if flag[1333]:
	elif flag[1330]:
	elif flag[1329]:
		CharFlagsUnset char[0] 0x0080
		ForkFunc char[0] fork[0] fn[0,1]
	elif flag[1320]:
	Return

fn[3]:
	TriggerFlagsSet trigger[0] 0x0080
	TriggerFlagsSet trigger[1] 0x0080
	if flag[1320] && !flag[1326]:
		TriggerFlagsUnset trigger[0] 0x0080
	if flag[1335] && !flag[1336]:
		TriggerFlagsUnset trigger[1] 0x0080
	if flag[1333]:
	SoundPlay sound[124] 1 100 0
	Return

fn[4]:
	TextStart self
	if !flag[0]:
		TextTalk self {
			還有一些時間，
			所以我正在參觀這座宅邸。{wait}
		}
		TextWait
		TextTalk self {
			話說回來，這設備真是好驚人啊……{wait}
		}
		TextWait
		TextTalk self {
			能感受到哈爾特曼議長那
			令人難以想像的權威呢。{wait}
		}
		TextWait
		FlagSet flag[0]
	else:
		TextTalk self {
			話說回來，這設備真是好驚人啊……{wait}
		}
		TextWait
		TextTalk self {
			議長宅邸想必也是由
			著名建築家設計的吧。{wait}
		}
		TextWait
	TextEnd self
	Return

