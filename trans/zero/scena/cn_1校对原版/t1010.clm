fn[9]:
	TextStart self
	if flag[1333]:
	elif flag[1330]:
	elif flag[1329]:
	elif flag[1320]:
	elif flag[1319]:
	elif flag[1318]:
		TextTalk self {
			喂喂，
			不要穿成這樣
			走進住宅區。{wait}
		}
		TextWait
		TextTalk self {
			每個人的穿著打扮
			都要與自己所在的場所相襯。{wait}
		}
		TextWait
		TextTalk self {
			你們至少也該去時裝店
			換身像樣的衣服再來吧。{wait}
		}
		TextWait
	elif flag[1312]:
		if !flag[1]:
			TextTalk self {
				……哎呀呀。{wait}
			}
			TextWait
			TextTalk self {
				幾位平民，
				來高級住宅區有何貴幹呢？{wait}
			}
			TextWait
			TextTalk self {
				要觀光的話，
				還是到主題樂園去吧。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				要觀光的話，
				還是到主題樂園去吧。{wait}
			}
			TextWait
			TextTalk self {
				你們這些平民，即使看了我等貴族的住宅，
				也只有眼紅羨慕的份吧？{wait}
			}
			TextWait
	elif flag[1307]:
	TextEnd self
	Return

