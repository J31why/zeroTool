			}
			TextWait
			TextTalk self {
				這樣一來，會議大概就要
				繼續延長下去了吧……{wait}
			}
			TextWait
	elif flag[1342]:
		if (QuestFlagsGet quest[32] 0x10 | flag[636]) && !flag[1535]:
			if QuestFlagsGet quest[32] 0x10:
				TextTalk self {
					哎呀……是你們啊。
					在紀念慶典期間，真是麻煩你們了。{wait}
				}
				TextWait
				if QuestTaskGet quest[32] 14:
					TextTalk name[0] {
						#0000F哪裡，並不是什麼值得您道謝的事情。
						對警官來說，那只是理所當然的分內之事。{wait}
					}
					TextWait
					if PartyPosition name[1] > -1:
						TextTalk name[1] {
							#0100F不管怎麼說，能順利解決就很好了。{wait}
						}
						TextWait
					elif PartyPosition name[2] > -1:
						TextTalk name[2] {
							#0204F嗯，這大概也算是
							我們實力的體現吧。{wait}
						}
						TextWait
					elif PartyPosition name[3] > -1:
						TextTalk name[3] {
							#0304F嘿，因為我們是傳說中的特務支援課嘛。{wait}
						}
						TextWait
					TextTalk self {
						呵呵，看起來，
						你們還是一樣有精神啊。{wait}
					}
					TextWait
				else:
					TextTalk name[0] {
						#0006F那個時候，我們沒能幫上
