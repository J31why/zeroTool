					}
					TextWait
				TextTalk self {
					話說回來……唔。
					今天還帶著一個小孩子啊。{wait}
				}
				TextWait
				TextTalk self {
					接下來還要去警署嗎？{wait}
				}
				TextWait
			else:
				TextTalk self {
					哎呀……是羅伊德嘛。
					好久不見了啊。{wait}
				}
				TextWait
				TextTalk self {
					唔……今天還帶著
					一個小孩子啊。
					接下來是要去警署嗎？{wait}
				}
				TextWait
			TextTalk name[0] {
				#0000F那個……嗯，算是吧，正要過去一趟呢。
				準備去查一查這個孩子的身份來歷。{wait}
