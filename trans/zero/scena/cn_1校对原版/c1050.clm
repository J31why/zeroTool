		}
		TextWait
		TextTalk self {
			哈，用不著這麼拘束啦。
			也不是什麼了不起的職位。{wait}
		}
		TextWait
		TextTalk name[2] {
			#0200F（從外表根本看不出來呢……）{wait}
		}
		TextWait
		TextTalk name[1] {
			#0104F（工商協會的摩爾斯會長……
			　就是這個人啊。）{wait}
		}
		TextWait
		FlagSet flag[636]
	elif flag[1792]:
	elif flag[1566]:
		if !flag[0]:
			TextTalk self {
				繼昨天的事件之後，
				機場那邊好像也
				發生了麻煩呢。{wait}
			}
			TextWait
			TextTalk self {
				嗯，最近真是
				麻煩不斷啊……{wait}
			}
			TextWait
			TextTalk self {
				或許現在並不是適合召開議會的時候呢。{wait}
