			}
			TextWait
			TextTalk self {
				麥克道爾市長大概又會
				非常操勞了吧。{wait}
			}
			TextWait
			if QuestFlagsGet quest[32] 0x10 | flag[636]:
				if PartyPosition name[1] > -1:
