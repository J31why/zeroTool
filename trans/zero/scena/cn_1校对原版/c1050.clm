					}
					TextWait
					TextTalk name[1] {
						#0100F（他們兩個人以前
						　就有些私交呢。）{wait}
					} {
						#0108F（……我也…………
						　有些擔心議會的事情呢。）{wait}
					}
					TextWait
				elif PartyPosition name[2] > -1:
					TextTalk name[2] {
						#0203F（會長先生他好像
						　很擔心艾莉前輩
