calmare zero_k scena
scena:
	name "c1050" "c1050" "c1050"
	town town[1]
	bgm bgm[100]
	flags 8192
	item_use fn[0,255]
	unk 255 0

entry:
	pos (0, 0, -1000)
	unk1 0
	cam_from (0, 2500, 34000)
	cam_pers 262
	unk2 30
	cam_deg 45deg
	cam_limit 0deg 360deg
	cam_at (0, 0, 0)
	unk3 0
	unk4 0
	flags 0x0001
	town town[1]
	init fn[0,2]
	reinit fn[0,3]

chip[0] "chr/ch20800.itc"
chip[1] "chr/ch20900.itc"
chip[2] "chr/ch20802.itc"

npc char[0]:
	name "摩爾斯老人"
	pos (569, 4019, 7690)
	angle 135deg
	flags 0x0105
	unk2 0
	chip chip[0]
	init fn[0,1]
	talk fn[0,4]
	unk4 255

npc char[1]:
	name "摩爾斯老人"
	pos (-2160, 100, 6829)
	angle 90deg
	flags 0x0185
	unk2 0
	chip chip[2]
	init fn[255,255]
	talk fn[0,5]
	unk4 255

npc char[2]:
	name "帕拉夫人"
	pos (379, 0, 9850)
	angle 0deg
	flags 0x0105
	unk2 0
	chip chip[1]
	init fn[0,0]
	talk fn[0,6]
	unk4 255

fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharIdle self (1410, null, 9460) (-780, null, 4870) 1000mm/s
		Sleep 300ms
	Return

fn[2]:
	if flag[1792]:
		CharFlagsSet char[0] 0x0080
		CharFlagsUnset char[1] 0x0080
		CharSetPos char[2] (-2200, 30, 8350) 135deg
		CharFlagsSet char[2] 0x0010
	elif flag[1566]:
	elif flag[1554]:
	elif flag[1536]:
	elif flag[1342]:
	elif flag[1307]:
		CharFlagsSet char[0] 0x0080
	elif flag[1362]:
		CharFlagsSet char[0] 0x0080
	elif flag[1292]:
		CharFlagsSet char[0] 0x0080
	elif flag[1282]:
		CharFlagsSet char[0] 0x0080
	elif flag[1280]:
		CharFlagsSet char[0] 0x0080
		CharFlagsSet char[2] 0x0080
	elif flag[1055]:
		CharFlagsSet char[0] 0x0080
	elif flag[1040]:
		CharFlagsSet char[0] 0x0080
		CharFlagsUnset char[1] 0x0080
	elif flag[1031]:
	elif flag[1024]:
	elif flag[801]:
	elif flag[777]:
	elif flag[768]:
	elif flag[533]:
	elif flag[526]:
	Return

fn[3]:
	if system[4] == 3:
		EntranceSetDisabled entrance[0] 0
		EntranceSetDisabled entrance[1] 1
	else:
		EntranceSetDisabled entrance[0] 1
		EntranceSetDisabled entrance[1] 0
	if flag[1037] && !flag[1038]:
		MapColor 0x00C8D2FF 0ms
	elif flag[1792]:
		MapColor 0x00C8D2FF 0ms
	else:
	Return

fn[4]:
	TextStart self
	if flag[526] && !flag[1280] && !flag[636]:
		CharTurnToChar char[0] name[0] 0deg/s
		if flag[1024]:
			TextTalk self {
				……哦哦，你不就是…在列車上
				曾和我同座的那個小夥子嗎。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0002F啊，是那個時候的老爺爺！
				……哈哈，好久不見了。{wait}
			}
			TextWait
			TextTalk self {
				唔唔，自那之後已經過去兩個月了嗎。{wait}
			}
			TextWait
			TextTalk self {
				說起來，那個時候，
				你好像說是要去任職報到吧。
				工作方面還算順利嗎？{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F嗯，算是吧。
				最近總算開始適應了。{wait}
			}
			TextWait
		elif flag[768]:
			TextTalk self {
				……哦哦，你不就是…在列車上
				曾和我同座的那個小夥子嗎。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0002F啊，是那個時候的老爺爺！
				……哈哈，好久不見了。{wait}
			}
			TextWait
			TextTalk self {
				唔唔，自那之後已經過去兩個月了嗎。{wait}
			}
			TextWait
			TextTalk self {
				說起來，那個時候，
				你好像說是要去任職報到吧。
				工作方面還算順利嗎？{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F嗯，算是吧。
				最近總算開始適應了。{wait}
			}
			TextWait
		else:
			TextTalk self {
				……哦哦，你是那時的小夥子。{wait}
			}
			TextWait
			TextTalk self {
				任職報到的情況怎麼樣啊？{wait}
			}
			TextWait
			TextTalk name[0] {
				#0012F嗯，那個，哈哈哈……
				感覺總算是正式進入狀態了啊……{wait}
			}
			TextWait
		TextTalk self {
			呵呵，和同期入職
			的夥伴們在一起嗎，
			一群年輕人湊在一起，真是很有氣勢啊。{wait}
		}
		TextWait
		TextTalk self {
			呵呵，雖然我幫不上什麼忙，不過，如果
			有需要，就儘管來找我商量吧。{wait}
		}
		TextWait
		TextTalk self {
			我年輕的時候也曾有過經商的經歷，
			還算是有些人脈啊。{wait}
		}
		TextWait
		TextTalk name[0] {
			#0005F哎，是這樣啊。{wait}
		} {
			#0000F順便再請問一下，
			您具體都認識些什麼人呢……？{wait}
		}
		TextWait
		TextTalk self {
			嗯，這個嘛。{wait}
		}
		TextWait
		TextTalk self {
			像克洛斯貝爾的市長啦，
			貿易商團隊的領導啦。{wait}
		}
		TextWait
		TextTalk self {
			還有就是烏爾斯拉醫科大學的
			理事長，全都是我的好友啊。{wait}
		}
		TextWait
		Emote field_party[0] 0mm 2000mm 16 19 250ms 1
		SoundPlay sound[23] 0 100 0
		Emote field_party[1] 0mm 2000mm 16 19 250ms 1
		SoundPlay sound[23] 0 100 0
		Emote field_party[2] 0mm 2000mm 16 19 250ms 1
		SoundPlay sound[23] 0 100 0
		Emote field_party[3] 0mm 2000mm 16 19 250ms 1
		SoundPlay sound[23] 0 100 0
		Sleep 1200ms
		TextTalk name[3] {
			#0303F……羅伊德，這位老爺爺
			好像是個很有來頭的人物啊。{wait}
		}
		TextWait
		TextTalk name[0] {
			#0006F那個，老爺爺，您究竟是……{wait}
		}
		TextWait
		TextTalk self {
			呵呵，我是克洛斯貝爾
