					TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				如今的狀況就是，
				真正出色的政治家
				只剩下麥克道爾市長。{wait}
			}
			TextWait
			TextTalk self {
				議會恐怕又將一片混亂吧……
				但我們也只能在一旁觀望。{wait}
			}
			TextWait
	elif flag[1055]:
	elif flag[1040]:
	elif flag[1031]:
		if !flag[0]:
			TextTalk self {
				下個月會有
				盛大熱鬧的紀念慶典啊。{wait}
			}
			TextWait
			TextTalk self {
				不過，更值得注意的
				還是在那一周之後的
				自治州議會啊。{wait}
			}
			TextWait
			TextTalk self {
				那可是要制定州政府一年中所有計劃的
				重要議會……為了防止議員們謀取私利，
				我們也必須密切關注。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				在紀念慶典之後，
				還要召開預算會議。{wait}
			}
			TextWait
			TextTalk self {
				嗯……對中立派的市長而言，
				那才是真正需要面對的難題吧。
				我們也必須要密切關注才行啊。{wait}
			}
			TextWait
	elif flag[1024]:
		if !flag[0]:
			TextTalk self {
				魯巴徹的那些傢伙們
				被保釋出來了嗎……
				結果還是一如既往地讓人惱火啊。{wait}
			}
			TextWait
			TextTalk self {
				雖然我早就決定過
				不會涉足政治，
				但在這種時候，還是很焦急憤怒啊。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				克洛斯貝爾的政治
				早已被金錢與權力徹底污染了。{wait}
			}
			TextWait
			TextTalk self {
				哎呀呀……每一次都是
				如此讓人失望。{wait}
			}
			TextWait
	elif flag[801]:
		if !flag[0]:
			TextTalk self {
				露天市場上有個
				叫迪因茲的小夥子在賣蔬菜吧。{wait}
			}
			TextWait
			TextTalk self {
				以前曾經幫助過他，在那之後，
