					}
					TextWait
					if PartyPosition name[1] > -1:
						TextTalk name[1] {
							#0103F實在是讓您擔心了。{wait}
						}
						TextWait
					elif PartyPosition name[2] > -1:
						TextTalk name[2] {
							#0203F……當時真是讓您擔心了。{wait}
						}
						TextWait
					elif PartyPosition name[3] > -1:
						TextTalk name[3] {
							#0306F真是沒臉見人啊。{wait}
						}
						TextWait
					TextTalk self {
						哪裡哪裡，你們能夠全力幫忙調查，
