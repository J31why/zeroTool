look_point[0]:
	pos (14590, 0, 4630)
	radius 1000
	bubble_pos (16030, 1500, 6050)
	unk1 126
	unk2 0
	function fn[0,5]
	unk3 0
	unk4 0

fn[0]:
	var[3] = random % 8
	switch var[3]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharWalkToPos self (7200, 0, 370) 1000mm/s 0
		CharWalkToPos self (7280, 30, 1390) 1000mm/s 0
		CharTurnTo self 45deg 500deg/s
		Sleep 1300ms
		CharWalkToPos self (5850, 0, 1930) 1000mm/s 0
		CharWalkToPos self (4730, 0, 3700) 1000mm/s 0
		CharWalkToPos self (4840, 0, 5570) 1000mm/s 0
		CharTurnTo self 315deg 500deg/s
		Sleep 1500ms
		CharWalkToPos self (5660, 0, 5540) 1000mm/s 0
		CharWalkToPos self (10470, 0, 10350) 1000mm/s 0
		CharTurnTo self 0deg 500deg/s
		Sleep 1200ms
		CharWalkToPos self (12980, 0, 7230) 1000mm/s 0
		CharWalkToPos self (12730, 0, 2100) 1000mm/s 0
		CharWalkToPos self (13200, 0, 1420) 1000mm/s 0
		CharTurnTo self 90deg 500deg/s
		Sleep 1600ms
		CharWalkToPos self (12280, 0, 680) 1000mm/s 0
		CharWalkToPos self (11230, 0, 110) 1000mm/s 0
		CharWalkToPos self (8930, 30, -1570) 1000mm/s 0
		Sleep 1400ms
		CharWalkToPos self (8720, 0, -510) 1000mm/s 0
	Return

fn[2]:
	while 1:
		CharIdle self (-49770, null, -54850) (-51170, null, -57050) 1000mm/s
	Return

fn[3]:
	if flag[1792]:
		CharSetPos char[1] (11180, 0, 15810) 0deg
		CharFlagsSet char[5] 0x0080
		CharFlagsUnset char[4] 0x0080
		CharFlagsSet char[7] 0x0080
	elif flag[1566]:
		CharSetPos char[1] (12310, 0, -1990) 225deg
		ForkFunc char[1] fork[0] fn[0,1]
		CharSetPos char[2] (-103790, 0, -55180) 180deg
		ForkFunc char[2] fork[0] fn[0,0]
		CharFlagsSet char[5] 0x0080
		CharFlagsSet char[7] 0x0080
		CharFlagsUnset char[4] 0x0080
		CharFlagsUnset char[6] 0x0080
	elif flag[1554]:
		CharFlagsSet char[0] 0x0010
	elif flag[1536]:
		CharFlagsUnset char[14] 0x0080
		CharFlagsUnset char[15] 0x0080
		CharFlagsSet char[14] 0x0010
		if QuestFlagsGet quest[42] 0x10:
			CharSetPos char[14] (-100320, 30, -56530) 180deg
			CharSetPos char[15] (-101160, 30, -55430) 180deg
			CharFlagsSet char[15] 0x0010
	elif flag[1342]:
		CharSetPos char[0] (16030, 0, 6050) 270deg
		CharSetPos char[1] (12310, 0, -1990) 225deg
		ForkFunc char[1] fork[0] fn[0,1]
		CharFlagsUnset char[10] 0x0080
		CharFlagsUnset char[11] 0x0080
		CharFlagsUnset char[14] 0x0080
		CharFlagsUnset char[15] 0x0080
		if flag[1434] && flag[1346]:
			CharFlagsSet char[2] 0x0080
		else:
			CharSetPos char[2] (13950, 0, 6940) 135deg
			ForkFunc char[2] fork[0] fn[0,0]
	elif flag[1055]:
		CharSetPos char[2] (4960, 0, 9080) 270deg
		ForkFunc char[2] fork[0] fn[0,0]
		CharFlagsUnset char[16] 0x0080
		CharFlagsUnset char[17] 0x0080
		CharSetChipPattern char[17] 1
		CharSetChipBase char[22] chip[21]
		CharSetChipPattern char[22] 15
		CharSetPos char[22] (4000, 600, 7100) 0deg
		CharFlagsUnset char[22] 0x0080
		CharFlags2Unset char[22] 0x8000
		CharSetChipBase char[23] chip[21]
		CharSetChipPattern char[23] 15
		CharSetPos char[23] (3300, 600, 8000) 0deg
		CharFlagsUnset char[23] 0x0080
		CharFlags2Unset char[23] 0x8000
	elif flag[1040]:
		CharFlagsUnset char[16] 0x0080
		CharFlagsUnset char[17] 0x0080
	elif flag[1031]:
	elif flag[1024]:
	elif flag[801]:
		CharFlagsUnset char[18] 0x0080
		CharFlagsUnset char[19] 0x0080
		if QuestFlagsGet quest[12] 0x10:
			CharSetPos char[18] (-49440, 30, -56190) 270deg
			CharSetPos char[19] (-51000, 30, -56190) 90deg
			ForkFunc char[18] fork[0] fn[0,0]
		elif !QuestFlagsGet quest[12] 0x02:
			CharFlagsSet char[19] 0x0010
		else:
			CharTurnTo char[19] 45deg 0deg/s
	elif flag[777]:
		CharFlagsUnset char[9] 0x0080
		CharFlagsUnset char[18] 0x0080
		CharFlagsUnset char[19] 0x0080
		CharSetPos char[18] (-49800, 20, -53530) 180deg
		CharSetPos char[19] (-50200, 20, -55110) 0deg
		CharFlagsSet char[18] 0x0010
		CharFlagsSet char[19] 0x0010
		ForkFunc char[18] fork[0] fn[0,0]
	elif flag[768]:
		CharFlagsUnset char[12] 0x0080
		CharFlagsSet char[12] 0x0040
		CharSetChipBase char[12] chip[14]
		CharSetChipPattern char[12] 0
		CharSetPos char[12] (3230, 150, 9000) 180deg
		CharFlagsUnset char[13] 0x0080
		ForkFunc char[13] fork[0] fn[0,0]
		CharSetPos char[13] (2020, 0, 9600) 180deg
		CharFlagsUnset char[18] 0x0080
		CharFlagsUnset char[19] 0x0080
	elif flag[532]:
		CharFlagsUnset char[12] 0x0080
		ForkFunc char[12] fork[0] fn[0,0]
		CharFlagsUnset char[13] 0x0080
		ForkFunc char[13] fork[0] fn[0,0]
	elif flag[526]:
	if flag[526] && !flag[768] && flag[664]:
		CharFlagsUnset char[8] 0x0080
	if flag[532] && !flag[533]:
		CharFlagsUnset char[10] 0x0080
	Return

fn[4]:
	if flag[1566]:
		FlagSet flag[8]
	elif flag[1342] && !flag[1536]:
		FlagSet flag[6]
	else:
		FlagSet flag[7]
	if flag[1037] && !flag[1038]:
		MapColor 0x00C8D2FF 0ms
	elif flag[1792]:
		MapColor 0x00C8D2FF 0ms
	else:
	Return

fn[5]:
	if flag[1566]:
		Call fn[0,12]
	elif flag[1342] && !flag[1536]:
		Call fn[0,6]
	else:
		Call fn[0,8]
	Return

fn[6]:
	TextStart char[0]
	if flag[6]:
		var[0] = 99
		while var[0] == 99:
			FadeOut 300ms 0x00000000 100
			Menu menu[0] -1 -1 1
				"對話" // 0
				"購物" // 1
				"休息" // 2
				"放棄" // 3
			MenuWait var[0]
			if var[0] < 1 | var[0] > 2:
				MenuClose menu[0]
				FadeIn 300ms 0x00000000
				FadeWait
			if var[0] == 1:
				ShopOpen shop[52]
				var[0] = 99
			elif var[0] == 2:
				ShopOpen shop[50]
				var[0] = 99
			elif var[0] != 0:
			elif var[0] == 0:
				var[0] = 99
				Call fn[0,7]
	else:
		Call fn[0,7]
	TextEnd char[0]
	Return

fn[7]:
	if flag[1792]:
		if !flag[0]:
			TextTalk char[0] {
				我本來讓那個臨時工在廚房幫忙，
				結果他每次都和來廚房
				拿盤子的珊珊撞在一起。{wait}
			}
			TextWait
			TextTalk char[0] {
				……那個臭小子，該不會
				根本就是故意的吧？{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				我讓那個臨時工去招攬客人了，{wait}
			}
			TextWait
			TextTalk char[0] {
				絕對不會再讓他踏入廚房一步。{wait}
			}
			TextWait
	elif flag[1566]:
		TextTalk char[0] {
			……臨時工只要老實幹活就好。{wait}
		}
		TextWait
	elif flag[1554]:
		if !flag[0]:
			TextTalk char[0] {
				（滋啦滋啦）……{wait}
			}
			TextWait
			TextTalk char[0] {
				今天的湯很不錯哦。{wait}
			}
			TextWait
			CharFlagsUnset char[0] 0x0010
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				這個湯的配方，
				我在共和國時就一直使用，{wait}
			}
			TextWait
			TextTalk char[0] {
				是我們店料理美味的秘訣哦。{wait}
			}
			TextWait
	elif flag[1536]:
		if !flag[0]:
			TextTalk char[0] {
				我開這家店並不完全是
				為了取悅客人，{wait}
			}
			TextWait
			TextTalk char[0] {
				但也並不完全是為了賺錢，{wait}
			}
			TextWait
			TextTalk char[0] {
				……這兩個目的都各占一點。{wait}
			}
			TextWait
			TextTalk char[0] {
				反正我們這裡也不是
				什麼很受歡迎的大酒館。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				開店這種事，賺得差不多也就行了，{wait}
			}
			TextWait
			TextTalk char[0] {
				因為我比較喜歡安靜的店。{wait}
			}
			TextWait
	elif flag[1342]:
		TextTalk char[0] {
			紀念慶典結束後，這裡終於安靜下來了。{wait}
		}
		TextWait
		TextTalk char[0] {
			……而我也能心平氣和地
			經營了。{wait}
		}
		TextWait
	elif flag[1055]:
		TextTalk char[0] {
			如果那些混混敢對珊珊意圖不軌，
			我一定不會饒過他們的～～……{wait}
		}
		TextWait
		TextTalk char[0] {
			珊珊也真是的。{wait}
		}
		TextWait
		TextTalk char[0] {
			根本不需要
			接待那種客人！{wait}
		}
		TextWait
	elif flag[1040]:
		TextTalk char[0] {
			那些傢伙……又來了啊。{wait}
		}
		TextWait
		TextTalk char[0] {
			要是再敢在店裡搗亂，
			我就把他們趕出去！{wait}
		}
		TextWait
		if !flag[0]:
			TextTalk name[0] {
				#0000F（瓦魯多好像
				　經常來這家店啊。）{wait}
			}
			TextWait
			TextTalk name[1] {
				#0100F（店裡的人
				　好像也都見怪不怪了。）{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1031]:
		if !flag[0]:
			TextTalk char[0] {
				我移居到這裡來的時候，
				珊珊還很小。{wait}
			}
			TextWait
			TextTalk char[0] {
				而且這附近
				也沒有與珊珊年紀相仿
				的女孩子。{wait}
			}
			TextWait
			TextTalk char[0] {
				……不過，現在
				她好像終於交了個好朋友哦。{wait}
			}
			TextWait
			TextTalk char[0] {
				我也很開心啊。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
