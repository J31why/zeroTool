fn[35]:
	TextStart self
	if flag[801]:
		if QuestFlagsGet quest[12] 0x10:
			TextTalk self {
				哇～是咪西！
				太可愛了！！{wait}
			}
			TextWait
			TextTalk self {
				大哥哥，
				謝謝你們！{wait}
			}
			TextWait
		elif QuestFlagsGet quest[12] 0x02:
			TextTalk self {
				大哥哥，你們要幫我
				找『咪西』嗎？{wait}
			}
			TextWait
			TextTalk self {
				哇～那我在這裡等喔！{wait}
			}
			TextWait
		else:
			TextTalk self {
				嗚嗚嗚……我還以為
				可以見到『咪西』的……{wait}
			}
			TextWait
	elif flag[777]:
		Call fn[0,34]
	elif flag[768]:
		TextTalk self {
			哇～床也
			好軟啊！{wait}
		}
		TextWait
		TextTalk self {
			還有哦，爸爸
			答應要給我買一個
			我喜歡的東西哦。{wait}
		}
		TextWait
		TextTalk self {
			哇～真期待！{wait}
		}
		TextWait
	TextEnd self
	Return

