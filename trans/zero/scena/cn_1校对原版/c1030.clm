			哇～太棒了！{wait}
		}
		TextWait
		TextTalk char[18] {
			啊哈哈，你可真是
			喜歡『咪西』啊！{wait}
		}
		TextWait
		_Char4B char[18] 255
		_Char4B char[19] 255
	elif flag[768]:
		TextTalk self {
