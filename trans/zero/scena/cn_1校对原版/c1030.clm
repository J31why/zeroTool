			Menu menu[0] -1 -1 1
				"對話" // 0
				"購物" // 1
				"休息" // 2
				"放棄" // 3
			MenuWait var[0]
			if var[0] < 1 | var[0] > 2:
				MenuClose menu[0]
				FadeIn 300ms 0x00000000
				FadeWait
			if var[0] == 1:
				ShopOpen shop[52]
				var[0] = 99
			elif var[0] == 2:
				ShopOpen shop[50]
				var[0] = 99
			elif var[0] != 0:
			elif var[0] == 0:
				var[0] = 99
				Call fn[0,9]
	else:
		Call fn[0,9]
	TextEnd char[1]
	Return

