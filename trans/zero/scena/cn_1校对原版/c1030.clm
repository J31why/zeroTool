fn[34]:
	TextStart self
	if flag[801]:
		if QuestFlagsGet quest[12] 0x10:
			TextTalk self {
				各位，實在非常感謝你們。
				看到兒子這麼高興……{wait}
			}
			TextWait
			TextTalk self {
				我覺得這趟克洛斯貝爾之行算是值了……
				謝謝你讓我的兒子露出笑容，『咪西』！{wait}
			}
			TextWait
			if !flag[17]:
				TextTalk name[3] {
					#0300F（克洛斯貝爾還真是
					　什麼樣的遊客都有啊……）{wait}
				}
				TextWait
				TextTalk name[2] {
					#0200F（如果是為了『咪西』的話，
					　倒是可以理解。）{wait}
				}
				TextWait
				Emote name[0] 0mm 2000mm 16 19 250ms 1
				SoundPlay sound[23] 0 100 0
				Emote name[1] 0mm 2000mm 16 19 250ms 1
				SoundPlay sound[23] 0 100 0
				Emote name[3] 0mm 2000mm 16 19 250ms 1
				SoundPlay sound[23] 0 100 0
				Sleep 1000ms
			FlagSet flag[17]
		elif QuestFlagsGet quest[12] 0x02 && !QuestFlagsGet quest[12] 0x10 && ItemHas item[93] 0 > 0:
			if !flag[880]:
				Call fn[0,32]
			else:
				TextTalk char[18] {
					『咪西』的玩偶……
					請務必
					轉讓給我！{wait}
				}
				TextWait
				FlagSet flag[880]
				var[0] = 0
				Menu menu[0] -1 -1 0
					"【轉讓】" // 0
					"【不轉讓】" // 1
				MenuWait var[0]
				MenuClose menu[0]
				switch var[0]:
					case 0:
						TextEnd char[18]
						EventBegin 0
						ForkQuit char[18] fork[0]
						_Char4A char[18] 255
						_Char4A char[19] 255
						CrossFade 800ms
						CamSetDistance -50420 1400 -54190 0ms
						ED7CamRotate 45deg 22deg 0deg 0ms
						CamPers 420 0ms
						CamZoom 20940 0ms
						CharSetPos name[0] (-51120, 30, -54260) 180deg
						CharSetPos name[1] (-51120, 30, -52840) 180deg
						CharSetPos name[2] (-50000, 30, -54260) 180deg
						CharSetPos name[3] (-50000, 30, -52840) 180deg
						CharSetPos char[18] (-50570, 30, -55800) 0deg
						FadeWait
						Call fn[0,33]
						Return
					case 1:
						TextTalk char[18] {
							這、這樣啊……{wait}
						}
						TextWait
						TextTalk char[18] {
							如果各位改變主意了，
							能不能再來找我呢？
							我不到最後絕不死心……{wait}
						}
						TextWait
						break
		elif QuestFlagsGet quest[12] 0x02:
			TextTalk self {
				沒想到賭場
				的獎品裡就有咪西……{wait}
			}
			TextWait
			TextTalk self {
				不過，我是個
				從來不賭博的人。{wait}
			}
			TextWait
			TextTalk self {
				如果各位方便的話，
				能不能幫我贏回那個玩偶呢……
				我好像太自私了呢。{wait}
			}
			TextWait
		else:
			Call fn[0,31]
	elif flag[777]:
		_Char4A char[18] 255
		_Char4A char[19] 255
		TextTalk char[18] {
			好了，肚子也填飽了。{wait}
