fn[24]:
	EventBegin 1
	if QuestTaskGet quest[9] 9:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 0
			"【結束安檢工作，到外面去】" // 0
			"【繼續進行安檢工作】" // 1
		MenuWait var[0]
		MenuClose menu[0]
		FadeIn 300ms 0x00000000
		if var[0] == 0:
			FadeOut 1000ms 0x00000000 255
			FadeWait
			BgmStop 2000ms
			BgmWait
			system[76] = 0
			FlagSet flag[738]
			NewScene "scena/c0800.bin" 0 0 0
			Hcf
		else:
			Sleep 50ms
			CharSetPos field_party[0] (2000, 0, -7850) 270deg
			EventEnd 4
	else:
		TextTalk name[0] {
			#0001F……安檢工作還沒有完成，
			現在還不能離開列車啊。{wait}
		}
		TextWait
		Sleep 50ms
		CharSetPos field_party[0] (2000, 0, -7850) 270deg
		EventEnd 4
	Return

