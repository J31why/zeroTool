label[1]:
	name "主題樂園方向"
	pos (-5000.0, 0.0, 20000.0)
	unk1 0
	unk2 0

fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if flag[736]:
		FlagUnset flag[736]
		Event fn[0,13]
	Return

fn[2]:
	SoundPlayContinuously sound[885] (37600, 4000, 17620) 90000 60000 100 0
	ED7_E1 (-2490, 4000, 10240)
	ED7_E1 (-77760, 4000, 18030)
	SoundPlay sound[918] 1 100 0
	Return

fn[3]:
	TextStart self
	TextTalk self {
		看到煙火了嗎？{wait}
	}
	TextWait
	TextTalk self {
		為了讓整個米修拉姆的人都能看到，
		特意放得很高呢。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[4]:
	TextStart self
	TextTalk self {
		裡面現在正在進行
		夜間遊行呢。{wait}
	}
	TextWait
	TextTalk self {
		以咪西為代表，
		主題樂園的吉祥物
		正在熱熱鬧鬧地巡遊。{wait}
	}
	TextWait
	TextTalk self {
		這是只有入園者才能
		享受到的樂趣。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[5]:
	TextStart self
	if !flag[0]:
		TextTalk self {
			雲霄飛車也
			非常好玩！{wait}
		}
		TextWait
		TextTalk self {
			#4S『嗖』地一下！！！！{wait}
		}
		TextWait
		TextTalk self {
			……那種感覺真是難以形容！{wait}
		}
		TextWait
		FlagSet flag[0]
	else:
		TextTalk self {
			雲霄飛車太棒了！
			景色瞬間就
			飛到身後了呢！{wait}
		}
		TextWait
	TextEnd self
	Return

fn[6]:
	TextStart self
	TextTalk self {
		……………………{wait}
	}
	TextWait
	TextTalk self {
		唔哇……{wait}
	}
	TextWait
	TextEnd self
	Return

fn[7]:
	TextStart self
	if !flag[1]:
		TextTalk self {
			我老公真是的，明明很怕
			乘坐這種刺激型的娛樂設施，
			還非要硬著頭皮上去。{wait}
		}
		TextWait
		TextTalk self {
			但是，已經好久沒有全家同樂了，
			真是非常開心啊。{wait}
		}
		TextWait
		TextTalk self {
			必須要感謝
			在百忙之中抽出時間
			的老公呢。{wait}
		}
		TextWait
		FlagSet flag[1]
	else:
		TextTalk self {
			孩子好像也玩得很高興。
			呵呵，必須要感謝老公啊。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[8]:
	TextStart self
	if !flag[2]:
		TextTalk self {
			（迷迷糊糊）……{wait}
		}
		TextWait
		FlagSet flag[2]
	else:
		TextTalk self {
			（昏昏欲睡）……{wait}
		}
		TextWait
	TextEnd self
	Return

fn[9]:
	TextStart self
	if !flag[3]:
		TextTalk self {
			哎呀呀，兒子好像玩得太興奮，
			已經精疲力盡了呢。{wait}
		}
		TextWait
		FlagSet flag[3]
	else:
		CharTurnToChar self char[5] 0deg/s
		TextTalk self {
			喂，再堅持一下啊，
			水上巴士馬上就要來了。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[10]:
	TextStart null
	TextSetName ""
	TextMessage null {
		{color 5}主題樂園的遊覽圖上
		畫得很清楚。{wait}
	} {
		在這片廣大的場地中，
		建有各式各樣的
		娛樂設施。{wait}
	}
	TextWait
	TextClose 0
	_59
	TextEnd null
	Return

fn[11]:
	TextStart null
	FadeOut 300ms 0x00000000 100
	TextSetName ""
	TextSetPos -1 -1 -1 -1
	TextMessage null {
		{color 5}   ～致各位遊客～
		本主題樂園
		嚴令禁止不正當行為
		以及攜帶危險品。
		請各位帶著小孩的
		家長務必看管好
		自己的孩子。{wait}
	}
	TextWait
	TextClose 0
	FadeIn 300ms 0x00000000
	_59
	TextSetPos -1 280 60 3
	TextEnd null
	Return

fn[12]:
	EventBegin 1
	if !flag[4]:
		TextTalk name[0] {
			#5003F主題樂園那邊好像
			很熱鬧啊……{wait}
		} {
			#5000F不過，這次沒時間遊玩了。
			差不多也做好準備了，
			我們這就去拍賣會場吧。{wait}
		}
		TextWait
		if !flag[1354]:
			TextTalk name[2] {
				#0203F……明白。{wait}
			}
			TextWait
		else:
			TextTalk name[2] {
				#5403F……明白。{wait}
			}
			TextWait
		if !flag[1353]:
			TextTalk name[1] {
				#0100F遲到就不好了呢。{wait}
			}
			TextWait
		else:
			TextTalk name[1] {
				#5300F遲到就不好了呢。{wait}
			}
			TextWait
		if !flag[1355]:
			TextTalk name[3] {
				#0300F好，走吧。{wait}
			}
			TextWait
		else:
			TextTalk name[3] {
				#5600F好，走吧。{wait}
			}
			TextWait
		FlagSet flag[4]
	else:
		TextTalk name[0] {
			#5000F這次沒時間去
			主題樂園玩了……{wait}
		} {
			差不多也做好準備了，
			我們這就去拍賣會場吧。{wait}
		}
		TextWait
	Sleep 50ms
	CharSetPos field_party[0] (0, 4400, -1250) 180deg
	EventEnd 4
	Return

fn[13]:
	EventBegin 0
	FadeOut 0ms 0x00000000 255
	FadeIn 1000ms 0x00000000
	FadeWait
	FadeOut 1000ms 0x00000000 255
	FadeWait
	FlagSet flag[736]
	NewScene "scena/t105b.bin" 0 0 0
	Hcf
	Return
