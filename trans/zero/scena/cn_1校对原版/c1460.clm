fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		ED7_A0 self 1000ms 0 251
	Return

fn[2]:
	while 1:
		ED7CharAnimation self 1500ms 0 1 2 3 4 3 2 1
	Return

fn[3]:
	while 1:
		ED7CharAnimation self 1500ms 0 1 2 3 4 5
	Return

fn[4]:
	if flag[1280]:
	elif flag[1024]:
		CharFlagsSet char[9] 0x0080
		CharFlagsSet char[10] 0x0080
		CharFlagsSet char[11] 0x0080
		CharFlagsSet char[12] 0x0080
		CharFlagsSet char[13] 0x0080
		CharFlagsSet char[14] 0x0080
		CharFlagsSet char[15] 0x0080
		CharFlagsSet char[16] 0x0080
		CharFlagsSet char[17] 0x0080
	elif flag[801]:
		if QuestFlagsGet quest[10] 0x10:
		elif QuestTaskGet quest[10] 4:
			CharFlagsUnset char[1] 0x0080
			CharFlagsUnset char[2] 0x0080
		elif flag[886] && !QuestTaskGet quest[10] 2:
			Event fn[0,14]
		if QuestFlagsGet quest[10] 0x10:
			CharFlagsSet char[9] 0x0080
			CharFlagsSet char[10] 0x0080
			CharFlagsSet char[11] 0x0080
			CharFlagsSet char[12] 0x0080
			CharFlagsSet char[13] 0x0080
			CharFlagsSet char[14] 0x0080
			CharFlagsSet char[15] 0x0080
			CharFlagsSet char[16] 0x0080
			CharFlagsSet char[17] 0x0080
		else:
			if flag[887]:
				CharFlagsSet char[9] 0x0080
			if flag[888]:
				CharFlagsSet char[10] 0x0080
			if flag[889]:
				CharFlagsSet char[11] 0x0080
			if flag[890]:
				CharFlagsSet char[12] 0x0080
			if flag[891]:
				CharFlagsSet char[13] 0x0080
	Return

fn[5]:
	if system[4] == 3:
		EntranceSetDisabled entrance[0] 0
		EntranceSetDisabled entrance[25] 1
	else:
		EntranceSetDisabled entrance[0] 1
		EntranceSetDisabled entrance[25] 0
	if flag[1037] && !flag[1038]:
		MapColor 0x00C8D2FF 0ms
	elif flag[1792]:
		MapColor 0x00C8D2FF 0ms
	else:
	if !flag[2187]:
		ObjFrame object[9] 0
	else:
		ObjFrame object[9] 30
	if !flag[2188]:
		ObjFrame object[10] 0
	else:
		ObjFrame object[10] 30
	if !flag[2189]:
		ObjFrame object[11] 0
	else:
		ObjFrame object[11] 30
	if !flag[2190]:
		ObjFrame object[12] 0
	else:
		ObjFrame object[12] 30
	if !flag[2191]:
		ObjFrame object[13] 0
	else:
		ObjFrame object[13] 30
	TriggerFlagsSet trigger[0] 0x0080
	TriggerFlagsSet trigger[1] 0x0080
	TriggerFlagsSet trigger[2] 0x0080
	if QuestTaskGet quest[10] 4:
		ED7_76_0 object[255] "CA02" 1
		ED7_76_0 object[255] "model5" 1
		ED7_76_1 object[255] "break" 1
		ED7_76_0 object[255] "CA03" 1
		ED7_76_0 object[255] "all01" 1
		ED7_76_1 object[255] "CA02" 2
		ED7_76_1 object[255] "model5" 2
	else:
		ED7_76_1 object[255] "model5" 1
		ED7_76_0 object[255] "CA03" 1
		ED7_76_0 object[255] "break" 1
		ED7_76_0 object[255] "CA02" 1
		ED7_76_0 object[255] "all11" 1
		ED7_76_1 object[255] "CA03" 2
		ED7_76_1 object[255] "break" 2
	if flag[1024]:
		if !QuestTaskGet quest[10] 4:
			ED7_76_0 object[255] "CA02" 1
			ED7_76_0 object[255] "model5" 1
			ED7_76_1 object[255] "break" 1
			ED7_76_0 object[255] "CA03" 1
			ED7_76_0 object[255] "all01" 1
			ED7_76_1 object[255] "CA02" 2
			ED7_76_1 object[255] "model5" 2
	elif flag[801]:
		if QuestFlagsGet quest[10] 0x10:
		elif QuestTaskGet quest[10] 6:
			EntranceSetFunc entrance[0] fn[0,28]
			if system[0] == 124:
				if !flag[3]:
					FlagSet flag[3]
					Event fn[0,22]
			elif system[0] == 118:
				if !flag[2]:
					FlagSet flag[2]
					ED7_E0 0
					CharFlagsSet char[9] 0x0080
					CharFlagsSet char[10] 0x0080
					CharFlagsSet char[11] 0x0080
					CharFlagsSet char[12] 0x0080
			else:
				FlagUnset flag[3]
				FlagUnset flag[2]
		elif flag[904]:
			EntranceSetFunc entrance[0] fn[0,28]
			TriggerFlagsUnset trigger[2] 0x0080
			if system[0] == 118:
				if !flag[2]:
					FlagSet flag[2]
					ED7_E0 0
					CharFlagsSet char[9] 0x0080
					CharFlagsSet char[10] 0x0080
					CharFlagsSet char[11] 0x0080
					CharFlagsSet char[12] 0x0080
			else:
				FlagUnset flag[2]
		elif QuestTaskGet quest[10] 4:
			EntranceSetFunc entrance[0] fn[0,28]
			TriggerFlagsUnset trigger[1] 0x0080
		elif QuestTaskGet quest[10] 3:
			TriggerFlagsUnset trigger[0] 0x0080
		elif flag[886]:
			if flag[887] && flag[888] && flag[889] && flag[890] && flag[891]:
				if system[0] == 109 | system[0] == 111 | system[0] == 113:
					Event fn[0,15]
				elif system[0] == 101 | system[0] == 103 | system[0] == 107:
					Event fn[0,16]
	Call fn[0,6]
	Return

fn[6]:
