	TextTalk name[0] {
		#0000F#5P好，總算是搞定了。{wait}
	}
	TextWait
	TextTalk name[3] {
		#0304F#12P不過，和那個叫亞里歐斯的
		遊擊士打倒的那隻相比，還是弱了一些啊。{wait}
	}
	TextWait
	TextTalk name[1] {
		#0102F#11P呵呵，不過，只要我們四人聯手協力，
		今後也一定可以克服任何困難呢。{wait}
	}
	TextWait
