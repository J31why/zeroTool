		ED7CharAnimation self 1500ms 0 1 2 3 4
	Return

fn[2]:
	while 1:
		ED7CharAnimation self 1000ms 0 1 2 3 4 3 2 1
	Return

fn[3]:
	while 1:
		ED7CharAnimation self 1000ms 0 1 2 3 4 5
	Return

fn[4]:
	if flag[519] && !flag[520]:
		Event fn[0,7]
	if flag[736]:
		FlagUnset flag[736]
		Event fn[0,19]
	Return

fn[5]:
	LookPointFlagsSet look_point[0] 0x0001
	if !flag[960]:
		ED7_76_0 object[0] "sign00" 1
		ED7_76_0 object[0] "light00" 1
		LookPointFlagsUnset look_point[0] 0x0001
		ObjFlagsUnset object[0] 0x0010
	else:
		ED7_76_0 object[0] "sign01" 1
		ED7_76_0 object[0] "light01" 1
	EntranceSetFunc entrance[1] fn[255,65535]
	if QuestFlagsGet quest[53] 0x10 && !flag[704]:
		EntranceSetFunc entrance[1] fn[0,25]
	char[8].12 = 128
	char[8].20 = 219
	char[8].13 = 128
	char[8].21 = 219
	char[8].14 = 128
	char[8].22 = 219
	char[8].15 = 128
	char[8].23 = 219
	char[8].16 = 128
	char[8].24 = 219
	char[8].17 = 128
	char[8].25 = 219
	char[8].18 = 128
	char[8].26 = 219
	char[8].19 = 128
	char[8].27 = 219
	char[8].51 = 2500
	char[8].7 = 2500
	if system[4] != 0 | !QuestFlagsGet quest[53] 0x02:
		CharFlagsSet char[8] 0x0080
		TriggerFlagsSet trigger[0] 0x0080
	elif !flag[960]:
		CharFlagsUnset char[8] 0x0080
		TriggerFlagsUnset trigger[0] 0x0080
	SoundPlay sound[128] 1 100 0
	Return

fn[6]:
