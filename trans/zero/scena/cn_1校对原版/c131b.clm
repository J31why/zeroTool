fn[4]:
	ED7_F2 2
	FadeOut 300ms 0x00000000 100
	TextMessage name[742] {
		{color 5}設有可回復導力器的裝置。{color 0}{wait}
	}
	Menu menu[0] -1 -1 1
		"在此地休息" // 0
		"放棄" // 1
	MenuWait var[0]
	MenuClose menu[0]
	TextClose 0
	if var[0] == 0:
		FadeIn 100ms 0x00000000
		Sleep 500ms
		SoundLoad sound[13]
		ED7_74 object[1] 0 30
		SoundPlay sound[7] 0 100 0
		ObjFrame object[1] 0
		ED7ObjPlay object[1] 0 30 0 0
		ObjWait object[1]
		ED7ObjPlay object[1] 31 390 0 32
		Sleep 1000ms
		BgmStop 3000ms
		FadeOut 1000ms 0x00000000 255
		Sleep 700ms
		SoundPlay sound[13] 0 100 0
		FadeWait
		PartySetAttr name[255] 254 0
		CamLookChar field_party[0] 0ms
		ED7_31 1
		Sleep 3500ms
		ObjFrame object[1] 0
		BgmResume
		FadeIn 1000ms 0x00000000
		TextClose 0
		TextEnd null
		Return
	elif var[0] != 0:
		FadeIn 300ms 0x00000000
		TextEnd null
		Return
	Return
	Return

fn[5]:
	TextStart self
	if flag[1853]:
		TextTalk self {
			門前的那些傢伙
			安置了導力炸彈一類的東西。{wait}
		}
		TextWait
		TextTalk self {
			你們將其擊退之後，
			就由我們來負責拆除炸彈！{wait}
		}
		TextWait
		TextTalk self {
			……一定要十分小心啊，
			願女神保佑你們！{wait}
		}
		TextWait
	elif !flag[0]:
		TextTalk self {
			你們來的這一路似乎也歷經磨難呢……{wait}
		}
		TextWait
		TextTalk self {
			這裡就交給我們
			保全人員好了。{wait}
		}
		TextWait
		TextTalk self {
			只要待在ＩＢＣ裡，就保證絕對
			沒人能碰你們一根手指頭！{wait}
		}
		TextWait
		FlagSet flag[0]
	else:
		TextTalk self {
			外面有保全人員在，
			已經做好萬全的警備了。{wait}
		}
		TextWait
		TextTalk self {
			不用擔心，
			這裡就交給我們！{wait}
		}
		TextWait
	TextEnd self
	Return

