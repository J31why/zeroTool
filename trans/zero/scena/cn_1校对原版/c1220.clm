	function fn[0,16]
	unk3 0
	unk4 0

fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if flag[1792]:
		CharFlagsSet char[2] 0x0080
	elif flag[1566]:
		CharSetPos char[1] (3100, 20, -890) 90deg
		CharFlagsSet char[1] 0x0010
		CharFlagsSet char[2] 0x0080
	elif flag[1560]:
		CharFlagsUnset char[3] 0x0080
		CharFlagsUnset char[3] 0x0080
		CharFlags2Unset char[3] 0x8000
		CharSetPos char[3] (820, 0, 220) 0deg
		CharFlagsUnset char[3] 0x0040
		ForkFunc char[3] fork[0] fn[0,0]
		CharFlagsSet char[2] 0x0010
	elif flag[1554]:
	elif flag[1536]:
		CharFlagsSet char[2] 0x0080
	elif flag[1342]:
		CharFlagsSet char[2] 0x0080
	elif flag[1307]:
	elif flag[1362]:
	elif flag[1292]:
		CharFlagsSet char[2] 0x0080
	elif flag[1282]:
		CharFlagsSet char[2] 0x0080
	elif flag[1281]:
		CharFlagsSet char[2] 0x0080
		CharFlagsSet char[1] 0x0010
	elif flag[1280]:
		CharFlagsSet char[2] 0x0080
	elif flag[1055]:
	elif flag[1040]:
	elif flag[1031]:
		CharTurnTo char[2] 270deg 0deg/s
		CharFlagsSet char[2] 0x0010
		CharSetPos char[1] (-2140, 0, 450) 90deg
		CharFlagsSet char[1] 0x0010
	elif flag[1024]:
		CharFlagsUnset char[3] 0x0080
		CharFlagsSet char[3] 0x0010
		CharFlagsSet char[3] 0x0040
		CharSetChipBase char[3] chip[3]
		CharSetChipPattern char[3] 0
		CharFlagsUnset char[3] 0x0080
		CharFlags2Unset char[3] 0x8000
		CharSetPos char[3] (470, 0, 56880) 180deg
	elif flag[801]:
		CharTurnTo char[2] 270deg 0deg/s
		CharSetPos char[1] (-2140, 0, 450) 90deg
		CharFlagsSet char[1] 0x0010
	elif flag[777]:
	elif flag[768]:
		CharFlagsUnset char[3] 0x0080
		CharFlagsUnset char[3] 0x0080
		CharFlags2Unset char[3] 0x8000
		CharSetPos char[3] (3580, 0, 60060) 90deg
		ForkFunc char[3] fork[0] fn[0,0]
		CharFlagsSet char[3] 0x0010
		CharTurnTo char[1] 270deg 0deg/s
	elif flag[533]:
		CharFlagsSet char[2] 0x0080
		CharFlagsSet char[1] 0x0010
	else:
		CharFlagsSet char[2] 0x0080
	Return

fn[2]:
	LookPointFlagsSet look_point[1] 0x0001
	if QuestTaskGet quest[34] 5 && !QuestFlagsGet quest[34] 0x40 && !flag[1342]:
		LookPointFlagsUnset look_point[1] 0x0001
	if system[4] == 3:
		EntranceSetDisabled entrance[0] 0
		EntranceSetDisabled entrance[5] 1
	else:
		EntranceSetDisabled entrance[0] 1
		EntranceSetDisabled entrance[5] 0
	if flag[1037] && !flag[1038]:
		MapColor 0x00C8D2FF 0ms
	elif flag[1792]:
		MapColor 0x00C8D2FF 0ms
	else:
	TriggerFlagsSet trigger[0] 0x0080
	if flag[525]:
		TriggerFlagsUnset trigger[0] 0x0080
	if flag[1566] && !flag[1792]:
		LookPointFlagsSet look_point[0] 0x0001
	Return

fn[3]:
	field_party[0].5 = char[0].4
	char[0].5 = char[0].4
	TextStart char[0]
	CharFlagsUnset char[0] 0x0010
	CharTurnToChar char[0] field_party[0] 0deg/s
	char[0].4 = (char[0].4 + 360) % 360
	char[0].4 = char[0].4 + 360 - char[0].5
	char[0].5 = char[0].4 / 180
	if char[0].4 <= 45 | char[0].4 >= 315 && char[0].4 <= 405 | char[0].4 >= 675:
	elif char[0].5 < 1:
		char[0].8 = 2
	elif char[0].5 > 2:
		char[0].8 = 1
	else:
		char[0].8 = char[0].5
	char[0].4 = field_party[0].5
	field_party[0].5 = 0
	char[0].5 = 0
	CharFlagsSet char[0] 0x0010
	if flag[1280] && !flag[1342]:
		Call fn[0,4]
	else:
		Call fn[0,6]
	CharSetChipPattern char[0] 0
	TextEnd char[0]
	Return

fn[4]:
	if QuestFlagsGet quest[24] 0x10:
		if flag[5]:
			TextTalk char[0] {
				各位，
				真是辛苦了。{wait}
			}
			TextWait
			TextTalk char[0] {
				格蕾絲小姐好像
				也非常高興，
				真是太好了。{wait}
			}
			TextWait
		else:
			Call fn[0,6]
	elif QuestTaskGet quest[24] 1:
		var[0] = 99
		while var[0] == 99:
			Menu menu[0] -1 -1 1
				"【對話】" // 0
				"【交付照片】" // 1
				"【放棄】" // 2
			MenuWait var[0]
			if var[0] == 0:
				MenuClose menu[0]
				if flag[5]:
					TextTalk char[0] {
						這期的觀光指南企劃案
						是格蕾絲小姐提出的。{wait}
					}
					TextWait
					TextTalk char[0] {
						為了刊物的順利出版，
						無論如何，請多多加油啊。{wait}
					}
					TextWait
				else:
					Call fn[0,6]
				var[0] = 99
			elif var[0] == 1:
				MenuClose menu[0]
				var[3] = 0
				if QuestTaskGet quest[24] 2:
					var[3] += 1
				if QuestTaskGet quest[24] 3:
					var[3] += 1
				if QuestTaskGet quest[24] 4:
					var[3] += 1
				if QuestTaskGet quest[24] 5:
					var[3] += 1
				if QuestTaskGet quest[24] 6:
					var[3] += 1
				if QuestTaskGet quest[24] 7:
					var[3] += 1
				if QuestTaskGet quest[24] 8:
					var[3] += 1
				if QuestTaskGet quest[24] 9:
					var[3] += 1
				if QuestTaskGet quest[24] 10:
					var[3] += 1
				if var[3] >= 5:
					Call fn[0,13]
				else:
					TextTalk name[0] {
						#0005F（啊……
						　格蕾絲小姐委託我們拍攝的
						　照片數量是五張以上。）{wait}
					} {
						#0003F（現在手中的照片數量不夠，
						　還不能交付呢……）{wait}
					}
					TextWait
					var[0] = 99
					var[3] = 0
			elif var[0] != 0:
				MenuClose menu[0]
				Return
	elif QuestFlagsGet quest[24] 0x02:
		Call fn[0,11]
	else:
		Call fn[0,6]
	Return

fn[5]:
	field_party[0].5 = char[0].4
	char[0].5 = char[0].4
	TextStart char[0]
	CharFlagsUnset char[0] 0x0010
	CharTurnToChar char[0] field_party[0] 0deg/s
	char[0].4 = (char[0].4 + 360) % 360
	char[0].4 = char[0].4 + 360 - char[0].5
	char[0].5 = char[0].4 / 180
	if char[0].4 <= 45 | char[0].4 >= 315 && char[0].4 <= 405 | char[0].4 >= 675:
	elif char[0].5 < 1:
		char[0].8 = 2
	elif char[0].5 > 2:
		char[0].8 = 1
	else:
		char[0].8 = char[0].5
	char[0].4 = field_party[0].5
	field_party[0].5 = 0
	char[0].5 = 0
	CharFlagsSet char[0] 0x0010
	TextTalk char[0] {
		啊，各位，
		這邊是後臺啊！{wait}
	}
	TextWait
	TextTalk char[0] {
		如果有什麼需要，
		請去櫃檯正面吧。{wait}
	}
	TextWait
	CharSetChipPattern char[0] 0
	TextEnd char[0]
	Return

fn[6]:
	if flag[1792]:
		TextTalk char[0] {
			格蕾絲小姐
			又出去採訪了。{wait}
		}
		TextWait
		TextTalk char[0] {
			雖然她平時也總是帶著
			雷因茲到處去調查採訪，
			不過……{wait}
		}
		TextWait
		TextTalk char[0] {
			今天看上去好像稍微有些嚴肅呢，
			是不是發生了什麼不好的事件啊？{wait}
		}
		TextWait
	elif flag[1566]:
	elif flag[1554]:
		if flag[0]:
			TextTalk char[0] {
				……昨天晚上可真是不得了……{wait}
			}
			TextWait
			TextTalk char[0] {
				……這次的事態不會是由
				格蕾絲小姐的报道造成的吧？{wait}
			}
			TextWait
		else:
			TextTalk char[0] {
				……今天的克洛斯貝爾時報周刊
				臨時休刊了。{wait}
			}
			TextWait
			TextTalk char[0] {
				給讀者們帶來了諸多不便，
				實在是非常抱歉……{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1536]:
		if flag[0]:
			TextTalk char[0] {
				格蕾絲小姐……
				能不能儘量寫一些
				不會惹麻煩的报道啊……{wait}
			}
			TextWait
		else:
			TextTalk char[0] {
				格蕾絲小姐可真是的，
				又寫了那樣的新聞报道……{wait}
			}
			TextWait
			TextTalk char[0] {
				已經連續好幾天都有議員先生
				前來上門問罪……{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1342]:
		TextTalk char[0] {
			紀念慶典結束了，
			最近街上真是很寧靜啊。{wait}
		}
		TextWait
		TextTalk char[0] {
			……不過，從明天開始，
			可能就又要忙起來了。{wait}
		}
		TextWait
	elif flag[1307]:
		TextTalk char[0] {
			今天發行了臨時增刊，
			請大家一定要買來看啊。{wait}
		}
		TextWait
	elif flag[1362]:
		TextTalk char[0] {
			公園那邊好像又有騷亂呢……{wait}
		}
		TextWait
		TextTalk char[0] {
			繼遊行之後，難道
			又要召開什麼活動嗎？{wait}
		}
		TextWait
	elif flag[1292]:
		TextTalk char[0] {
			今天要舉行慶典的重頭戲──
			遊行活動了啊。{wait}
		}
		TextWait
		TextTalk char[0] {
			各位記者都備好相機，
			一溜煙地跑出去报道了。{wait}
		}
		TextWait
		TextTalk char[0] {
			……喜歡這種熱鬧歡快的慶典，
			大概是克洛斯貝爾人的天性吧。{wait}
		}
		TextWait
	elif flag[1282]:
		if !flag[1435]:
			TextTalk char[0] {
				各位……聽說昨天
				發生了不得了的事情呢。{wait}
			}
			TextWait
			TextTalk char[0] {
				雖然具體情況我沒有細問，
				但看格蕾絲小姐那一臉興奮的表情，
				也就基本可以想像得到了。{wait}
			}
			TextWait
			TextTalk name[3] {
				#0300F哈哈，是嗎……{wait}
			}
			TextWait
			TextTalk name[1] {
				#0106F雖然早就做好了
				被曝光的覺悟……{wait}
			} {
				#0100F不過，最後還是給格蕾絲小姐
				提供了好的新聞素材啊。{wait}
			}
			TextWait
			TextTalk name[2] {
				#0203F……稍微有些不愉快呢，
				下次必須要讓她給我們點補償才行。{wait}
			}
			TextWait
			TextTalk name[0] {
				#0009F哈哈……說得也是啊。
				下次就讓她無償為我們提供情報好了。{wait}
			}
			TextWait
			TextTalk char[0] {
				啊哈哈……{wait}
			}
			TextWait
			TextTalk char[0] {
				面對著格蕾絲小姐
				還能說出這種話的人，
				我還是第一次見到呢。{wait}
			}
			TextWait
			FlagSet flag[1435]
		elif flag[0]:
			TextTalk char[0] {
				格蕾絲小姐今天
				也一臉興奮地
				出門了。{wait}
			}
			TextWait
			TextTalk char[0] {
				她很開心地說過，那是因為在紀念慶典期間
				有很多可供报道的消息。{wait}
			}
			TextWait
		else:
			TextTalk char[0] {
				呵呵，稍微吃了一驚呢。
				被格蕾絲小姐报道之後不但不生氣，
				反而還要求回禮……{wait}
			}
			TextWait
			TextTalk char[0] {
				特務支援課一定是個非常了不起的
				地方，所以大家才如此豁達吧。{wait}
			}
			TextWait
			Emote field_party[0] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Emote field_party[1] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Emote field_party[2] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Emote field_party[3] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Sleep 1000ms
			TextTalk name[0] {
				#0006F也、也並不算是
				這樣……{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1281]:
		TextTalk char[0] {
			不知為什麼，外面好像
			很吵鬧啊。{wait}
		}
		TextWait
		TextTalk char[0] {
			是不是舞臺那裡
			的活動開始了呢。{wait}
		}
		TextWait
	elif flag[1280]:
		if flag[0]:
			TextTalk char[0] {
				大家今天都十分開心地
				出門了。{wait}
			}
			TextWait
			TextTalk char[0] {
				紀念慶典期間的採訪报道
				好像很有趣呢。{wait}
			}
			TextWait
		else:
			TextTalk char[0] {
				歡迎來到克洛斯貝爾通訊社。{wait}
			}
			TextWait
			TextTalk char[0] {
				紀念慶典終於要開始了，
				各位記者看上去也都特別忙碌。
				整天都在街上四處奔走呢。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1055]:
		if flag[0]:
			TextTalk char[0] {
				呼，Ｂ席票就可以了，
				不知道還有沒有剩下的。{wait}
			}
			TextWait
			TextTalk char[0] {
				不然就去問問總編吧……{wait}
			}
			TextWait
		else:
			TextTalk char[0] {
				距離彩虹劇團的預演，
				已經只剩不到兩周的時間了啊。{wait}
			}
			TextWait
			TextTalk char[0] {
				……真羨慕那些
				能去採訪的記者啊。{wait}
			}
			TextWait
			TextTalk char[0] {
				因為我最後
				也沒有買到票。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1040]:
		if flag[0]:
			TextTalk char[0] {
				幹記者這一行，總會
				遇到各式各樣的事情啊。{wait}
			}
			TextWait
			TextTalk char[0] {
				嗯嗯，不要沮喪，不要沮喪。
				如果想成為一名真正的記者，
				就必須要克服這些困難啊。{wait}
			}
			TextWait
		else:
			TextTalk char[0] {
				不知為何，雷因茲今天
				看起來好像很沮喪……{wait}
			}
			TextWait
			TextTalk char[0] {
				真是少見啊，
				平時一向都很有精神的啊。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1031]:
		if flag[0]:
			TextTalk char[0] {
				魯巴徹商會的黑衣人
				經常會前來拜訪。
				唉……{wait}
			}
			TextWait
			TextTalk char[0] {
				真不理解總編為什麼可以
				那麼泰然自若地應對他們。{wait}
			}
			TextWait
		else:
			TextTalk char[0] {
				魯巴徹商會的人
				經常會前來拜訪。
				和總編談一些事情。{wait}
			}
			TextWait
			TextTalk char[0] {
				雖然沒有出現暴力行為，
				但口頭威嚇，或是敲桌子之類，
				公然的威脅行為卻是屢見不鮮……{wait}
