		TextTalk name[0] {
			#0005F啊，這樣啊。
			真是失禮了。{wait}
		}
		TextWait
		FlagSet flag[4]
	else:
		TextTalk name[0] {
			#0003F二樓好像是不能隨便上去的，
			還是不要上去了。{wait}
		}
		TextWait
	Sleep 50ms
	CharSetPos field_party[0] (-6370, 20, 2470) 180deg
	EventEnd 4
	Return
