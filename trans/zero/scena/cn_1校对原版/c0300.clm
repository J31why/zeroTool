			}
			TextWait
		else:
			TextTalk char[3] {
				我父母的家是一座大宅子。{wait}
			}
			TextWait
			TextTalk char[3] {
				有很多女僕和傭人可以使喚，
				家務之類的事情，我從來都沒做過呢。{wait}
			}
			TextWait
			TextTalk char[3] {
