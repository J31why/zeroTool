fn[31]:
	TextStart null
	if (QuestTaskGet quest[8] 1 | QuestTaskGet quest[8] 2) && !QuestFlagsGet quest[8] 0x10 && !QuestFlagsGet quest[8] 0x40:
		if !QuestTaskGet quest[8] 8:
