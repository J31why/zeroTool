				這麼多的家務讓我手忙腳亂……{wait}
			}
			TextWait
			TextTalk char[3] {
				不過，現在的生活卻讓我樂在其中呢。{wait}
			}
			TextWait
			FlagSet flag[5]
	elif flag[533]:
		if flag[5]:
			TextTalk char[3] {
				住在前面那條街道的蘇菲亞女士，
				是一位非常出色的人。{wait}
			}
			TextWait
			TextTalk char[3] {
				我非常憧憬她。{wait}
			}
			TextWait
		else:
			TextTalk char[3] {
				住在前面那條街道的蘇菲亞女士，
				在烹飪方面很有一手呢。{wait}
			}
			TextWait
			TextTalk char[3] {
				而且好像還能幫丈夫
				處理工作上的事情。{wait}
			}
			TextWait
			TextTalk char[3] {
				真是太能幹了……{wait}
			}
			TextWait
			TextTalk char[3] {
				我對丈夫的工作
				就一竅不通。{wait}
			}
			TextWait
			FlagSet flag[5]
	elif flag[5]:
		TextTalk char[3] {
			都說鮮花要經過愛心的澆灌，
			才能鮮豔盛開呢。{wait}
		}
		TextWait
		TextTalk char[3] {
			呵呵，漸漸長大了呢。{wait}
		}
		TextWait
	else:
