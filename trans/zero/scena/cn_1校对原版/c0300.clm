				就不用特意打擾人家了吧？{wait}
			}
			TextWait
			TextTalk name[0] {
				#0000F說得也是……
				這家人好像很有身份。{wait}
			} {
				還是不要冒昧拜訪了。{wait}
			}
			TextWait
			TextTalk name[1] {
				#0108F…………………………{wait}
			}
			TextWait
			FlagSet flag[562]
		else:
			TextSetName ""
			TextMessage null {
				{color 5}似乎沒有必要拜訪這座宅邸。{wait}
			}
			TextWait
			TextClose 0
			_59
	TextEnd null
	Return

