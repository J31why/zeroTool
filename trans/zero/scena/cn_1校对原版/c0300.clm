				（該問的已經問完了，
				　沒必要再繼續打擾。）{wait}
			}
			TextWait
		TextEnd null
		Return
	if flag[525] && !flag[1036]:
		if !flag[562]:
			TextTalk name[0] {
				#0005F這裡是……？
				真是座氣派的宅邸呢。{wait}
			}
