			TextTalk name[1] {
				#0109F那個，羅伊德……
				都已經問過剛才那個人了，
				沒必要再來這座住宅了吧？{wait}
			} {
				要是沒其它事情的話，
				我們還是離開吧。{wait}
			}
			TextWait
			TextTalk name[0] {
