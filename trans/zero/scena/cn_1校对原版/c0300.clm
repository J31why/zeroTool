fn[6]:
	field_party[0].5 = self.4
	self.5 = self.4
	TextStart self
	CharFlagsUnset self 0x0010
	CharTurnToChar self field_party[0] 0deg/s
	self.4 = (self.4 + 360) % 360
	self.4 = self.4 + 360 - self.5
	self.5 = self.4 / 180
	if self.4 <= 45 | self.4 >= 315 && self.4 <= 405 | self.4 >= 675:
	elif self.5 < 1:
		self.8 = 2
	elif self.5 > 2:
		self.8 = 1
	else:
		self.8 = self.5
	self.4 = field_party[0].5
	field_party[0].5 = 0
	self.5 = 0
	CharFlagsSet self 0x0010
	if flag[1792]:
		if flag[0]:
			TextTalk char[0] {
				克洛斯貝爾的夜晚有點冷，
				你們還是早些回去為好啊。{wait}
			}
			TextWait
		else:
			TextTalk char[0] {
				哎呀，糟糕，已經是黃昏了……{wait}
			}
			TextWait
			TextTalk char[0] {
				差不多也該回家了啊。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1566]:
		TextTalk char[0] {
			說起邦德，那可真是個
			性格開朗的青年。{wait}
		}
		TextWait
		TextTalk char[0] {
			他出了什麼事嗎……{wait}
		}
		TextWait
	elif flag[1554]:
		if flag[0]:
			TextTalk char[0] {
				這樣的話，會議一時也無法結束了。{wait}
			}
			TextWait
		else:
			TextTalk char[0] {
				帝國派的提案考慮到了帝國的權利，
				而共和國派也努力推行有利於共和國的政策。{wait}
			}
			TextWait
			TextTalk char[0] {
				……克洛斯貝爾簡直就是被
				兩個大國夾在了中間。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1536]:
		TextTalk self {
			那座住宅裡住著一名
			叫做邦德的證券經理。{wait}
		}
		TextWait
		TextTalk self {
			大概是紀念慶典之後吧，
			好像在生意上失敗了。{wait}
		}
		TextWait
		TextTalk self {
			那段時間裡，他的情緒非常低落。{wait}
		}
		TextWait
	elif flag[1342]:
		TextTalk char[0] {
			哦哦，今天也是個好天氣呢。{wait}
		}
		TextWait
		TextTalk char[0] {
			怎麼樣，小姑娘也
			跟我一起曬曬太陽吧？{wait}
		}
		TextWait
	elif flag[1055]:
		if flag[0]:
			TextTalk char[0] {
				克洛斯貝爾的政治局面
				非常複雜，只憑正義感，
				很多事情根本就做不成。{wait}
			}
			TextWait
			TextTalk char[0] {
				還是要把這些事交付給那些
				狡猾的人才行，無論他們是善是惡。{wait}
			}
			TextWait
		else:
			TextTalk char[0] {
				自治州議會中聚集的那些議員們，
				都是一些狡猾的傢伙。{wait}
			}
			TextWait
			TextTalk char[0] {
				因為克洛斯貝爾的政治體系中，
				涉及到了帝國和共和國的各種意圖，
				情況十分複雜。{wait}
			}
			TextWait
			TextTalk char[0] {
				就算一些正義感很強的年輕人
				當選了議員，想要做些什麼，
				到頭來……{wait}
			}
			TextWait
			TextTalk char[0] {
				終究還是無法得償所願啊。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[1040]:
		if flag[0]:
			TextTalk char[0] {
				我在這裡悠閒放鬆的時候，
				經常看到送披薩的人經過。{wait}
			}
			TextWait
			TextTalk char[0] {
				最近，這種新潮的東西
				開始流行起來了呢。{wait}
			}
			TextWait
		else:
			TextTalk char[0] {
				嗯，最近使用
				外賣服務好像
				成為了一種新的流行啊。{wait}
			}
			TextWait
			TextTalk char[0] {
