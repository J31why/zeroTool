fn[5]:
	field_party[0].5 = char[1].4
	char[1].5 = char[1].4
	TextStart char[1]
	CharFlagsUnset char[1] 0x0010
	CharTurnToChar char[1] field_party[0] 0deg/s
	char[1].4 = (char[1].4 + 360) % 360
	char[1].4 = char[1].4 + 360 - char[1].5
	char[1].5 = char[1].4 / 180
	if char[1].4 <= 45 | char[1].4 >= 315 && char[1].4 <= 405 | char[1].4 >= 675:
	elif char[1].5 < 1:
		char[1].8 = 2
	elif char[1].5 > 2:
		char[1].8 = 1
	else:
		char[1].8 = char[1].5
	char[1].4 = field_party[0].5
	field_party[0].5 = 0
	char[1].5 = 0
	CharFlagsSet char[1] 0x0010
	if !flag[0]:
		TextTalk char[1] {
			歡迎光臨
			克洛斯貝爾市立圖書館。{wait}
		}
		TextWait
		TextTalk char[1] {
			今天圖書管理員上的是晚班，
			所以現在館裡就只有我一個人……
			但仍然可以辦理借閱手續哦。{wait}
		}
		TextWait
		TextTalk char[1] {
			各位可以找我辦理手續。{wait}
		}
		TextWait
		FlagSet flag[0]
	else:
		TextTalk char[1] {
			今天邁爾斯先生
			值晚班……{wait}
		}
		TextWait
		TextTalk char[1] {
			……那個，
			如果想要借閱書籍的話，
			請不要客氣，找我辦理手續哦。{wait}
		}
		TextWait
	CharSetChipPattern char[1] 0
	TextEnd char[1]
	Return

