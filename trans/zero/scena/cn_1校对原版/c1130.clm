fn[0]:
	var[3] = random % 8
	switch var[3]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharWalkToPos self (29310, 4000, 9100) 1000mm/s 0
		CharWalkToPos self (17140, 4000, 9100) 1000mm/s 0
		CharWalkToPos self (17140, 4000, 6840) 1000mm/s 0
		CharWalkToPos self (27790, 4000, 6840) 1000mm/s 0
		CharWalkToPos self (27790, 4000, -9440) 1000mm/s 0
		CharWalkToPos self (29310, 4000, -9440) 1000mm/s 0
	Return

fn[2]:
	if flag[1792]:
		CharFlagsUnset char[3] 0x0080
		CharFlagsUnset char[5] 0x0080
		CharFlagsSet char[4] 0x0080
		CharFlagsSet char[6] 0x0080
		CharFlagsUnset char[10] 0x0080
		if !QuestFlagsGet quest[40] 0x10:
			CharFlagsSet char[7] 0x0080
	elif flag[1566]:
	elif flag[1554]:
	elif flag[1536]:
	elif flag[1342]:
		CharFlagsUnset char[9] 0x0080
	elif flag[1307]:
		CharFlagsSet char[4] 0x0080
		CharFlagsSet char[6] 0x0080
		CharFlagsSet char[7] 0x0080
		CharFlagsUnset char[8] 0x0080
	elif flag[1362]:
		CharFlagsSet char[4] 0x0080
		CharFlagsSet char[6] 0x0080
		CharFlagsSet char[7] 0x0080
		CharFlagsUnset char[8] 0x0080
	elif flag[1292]:
		CharFlagsSet char[4] 0x0080
		CharFlagsSet char[6] 0x0080
		CharFlagsSet char[7] 0x0080
		CharFlagsUnset char[8] 0x0080
	elif flag[1282]:
		CharFlagsSet char[4] 0x0080
		CharFlagsSet char[6] 0x0080
		CharFlagsSet char[7] 0x0080
		CharFlagsUnset char[8] 0x0080
	elif flag[1280]:
		CharFlagsSet char[4] 0x0080
		CharFlagsSet char[6] 0x0080
		CharFlagsSet char[7] 0x0080
	elif flag[1055]:
	elif flag[1040]:
		CharFlagsSet char[4] 0x0080
		CharFlagsSet char[6] 0x0080
	elif flag[1031]:
	elif flag[1024]:
	elif flag[801]:
	elif flag[777]:
	elif flag[768]:
	elif flag[533]:
	elif flag[526]:
		CharFlagsSet char[7] 0x0080
		CharFlagsSet char[0] 0x0080
		CharFlagsUnset char[1] 0x0080
	if flag[1342] && !flag[1536] && !flag[1464]:
		Event fn[0,54]
	Return

fn[3]:
	if !flag[1342] && flag[1280]:
		LookPointFlagsSet look_point[0] 0x0001
	if flag[1792] && !QuestFlagsGet quest[40] 0x10:
		LookPointFlagsSet look_point[0] 0x0001
	if system[4] == 3:
		EntranceSetDisabled entrance[0] 0
		EntranceSetDisabled entrance[1] 1
	else:
		EntranceSetDisabled entrance[0] 1
		EntranceSetDisabled entrance[1] 0
	if flag[1037] && !flag[1038]:
		MapColor 0x00C8D2FF 0ms
	elif flag[1792]:
		MapColor 0x00C8D2FF 0ms
	else:
	LookPointFlagsSet look_point[4] 0x0001
	LookPointFlagsSet look_point[6] 0x0001
	LookPointFlagsSet look_point[8] 0x0001
	if flag[768]:
		LookPointFlagsUnset look_point[8] 0x0001
	if flag[768] && !flag[1024]:
		if QuestFlagsGet quest[5] 0x10:
			LookPointFlagsUnset look_point[3] 0x0001
			LookPointFlagsUnset look_point[4] 0x0001
			LookPointFlagsUnset look_point[6] 0x0001
		else:
			LookPointFlagsSet look_point[3] 0x0001
	LookPointFlagsSet look_point[2] 0x0001
	if flag[1024]:
		LookPointFlagsUnset look_point[2] 0x0001
		LookPointFlagsUnset look_point[4] 0x0001
		LookPointFlagsUnset look_point[6] 0x0001
	LookPointFlagsSet look_point[5] 0x0001
	LookPointFlagsSet look_point[7] 0x0001
	LookPointFlagsSet look_point[9] 0x0001
	if QuestFlagsGet quest[40] 0x10:
		LookPointFlagsUnset look_point[5] 0x0001
		LookPointFlagsUnset look_point[7] 0x0001
		LookPointFlagsUnset look_point[9] 0x0001
	Return

fn[4]:
	TextStart self
	if flag[1792]:
		if QuestFlagsGet quest[40] 0x10:
			if !flag[0]:
				TextTalk self {
					啊……
					差不多快到閉館的時間了。{wait}
				}
				TextWait
				TextTalk self {
					必須快點鎖好門窗。{wait}
				}
				TextWait
				FlagSet flag[0]
			else:
				TextTalk self {
					借閱、返還的受理即將結束，
					請各位抓緊時間。{wait}
				}
				TextWait
		else:
			TextTalk self {
				館長有事
				外出了。{wait}
			}
			TextWait
			TextTalk self {
				而且差不多也快到閉館時間了，
				看來今天得由我
				來鎖門窗呢。{wait}
			}
			TextWait
	elif flag[1566]:
		if !flag[0]:
			TextTalk self {
				諾瓦斯先生今天
				也打算待到
				閉館時間再走吧……{wait}
			}
			TextWait
			TextTalk self {
				最近他好像
				幹勁十足啊。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				啊……對了，古老文獻
				是禁止借出的哦。{wait}
			}
			TextWait
			TextTalk self {
				如果各位想要查閱的話，
				請在開館
				時間內前來。{wait}
			}
			TextWait
	elif flag[1554]:
		if !flag[0]:
			TextTalk self {
				今天天氣也很好啊，
				感覺很適合晾曬防蟲呢。{wait}
			}
			TextWait
			TextTalk self {
				啊……我並不是想
				把這裡的書籍弄亂哦。{wait}
			}
			TextWait
			TextTalk self {
				只是想讓它們通通風而已。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				今天天氣也很好啊，
				感覺很適合野餐。{wait}
			}
			TextWait
			TextTalk self {
				等工作上有閒暇了，
				我也去哪裡玩玩吧。{wait}
			}
			TextWait
	elif flag[1536]:
		if !flag[0]:
			TextTalk self {
				這是擺放新發行書籍的地方。{wait}
			}
			TextWait
			TextTalk self {
				這個作者所著的系列作品
				很受歡迎……
				能讀到這些書，市民們肯定都會很開心的。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				這個作者的作品很受歡迎。{wait}
			}
			TextWait
			TextTalk self {
				各位要是想閱讀的話，
				早點借比較好哦。{wait}
			}
			TextWait
	elif flag[1342]:
		TextTalk self {
			那個……
			各位是在找兒童書籍嗎？{wait}
		}
		TextWait
		TextTalk self {
			兒童書籍的書櫃
			在進門之後的右手邊哦。{wait}
		}
		TextWait
		TextTalk self {
			因為比較受歡迎，
			所以很多都借出去了。{wait}
		}
		TextWait
	elif flag[1307]:
		if !flag[0]:
			TextTalk self {
				……今天準備
				好好將圖書館打掃一番。{wait}
			}
			TextWait
			TextTalk self {
				來館的人也比較少，
				對於打掃衛生來說時機正好呢。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				我今天早上也很早就起床了。{wait}
			}
			TextWait
			TextTalk self {
				今天下午兩點就會閉館，
				各位要是想借書的話請儘快哦。{wait}
			}
			TextWait
	elif flag[1362]:
		if !flag[0]:
			TextTalk self {
				這個圖書館的二樓
				可是觀看遊行的特等席位哦。{wait}
			}
			TextWait
			TextTalk self {
				呵呵，果然
				大家都不知道呢。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				我估計連
				館長都不知道。{wait}
			}
			TextWait
			TextTalk self {
				呵呵，因為這是只屬於我的秘密。{wait}
			}
			TextWait
	elif flag[1292]:
		if !flag[0]:
			TextTalk self {
				今天好像比前兩天更加熱鬧了呢……{wait}
			}
			TextWait
			TextTalk self {
				即使在館內
				都能聽到外面的鼎沸人聲。{wait}
			}
			TextWait
			TextTalk self {
				我要不要
				也趁午休時出去晃晃呢……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				都說克洛斯貝爾人
				很喜歡慶典……{wait}
			}
			TextWait
			TextTalk self {
				呵呵，我果然也是
				土生土長的克洛斯貝爾人啊。{wait}
			}
			TextWait
	elif flag[1282]:
		TextTalk self {
			整理返還的書
			真是辛苦啊。{wait}
		}
		TextWait
		TextTalk self {
			必須趁來館的人比較少的時候，
			重新擺放好。{wait}
		}
		TextWait
	elif flag[1280]:
		if !flag[0]:
			TextTalk self {
				您好，歡迎光臨克洛斯貝爾
				市立圖書館。{wait}
			}
			TextWait
			TextTalk self {
				……紀念慶典期間，
				來館的人果然急劇減少啊。{wait}
			}
			TextWait
			TextTalk self {
				算了，這也是沒辦法的事……
				因為現在正是紀念慶典中最熱鬧的時候啊。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				啊……對了對了，
				館內禁止飲食。{wait}
			}
			TextWait
			TextTalk self {
				在露天店鋪買的東西
				不許帶入館內哦。{wait}
			}
			TextWait
	elif flag[1055]:
		if !flag[0]:
			TextTalk self {
				館長好像在紀念慶典
				期間休假。{wait}
			}
			TextWait
			TextTalk self {
				算了，反正在慶典的時候，
				來館的人會少很多……{wait}
			}
			TextWait
			TextTalk self {
				雖然還是有點沒信心，
				但我會一個人好好努力的。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				平常工作都是館長在忙。{wait}
			}
			TextWait
			TextTalk self {
				難得有這個機會，
				我得好好加油。{wait}
			}
			TextWait
	elif flag[1040]:
		if !flag[0]:
			TextTalk self {
				那次地下傳來了
				重物倒地的聲音……{wait}
			}
			TextWait
			TextTalk self {
				呼，總之館長
				沒事就好。{wait}
			}
			TextWait
			TextTalk self {
				那些書還是
				很重的。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				幸好館長沒受傷。{wait}
			}
			TextWait
			TextTalk self {
				不過當時看到他
				被埋在書堆裡，掙扎著往外爬的場面，
				我吃驚得都說不出話來了。{wait}
			}
			TextWait
	elif flag[1031]:
		if !flag[0]:
			TextTalk self {
				彩虹的門票
				都已經賣光了吧……{wait}
			}
			TextWait
			TextTalk self {
				要是我沒放棄，
				一直排隊就好了。{wait}
			}
			TextWait
			TextTalk self {
				我總是很容易就會放棄……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				對了……在圖書館的藏書中，
				有彩虹過去的公演目錄
				和寫真集哦。{wait}
			}
			TextWait
			TextTalk self {
				……不過一直
				都沒被還回來呢。{wait}
			}
			TextWait
	elif flag[1024]:
		if !flag[0]:
			TextTalk self {
				館長在休館日
				也會來圖書館
				整理書籍和製作目錄。{wait}
			}
			TextWait
			TextTalk self {
				他不僅是因為喜歡書，
				也是為了造福市民
				而努力。{wait}
			}
			TextWait
			TextTalk self {
				呵呵，雖然算不上位高權重，
				但我覺得他很了不起。{wait}
			}
