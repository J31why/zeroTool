fn[46]:
	TextTalk name[0] {
		#6P#0000F嗯，沒問題。{wait}
	}
	TextWait
	TextTalk char[7] {
		#11P嗯，謝謝。{wait}
	}
	TextWait
	TextTalk char[7] {
		#11P最近，有很多人過了還書期限
		卻還沒有歸還書籍。{wait}
	}
	TextWait
	TextTalk char[7] {
		#11P所以就想拜託你們
		去找那些借書者要回書籍。{wait}
	}
	TextWait
	TextTalk name[2] {
		#6P#0203F……原來如此。{wait}
	}
	TextWait
	TextTalk name[3] {
		#5P#5P#0300F這任務聽上去
		好像不是很難啊。{wait}
	}
	TextWait
	TextTalk name[0] {
		#6P#0000F那麼……
		那些人的住址
		您都知道嗎？{wait}
	}
	TextWait
	TextTalk char[7] {
		#11P嗯，借閱人的資料
		都記在圖書卡上了。{wait}
	}
	TextWait
	TextTalk char[7] {
		#11P那我念給你們聽了哦。{wait}
	}
	TextWait
	TextTalk char[7] {
		#11P首先是……
		西側大道的公寓
		《貝爾海姆》的菲伊先生。{wait}
	}
	TextWait
	TextTalk char[7] {
		#11P接著是……
		東側大道的公寓
		《洋槐莊園》的克拉莉絲女士。{wait}
	}
	TextWait
	TextTalk char[7] {
		#11P最後是……
		行政區克洛斯貝爾警察局總部的
		雷蒙德警官。{wait}
	}
	TextWait
	Emote name[0] 0mm 2000mm 16 19 250ms 1
