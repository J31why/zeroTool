		ScMenuSetTitle 65535 25 0 "書架４"
		TextSetName ""
		Menu menu[0] -1 -1 1
			"【大崩壞】" // 0
			"【釣公師團】" // 1
			"【導力革命】" // 2
			"【導力器】" // 3
			"【放棄】" // 4
		MenuWait var[0]
		MenuClose menu[0]
		ED7_DB
		if var[0] == 0:
			ScMenuSetTitle 65535 25 0 "大崩壞"
			TextSetPos -1 70 -1 -1
			TextSetName ""
			TextMessage null {
				{color 5}指發生於一千兩百年前，古代塞姆利亞文明
				的毀滅。有資料稱它是由天地異變所引發的，
				但具體原因仍然不明。{wait}
			} {
				『大崩壞』導致文明消失之後，
				人們度過了漫長的『黑暗時代』。{wait}
			}
			TextWait
			ED7_DB
			TextClose 0
			TextSetPos -1 280 60 3
			_59
			var[0] = 99
		if var[0] == 1:
			ScMenuSetTitle 65535 25 0 "釣公師團"
			TextSetPos -1 70 -1 -1
			TextSetName ""
			TextMessage null {
				{color 5}旨在普及釣魚文化，
				是垂釣界的專業組織。
				該組織由一位原為貴族的釣魚愛好者
				Ｈ・費瑟爾先生所發起，
				其總部位於利貝爾王國的格蘭賽爾市。{wait}
			} {
				主要活動為進行釣場的探訪、調查、開發，
				並致力於發掘培養新一代釣師，
				另外，釣公師團近年也開始著手開發釣具、釣餌等，
				其活動領域正在逐年擴大。{color 0}{wait}
			}
			TextWait
			ED7_DB
			TextClose 0
			TextSetPos -1 280 60 3
			_59
			var[0] = 99
		if var[0] == 2:
			ScMenuSetTitle 65535 25 0 "導力革命"
			TextSetPos -1 70 -1 -1
			TextSetName ""
			TextMessage null {
				{color 5}大約在五十年前，
				導力器的發明
				引發了全大陸的技術革新。{wait}
			} {
				雖然導力器是劃時代的發明，
				但當時人們卻對其持懷疑態度，
				直到愛普斯泰恩財團的導力通訊器及
				ＺＣＦ的導力飛行船問世後，
				其實用性才被全大陸所承認。{wait}
			} {
				現在，從取暖設備與照明設備等日用品，
				到列車、飛行船、戰車及大炮等兵器，
				所有設備都已經得到導力化，
				導力器對人們來說，
				已經變得必不可少。{wait}
			} {
				近幾年，隨著導力機械的小型化，
				烏爾努公司和萊恩福爾特公司對
				高性能導力驅動車的開發也在不斷進步，
				其產品已經開始在一般民眾間普及開來。{color 0}{wait}
			}
			TextWait
			ED7_DB
			TextClose 0
			TextSetPos -1 280 60 3
			_59
			var[0] = 99
		if var[0] == 3:
			ScMenuSetTitle 65535 25 0 "導力器"
			TextSetPos -1 70 -1 -1
			TextSetName ""
			TextMessage null {
				{color 5}由Ｃ・愛普斯泰恩博士發明，
				借由引出七耀石中的導力，
				來引發種種現象的機械的總稱。{wait}
			} {
				導力器利用其內在構造及齒輪運轉，
				使由七耀石加工而來的結晶迴路互相干涉，
				從而引發無數種現象。{wait}
			} {
				導力器的實用性之強，
				不僅在於能引發各種現象，並且『隨時間流逝內部的
				導力會逐漸恢復』，從經濟效率上看遠遠
				高於外燃、內燃機械。{color 0}{wait}
			}
			TextWait
			ED7_DB
			TextClose 0
			TextSetPos -1 280 60 3
			_59
			var[0] = 99
	FadeIn 300ms 0x00000000
	TextEnd null
	Return

