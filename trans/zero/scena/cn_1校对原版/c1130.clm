	}
	TextWait
	CharTurnToChar name[3] name[2] 500deg/s
	TextTalk name[3] {
		#5P#0306F什、什麼啊，
		為什麼要用那種冷冷的眼神看著我……{wait}
	}
	TextWait
	CharTurnTo name[2] 90deg 500deg/s
	TextTalk name[2] {
		#6P#0200F不，沒什麼。{wait}
	}
	TextWait
	TextTalk name[0] {
