		MenuWait var[0]
		MenuClose menu[0]
		ED7_DB
		if var[0] == 0:
			ScMenuSetTitle 65535 25 0 "萊恩福爾特公司"
			TextSetPos -1 70 -1 -1
			TextSetName ""
			TextMessage null {
				{color 5}總部位於埃雷波尼亞帝國，
				是一家巨大的綜合技術製造商。
				前身是專門製造使用火藥的
				大炮以及重型武器的兵器工房。{wait}
			} {
				自從導力器問世之後，
				便轉而製造導力槍與導力兵器，
				並涉足導力列車與飛行船等領域，
				最終發展為與卡爾瓦德共和國的『烏爾努公司』
				齊名的，世界兩大製造商之一。{color 0}{wait}
			}
			TextWait
			ED7_DB
			TextClose 0
			TextSetPos -1 280 60 3
			_59
			var[0] = 99
		if var[0] == 1:
			ScMenuSetTitle 65535 25 0 "雷米菲利亞公國"
			TextSetPos -1 70 -1 -1
			TextSetName ""
			TextMessage null {
				{color 5}雷米菲利亞公國位於塞姆利亞大陸北部。
				雖然處於自然環境嚴酷的北方，
				但有著茂密的森林與清澈的湖泊，
				風光明媚、景色秀麗，
				吸引了眾多遊客前來觀光。{wait}
			} {
				雷米菲利亞公國同時也是著名的醫療發達國家，
				集中了全大陸的頂尖醫療器械製造商，
				並且培養了許多優秀的醫生。
				克洛斯貝爾自治州的聖烏爾斯拉醫科大學
				也是由雷米菲利亞公國協助設立的。{color 0}{wait}
			}
			TextWait
			ED7_DB
			TextClose 0
			TextSetPos -1 280 60 3
			_59
			var[0] = 99
		if var[0] == 2:
			ScMenuSetTitle 65535 25 0 "列曼自治州"
			TextSetPos -1 70 -1 -1
			TextSetName ""
			TextMessage null {
				{color 5}列曼自治州位於塞姆利亞大陸中部。
				不僅是愛普斯泰恩財團的總部所在地，
				同時也是Ｃ・愛普斯泰恩博士的故鄉。{wait}
			} {
				除此之外，在全大陸都設有分部的
				遊擊士協會的總部也設於該國。{color 0}{wait}
			}
			TextWait
			ED7_DB
			TextClose 0
			TextSetPos -1 280 60 3
			_59
			var[0] = 99
		if var[0] == 3:
			ScMenuSetTitle 65535 25 0 "利貝爾王國"
			TextSetPos -1 70 -1 -1
			TextSetName ""
			TextMessage null {
				{color 5}利貝爾王國位於塞姆利亞大陸西南部。
				自古以來就擁有豐富絢麗的自然風光，
				現在，利貝爾王國在老女王艾莉西亞Ⅱ世的治理下，
				局勢穩定，以和平著稱。{wait}
			} {
				雖然與周邊諸國相比，國力稍顯遜色，
				但凭借豐富的七耀石資源和先進的技術，
				加上靈活的外交政策，
				使其與各國建立了平等友好的關係。{wait}
			} {
				去年，在王國中央的瓦雷利亞湖上
				出現了神秘的巨大物體（詳情不明），
				並使王國全境的導力全部停止運轉，
				所幸，此危機最後被軍隊和遊擊士協會
				順利解決了。{color 0}{wait}
			}
			TextWait
			ED7_DB
			TextClose 0
			TextSetPos -1 280 60 3
			_59
			FlagSet flag[1529]
			var[0] = 99
		if var[0] == 4:
			ScMenuSetTitle 65535 25 0 "獵兵團"
			TextSetPos -1 70 -1 -1
			TextSetName ""
			TextMessage null {
				{color 5}指代大陸各國的傭兵部隊中
				最優秀的部隊時所使用的稱號。{wait}
			} {
				雇主可依據規模和目的與其靈活地訂立合約，
				再加上獵兵擁有著強大的戰鬥力，
				因此常作為私人武裝被雇傭，
				但有的國家也明令禁止其在境內活動。{color 0}{wait}
			}
			TextWait
			ED7_DB
			TextClose 0
			TextSetPos -1 280 60 3
			_59
			var[0] = 99
	FadeIn 300ms 0x00000000
	TextEnd null
	Return

