			TextSetName ""
			TextMessage null {
				{color 5}用七耀石的碎片『耀晶石』精製加工而成，
				擁有結晶構造的迴路。{wait}
			} {
				是既能作為能量源使用，
				又可以引發各種現象的裝置，
				但若未設置於導力器內部，
				便發揮不出功效。{color 0}{wait}
