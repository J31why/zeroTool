		self.1 = char[0].1
		self.1 -= 250
		self.1 += char[0].2 / 3
		self.3 = char[0].3
		self.3 += 1200
		self.3 -= char[0].2 / 3
		self.2 = 1500
		self.4 = char[0].4
		Sleep 1ms
	Return

