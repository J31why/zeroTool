fn[2]:
	var[0] = 0
	SystemFlagsSet 0x00000080
	FadeOut 300ms 0x00000000 100
	FadeWait
	Menu menu[0] -1 -1 0
		"第一幕" // 0
		"第二幕" // 1
		"第三幕" // 2
		"第四幕" // 3
		"終幕" // 4
		"第四幕中場（暫訂）" // 5
	MenuWait var[0]
	MenuClose menu[0]
	switch var[0]:
		case 0:
			FlagSet flag[738]
			NewScene "scena/e3400.bin" 0 0 0
			Hcf
			break
		case 1:
			FlagSet flag[748]
			NewScene "scena/e3400.bin" 0 0 0
			Hcf
			break
		case 2:
			FlagSet flag[749]
