		CharSetPos name[4] (69670, 0, 740) 90deg
		CharFlagsUnset field_party[4] 0x0080
		CharFlags2Unset field_party[4] 0x8000
		CharFlagsUnset field_party[5] 0x0080
		CharFlags2Unset field_party[5] 0x8000
		FadeWait
		TextTalk name[0] {
			#00013F果然──{wait}
		}
		TextWait
		TextTalk name[1] {
			#00101F三台的鐵門
			都關著。{wait}
		}
		TextWait
		TextTalk name[2] {
			#00201F既然大樓的控制權被搶走，
			昇降機應該也都
			沒辦法用。{wait}
		}
		TextWait
		TextTalk name[3] {
			#00303F既然這樣，
			就算用蠻力撬開鐵門，
			也沒用了。{wait}
		}
		TextWait
		TextTalk name[8] {
			#10107F嗯，我們快點走逃生梯吧！{wait}
		}
		TextWait
		CharSetPos field_party[0] (109910, 0, -130740) 270deg
		CharFlagsSet field_party[4] 0x0080
		CharFlags2Set field_party[4] 0x8000
		CharFlagsSet field_party[5] 0x0080
		CharFlags2Set field_party[5] 0x8000
		FlagSet flag[3605]
		EventEnd 5
	else:
		EventBegin 1
		TextTalk name[0] {
			#00007F昇降機沒辦法用……
			我們去逃生梯吧！{wait}
		}
		TextWait
		CharSetPos field_party[0] (109910, 0, -130740) 270deg
		EventEnd 4
	Return

fn[138]:
	TextStart null
	if flag[2816]:
		TextMessage null {
			{color 5}好像有其他樓層
			正在使用昇降機，
			沒有停下的跡象。{color 0}{wait}
		}
		TextWait
		TextClose 0
		_59
	elif !flag[3602]:
		TextSetName ""
		TextMessage null {
			{color 5}昇降機的鐵門
			緊閉著。{color 0}{wait}
		}
		TextWait
		TextClose 0
		_59
		TextTalk name[0] {
			#00000F對了，會議期間除了
			前面的昇降機之外，
			其他好像都沒辦法用。{wait}
		}
		TextWait
		TextTalk name[1] {
			#00100F嗯，我記得是因為
			警備上的理由封鎖了。{wait}
		}
		TextWait
		if flag[3603]:
			TextTalk name[2] {
				#00200F這裡似乎也跟逃生梯一樣，
				都是透過導力網路
				控制、管理的。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00000F嗯，我聽說了。{wait}
			} {
				沒關係，要移動的時候
				就搭前面的昇降機吧。{wait}
			}
			TextWait
		else:
			TextTalk name[2] {
				#00200F順道一提，
				上鎖和解鎖都是透過
				導力網路控制、管理的。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00000F嗯，真不愧是
				蘭花塔的保全系統。{wait}
			} {
				沒關係，要移動的時候
				就搭前面的昇降機吧。{wait}
			}
			TextWait
		FlagSet flag[3602]
	else:
		TextSetName ""
		TextMessage null {
			{color 5}昇降機的鐵門
			緊閉著。{wait}
		} {
			會議期間似乎無法使用
			這台昇降機。{color 0}{wait}
		}
		TextWait
		TextClose 0
		_59
	TextEnd null
	Return

