fn[41]:
	while 1:
		var[0] = random % 100
		if var[0] < 20:
			Sleep 500ms
		elif var[0] < 40:
			Sleep 1000ms
		elif var[0] < 60:
			Sleep 1500ms
		elif var[0] < 80:
			Sleep 2000ms
		else:
			Sleep 2500ms
		EffPlay eff[0] eff_instance[255] self 3 (0, 1200, 400) 0 0 0 1000 1000 1000 null (0, 0, 0) 0ms
		SoundPlay sound[810] 0 80 0
	Return

