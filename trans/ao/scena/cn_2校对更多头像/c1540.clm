fn[133]:
	TextStart null
	if !flag[3602]:
		TextSetName ""
		TextMessage null {
			{color 5}昇降機的鐵門
			緊閉著。{color 0}{wait}
		}
		TextWait
		TextClose 0
		_59
		TextTalk name[0] {
			#00005F對了，會議期間除了
			前面的昇降機之外，
			其他好像都沒辦法用。{wait}
		}
		TextWait
		TextTalk name[1] {
			#00100F嗯，我記得是因為
			警備上的理由封鎖了。{wait}
		}
		TextWait
		if flag[3603]:
			TextTalk name[2] {
				#00200F這裡似乎也跟逃生梯一樣，
				都是透過導力網路
				控制、管理的。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00003F嗯，我聽說了。{wait}
			} {
				#00000F沒關係，要移動的時候
				就搭前面的昇降機吧。{wait}
			}
			TextWait
		else:
			TextTalk name[2] {
				#00200F順道一提，
				上鎖和解鎖都是透過
				導力網路控制、管理的。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00003F嗯，真不愧是
				蘭花塔的保全系統。{wait}
			} {
				#00000F沒關係，要移動的時候
				就搭前面的昇降機吧。{wait}
			}
			TextWait
		FlagSet flag[3602]
	else:
		TextSetName ""
		TextMessage null {
			{color 5}昇降機的鐵門
			緊閉著。{wait}
		} {
			會議期間似乎無法使用
			這台昇降機。{color 0}{wait}
		}
		TextWait
		TextClose 0
		_59
	TextEnd null
	Return

