				……你們要幫我保密喔～！{wait}
			}
			TextWait
			FlagSet flag[10]
		else:
			TextTalk self {
				警部回來的話，
				搜查二課也就放心了～{wait}
			}
			TextWait
			TextTalk self {
				好～在那之前，
				我們也得好好努力才行～！{wait}
			}
			TextWait
	elif flag[3371]:
	elif flag[3089]:
		TextTalk self {
