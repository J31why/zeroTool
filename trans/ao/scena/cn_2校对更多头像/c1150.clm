				繼續努力了啊～{wait}
			}
			TextWait
			TextTalk self {
				還有，要是議會那邊可以幫我加薪
				就好了～開玩笑的啦。{wait}
			}
			TextWait
	elif flag[2353]:
		if !flag[2554]:
			Call fn[0,27]
		else:
			TextTalk self {
				唉，又被警部
				踩到痛處了啦～{wait}
			}
			TextWait
			TextTalk self {
				我也想要
				變得可靠一點……
				但是個性改不過來啊。{wait}
			}
			TextWait
	TextEnd self
	Return

