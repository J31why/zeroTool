fn[10]:
	var[0] = 0
	while var[0] != 255:
		FadeOut 300ms 0x00000000 100
		FadeWait
		TextSetPos 173 40 -1 -1
		TextSetName ""
		Menu menu[0] -1 -1 1
			"【關於教團】" // 0
			"【關於真知】" // 1
			"【關於御子】" // 2
			"【放棄】" // 3
		MenuWait var[0]
		MenuClose menu[0]
		TextClose 0
		FadeIn 300ms 0x00000000
		FadeWait
		TextSetPos -1 280 60 3
		switch var[0]:
			case 0:
				SoundPlay sound[72] 0 100 0
				Call fn[0,11]
				break
			case 1:
				SoundPlay sound[72] 0 100 0
				Call fn[0,12]
				break
			case 2:
				SoundPlay sound[72] 0 100 0
				Call fn[0,13]
				break
			case 3:
				var[0] = 255
				break
			default:
				var[0] = 255
				break
	Return

fn[11]:
	FadeOut 300ms 0x00000000 100
	TextSetPos -1 -1 34 -1
	if global[2] == 0:
		TextSetName ""
		TextMessage null {
			{color 2}#2S『關於教團』

			──我的名字是約亞西姆・瓊塔。
			隸屬於《Ｄ∴Ｇ教團》的幹部祭司。
			六年前，在包括遊擊士在內的
			多方勢力攻擊下，我們教團陷入毀滅狀態。
			但是只有我因故逃過一劫，
			平安地逃到這塊■■之地。
			在偉大的《■》引導下，
			我為了成就教團的大願而活下來了。
			為了終將到來的那個時刻──
			做為記載新聖典所需的資料，
			我將把資料記錄在各終端機當中。{color 0}{wait}
		}
		TextWait
		TextClose 0
	else:
		TextSetName ""
		TextMessage null {
			{color 2}#2S『關於教團』

			──我的名字是約亞西姆・瓊塔。
			隸屬於《Ｄ∴Ｇ教團》的幹部祭司。
			六年前，在包括遊擊士在內的
			多方勢力攻擊下，我們教團陷入毀滅狀態。
			但是只有我因故逃過一劫，
			平安地逃到這塊起源之地。
			在偉大的《Ｄ》引導下，
			我為了成就教團的大願而活下來了。
			為了終將到來的那個時刻──
			做為記載新聖典所需的資料，
			我將把資料記錄在各終端機當中。{color 0}{wait}
		}
		TextWait
		TextClose 0
	TextSetName ""
	TextMessage null {
		{color 2}#2S首先敘述關於我們教團的成立經過吧。
		為此，我必須回顧這塊塞姆利亞大陸
		所歷經的可恨歷史。

		──在大約一千二百年前的《大崩壞》之後，
		大陸失去了高度文明和秩序，
		被戰爭和貧窮支配的《黑暗時代》來臨。
		於是，疲憊至極的人們
		犯下了一個大錯。

		那就是被突然出現的
