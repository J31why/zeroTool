			看能不能暗中進行交涉。{wait}
		}
		TextWait
		TextTalk self {
			既然做得出這種事，
			表示他們肯定有什麼企圖。{wait}
		}
		TextWait
	elif flag[2848]:
		TextTalk self {
			瓦魯多・瓦雷斯是
			從哪裡得到真知的……{wait}
		}
		TextWait
		TextTalk self {
			假設不是透過魯巴徹，
			那究竟會是從哪個管道呢？{wait}
		}
		TextWait
	elif flag[2837]:
	elif flag[2832]:
		if QuestFlagsGet quest[129] 0x10:
			if !flag[10]:
				TextTalk self {
					啊，是你們啊～
					昨天真是謝謝你們。{wait}
				}
				TextWait
				TextTalk self {
					對了對了，昨天晚上那個老婆婆
					在我的夢裡出現～
					不知為何，我反過來被她追趕呢。{wait}
				}
				TextWait
				TextTalk self {
					呼，害我睡得
					不是很好啊。{wait}
				}
				TextWait
				Emote field_party[0] 0mm 2000mm 16 19 250ms 1
				SoundPlay sound[23] 0 100 0
				Emote field_party[1] 0mm 2000mm 16 19 250ms 1
				SoundPlay sound[23] 0 100 0
				Emote field_party[2] 0mm 2000mm 16 19 250ms 1
				SoundPlay sound[23] 0 100 0
				Emote field_party[3] 0mm 2000mm 16 19 250ms 1
				SoundPlay sound[23] 0 100 0
				Sleep 1000ms
				TextTalk name[0] {
					#00006F（被他這麼一說，
					　感覺好像連我都會夢到啊。）{wait}
				}
				TextWait
				TextTalk name[1] {
					#00106F（……努力忘記這件事吧。）{wait}
				}
				TextWait
				FlagSet flag[10]
			else:
				TextTalk self {
					總之，
					昨天真的很感謝你們。
					多虧了你們的幫忙。{wait}
				}
				TextWait
		else:
			TextTalk self {
				呼，昨天我做了一個
				很討厭的夢～{wait}
			}
			TextWait
			TextTalk self {
				我夢到自己被昨天帶走的
				老婆婆追趕……{wait}
			}
			TextWait
			TextTalk self {
				我起雞皮疙瘩了，
				一回想起來就冒冷汗啊～{wait}
			}
			TextWait
	elif flag[2816]:
	elif flag[2573]:
	elif flag[2564]:
	elif flag[2560]:
	elif flag[2369]:
		if !flag[10]:
			TextTalk self {
				呼，這陣子總部內的
				氣氛也非常緊繃。
				真是受不了啊～{wait}
			}
			TextWait
			TextTalk self {
				來自議員和高層的壓力
