fn[5]:
	TextSetName ""
	TextMessage null {
		{color 5}有一本導力車雜誌『行軍・狂飆者！』。{color 0}{wait}
	}
	TextWait
	TextClose 0
	_59
	TextSetPos -1 280 60 3
	if flag[393] && !ItemHas item[881] 0:
		SoundPlay sound[17] 0 100 0
		TextSetPos -1 -1 -1 -1
		TextSetName ""
		TextMessage null {
			記住了
			{color 2}『防禦色彩』{color 0}的噴漆樣式。{wait}
		}
		TextWait
		TextClose 0
		_59
		TextSetPos -1 280 60 3
		ItemAdd item[881] 1
	TextEnd null
	Return

fn[6]:
	Call fn[0,7]
	Return

fn[7]:
	TextStart char[0]
	if flag[3385]:
		if !flag[0]:
			TextTalkNamed char[0] "士兵奧利弗" {
				有來不及逃出克洛斯貝爾的
				共和國人來到這裡。{wait}
			}
			TextWait
			TextTalkNamed char[0] "士兵奧利弗" {
				不過，在無法解除
				對共和國警戒的現狀下，
				不得不讓他們停留在這裡。{wait}
			}
			TextWait
			TextTalkNamed char[0] "士兵奧利弗" {
				我能理解他們想回去的心情，
				所以覺得有點過意不去……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalkNamed char[0] "士兵奧利弗" {
				不過，在無法解除
				對共和國警戒的現狀下，
				不得不讓他們停留在這裡。{wait}
			}
			TextWait
			TextTalkNamed char[0] "士兵奧利弗" {
				雖然他們可能無法接受，
				不過也只能請他們諒解了。{wait}
			}
			TextWait
	elif flag[3074]:
		if QuestFlagsGet quest[147] 0x10:
			if !flag[0]:
				TextTalk char[0] {
					剛才硬闖過閘門的
					黑色運輸車，似乎是通緝中的
					詐欺犯對吧。{wait}
				}
				TextWait
				TextTalk char[0] {
					雖然在這種緊張狀態下讓我嚇了一跳……
					不過，能抓到他真是太好了。{wait}
				}
				TextWait
				FlagSet flag[0]
			else:
				TextTalk char[0] {
					總之，你們也辛苦了呢。{wait}
				}
				TextWait
				TextTalk char[0] {
					我已經跟道格拉斯副司令
					報告完畢，你們可以不用
					在意這裡的事。{wait}
				}
				TextWait
		elif QuestFlagsGet quest[147] 0x40:
			TextTalk char[0] {
				剛才硬闖過閘門的
				黑色運輸車，似乎是通緝中的
				詐欺犯對吧。{wait}
			}
			TextWait
			TextTalk char[0] {
				在這種緊張狀態下……
				真是的，居然幹這種蠢事。{wait}
			}
			TextWait
		elif !flag[0]:
			TextTalk char[0] {
				國界的緊張狀態
				已經很接近極限了。{wait}
			}
			TextWait
			TextTalk char[0] {
				共和國雖然有唐古拉姆丘陵
				當成緩衝地帶，
				不過仍然無法放心。{wait}
			}
			TextWait
			TextTalk char[0] {
				現在得咬緊牙關撐下去。
				一定要持續警戒才行呢。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				對克洛斯貝爾來說，
				現在也得咬緊牙撐下去才行。
				一定要持續警戒才行呢。{wait}
			}
			TextWait
	elif flag[2848]:
		if !flag[0]:
			TextTalk char[0] {
				昨天唐古拉姆門
				也忙著處理脫軌意外。{wait}
			}
			TextWait
			TextTalk char[0] {
				也有請共和國的
				旅客巴士支援，
				非常辛苦呢。{wait}
			}
			TextWait
			TextTalk char[0] {
				居然在這種緊張狀態下
				發生意外……真是的，
				正所謂屋漏偏逢連夜雨啊。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				居然在這種緊張狀態下
				發生意外……真是的，
				正所謂屋漏偏逢連夜雨啊。{wait}
			}
			TextWait
			TextTalk char[0] {
				起碼在公民投票結束之前，
				真希望不要再發生
				更多意外了。{wait}
			}
			TextWait
	elif flag[2832]:
		Call fn[0,8]
	elif flag[2816]:
		if !flag[0]:
			TextTalk char[0] {
				最近就連共和國也在
				討論克洛斯貝爾
				獨立是否恰當。{wait}
			}
			TextWait
			TextTalk char[0] {
				而且跟克洛斯貝爾不同，
				幾乎所有人都反對的樣子。
				嗯，我想這也是無可奈何的事……{wait}
			}
			TextWait
			TextTalk char[0] {
				雖然最近會舉行公民投票，
				不過在這種情況下，
				真的有辦法獨立成功嗎？{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				雖然最近會舉行公民投票，
				不過在這種情況下，
				真的有辦法獨立成功嗎？{wait}
			}
			TextWait
			TextTalk char[0] {
