			去哪裡了呢？{wait}
		}
		TextWait
		TextTalk self {
			他一直沒有回來，
			難道是去了對策總部嗎？{wait}
		}
		TextWait
	elif flag[2576]:
		if !flag[3599]:
			TextTalk self {
				皮埃爾副局長好像
				從剛才開始就一直自言自語，
				他還好嗎？{wait}
			}
			TextWait
			TextTalk self {
				……我好擔心啊。{wait}
			}
			TextWait
		elif !flag[3601]:
			TextTalk self {
				你們幾個好像跟
				皮埃爾副局長說過話了吧？{wait}
			}
			TextWait
			TextTalk self {
				他的狀況還好嗎？{wait}
			}
			TextWait
			TextTalk name[0] {
				#00012F呃、呃……{wait}
			}
			TextWait
			TextTalk name[3] {
				#00306F那樣算不算「還好」，
				實在是個很困難的問題。{wait}
			}
			TextWait
			TextTalk name[2] {
				#00203F唉，也可以說是
				跟平常一樣就是了。{wait}
			}
			TextWait
			TextTalk name[1] {
				#00106F但是，我印象中
				他以前應該不是那麼
				自卑的人才對……{wait}
			}
			TextWait
			TextTalk self {
				原來如此，自卑啊……
				唉，這也不能怪他吧。{wait}
			}
			TextWait
			TextTalk self {
				雖然我們局裡
				有兩個人擁有
				副局長的頭銜……{wait}
			}
			TextWait
			TextTalk self {
				但前局長解任之後，
				是另一個副局長
				被任命為局長。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00001F的確有過這麼一回事呢。{wait}
			} {
				雖然他跟我們
				完全沒有交集就是了……{wait}
			}
			TextWait
			TextTalk self {
				然後那個新局長……
				你們知道他其實是
				皮埃爾副局長的學弟嗎？{wait}
			}
			TextWait
			Emote name[0] 0mm 2000mm 38 38 250ms 1
			Sleep 1000ms
			TextTalk name[0] {
				#00005F新局長是……副局長的學弟？{wait}
			}
			TextWait
			TextTalk name[8] {
				#10106F原來如此，就是因為這樣……{wait}
			}
			TextWait
			TextTalk self {
				話雖如此，我也
				無法想像皮埃爾先生
				當上局長。{wait}
			}
			TextWait
			TextTalk self {
				說得明白一點，
				我認為這個人事安排非常合適……{wait}
			}
			TextWait
			TextTalk self {
				但即使如此，被同樣是副局長……
				而且資歷還比自己淺的人超越，
				應該很不是滋味吧？{wait}
			}
			TextWait
			TextTalk name[4] {
				#10302F呵呵，會有那種想法
				確實也是理所當然的。{wait}
			}
			TextWait
			TextTalk self {
				嗯，就是因為這樣，
				他其實也很辛苦啊。{wait}
			}
			TextWait
			TextTalk self {
				所以你們跟他相處的時候，
				該說是要放寬心胸吧……{wait}
			}
			TextWait
			TextTalk self {
				就算被他嘮叨抱怨，
				也要懷著體諒的心情
				比較好。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00012F也、也是……{wait}
			}
			TextWait
			FlagSet flag[3601]
		else:
			TextTalk self {
				別看皮埃爾副局長那樣，
				其實他也很辛苦啊。{wait}
			}
			TextWait
			TextTalk self {
				雖然他嘴巴很毒，
				但我們也得多擔待他才行。{wait}
			}
			TextWait
	TextEnd self
	Return

