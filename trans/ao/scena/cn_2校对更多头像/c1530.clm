fn[30]:
	TextStart self
	if flag[2578]:
		TextTalk self {
			雖然不太清楚是怎麼一回事……
			但包括伊安律師在內，這裡真是
			聚集了一群氣質特殊的人啊。{wait}
		}
		TextWait
