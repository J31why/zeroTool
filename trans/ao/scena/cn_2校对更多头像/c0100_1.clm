fn[23]:
	EventBegin 0
	CrossFade 500ms
	_Char4A char[8] 255
	_Char4A char[9] 255
	CharTurnTo char[8] 270deg 0deg/s
	CharSetPos name[0] (-25020, 1300, -19860) 90deg
	CharSetPos name[1] (-25130, 1300, -18930) 90deg
	CharSetPos name[8] (-26200, 1300, -19870) 90deg
	CharSetPos name[4] (-26790, 1300, -19180) 90deg
	if PartyPosition name[164] > -1:
		CharSetPos name[164] (-24820, 1300, -16830) 133deg
	CamSetDistance -24880 3000 -20830 0ms
	ED7CamRotate 43deg 20deg 0deg 0ms
	CamPers 700 0ms
	CamZoom 10510 0ms
	FadeWait
	TextTalk char[9] {
		#01200F吼喔喔喔喔……{wait}
	}
	TextWait
	TextTalk name[0] {
		#6P#00000F賽特、柯貝。
		原來你們倆在一起啊。{wait}
	}
	TextWait
	TextTalk name[1] {
		#00102F呵呵，你們感情還是這麼好。{wait}
	}
	TextWait
	TextTalk name[4] {
		#6P#10304F呵呵，牠就是特務支援課
		養的警犬啊。{wait}
	} {
		#10300F請多多指教喔，賽特。{wait}
	}
	TextWait
	TextTalk char[9] {
		#01203F吼喔喔……汪。{wait}
	}
	TextWait
	if PartyPosition name[164] > -1:
		TextTalk name[164] {
			#01104F『不是他們「養」我，
			　而是我在照顧大家』牠這麼說喔。{wait}
		}
		TextWait
		Emote name[0] 0mm 2000mm 16 19 250ms 1
		SoundPlay sound[23] 0 100 0
		Sleep 50ms
		Emote name[1] 0mm 2000mm 16 19 250ms 1
		SoundPlay sound[23] 0 100 0
		Sleep 50ms
		Emote name[8] 0mm 2000mm 16 19 250ms 1
		SoundPlay sound[23] 0 100 0
		Sleep 1000ms
		TextTalk name[4] {
			#6P#10309F啊哈哈，那我說錯話了呢。{wait}
		}
		TextWait
		TextTalk name[0] {
			#00006F算、算是吧……
			牠是幫了我們不少忙。
			牠的自尊心還是這麼高啊……{wait}
		}
		TextWait
	else:
		TextTalk name[0] {
			#00005F感覺牠好像
			有什麼話想說……{wait}
		} {
			#00003F嗯，如果緹歐或是琪雅在的話，
			就能聽懂牠的話了。{wait}
		}
		TextWait
	CharTurnToChar name[8] char[8] 500deg/s
	TextTalk name[8] {
		#6P#10102F呵呵，雖然我很怕狗，
		但已經很習慣賽特了。{wait}
	} {
		#10105F那麼，這邊的黑貓是？{wait}
	}
	TextWait
	CharTurnToChar name[1] char[8] 500deg/s
	TextTalk name[0] {
		#6P#00000F喔，牠叫柯貝。{wait}
	} {
		好像是從克洛斯貝爾通訊社
		進駐這棟大樓那時起，
		就一直住在這裡的樣子。{wait}
	}
	TextWait
	TextTalk char[8] {
		#11P喵──嗚。{wait}
	}
	TextWait
	TextTalk name[8] {
		#6P#10102F呵呵，好可愛。{wait}
	} {
		#10109F太好了，以後我就能在支援課
		跟貓玩了……！{wait}
	}
	TextWait
	TextTalk name[1] {
		#00109F諾艾兒喜歡貓嗎？
		呵呵，今後真令人期待呢。{wait}
	}
	TextWait
	TextTalk char[8] {
		#11P呼咪～……{wait}
	}
	TextWait
	_59
	CharSetPos field_party[0] (-24690, 1300, -19050) 90deg
	FlagSet flag[2511]
	_Char4B char[8] 255
	CharTurnTo char[8] 180deg 0deg/s
	_Char4B char[9] 255
	EventEnd 5
	Return

fn[24]:
	if flag[3074] && !flag[3089]:
		if !QuestFlagsGet quest[147] 0x02 | QuestFlagsGet quest[147] 0x40 | QuestFlagsGet quest[147] 0x10:
			if !flag[3204]:
				Call fn[1,26]
				Return
	TextStart null
	FadeOut 300ms 0x00000000 100
	TextSetName ""
	TextSetPos -1 -1 -1 -1
	TextMessage null {
		{color 5}       『克洛斯貝爾之鐘』
		Ｓ１１８５  在克洛斯貝爾自治州
		發掘出土的巨型大鐘。
		依據出土遺跡的情況來看，
		可推斷為中世紀時期的物品。
		使用多種金屬打造而成，
		敲打時會發出悅耳的低音。{wait}
	}
	TextWait
	TextMessage null {
		{color 5}據推測是由當時的權貴
		所製造的，但是關於
		鐘的用途則眾說紛紜。{wait}
	}
	TextWait
	TextClose 0
	FadeIn 300ms 0x00000000
	_59
	TextSetPos -1 280 60 3
	TextEnd null
	Return

fn[25]:
	TextStart null
	if QuestFlagsGet quest[115] 0x02 && !QuestFlagsGet quest[115] 0x10 && !QuestFlagsGet quest[115] 0x40 && flag[2722]:
		if !flag[3815]:
			TextTalk name[161] {
				基隆德武器商會……
				原來如此，這裡是合法的武器商店嗎？{wait}
			}
			TextWait
			TextTalk name[161] {
				好，我們進去看看吧。{wait}
			}
			TextWait
			if flag[3622]:
				Fork name[0] fork[1]:
					CharTurnToChar self name[161] 500deg/s
				Sleep 50ms
				Fork name[1] fork[1]:
					CharTurnToChar self name[161] 500deg/s
				Sleep 50ms
				Fork name[3] fork[1]:
					CharTurnToChar self name[161] 500deg/s
				Sleep 300ms
			elif flag[3623]:
				Fork name[0] fork[1]:
					CharTurnToChar self name[161] 500deg/s
				Sleep 50ms
				Fork name[1] fork[1]:
					CharTurnToChar self name[161] 500deg/s
				Sleep 50ms
				Fork name[8] fork[1]:
					CharTurnToChar self name[161] 500deg/s
				Sleep 300ms
			elif flag[3624]:
				Fork name[0] fork[1]:
					CharTurnToChar self name[161] 500deg/s
				Sleep 50ms
				Fork name[1] fork[1]:
					CharTurnToChar self name[161] 500deg/s
				Sleep 50ms
				Fork name[4] fork[1]:
					CharTurnToChar self name[161] 500deg/s
				Sleep 300ms
			TextTalk name[0] {
				#00003F抱歉喔，星。
				你說得沒錯，這裡確實是武器商店。{wait}
			} {
				#00001F裡面有不少危險的商品，
				我們實在不能帶你進去……{wait}
			}
			TextWait
			TextTalk name[161] {
				哼！只要
				別觸碰商品就好了吧？{wait}
			}
			TextWait
			TextTalk name[161] {
				我對這裡很感興趣。
				我說要進去就是要進去。{wait}
			}
			TextWait
			CharTurnToChar name[0] name[1] 500deg/s
			Sleep 300ms
			TextTalk name[0] {
				#00006F（唉……
				　艾莉，拜託妳了。）{wait}
			}
			TextWait
			CharTurnToChar name[1] name[0] 500deg/s
			Sleep 300ms
			TextTalk name[1] {
				#00100F（呵呵，瞭解。）{wait}
			}
			TextWait
			CharTurnToChar name[1] name[161] 500deg/s
			Sleep 300ms
			TextTalk name[1] {
				#00103F我說啊，星，你是重要人物，
				而我們受託照顧你。{wait}
			} {
				所以即使只有
				萬分之一的可能性，
				我們也必須要排除危險才行。{wait}
			} {
				#00100F星你這麼聰明，
				應該可以體會我們的難處吧？{wait}
			}
			TextWait
			TextTalk name[161] {
				唔……
				確實是可以體會啦。{wait}
			}
			TextWait
			TextTalk name[1] {
				#00109F呵呵，太好了。
				星果然是個聰明的好孩子。{wait}
			}
			TextWait
			TextTalk name[161] {
				沒、沒錯……
				我是個聰明的好孩子！{wait}
			}
			TextWait
			if flag[3622]:
				TextTalk name[3] {
					#00309F（哈哈，大小姐的影響力真不得了。）{wait}
				}
				TextWait
			elif flag[3623]:
				TextTalk name[8] {
					#10109F（啊哈哈，
					　艾莉小姐的影響力真大啊。）{wait}
				}
				TextWait
			elif flag[3624]:
				TextTalk name[4] {
					#10302F（呵呵，艾莉的影響力真大呢。）{wait}
				}
				TextWait
			FlagSet flag[3815]
		else:
			TextTalk name[0] {
				#00000F我們現在帶著星一起行動。
				還是別去武器商會吧。{wait}
			}
			TextWait
	TextEnd null
	Return

fn[26]:
	EventBegin 0
	CrossFade 500ms
	_Char4A char[12] 0
	_Char4A char[13] 0
	CharFlagsUnset field_party[4] 0x0080
	CharFlags2Unset field_party[4] 0x8000
	CharFlagsUnset field_party[5] 0x0080
	CharFlags2Unset field_party[5] 0x8000
