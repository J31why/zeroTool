			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				沒想到迪塔市長會頒布
				這麼強硬的政策……{wait}
			}
			TextWait
			TextTalk self {
				但是的確，我們如果要崛起，
