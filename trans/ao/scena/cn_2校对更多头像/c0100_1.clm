			}
			TextWait
	elif flag[3074]:
		if !flag[1]:
			TextTalk self {
				前陣子的襲擊事件……
				肯定是帝國幹的好事。{wait}
			}
			TextWait
			TextTalk self {
				那些傢伙最近似乎都裝得很安分，
				但他們的本性就是為達目的不擇手段……{wait}
			}
			TextWait
			TextTalk self {
				拐彎抹角，耍些卑劣的手段，
				還計畫要侵略他國……
				埃雷波尼亞就是這種國家啦！{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				前陣子的襲擊事件……
				肯定是帝國幹的好事。{wait}
			}
			TextWait
			TextTalk self {
				拐彎抹角，耍些卑劣的手段，
				還計畫要侵略他國……
				埃雷波尼亞就是這種國家啦！{wait}
			}
			TextWait
	elif flag[2861]:
		TextTalk self {
			這次的事件，搞不好是帝國在暗中搞鬼……{wait}
		}
		TextWait
		TextTalk self {
			……嗯，如果是的話，
			要是只跟以前一樣乖乖聽話，
			或許沒辦法保護克洛斯貝爾吧。{wait}
		}
		TextWait
	elif flag[2848]:
	elif flag[2837]:
		if !flag[1]:
			TextTalk self {
				西邊好像
				發生了什麼意外啊。{wait}
			}
			TextWait
			TextTalk self {
				上天保佑、上天保佑……
				空之女神愛德斯啊，請您保佑大家。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				上天保佑、上天保佑……
				空之女神愛德斯啊，請您保佑大家。{wait}
			}
			TextWait
	elif flag[2832]:
		if !flag[1]:
			TextTalk self {
				雖然不能一概而論，
				但年輕一輩的人好像大多
