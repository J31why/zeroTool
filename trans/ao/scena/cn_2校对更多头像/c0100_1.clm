			}
			TextWait
			TextTalk self {
				雖然最後搞成一團混亂，
				但我還是無法怪罪於他。{wait}
			}
			TextWait
	elif flag[3371]:
	elif flag[3089]:
		if !flag[1]:
			TextTalk self {
