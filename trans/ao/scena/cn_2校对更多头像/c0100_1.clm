	CharSetPos name[2] (-1610, 0, -4590) 0deg
	CharSetPos name[4] (-900, 0, -5970) 0deg
	CharSetPos name[3] (740, 0, -6130) 0deg
	CamSetDistance -1190 1900 -5280 0ms
	ED7CamRotate 45deg 21deg 0deg 0ms
	CamPers 660 0ms
	CamZoom 11710 0ms
	CharFlagsSet char[7] 0x0008
	FadeWait
	Sleep 1000ms
	if flag[3295]:
		TextTalk char[12] {
			#14502F嗨，羅伊德和大家。{wait}
		}
		TextWait
		TextTalk char[13] {
			特務支援課的各位，
			還有諾艾兒上士也辛苦了。{wait}
		}
		TextWait
		TextTalk name[8] {
			#10100F您辛苦了！{wait}
		}
		TextWait
		TextTalk char[12] {
			#14500F對了，剛才的工作
			已經結束了嗎？{wait}
		}
		TextWait
		if QuestFlagsGet quest[147] 0x10:
			TextTalk name[0] {
				#00002F#2P嗯，剛剛解決了。
				多虧了弗蘭茲，真是謝謝你。{wait}
			}
			TextWait
			TextTalk char[12] {
				#14509F哈哈，雖然搞不太清楚狀況，
				但我很榮幸能幫上忙。{wait}
			}
			TextWait
		else:
			TextTalk name[0] {
				#00003F#2P對、對啊……是剛剛才解決的。{wait}
			} {
				#00006F（雖然因為沒有好好聽對方說話，
				　結果讓詐欺師逃走了……）{wait}
			}
			TextWait
			TextTalk char[12] {
				#14509F哈哈，雖然搞不太清楚狀況，
				但事情告一段落就好。{wait}
			}
			TextWait
		TextTalk name[0] {
			#00005F#2P對了，弗蘭茲，
			今天你要加入
			這裡的警備工作吧？{wait}
		} {
			這裡平常都是由凱特學姊
			負責警備就是了。{wait}
		}
		TextWait
	else:
		TextTalk char[12] {
			#14502F嗨，這不是羅伊德跟夥伴們嗎？{wait}
		}
		TextWait
		TextTalk char[13] {
			特務支援課的各位，
			還有諾艾兒上士也辛苦了。{wait}
		}
		TextWait
		TextTalk name[8] {
			#10100F您辛苦了！{wait}
		}
		TextWait
		TextTalk name[0] {
			#00005F#2P弗蘭茲，今天你要加入
			這裡的警備工作吧？{wait}
		} {
			這裡平常都是由凱特學姊
			負責警備就是了。{wait}
		}
		TextWait
	TextTalk char[12] {
		#14500F嗯，因為學姊
		有其他事情要去別的地方。{wait}
	} {
		#14510F所以我臨時被調來
		負責這裡的警備工作。{wait}
	}
	TextWait
	CamSetDistance -2320 2800 -900 2000ms
	ED7CamRotate 45deg 8deg 0deg 2000ms
	CamPers 660 2000ms
	CamZoom 15930 2000ms
	Sleep 2500ms
	TextTalk name[1] {
		#12P#00108F『克洛斯貝爾的鐘』……
		被紅色星座
		偷走了呢。{wait}
	} {
		#00101F應該也是因為這個緣故，
		才加強這裡的警備吧？{wait}
	}
	TextWait
	TextTalk char[13] {
		畢竟是克洛斯貝爾重要的
		文化財產被偷了啊。{wait}
	}
	TextWait
	TextTalk char[13] {
		為了保險起見，
		我從警備隊過來支援。{wait}
	}
	TextWait
	CamSetDistance -1190 1900 -5280 2000ms
	ED7CamRotate 45deg 21deg 0deg 2000ms
	CamPers 660 2000ms
	CamZoom 11710 2000ms
	Sleep 2500ms
	TextTalk name[2] {
		#00206F#3P偷鐘的目的，
		還有把鐘偷去哪裡，
		現在都還不明吧？{wait}
	}
	TextWait
	TextTalk char[12] {
		#14503F嗯，警察和警備隊
		雖然都有在搜查，
		但一直找不到。{wait}
	}
	TextWait
	TextTalk name[3] {
		#00303F#4P叔叔他們……
		到底為什麼
		要做這種事？{wait}
	}
	TextWait
	TextTalk name[4] {
		#10300F#4P呵呵，如果要隨身攜帶，
		那個鐘也有點太笨重了呢。{wait}
	}
	TextWait
	TextTalk name[0] {
		#00003F#2P……總之，
		『鐘』的事情就交給他們，
		我們專心處理我們的工作吧。{wait}
	} {
		#00000F那就再見囉，弗蘭茲。
		市區的警備工作要努力啊。{wait}
	}
	TextWait
	TextTalk char[12] {
		#14500F嗯，再見啦。{wait}
	}
	TextWait
	_59
	_Char4B char[12] 0
	_Char4B char[13] 0
