				#10106F嗚嗚，有點可惜。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00000F哈哈，下次釣到魚的話，
				再拿給你吃吧。{wait}
			}
			TextWait
			FlagSet flag[2522]
		else:
			TextTalk char[8] {
				喵喵啊～㈱{wait}
			}
			TextWait
	Return

