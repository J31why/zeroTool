calmare ao_k scena
scena:
	name "c0100" "c0100" "c0100_1"
	town town[4]
	bgm bgm[150]
	flags 8192
	item_use fn[0,255]
	unk 255 0

entry:
	pos (0, 0, -1000)
	unk1 0
	cam_from (0, 2500, 24000)
	cam_pers 500
	unk2 30
	cam_deg 45deg
	cam_limit 0deg 360deg
	cam_at (1100, 0, -3500)
	unk3 0
	unk4 0
	flags 0x0001
	town town[4]
	init fn[0,7]
	reinit fn[0,8]

anim[0] 256ms

sepith[0] 0 0 0 0 0 0 0 0

fn[0]:
	TextStart self
	if flag[3385]:
		TextTalk self {
			我還想說好不容易才出來外面……
			那棵飄浮在空中的樹到底是什麼啊？{wait}
		}
		TextWait
		TextTalk self {
			應該不會掉下來砸到哪裡吧？
			……我超擔心的。{wait}
		}
		TextWait
	elif flag[3371]:
	elif flag[3089]:
		if !flag[0]:
			TextTalk self {
				以前發生過的意外，
				原因出於兩大國的『暗鬥』……{wait}
			}
			TextWait
			TextTalk self {
				意思是說，那是兩國的間諜
				互相較勁的結果嗎？{wait}
			}
			TextWait
			TextTalk self {
				……老實說，我沒有想那麼多，
				但如果是真的，實在是不可原諒。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				以前發生過的意外，
				原因出於兩大國的『暗鬥』……{wait}
			}
			TextWait
			TextTalk self {
				……老實說，我沒有想那麼多，
				但如果是真的，實在是不可原諒。{wait}
			}
			TextWait
	elif flag[3074]:
		if !flag[0]:
			TextTalk self {
				有風聲說，雇用那個武裝集團的
				就是帝國政府……{wait}
			}
			TextWait
			TextTalk self {
				如果是的話，不知道對方
				什麼時候會再次發動攻擊。{wait}
			}
			TextWait
			TextTalk self {
				一想到這裡，我就很擔心……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				有風聲說，雇用那個武裝集團的
				就是帝國政府……{wait}
			}
			TextWait
			TextTalk self {
				一想到對方可能會再次發動攻擊，
				我就很擔心……{wait}
			}
			TextWait
	elif flag[2861]:
		TextTalk self {
			瑪因茲的人們現在
			一定過得很辛苦吧……{wait}
		}
		TextWait
		TextTalk self {
			一大群手持武器的人
			突然闖進來，
			這畫面光是用想的都覺得可怕……{wait}
		}
		TextWait
	elif flag[2848]:
		TextTalk self {
			今天媽媽拜託我幫忙跑腿。{wait}
		}
		TextWait
		TextTalk self {
			……因為屋頂漏水，
			要我趕快去買水桶。{wait}
		}
		TextWait
	elif flag[2837]:
		TextTalk self {
			居然出動了那麼多救護車……
			好像發生了很嚴重的意外呢。{wait}
		}
		TextWait
	elif flag[2832]:
		TextTalk self {
			我真的想要一個人搬出來住嗎？{wait}
		}
		TextWait
		TextTalk self {
			雖然很嚮往獨立的生活，
			但家裡只有自己一個人，
			感覺會很寂寞耶……{wait}
		}
		TextWait
	elif flag[2816]:
		if !flag[0]:
			TextTalk self {
				打工、打工……
				要穩定的話，應該就是去當服務生吧。{wait}
			}
			TextWait
			TextTalk self {
				不過，如果想趕快賺錢的話，
				去當公關小姐也行……{wait}
			}
			TextWait
			TextTalk self {
				……不行不行不行，
				我也真是的，到底在想什麼啊？{wait}
			}
			TextWait
			TextTalk self {
				不管多好賺，我都是絕對
				沒辦法陪大叔喝酒的！{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				想一個人生活，就得打工才行……
				我適合怎樣的工作呢？{wait}
			}
			TextWait
	elif flag[2573]:
		if !flag[0]:
			TextTalk self {
				如果要一個人住，我個人覺得
				住在西側大道那邊是首選……{wait}
			}
			TextWait
			TextTalk self {
				但考慮到房租和現實的因素，
				最後還是會落腳在東側大道那邊吧。{wait}
			}
			TextWait
			TextTalk self {
				舊市街雖然房租超便宜，
				但我很擔心治安問題……{wait}
			}
			TextWait
			TextTalk self {
				話說回來，如果要搬出來住，
				得先找到打工才行。
				……唉……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				如果要一個人住，我個人覺得
				住在西側大道那邊是首選……{wait}
			}
			TextWait
			TextTalk self {
				……話說回來，如果要搬出來住，
				得先找到打工才行。{wait}
			}
			TextWait
	elif flag[2568]:
		TextTalk self {
			哎呀呀，已經這麼晚啦。{wait}
		}
		TextWait
		TextTalk self {
			我得快點回家
			幫媽媽的忙才行。{wait}
		}
		TextWait
	elif flag[2564]:
		TextTalk self {
			各國領導人來到克洛斯貝爾的
			過程其實很短耶。{wait}
		}
		TextWait
		TextTalk self {
			大家都坐在車子裡，
			不太清楚誰是誰……
			但可以感受到ＶＩＰ的感覺。{wait}
		}
		TextWait
	elif flag[2560]:
		if !flag[0]:
			TextTalk self {
				畢竟明天開始就是通商會議，
				感覺氣氛真的有點嚴肅呢。{wait}
			}
			TextWait
			TextTalk self {
				剛才我還被巡邏的警官叫住，
				這還是我這輩子第一次
				被警察盤問呢。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				雖然是第一次被警察盤問，
				但總覺得這樣很失禮耶。{wait}
			}
			TextWait
			TextTalk self {
				不管是誰都不想大聲說
				自己是在幫忙家務嘛……
				真是丟臉丟到家了。{wait}
			}
			TextWait
	elif flag[2369]:
		TextTalk self {
			我不想要因為下雨
			就整天待在家裡。{wait}
		}
		TextWait
		TextTalk self {
			所以就撐著最喜歡的傘
			出來散步囉♪{wait}
		}
		TextWait
	elif flag[2353]:
		if flag[2437] && QuestFlagsGet quest[105] 0x10:
			TextTalk self {
				路上出現一大堆警車，
				嚇我一跳。{wait}
			}
			TextWait
			TextTalk self {
				不過，感覺很有警察的氣氛，
				好像有點帥呢。{wait}
			}
			TextWait
		elif !flag[0]:
			TextTalk self {
				討厭，我爸為什麼老是
				不穿衣服在家裡亂晃啊？{wait}
			}
			TextWait
			TextTalk self {
				該說是都沒顧慮到青春期的女兒嗎……
				根本就是犯罪了吧。{wait}
			}
			TextWait
			TextTalk self {
				啊～好想搬出去一個人住喔～{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				啊～好想搬出去一個人住喔～{wait}
			}
			TextWait
			TextTalk self {
				嗯～哪裡有
				好的房屋出租呢？{wait}
			}
			TextWait
	TextEnd self
	Return

fn[1]:
	TextStart self
	if flag[3385]:
		if !flag[1]:
			TextTalk self {
				雖然不太清楚詳細情況是怎樣，
