	_59
	TextSetPos -1 280 60 3
	TextEnd null
	Return

fn[25]:
	TextStart null
	if QuestFlagsGet quest[115] 0x02 && !QuestFlagsGet quest[115] 0x10 && !QuestFlagsGet quest[115] 0x40 && flag[2722]:
		if !flag[3815]:
			TextTalk name[161] {
				ジロンド武器商会……
				なるほど、ここは合法的な武器の店か。{wait}
			}
			TextWait
			TextTalk name[161] {
				よし、ちょっと寄ってくぞ。{wait}
			}
			TextWait
			if flag[3622]:
				Fork name[0] fork[1]:
					CharTurnToChar self name[161] 500deg/s
				Sleep 50ms
				Fork name[1] fork[1]:
					CharTurnToChar self name[161] 500deg/s
				Sleep 50ms
				Fork name[3] fork[1]:
					CharTurnToChar self name[161] 500deg/s
				Sleep 300ms
			elif flag[3623]:
				Fork name[0] fork[1]:
					CharTurnToChar self name[161] 500deg/s
				Sleep 50ms
				Fork name[1] fork[1]:
					CharTurnToChar self name[161] 500deg/s
				Sleep 50ms
				Fork name[8] fork[1]:
					CharTurnToChar self name[161] 500deg/s
				Sleep 300ms
			elif flag[3624]:
				Fork name[0] fork[1]:
					CharTurnToChar self name[161] 500deg/s
				Sleep 50ms
				Fork name[1] fork[1]:
					CharTurnToChar self name[161] 500deg/s
				Sleep 50ms
				Fork name[4] fork[1]:
					CharTurnToChar self name[161] 500deg/s
				Sleep 300ms
			TextTalk name[0] {
				#00003Fごめん、シン。
				君の言う通りここは武器の店なんだ。{wait}
			} {
				#00001F中には危ない商品もあるから、
				さすがに案内するわけには……{wait}
			}
			TextWait
			TextTalk name[161] {
				フンッ、ベツに
				商品に触らなければいいんだろ？{wait}
			}
			TextWait
			TextTalk name[161] {
				ここには興味があるんだ。
				ボクが寄ってくったら寄ってくぞ。{wait}
			}
			TextWait
			CharTurnToChar name[0] name[1] 500deg/s
			Sleep 300ms
			TextTalk name[0] {
				#00006F（ふぅ……
				{}  エリィ、お願いするよ。）{wait}
			}
			TextWait
			CharTurnToChar name[1] name[0] 500deg/s
			Sleep 300ms
			TextTalk name[1] {
				#00100F（ふふ、了解よ。）{wait}
			}
			TextWait
			CharTurnToChar name[1] name[161] 500deg/s
			Sleep 300ms
			TextTalk name[1] {
				#00103Fねえシン君、あなたは
				大事な大事な預かり物よ。{wait}
			} {
				だから私たちは、
				たとえ万が一の可能性でも
				危険を排除しないといけないの。{wait}
			} {
				#00100Fシン君なら賢いから
				事情は分かってくれるわよね？{wait}
			}
			TextWait
			TextTalk name[161] {
				う……
				確かに理解はできますが。{wait}
			}
			TextWait
			TextTalk name[1] {
				#00109Fふふ、よかった。
				やっぱりシン君はお利口さんね。{wait}
			}
			TextWait
			TextTalk name[161] {
				は、はい……
				ボク、お利口さんなんです！{wait}
			}
			TextWait
			if flag[3622]:
				TextTalk name[3] {
					#00309F（はは、お嬢の効果は絶大だな。）{wait}
				}
				TextWait
			elif flag[3623]:
				TextTalk name[8] {
					#10109F（あはは、
					{}  エリィさん効果は絶大ですね。）{wait}
				}
				TextWait
			elif flag[3624]:
				TextTalk name[4] {
					#10302F（ふふ、エリィの効果は絶大だね。）{wait}
				}
				TextWait
			FlagSet flag[3815]
		else:
			TextTalk name[0] {
				#00000F今はシンを連れているんだ。
				武器商会に入るのは止めておこう。{wait}
			}
			TextWait
	TextEnd null
	Return

