calmare ao_k scena
scena:
	name "c0100" "c0100" "c0100_1"
	town town[4]
	bgm bgm[150]
	flags 8192
	item_use fn[0,255]
	unk 255 0

entry:
	pos (0, 0, -1000)
	unk1 0
	cam_from (0, 2500, 24000)
	cam_pers 500
	unk2 30
	cam_deg 45deg
	cam_limit 0deg 360deg
	cam_at (1100, 0, -3500)
	unk3 0
	unk4 0
	flags 0x0001
	town town[4]
	init fn[0,7]
	reinit fn[0,8]

anim[0] 256ms

sepith[0] 0 0 0 0 0 0 0 0

fn[0]:
	TextStart self
	if flag[3385]:
		TextTalk self {
			やっとお外に出られたと思ったら……
			あの空に浮かんでいる樹は一体なんなの？{wait}
		}
		TextWait
		TextTalk self {
			まさかどこかに落ちて来ないわよね？
			……はてしなく不安だわ。{wait}
		}
		TextWait
	elif flag[3371]:
	elif flag[3089]:
		if !flag[0]:
			TextTalk self {
				過去に起こった事故が、
				２大国の“暗闘”によるものだった……{wait}
			}
			TextWait
			TextTalk self {
				それって、両国のスパイ同士が
				お互いやり合った結果っていうこと？{wait}
			}
			TextWait
			TextTalk self {
				……正直深く考えたことなかったけど、
				もしそれが本当なら許せないことよね。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				過去に起こった事故が、
				２大国の“暗闘”によるものだった……{wait}
			}
			TextWait
			TextTalk self {
				……正直深く考えたことなかったけど、
				もしそれが本当なら許せないことよね。{wait}
			}
			TextWait
	elif flag[3074]:
		if !flag[0]:
			TextTalk self {
				あの武装集団を雇ったのは
				帝国政府だって噂だけど……{wait}
			}
			TextWait
			TextTalk self {
				そういう意味では、いつまた
				襲ってくるか分からないのよね。{wait}
			}
			TextWait
			TextTalk self {
				そう思うと、ものすごく不安だわ……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				あの武装集団を雇ったのは
				帝国政府だって噂だけど……{wait}
			}
			TextWait
			TextTalk self {
				いつまた襲ってくるかと思うと、
				ものすごく不安だわ……{wait}
			}
			TextWait
	elif flag[2861]:
		TextTalk self {
			マインツの人たち、きっと
			今頃つらい思いをしてるわよね……{wait}
		}
		TextWait
		TextTalk self {
			武器を持った人たちが
			突然乗り込んで来るだなんて、
			想像するだけで怖いわ……{wait}
		}
		TextWait
	elif flag[2848]:
		TextTalk self {
			今日はママにお使いを頼まれたの。{wait}
		}
		TextWait
		TextTalk self {
			……雨漏りしたから、
			至急バケツを買って来てってね。{wait}
		}
		TextWait
	elif flag[2837]:
		TextTalk self {
			あんなに救急車が出動するなんて……
			結構大きな事故が起こったみたいね。{wait}
		}
		TextWait
	elif flag[2832]:
		TextTalk self {
			私って本当に一人暮らししたいのかな？{wait}
		}
		TextWait
		TextTalk self {
			確かに憧れはあるけど、
			何だかんだ家に１人だけって
			随分寂しい気がするわね……{wait}
		}
		TextWait
	elif flag[2816]:
		if !flag[0]:
			TextTalk self {
				バイト、バイト……
				無難な所ならウェイトレスとかかしら。{wait}
			}
			TextWait
			TextTalk self {
				けど、効率よく稼ぐなら
				ホステスという選択肢も……{wait}
			}
			TextWait
			TextTalk self {
				……いやいやいや、
				私ってば、一体何考えてるのかしら。{wait}
			}
			TextWait
			TextTalk self {
				いくら稼ぎがよくてもオジサンの
				お酒の相手なんて絶対に無理だからっ。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				一人暮らししたいならバイトしなきゃね……
				どういう仕事が私向きかしら？{wait}
			}
			TextWait
	elif flag[2573]:
		if !flag[0]:
			TextTalk self {
				一人暮らしをするなら、個人的に
				西通り方面が一番良いと思うんだけど……{wait}
			}
			TextWait
			TextTalk self {
				家賃とか現実的な線を考えると、
				結局、東通り方面に落ち着くのよね。{wait}
			}
			TextWait
			TextTalk self {
				旧市街は流石に破格だけど、
				何より治安が心配だし……{wait}
			}
			TextWait
			TextTalk self {
				っていうか、自立するなら
				その前にバイトでも探さなくちゃね。
				……ふう。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				一人暮らしをするなら、個人的に
				西通り方面が一番良いと思うんだけど……{wait}
			}
			TextWait
			TextTalk self {
				……っていうか、自立するなら
				その前にバイトでも探さなくちゃね。{wait}
			}
			TextWait
	elif flag[2568]:
		TextTalk self {
			あら、もうこんな時間なのね。{wait}
		}
		TextWait
		TextTalk self {
			早くお家に帰って
			ママのお手伝いをしないと。{wait}
		}
		TextWait
	elif flag[2564]:
		TextTalk self {
			首脳たちのクロスベル入りも
			終わってみればあっという間ね。{wait}
		}
		TextWait
		TextTalk self {
			みんな車に乗ってたから
			よく分からなかったけど……
			ＶＩＰ感だけは伝わって来たわ。{wait}
		}
		TextWait
	elif flag[2560]:
		if !flag[0]:
			TextTalk self {
				明日から通商会議とだけあって、
				流石にちょっと物々しい感じね。{wait}
			}
			TextWait
			TextTalk self {
				さっき、巡回している
				警察官に呼び止められて、
				人生初の職務質問をされちゃったわ。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				職務質問なんて初めてだったけど、
				何ていうか失礼しちゃうわよね。{wait}
			}
			TextWait
			TextTalk self {
				誰だって家事手伝いだなんて
				大きな声で言いたくないのに……
				とんだ辱めだわ。{wait}
			}
			TextWait
	elif flag[2369]:
		TextTalk self {
			私、雨だからって家の中で
			じっとしているのは嫌いなの。{wait}
		}
		TextWait
		TextTalk self {
			お気に入りの傘を差して、
			レッツ・お散歩ってね♪{wait}
		}
		TextWait
	elif flag[2353]:
		if flag[2437] && QuestFlagsGet quest[105] 0x10:
			TextTalk self {
				パトカーがいっぱい出てきて
				びっくりしちゃったわ。{wait}
			}
			TextWait
			TextTalk self {
				でも、なんだか警察らしくて
				カッコよかったかも。{wait}
			}
			TextWait
		elif !flag[0]:
			TextTalk self {
				もう、うちのパパったらどうして
				家の中を裸でうろうろするのかしら。{wait}
			}
			TextWait
			TextTalk self {
				年頃の娘に対する配慮に
				欠けると言うか……もはや犯罪よね。{wait}
			}
			TextWait
			TextTalk self {
				あ～、一人暮らししたいな～。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				あ～、一人暮らししたいな～。{wait}
			}
			TextWait
			TextTalk self {
				う～ん、どこかに
				いい物件はないものかしら。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[1]:
	TextStart self
	if flag[3385]:
		if !flag[1]:
