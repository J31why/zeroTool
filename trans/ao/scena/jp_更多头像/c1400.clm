fn[53]:
	TextStart null
	FadeOut 300ms 0x00000000 100
	TextSetName ""
	TextSetPos -1 -1 -1 -1
	TextMessage null {
		{color 5}アパート『メゾン・イメルダ』

		　～　現在運営休止中　～{wait}
	}
	TextWait
	TextClose 0
	if ItemHas item[801] 0:
		_59
		TextSetPos -1 280 60 3
		TextMessage null {
			{color 5}メゾン・イメルダの鍵を使いますか？{wait}
		}
		Menu menu[0] -1 -1 1
			"は　い" // 0
			"いいえ" // 1
		MenuWait var[0]
		MenuClose menu[0]
		TextClose 0
		if var[0] == 0:
			_59
			Sleep 500ms
			SoundPlay sound[806] 0 100 0
			Sleep 1000ms
			TextMessage null {
				{color 5}『メゾン・イメルダ』の鍵を開けた。{wait}
			}
			TextWait
			TextClose 0
			QuestTaskSet quest[103] 1
			FlagSet flag[2457]
			ObjFlagsSet object[1] 0x0010
			LookPointFlagsSet look_point[1] 0x0001
	else:
		FadeIn 300ms 0x00000000
		if !flag[13]:
			TextTalk name[0] {
				#00000F……鍵がかかってるみたいだ。{wait}
			}
			TextWait
			TextTalk name[1] {
				#00105Fこのアパートに魔獣退治の
				支援要請が入っていたわね。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00003F確か、管理人は
				アンティークショップの店主
				『イメルダ夫人』だったな。{wait}
			} {
				#00000F裏通りにある
				アンティークショップに
				鍵を借りにいこう。{wait}
			}
			TextWait
			FlagSet flag[13]
		else:
			TextTalk name[0] {
				#00000Fこのアパートには
				魔獣退治の支援要請が
				入っていたはずだ。{wait}
			} {
				#00000F裏通りにある
				アンティークショップに
				鍵を借りにいこう。{wait}
			}
			TextWait
	FadeIn 300ms 0x00000000
	_59
	TextSetPos -1 280 60 3
	TextEnd null
	Return
