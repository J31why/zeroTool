fn[3]:
	if flag[273]:
		FlagUnset flag[273]
		FlagSet flag[11]
		Event fn[0,24]
	elif flag[274]:
		FlagUnset flag[274]
		Event fn[0,41]
	if !flag[2861] && flag[2848]:
		if !flag[3038]:
			Event fn[0,42]
	if flag[3074] && !flag[3089]:
		FlagSet flag[11]
		if QuestFlagsGet quest[143] 0x10:
			CharFlagsSet char[0] 0x0010
			CharFlagsSet char[4] 0x0010
			CharSetPos char[4] (-4500, 0, -7300) 270deg
			CharSetPos char[0] (-5560, 0, -7300) 90deg
			CharSetPos char[1] (-5160, 0, -6000) 135deg
			CharSetPos char[16] (-8590, 0, 2730) 225deg
			CharFlagsUnset char[16] 0x0080
			CharFlagsSet char[6] 0x0080
			CharSetPos char[17] (3340, 0, 10090) 90deg
			CharFlagsUnset char[17] 0x0080
			CharSetPos char[15] (-5820, 0, -3790) 45deg
			ForkFunc char[15] fork[0] fn[0,2]
			CharFlagsUnset char[15] 0x0080
			CharSetChipBase char[5] chip[16]
			CharSetChipPattern char[5] 0
			ForkQuit char[5] fork[0]
			CharFlags2Set char[5] 0x0004
			CharSetChipBase char[14] chip[14]
			CharSetChipPattern char[14] 0
			ForkQuit char[14] fork[0]
			CharFlags2Set char[14] 0x0004
		else:
			CharFlagsSet char[5] 0x0010
			CharFlagsSet char[14] 0x0010
			CharFlagsSet char[12] 0x0010
			CharFlagsSet char[13] 0x0010
		CharSetChipBase char[7] chip[7]
		CharSetChipPattern char[7] 0
		ForkQuit char[7] fork[0]
		CharFlags2Set char[7] 0x0004
	Return

fn[4]:
	if flag[3074] && !flag[3089]:
		ObjFlagsSet object[11] 0x0004
		ObjFlagsSet object[12] 0x0004
		ObjFlagsSet object[13] 0x0004
		FlagSet flag[11]
	if flag[2848] && !flag[2858] | flag[2369] && system[4] == 1:
		ED7_76_0 object[255] "light01" 1
		ED7_76_0 object[255] "light04" 1
		SoundPlay sound[128] 1 50 0
	if !flag[3385] && flag[3370]:
		MapColor 0x00E6D2D2 0ms
		ED7_76_0 object[255] "light01" 1
		ED7_76_0 object[255] "light04" 1
	LookPointFlagsSet look_point[0] 0x0001
	ObjFlagsSet object[14] 0x0004
	if flag[3074]:
		LookPointFlagsUnset look_point[0] 0x0001
		ObjFlagsUnset object[14] 0x0004
	if flag[11]:
		system[1] = 162
		FlagUnset flag[11]
	Return

fn[5]:
	TextSetName ""
	TextSetPos -1 -1 -1 -1
	TextMessage null {
		{color 5}★特製スイートショコラの作り方★
		　～　みなさまもご家庭で
		　　　いかがですか？　　～{wait}
	}
	TextWait
	TextMessage null {
		{color 5}スイートショコラのレシピが書かれている。{wait}
	}
	TextWait
	TextClose 0
	_59
	TextSetPos -1 280 60 3
	if ItemHas item[2] 0:
		if !RecipeLearn 17:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextSetName ""
			TextMessage null {
				{color 2}『スイートショコラ』{color 0}のレシピを覚えた。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			FadeWait
			_59
			TextSetPos -1 280 60 3
	TextEnd null
	Return

fn[6]:
	TextStart self
	if QuestFlagsGet quest[143] 0x10:
		if !flag[4]:
			CharTurnToChar char[0] field_party[0] 500deg/s
			TextTalk char[0] {
				#02102Fあっ、あなた達もお疲れ様！{wait}
			} {
				今、ミスコンの参加者たちに
				インタビューしてるところなの。{wait}
			} {
				#02109Fフフ、あなたたちも後で
				ちゃんと付き合ってよね～♪{wait}
			}
			TextWait
			TextTalk name[0] {
				#00006F（う、う～ん、悪いけど、
				{}  時間をとられそうだしなあ……）{wait}
			}
			TextWait
			TextTalk name[4] {
				#10302F（フフ、こっそり逃げた方が
				{}  よさそうだね。）{wait}
			}
			TextWait
			CharTurnTo char[0] 90deg 500deg/s
			FlagSet flag[4]
		else:
			TextTalk char[0] {
				#02105Fあらま、そうなんですか？{wait}
			} {
				#02100F確かにあんな事件があった後だし、
				ご家族に顔を見せたほうが
				いいかもしれませんね。{wait}
			}
			TextWait
	elif !flag[3302]:
		TextTalk char[0] {
			#02109Fやっほー、ロイド君たち！{wait}
		}
		TextWait
		TextTalk name[0] {
			#00000Fグレイスさん……
			チャリティイベントの取材ですか？{wait}
		}
		TextWait
		TextTalk char[0] {
			#02100Fふふ、そういうこと☆{wait}
		} {
			かなり賑やかみたいだし、
			クロスベル市民たちも
			元気になれる記事が書けそうだわ。{wait}
		} {
			#02103Fあの襲撃事件の傷跡は
			まだ消えていないし……{wait}
		} {
			#02102Fあたしたちマスコミも、
			出来ることをやんなくちゃね。{wait}
		}
		TextWait
		TextTalk name[3] {
			#00309Fはは、がんばって下さいッス。{wait}
		}
		TextWait
		FlagSet flag[3302]
	else:
		TextTalk char[0] {
			#02102Fなんでも、チャリティイベントには
			面白そうなプログラムがあるって
			噂になってるし……{wait}
		} {
			#02109Fふふ、ばっちりスクープするわよっ！{wait}
		}
		TextWait
	TextEnd self
	Return

fn[7]:
	TextStart self
	if QuestFlagsGet quest[143] 0x10:
		TextTalk self {
			ミスコン、なかなか
			見応えがありましたねえ。{wait}
		}
		TextWait
		TextTalk self {
			いい写真も一杯撮れたし、
			早く帰ってまとめ直さないと。{wait}
		}
		TextWait
	else:
		TextTalk self {
			チャリティイベントに呼ばれた
			美人ピアノ奏者……{wait}
		}
		TextWait
		TextTalk self {
			なかなかいい写真が撮れそうですね。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[8]:
	TextStart self
	if QuestFlagsGet quest[143] 0x10:
		if !flag[5]:
			TextTalk self {
				いや～、まさかサンサンが
				ミスコンに参加するとは
				思ってなかったぜ。{wait}
			}
			TextWait
			TextTalk self {
				ま、おかげでいつもの調子が
				少しは戻ってきたみたいだし、
				結果オーライって感じだな。{wait}
			}
			TextWait
			FlagSet flag[5]
		else:
			TextTalk self {
				しかし、サンサンが
				ミスコンに参加したとなると……{wait}
			}
			TextWait
			TextTalk self {
				……マスター、怒ってなきゃいいが。{wait}
			}
			TextWait
	elif !flag[5]:
		TextTalk self {
			《龍老飯店》から
			チャリティイベントに
			料理を出してるんだ。{wait}
		}
		TextWait
		TextTalk self {
			店のほうでは俺がいない穴を
			パックとルースに任せてる。{wait}
		}
		TextWait
		TextTalk self {
			ちょっと心配だが、
			あいつらもマシになったし
			多分大丈夫だろうな。{wait}
		}
		TextWait
		FlagSet flag[5]
	else:
		TextTalk self {
			しかし……サンサンのヤツが
			最近元気がねえんだよな。{wait}
		}
		TextWait
		TextTalk self {
			コンテストの参加も
			断っちまったみたいだし……
			早く元気になりゃいいが。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[9]:
	TextStart self
	if QuestFlagsGet quest[143] 0x10:
		if !flag[9]:
			TextTalk self {
				#15010Fうふふ、これで
				お店のお客さんが増えたら
				パパも大喜びね。{wait}
			} {
				#15004F……リーシャの事は心配だけど、
				きっと帰ってくるはずよ。{wait}
			} {
				#15000Fその時に笑顔で迎えられるように、
				私も元気にして待ってないとね。{wait}
			}
			TextWait
			FlagSet flag[9]
		else:
			TextTalk self {
				#15004Fリーシャの事は心配だけど、
				きっと帰ってくるはずよ。{wait}
			} {
				#15000Fその時に笑顔で迎えられるように、
				私も元気にして待ってないとね。{wait}
			}
			TextWait
	else:
	TextEnd self
	Return

fn[10]:
	TextStart self
	if QuestFlagsGet quest[143] 0x10:
		if !flag[10]:
			TextTalk self {
				はあ……私のような者が、
				あんな壇上に上がってしまって……{wait}
			}
			TextWait
			TextTalk name[1] {
				#00109Fふふ……ジョアンナ、
				とってもかわいらしかったわよ。{wait}
			}
			TextWait
			TextTalk self {
