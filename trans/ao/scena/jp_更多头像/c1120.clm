	TextTalk char[30] {
		外国人、とりわけ帝国人と共和国人を
		優遇する不平等な法体制！{wait}
	}
	TextWait
	TextTalk char[30] {
		市民の血税の１０％をも
		２大国に納めねばならぬ取り決め！{wait}
	}
	TextWait
	TextTalk char[30] {
		どう考えても
		おかしいとは思わないのか！？{wait}
	}
	TextWait
	TextTalk char[31] {
		我々が今、立ち上がらなければ
		この状況は未来永劫に渡って
		続くんですよ！？{wait}
	}
	TextWait
	TextTalk char[31] {
		本当にそれでいいんですか！？{wait}
	}
	TextWait
	TextTalk char[29] {
		……フン、馬鹿馬鹿しい。{wait}
	}
	TextWait
	TextTalk char[29] {
		現実問題として、力が伴わなければ
		国家独立など絵に描いた餅にすぎん。{wait}
	}
	TextWait
	TextTalk char[29] {
		いざ他国の大軍が侵攻してきたら
		戦車も持たない警備隊でどう防ぐのだ？{wait}
	}
	TextWait
	TextTalk char[30] {
		その他国というのはどう考えても
		エレボニア帝国のことだろう！{wait}
	}
	TextWait
	TextTalk char[30] {
		西のガレリア要塞に《列車砲》なる
		クロスベル市を狙える大量破壊兵器が
		配備されているのは周知の事実だ！{wait}
	}
	TextWait
	TextTalk char[31] {
		戦車にしても、軍用飛行艇にしても
		クロスベルの豊かな財政なら
		十分に配備することが可能です！{wait}
	}
	TextWait
	TextTalk char[31] {
		重要なのは我々の
		決断なのではありませんか！？{wait}
	}
	TextWait
	TextTalk char[29] {
		判らん連中だな……
		現実を見ろと言っているのだ！{wait}
	}
	TextWait
	TextTalk char[29] {
		第一、クロスベルの繁栄は
		帝国と共和国から流れ込んでくる
		ミラに負うところが大きいのだ！{wait}
	}
	TextWait
	TextTalk char[29] {
		独立などして壁を作ってしまったら
		その富も消えるかもしれんのだぞ！？{wait}
	}
	TextWait
	TextTalk char[28] {
		まあまあ、皆さん落ち着いて。{wait}
	}
	TextWait
	TextTalk char[28] {
		……いずれにしても問題は、
		このような強引な独立提言を
		国際社会が容認するかどうかにある。{wait}
	}
	TextWait
	TextTalk char[28] {
		その議論が欠けているのではないかね？{wait}
	}
	TextWait
	TextTalk char[30] {
		この際、国際社会は関係ない！{wait}
	}
	TextWait
	TextTalk char[30] {
		クロスベルの国家独立こそ
		“正義”を実現する唯一無二の道！{wait}
	}
	TextWait
	TextTalk char[31] {
		所詮あなたもカルバードの
		都合のいい代弁者に過ぎないわけか！{wait}
	}
	TextWait
	TextTalk char[28] {
		た、確かに私は
		共和国派などと呼ばれてはいるが……{wait}
	}
	TextWait
	TextTalk char[28] {
		クロスベルを愛する心にかけては
		誰にも負けない自信はあるつもりだ！{wait}
	}
	TextWait
	TextTalk char[28] {
		その言葉、訂正してもらおうか！{wait}
	}
	TextWait
	CrossFade 500ms
	CamSetDistance 6040 5500 -5410 0ms
	ED7CamRotate 29deg 31deg 0deg 0ms
	CamPers 440 0ms
	CamZoom 21420 0ms
	CharSetPos name[0] (6940, 4000, -3750) 315deg
	CharSetPos name[2] (6910, 4000, -4960) 315deg
