	FadeWait
	TextTalk name[3] {
		#00300F雨の日だっつーのに、
		なかなか盛り上がってるなぁ。{wait}
	}
	TextWait
	TextTalk name[0] {
		#00000Fああ、市民からの参加者も
		思っていた以上に多いな……{wait}
	} {
		#00003Fしかし帝国派と共和国派の有力議員と
		最近、勢いを増しているっていう
		独立派の若手議員たちの論戦か。{wait}
	}
	TextWait
	TextTalk name[4] {
		#10302Fフフ、今のクロスベルの政治状況を
		反映したかのような顔ぶれだね。{wait}
	}
	TextWait
	TextTalk name[2] {
		#00200F何だか、どちらの言い分も
		もっともらしく聞こえますけど……{wait}
	}
	TextWait
	TextTalk name[1] {
		#00103F……実際、この問題は
		簡単に結論できるものではないわ。{wait}
	} {
		それこそ何十年にも渡って
		同じような議論が繰り返されてきた。{wait}
	} {
		#00101Fでも、確かにそろそろ真剣に
		結論を出すべき時かもしれない……{wait}
	}
	TextWait
	TextTalk name[8] {
		#10101F………そうですね。{wait}
	} {
		#10108F（前途多難な独立か
		{}  それとも正義なき従属か……）{wait}
	}
	TextWait
