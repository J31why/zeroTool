fn[13]:
	TextStart self
	if QuestFlagsGet quest[143] 0x10:
		if flag[7]:
			TextTalk char[0] {
				#02100Fふむふむ、それじゃあ
				職場の同僚から勧められて？{wait}
			}
			TextWait
			TextTalk self {
				ええ、そうなんです。{wait}
			}
			TextWait
			TextTalk self {
				ふふ、ミスコンの壇上は
				本当に緊張しました。{wait}
			}
			TextWait
			TextTalk self {
				でも、皆さんに拍手をもらえたのは
				素直に嬉しかったです。{wait}
			}
			TextWait
			TextTalk self {
				ふふ、やっぱり出てよかったですね。{wait}
			}
			TextWait
			TextTalk char[0] {
				#02104Fふんふん……（サラサラ）{wait}
			}
			TextWait
		else:
			TextTalk self {
				実は私、近い内に
				故郷のレミフェリアに帰る予定なんです。{wait}
			}
			TextWait
			TextTalk self {
				すぐに戻ってくるつもりですが……
				両親へのいい土産話ができましたね。{wait}
			}
			TextWait
	else:
		TextTalk self {
			この後のプログラムで、
			壇上に上がらなくては
			いけないんです。{wait}
		}
		TextWait
		TextTalk self {
			人前に立つのは
			職業柄慣れているのですが、
			やっぱり緊張してしまいますね。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[14]:
	TextStart self
	if QuestFlagsGet quest[143] 0x10:
		TextTalk self {
