		}
		TextWait
		TextTalk self {
			ふう、警戒も楽じゃねえな。{wait}
		}
		TextWait
	elif flag[2560]:
		if !flag[13]:
			TextTalk self {
				ああ、特務支援課か。{wait}
			}
			TextWait
			TextTalk self {
				見ての通りこっちは今、
				露店通りを警戒中だぜ。{wait}
			}
			TextWait
			TextTalk self {
				アンタらはアンタらの
				やれることを尽くしてくれよ。{wait}
			}
			TextWait
			FlagSet flag[13]
		else:
			TextTalk self {
				見ての通りこっちは今、
				露店通りを警戒中だぜ。{wait}
			}
			TextWait
			TextTalk self {
				アンタらはアンタらの
				やれることを尽くしてくれよ。{wait}
			}
			TextWait
	TextEnd self
	Return
