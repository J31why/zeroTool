fn[6]:
	TextStart char[1]
	if flag[3385]:
		if !flag[1]:
			TextTalk char[1] {
				あんな樹が現れるなんて、
				と、とんでもないことに
				なってしまいましたね～……{wait}
			}
			TextWait
			TextTalk char[1] {
				師長からは患者さんに
				不安を与えないよう冷静にって
				言われてるんですけど……{wait}
			}
			TextWait
			TextTalk char[1] {
				はあ、とてもじゃないけど
				落ち着いてられませんよね～……{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk char[1] {
				あ、セシル先輩なら
				あの大きな樹を見るために
				敷地内の休憩所にいきましたよ～。{wait}
			}
			TextWait
			TextTalk char[1] {
				はあ、先輩は落ち着いてて
				スゴいですよね～……{wait}
			}
			TextWait
	elif flag[3362]:
		TextTalk char[1] {
			街に帰れなくなってる
			入院患者さんや外来の方への
			対応をしているところなんです～。{wait}
		}
		TextWait
		TextTalk char[1] {
			街であんなことが起こった以上、
			しばらくこの状況は続きそうですね～。{wait}
		}
		TextWait
	elif flag[3338]:
		if !flag[1]:
			TextTalk char[1] {
				ドノバンさんの回復は
				かなり順調ですし、近いうちに
				退院も出来ると思います。{wait}
			}
			TextWait
			TextTalk char[1] {
				だけど、イリアさんは
				根気強くリハビリをしても
				完治するか分からないんだとか……{wait}
			}
			TextWait
			TextTalk char[1] {
				なんとか頑張って
				復活できるといいんですけど。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk char[1] {
				イリアさんは
				根気強くリハビリをしても
				完治するか分からないなんだとか……{wait}
			}
			TextWait
			TextTalk char[1] {
				それでも、いいしれない希望を
				感じさせてくれるのが
				イリアさんの凄い所ですよね。{wait}
			}
			TextWait
	elif flag[3328]:
		if !flag[1]:
			TextTalk char[1] {
				イリアさんやドノバンさんの
				意識が戻ったんですよ～。{wait}
			}
			TextWait
			TextTalk char[1] {
				最近は何かと物騒な話ばかりで
