				退院には時間がかかりそうなんです。{wait}
			}
			TextWait
			TextTalk char[1] {
				今まで色んな患者さんが
				入院してきましたけど、
				さすがに目を覆いたくなりますよ……{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk char[1] {
				今まで色んな患者さんが
