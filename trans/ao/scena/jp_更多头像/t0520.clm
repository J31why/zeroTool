fn[6]:
	if QuestFlagsGet quest[128] 0x02 && !QuestFlagsGet quest[128] 0x10 && !QuestFlagsGet quest[128] 0x40 && flag[2960] && !flag[2968]:
		Call fn[0,35]
		Return
	if QuestFlagsGet quest[133] 0x02 && !QuestFlagsGet quest[133] 0x10 && !QuestFlagsGet quest[133] 0x40 && flag[2989] && !flag[2990]:
		Call fn[0,36]
		Return
	TextStart char[0]
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"話をする" // 0
			"買い物をする" // 1
			"休憩をする" // 2
			"やめる" // 3
		MenuWait var[0]
		if var[0] < 1 | var[0] > 2:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			ShopOpen shop[82]
			var[0] = 99
		elif var[0] == 2:
			ShopOpen shop[80]
			var[0] = 99
		elif var[0] == 3:
		else:
			if var[0] != 0:
				TextEnd char[0]
				Return
			if var[0] == 0:
				var[0] = 99
				if flag[16]:
					TextTalk char[0] {
						フフ、鉱山町名物の
						ステーキを食べれば、
						たちまち力が湧いてくるよ。{wait}
					}
					TextWait
					TextTalk char[0] {
						あんたたちも、
						ガッツリ食べたい時は
						またウチに来るんだね。{wait}
					}
					TextWait
				elif flag[3385]:
					if !flag[0]:
						TextTalk char[0] {
							街での騒ぎのあと、
							疲れ果てた様子の遊撃士たちと、
							泣きはらした顔の女の子が来てね。{wait}
						}
						TextWait
						TextTalk char[0] {
							彼らもクロスベル市での
							解放作戦に参加したらしいんだ。{wait}
						}
						TextWait
						TextTalk char[0] {
							レジスタンスに協力してた
							あたしたちとしては、是非とも
							労ってあげたいところだね。{wait}
						}
						TextWait
						FlagSet flag[0]
					else:
						TextTalk char[0] {
							下で休んでる遊撃士たちは、
							クロスベル市での
							解放作戦に参加したらしいんだ。{wait}
						}
						TextWait
						TextTalk char[0] {
							さっき別の遊撃士さんも来て
							魔獣退治を手伝ってくれたし……
							本当に彼らには世話になるよ。{wait}
						}
						TextWait
				elif flag[3362]:
					if !flag[0]:
						TextTalk char[0] {
							今、レジスタンスのリーダー
							ミレイユさんが補給に来てるとこだ。{wait}
						}
						TextWait
						TextTalk char[0] {
							あんたたち、近々
							大きな作戦をやるんだって？{wait}
						}
						TextWait
						TextTalk char[0] {
							あたし達も応援してるよ。
							気張っていくんだね。{wait}
						}
						TextWait
						FlagSet flag[0]
					else:
						TextTalk char[0] {
							あんたたち、近々
							大きな作戦をやるんだって？{wait}
						}
						TextWait
						TextTalk char[0] {
							あたし達も応援してるよ。
							気張っていくんだね。{wait}
						}
						TextWait
				elif flag[3328]:
					if !flag[3439]:
						CharTurnToChar char[0] name[3] 0deg/s
						TextTalk char[0] {
							ランディ、レジスタンスから
							一度離れたんだってね？{wait}
						}
						TextWait
						TextTalk name[3] {
							#00304Fああ、助けてやらなきゃならん
							愛娘が待ってるんでな。{wait}
						} {
							#00302Fオバちゃん、しばらくの間
							マインツの奴らと一緒に
							ミレイユたちを頼んだぜ。{wait}
						}
						TextWait
						TextTalk char[0] {
							はは、了解だ。
							あんたも気をつけるんだよ。{wait}
						}
						TextWait
						FlagSet flag[3439]
					elif !flag[0]:
						TextTalk char[0] {
							レジスタンスの子達には、
							山岳地帯のいい隠れ場所を教えたり、
							食糧や薬の補給を手伝ったり……{wait}
						}
						TextWait
						TextTalk char[0] {
							国防軍の連中が捜索に来ても
							徹底的にしらんぷりしてやったり、
							とまあ色々手伝ってるんだ。{wait}
						}
						TextWait
						TextTalk char[0] {
							大したことじゃないけど、
							出来る限りの事はしてあげないとね。{wait}
						}
						TextWait
						FlagSet flag[0]
					else:
						TextTalk char[0] {
							レジスタンスには
							頑張って欲しいものだよ。{wait}
						}
						TextWait
						TextTalk char[0] {
							大した手伝いはできないけど、
							出来る限りの事はしてあげないとね。{wait}
						}
						TextWait
				elif flag[3074]:
					if !flag[0]:
						TextTalk char[0] {
							あの武装集団の連中は、
							結局町の人間や食料なんかには
							一切手をつけなかったんだ。{wait}
						}
						TextWait
						TextTalk char[0] {
							恐ろしい目にあったことには
							変わりないけど、大きな被害が出た
							警備隊に比べたらマシかもしれないね。{wait}
						}
						TextWait
						TextTalk char[0] {
							……しかし、何が目的だったのかねえ。
							本当にワケが分からないよ。{wait}
						}
						TextWait
						FlagSet flag[0]
					else:
						TextTalk char[0] {
							武装集団の連中……
							何が目的だったのかねえ。{wait}
						}
						TextWait
						TextTalk char[0] {
							本当にワケが分からないよ。{wait}
						}
						TextWait
				elif flag[2848]:
					TextTalk char[0] {
						うーん、心地いい雨だねえ。{wait}
					}
					TextWait
					TextTalk char[0] {
						こんな日は
						夜のお客も少なくなるし、
						ノンビリしてるとするかね。{wait}
					}
					TextWait
				elif flag[2832]:
					if !QuestFlagsGet quest[133] 0x10 && flag[2990]:
						if !flag[0]:
							TextTalk char[0] {
								リベール製のグラス、
								ちゃんと届いてよかったよ。{wait}
							}
							TextWait
							TextTalk char[0] {
								間違えて届いた荷物に
