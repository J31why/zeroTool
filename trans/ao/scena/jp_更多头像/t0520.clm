								本当にギョッとしたもんさ。{wait}
							}
							TextWait
							TextTalk char[0] {
								ハハ、とにかくあんたたちも
								ご苦労だったね。
								礼を言わせてもらうよ。{wait}
							}
							TextWait
							FlagSet flag[0]
						else:
							TextTalk char[0] {
								ちょっと前に注文した
								リベール製のグラス、
								ちゃんと届いてよかったよ。{wait}
							} {
								本当にギョッとしたもんさ。{wait}
							}
							TextWait
							TextTalk char[0] {
								ハハ、とにかくあんたたちも
								ご苦労だったね。
								礼を言わせてもらうよ。{wait}
							}
							TextWait
					elif !flag[0]:
						TextTalk char[0] {
							マルロさん、
							ようやく元気になったらしいよ。{wait}
						}
						TextWait
						TextTalk char[0] {
							リュッカの慰め方は、
							ハタから見ても物凄く
							素っ気無かったもんだが……{wait}
						}
						TextWait
						TextTalk char[0] {
							まあ、本人がそれで
							元気がでたならいいってことさ。{wait}
						}
						TextWait
						FlagSet flag[0]
					else:
						TextTalk char[0] {
							ま、これでマルロさんも
							元気になったみたいだし……
							ひとまず一件落着かね。{wait}
						}
						TextWait
				elif flag[2816]:
					if !flag[0]:
						TextTalk char[0] {
							最近、マルロさんは
							リュッカに嫌われたと
							思いこんでるらしくてね。{wait}
						}
						TextWait
						TextTalk char[0] {
							酒場にも顔を出さないし、
							仕事にも身が入らなくて
							困ってるらしいんだよ。{wait}
						}
						TextWait
						TextTalk char[0] {
							リュッカ本人に自覚がないから
							微妙な話になってるのよねえ……{wait}
						}
						TextWait
						FlagSet flag[0]
					else:
						TextTalk char[0] {
							でも、ガンツさんも
							いいところあるじゃないか。
							友達のために直談判なんてさ。{wait}
						}
						TextWait
						TextTalk char[0] {
