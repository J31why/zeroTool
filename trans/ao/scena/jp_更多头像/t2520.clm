			} {
				#07601F#11Pその上、不届きな輩が
				無理やりゲートを通るなんて事も
				起こってしまっている。{wait}
			} {
				#07603F#11Pそんなわけで、
				気が抜けない状態なのさ。{wait}
			}
			TextWait
			TextTalk name[1] {
				#6P#00100Fそうでしたか……{wait}
			}
			TextWait
			TextTalk name[0] {
				#6P#00003F（俺たちが取り逃がしてしまった
				　医療物資の窃盗犯か……）{wait}
			} {
				#00001F……でも、今回の依頼はそのあたりも
				関係しているわけですね？{wait}
			}
			TextWait
		else:
			TextTalk char[1] {
				#07603F#11P門に入ってきてお前たちも
				ひしひし感じているだろうが……{wait}
			} {
				#07601F#11P現在、クロスベル警備隊は
				厳戒態勢にあってな。{wait}
			} {
				#07601F#11Pちぃっとばかし、
				気が抜けねえ状態なのさ。{wait}
			}
			TextWait
			TextTalk name[0] {
				#6P#00001Fなるほど……
				今回の依頼はそのあたりのことも
				関係しているわけですね。{wait}
			}
			TextWait
