			#07603F#11Pあぁ、そういうことになるな。{wait}
		} {
			#07601F#11Pさっそく、仕事の内容を
			説明しようと思うが……{wait}
		} {
			#07601F#11Pお前さんたち、
			依頼を引き受けてくれるか？{wait}
		}
		TextWait
	else:
		TextTalk char[1] {
			#07601F#11Pお前さんたち、手は空いたのか？{wait}
		} {
			#07601F#11P早速依頼を引き受けてもらいたいが……{wait}
		}
		TextWait
