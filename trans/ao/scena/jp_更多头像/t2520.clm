fn[9]:
	if QuestFlagsGet quest[111] 0x02 && !QuestFlagsGet quest[111] 0x10 && !QuestFlagsGet quest[111] 0x40 && flag[2704]:
		Call fn[0,11]
		Return
	if QuestFlagsGet quest[145] 0x02 && !QuestFlagsGet quest[145] 0x10 && !QuestFlagsGet quest[145] 0x40 && !flag[3292]:
		Call fn[0,20]
		Return
	TextStart char[1]
	if flag[3074]:
		if QuestFlagsGet quest[145] 0x02:
			if !QuestFlagsGet quest[145] 0x10:
				if !flag[1]:
					TextTalk char[1] {
						#07601F古戦場の封鎖は解除するよう
						すでに連絡はしておいた。{wait}
					} {
						#07603Fアルモリカ古道方面から
						魔獣の発生現場に向かってくれ。{wait}
					} {
						#07601F警備隊として、魔獣退治に
						手を割けないのは心苦しい思いだが……{wait}
					} {
						#07600Fお前さんたちならこの件を
						解決してくれると信じているぞ。{wait}
					}
					TextWait
					FlagSet flag[1]
				else:
					TextTalk char[1] {
						#07601F古戦場の封鎖は解除するよう
						すでに連絡はしておいた。{wait}
					} {
						#07603F古道方面から現場に向かってくれ。{wait}
					} {
						#07600Fお前さんたちならこの件を
						解決してくれると信じているぞ。{wait}
					}
					TextWait
			elif !flag[3307]:
				TextTalk char[1] {
					#07600Fご苦労だったな、支援課諸君。{wait}
				} {
					#07604Fまだまだ問題は山積みだが、
					おかげで懸案していた事が
					一つ片付いた。{wait}
				} {
					#07602Fあの襲撃事件で受けた被害で、
					人手も足らない所だったからな。
					本当に感謝している。{wait}
				}
				TextWait
				TextTalk name[0] {
					#00000Fいえ、困った時はお互い様ですから。{wait}
				}
				TextWait
				TextTalk name[1] {
					#00103F……警備隊の被害は
					本当に甚大だったんですよね。{wait}
				} {
					#00101F今後の建て直しの見込みは、
					どれくらい立っているんでしょうか？{wait}
				}
				TextWait
				TextTalk char[1] {
					#07603F……この緊張状態への対応もあって、
					正直言ってままなっていない。{wait}
				} {
					#07601Fだが、ノエル曹長が警備隊に戻れば
					そちらにも手が回せるようになるだろう。{wait}
				} {
					#07601Fその際は、是非とも然るべきポストで
					組織の建て直しに貢献してもらう
					ことになるだろう。{wait}
				}
				TextWait
				if system[10] != 255:
					Emote field_party[0] 0mm 2000mm 38 38 250ms 1
					Sleep 50ms
				if system[11] != 255:
					Emote field_party[1] 0mm 2000mm 38 38 250ms 1
					Sleep 50ms
				if system[12] != 255:
					Emote field_party[2] 0mm 2000mm 38 38 250ms 1
					Sleep 50ms
				if system[13] != 255:
					Emote field_party[3] 0mm 2000mm 38 38 250ms 1
				Sleep 1000ms
				TextTalk name[3] {
					#00305Fそいつは……{wait}
				}
				TextWait
				TextTalk name[8] {
					#10108F……昇進、ということですか？{wait}
				}
				TextWait
				TextTalk char[1] {
					#07603F……今回、警備隊の被害が
					ある意味最も大きかったのは、
					『士気』へのダメージだ。{wait}
				} {
					#07601F仲間の犠牲のショックを受け、
					警備隊の役割そのものへの恐怖に
					蝕まれた者は相当数に上るだろう。{wait}
				} {
					#07603F一部の隊員たちは、
					怒りや矜持を拠り所にして
					何とかそれを保っているようだが……{wait}
				}
				TextWait
				TextTalk name[2] {
					#00203F……そうですね。
					そういった想いは
					ひしひしと伝わってきます。{wait}
				}
				TextWait
				TextTalk char[1] {
					#07603F失われた士気を取り戻す為にも、
					優秀な士官は必ず必要になる。{wait}
				} {
					#07601Fまだ確定事項ではないが……
					お前さんにはその能力が
					充分にあるはずだ。{wait}
				}
				TextWait
				TextTalk name[8] {
					#10103F……ミレイユ三尉のように
					できるかは分かりませんけど……{wait}
				} {
					#10101Fそうなった場合は謹んで、
					使命を全うさせていただきます。{wait}
				}
				TextWait
				TextTalk char[1] {
					#07601F……すまない。
					しばらく辛い時が続くだろうが、
					よろしく頼むぞ。{wait}
				}
				TextWait
				FlagSet flag[3307]
			else:
				TextTalk char[1] {
					#07603F警備隊を立て直す為にも、
					曹長には然るべきポストについて
