			}
			TextWait
			TextTalk name[4] {
				#10304Fフフ、分かってないなあ。{wait}
			} {
				#10309F女の子の噂話なんて、
				その場に男がいたら
				できないことがほとんどだよ？{wait}
			}
			TextWait
			TextTalk name[0] {
				#00006F（へ、偏見混じりだとは思うけど……
				{}  微妙に恐ろしいものを感じるな。）{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				ノエル曹長……早く警備隊に
