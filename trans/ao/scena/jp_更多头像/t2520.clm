			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalkNamed char[0] "兵士フラミー" {
				ダグラス副司令は、
				現在クロスベル市で今後の対応を
				検討しているみたいです。{wait}
			}
			TextWait
			TextTalkNamed char[0] "兵士フラミー" {
				国防軍として、どれだけの事を
				できるかは分かりませんが……
				なんとか頑張りたいですね。{wait}
			}
			TextWait
	elif flag[3074]:
		if !flag[0]:
			TextTalk char[0] {
				ノエル曹長……
				妹さん、助かって本当に
				良かったですね。{wait}
			}
			TextWait
			TextTalk name[8] {
				#10108Fええ……警備隊の被害を見ると
