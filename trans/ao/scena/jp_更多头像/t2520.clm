		#6P#00012Fえ、えっと……{wait}
	}
	TextWait
	TextTalk name[3] {
		#6P#00305Fなんだ、ダグラスの兄さん。
		すっかり黙っちまってよ。{wait}
	}
	TextWait
	TextTalk name[8] {
		#10106F軍用犬を退治しなかったのは
		やっぱマズかったでしょうか？{wait}
	}
	TextWait
	TextTalk char[1] {
		#07604F#11P……いや、上出来だろうぜ。{wait}
	} {
		#07602F#11P予想を超えた結果なんで
		ちょっとおどろいちまってな。{wait}
	}
	TextWait
	TextTalk name[4] {
		#6P#10300Fま、そうだろうね。{wait}
	} {
		#10309F『軍用犬を説得した』だなんて、
		普通なら眉唾物の話だもの。{wait}
	}
	TextWait
	TextTalk name[1] {
		#6P#00106Fた、確かに信じられない
		かもしれないわね。{wait}
	}
	TextWait
	TextTalk name[2] {
		#00200Fでも、事実ですから
		何も問題はないかと。{wait}
	}
	TextWait
	TextTalk char[1] {
		#07604F#11P……いや、結構だ。{wait}
	} {
		#07600F#11P穏便な解決ができるなら
