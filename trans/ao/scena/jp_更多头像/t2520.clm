			}
			TextWait
			TextTalk name[8] {
				#10106F（も、戻ったら大変そうだなあ……）{wait}
			}
			TextWait
	elif flag[2560]:
		if !flag[0]:
			TextTalk char[0] {
				ダグラス副司令は以前、
