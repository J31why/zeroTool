			しているこの状況……{wait}
		} {
			#07601F#11P先ほどのような事がないよう
			警備隊としては、国境の警備は
			特に厳重にする必要があるだろう。{wait}
		}
		TextWait
	else:
		TextTalk char[1] {
			#07606F#11Pそうしたいところだが……
			さっきも言ったように、
			警備隊は厳戒態勢なんだ。{wait}
		} {
			#07601F#11Pクロスベル市襲撃犯と目される
			《赤い星座》も姿をくらまし、
			尻尾すらつかめていない。{wait}
		} {
			#07603F#11Pさらに帝国と共和国が
