			}
			TextWait
			TextTalk char[0] {
				クロスベルを守るために
				その命を燃やし、捧げる……
				それが警備隊の使命ですから。{wait}
			}
			TextWait
	elif flag[2848]:
		if !flag[0]:
			TextTalk char[0] {
				昨日の列車の脱線事故……{wait}
			}
			TextWait
			TextTalk char[0] {
				住民投票が近づいている
				このタイミングで起こったことを
