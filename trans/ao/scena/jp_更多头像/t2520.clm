fn[22]:
	TextTalk name[0] {
		#6P#00000Fええ、よろしくお願いします。{wait}
	}
	TextWait
	TextTalk char[1] {
		#07600F#11Pうむ、恩に着るぞ。{wait}
	} {
		#07601F#11P──依頼にも書いていたことだが、
		近頃、謎の『黒い魔獣』が出るという
		目撃情報が寄せられていてな。{wait}
	} {
		#07601F#11Pアルモリカ村の付近などで
		農作物や家畜などに
		被害が出てしまっているらしい。{wait}
	}
	TextWait
	TextTalk name[1] {
		#6P#00105F黒い魔獣……
		どこかで聞いたことが
		あるような印象ね。{wait}
	}
	TextWait
	TextTalk name[3] {
		#6P#00303F作物を襲うってのも
		聞き覚えがあるような。{wait}
	}
	TextWait
	TextTalk name[8] {
		#10105Fもしかして……
		以前起こった『狼型魔獣』の事件に
		似ているんじゃないですかね。{wait}
	} {
		#10103Fあの時は、マフィアの操る
		軍用犬が犯人でしたけど……{wait}
	}
	TextWait
	TextTalk char[1] {
		#07601F#11P……俺もその事件は
		報告書で読んでいたから、
		気になっていてな。{wait}
	} {
		#07603F#11P実際、ルバーチェは解体されたが
		所有していた軍用犬の多数は
		行方が分からなくなっている。{wait}
	} {
		#07601F#11P可能性は決して低くはないだろう。{wait}
	}
	TextWait
	TextTalk name[2] {
		#00200F警備隊ではどの程度
		調査が進んでいるんですか？{wait}
	}
	TextWait
	TextTalk char[1] {
		#07601F#11P被害現場の検証と
		周辺の住民への聞き込みは
		軽く行ったってところだ。{wait}
	} {
		#07603F#11Pその結果、『黒い魔獣』は
		古戦場方面から来ている
		ということが判明した。{wait}
	} {
		#07601F#11Pそこでお前たちには、
		古戦場に向かってもらいたい。{wait}
	} {
		#07601F#11Pこの魔獣たちの調査、
		可能ならば退治をしてもらう。{wait}
	}
	TextWait
	TextTalk name[4] {
		#6P#10302F事情はおおむね理解したよ。{wait}
	} {
		#10303Fにしても、やっぱり随分と
		忙しいみたいだね？{wait}
	} {
		#10300Fこういう仕事は
		警備隊でやるもんだと
		思っていたけど……{wait}
	}
	TextWait
	if QuestFlagsGet quest[147] 0x02:
		TextTalk char[1] {
			#07606F#11Pそうしたいところだが……
			さっきも言ったように、
			警備隊は厳戒態勢なんだ。{wait}
