		CharWalkToPos self (-33890, 0, -11290) 2000mm/s 0
		CharWalkToPos self (-33890, 0, 4560) 2000mm/s 0
		CharWalkToPos self (-53890, 0, 4560) 2000mm/s 0
	Return

