fn[17]:
	FadeOut 300ms 0x00000000 100
	FadeWait
	TextSetPos -1 30 -1 -1
	TextSetName ""
	Menu menu[0] -1 -1 0
		"【演習を始める】" // 0
		"【準備ができていない】" // 1
	MenuWait var[0]
	MenuClose menu[0]
	TextClose 0
	TextSetPos -1 280 60 3
	FadeIn 300ms 0x00000000
	FadeWait
	switch var[0]:
		case 0:
			Call fn[0,18]
			break
		case 1:
			TextTalk name[0] {
				#6P#00000Fすみませんが……
				少し時間をもらえますか？{wait}
			}
			TextWait
			TextTalk char[1] {
				#07600F#11Pふむ、そうか。{wait}
			} {
				#07610F#11Pそれでは、準備ができたら
				もう一度声をかけてくれ。{wait}
			}
			TextWait
			_59
			FlagSet flag[2704]
			break
	Return

