fn[28]:
	TextStart self
	if flag[3089]:
		TextTalk self {
			はは、こんどウチの店でも
			独立記念セールをやろうかなあ。{wait}
		}
		TextWait
	elif flag[3074]:
		if !flag[6]:
			TextTalk self {
				君も聞いたかい？
				どうやらこの間の襲撃事件は
				帝国の陰謀だったらしいね。{wait}
			}
			TextWait
			TextTalk self {
				僕は本当に
				帝国という国が許せないよ。{wait}
			}
			TextWait
			FlagSet flag[6]
		else:
			TextTalk self {
				でも今回のことでよく分かったよ。
				例え帝国に従った所で彼らは
				僕らを守るつもりなんて毛頭ない……{wait}
			}
			TextWait
			TextTalk self {
				だからこそ、僕らは独立の意志を
				押し通すしかないってね。{wait}
			}
			TextWait
	elif flag[2861]:
		if !flag[6]:
			TextTalk self {
				まさか……
				こんな事件が起こるなんてね。{wait}
			}
			TextWait
			TextTalk self {
				警備隊が何とかしてくれると
				いいんだが……{wait}
			}
			TextWait
			TextTalk self {
				いよいよとなれば、
				それこそ２大国の力を借りないと
				いけないんじゃないだろうか？{wait}
			}
			TextWait
			FlagSet flag[6]
		else:
			TextTalk self {
				だが、独立提唱の影響で
				２大国との関係は
				悪化しているというし……{wait}
			}
			TextWait
			TextTalk self {
				ううむ……
				一体この先どうなるんだ……？{wait}
			}
			TextWait
	elif flag[2848]:
	elif flag[2837]:
		TextTalk self {
			そういえば……明日は
			市民会館で市民フォーラムが
			行われるんだったな。{wait}
		}
		TextWait
		TextTalk self {
			ふむ、今からでも
			問い合わせてみようかな。{wait}
		}
		TextWait
	elif flag[2832]:
		TextTalk self {
			心情的なことだけで言うと、
			独立にはもちろん賛成なんだが……{wait}
		}
		TextWait
		TextTalk self {
			とにかく、２大国の脅威から
			どう安全を保つかが問題だよね。{wait}
		}
		TextWait
		TextTalk self {
			対話で道が開けるといいんだが、
			そう単純な話でもないからねぇ。{wait}
		}
		TextWait
	elif flag[2816]:
		TextTalk self {
			クロスベルが独立するべきか否か……
			ふむ、何度考えても難しい問題だな。{wait}
		}
		TextWait
	elif flag[2573]:
		TextTalk self {
			ディーター市長とマクダエル議長、
			この２人がいれば本会議は
			必ず実り豊かなものになるだろう。{wait}
		}
		TextWait
		TextTalk self {
			ふむ、クロスベル経済の
			未来はますますもって明るいね。{wait}
		}
		TextWait
	elif flag[2564]:
		TextTalk self {
			除幕式はこの場所からでも
			十分に楽しめたよ。{wait}
		}
		TextWait
		TextTalk self {
			クロスベルのどこからでも
			見られるなんて、本当に凄まじい
			スケールの建物だよね。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[29]:
	TextStart self
	if flag[3089]:
	elif flag[3074]:
