			} {
				#04000F待っているシズクちゃんのためにも、
				あのキーアってコと一緒に
				何としても連れ帰ってきてちょうだい。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				#04004Fフフ、あとはキーアってコを
				取り戻すだけね。{wait}
			} {
				#04000F待っているシズクちゃんのためにも、
				アリオスと一緒に何としても
				連れ帰ってきてちょうだい。{wait}
			}
			TextWait
	elif flag[3385]:
		if !flag[3541]:
			TextTalk char[0] {
				#04000Fあなたたち……
				大統領の拘束、お疲れだったわね。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00000Fギルドの皆さんも、
				ご協力ありがとうございました。{wait}
			} {
				皆さんの協力が無くては、
				決して成し遂げられなかったと思います。{wait}
			}
			TextWait
			TextTalk char[0] {
				#04011Fウフフ、いいって事よ。{wait}
			} {
				#04004F街の状況を何とかしたかった
				アタシたちにとっても、
				渡りに船だったんだから。{wait}
			} {
				#04000Fおかげでギルドの活動も
				再開出来るようになったしね。{wait}
			}
			TextWait
			TextTalk name[1] {
				#00105Fそういえば、ギルドの皆さんは……{wait}
			}
			TextWait
			TextTalk char[0] {
				#04000Fええ、結界が解除されたから
				手分けして市外に行っているわ。{wait}
			} {
				#04003Fしばらく街から出られなかったから
				各所で問題が起こってるらしくて、
				依頼が一気に押し寄せたのよね。{wait}
			}
			TextWait
			TextTalk name[2] {
				#00200Fそれは……大変そうですね。{wait}
			}
			TextWait
			TextTalk name[3] {
				#00303F俺たちも手伝えれば
				良かったんだが……{wait}
			}
			TextWait
			TextTalk char[0] {
				#04004Fまあ、こちらは任せておきなさい。{wait}
			} {
				#04001F代わりに、湿地帯に現れた
				得体の知れない《大樹》……
				あれはあなた達に任せるわ。{wait}
			} {
				アナタたちの今の役割は、
