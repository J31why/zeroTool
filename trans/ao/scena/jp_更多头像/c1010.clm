			TextTalk name[0] {
				#00008F……はい、何とか。{wait}
			}
			TextWait
			TextTalk name[3] {
				#00306Fさすがにトンでもねえ
				強さだったけどな。{wait}
			}
			TextWait
			TextTalk char[0] {
				#04003F……アリオスは“理”に通じる
				正真正銘の達人よ。{wait}
			} {
				それも、単なる才能だけでは
				決して辿り着けない……
				並々ならぬ鍛錬があればこその強さ。{wait}
			} {
				#04011Fフフ、それを乗り越えてしまうなんて
				あなたたちも強くなったじゃない。{wait}
			}
			TextWait
			TextTalk name[2] {
				#00204F正直、運もあったとは思います。{wait}
			}
			TextWait
			TextTalk name[1] {
				#00100F厳しい戦いでしたけど……
				ようやく乗り越える事が出来ました。{wait}
			}
			TextWait
			TextTalk char[0] {
				#04004Fフフ、それじゃああとは
				あのキーアってコだけね。{wait}
			} {
				#04000F待っているシズクちゃんのためにも、
				アリオスと一緒に何としても
				連れ帰ってきてちょうだい。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00000Fええ、必ず……！{wait}
			}
			TextWait
			FlagSet flag[3542]
		elif !flag[0]:
			TextTalk char[0] {
				#04003Fアリオスは“理”に通じる
				正真正銘の達人よ。{wait}
			} {
				#04011Fフフ、それを乗り越えてしまうなんて
