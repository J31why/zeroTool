fn[0]:
	switch random % 8:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharWalkToPos self (110000, 0, -107310) 2000mm/s 0
		Sleep 300ms
		CharTurnTo self 180deg 500deg/s
		Sleep 300ms
		CharWalkToPos self (110000, 0, -126470) 2000mm/s 0
		Sleep 300ms
		CharTurnTo self 0deg 500deg/s
		Sleep 300ms
	Return

