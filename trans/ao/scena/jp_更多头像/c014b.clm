			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 0:
			Call fn[0,7]
			var[0] = 99
		elif var[0] == 1:
			MenuClose menu[0]
			Call fn[0,5]
