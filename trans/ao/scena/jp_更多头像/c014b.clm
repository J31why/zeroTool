		TextTalk self {
			流石にそこまですると、
			チャコに嫌われてしまうしなぁ。{wait}
		}
		TextWait
		TextTalk self {
			ふむ、どうしたものか……{wait}
		}
		TextWait
		FlagSet flag[4]
	else:
		TextTalk self {
			後ろからコッソリ付いていくと
			私が不審人物になってしまうしなぁ。{wait}
		}
		TextWait
		TextTalk self {
			今日も大人しく帰るとするか……{wait}
		}
		TextWait
	TextEnd self
	Return

fn[15]:
	TextStart self
	if !flag[5]:
		TextTalk self {
			もうすぐ営業終了時間かぁ。
			お客さんはまだ
			結構いるみたいだけど……{wait}
		}
		TextWait
		TextTalk self {
			…………声、かけてみるか？{wait}
		}
		TextWait
		FlagSet flag[5]
	else:
		TextTalk self {
			勇気を振り絞って
			チャコちゃんに声を……{wait}
		}
		TextWait
		TextTalk self {
			ふう、ちょっと
			落ち着いて考えるか。{wait}
		}
		TextWait
	TextEnd self
	Return
