fn[5]:
	ED7_F2 1
	SystemFlagsSet 0x08000000
	if !flag[3988]:
		SoundPlay sound[14] 0 100 0
		ED7_74 object[0] 0 30
		ED7ObjPlay object[0] 0 30 0 0
		Sleep 500ms
		if ItemAdd item[502] 1:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextSetName ""
			TextMessage name[742] {
				{item[502]}{color 0}を手に入れた。{wait}
			}
			TextWait
			TextClose 0
			TextSetPos -1 280 60 3
			FadeIn 300ms 0x00000000
			FlagSet flag[3988]
			ED7_DE 5
		else:
			FadeOut 300ms 0x00000000 100
			TextSetName ""
			TextMessage name[742] {
				宝箱には{item[502]}{color 0}が入っている。
				持ち物が一杯なので、{item[502]}{color 0}をあきらめた。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			SoundPlay sound[15] 0 100 0
			ED7ObjPlay object[0] 30 0 0 0
	else:
		FadeOut 300ms 0x00000000 100
		TextSetPos -1 -1 -1 -1
		TextSetName ""
		TextMessage name[742] {
			{0x06}{color 5}宝箱には何も入っていない。{color 0}{wait}
