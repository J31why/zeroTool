fn[6]:
	TextSetName ""
	TextMessage null {
		{color 5}車雑誌『導力車フリークvol.2』がある。{color 0}{wait}
	}
	TextWait
	TextClose 0
	_59
	TextSetPos -1 280 60 3
	if flag[393] && !ItemHas item[882] 0:
		SoundPlay sound[17] 0 100 0
		TextSetPos -1 -1 -1 -1
		TextSetName ""
		TextMessage null {
			ペイントパターン
			{color 2}『ポップカラー』{color 0}を覚えた。{wait}
		}
		TextWait
		TextClose 0
		_59
		TextSetPos -1 280 60 3
		ItemAdd item[882] 1
	TextEnd null
	Return

