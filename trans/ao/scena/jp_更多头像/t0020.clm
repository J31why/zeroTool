fn[8]:
	TextStart self
	if QuestFlagsGet quest[130] 0x02 && !QuestFlagsGet quest[130] 0x10 && !QuestFlagsGet quest[130] 0x40 && flag[2976] && !flag[2978]:
		Call fn[0,42]
		TextEnd self
		Return
	if flag[3385]:
		if !flag[0]:
			TextTalk char[0] {
				得体のしれん大樹が現れて、
				ジェイクが萎縮してしまわんか
				心配だったのじゃが……{wait}
			}
			TextWait
			TextTalk char[0] {
				ハロルドくんの一言で
				逆にやる気を発揮したようじゃ。{wait}
			}
			TextWait
			TextTalk char[0] {
				商人にとって最も大切な商魂……
				それが芽生えたジェイクは
				これからもきっと大丈夫じゃろうて。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				商人にとって最も大切な商魂……
				ジェイクにもそれが芽生えおった。{wait}
			}
			TextWait
			TextTalk char[0] {
				クロスベルが今度どうなってしまおうと、
				もうわしに思い残す事はないわい。{wait}
			}
			TextWait
	elif flag[3362]:
		if !flag[0]:
			TextTalk char[0] {
				ハロルドくんは、ソフィア殿や
				コリンくんという家族の存在に
				しっかりと支えられておるようじゃ。{wait}
			}
			TextWait
			TextTalk char[0] {
				ふむ、ジェイクにもそのような
				存在がいればあるいは……{wait}
			}
			TextWait
			TextTalk char[0] {
				隠居したら、本格的に
				孫の嫁探しをするのも
				悪くないかもしれんのう。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				ふむ、ジェイクにも
				公私共に支えてくれる
				嫁が見つかれば……{wait}
			}
			TextWait
			TextTalk char[0] {
				孫の嫁探しをするのも
				悪くないかもしれんのう。{wait}
			}
			TextWait
	elif flag[3328]:
		if !flag[0]:
			TextTalk char[0] {
				ハロルドくんは、
				国防軍からの物資の支給に関して
				色々と交渉してくれているのじゃよ。{wait}
			}
			TextWait
			TextTalk char[0] {
				いくら自給自足の成り立っている
				この村とて、常備薬などは
				かなり必要になってくるからな。{wait}
			}
			TextWait
			TextTalk char[0] {
				ジェイクのやつも、あれくらい
				出来るようになってくれればのう……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				ジェイクのやつも、
				ハロルドくん位の商人に
				なってくれればのう……{wait}
			}
			TextWait
			TextTalk char[0] {
				……いかんいかん、最近せっかく
				やる気をだしてきておるんじゃ。
				あまり小言は言わんようにせんとな。{wait}
			}
			TextWait
	elif flag[3074]:
		if !flag[0]:
			TextTalk char[0] {
				少し前から、ジェイクが
				人が変わったように
				やる気を出しはじめてのう。{wait}
			}
