fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharWalkToPos self (700, 0, 2050) 2000mm/s 0
		CharWalkToPos self (6210, 0, 2640) 2000mm/s 0
		CharTurnTo self 45deg 400deg/s
		Sleep 1800ms
		CharTurnTo self 225deg 400deg/s
		Sleep 100ms
		CharWalkToPos self (2810, 0, 1030) 2000mm/s 0
		CharWalkToPos self (3120, 0, -560) 2000mm/s 0
		CharTurnTo self 135deg 400deg/s
		Sleep 1800ms
		CharTurnTo self 270deg 400deg/s
		Sleep 100ms
		CharWalkToPos self (-2050, 0, -820) 2000mm/s 0
		CharTurnTo self 315deg 400deg/s
		Sleep 1800ms
		CharTurnTo self 45deg 400deg/s
		Sleep 100ms
	Return

