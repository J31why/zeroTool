fn[30]:
	TextStart self
	if flag[2578]:
		TextTalk self {
			よく分からないけど……
			イアン先生をはじめ、妙に
			オーラのある人が集まっているな。{wait}
		}
		TextWait
		TextTalk self {
			ただならない雰囲気を感じるよ。{wait}
		}
		TextWait
	elif flag[2577]:
		TextTalk self {
			そういえば、ピエール副局長は
			どこにいったんだろう。{wait}
		}
		TextWait
		TextTalk self {
			なかなか帰ってこないけど、
			対策本部の方にでも行ったのかな？{wait}
		}
		TextWait
	elif flag[2576]:
		if !flag[3599]:
			TextTalk self {
				ピエール副局長、
				さっきから何かぶつぶつ
				言ってるみたいけど大丈夫かなぁ。{wait}
			}
			TextWait
			TextTalk self {
				……気になって仕方ないよ。{wait}
			}
			TextWait
		elif !flag[3601]:
			TextTalk self {
				君たち、どうやらピエール副局長と
				話をしていたみたいだね。{wait}
			}
			TextWait
			TextTalk self {
				調子は大丈夫そうだったかい？{wait}
			}
			TextWait
			TextTalk name[0] {
				#00012Fえ、えっと……{wait}
			}
			TextWait
			TextTalk name[3] {
				#00306Fあれを大丈夫と言うかどうかは
				難しい問題だな。{wait}
			}
			TextWait
			TextTalk name[2] {
				#00203Fまあ、いつも通りと言えば
				いつも通りでしたが。{wait}
			}
			TextWait
			TextTalk name[1] {
				#00106Fでも前は、あそこまで
				卑屈な人でもなかったような
				気はするんだけど……{wait}
			}
			TextWait
			TextTalk self {
				なるほど、卑屈か……
				まあ、それも仕方ないんじゃないかな。{wait}
			}
			TextWait
			TextTalk self {
				何といっても、ウチには
				副局長の肩書きを持つ人間が
				２人いるわけだけど……{wait}
			}
			TextWait
			TextTalk self {
				前局長の解任を受けて
				新しい局長に任命されたのは
				もう一方の副局長だったんだからね。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00001F確かにそうでしたね。{wait}
			} {
				俺たちとは
				全然、接点のない方だけど……{wait}
			}
			TextWait
			TextTalk self {
				で、その新局長なんだが……
				実はピエール副局長の
				後輩だってのを知ってるかい？{wait}
			}
			TextWait
			Emote name[0] 0mm 2000mm 38 38 250ms 1
			Sleep 1000ms
			TextTalk name[0] {
				#00005F新局長が……副局長の後輩？{wait}
			}
			TextWait
			TextTalk name[8] {
				#10106Fなるほど、それで……{wait}
			}
			TextWait
			TextTalk self {
				とはいえ、ピエールさんが
				局長ってのは俺でもいまいち
				想像が付かないからね。{wait}
			}
			TextWait
			TextTalk self {
				はっきり言って
				妥当な人事だとは思うけど……{wait}
			}
			TextWait
			TextTalk self {
				それでも、同じ副局長……
				おまけにキャリアが下の人間に
				抜かれたんじゃ堪えるよなぁ。{wait}
			}
			TextWait
			TextTalk name[4] {
				#10302Fフフ、確かに
				それが当然の感情だろうね。{wait}
			}
			TextWait
			TextTalk self {
				まあ、というわけで
				あの人も色々と大変なんだよ。{wait}
			}
			TextWait
			TextTalk self {
				だから、君たちもあの人と
				接する時は心を広くっていうか……{wait}
			}
			TextWait
			TextTalk self {
				たとえ小言を言われても、
				逆に気遣うくらいの
				気持ちでいるといいと思うよ。{wait}
			}
			TextWait
