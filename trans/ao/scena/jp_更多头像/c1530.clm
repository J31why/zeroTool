				#00012Fそ、そうですね……{wait}
			}
			TextWait
			FlagSet flag[3601]
		else:
			TextTalk self {
				ピエール副局長も、
				ああ見えて色々と大変なんだよ。{wait}
			}
			TextWait
			TextTalk self {
				口やかましい人ではあるけど、
				こちらも我慢してあげないとね。{wait}
			}
			TextWait
	TextEnd self
	Return

