		街に来てたんですね。{wait}
	}
	TextWait
	TextTalk char[9] {
		#07903Fええ、ついさっきね。{wait}
	} {
		#07900Fまだこちらで会議を続けている
		司令と副司令をお待ちしているの。{wait}
	}
	TextWait
	TextTalk name[1] {
		#6P#00103F課長も昨夜から
		参加していた会議ね……{wait}
	}
	TextWait
	TextTalk name[2] {
		#6P#00201F警備隊の司令たちが残っている
		ということは……やっぱり
		対策も難航しているんでしょうか。{wait}
	}
	TextWait
	Emote char[9] 0mm 2000mm 24 27 250ms 0
	Sleep 1000ms
	EmoteStop char[9]
	TextTalk char[9] {
		#07901F……あなたたち。
		今朝、その課長さんから
		問い合わせがあった件だけど……{wait}
	} {
		ランディが行方を
		くらませたんですって？{wait}
	}
	TextWait
	TextTalk name[0] {
		#6P#00003F……はい。{wait}
	} {
		#00001Fおそらく……
		マインツ山道に向かっている
		状況だと思われます。{wait}
	}
	TextWait
	TextTalk char[9] {
		#07908F……そう……………………{wait}
	}
	TextWait
	Emote char[9] 0mm 2000mm 24 27 250ms 0
	Sleep 2000ms
	EmoteStop char[9]
	TextTalk name[4] {
		#6P#10300F……大丈夫かい？{wait}
	}
	TextWait
	TextTalk char[9] {
		#07903F……ええ、私は平気よ。
		それよりも……{wait}
	} {
		#07901Fランディが姿を消したのは、
		あいつの過去が関係してる……
		そうなんでしょう？{wait}
	}
	TextWait
	TextTalk name[0] {
		#6P#00008Fそ、それは……{wait}
	}
	TextWait
	TextTalk char[9] {
		#07908F……くやしいけど、
		私はランディの過去を、
		あまり詳しくは知らないわ。{wait}
	} {
		今まで実戦訓練で
		ライフルを使えなかった理由も、
		私には分からない。{wait}
	} {
		#07901Fだけど……今回のこれが、
		皆に多大な心配をかける
		本当に馬鹿な行為なのは分かる。{wait}
	}
	TextWait
	TextTalk name[8] {
		#6P#10108Fミレイユ三尉……{wait}
	}
	TextWait
	TextTalk name[2] {
		#6P#00203F……確かに、馬鹿を超えた大馬鹿です。{wait}
	}
	TextWait
	TextTalk char[9] {
		#07903F……警備隊も甚大な被害を受けたわ。
		これから司令たちによって、もう一度
		救援部隊を編成することになると思う。{wait}
	} {
		私たちはそれまで動く事はできないし……
		ランディ１人のために出動を
		早めるわけにもいかない。{wait}
	} {
		#07900Fだから皆さん……
		あの馬鹿のこと、どうかお願いね。{wait}
	}
	TextWait
	TextTalk name[0] {
		#6P#00000F……任せてください。
		ランディは俺たちが、必ず……！{wait}
	}
	TextWait
	_59
	_Char4B char[9] 255
