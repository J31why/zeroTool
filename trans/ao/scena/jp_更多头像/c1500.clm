	}
	TextWait
	TextTalk name[3] {
		#00300F#12Pよく分からねえが……
		こっちこそ話し込んで悪かったな。{wait}
	}
	TextWait
	TextTalk char[90] {
		ハハ、気にしないでくれ。{wait}
	}
	TextWait
	TextTalk char[90] {
