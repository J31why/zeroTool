		#00305F#12Pもしかして、カーターか？{wait}
	} {
		#00302Fはは、そんな白い軍服だから
		気づかなかったぜ。{wait}
	} {
		お前、ベルガード門に
		配備されてたんじゃなかったか？{wait}
	}
	TextWait
	TextTalk char[90] {
		ああ、大統領の演説にあわせて
		国境門からも何人か
		警備に呼ばれてるんだ。{wait}
	}
	TextWait
	TextTalk char[90] {
		ロギンスもあっちの方で
		巡回してるぜ。{wait}
	}
	TextWait
	TextTalk name[3] {
		#00302F#12Pはは、なるほどな。{wait}
	}
	TextWait
	TextTalk name[0] {
		#00000F#12P（この人は……）{wait}
	}
	TextWait
	TextTalk name[1] {
		#00100F#6P（ランディの警備隊時代の
		{}  同僚みたいね。）{wait}
	}
	TextWait
	TextTalk char[90] {
		いや、しかし
		大変なことになったよな。{wait}
	}
	TextWait
	TextTalk char[90] {
		俺たちも突然
		こんな軍服を渡されて、
		最初は驚いたもんだよ。{wait}
	}
	TextWait
	TextTalk name[3] {
		#00306F#12Pああ、いきなりすぎて
		訳がわかんねえっつうか……{wait}
	} {
		#00300F考えてみりゃ、軍服といい
		随分用意が良すぎる気もするな。{wait}
	}
	TextWait
	TextTalk char[90] {
		きっと大統領が、前々から
		準備を進めてたんだろうなあ。{wait}
	}
	TextWait
	TextTalk char[90] {
		国防軍の装備も強化される
		見込みがあるみたいだし
		気を引き締めてかないとな。{wait}
	}
	TextWait
	TextTalk name[3] {
		#00305F#12Pあ、ああ……{wait}
	}
	TextWait
	TextTalk name[2] {
		#00201F#12P（……国防軍の兵士さんたちは、
		{}  今回の再編成をかなり好意的に
		{}  受け取ってるみたいですね。）{wait}
	}
	TextWait
	TextTalk name[1] {
		#00106F#6P（他国の正規軍に比べて
		{}  不遇なのは間違いなかったから、
		{}  気持ちは分かる気がするけど……）{wait}
	}
	TextWait
	TextTalk char[90] {
		ちなみに、国防軍になるにあたって
		俺たちにも通常の軍隊のような
		階級名が使われることになったんだ。{wait}
	}
	TextWait
	TextTalk char[90] {
		一尉、二尉、三尉って呼ばれてたのが
		大尉、中尉、少尉って具合にな。{wait}
	}
	TextWait
	TextTalk char[90] {
		士官を呼ぶときに間違えたりすると、
		相当失礼だから気をつけろよ。{wait}
	}
	TextWait
	TextTalk name[3] {
		#00300F#12Pああ、ご忠告あんがとよ。{wait}
	} {
		#00303Fつーことは、ミレイユのヤツは
		『三尉』だったから……
		今度からは『少尉』になるわけか。{wait}
	} {
		#00309Fはは、からかうネタが一つ増えたぜ。{wait}
	}
	TextWait
	TextTalk name[0] {
		#00006F#12Pおいおい……{wait}
	}
	TextWait
	TextTalk char[90] {
		え、え～っと……
		まあ、そうなるかな。{wait}
	}
	TextWait
	Emote name[0] 0mm 2000mm 0 1 250ms 2
