anim[0] 328ms

sepith[0] 0 0 0 0 0 0 0 0

fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharIdle self (1410, null, 9460) (-780, null, 4870) 1000mm/s
		Sleep 300ms
	Return

fn[2]:
	if flag[3385]:
	elif flag[3371]:
		CharFlagsUnset char[2] 0x0080
		CharSetChipBase char[2] chip[5]
		ForkFunc char[2] fork[0] fn[0,0]
		CharSetPos char[2] (1020, 0, 3500) 270deg
		CharSetPos char[0] (-800, 0, 3500) 90deg
		ForkFunc char[0] fork[0] fn[0,0]
		if !flag[2]:
			CharFlagsSet char[2] 0x0010
		CharFlagsSet char[0] 0x0010
		CharFlagsUnset char[3] 0x0080
		CharSetChipBase char[3] chip[6]
		ForkFunc char[3] fork[0] fn[0,0]
		CharSetPos char[3] (1040, 4019, 7540) 0deg
		CharSetPos char[1] (1040, 4019, 8540) 180deg
		CharFlagsSet char[1] 0x0010
	elif flag[3089]:
	elif flag[3074]:
		CharFlagsSet char[0] 0x0080
	elif flag[2861]:
	elif flag[2848]:
	elif flag[2837]:
		CharFlagsSet char[0] 0x0080
	elif flag[2832]:
		CharFlagsSet char[0] 0x0080
	elif flag[2816]:
	elif flag[2573]:
	elif flag[2564]:
	elif flag[2560]:
	elif flag[2369]:
		if QuestFlagsGet quest[107] 0x10:
			CharSetChipBase char[2] chip[3]
			CharSetChipPattern char[2] 0
			ForkQuit char[2] fork[0]
			CharFlags2Set char[2] 0x0004
			CharFlagsUnset char[2] 0x0080
			CharSetChipBase char[3] chip[4]
			CharSetChipPattern char[3] 0
			ForkQuit char[3] fork[0]
			CharFlags2Set char[3] 0x0004
			CharFlagsUnset char[3] 0x0080
	elif flag[2353]:
	Return

fn[3]:
	if flag[2848] && !flag[2858] | flag[2369] && system[4] == 1:
		ED7_76_0 object[255] "hikari00_add" 1
		ED7_76_0 object[255] "hikari01_add" 1
		SoundPlay sound[128] 1 50 0
	if !flag[3385] && flag[3370]:
		MapColor 0x00E6D2D2 0ms
		ED7_76_0 object[255] "hikari00_add" 1
		ED7_76_0 object[255] "hikari01_add" 1
	Return

fn[4]:
	TextStart self
	if flag[3385]:
		if !flag[0]:
			TextTalk self {
				クロスベルは日常を
				取り戻しつつあるが、
				まだ問題は山積みじゃ。{wait}
			}
			TextWait
			TextTalk self {
				国交を断った影響で
				何処の商店も十分な商品を
				揃えられてはおらぬ。{wait}
			}
			TextWait
			TextTalk self {
				マクダエル議長とも
				連絡を取り合いつつ、
				なんとか対策を考えねばな。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				クロスベルは日常を
				取り戻しつつあるが、
				まだ問題は山積みじゃ。{wait}
			}
			TextWait
			TextTalk self {
				マクダエル議長とも
				連絡を取り合いつつ、
				なんとか対策を考えねばな。{wait}
			}
			TextWait
	elif flag[3371]:
		if !flag[0]:
			TextTalk self {
				ううむ、露店の者たちの
				安否が気がかりじゃな。{wait}
			}
			TextWait
			TextTalk self {
				戒厳令下でも、どうしても
				商売をつづけたいというから
				許可してしまったが……{wait}
			}
			TextWait
			TextTalk self {
				もし、彼らに何かあったら
				わしの責任じゃよ。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				ううむ、露店の者たちの
				安否が気がかりじゃな。{wait}
			}
			TextWait
			TextTalk self {
				もし、彼らに何かあったら
				戒厳令下の商売を許可した
				わしの責任じゃよ。{wait}
			}
			TextWait
	elif flag[3089]:
		if !flag[0]:
			TextTalk self {
				例のディーター殿の演説……
				マクダエル議長が姿を
				見せていなかったのが気になるが。{wait}
			}
			TextWait
			TextTalk self {
				エリィ君、
				何か知ってはおらぬのかね？{wait}
			}
			TextWait
			TextTalk name[1] {
				#00103F……いえ。
				実は私も少し気になっていまして……{wait}
			}
			TextWait
			TextTalk self {
				ふむ、そうか……
				さぞ心配じゃろう。{wait}
			}
			TextWait
			TextTalk self {
				いずれにせよ
				こうなってしまった以上、
				２大国との対立は避けられまい。{wait}
			}
			TextWait
			TextTalk self {
				有事に備えておくように
				商工会から呼びかけねばな……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				こうなってしまった以上、
				２大国との対立は避けられまい。{wait}
			}
			TextWait
			TextTalk self {
				有事に備えておくように
				商工会から呼びかけねばな……{wait}
			}
			TextWait
	elif flag[3074]:
	elif flag[2861]:
		if !flag[0]:
			TextTalk self {
				ふむ、住民投票も
				間近に迫ったこの時期に、
				かような事件が起こるとは……{wait}
			}
			TextWait
			TextTalk self {
				下手をすると、帝国や共和国に
				付け込まれる格好の材料に
				なってしまうかもしれん。{wait}
			}
			TextWait
			TextTalk self {
				なんとしても、早急な解決が
				望まれるところじゃな。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				ただでさえ、
				治安の面で帝国や共和国に
				弱みを見せている現状じゃ。{wait}
			}
			TextWait
			TextTalk self {
				なんとしても、早急な解決が
				望まれるところじゃな。{wait}
			}
			TextWait
	elif flag[2848]:
		if !flag[0]:
			TextTalk self {
				昨日の列車事故は
				得体のしれない化け物の
				仕業だったとか……{wait}
			}
			TextWait
			TextTalk self {
				ふむ、最近目撃されるという
				不可思議な怪物と
				同じものなのかのう？{wait}
			}
			TextWait
			TextTalk self {
				近頃ただでさえ事件が多い。
				諸君らも充分気をつけるのじゃぞ。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				列車事故を起こした化け物が
				最近噂される不可思議な怪物と
				同じものかはわからんが……{wait}
			}
			TextWait
			TextTalk self {
				近頃ただでさえ事件が多い。
				諸君らも充分気をつけるのじゃぞ。{wait}
			}
			TextWait
	elif flag[2837]:
	elif flag[2832]:
	elif flag[2816]:
		if !flag[0]:
			TextTalk self {
				クロスベル自治州の独立……
				ディーター市長も思い切ったことを
				宣言したものじゃ。{wait}
			}
			TextWait
			TextTalk self {
				だが、内外への発言力が
				かつてないほどに高まっておる
				今こそが、好機なのは間違いない。{wait}
			}
			TextWait
			TextTalk self {
				長い歴史で２大国に支配され続け、
				失われつつあるクロスベルの誇り……{wait}
			}
			TextWait
			TextTalk self {
				色々と軋轢はあるだろうが、
				独立の実現という結果を以って
				何としても取り戻してほしいものじゃ。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				……そうそう、そんな市長の
				最近の勢いを応援する意味でも、
				ある企画を進めておるのじゃよ。{wait}
			}
			TextWait
			TextTalk self {
				クロスベル通信社と共同の企画じゃ、
				市民も活気付いてくれるじゃろう。
				諸君も、楽しみにしておいてくれ。{wait}
			}
			TextWait
	elif flag[2573]:
		if !flag[0]:
			TextTalk self {
				ついに通商会議が始まるのう。{wait}
			}
			TextWait
			TextTalk self {
				わしら市民は
				クロスベルタイムズでの
				結果を待つのみじゃ。{wait}
			}
			TextWait
			TextTalk self {
				さて……
				どんな会議になるのやら。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				本来ならば、ぜひとも
				会議の様子を見たかったものじゃ。{wait}
			}
			TextWait
			TextTalk self {
				さて……
				どんな会議になるのやら。{wait}
			}
			TextWait
	elif flag[2564]:
		TextTalk self {
			どうやら孫のロイが、
			露店の仕事に興味を
			持ち始めたそうじゃ。{wait}
		}
		TextWait
		TextTalk self {
			……わしも元は露天商でな。
			ふむ、これも血筋かのう。{wait}
		}
		TextWait
	elif flag[2560]:
		if flag[3627] && !QuestFlagsGet quest[115] 0x10 && !QuestFlagsGet quest[115] 0x40:
			if !flag[3664]:
				Call fn[0,9]
			elif flag[3664]:
				TextTalk char[0] {
					ふむ、まさか黒月の
					長老さんのお孫さんが
					ウチに来てくれるなんてね。{wait}
				}
				TextWait
				TextTalk char[0] {
					何はともあれ、
					この街を気に入ってくれると
					私も嬉しいよ。{wait}
				}
				TextWait
		else:
			TextTalk self {
				通商会議では、各国の代表者が
				主に経済関係の取り決めについて
				協議を行う。{wait}
			}
			TextWait
			TextTalk self {
				わしら商工会もその動向には
				注目しているのじゃよ。{wait}
			}
			TextWait
	elif flag[2369]:
		if QuestFlagsGet quest[107] 0x02 && flag[2451]:
			if !QuestFlagsGet quest[107] 0x10:
				if !flag[2452]:
					if !flag[0]:
						TextTalk self {
							おや、ロイドくんじゃないか。
							一体どうしたね？{wait}
						}
						TextWait
						TextTalk name[0] {
							#00000Fえっと……
							メイリンちゃんは
							ご在宅でしょうか？{wait}
						}
						TextWait
						TextTalk self {
							ん、さっき帰ってきたと
							思っておったが……
							またどこかに行ったかの？{wait}
						}
						TextWait
						TextTalk self {
							すまないが、婆さんに
							聞いてもらえるかな？{wait}
						}
						TextWait
						FlagSet flag[0]
					else:
						TextTalk self {
							仕事をしていてな。
							孫が出かけたのに
							気づかなんだ。{wait}
						}
						TextWait
						TextTalk self {
							孫については婆さんに
							聞いてもらえるかな？{wait}
						}
						TextWait
				else:
					TextTalk self {
						さて、商工会の仕事の
						続きをせねばな……{wait}
					}
					TextWait
			else:
				TextTalk self {
					ロイのやつに
					説教のひとつでも
					してやろうかと思うたが……{wait}
				}
				TextWait
				TextTalk self {
					メイリンのいるところで
					やるのもなんじゃな。{wait}
				}
				TextWait
				TextTalk self {
					今日のところは見逃してやるか。{wait}
				}
				TextWait
			TextEnd self
			Return
		if !flag[0]:
			TextTalk self {
				教団事件直前に行われた
				クロスベル予算議会は、
				一旦仕切りなおしになってな。{wait}
			}
			TextWait
			TextTalk self {
				新市長、新議長が中心となって
				利権が絡まない案へと
				予算が組み直されたんじゃ。{wait}
			}
			TextWait
			TextTalk self {
				うむ、市政もようやく
				良い方向へと進みはじめた
				ということかのう。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				市政もようやく良い方向へと
				進み始めたようじゃ。{wait}
			}
			TextWait
			TextTalk self {
				これも新市長と新議長の
				おかげかのう。{wait}
			}
			TextWait
	elif flag[2353]:
		if !flag[2425]:
			TextTalk self {
				おや……ロイド君に、
				マクダエル議長のお嬢さんか。{wait}
			}
			TextWait
			TextTalk self {
				久しぶりじゃのう。
				元気そうで何よりじゃ。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00000Fこんにちは、モルス会長。{wait}
			}
			TextWait
			TextTalk name[1] {
				#00100Fご無沙汰しています。{wait}
			}
			TextWait
			TextTalk name[4] {
				#10300F確か、東通りの商人をまとめる
				商工会の会長さんだったね。{wait}
			}
			TextWait
			TextTalk name[8] {
				#10105Fああ、こちらの方が……
				（母さんも露天商時代に
				{}  お世話になったんだっけ。）{wait}
			}
			TextWait
			TextTalk self {
				うむ、新顔もおるようだし
				いよいよ特務支援課も
				再始動と言ったところか。{wait}
			}
			TextWait
			TextTalk self {
				君たちには
				わしら市民も期待しておる。
				がんばってくれたまえよ。{wait}
			}
			TextWait
			FlagSet flag[2425]
		else:
			TextTalk self {
				君たち特務支援課には
				これからも期待しておるぞ。{wait}
			}
			TextWait
			TextTalk self {
				何か力になれることがあったら
				いつでも来るといい。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[5]:
	if QuestFlagsGet quest[107] 0x02 && !QuestFlagsGet quest[107] 0x10 && !QuestFlagsGet quest[107] 0x40 && flag[2451] && !flag[2452]:
		Call fn[0,8]
		Return
	TextStart self
	if flag[3385]:
		if !flag[1]:
			TextTalk self {
				大統領の拘束を乗り越えて、
				これからどうするか……{wait}
			}
			TextWait
			TextTalk self {
				それがクロスベルに住む人々にとって
				何より大事なことだと思うわ。{wait}
			}
			TextWait
			TextTalk self {
				皆で話し合って、きっといい方向に
				物事が進んでいけばいいわね。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				これからどうするか……
				クロスベルに住む人々にとって
				それが何より大事なことだと思うわ。{wait}
			}
			TextWait
			TextTalk self {
				皆で話し合って、きっといい方向に
				物事が進んでいけばいいわね。{wait}
			}
			TextWait
	elif flag[3371]:
		TextTalk self {
			ロイとおじいさんが
			ちゃあんと見張っているから、
			怖いのもここにはこないわ。{wait}
		}
		TextWait
		TextTalk self {
			だからメイリン、
			心配しなくていいからね。{wait}
		}
		TextWait
	elif flag[3089]:
		if !flag[1]:
			TextTalk self {
				ディーターさんの独立宣言……
				時期尚早ではなかったかしら……{wait}
			}
			TextWait
			TextTalk self {
				この世のあらゆる物事は
				変わっていくものだとは
				分かっていたつもりだけど……{wait}
			}
			TextWait
			TextTalk self {
