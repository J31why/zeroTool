				なってしまっていたのかもね……{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				物事の急激な変化は、
				私たち年寄りにとっては
				怖いものがあるわ。{wait}
			}
			TextWait
			TextTalk self {
				クロスベルは既に
				引き返せないところまで
				きてしまっていたのね……{wait}
			}
			TextWait
	elif flag[3074]:
		TextTalk self {
			おじいさんなら、商工会の用事で
			市民会館に行っているわ。{wait}
		}
		TextWait
		TextTalk self {
			今回のチャリティイベントは
			ロイも手伝ってるそうだけど……
			どうなるかしらね。{wait}
		}
		TextWait
	elif flag[2861]:
		TextTalk self {
			今はとにかく、女神様に
			お祈りすることしかできないわ。{wait}
		}
		TextWait
		TextTalk self {
			これ以上このクロスベルで
			無駄な血が流れませんように……{wait}
		}
		TextWait
	elif flag[2848]:
		TextTalk self {
			最近は本当に何が起こるか
			分からないわねえ……{wait}
		}
		TextWait
		TextTalk self {
			ロイやメイリンにも、
			出歩くときには充分に
			気をつけるように言わないと。{wait}
		}
		TextWait
	elif flag[2837]:
		TextTalk self {
			さてと……
			おじいさんとメイリンが
			そろそろ帰る頃かしら。{wait}
		}
		TextWait
		TextTalk self {
			紅茶とお菓子を用意して
			待っているとしましょうかね。{wait}
		}
		TextWait
	elif flag[2832]:
		TextTalk self {
			おじいさんなら今頃、
			表の通りでメイリンと
			遊んでるんじゃないかしら。{wait}
		}
		TextWait
		TextTalk self {
			ふふ、おじいさんったら
			久しぶりの休みに孫と遊べて、
