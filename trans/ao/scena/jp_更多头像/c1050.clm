calmare zero_k scena
scena:
	name "c1050" "c1050" "c1050"
	town town[1]
	bgm bgm[150]
	flags 8192
	item_use fn[0,255]
	unk 255 0

entry:
	pos (0, 0, -1000)
	unk1 0
	cam_from (0, 0, 24000)
	cam_pers 500
	unk2 30
	cam_deg 45deg
	cam_limit 0deg 360deg
	cam_at (0, 0, 0)
	unk3 0
	unk4 0
	flags 0x0001
	town town[1]
	init fn[0,2]
	reinit fn[0,3]

chip[0] "chr/ch20800.itc"
chip[1] "chr/ch20900.itc"
chip[2] "chr/ch20802.itc"
chip[3] "chr/ch21202.itc"
chip[4] "chr/ch21502.itc"
chip[5] "chr/ch21200.itc"
chip[6] "chr/ch21500.itc"

