sepith[0] 0 0 0 0 0 0 0 0

fn[0]:
	switch random % 8:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharWalkToPos self (-21200, 0, -3250) 2000mm/s 0
		Sleep 2000ms
		CharTurnTo self 90deg 400deg/s
		Sleep 100ms
		CharWalkToPos self (10400, 0, -3250) 2000mm/s 0
		Sleep 2000ms
		CharTurnTo self 270deg 400deg/s
		Sleep 100ms
	Return

fn[2]:
	while 1:
		CharIdle self (150870, null, 2760) (154790, null, -600) 1000mm/s
		Sleep 450ms
	Return

