	} {
		#08403F報告にあった『プレロマ草』とやらが
		本当に幻獣と関係あるとしたら、
		他に咲いてないか確認はしておかないとね。{wait}
	}
	TextWait
	TextTalk name[2] {
		#00200Fなるほど……
		確かに確認は必要そうです。{wait}
	}
	TextWait
	TextTalk name[3] {
		#00300F遊撃士の兄さんたちなら
		俺たちが入れないような
		奥地の方も探索出来るだろうしな。{wait}
	}
	TextWait
	TextTalk char[11] {
		#08404Fまあ、そういうことだ。{wait}
	} {
		#08400Fとりあえずこっちは任せてくれ。
		君たちにも君たちにしか
		できない事があるだろうしな。{wait}
	}
	TextWait
	CharFlagsSet char[11] 0x0010
	CharFlagsSet char[12] 0x0010
	CharSetChipPattern char[11] 0
	CharSetChipPattern char[12] 0
	FlagSet flag[3047]
	Return

fn[24]:
	CharFlagsSet char[11] 0x0010
	CharFlagsSet char[12] 0x0010
	CharSetChipPattern char[11] 0
	CharSetChipPattern char[12] 0
	TextTalk char[11] {
		#08401Fそれにしても……
		通商会議に続いてなかなか
		忙しさが抜けないな。{wait}
	} {
		#08406F婚約者のパールにも
		なかなか会ってやれないよ。{wait}
	}
	TextWait
	TextTalk char[12] {
		#08500F百貨店で働いている娘か……{wait}
	} {
		#08501Fまあ……今は致し方あるまい。
		人手も足りない状況だからな。{wait}
	} {
		#08504F一通りの案件が片付いたら、
		ミシェルに休暇を申請するといい。
		日程の調整には俺も協力する。{wait}
	}
	TextWait
