fn[5]:
	TextSetName ""
	TextMessage null {
		{color 5}車雑誌『行軍・爆走野郎！』がある。{color 0}{wait}
	}
	TextWait
	TextClose 0
	_59
	TextSetPos -1 280 60 3
	if flag[393] && !ItemHas item[881] 0:
		SoundPlay sound[17] 0 100 0
		TextSetPos -1 -1 -1 -1
		TextSetName ""
		TextMessage null {
			ペイントパターン
			{color 2}『ガードカラー』{color 0}を覚えた。{wait}
		}
		TextWait
		TextClose 0
		_59
		TextSetPos -1 280 60 3
		ItemAdd item[881] 1
	TextEnd null
	Return

fn[6]:
	Call fn[0,7]
	Return

fn[7]:
	TextStart char[0]
	if flag[3385]:
		if !flag[0]:
			TextTalkNamed char[0] "兵士オリバー" {
				クロスベルから逃げ遅れていた
				共和国人たちが訪れていてね。{wait}
			}
			TextWait
			TextTalkNamed char[0] "兵士オリバー" {
				だが、共和国への警戒が解けない
				今の状況じゃあ、さすがに
				足止めせざるを得ないんだ。{wait}
			}
			TextWait
			TextTalkNamed char[0] "兵士オリバー" {
				帰りたい気持ちは分かるから、
				少し心苦しいんだけどね……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalkNamed char[0] "兵士オリバー" {
				共和国への警戒が解けない
				今の状況じゃあ、さすがに
				足止めせざるを得ない。{wait}
			}
			TextWait
			TextTalkNamed char[0] "兵士オリバー" {
				納得いかないかもしれないけど、
				分かってもらうしかないな。{wait}
			}
			TextWait
	elif flag[3074]:
		if QuestFlagsGet quest[147] 0x10:
			if !flag[0]:
				TextTalk char[0] {
					さっき、無理やりゲートを通った
					黒い運搬車は、指名手配中の
					詐欺師のものだったみたいだな。{wait}
				}
				TextWait
				TextTalk char[0] {
					この緊張状態の時に驚いたけど……
					何にせよ、捕まってよかったよ。{wait}
				}
				TextWait
				FlagSet flag[0]
			else:
				TextTalk char[0] {
					とにかく、君たちもお疲れ様だったな。{wait}
				}
				TextWait
				TextTalk char[0] {
					ダグラス副司令には
					すでに報告しておいたから、
					そっちは気にしなくていいからな。{wait}
				}
				TextWait
		elif QuestFlagsGet quest[147] 0x40:
			TextTalk char[0] {
				さっき、ゲートを無理やり通っていった
				黒い運搬車は、指名手配中の
				詐欺師のものだったみたいだ。{wait}
			}
			TextWait
			TextTalk char[0] {
				この緊張状態の時に……
				まったく、馬鹿げたことをしてくれるよ。{wait}
			}
			TextWait
		elif !flag[0]:
			TextTalk char[0] {
				国境の緊張は、
				まさに極限に近い状態だ。{wait}
			}
			TextWait
			TextTalk char[0] {
				共和国方面はタングラム丘陵という
				緩衝地帯があるにはあるけど、
				それでもやはり安心はできない。{wait}
			}
			TextWait
			TextTalk char[0] {
				ここが踏ん張りどころだ。
				しっかり警戒を続けないとな。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				クロスベルにとっても、
				ここが踏ん張りどころだ。
				しっかり警戒を続けないとな。{wait}
			}
			TextWait
	elif flag[2848]:
		if !flag[0]:
			TextTalk char[0] {
				昨日は、タングラム門も
				脱線事故の対応に追われていてね。{wait}
			}
			TextWait
			TextTalk char[0] {
				共和国の旅客バスにも
				応援を要請したりして、
				なかなか大変だったんだ。{wait}
			}
			TextWait
			TextTalk char[0] {
				この緊張状態が続いてるときに
				事故だなんて……やれやれ、
				間が悪いときに起きたものだよ。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				この緊張状態が続いてるときに
				事故だなんて……やれやれ、
				間が悪いときに起きたものだよ。{wait}
			}
			TextWait
			TextTalk char[0] {
				せめて住民投票までは
				これ以上の不測の事態は
				ご遠慮願いたいね。{wait}
			}
			TextWait
	elif flag[2832]:
		Call fn[0,8]
	elif flag[2816]:
		if !flag[0]:
			TextTalk char[0] {
				最近は共和国でも、
				クロスベル独立の是非が
				議論されてるらしい。{wait}
			}
			TextWait
			TextTalk char[0] {
				しかも、クロスベルの中とは違って
				その殆どは反対だそうだ。
				まあ、仕方ないとは思うが……{wait}
			}
			TextWait
			TextTalk char[0] {
				近く住民投票が行われるが、
				こんな状況で独立が実現する
				なんてことがあるんだろうか。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				近く住民投票が行われるが、
				こんな状況で独立が実現する
				なんてことがあるんだろうか。{wait}
			}
			TextWait
			TextTalk char[0] {
				警備隊としては、ぜひとも
				実現してほしいものだが……
				やはり難しいかもしれないな。{wait}
			}
			TextWait
