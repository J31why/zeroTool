	CharFlagsUnset char[12] 0x0010
	FlagSet flag[10]
	FlagSet flag[11]
	Return

fn[25]:
	TextStart self
	if !flag[3047]:
		Call fn[0,23]
	elif !flag[11]:
		Call fn[0,24]
	else:
		TextTalk self {
			#08501Fお前たちの報告を受けて確認したが、
			他の幻獣出現地点にもひっそりと
			『プレロマ草』が咲いていた。{wait}
		} {
			#08503F……何とも得体のしれない植物だ。
			重々注意していたほうがよさそうだな……{wait}
		}
		TextWait
	TextEnd self
	Return

fn[26]:
	TextStart self
	if !flag[12]:
		TextTalk self {
			街の襲撃事件のときは、
			アルモリカ村にいたの。{wait}
		}
		TextWait
		TextTalk self {
			一応連絡をとったら、
			リュウもお父さんも
			無事だって……{wait}
		}
		TextWait
		TextTalk self {
			……本当に安心した。{wait}
		}
		TextWait
		FlagSet flag[12]
	else:
		TextTalk self {
			もう少ししたら家に帰ろうかな。
			リュウとお父さんが心配だし……{wait}
		}
		TextWait
	TextEnd self
	Return

