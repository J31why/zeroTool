fn[10]:
	var[0] = 0
	while var[0] != 255:
		FadeOut 300ms 0x00000000 100
		FadeWait
		TextSetPos 173 40 -1 -1
		TextSetName ""
		Menu menu[0] -1 -1 1
			"【教団について】" // 0
			"【グノーシスについて】" // 1
			"【御子について】" // 2
			"【やめる】" // 3
		MenuWait var[0]
		MenuClose menu[0]
		TextClose 0
		FadeIn 300ms 0x00000000
		FadeWait
		TextSetPos -1 280 60 3
		switch var[0]:
			case 0:
				SoundPlay sound[72] 0 100 0
				Call fn[0,11]
				break
			case 1:
				SoundPlay sound[72] 0 100 0
				Call fn[0,12]
				break
			case 2:
				SoundPlay sound[72] 0 100 0
				Call fn[0,13]
				break
			case 3:
				var[0] = 255
				break
			default:
				var[0] = 255
				break
	Return

fn[11]:
	FadeOut 300ms 0x00000000 100
	TextSetPos -1 -1 34 -1
	if global[2] == 0:
		TextSetName ""
		TextMessage null {
			{color 2}#2S『教団について』

			──私の名はヨアヒム・ギュンター。
			《Ｄ∴Ｇ教団》に属する幹部司祭である。
			６年前、遊撃士を含む多くの勢力の手で
			我が教団は壊滅状態に陥ってしまった。
			しかし、私だけは故あって難を逃れ、
			この■■の地へと落ち延びる事ができた。
			大いなる《■》の導きによって
			教団の大望を成すべく私は永らえたのだ。
			いずれ来るその時──
			新たな聖典を記すための資料として
			各端末にデータを記録しておく事とする。
			{color 0}{wait}
		}
		TextWait
		TextClose 0
	else:
		TextSetName ""
		TextMessage null {
			{color 2}#2S『教団について』

			──私の名はヨアヒム・ギュンター。
			《Ｄ∴Ｇ教団》に属する幹部司祭である。
			６年前、遊撃士を含む多くの勢力の手で
			我が教団は壊滅状態に陥ってしまった。
			しかし、私だけは故あって難を逃れ、
			この起源の地へと落ち延びる事ができた。
			大いなる《Ｄ》の導きによって
			教団の大望を成すべく私は永らえたのだ。
			いずれ来るその時──
			新たな聖典を記すための資料として
			各端末にデータを記録しておく事とする。
			{color 0}{wait}
		}
		TextWait
		TextClose 0
	TextSetName ""
	TextMessage null {
		{color 2}#2Sまず、我が教団の成り立ちについて語ろう。
		そのためには、このゼムリア大陸が辿った
		忌々しい歴史を振り返る必要がある。

		──約１２００年前の《大崩壊》によって
		大陸は高度な文明と秩序を失い、
		戦と貧困の支配する《暗黒時代》が訪れた。
		そして、疲れ果てた人々は
		大いなる間違いを犯してしまった。

		突如現れた愚か者どもの甘言に惑わされ、
		彼らの作りだした身勝手な秩序を
		受け入れてしまったのだ。
		{color 0}{wait}
	}
	TextWait
	TextClose 0
	if global[2] < 2:
		TextSetName ""
		TextMessage null {
			{color 2}#2Sすなわち──愚かなる■■■■と
			信仰の象徴たる《■の■■》である。
			彼らの秩序によって《暗黒時代》は終焉し、
			その信仰はたちまち大陸中に広まったが……

			よく考えてみてほしい。
			もし真に《■■》が存在するというのならば
			誰もが等しく救いを受けるべきではないか？
			しかし、未だに格差の概念は無くならず、
			災厄や不幸で命を落とす者も後を絶たない。

			《■■》は救う人間を選ぶというのか？
			あまりに馬鹿馬鹿しい話ではないか。
			{color 0}{wait}
		}
		TextWait
		TextClose 0
	else:
		TextSetName ""
		TextMessage null {
			{color 2}#2Sすなわち──愚かなる七耀教会と
