fn[133]:
	TextStart null
	if !flag[3602]:
		TextSetName ""
		TextMessage null {
			{color 5}エレベーターのシャッターは
			固く閉ざされている。{color 0}{wait}
		}
		TextWait
		TextClose 0
		_59
		TextTalk name[0] {
			#00005Fそういえば、会議中は
			手前のエレベーター以外は
			使えないんだったか。{wait}
		}
		TextWait
		TextTalk name[1] {
			#00100Fええ、確か警備上の理由で
			そういう事になっていたわね。{wait}
		}
		TextWait
		if flag[3603]:
			TextTalk name[2] {
				#00200F非常階段同様、
				ここも導力ネットによって
				制御・管理されているようですね。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00003Fああ、そうらしいな。{wait}
			} {
				#00000Fまあいい、移動する時は
				手前のエレベーターを使おう。{wait}
			}
			TextWait
		else:
			TextTalk name[2] {
				#00200Fちなみに、ロックの開閉は
				導力ネットによって
				制御・管理されているようですね。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00003Fああ、流石はオルキスタワーの
				セキュリティってところだな。{wait}
			} {
				#00000Fまあいい、移動する時は
				手前のエレベーターを使おう。{wait}
			}
			TextWait
		FlagSet flag[3602]
	else:
		TextSetName ""
		TextMessage null {
			{color 5}エレベーターのシャッターは
			固く閉ざされている。{wait}
		} {
			会議中、このエレベーターは
			使用できないようだ。{color 0}{wait}
		}
		TextWait
		TextClose 0
		_59
	TextEnd null
	Return

