fn[104]:
	EventBegin 1
	if !flag[18]:
		TextTalk name[161] {
			こっちは東通りか？{wait}
		}
		TextWait
		TextTalk name[0] {
			#00000Fいや、違うけど……{wait}
		}
		TextWait
		Emote name[161] 0mm 1700mm 12 13 250ms 2
		SoundPlay sound[23] 0 100 0
		Sleep 1000ms
		TextTalk name[161] {
			だよな？{wait}
		}
		TextWait
		TextTalk name[161] {
			……たしか、ボクは東通りを
			経由しろって言ったと思うけど。{wait}
		}
		TextWait
		TextTalk name[0] {
			#00006Fそうだな……悪かったよ。{wait}
		}
		TextWait
		FlagSet flag[18]
	else:
		TextTalk name[161] {
			おい、寄り道はいいけど
			遠回りはカンベンだかんな。{wait}
		}
		TextWait
		TextTalk name[161] {
			さっさと東通りに連れてってくれ。{wait}
		}
		TextWait
	CharSetPos field_party[0] (-28110, 2000, 23520) 90deg
	EventEnd 4
	Return

