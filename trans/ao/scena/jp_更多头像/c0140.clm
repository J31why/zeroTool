				恩返ししてくれるんだから。{wait}
			}
			TextWait
	Return

fn[11]:
	TextTalk char[1] {
		#08100Fオッケー。
		何について聞きたいの？{wait}
	}
	TextWait
	var[3] = 0
	while var[3] != 255:
		FadeOut 300ms 0x00000000 100
		Menu menu[1] -1 -1 1
			"戦術オーブメントについて" // 0
			"クオーツについて" // 1
			"スロットの開封について" // 2
			"スロットの強化について" // 3
			"導力魔法（アーツ）について" // 4
			"エニグマⅡについて" // 5
			"マスタークオーツについて" // 6
			"やめる" // 7
		MenuWait var[3]
		MenuClose menu[1]
		if var[3] != 7 && var[3] != -2:
			FadeIn 300ms 0x00000000
			_59
		switch var[3]:
			case 0:
				TextTalk char[1] {
					#08100F《戦術オーブメント》は、
					戦闘用に特化した
					小型の携帯導力器のことよ。{wait}
				} {
					#08102F使用者の能力を強化してくれるほか
					導力魔法#8Rア  ー  ツ#の使用もサポートしてくれるの。{wait}
				} {
					#08110F一般的には、単に『オーブメント』って
					呼ばれることも多いわね。{wait}
				} {
					#08104Fオーブメントは個人に合わせて
					完璧に調整されてるから、
					持ち主によって構造が異なるわよ。{wait}
				} {
					#08100F属性限定のスロットがあったり、
					スロットを結ぶ線#2Rライン#の形が違ったりするわ。
					一度みんなで見比べてみるといいかもね。{wait}
				}
				TextWait
				break
			case 1:
				TextTalk char[1] {
					#08100Fクオーツは、セピスを精錬して作られる
					オーブメント用の『結晶回路』のことね。{wait}
				} {
					#08102F必要なセピスさえ持ってきてくれれば
					ウチで合成ができるわ。{wait}
				} {
					#08100Fクオーツによって色々な効果があるし、
					属性値が一定以上になると
					導力魔法#8Rア  ー  ツ#が使えるようになるの。{wait}
				} {
					#08110Fセピスが溜まったら色々試してみてね。{wait}
				}
				TextWait
				break
			case 2:
				TextTalk char[1] {
					#08100Fオーブメントのスロットは
					初めはほとんどが未開封の状態よ。{wait}
				} {
					#08104Fだからクオーツをセットするには
					まずはスロットを開封する必要があるの。{wait}
				} {
					#08102Fスロットを開封すれば、
					それだけクオーツも沢山付けられるし
					最大ＥＰも上昇するわ。{wait}
				} {
					#08110F開封にはセピスが必要になるけど、
					早めに開封して損はないと思うわよ。{wait}
				}
				TextWait
				break
			case 3:
				TextTalk char[1] {
					#08100Fクオーツの中には『上位クオーツ』と
					呼ばれるものがあってね。{wait}
				} {
					#08103Fこれは強力すぎて、普通のスロットだと
					セットすることが出来ないの。{wait}
				} {
					#08100Fそこで必要になるのが、
					スロット自体の強化ってわけ。{wait}
				} {
					#08102F開封と同様にセピスが必要になるけど、
					最大ＥＰも上昇するからね。{wait}
				} {
					#08110F強化を焦ることはないと思うけど、
					オーブメントのパワーアップには
					欠かせない要素と言えるでしょうね。{wait}
				}
				TextWait
				break
			case 4:
				TextTalk char[1] {
					#08100F戦術オーブメントを使って発動する魔法が
					いわゆる導力魔法#8Rオーバルアーツ#ね。{wait}
				} {
					#08110F単純に『アーツ』って呼ばれる事が多いわ。{wait}
				} {
					#08100Fアーツは、セットしたクオーツの
					『ラインごとの属性値の合計』によって
					発動できる種類が決まってくるの。{wait}
				} {
					#08104Fつまり、セットしたクオーツの
					属性値が高ければ高いほど、
					使えるアーツも増えるってわけね。{wait}
				} {
					#08100Fちなみに、より強力なアーツを
					使いたい場合は属性値の組み合わせも
					重要になってくるわ。{wait}
				} {
					#08109Fその辺りの詳しい情報は、
					捜査手帳にリストが載っているから
					そちらを参照してね。{wait}
				}
				TextWait
				break
			case 5:
				TextTalk char[1] {
					#08100Fエニグマの通信機能を引き継ぎ、
					大胆な改造が施された後継機――
					それが『エニグマⅡ』よ。{wait}
				} {
					#08102F唯一にして最大の変更点は、
					新たに『マスタークオーツ』という
					特別なクオーツに対応されたことね。{wait}
				} {
					#08103Fちなみに大抵そうなんだけど……
					今回のバージョンアップによって
					基本アーキテクチャに変更があってね。{wait}
				} {
					#08101Fだから、互換性の問題で
					旧エニグマで使っていたクオーツは
					一切セットができないの。{wait}
				} {
					#08106Fてわけで、エニグマⅡを使うには
					新しい規格のクオーツが必要になるわよ。{wait}
				}
				TextWait
				break
			case 6:
				TextTalk char[1] {
					#08100Fマスタークオーツは、
					エニグマⅡの中心に嵌める
					特別なクオーツのことよ。{wait}
				} {
					#08102F従来のクオーツと決定的に違うのは
					それ自身が『成長する』ということね。{wait}
				} {
					#08104Fオーブメントにセットした状態で
					戦闘を重ねることで、レベルが上がって
					より強力な効果を発揮してくれるわ。{wait}
				} {
					#08100F使用者の能力強化、
					クオーツの特殊効果、そして属性値……
					大きな成長要素はこの３点ね。{wait}
				} {
					#08109Fちなみにマスタークオーツは
					どんなものでも最後まで育てれば
					非常に強力なものになるらしいわ。{wait}
				} {
					#08103Fレベルを上げるには
					かなりの時間がかかるみたいだし……{wait}
				} {
					#08110F浮気せずに、気に入ったものを
					使い続けることが重要かもしれないわね。{wait}
				}
				TextWait
				break
			default:
				var[3] = 255
				break
	Sleep 150ms
	var[3] = 0
	Return

