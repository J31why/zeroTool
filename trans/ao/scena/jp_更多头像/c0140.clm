					#08100F#11Pエニグマの通信機能を引き継ぎ、
					大胆な改造が施された後継機――
					それが『エニグマⅡ』よ。{wait}
				} {
					#08102F#11P唯一にして最大の変更点は、
					新たに『マスタークオーツ』という
					特別なクオーツに対応されたことね。{wait}
				} {
					#08103F#11Pちなみに大抵そうなんだけど……
					今回のバージョンアップによって
					基本アーキテクチャに変更があってね。{wait}
				} {
					#08101F#11Pだから、互換性の問題で
					旧エニグマで使っていたクオーツは
					一切セットができないの。{wait}
				} {
					#08106F#11Pてわけで、エニグマⅡを使うには
					新しい規格のクオーツが必要になるわよ。{wait}
				}
				TextWait
				break
			case 6:
				TextTalk char[1] {
					#08100F#11Pマスタークオーツは、
					エニグマⅡの中心に嵌める
					特別なクオーツのことよ。{wait}
				} {
					#08102F#11P従来のクオーツと決定的に違うのは
					それ自身が『成長する』ということね。{wait}
				} {
					#08104F#11Pオーブメントにセットした状態で
					戦闘を重ねることで、レベルが上がって
					より強力な効果を発揮してくれるわ。{wait}
				} {
					#08100F#11P使用者の能力強化、
					クオーツの特殊効果、そして属性値……
					大きな成長要素はこの３点ね。{wait}
				} {
					#08109F#11Pちなみにマスタークオーツは
					どんなものでも最後まで育てれば
					非常に強力なものになるらしいわ。{wait}
				} {
					#08103F#11Pレベルを上げるには
					かなりの時間がかかるみたいだし……{wait}
				} {
					#08110F#11P浮気せずに、気に入ったものを
					使い続けることが重要かもしれないわね。{wait}
				}
				TextWait
				break
			default:
				var[3] = 255
				break
	TextTalk name[0] {
