anim[0] 516ms

fn[0]:
	switch random % 8:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	CharFlagsSet char[2] 0x0010
	CharSetPos char[4] (-68850, 0, -980) 0deg
	if !flag[2]:
		CharFlagsSet char[4] 0x0010
	CharSetPos char[5] (-68700, 0, 340) 180deg
	CharFlagsSet char[5] 0x0010
	Return

fn[2]:
	Return

fn[3]:
	TextSetName ""
	TextMessage null {
		{color 5}『お菓子の王国　第一巻』がある。{wait}
	}
	TextWait
	TextClose 0
	_59
	TextSetPos -1 280 60 3
	if ItemHas item[2] 0:
		if !RecipeLearn 19:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextSetName ""
			TextMessage null {
				{color 2}『ミックスジェラート』{color 0}のレシピを覚えた。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			FadeWait
			_59
			TextSetPos -1 280 60 3
	TextEnd null
	Return

fn[4]:
	Call fn[0,5]
	Return

fn[5]:
	TextStart char[0]
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"話をする" // 0
			"買い物をする" // 1
			"やめる" // 2
		MenuWait var[0]
		if var[0] != 1:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			ShopOpen shop[201]
			var[0] = 99
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			Call fn[0,6]
	TextEnd char[0]
	Return

fn[6]:
	if !flag[0]:
		TextTalk char[0] {
			#14705Fこんな時間に
			ウロウロしてるなんて
			珍しいじゃないか。{wait}
		} {
			#14703F一応、閉店時間は
			過ぎちまってんだが……{wait}
		} {
			#14702Fま、おまえらならいいだろ。
			遠慮せず見てってくれ。{wait}
		}
		TextWait
		TextTalk name[0] {
			#00000Fサンキュー、オスカー。
			是非そうさせてもら……{wait}
		}
		TextWait
		TextTalk name[9] {
			#00603F…………………………{wait}
		}
		TextWait
		TextTalk name[0] {
			#00006F（か、買い物するにしても
			{}  早く済ませた方がよさそうだな。）{wait}
		}
		TextWait
		FlagSet flag[0]
	else:
		TextTalk char[0] {
			#14703F一応、閉店時間は
			過ぎちまってんだが……{wait}
		} {
			#14702Fま、おまえらならいいだろ。
			遠慮せず見てってくれ。{wait}
		}
		TextWait
	Return

fn[7]:
	TextStart self
	TextTalk self {
		さーて、そろそろ
		後片付けに入るとするか。{wait}
	}
	TextWait
	TextTalk self {
		パン屋の仕込みは、
		早朝３時からなんでな。
		明日に備えてさっさと休まねえと。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[8]:
	TextStart self
	TextTalk self {
		#14807F私の作ったパン、
		オスカーのに
		売り上げで負けてる……！？{wait}
	} {
		#14813Fぐぬぬ、明日こそは……！{wait}
	}
	TextWait
	TextEnd self
	Return

fn[9]:
	Call fn[0,10]
	Return

fn[10]:
	TextStart char[3]
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"話をする" // 0
			"買い物をする" // 1
			"やめる" // 2
		MenuWait var[0]
		if var[0] != 1:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			ShopOpen shop[41]
			var[0] = 99
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			TextTalk char[3] {
				おやいらっしゃい、
				何か入用かい？{wait}
			}
			TextWait
			TextTalk char[3] {
				店はもう少し
				開けてるつもりだから、
				ゆっくりしてていいからね。{wait}
			}
			TextWait
	TextEnd char[3]
	Return

fn[11]:
	TextStart self
	if !flag[2]:
		Call fn[0,12]
	else:
		TextTalk self {
			ふふ、モモったらよっぽど
			楽しかったんでしょうね。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[12]:
	_Char4A char[4] 255
	_Char4A char[5] 255
	TextTalk char[5] {
		……それでね、それでね。
		リュウ君、オルキスタワーに
		かってに入ろうとしたの。{wait}
	}
	TextWait
	TextTalk char[5] {
		そしたら、モモとアンリちゃんまで
		警察の人におこられちゃって……{wait}
	}
	TextWait
	TextTalk char[4] {
		あらあら……
		それは大変だったわねえ。{wait}
	}
	TextWait
	TextTalk char[5] {
		でもね、でもね。
		とっても楽しかったの……！{wait}
	}
	TextWait
	FlagSet flag[2]
	FlagSet flag[3]
	CharFlagsUnset char[4] 0x0010
	_Char4B char[4] 255
	_Char4B char[5] 255
	Return

fn[13]:
	TextStart self
	if !flag[3]:
		Call fn[0,12]
	else:
		TextTalk self {
			でもリュウ君、面白かったの。
			ぜんぶアンリちゃんのせいに
			しようとしちゃって……{wait}
		}
		TextWait
		TextTalk self {
			でも、すぐにばれちゃって、
			もっと叱られちゃったの。
			くすくす……{wait}
		}
		TextWait
	TextEnd self
	Return
