fn[8]:
	TextStart char[0]
	if flag[3385]:
		if !flag[1]:
			TextTalkNamed char[0] "兵士コナーズ" {
				国境にかかる渡り橋は、
				いまだに落ちたままだが、
				帝国軍への警戒は厳重にしてる。{wait}
			}
			TextWait
			TextTalkNamed char[0] "兵士コナーズ" {
				奴らが侵攻を始めようと思ったら、
				落ちた橋なんてすぐにでも
				修繕しちまえるだろう。{wait}
			}
			TextWait
			TextTalkNamed char[0] "兵士コナーズ" {
				幸か不幸か、帝国は内戦中……
				今のうちに俺たちも
				体勢を整えておかなくちゃな。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalkNamed char[0] "兵士コナーズ" {
				帝国軍が侵攻を始めようと思ったら、
				落ちた橋なんてすぐにでも
				修繕しちまえるだろう。{wait}
			}
			TextWait
			TextTalkNamed char[0] "兵士コナーズ" {
				幸か不幸か、帝国は内戦中……
				今のうちに俺たちも
				体勢を整えておかなくちゃな。{wait}
			}
			TextWait
	elif flag[3074]:
		TextTalk char[0] {
			最近の緊張状態を鑑みて、
			クロスベルを離れる外国人も
			少なからずいるようだ。{wait}
		}
		TextWait
		TextTalk char[0] {
			それでなくても、
			物騒な事件が続いたからな……
			仕方がないってところか。{wait}
		}
		TextWait
	elif flag[2848]:
		if !flag[1]:
			TextTalk char[0] {
				昨日、ミレイユ三尉の連れた部隊が
				巨大な化物を目撃したそうだな。{wait}
			}
			TextWait
			TextTalk char[0] {
				逃げてしまった化物の警戒に、
				しばらくは一個中隊単位で
				自治州内をパトロールするらしい。{wait}
			}
			TextWait
			TextTalk char[0] {
				やれやれ……
				緊張状態も続いている中で
				忙しさは増す一方だな。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk char[0] {
				逃げてしまった化物の警戒に、
				しばらくは一個中隊単位で
				自治州内をパトロールするらしい。{wait}
			}
			TextWait
			TextTalk char[0] {
				やれやれ……
				緊張状態も続いている中で
				忙しさは増す一方だな。{wait}
			}
			TextWait
	elif flag[2832]:
		TextTalk char[0] {
			さっき、ここを通った帝国商人が、
			クロスベルの独立について
