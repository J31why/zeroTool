	Return

fn[9]:
	TextStart self
	if flag[3385]:
		if !flag[3]:
			TextTalk char[3] {
				国防軍を受け入れた司令、
				レジスタンス活動を始めた
				ミレイユ三尉たち……{wait}
			}
			TextWait
			TextTalk char[3] {
				あの人たちは、考えに考えた末に
				それぞれの道を選んだんだ。{wait}
			}
			TextWait
			TextTalk char[3] {
				だが、国防軍になれた事で
				隊員のほとんどは浮かれちまって、
				ただ流されるままになっていた。{wait}
			}
			TextWait
			TextTalk char[3] {
				……はあ、自分で自分が情けないな。{wait}
			}
			TextWait
			FlagSet flag[3]
		else:
			TextTalk char[3] {
				ソーニャ司令もミレイユ三尉たちも、
				考えに考えた末に
				それぞれの道を選んだんだ。{wait}
			}
			TextWait
			TextTalk char[3] {
				……俺たちも頑張らないとな。{wait}
			}
			TextWait
	TextEnd self
	Return

