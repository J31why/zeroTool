fn[5]:
	TextStart self
	if flag[2573]:
		if !flag[2636]:
			Call fn[0,12]
		else:
			TextTalk self {
				#07900F今、ソーニャ司令とダグラス副司令が
				テロ対策の打ち合わせをしてるの。{wait}
			} {
				#07903Fあまり邪魔をしないようにね。{wait}
			}
			TextWait
	elif flag[2564]:
		if !flag[2636]:
			Call fn[0,12]
		elif !flag[1]:
			TextTalk self {
				#07900Fソーニャ司令なら、
				今日は保養地ミシュラムで
				警備の指揮をとっているわ。{wait}
			} {
				#07903F国賓たちが迎賓館に
				招待されているから、
				最も重要な警備地点なのよね。{wait}
			}
			TextWait
			TextTalk name[3] {
				#00305Fっつーことは
				今日はお前が司令の代わりに
				ベルガード門の連中を纏めるわけか。{wait}
			} {
				#00306Fはあ、ミレイユなんかに
				あのソーニャ司令の
				代理が務まるんですかねえ～？{wait}
			}
			TextWait
			CharTurnToChar self name[3] 500deg/s
			TextTalk self {
				#07901Fし、失礼なッ……{wait}
			} {
				#07903F……ふん、あなたの心配なんか結構。
				前司令がいたころは似たような事を
				よくやらされてたもの。{wait}
			} {
				#07907Fソーニャ司令のお留守は、
				絶対に守ってみせるんだから！{wait}
			}
			TextWait
			TextTalk name[3] {
				#00309Fはは、その意気なら大丈夫そうだな。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				#07903F前司令がいたころは
				よく代理で門の指揮を
				任されていたもの。{wait}
			} {
				#07901Fソーニャ司令のお留守は、
				絶対に守ってみせるんだから！{wait}
			}
			TextWait
	elif flag[2560]:
		if !flag[2636]:
			Call fn[0,12]
		elif !flag[1]:
			TextTalk self {
				#07904Fま、まあ、
				私の昇進の話はさておき……{wait}
			} {
				#07900F通商会議に向けて、
				国境門でも警戒を強めているわ。{wait}
			} {
				旅行者なんかとトラブルを
				起こしたりしないよう、
				注意してちょうだいね。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				#07900F通商会議に向けて、
				国境門でも警戒を強めているわ。{wait}
			} {
				旅行者なんかとトラブルを
				起こしたりしないよう、
				注意してちょうだいね。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[6]:
	TextStart self
	if flag[3074]:
	elif flag[2861]:
	elif flag[2848]:
	elif flag[2832]:
		if !flag[1]:
			TextTalk self {
				#07900Fああ、あなたたち……{wait}
			} {
				ベルガード門に来る途中に、
				何か危ない目に合わなかった？{wait}
			}
			TextWait
			TextTalk name[0] {
				#00005Fえっ……？{wait}
			}
			TextWait
			TextTalk name[3] {
				#00305F別段いつもと変わった様子は
				なかったみてえだけどな。{wait}
			}
			TextWait
			TextTalk self {
				#07900Fそう……{wait}
			} {
				#07903F……どうやら今日は
				現れる気配はないみたいね。{wait}
			}
			TextWait
			Emote field_party[0] 0mm 2000mm 0 1 250ms 2
			SoundPlay sound[29] 0 100 0
			Emote field_party[1] 0mm 2000mm 0 1 250ms 2
			SoundPlay sound[29] 0 100 0
			Emote field_party[2] 0mm 2000mm 0 1 250ms 2
			SoundPlay sound[29] 0 100 0
			Emote field_party[3] 0mm 2000mm 0 1 250ms 2
			SoundPlay sound[29] 0 100 0
			Sleep 1000ms
			TextTalk self {
				#07900Fいえ、気にしないで。
				こちらの仕事の話だから。{wait}
			} {
				#07903Fもしかしたら近い内に、
				あなたたちに相談するかも
				しれないけど……{wait}
			}
			TextWait
			TextTalk name[3] {
				#00303Fふーむ、よくわからねえが……
				助けが必要ならいつでも呼んでくれや。{wait}
			}
			TextWait
			TextTalk self {
				#07902Fええ、その時はお願いするわね。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				#07903F……どうやら今日は
				現れる気配はないみたいだし……{wait}
			} {
				#07901F今はとにかく、２大国との緊張状態に
				全力であたっていかないとね。{wait}
			}
			TextWait
	elif flag[2816]:
		if !flag[2900]:
			TextTalk name[3] {
				#00309Fいよっ、ミレイユ准尉殿。
				元気にしてたかよ？{wait}
			}
			TextWait
			CharTurnToChar self name[3] 500deg/s
			TextTalk self {
				#07901F……あなた、
				わざとやってるでしょ？{wait}
			} {
				#07906Fこの間三尉に昇進したって
				言ったばかりじゃない……
				まったくもう。{wait}
			}
			TextWait
			TextTalk name[8] {
				#10109Fあはは……何はともあれ、
				昇進、おめでとうございます。{wait}
			}
			TextWait
			CharTurnToChar self name[8] 500deg/s
			TextTalk self {
				#07909Fふふ、ありがとう曹長。{wait}
			} {
				#07903F昇進はありがたいことだけど……
				背負う責任もだんだんと
				大きくなってくるでしょう。{wait}
			} {
				#07901Fこれからも一層、
				精進を重ねていかなくちゃね。{wait}
			}
			TextWait
			TextTalk name[3] {
				#00306Fやれやれ、あいかわらず
				クソマジメなやつだなあ。{wait}
			} {
				#00302Fガンバるばかりじゃ疲れちまうぜ。
				テケトーにやっとけ、テケトーに。{wait}
			}
			TextWait
			CharTurnToChar self name[3] 500deg/s
			Emote self 0mm 2000mm 12 13 250ms 2
			SoundPlay sound[23] 0 100 0
			Sleep 1000ms
			TextTalk self {
				#07901F人が折角いい話を
				してるっていうのに……
				この、ぼけなすランディ！{wait}
			}
			TextWait
			TextTalk name[8] {
				#10112Fあ、あはは……
				（昇進しても相変わらずですね……）{wait}
			}
			TextWait
			FlagSet flag[2900]
			CharTurnTo self 180deg 0deg/s
		elif !flag[2901]:
			TextTalk name[3] {
				#00300Fおっと、そういや……
				昇進祝いにプレゼントしたアレ、
				つけてるか？{wait}
			} {
				ミシュラムの宝飾店で
				買ってきたアレだよ、アレ。{wait}
			}
			TextWait
			if !flag[2769]:
				TextTalk name[0] {
					#00005Fへえ……
					プレゼントなんてしてたのか。{wait}
				}
				TextWait
			else:
				TextTalk name[0] {
					#00002Fああ……そういえば、
					ブローチを買ってたんだっけ。{wait}
				}
				TextWait
			CharTurnToChar self name[3] 500deg/s
			TextTalk self {
				#07906Fあのねえ……
				つけてるわけないでしょ。{wait}
			} {
				#07900F警備隊の士官ともあろうものが
				そんなチャラチャラできないし、
				アレは大事にしまって……{wait}
			}
			TextWait
			Emote self 0mm 2000mm 2 7 80ms 1
			SoundPlay sound[28] 0 100 0
			Sleep 1000ms
			Emote self 0mm 2000mm 40 43 100ms 0
			Sleep 1000ms
			EmoteStop self
			TextTalk self {
				#07911Fちっ、ちがっ……ちがうからね！
				大事になんてしてないから！{wait}
			} {
				#07909Fそ、そう！　タンスのすみ～の方に
				ぞんざいに投げ入れてて……！{wait}
			}
			TextWait
			TextTalk name[3] {
				#00309Fわはは、照れるなっつの。{wait}
			}
			TextWait
			TextTalk name[2] {
				#00204F（……ほほえましいです。）{wait}
			}
			TextWait
			FlagSet flag[2901]
			CharTurnTo self 180deg 0deg/s
		else:
			TextTalk self {
				#07902Fコ、コホン、とにかく……
				昇進したからには、
				前以上に頑張っていくつもりよ。{wait}
			} {
				#07903F少しでも司令の力になれるよう、
				より一層精進していかなくちゃね。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[7]:
	Call fn[0,8]
	Return

fn[8]:
	TextStart char[2]
	if flag[3074]:
		name[8].5 = char[2].4
		char[2].5 = char[2].4
		CharFlagsUnset char[2] 0x0010
		CharTurnToChar char[2] name[8] 0deg/s
		char[2].4 = (char[2].4 + 360) % 360
		char[2].4 = char[2].4 + 360 - char[2].5
		char[2].5 = char[2].4 / 180
		if char[2].4 <= 45 | char[2].4 >= 315 && char[2].4 <= 405 | char[2].4 >= 675:
		elif char[2].5 < 1:
			char[2].8 = 2
		elif char[2].5 > 2:
			char[2].8 = 1
		else:
			char[2].8 = char[2].5
		char[2].4 = name[8].5
		name[8].5 = 0
		char[2].5 = 0
		CharFlagsSet char[2] 0x0010
		if !flag[2]:
			TextTalk char[2] {
				#02008F……………………………………{wait}
			}
			TextWait
			TextTalk name[0] {
				#00001Fソーニャ司令……
				何か悩み事でもあるんですか？{wait}
			}
			TextWait
			TextTalk char[2] {
				#02003F……警備隊の再編について少しね。{wait}
			} {
				#02000Fマインツ山道で受けた甚大な被害から
				元の状態まで立ち直るには、
				やはり時間がかかるでしょう。{wait}
			}
			TextWait
			TextTalk name[1] {
				#00108Fやはりそうですか……{wait}
			}
			TextWait
			TextTalk name[8] {
				#10108F…………………………{wait}
			}
			TextWait
			TextTalk char[2] {
				#02000F……ノエル曹長。
				浮かない顔をしているわね。{wait}
			} {
				#02003F警備隊への復帰を決めたこと、
				後悔しているのかしら。{wait}
			}
			TextWait
			TextTalk name[8] {
				#10103F……いえ、そんなことは。{wait}
			} {
				#10108Fただ、支援課も忙しいのに
				私だけ抜けてしまうのが
				少し忍びない気持ちですけど……{wait}
			}
			TextWait
			TextTalk name[0] {
				#00003Fノエル……{wait}
			}
			TextWait
			TextTalk char[2] {
				#02003F……警備隊の建て直しに
				あなたの力は是非とも欲しいけど……{wait}
			} {
				#02000Fやはり、復帰は止めておくのかしら？{wait}
			}
			TextWait
			TextTalk name[8] {
				#10103Fいえ……
				やっぱり決めたことですから。{wait}
			} {
				#10101Fノエル・シーカー、
				今日一日の業務が終わり次第、
				警備隊に復帰させていただきます！{wait}
			}
			TextWait
			TextTalk char[2] {
				#02004F結構。{wait}
			} {
				#02000Fでももちろん、今の貴女はまだ
				支援課の出向員よ。{wait}
			} {
				悔いのないよう、残った仕事は
				全て片付けてきなさい。
				……いいわね？{wait}
			}
			TextWait
			TextTalk name[8] {
				#10100Fハッ、了解です！{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			TextTalk char[2] {
				#02000F警備隊の建て直しに
				ノエルの力は是非とも欲しいわ。{wait}
			} {
				#02004F今日一日、悔いのないように
				支援課の業務を片付けて、
				それから戻ってきてちょうだい。{wait}
			}
			TextWait
			TextTalk name[8] {
				#10100Fハッ、了解です！{wait}
			}
			TextWait
		CharFlagsUnset char[2] 0x0010
	elif flag[2848]:
