fn[7]:
	if QuestFlagsGet quest[128] 0x02 && !QuestFlagsGet quest[128] 0x10 && !QuestFlagsGet quest[128] 0x40 && flag[2960] && !flag[2969]:
		if flag[2848]:
			Call fn[0,33]
			Return
		if !flag[3017]:
			Call fn[0,32]
			Return
	TextStart char[0]
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"話をする" // 0
			"買い物をする" // 1
			"休憩をする" // 2
			"やめる" // 3
		MenuWait var[0]
		if var[0] < 1 | var[0] > 2:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			if flag[3328]:
				ShopOpen shop[95]
			elif flag[2848]:
				ShopOpen shop[94]
			elif flag[2816]:
				ShopOpen shop[93]
			else:
				ShopOpen shop[92]
			var[0] = 99
		elif var[0] == 2:
			ShopOpen shop[90]
			var[0] = 99
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			if flag[11]:
				if flag[2969]:
					TextTalk char[0] {
						ふふ、ウチの煮込みシチューは
						最高だったろう？{wait}
					}
					TextWait
					TextTalk char[0] {
						患者さんや外来のお客さんにも
						元気が出るって評判なんだ。
						また食べにおいで。{wait}
					}
					TextWait
				else:
					TextTalk char[0] {
						ウチのお勧め料理は
						かなりの時間、
						煮込む必要があるんだ。{wait}
					}
					TextWait
					if !flag[2832]:
						TextTalk char[0] {
							完成するのは
							２日後ってところだね。{wait}
						}
						TextWait
						TextTalk char[0] {
							その頃になったら
							忘れずにおいで。{wait}
						}
						TextWait
					else:
						TextTalk char[0] {
							完成するのは
							明日ってところだね。{wait}
						}
						TextWait
						TextTalk char[0] {
							もうすぐだから、
							忘れずにおいで。{wait}
						}
						TextWait
			elif flag[3385]:
				if !flag[0]:
					TextTalk char[0] {
						ハロルドさんから連絡があってね。
						後で病院の方に来てくれるらしいんだ。{wait}
					}
					TextWait
					TextTalk char[0] {
						アルモリカ産の野菜を
						沢山持ってきてくれるよう頼んだし、
						ようやくまともな食事が作れそうだよ。{wait}
					}
					TextWait
					TextTalk char[0] {
						豊かな食事は何より大切だからね。
						これで患者さんたちも
						元気になってくれるだろうさ。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[0] {
						ハロルドさんにアルモリカ産の野菜を
						沢山持ってきてくれるよう頼んだし、
						ようやくまともな食事が作れそうだよ。{wait}
					}
					TextWait
					TextTalk char[0] {
						豊かな食事は何より大切だからね。
						これで患者さんたちも
						元気になってくれるだろうさ。{wait}
					}
					TextWait
			elif flag[3362]:
				TextTalk char[0] {
					こっちに留まってる
					外来さんたちにも、だんだんと
					疲れが溜まってるみたいだ。{wait}
				}
				TextWait
				TextTalk char[0] {
					早いところクロスベル市に
					戻してあげられるといいんだけど。{wait}
				}
				TextWait
			elif flag[3338]:
				if !flag[0]:
					TextTalk char[0] {
						街から食糧は
						支給されてるんだが、
						基本的に保存食が多くてねえ。{wait}
					}
					TextWait
					TextTalk char[0] {
						やれやれ、病院食を作るにも
						どうにも栄養のバランスが
						悪くなっちまうよ。{wait}
					}
					TextWait
					TextTalk char[0] {
						心なしか患者さんや
						外来客さんの表情も暗いし……
						なんとかしたいねえ。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[0] {
						街から支給される食糧だけじゃ
						どうにも栄養のバランスが
						悪くなっちまうよ。{wait}
					}
					TextWait
					TextTalk char[0] {
						以前みたいにアルモリカ村の
						新鮮な野菜が仕入れられるように
						なればいいんだけどねえ。{wait}
					}
					TextWait
			elif flag[3328]:
				if !flag[0]:
					TextTalk char[0] {
						あっちの方にいる街の子たち、
						アルカンシェルのファンらしくてね。{wait}
					}
					TextWait
					TextTalk char[0] {
						イリアのお見舞いに来てたんだが、
						独立宣言から病院に残って
						色々と手伝ってくれてるんだ。{wait}
					}
					TextWait
					TextTalk char[0] {
						ふふ、親切な子たちもいたものだよ。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[0] {
						イリアのファンの子たちが、
						独立宣言から病院に残って
						色々と手伝ってくれてるんだ。{wait}
					}
					TextWait
					TextTalk char[0] {
						ふふ、親切な子たちもいたものだよ。{wait}
					}
					TextWait
			elif flag[3074]:
				if !flag[0]:
					TextTalk char[0] {
						あたしゃ病院食のメニューも
						担当しているんだが……{wait}
					}
					TextWait
					TextTalk char[0] {
						今回の入院患者さんには、
						ご飯も食べられないほどの
						怪我してる人も多くてね。{wait}
					}
					TextWait
					TextTalk char[0] {
						食は活力につながるんだ。
						なんとか食べれるように
						なってほしいもんだよ。{wait}
					}
