fn[3]:
	if flag[3074]:
		LookPointFlagsSet look_point[1] 0x0001
	if !flag[3385] && flag[3371]:
		LookPointFlagsSet look_point[0] 0x0001
	if flag[2848] && !flag[2858] | flag[2369] && system[4] == 1:
		ED7_76_0 object[255] "hikari00_add" 1
		ED7_76_0 object[255] "hikari01_add" 1
		SoundPlay sound[128] 1 50 0
	if !flag[3385] && flag[3370]:
		MapColor 0x00E6D2D2 0ms
		ED7_76_0 object[255] "hikari00_add" 1
		ED7_76_0 object[255] "hikari01_add" 1
	if system[0] == 102:
		ED7_76_1 object[255] "model5" 1
	else:
		ED7_76_0 object[255] "model5" 1
	LookPointFlagsSet look_point[9] 0x0001
	if QuestFlagsGet quest[115] 0x02 && !QuestFlagsGet quest[115] 0x10 && !QuestFlagsGet quest[115] 0x40 && flag[2723]:
		EntranceSetFunc entrance[0] fn[0,53]
		LookPointFlagsUnset look_point[9] 0x0001
	Return

fn[4]:
	TextSetName ""
	TextSetPos -1 -1 -1 -1
	TextMessage null {
		{color 5}　　★　リジョンフード・メモ　★
		ご来店のお客様に、爽やかな喉ごしの
		ベルベリージュースを提案いたします。{wait}
	}
	TextWait
	TextMessage null {
		{color 5}ベルベリージュースのレシピが書かれている。{wait}
	}
	TextWait
	TextClose 0
	_59
	TextSetPos -1 280 60 3
	if ItemHas item[2] 0:
		if !RecipeLearn 22:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextSetName ""
			TextMessage null {
				{color 2}『ベルベリージュース』{color 0}のレシピを覚えた。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			FadeWait
			_59
			TextSetPos -1 280 60 3
	TextEnd null
	Return

fn[5]:
	Call fn[0,6]
	Return

fn[6]:
	TextStart char[0]
	if flag[3385]:
		TextTalk char[0] {
			少し前にスコットさんが
			顔を見せに来てくれたんですが、
			とりあえず元気そうで何よりでした。{wait}
		}
		TextWait
		TextTalk char[0] {
			彼があれだけ
			頑張ってくれているんですから……
			私も出来ることを頑張らないとですね！{wait}
		}
		TextWait
	elif flag[3371]:
		if !flag[3548]:
			Call fn[0,23]
		elif !flag[0]:
			TextTalk char[0] {
				幸い、この場所は当面の間、
				食料品や日用品の類に
				困ることはありませんが……{wait}
			}
			TextWait
			TextTalk char[0] {
				この状況が長く続くとすれば、
				むしろそういった蓄えのない
				ご家庭などの方が心配ですね。{wait}
			}
			TextWait
			TextTalk char[0] {
				本当に……政府はいったい
				何を考えているのでしょうか？{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				本当に……政府はいったい
				何を考えているのでしょうか？{wait}
			}
			TextWait
			TextTalk char[0] {
				スコットさんも
				無事だといいんですが……{wait}
			}
			TextWait
	elif flag[3089]:
		if !flag[0]:
			TextTalk char[0] {
				シンシア先輩は住民投票の翌日に
				故郷のレミフェリアに帰ったんです。{wait}
			}
			TextWait
			TextTalk char[0] {
				先輩も、まさか
				今のクロスベルの状況は
				予想していなかったと思いますけど……{wait}
			}
			TextWait
			TextTalk char[0] {
				以前からご家族も
				かなり心配されていたようですし、
				早めに帰国できて本当に良かったです。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				シンシア先輩は、必ずまた
				この百貨店に戻って来るって
				約束してくれたんです。{wait}
			}
			TextWait
			TextTalk char[0] {
				これから色々不安もありますけど……
				先輩とまたご一緒できる日を信じて
				とにかく一生懸命がんばります。{wait}
			}
			TextWait
	elif flag[3074]:
		if !flag[0]:
			TextTalk char[0] {
				シンシア先輩は、行政区で
				行われているチャリティイベントに
				お手伝いで参加しているんです。{wait}
			}
			TextWait
			TextTalk char[0] {
				それに、何でも
				ミスコンにも参加するとか。
				あとで写真をみせてもらおっと♪{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				シンシア先輩は、何でも
