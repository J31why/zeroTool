		CharFlagsUnset char[24] 0x0080
	elif flag[2560]:
		CharFlagsSet char[10] 0x0080
		CharFlagsUnset char[15] 0x0080
		CharSetChipBase char[15] chip[13]
		CharSetChipPattern char[15] 0
		ForkQuit char[15] fork[0]
		CharFlags2Set char[15] 0x0004
		CharFlagsUnset char[16] 0x0080
		CharFlagsUnset char[17] 0x0080
		if !flag[13]:
			CharFlagsSet char[15] 0x0010
		CharFlagsSet char[16] 0x0010
		CharFlagsSet char[17] 0x0010
		CharFlagsUnset char[22] 0x0080
		CharFlagsUnset char[23] 0x0080
		CharSetChipBase char[22] chip[19]
		CharSetChipPattern char[22] 0
		ForkQuit char[22] fork[0]
		CharFlags2Set char[22] 0x0004
		CharSetChipBase char[23] chip[20]
		CharSetChipPattern char[23] 0
		ForkQuit char[23] fork[0]
