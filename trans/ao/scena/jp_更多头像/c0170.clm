	elif flag[2369]:
		CharSetPos char[10] (-17370, 30, 22740) 45deg
		CharFlagsSet char[6] 0x0010
		CharFlagsSet char[10] 0x0010
		CharFlagsUnset char[8] 0x0080
		CharFlagsUnset char[7] 0x0080
		CharFlagsUnset char[21] 0x0080
		if !QuestFlagsGet quest[110] 0x10:
			CharFlagsUnset char[20] 0x0080
			CharSetPos char[20] (-15840, 0, 15980) 0deg
			CharFlagsSet char[20] 0x0010
	elif flag[2353]:
		CharFlagsSet char[10] 0x0080
		CharFlagsUnset char[21] 0x0080
	if flag[272]:
