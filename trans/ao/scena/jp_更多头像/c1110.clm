fn[5]:
	if QuestFlagsGet quest[106] 0x02 && !QuestFlagsGet quest[106] 0x10 && !QuestFlagsGet quest[106] 0x40:
		if flag[2446] && flag[2447] && flag[2449] && flag[2450]:
			Call fn[0,28]
			Return
		if !flag[2444]:
			Call fn[0,27]
			Return
	TextStart char[0]
	if flag[3385]:
		if !flag[0]:
			TextTalk char[0] {
				職員で手分けして、
				戒厳令下の騒動での市民の
				安否を確認したのですが……{wait}
			}
			TextWait
			TextTalk char[0] {
				騒ぎに巻き込まれて
				軽傷を負った市民十数名以外は、
				ほとんど被害がなかったようです。{wait}
			}
			TextWait
			TextTalk char[0] {
				治療が必要な方々への
				救急車の手配もすみましたし……
				ひとまずこれで安心ですね。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				戒厳令下の騒動では、
				軽傷を負った市民十数名以外は、
				ほとんど被害がなかったようです。{wait}
			}
			TextWait
			TextTalk char[0] {
				治療が必要な方々への
				救急車の手配もすみましたし……
				ひとまずこれで安心ですね。{wait}
			}
			TextWait
	elif flag[3371]:
		if !flag[0]:
			TextTalk char[0] {
				現在、市民会館では
				ご自宅に戻れない市民の方々の
				受け入れ態勢をとっています。{wait}
			}
			TextWait
			TextTalk char[0] {
				なにかお困り事などございましたら
				ご遠慮なくお申しつけ下さいませ。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				市民会館にも、食料品や毛布など
				緊急時の備えがございます。{wait}
			}
			TextWait
			TextTalk char[0] {
				なにかお困り事などございましたら
				ご遠慮なくお申しつけ下さいませ。{wait}
			}
			TextWait
	elif flag[3089]:
		TextTalk char[0] {
			万歳を唱和する声が、
			ここにもはっきり届いてきます。{wait}
		}
		TextWait
		TextTalk char[0] {
			少し怖い気がするのは
			どうしてなんでしょうかね……{wait}
		}
		TextWait
	elif flag[3074]:
		TextTalk char[0] {
			本日はチャリティイベントへの
			ご来場ありがとうございます。{wait}
		}
		TextWait
		TextTalk char[0] {
			ぜひ参加されたいという
			企画等ございましたら
			どうぞお問い合わせくださいね。{wait}
		}
		TextWait
	elif flag[2861]:
		if !flag[0]:
			TextTalk char[0] {
				マインツを襲った武装集団について、
				市民の皆さんから非常に多くの
				お問い合わせを頂いているのですが……{wait}
			}
			TextWait
			TextTalk char[0] {
				犯人や事件の目的の話になると、
				私にはお答えようのないことなので
				すごく困ってしまいます。{wait}
			}
			TextWait
			TextTalk char[0] {
				帝国の仕業と言う方も多いのですが……
				果たして真実はどこにあるんでしょうか？{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				帝国の仕業と言う方も多いのですが……
				果たして真実はどこにあるんでしょうか？{wait}
			}
			TextWait
	elif flag[2848]:
		TextTalk char[0] {
			只今、左手の多目的ホールにて
			国家独立をテーマとした
			市民フォーラムが開催中です。{wait}
		}
		TextWait
		TextTalk char[0] {
			どなたでも傍聴は可能ですので
			宜しければ、お立ち寄り下さいませ。{wait}
		}
		TextWait
	elif flag[2837]:
		TextTalk char[0] {
			そうですね、当日でも
			傍聴自体は可能なのですが……{wait}
		}
		TextWait
		TextTalk char[0] {
			あいにく座席の方は
			埋まっておりまして……{wait}
		}
		TextWait
	elif flag[2832]:
		TextTalk char[0] {
			いらっしゃいませ。
			クロスベル市民会館へようこそ。{wait}
		}
		TextWait
		TextTalk char[0] {
			市民会館のご利用をお考えの方は
			まずは受付脇にある、こちらの
			お申し込み表にご記入くださいね。{wait}
		}
		TextWait
	elif flag[2816]:
		if !flag[0]:
			TextTalk char[0] {
				国家独立の提唱を受け、
				ここで勉強会を開きたいという
				お問い合わせが増えておりまして。{wait}
			}
			TextWait
			TextTalk char[0] {
				そんな声を受けて、市と通信社が
				共同で明後日に市民フォーラムを
				開催することになったんです。{wait}
			}
			TextWait
			TextTalk char[0] {
				現在も色々と調整中ですが、
				きっと皆さんにとって有意義な
				フォーラムが開催できると思います。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				明後日、この市民会館で
				クロスベルの国家独立をテーマとした
				市民フォーラムを開催する予定です。{wait}
			}
			TextWait
			TextTalk char[0] {
				現在も色々と調整中ですが、
				きっと皆さんにとって有意義な
				フォーラムが開催できると思います。{wait}
			}
			TextWait
	elif flag[2573]:
		TextTalk char[0] {
			も、申し訳ございません。
			以前から告示は
			していたと思うのですが……{wait}
		}
		TextWait
		TextTalk char[0] {
			安全保障の観点からどうしても
			一般の方をお通しするわけには
			いかないんです。{wait}
		}
		TextWait
	elif flag[2564]:
		if !flag[0]:
			TextTalk char[0] {
				各国の首脳が、とうとう
				クロスベル入りを果たしましたね。{wait}
			}
			TextWait
			TextTalk char[0] {
				午後からはそれぞれで
				行動するという話も聞きましたが……{wait}
			}
			TextWait
			TextTalk char[0] {
				皆さん、どういった
				お時間を過ごされるんでしょうかね？{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				首脳たちは、午後からはそれぞれで
				行動するという話も聞きましたが……{wait}
			}
			TextWait
			TextTalk char[0] {
				皆さん、どういった
				お時間を過ごされるんでしょうかね？{wait}
			}
			TextWait
	elif flag[2560]:
		TextTalk char[0] {
			通商会議とその前後の期間中は
			市民会館のご利用を
			ご遠慮いただいているんです。{wait}
		}
		TextWait
		TextTalk char[0] {
			ここはオルキスタワーにも近いですし、
			何かあったらそれこそ事ですからね。{wait}
		}
		TextWait
	elif flag[2369]:
		if QuestFlagsGet quest[106] 0x10:
			TextTalk char[0] {
				皆さん、本日は調査の方、
				どうもありがとうございました。{wait}
			}
			TextWait
			TextTalk char[0] {
				今後ともクロスベル市民会館を
				何卒よろしくお願いします。{wait}
			}
			TextWait
		elif QuestFlagsGet quest[106] 0x02:
			TextTalk char[0] {
				皆さんにお願いしたいのは
				計３箇所の不審住戸、および
				消息不明の前所有者の確認です。{wait}
			}
			TextWait
			TextTalk char[0] {
				全て確認されましたら、
				こちらの方に報告をお願いします。{wait}
			}
			TextWait
		else:
	elif flag[2353]:
		Call fn[0,10]
	TextEnd char[0]
	Return

fn[6]:
	TextStart self
	if flag[2353]:
		TextTalk self {
			いい物件が
			みつかるといいですわね。{wait}
		}
		TextWait
		TextTalk self {
			できたら、お花がいっぱい
			咲いている場所だと
			いいのですけど……{wait}
		}
		TextWait
	TextEnd self
	Return

