fn[10]:
	_Char4A char[8] 255
	_Char4A char[0] 255
	if !flag[0]:
		TextTalk char[8] {
			ええ、できるだけ安い部屋を
			探しているんですが……{wait}
		}
		TextWait
		TextTalk char[8] {
			多少狭くてもいいので、
			家族３人で暮らせる場所……
			どこかないものでしょうか。{wait}
		}
		TextWait
		TextTalk char[0] {
			そうですね……
			こういった資料もありますので、
			確認してみてはいかがでしょう。{wait}
