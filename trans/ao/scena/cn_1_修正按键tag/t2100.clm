fn[2]:
	if flag[0]:
		system[1] = 0
		FlagUnset flag[0]
	elif flag[3074] && !flag[3355]:
		system[1] = 151
	elif flag[3355]:
		system[1] = 566
	if flag[2848] && !flag[2858] | flag[2369] && system[4] == 1:
		EffLoad eff[9] "map/mprain00.eff"
		EffPlay eff[9] eff_instance[7] null 0 (0, 0, 0) 0 0 0 1000 1000 1000 null (0, 0, 0) 1000ms
		MapColor 0x00B4B4B4 0ms
		Fog 0xFFD5B47B 13 230 0
		SoundPlay sound[128] 1 100 0
	if flag[3100]:
		MapColor 0x00FFEBDC 0ms
	else:
	ED7_76_0 object[255] "open" 1
	ED7_76_0 object[255] "amor0" 1
	ED7_76_0 object[255] "amor0b" 1
	ED7_76_0 object[255] "cano0" 1
	ED7_76_0 object[255] "kage01" 1
	if !flag[3950]:
		ObjFrame object[2] 0
	else:
		ObjFrame object[2] 30
	Return

fn[3]:
	ED7_F2 1
	SystemFlagsSet 0x08000000
	if !flag[3950]:
		SoundPlay sound[14] 0 100 0
		ED7_74 object[2] 0 30
		ED7ObjPlay object[2] 0 30 0 0
		Sleep 500ms
		if ItemAdd item[45] 1:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextSetName ""
			TextMessage name[742] {
				{color 0}已取得{item[45]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			TextSetPos -1 280 60 3
			FadeIn 300ms 0x00000000
			FlagSet flag[3950]
			ED7_DE 5
		else:
			FadeOut 300ms 0x00000000 100
			TextSetName ""
			TextMessage name[742] {
				寶箱裡裝有{item[45]}{color 0}。
				因持有物品已達上限，已放棄{item[45]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			SoundPlay sound[15] 0 100 0
			ED7ObjPlay object[2] 30 0 0 0
	else:
		FadeOut 300ms 0x00000000 100
		TextSetPos -1 -1 -1 -1
		TextSetName ""
		TextMessage name[742] {
			{0x06}{color 5}寶箱裡什麼都沒有。{color 0}{wait}
		}
		TextWait
		TextClose 0
		FadeIn 300ms 0x00000000
	Sleep 30ms
	TextEnd null
	SystemFlagsUnset 0x08000000
	Return

fn[4]:
	TextStart self
	if flag[3074]:
		if !flag[1]:
			TextTalk self {
				襲擊克洛斯貝爾市的
				獵兵團，其實是帝國雇來的……
				似乎有這樣的傳聞呢。{wait}
			}
			TextWait
			TextTalk self {
				傷害警備隊夥伴的傢伙，
				無論如何都不能原諒。{wait}
			}
			TextWait
			TextTalk self {
				帝國如果打算這麼做的話，
				我也會做好心理準備。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				也有帝國正在進行
				大規模演習的傳聞，
				不過……{wait}
			}
			TextWait
			TextTalk self {
				……正合我意。
				帝國如果打算這麼做的話，
				我也會做好心理準備。{wait}
			}
			TextWait
	elif flag[2848]:
		TextTalk self {
			就算是小雨，
			還是會影響能見度呢。{wait}
		}
		TextWait
		TextTalk self {
			也有幻獸
			再次出現的目擊情報……
			不留意不行呢。{wait}
		}
		TextWait
	elif flag[2832]:
		if !flag[1]:
			TextTalk self {
				傷腦筋，最近已經忙到
				根本沒時間休息了。{wait}
			}
			TextWait
			TextTalk self {
				……但是，司令跟三尉他們
				肯定比我們更辛苦吧。
				他們這麼強悍，真讓人佩服。{wait}
			}
			TextWait
			TextTalk self {
				我也要更加努力才行。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				司令跟三尉他們
				肯定比我們更辛苦吧。
				他們這麼強悍，真讓人佩服。{wait}
			}
			TextWait
			TextTalk self {
				我也要更加努力才行。{wait}
			}
			TextWait
	elif flag[2816]:
		if !flag[1]:
			TextTalk self {
				自從市長提倡獨立以來，
				帝國與共和國施加的壓力
				就更加明目張膽了。{wait}
			}
			TextWait
			TextTalk self {
				老實說，這種緊張狀態讓人胃很痛。{wait}
			}
			TextWait
			TextTalk self {
				總之要是能盡早解決，
				給我們一個痛快就好了。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				老實說，這種緊張狀態讓人胃很痛。{wait}
			}
			TextWait
			TextTalk self {
				總之要是能盡早解決，
				給我們一個痛快就好了。{wait}
			}
			TextWait
	elif flag[2573]:
		TextTalk self {
			根據情報，
			恐怖份子從帝國那邊入侵的
			可能性很高。{wait}
		}
		TextWait
		TextTalk self {
			還是會令人緊張呢。
			只要能平安無事
			結束這一天就好了……{wait}
		}
		TextWait
	elif flag[2564]:
		if !flag[1]:
			TextTalk self {
				我在唐古拉姆門有個朋友
				叫做巴瑞爾，他啊……{wait}
			}
			TextWait
			TextTalk self {
				好像每天都被嚴厲得像魔鬼
				一樣的副司令使喚的樣子。{wait}
			}
			TextWait
			TextTalk self {
				不過，跟無能的長官比起來，
				有嚴厲的上司反而叫人羨慕呢。{wait}
			}
			TextWait
			TextTalk self {
				索妮亞司令雖然也非常嚴厲，
				不過我連１里矩都不覺得
				之前的司令比較好。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				不過，跟無能的長官比起來，
				有嚴厲的上司反而叫人羨慕呢。{wait}
			}
			TextWait
			TextTalk self {
				索妮亞司令雖然也非常嚴厲，
				不過我連１里矩都不覺得
				之前的司令比較好。{wait}
			}
			TextWait
	elif flag[2560]:
		if !flag[1]:
			TextTalk self {
				索妮亞司令來了之後，
				讓人更能提起幹勁執行
				貝爾加德門的警備任務了。{wait}
			}
			TextWait
			TextTalk self {
				上司有能力真的是件
				幸福的事情呢。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				前任司令還在的時候，
				我無法用這麼充實的
				心情完成工作。{wait}
			}
			TextWait
			TextTalk self {
				上司有能力真的是件
				幸福的事情呢。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[5]:
	TextStart self
	if flag[3074]:
		if !flag[2]:
			TextTalk self {
				在國家獨立氣勢高漲的局勢下，
				現在的緊張狀態比不戰條約
				之前還要緊繃。{wait}
			}
			TextWait
			TextTalk self {
				如果和帝國的對峙
				到達極限的話，那輛『列車砲』
				也很有可能會再度出現吧。{wait}
			}
			TextWait
			TextTalk self {
				果然……還是無法避免
				跟帝國及共和國發生衝突嗎？{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			TextTalk self {
				……最近，索妮亞司令似乎
				也經常陷入沉思之中。{wait}
			}
			TextWait
			TextTalk self {
				關於警備隊的重新編組，
				迪塔市長與麥克道爾議長
				似乎也在討論，不過……{wait}
			}
			TextWait
			TextTalk self {
				包含跟兩大國的對立在內，
				問題堆積如山呢。{wait}
			}
			TextWait
	elif flag[2848]:
		if !flag[2]:
			TextTalk self {
				昨天的脫軌意外……
				真的很誇張呢。{wait}
			}
			TextWait
			TextTalk self {
				如果犯人是那個
				巨大怪物的話……我擔心
				可能還會發生更多意外。{wait}
			}
			TextWait
			TextTalk self {
				果然還是要想辦法
				找出並擊退怪物呢。{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			TextTalk self {
				考慮到橫斷鐵路的重要性，
				防止意外再度發生是第一要務。{wait}
			}
			TextWait
			TextTalk self {
				果然還是要想辦法
				找出並擊退怪物呢。{wait}
			}
			TextWait
	elif flag[2832]:
		if !flag[3143]:
			TextTalk self {
				布魯德為了讓我放鬆心情，
				所以把這本書送給我。{wait}
			}
			TextWait
			TextTalk self {
				因為非常有趣，
				所以如果不嫌棄的話，
				請各位也讀讀看。{wait}
			}
			TextWait
			TextSetPos -1 -1 -1 -1
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetName ""
			TextMessage name[742] {
				{color 0}已取得{item[757]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			ItemAdd item[757] 1
			TextSetPos -1 280 60 3
			FlagSet flag[3143]
		elif !flag[2]:
			TextTalk self {
				在那個岩層內部的
				《加雷利亞要塞》裡，
				佈署著各式各樣的武器。{wait}
			}
			TextWait
			TextTalk self {
				過去，在極度緊繃狀態下
				進行大規模演習時，
				『列車砲』也曾運作過。{wait}
			}
			TextWait
			TextTalk self {
				真想祈禱
				這個緊繃的狀態
				不會招致那樣的狀況。{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			TextTalk self {
				過去，在極度緊繃狀態下
				進行大規模演習時，
				『列車砲』也曾運作過。{wait}
			}
			TextWait
			TextTalk self {
				真想祈禱
				這個緊繃的狀態
				不會招致那樣的狀況。{wait}
			}
			TextWait
	elif flag[2816]:
		if !flag[2]:
			TextTalk self {
				那個提倡獨立宣言
				也讓我很驚訝。{wait}
			}
			TextWait
			TextTalk self {
				但是……為了將來
				能夠繼續守護克洛斯貝爾，
				或許這也是必要手段。{wait}
			}
			TextWait
			TextTalk self {
				要是能實現就好了。{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			TextTalk self {
				那個提倡獨立宣言
				也讓我很驚訝，不過……
				這或許也是必要手段。{wait}
			}
			TextWait
			TextTalk self {
				要是能實現就好了。{wait}
			}
			TextWait
	elif flag[2573]:
		if !flag[2]:
			TextTalk self {
				既然接獲恐怖份子的情報，
				我也會盡全力執行
				國界附近的警備。{wait}
			}
			TextWait
			TextTalk self {
				為了防止他們從空路進入，
				我會使用設置在附近的
				特殊設施。{wait}
			}
			TextWait
			TextTalk self {
				如果再加上軍隊持有的那種
				對空砲就萬無一失了，不過……{wait}
			}
			TextWait
			TextTalk self {
				……將希望寄託於不可能會
				有的東西也不是辦法呢。{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			TextTalk self {
				要是有軍隊持有的那種對空砲，
				就能萬無一失地防止他們
				從空路進入了，不過……{wait}
			}
			TextWait
			TextTalk self {
				……將希望寄託於不可能會
				有的東西也不是辦法呢。{wait}
			}
			TextWait
	elif flag[2564]:
		if !flag[2]:
			TextTalk self {
				今天早上，我有看到鮮紅的
				導力列車通過門下。{wait}
			}
			TextWait
			TextTalk self {
				那是帝國政府專用的列車……
				那個《鐵血宰相》跟奧利巴特皇子
				肯定坐在上面吧。{wait}
			}
			TextWait
			TextTalk self {
				通商會議總算要開始了……
				這種感覺很深刻呢。{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			TextTalk self {
				今天早上，我有看到鮮紅的
				導力列車通過門下。{wait}
			}
			TextWait
			TextTalk self {
				通商會議總算要開始了……
				這種感覺很深刻呢。{wait}
			}
			TextWait
	elif flag[2560]:
		TextTalk self {
			隨著通商會議接近，
			我們警備隊承擔的責任
			也變得越來越大了。{wait}
		}
		TextWait
		TextTalk self {
			就算是為了保護
			進入克洛斯貝爾的各國領導人……
			邊境必須嚴加戒備才行。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[6]:
