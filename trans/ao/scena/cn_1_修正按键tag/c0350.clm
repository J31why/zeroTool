		elif !flag[2446]:
		else:
			LookPointFlagsUnset look_point[0] 0x0001
	Return

fn[4]:
	TextStart self
	if flag[3385]:
	elif flag[3371]:
		if !flag[0]:
			Call fn[0,5]
		else:
			TextTalk self {
				可惡……
				為什麼我們會遇到這種事……{wait}
			}
			TextWait
	elif flag[3089]:
		if !flag[0]:
			TextTalk self {
				雖然共和國政府通知我們，
				要我們快點離開克洛斯貝爾，但是……{wait}
			}
			TextWait
			TextTalk self {
				哼，我才不要去搭
				那麼擁擠的列車，
				跟別人一起擠沙丁魚呢。{wait}
			}
			TextWait
			TextTalk self {
				等到吊扣駕照期間結束，
				我再去弄一台汽車，
				悠閒地開車回國去。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				我才不要去搭
				那麼擁擠的列車，
				跟別人一起擠沙丁魚呢。{wait}
			}
			TextWait
			TextTalk self {
				等到吊扣駕照期間結束，
				我再去弄一台汽車，
				悠閒地開車回國去。{wait}
			}
			TextWait
	elif flag[3074]:
		if !flag[0]:
			TextTalk self {
				聽說上次的攻擊事件，
				好像對警察和警備隊
				造成嚴重傷亡對吧？{wait}
			}
			TextWait
			TextTalk self {
				呵呵呵……真爽。
				誰叫他們對我們沒禮貌，
				遭受到報應了吧？{wait}
			}
			TextWait
			TextTalk name[1] {
				#00103F（……我們走吧。
				　沒時間理會這些人了。）{wait}
			}
			TextWait
			TextTalk name[4] {
				#10300F（嗯，和蠢蛋不管說什麼，
				都是廢話而已。）{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				聽說上次的攻擊事件，
				好像對警察和警備隊
				造成嚴重傷亡對吧？{wait}
			}
			TextWait
			TextTalk self {
				呵呵呵……真爽。{wait}
			}
			TextWait
	elif flag[2861]:
		if !flag[0]:
			if QuestFlagsGet quest[139] 0x10:
				TextTalk self {
					哼，罰則就是罰則。
					我就姑且暫時認份一點。{wait}
				}
				TextWait
				TextTalk self {
					……你們快點滾蛋吧。
					我才沒有空理會你們呢。{wait}
				}
				TextWait
				TextTalk name[8] {
					#10100F（看樣子上次被凱特小姐罵過，
					　似乎讓他學到教訓了。）{wait}
				}
				TextWait
				TextTalk name[0] {
					#00004F（嗯……
					　看來暫時不需要擔心
					　他們又做什麼蠢事。）{wait}
				}
				TextWait
			else:
				TextTalk self {
					……你們想幹嘛？{wait}
				}
				TextWait
				TextTalk self {
					我沒空理
					你們這些警察。
					……你們快點滾蛋吧。{wait}
				}
				TextWait
				TextTalk name[0] {
					#00005F（發生什麼事了嗎……？）{wait}
				}
				TextWait
				TextTalk name[8] {
					#10105F（這麼說來，導力車沒有
					　停放在平時停放的位置……）{wait}
				}
				TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				……你們快點滾蛋吧。
				我才沒有空理會你們呢。{wait}
			}
			TextWait
	elif flag[2848]:
	elif flag[2837]:
		TextTalk self {
			嘖！瑞吉那傢伙
			除了開車，動作都慢吞吞的。{wait}
		}
		TextWait
		TextTalk self {
			至少泡杯紅茶
			手腳也該快一點吧。{wait}
		}
		TextWait
	elif flag[2832]:
	elif flag[2816]:
	elif flag[2573]:
		if !flag[0]:
			TextTalk self {
				今天就到歡樂街那裡，
				那間叫《新・布朗》的俱樂部
				看看吧。{wait}
			}
			TextWait
			TextTalk self {
				呵呵，像你們這樣的老百姓，
				想必跟那間店一輩子無緣啦。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00012F（這、這倒也不見得啦……）{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				……不過他們還真是慢。
				賽庫斯和瑞吉到底在做什麼……{wait}
			}
			TextWait
	elif flag[2568]:
		if !flag[2635]:
			TextTalk self {
				……這麼晚了，你們想幹嘛？{wait}
			}
			TextWait
			TextTalk self {
				你們在白天做的好事……
				別跟我說你們都忘了。{wait}
			}
			TextWait
			TextTalk name[9] {
				#00605F（你們幾個……
				　和他們起了什麼爭執嗎？）{wait}
			}
			TextWait
			TextTalk name[3] {
				#00306F（呃，其實
				　這也不是出於我們本意啦……）{wait}
			}
			TextWait
			TextTalk name[9] {
				#00603F（真是的……別在這種敏感的時候
				　惹出不必要的麻煩。）{wait}
			} {
				#00600F（在明天正式會議結束之前，
				　絕對不能有一絲疏忽。
				　……知道了嗎？）{wait}
			}
			TextWait
			TextTalk name[0] {
				#00005F（瞭、瞭解。）{wait}
			}
			TextWait
			FlagSet flag[2635]
		else:
			TextTalk self {
				你們在白天做的好事……
				別跟我說你們都忘了。{wait}
			}
			TextWait
			TextTalk self {
				我總有一天一定會讓你們後悔。{wait}
			}
			TextWait
			TextTalk name[3] {
				#00306F（這傢伙還真煩啊……）{wait}
			}
			TextWait
	elif flag[2564]:
		if QuestFlagsGet quest[116] 0x10:
			if !flag[0]:
				TextTalk self {
					你們對我做那麼過份的事……
					我會讓你們吃不完兜著走。{wait}
				}
				TextWait
				TextTalk self {
					不過就是自治州的警察，
					自以為有幾兩重啊……？{wait}
				}
				TextWait
				FlagSet flag[0]
			else:
				TextTalk self {
					你們對我做那麼過份的事……
					我會讓你們吃不完兜著走。{wait}
				}
				TextWait
		elif QuestFlagsGet quest[116] 0x02 && PartyPosition name[162] > -1:
			if !flag[0]:
				TextTalk self {
					……可惡……
					竟然對我做這種事……{wait}
				}
				TextWait
				TextTalk self {
					你們幾個……
					……我會讓你們吃不完兜著走……！{wait}
				}
				TextWait
				TextTalk name[162] {
					#04609F啊哈哈，你明明弱爆了，
					還逞強個屁啊～{wait}
				} {
					#04604F算了，想來挑戰的話，
					我隨時都歡迎。{wait}
				} {
					#04611F記得做好被殺死的覺悟喔♪{wait}
				}
				TextWait
				TextTalk self {
					……唔……！{wait}
				}
				TextWait
				TextTalk name[3] {
					#00303F……夠了，走吧，謝莉。{wait}
				}
				TextWait
				FlagSet flag[0]
			else:
				TextTalk self {
					……可惡……
					對我做那麼過份的事……
					我絕對無法饒了你們……！{wait}
				}
				TextWait
		else:
			TextTalk self {
				呵呵，誰叫牠
				擅自闖入我們的城堡。{wait}
			}
			TextWait
			TextTalk self {
				接受這種程度的懲罰，
				也是理所當然的啦。{wait}
			}
			TextWait
	elif flag[2560]:
	elif flag[2369]:
		if !flag[0]:
			Call fn[0,6]
			TextEnd self
			CharSetChipPattern char[0] 2
