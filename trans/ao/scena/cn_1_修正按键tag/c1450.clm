fn[0]:
	switch random % 8:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharIdle self (50690, null, -2760) (53210, null, 3920) 1000mm/s
		Sleep 300ms
	Return

fn[2]:
	while 1:
		CharIdle self (7420, null, 8330) (12220, null, 13180) 1000mm/s
		Sleep 300ms
	Return

fn[3]:
	while 1:
		CharIdle self (52340, null, 48330) (55490, null, 50370) 1000mm/s
		Sleep 300ms
	Return

