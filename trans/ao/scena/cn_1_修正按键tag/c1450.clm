fn[5]:
	if !flag[3089] && flag[3074] | flag[3371]:
		LookPointFlagsSet look_point[1] 0x0001
	else:
		ObjFlagsUnset object[4] 0x0010
		ObjFrame object[4] 0
	if !flag[3089] && flag[3074]:
		ObjFlagsUnset object[0] 0x0010
		ObjFrame object[0] 0
	if flag[2369] && !flag[2560] && !flag[2450]:
		ObjFlagsUnset object[0] 0x0010
		ObjFrame object[0] 0
	if !flag[2369] && flag[2353]:
		ObjFlagsUnset object[0] 0x0010
		ObjFrame object[0] 0
	LookPointFlagsSet look_point[0] 0x0001
	if !flag[3089] && flag[3074]:
		LookPointFlagsUnset look_point[0] 0x0001
	elif flag[2369] && !flag[2560] && !flag[2450]:
		LookPointFlagsUnset look_point[0] 0x0001
	elif !flag[2369] && flag[2353]:
		LookPointFlagsUnset look_point[0] 0x0001
	if system[4] >= 5:
		EntranceSetDisabled entrance[0] 0
		EntranceSetDisabled entrance[13] 1
	else:
		EntranceSetDisabled entrance[0] 1
		EntranceSetDisabled entrance[13] 0
	if flag[2848] && !flag[2858] | flag[2369] && system[4] == 1:
		ED7_76_0 object[255] "hikari00_add" 1
		ED7_76_0 object[255] "hikari01_add" 1
		SoundPlay sound[128] 1 50 0
	if !flag[3385] && flag[3370]:
		MapColor 0x00E6D2D2 0ms
		ED7_76_0 object[255] "hikari00_add" 1
		ED7_76_0 object[255] "hikari01_add" 1
	if !flag[3089] && flag[3074] && !QuestFlagsGet quest[142] 0x10:
		if system[0] == 102:
			SoundPlay sound[1020] 1 60 0
		else:
			SoundStop sound[1020]
	if !flag[3089] && flag[3074] && !QuestFlagsGet quest[142] 0x10:
		ObjFlagsUnset object[6] 0x0004
	Return

fn[6]:
	if flag[10]:
		TextStart self
		TextTalk self {
			蓋巴爾先生在議員時代
			曾受到某人的關照，那人好像
			住在西側大道那裡。{wait}
		}
		TextWait
		TextTalk self {
			我記得應該是住在……
			叫做『雷什麼別墅』的
			建築物裡面。{wait}
		}
		TextWait
		TextTalk self {
			如果是那位人士的話，
			也許會知道蓋巴爾先生的行蹤吧。{wait}
		}
		TextWait
		TextEnd self
		Return
	elif QuestFlagsGet quest[142] 0x02 && !QuestFlagsGet quest[142] 0x10 && !QuestFlagsGet quest[142] 0x40 && flag[3249] && !flag[3251]:
		Call fn[0,32]
		Return
	TextStart self
	if flag[3385]:
		if !flag[0]:
			TextTalk self {
				不良組織的孩子們
				協力守護了
				舊市街啊。{wait}
			}
			TextWait
			TextTalk self {
				以前他們常在廣場打架，
				讓人不敢靠近他們，但是
				年輕人果然就是靠得住啊。{wait}
			}
			TextWait
			TextTalk self {
				到了今天，總算感覺到
				舊市街開始團結起來了。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				不良組織的孩子們
				守護著舊市街。
				年輕人果然就是靠得住啊。{wait}
			}
			TextWait
			TextTalk self {
				到了今天，總算感覺到
				舊市街開始團結起來了。{wait}
			}
			TextWait
	elif flag[3371]:
		TextTalk self {
			外面那些藍色霧氣，
			到底是什麼東西啊……？{wait}
		}
		TextWait
		TextTalk self {
			總之我得好好警告
			公寓居民不要
			出去外面才行。{wait}
		}
		TextWait
	elif flag[3089]:
		if !flag[0]:
			TextTalk self {
				我也聽過
				總統的演說了。{wait}
			}
			TextWait
			TextTalk self {
				雖說我聽得懂他的主張……
				但真的已經沒有和平
				解決的辦法了嗎……？{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				雖說我聽得懂總統的主張……{wait}
			}
			TextWait
			TextTalk self {
				但真的沒有和平
				解決的辦法嗎……？{wait}
			}
			TextWait
	elif flag[3074]:
		if !QuestFlagsGet quest[142] 0x10:
			if flag[3251]:
				if flag[3301]:
					TextTalk char[0] {
						充分煮過蔬菜之後，
						就要開始調味了。{wait}
					}
					TextWait
					TextTalk char[0] {
						『強壯苦番茄豬肉湯』……
						你們就好好期待它的味道吧。{wait}
					}
					TextWait
				else:
					TextTalk char[0] {
						好，差不多該準備一下
						發放賑災食物用的容器了。{wait}
					}
					TextWait
					TextTalk char[0] {
						希望今天能順利分送到大家手上啊……{wait}
					}
					TextWait
			else:
				TextTalk char[0] {
					準備賑災食物的工作，
					是在這個房間，還有
					柯洛娜的房間裡進行的。{wait}
				}
				TextWait
				TextTalk char[0] {
					畢竟份量相當大啊。
					不管有幾個廚房
					都不夠用。{wait}
				}
				TextWait
		else:
			TextTalk self {
				呵呵，看到大家津津有味地
				享用豬肉味噌湯的模樣，
				就是最好的回報了。{wait}
			}
			TextWait
			TextTalk self {
				我還得向你們
				說聲謝謝才行啊。{wait}
			}
			TextWait
	elif flag[2861]:
		if !flag[0]:
			TextTalk self {
				昨天傍晚左右，
				很稀奇地來了位訪客
				拜訪蓋巴爾先生……{wait}
			}
			TextWait
			TextTalk self {
				在那之後，蓋巴爾先生的
				樣子就有點怪怪的。{wait}
			}
			TextWait
			TextTalk self {
				他還說過有人
				正在追他之類的……
				嗯，讓我有些擔心他。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				他還說過有人
				正在追他之類的……
				嗯，讓我有些擔心他。{wait}
			}
			TextWait
	elif flag[2848]:
		TextTalk self {
			看來蓋巴爾先生
			對這裡的生活
			也漸漸習慣了啊。{wait}
		}
		TextWait
		TextTalk self {
			呵呵，這是件好事啊。{wait}
		}
		TextWait
	elif flag[2837]:
		if !flag[0]:
			TextTalk self {
				（狼吞虎嚥）……
				蓋巴爾先生的燉豆真是極品啊。{wait}
			}
			TextWait
			TextTalk self {
				呵呵，我本來還想要
				留到晚餐那時，但看來
				馬上就要被吃完了啊。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				但話說回來，蓋巴爾先生能這樣
				逐漸敞開心胸，真是太好了。{wait}
			}
			TextWait
			TextTalk self {
				聽說他在議員時代很高傲，
				看來本性其實是很善良的。{wait}
			}
			TextWait
	elif flag[2832]:
		Call fn[0,7]
	elif flag[2816]:
		if !flag[0]:
			TextTalk self {
				想讓克洛斯貝爾成為國家啊……
				雖然是極為正當的主張，
				不過我覺得有些太急躁了。{wait}
			}
			TextWait
			TextTalk self {
				那兩大國應該也不會
				給好臉色看，
				難以想像事情會和平發展啊……{wait}
			}
			TextWait
			TextTalk self {
				哎呀哎呀，迪塔市長還真是
				做了個大膽的提案啊。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				想讓克洛斯貝爾成為國家啊。
				我實在不覺得事情會和平發展……{wait}
			}
			TextWait
			TextTalk self {
				哎呀哎呀，迪塔市長還真是
				做了個大膽的提案啊。{wait}
			}
			TextWait
	elif flag[2573]:
		if !flag[0]:
			Call fn[0,8]
		else:
			TextTalk self {
				嗯、嗯，原來如此。{wait}
			}
			TextWait
			TextTalk self {
				的確，如果發生過那種事，
				就算禁不起誘惑
				也沒什麼好奇怪的了。{wait}
			}
			TextWait
	elif flag[2564]:
		if !flag[0]:
			TextTalk self {
				揭幕儀式啊……鎮上可是起了
				好大的騷動啊。{wait}
			}
