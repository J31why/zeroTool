fn[5]:
	ED7_F2 1
	SystemFlagsSet 0x08000000
	if !flag[3935]:
		SoundPlay sound[14] 0 100 0
		ED7_74 object[15] 0 30
		ED7ObjPlay object[15] 0 30 0 0
		Sleep 500ms
		if ItemAdd item[856] 1:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextSetName ""
			TextMessage name[742] {
				{color 0}已取得{item[856]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			TextSetPos -1 280 60 3
			FadeIn 300ms 0x00000000
			FlagSet flag[3935]
			ED7_DE 5
		else:
			FadeOut 300ms 0x00000000 100
			TextSetName ""
			TextMessage name[742] {
				寶箱裡裝有{item[856]}{color 0}。
				因持有物品已達上限，已放棄{item[856]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			SoundPlay sound[15] 0 100 0
			ED7ObjPlay object[15] 30 0 0 0
	else:
		FadeOut 300ms 0x00000000 100
		TextSetPos -1 -1 -1 -1
		TextSetName ""
		TextMessage name[742] {
			{0x06}{color 5}寶箱裡什麼都沒有。{color 0}{wait}
		}
		TextWait
		TextClose 0
		FadeIn 300ms 0x00000000
	Sleep 30ms
	TextEnd null
	SystemFlagsUnset 0x08000000
	Return

fn[6]:
	TextStart self
	if !flag[0]:
		TextTalk self {
			聽說明天在蘭花塔
			要召開一個叫做
			通商會議的東西。{wait}
		}
		TextWait
		TextTalk self {
			雖然不懂那是什麼，
			不過機會難得，我打算
			找安里他們一起去看熱鬧。{wait}
		}
		TextWait
		TextTalk self {
			嘿嘿，一定很有意思，
			我猜是什麼派對吧。
			真期待明天的來臨～♪{wait}
		}
		TextWait
		FlagSet flag[0]
	else:
		TextTalk self {
			那個通商會議啊，我猜
			大概是什麼派對吧？{wait}
		}
		TextWait
		TextTalk self {
			嘿嘿，真期待明天的來臨～{wait}
		}
		TextWait
	TextEnd self
	Return

fn[7]:
	TextStart self
	if !flag[1]:
		TextTalk self {
			喔喔……
			感光結晶迴路
			好像已經用完了。{wait}
		}
		TextWait
		TextTalk self {
			我在白天的揭幕儀式
			好像拍太多張照片了。{wait}
		}
		TextWait
		TextTalk self {
			我得在導力商店關門之前，
			趕緊去買新的回來。{wait}
		}
		TextWait
		FlagSet flag[1]
	else:
		TextTalk self {
			我得在導力商店關門之前，
			趕緊去買新的
			感光結晶迴路回來。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[8]:
	TextStart self
	TextTalk self {
		在咖啡廳看書看到入迷，
		竟然已經這麼晚了。{wait}
	}
	TextWait
	TextTalk self {
		（發抖！）……
		入夜後果然很冷啊。
		還是快點回家，以免感冒吧。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[9]:
	TextStart self
	if flag[2568]:
		if !flag[2]:
			TextTalk self {
				辛苦您了。{wait}
			}
			TextWait
			TextTalk self {
				通商會議期間為了加強警備，
				所以目前正在實行夜間行車管制。{wait}
			}
			TextWait
			TextTalk self {
				如果要開車到市外，
				目前需要申請許可。{wait}
			}
			TextWait
			TextTalk name[9] {
				#00604F警備工作辛苦了。
				希望你照這個樣子繼續努力。{wait}
			}
			TextWait
			Emote self 0mm 2000mm 2 7 80ms 1
			SoundPlay sound[28] 0 100 0
			Sleep 1000ms
			TextTalk self {
				達德利搜查官！{wait}
			}
			TextWait
			TextTalk self {
				您正在執行任務嗎？
				真是辛苦您了！{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			TextTalk self {
				目前尚未發現
				任何可疑的車輛。{wait}
			}
			TextWait
			TextTalk self {
				這裡請交給我負責吧。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[10]:
	TextStart null
