		else:
			Call fn[0,26]
		Return
	if QuestFlagsGet quest[108] 0x02 && !QuestFlagsGet quest[108] 0x10 && !QuestFlagsGet quest[108] 0x40 && !flag[2443] && flag[2453]:
		Call fn[0,22]
		Return
	TextStart char[2]
	if !flag[2468]:
		Call fn[0,6]
	else:
		var[0] = 99
		while var[0] == 99:
			FadeOut 300ms 0x00000000 100
			Menu menu[0] -1 -1 1
				"交談" // 0
				"兌換" // 1
				"放棄" // 2
			MenuWait var[0]
			if var[0] != 1:
				MenuClose menu[0]
				FadeIn 300ms 0x00000000
				FadeWait
			if var[0] == 1:
				ShopOpen shop[180]
				var[0] = 99
			elif var[0] != 0:
			elif var[0] == 0:
				var[0] = 99
				Call fn[0,6]
	TextEnd char[2]
	Return

fn[6]:
	if flag[3089]:
	elif flag[3074]:
	elif flag[2861]:
