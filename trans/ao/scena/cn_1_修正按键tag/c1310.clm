		if !flag[2]:
			TextTalk char[2] {
				越接觸導力網路，
				就越能夠發現
				它的魅力呢。{wait}
			}
			TextWait
			TextTalk char[2] {
				雖然可琳娜說
				導力遊戲最棒，不過
				我最中意的是天氣預報。{wait}
			}
			TextWait
			TextTalk char[2] {
				雖然還不是百分之百準確，
				不過還是蠻準的，
				我每天看的時候都很佩服呢。{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			TextTalk char[2] {
				導力網路上播放的
