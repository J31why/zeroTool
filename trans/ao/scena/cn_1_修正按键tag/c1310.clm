		if !flag[1]:
			TextTalk self {
				明天下午，
				共和國總統預定
				要來ＩＢＣ大樓視察。{wait}
			}
			TextWait
			TextTalk self {
				因為這樣，我們保安部也預定
				幾乎全員出動負責警戒。{wait}
			}
			TextWait
			TextTalk self {
				……我現在就莫名其妙地緊張起來了。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				明天下午，
				共和國總統預定
				要來ＩＢＣ大樓視察。{wait}
			}
			TextWait
			TextTalk self {
				一想到當天的警備……
				現在就莫名其妙地緊張起來了。{wait}
			}
			TextWait
	elif flag[2369]:
		if !flag[1]:
			TextTalk self {
				迪塔市長和
				瑪利亞貝爾小姐
				現在似乎比以前忙很多呢。{wait}
			}
			TextWait
			TextTalk self {
				不過，他們兩位即使這麼忙，
				還是不會忘記關心
				周遭的事物和笑容。{wait}
			}
			TextWait
			TextTalk self {
				我覺得他們真的很厲害。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				換做是我，
				只要一忙起來就絕對
				顧慮不到周圍的事。{wait}
			}
			TextWait
			TextTalk self {
				光看這點，
				就知道他們兩位有多麼厲害了。{wait}
			}
			TextWait
	elif flag[2353]:
		if !flag[1]:
			TextTalk self {
				您好。
				歡迎光臨克洛斯貝爾國際銀行。{wait}
			}
			TextWait
			TextTalk self {
				我雖然是保全人員，
				不過還是可以為您做簡單的介紹。
				請問今天要辦什麼事呢？{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				您好。
				歡迎光臨克洛斯貝爾國際銀行。{wait}
			}
			TextWait
			TextTalk self {
				如果是各種銀行手續，
				正面和右方的櫃檯
				都能為您服務。{wait}
			}
			TextWait
	TextEnd self
	Return

