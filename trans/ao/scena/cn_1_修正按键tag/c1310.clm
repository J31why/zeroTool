		CharFlagsSet char[1] 0x0080
		CharFlagsSet char[4] 0x0080
		CharFlagsSet char[2] 0x0080
		CharFlagsSet char[3] 0x0080
	elif flag[2560]:
		CharFlagsUnset char[5] 0x0080
		CharFlagsSet char[3] 0x0010
		CharFlagsSet char[5] 0x0010
	elif flag[2369]:
		CharFlagsSet char[4] 0x0080
		if !flag[3]:
			CharFlagsSet char[3] 0x0010
		if QuestFlagsGet quest[108] 0x02 && flag[2443]:
			CharFlagsUnset char[6] 0x0080
	elif flag[2353]:
	if flag[273]:
		FlagUnset flag[273]
		CharSetPos field_party[0] (60, 300, 28550) 0deg
	if QuestFlagsGet quest[108] 0x02 && !QuestFlagsGet quest[108] 0x10 && !QuestFlagsGet quest[108] 0x40 && !flag[2453]:
		SystemFlagsSet 0x10000000
		Event fn[0,16]
	if flag[2849] && !flag[2850]:
		SystemFlagsSet 0x10000000
		Event fn[0,23]
	Return

fn[2]:
	SoundPlay sound[160] 0 100 0
	Return

fn[3]:
	if flag[2848] && !flag[2858] | flag[2369] && system[4] == 1:
		ED7_76_0 object[255] "wlight_add" 1
		ED7_76_0 object[255] "ylight_add" 1
		SoundPlay sound[128] 1 50 0
	if ItemHas item[804] 0 >= 1:
		TriggerFlagsSet trigger[0] 0x0080
