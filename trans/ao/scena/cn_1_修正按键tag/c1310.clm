fn[4]:
	Call fn[0,5]
	Return

fn[5]:
	if QuestFlagsGet quest[135] 0x02 && !QuestFlagsGet quest[135] 0x10 && !QuestFlagsGet quest[135] 0x40 && !flag[3004] && flag[3003]:
		Call fn[0,29]
		Return
	if QuestFlagsGet quest[122] 0x02 && !QuestFlagsGet quest[122] 0x10 && !QuestFlagsGet quest[122] 0x40 && flag[2573] && !flag[2592] && !flag[2744]:
		if !flag[3633]:
