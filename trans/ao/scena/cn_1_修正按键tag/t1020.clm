fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharIdle self (-2750, null, 1550) (2750, null, -450) 1000mm/s
		Sleep 300ms
	Return

fn[2]:
	if flag[2608]:
		CharFlagsSet char[0] 0x0080
	elif flag[2607]:
	elif flag[2605]:
	elif flag[2604]:
	elif flag[2602]:
		CharFlagsUnset char[2] 0x0080
		CharFlagsUnset char[3] 0x0080
		CharSetChipBase char[3] chip[6]
		CharSetChipPattern char[3] 0
		ForkQuit char[3] fork[0]
		CharFlags2Set char[3] 0x0004
		CharFlagsSet char[3] 0x0010
		CharSetChipPattern char[3] 2
		CharFlagsUnset char[5] 0x0080
		CharSetChipBase char[5] chip[8]
		CharSetChipPattern char[5] 0
		ForkQuit char[5] fork[0]
		CharFlags2Set char[5] 0x0004
		CharFlagsSet char[5] 0x0010
		CharSetChipPattern char[5] 1
		CharFlagsUnset char[6] 0x0080
		CharFlagsUnset char[7] 0x0080
	elif flag[2601]:
		CharFlagsUnset char[2] 0x0080
		CharFlagsUnset char[3] 0x0080
		CharSetChipBase char[3] chip[6]
		CharSetChipPattern char[3] 0
		ForkQuit char[3] fork[0]
		CharFlags2Set char[3] 0x0004
		CharFlagsUnset char[5] 0x0080
		CharSetChipBase char[5] chip[8]
		CharSetChipPattern char[5] 0
		ForkQuit char[5] fork[0]
		CharFlags2Set char[5] 0x0004
		CharFlagsUnset char[6] 0x0080
		CharFlagsUnset char[7] 0x0080
		if !flag[3]:
			CharFlagsSet char[6] 0x0010
			CharFlagsSet char[7] 0x0010
	elif flag[2600]:
	elif flag[2597]:
		CharFlagsUnset char[1] 0x0080
		CharFlagsUnset char[3] 0x0080
		CharSetPos char[3] (26870, 0, 10210) 180deg
		CharFlagsUnset char[4] 0x0080
	elif flag[2592]:
	if flag[272]:
		FlagUnset flag[272]
		Event fn[0,13]
	elif flag[273]:
		FlagUnset flag[273]
		CharSetPos field_party[0] (28500, 0, 8080) 270deg
	Return

fn[3]:
	if flag[3385]:
		system[1] = 563
	TriggerFlagsSet trigger[0] 0x0080
	if flag[3357] && !flag[3358]:
		TriggerFlagsUnset trigger[0] 0x0080
	if flag[3356] && !flag[3361]:
		EntranceSetFunc entrance[5] fn[0,45]
	if flag[2601] && !flag[2602]:
		if !flag[2774]:
			EntranceSetFunc entrance[1] fn[0,38]
			EntranceSetFunc entrance[6] fn[0,39]
			EntranceSetFunc entrance[9] fn[0,40]
		else:
			EntranceSetFunc entrance[6] fn[0,39]
			EntranceSetFunc entrance[9] fn[0,40]
	LookPointFlagsSet look_point[0] 0x0001
	LookPointFlagsSet look_point[1] 0x0001
	LookPointFlagsSet look_point[2] 0x0001
	LookPointFlagsSet look_point[3] 0x0001
	LookPointFlagsSet look_point[4] 0x0001
	if flag[3072]:
		ObjFlagsUnset object[6] 0x0004
		ObjFlagsUnset object[1] 0x0010
		ObjFlagsUnset object[5] 0x0010
		ObjFlagsUnset object[2] 0x0010
		ObjFlagsUnset object[3] 0x0010
		LookPointFlagsUnset look_point[0] 0x0001
		LookPointFlagsUnset look_point[1] 0x0001
		LookPointFlagsUnset look_point[2] 0x0001
		LookPointFlagsUnset look_point[3] 0x0001
		LookPointFlagsUnset look_point[4] 0x0001
		if flag[3355]:
			ObjFlagsSet object[6] 0x0004
			LookPointFlagsSet look_point[1] 0x0001
		if flag[3355] && !flag[3361]:
			ObjFlagsSet object[1] 0x0010
			LookPointFlagsSet look_point[0] 0x0001
	TriggerFlagsSet trigger[1] 0x0080
	if flag[3356] && !flag[3385]:
		TriggerFlagsUnset trigger[1] 0x0080
		EntranceSetFunc entrance[0] fn[0,47]
	if flag[3358] && !flag[3361]:
		Call fn[0,35]
	if flag[3357] && !flag[3361]:
		if system[0] == 102 | system[0] == 108 | system[0] == 109:
			SoundPlayContinuously sound[110] (91010, 0, 27840) 70000 50000 100 0
		elif system[0] == 100 | system[0] == 101 | system[0] == 103 | system[0] == 104 | system[0] == 105 | system[0] == 106 | system[0] == 107:
			SoundPlay sound[110] 1 10 0
	Return

fn[4]:
	if !flag[2602] && flag[2601] && !flag[2774]:
		Call fn[0,37]
		Return
	TextStart self
	if flag[2605]:
	elif flag[2602]:
		if !flag[0]:
			TextTalk char[0] {
				那家會員制的珠寶店
				我也很常去。{wait}
			}
			TextWait
			TextTalk char[0] {
				那裡很安靜，平常不會有觀光客
				進去，所以我很喜歡，不過……{wait}
			}
			TextWait
			TextTalk char[0] {
				今天客人好像比平常多，
				我看等一下再來好了。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				那家會員制的珠寶店
				我也很常去。{wait}
			}
			TextWait
			TextTalk char[0] {
				今天客人好像比平常多，
				我看等一下再來好了。{wait}
			}
			TextWait
	elif flag[2601]:
		if !flag[2774]:
		else:
			TextTalk char[0] {
				剛剛那位女孩
				好像走向了別墅區。{wait}
			}
			TextWait
			TextTalk char[0] {
				她實在好可愛……
				不知道是哪戶人家的千金。{wait}
			}
			TextWait
	elif flag[2597]:
		if !flag[0]:
			TextTalk char[0] {
				我丈夫在前面的別墅區
				有棟房子。{wait}
			}
			TextWait
			TextTalk char[0] {
				手邊沒工作的時候，
				就會像今天這樣來這邊渡假。{wait}
			}
			TextWait
			TextTalk char[0] {
				這裡和吵雜熱鬧的克洛斯貝爾不同，
				真的能讓人好好放鬆下來。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				我很常來
				前面那個別墅區。{wait}
			}
			TextWait
			TextTalk char[0] {
				這裡和吵雜熱鬧的克洛斯貝爾不同，
				真的能讓人好好放鬆下來。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[5]:
	TextStart self
	if flag[2605]:
	elif flag[2602]:
	elif flag[2601]:
	elif flag[2597]:
		TextTalk char[1] {
			呵呵，每道菜看來都很好吃。
			中午就在這裡用餐吧。{wait}
		}
		TextWait
		TextTalk char[1] {
			難得來到米修拉姆，
			當然也要吃得奢侈點才行。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[6]:
	TextStart self
	if flag[2605]:
	elif flag[2602]:
		TextTalk char[2] {
			米修拉姆能逛的地方太多，
			真的是讓人眼花撩亂，
			到處都想逛啊。{wait}
		}
		TextWait
		TextTalk char[2] {
			呵呵，這讓我有種
			變年輕的感覺呢。{wait}
		}
		TextWait
	elif flag[2601]:
		if !flag[1]:
			TextTalk char[2] {
				嗯？女孩？{wait}
			}
			TextWait
			TextTalk char[2] {
				聽你這麼一說，我好像有看到
				她在商店街一個人走在路上……{wait}
			}
			TextWait
			TextTalk char[2] {
				至於往哪裡走，我就不清楚了。
				真是不好意思。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk char[2] {
				我好像有看到一位女孩
				在商店街一個人走在路上……{wait}
			}
			TextWait
			TextTalk char[2] {
				至於往哪裡走，我就不清楚了。
				真是不好意思。{wait}
			}
			TextWait
	elif flag[2597]:
	TextEnd self
	Return

fn[7]:
	TextStart self
	if flag[2605]:
	elif flag[2602]:
		TextTalk char[3] {
			啊，喂喂。
			你幹麼一臉愛睏的樣子啊？{wait}
		}
		TextWait
		TextTalk char[3] {
			還有很多好玩的地方喔。
			好啦，快打起精神來！{wait}
		}
		TextWait
	elif flag[2601]:
		if !flag[2]:
			TextTalk char[3] {
				咦？你問我有沒有看到
				一位綠色頭髮的女孩經過？{wait}
			}
			TextWait
			TextTalk char[3] {
				嗯，我是沒看到啦。
				和家人一起的小孩倒是看到很多。{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			TextTalk char[3] {
				不好意思，我沒看到
				什麼綠色頭髮的女孩喔。{wait}
			}
			TextWait
			TextTalk char[3] {
				要不要去其他地方找找？{wait}
			}
			TextWait
	elif flag[2597]:
		TextTalk char[3] {
			聽說今天上午
			湖畔沙灘被整個包下來了耶。{wait}
		}
		TextWait
		TextTalk char[3] {
			真是讓人超羨慕的，我也好想
			把那裡包下來悠閒地渡假喔～{wait}
		}
		TextWait
	TextEnd self
	Return

fn[8]:
	TextStart self
	if flag[2605]:
	elif flag[2602]:
	elif flag[2601]:
	elif flag[2597]:
		TextTalk char[4] {
			說到米修拉姆，當然
			主題樂園是非玩不可的啦。{wait}
		}
		TextWait
		TextTalk char[4] {
			雖然入場費不便宜，
			但我認為絕對值回票價。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[9]:
	TextStart self
	if flag[2605]:
	elif flag[2602]:
		TextTalk char[5] {
			早上在主題樂園
			玩得好累啊……{wait}
		}
		TextWait
		TextTalk char[5] {
			拜託先讓我睡一下。
			唔呀唔呀……{wait}
		}
		TextWait
	elif flag[2601]:
		TextTalk char[5] {
