fn[10]:
	TextStart self
	if flag[2605]:
	elif flag[2601]:
		if !flag[3]:
			Call fn[0,11]
		else:
			TextTalk char[6] {
				珍妮塔最近參加了聯誼，但沒能
				找到好對象，我看她有些沮喪，
				所以就鼓起勇氣找她一起來。{wait}
			}
			TextWait
			TextTalk char[6] {
				……好，我得先和店家討論一下，
				做些準備了。{wait}
			}
			TextWait
	elif flag[2597]:
	TextEnd self
	Return

fn[11]:
