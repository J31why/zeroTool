			TextClose 0
			FadeIn 300ms 0x00000000
			FadeWait
			_59
			TextSetPos -1 280 60 3
	TextEnd null
	Return

fn[5]:
	TextStart self
	if flag[3089]:
		if flag[3090] && QuestFlagsGet quest[137] 0x10 && !QuestFlagsGet quest[149] 0x10:
			TextTalk self {
				尼爾森似乎
				有來為蓋掃墓呢。{wait}
			}
			TextWait
			TextTalk self {
				他最近似乎在調查
				蓋的事件，不過……
				調查有進展嗎？{wait}
			}
			TextWait
		else:
			TextTalk self {
				成為獨立國家……
				那究竟會為克洛斯貝爾帶來什麼呢……？{wait}
			}
			TextWait
			TextTalk self {
				……希望長眠於此地的人們
				能夠守護我們。{wait}
			}
			TextWait
	elif flag[3074]:
		if !flag[0]:
			TextTalk self {
				剛才亞里歐斯有來這裡。
				他也有來跟我打招呼。{wait}
			}
			TextWait
			TextTalk self {
				雖然不再像以前一樣
				一起喝酒，不過……{wait}
			}
			TextWait
			TextTalk self {
				他也沒有變呢。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				直到現在，
				亞里歐斯到墓地的時候
				還是會過來打招呼。{wait}
			}
			TextWait
			TextTalk self {
				他也沒有變呢。{wait}
			}
			TextWait
	elif flag[2861]:
		TextTalk self {
			聽說警備隊在山道上
			死傷慘重。{wait}
		}
		TextWait
		TextTalk self {
			……我實在無法忍受
			那些前途無量的年輕人
			就這樣喪失生命。{wait}
		}
		TextWait
	elif flag[2848]:
		if !flag[0]:
			TextTalk self {
				在風雨吹打之下，
				刻在墓碑上的銘文也會
				一點一點風化消失。{wait}
			}
			TextWait
			TextTalk self {
				許多墓碑的存在
				就這樣逐漸被人們遺忘……{wait}
			}
			TextWait
			TextTalk self {
				為了不讓事情變成如此，
				像我這樣的守墓人也有必要存在。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				經歷長年的風雨吹打，
				墓碑上的銘文逐漸風化之後，就連
				其存在本身也會被人們遺忘……{wait}
			}
			TextWait
			TextTalk self {
				為了不讓事情變成如此，
				像我這樣的守墓人也有必要存在。{wait}
			}
			TextWait
	elif flag[2837]:
		if !flag[0]:
			TextTalk self {
				蓋他跟兒時玩伴有婚約，
				未來才正要開始的時候就殉職了。{wait}
			}
			TextWait
			TextTalk self {
				亞里歐斯則因為意外
				失去了妻子的生命及愛女的眼睛。{wait}
			}
			TextWait
			TextTalk self {
				為了他人跟克洛斯貝爾
				盡心盡力的他們，
				居然會遇到如此不幸……{wait}
			}
			TextWait
			TextTalk self {
				……真讓人無法接受。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				蓋跟亞里歐斯
				為了他人跟克洛斯貝爾，
				比任何人都還要盡心盡力。{wait}
			}
			TextWait
			TextTalk self {
				這樣的他們居然會遭遇不幸……
				真讓人無法接受。{wait}
			}
			TextWait
	elif flag[2832]:
		if !flag[0]:
			TextTalk self {
				亞里歐斯現在是名人了，
				他當年也曾經被蓋拉著
				跟我們一起喝酒。{wait}
			}
			TextWait
			TextTalk self {
				那傢伙很節制。
				總是用若無其事的表情
				看我跟蓋喝醉。{wait}
			}
			TextWait
			TextTalk self {
				呵呵，真想看一次
				他喝醉酒的模樣呢。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				以前，亞里歐斯偶爾也會
				被蓋拉著到這裡
				跟我們一起喝酒。{wait}
			}
			TextWait
			TextTalk self {
				因為他是個節制的傢伙，
				所以不會像我跟蓋
				一樣喝醉。{wait}
			}
			TextWait
	elif flag[2831]:
		if !flag[0]:
			TextTalk self {
				你們現在要掃墓嗎？{wait}
			}
			TextWait
			TextTalk self {
				晚上這裡會有點冷。
				早點掃完會比較好喔。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				因為這裡地勢高，
				所以晚上會有點冷。{wait}
			}
			TextWait
			TextTalk self {
				早點掃完會比較好喔。{wait}
			}
			TextWait
	elif flag[2829]:
	elif flag[2816]:
	elif flag[2573]:
		if !flag[0]:
			TextTalk self {
				《克洛斯貝爾問題》
				在被如此稱呼之前，
				就已經存在這裡許久了。{wait}
			}
			TextWait
			TextTalk self {
				被捲入帝國及共和國
				不斷反覆的紛爭，
				喪失了數不盡的生命。{wait}
			}
			TextWait
			TextTalk self {
				我雖然托蓋的福
				克服了這份悲傷，不過……
				還有許多人至今依然哀痛逾恆吧。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				剛才過來的利貝爾公主，
				對《克洛斯貝爾問題》的痛苦
				能感同身受。{wait}
			}
			TextWait
			TextTalk self {
				雖然她還很年輕，不過我覺得
				她是位充滿慈悲與關愛的女性。{wait}
			}
			TextWait
	elif flag[2564]:
		if !flag[0]:
			Call fn[0,7]
		else:
			TextTalk self {
				嗯，沒想到
				尼爾森居然回來了。{wait}
			}
			TextWait
			TextTalk self {
				來吧，今晚就讓我
				聽你多聊聊吧。{wait}
			}
			TextWait
	elif flag[2560]:
	elif flag[2369]:
		if !flag[2462]:
			Call fn[0,11]
		else:
			TextTalk self {
				來自諾森比亞啊……
				那孩子肯定也吃了很多苦吧。{wait}
			}
			TextWait
			TextTalk self {
				畢竟不能請小孩喝酒，
				在他下次來玩時，
				我可得準備一些茶點呢。{wait}
			}
			TextWait
	elif flag[2368]:
		if !flag[2476]:
			Call fn[0,6]
		elif !flag[0]:
			TextTalk self {
				蓋死了之後，
				我喝酒的量也減少許多。{wait}
			}
			TextWait
			TextTalk self {
				失去合得來的酒友，
				果然很寂寞呢。{wait}
			}
			TextWait
			TextTalk name[82] {
				#01108F爺爺……{wait}
			} {
				#01100F……等琪雅長大之後，
				會跟羅伊德他們一起來陪你喝酒！{wait}
			}
			TextWait
			CharTurnToChar self name[82] 500deg/s
			TextTalk self {
				哈哈，這樣啊。
				我會很期待
				那時候到來。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				呵呵，等妳長到
				可以喝酒的年紀時，
				應該也是個大美女吧。{wait}
			}
			TextWait
			TextTalk self {
				我會盡量活久一點，
				並且期待
				那時候到來。{wait}
			}
			TextWait
	elif flag[2367]:
	elif flag[2353]:
	TextEnd self
	Return

fn[6]:
	_Char4A char[0] 255
	CharTurnToChar char[0] name[0] 0deg/s
	Emote char[0] 0mm 2000mm 38 38 250ms 1
	Sleep 1000ms
	TextTalk char[0] {
		喔喔，你是羅伊德……
		好久不見了。{wait}
	}
	TextWait
	TextTalk char[0] {
		你什麼時候回來的？{wait}
	}
	TextWait
	TextTalk name[0] {
		#00000F嗯，前陣子剛回來。
		別來無恙。{wait}
	}
	TextWait
	TextTalk name[8] {
		#10105F羅伊德，這位先生是……？{wait}
	}
	TextWait
	if QuestFlagsGet quest[46] 0x10:
		TextTalk name[1] {
			#00100F呵呵，是我們之前
			透過委託認識的人喔。{wait}
		}
		TextWait
	TextTalk name[0] {
		#00000F嗯……
		這位是昆特，
		跟我大哥是酒友。{wait}
	} {
		#00004F他對我這個弟弟也很好。
		在教團事件之後，我們一起喝酒時，
		他也告訴了我很多以前的事情。{wait}
	}
	TextWait
	TextTalk char[0] {
		那個時候真的很開心。{wait}
	}
	TextWait
	TextTalk char[0] {
		不過，羅伊德酒量比不上蓋，
		所以有點無聊呢。{wait}
	}
	TextWait
	TextTalk name[0] {
		#00012F哈哈……不好意思。{wait}
	}
	TextWait
	TextTalk name[1] {
		#00100F呵呵，那個時候
		我們也在場。{wait}
	} {
		#00109F只有未成年的緹歐喝果汁，
		她似乎感到很不滿呢。{wait}
	}
	TextWait
	TextTalk name[4] {
		#10302F呵呵，原來如此。{wait}
	} {
		#10304F嗯，我們今後
		也要請你多關照了，老先生。{wait}
	}
	TextWait
	TextTalk char[0] {
		嗯，如果是羅伊德的同事，我很歡迎喔。{wait}
	}
	TextWait
	TextTalk char[0] {
		平常我負責管理這塊墓地。
		歡迎你們隨時過來。{wait}
	}
	TextWait
	_Char4B char[0] 255
	FlagSet flag[2476]
	Return

fn[7]:
	_Char4A char[1] 255
	_Char4A char[0] 255
	TextTalk char[0] {
