	TextTalk name[9] {
		#1000060030V#12P#00600F──馬克萊因。
		六年前這裡也只有
		這種貨色的小嘍囉出沒嗎？{wait}
	}
	TextWait
	CharTurnToChar name[7] name[9] 500deg/s
