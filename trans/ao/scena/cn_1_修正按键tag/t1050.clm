					}
					TextWait
					TextTalk char[0] {
						兩位是不是
						也差不多該出發了呢？{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[0] {
						剛才您的同伴
						先行外出了。{wait}
					}
					TextWait
					TextTalk char[0] {
						兩位是不是
						也差不多該出發了呢？{wait}
					}
					TextWait
			elif flag[2601]:
				if !flag[0]:
					TextTalk char[0] {
						剛才琪雅小姐一個人
