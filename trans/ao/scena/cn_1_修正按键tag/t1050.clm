					}
					TextWait
					TextTalk name[0] {
						#00000F嗯，非常舒適。{wait}
					}
					TextWait
					TextTalk char[0] {
						那真是太好了。{wait}
					}
					TextWait
					TextTalk char[0] {
						如果有什麼招呼不周的地方，
