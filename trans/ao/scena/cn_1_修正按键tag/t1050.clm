	Return

fn[7]:
	TextStart char[0]
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"交談" // 0
			"休息" // 1
			"放棄" // 2
		MenuWait var[0]
		if var[0] != 1:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			ShopOpen shop[100]
			var[0] = 99
		elif var[0] == 0:
			var[0] = 99
			if flag[3385]:
				if !flag[0]:
					TextTalk char[0] {
						鎮上的騷動也平息了，
						現在大家在飯店待命觀察情況。{wait}
					}
					TextWait
					TextTalk char[0] {
						說起來，那謎樣的青白色的大樹……
						這麼近一看更覺得詭異。{wait}
					}
					TextWait
					TextTalk char[0] {
						雖然我也很清楚，但目前要繼續
						米修拉姆的營運恐怕很難了。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[0] {
						米修拉姆要重新營運應該還要一陣子……
						但各位難得來了。{wait}
					}
					TextWait
					TextTalk char[0] {
						需要休息時，
						請儘管吩咐。{wait}
					}
					TextWait
			elif flag[3089]:
				if !flag[0]:
					Emote char[0] 0mm 2000mm 38 38 250ms 1
					Sleep 1000ms
					TextTalk char[0] {
						哦，羅伊德先生……
						您來啦。{wait}
					}
					TextWait
					TextTalk char[0] {
						本飯店雖然歇業中，
						但隨時準備好
						能讓客人入住。{wait}
					}
					TextWait
					TextTalk char[0] {
						需要休息時，請儘管吩咐。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[0] {
						嗯，話說回來，
						為什麼會有那樣的鐘聲……？{wait}
					}
					TextWait
					TextTalk char[0] {
						ＭＷＬ應該也歇業了……
						真是奇怪。{wait}
					}
					TextWait
			elif flag[2605]:
			elif flag[2602]:
				if !flag[2775]:
					TextTalk char[0] {
						哦，是羅伊德先生和琪雅小姐。
						歡迎兩位回來。{wait}
					}
					TextWait
					TextTalk char[0] {
						你們有碰到面，真是太好了。{wait}
					}
					TextWait
					TextTalk name[82] {
						#01110F耶嘿嘿，我回來了～{wait}
					}
					TextWait
					TextTalk name[0] {
						#00002F哈哈，讓你擔心了，真不好意思。{wait}
					}
					TextWait
					TextTalk char[0] {
						不不不，您太客氣了……{wait}
					}
					TextWait
					TextTalk char[0] {
						對了，剛才您的同伴
						似乎外出去了。{wait}
					}
					TextWait
					TextTalk char[0] {
						說是等各自的事情辦妥後，
						就到說好的地方集合……
						您是否要趕快前去呢？{wait}
					}
					TextWait
					TextTalk name[0] {
						#00004F好的，
						謝謝你告訴我。{wait}
					} {
						#00000F那麼，
						我們把事情辦好之後，
						就去主題樂園吧。{wait}
					}
					TextWait
					TextTalk name[82] {
						#01109F嗯，Ｌｅｔ‘ｓ　ｇｏ！{wait}
					}
					TextWait
					FlagSet flag[2775]
				elif !flag[0]:
					TextTalk char[0] {
						剛才您的同伴
						先行外出了。{wait}
					}
					TextWait
					TextTalk char[0] {
						說是等各自的事情辦妥後，
