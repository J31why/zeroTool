fn[8]:
	TextStart self
	if flag[3385]:
		if !flag[1]:
			TextTalk char[1] {
				可能是放很久了，
				灰塵好厚一層。{wait}
			}
			TextWait
			TextTalk char[1] {
				唉……雖然有點怕那棵青白色的樹，
				但也得好好打掃才行。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk char[1] {
				為了隨時能重新營運，
				所以都有定期來打掃……{wait}
			}
			TextWait
			TextTalk char[1] {
				但那棵青白色的樹
				就長在這麼近的地方，
				真讓人不安啊。{wait}
			}
			TextWait
	elif flag[3089]:
		if !flag[1]:
			TextTalk char[1] {
				剛才，升上國防部長的
				那位亞里歐斯先生
				有經過商店街。{wait}
			}
			TextWait
			TextTalk char[1] {
				似乎還帶著
				一位嬌小可愛的女孩……{wait}
			}
			TextWait
			TextTalk name[0] {
				#00001F（亞里歐斯先生和琪雅……
				　看來是來過這了。）{wait}
			}
			TextWait
			TextTalk name[1] {
				#00101F（趕快追上去吧。）{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk char[1] {
				剛才，升上國防部長的
				那位亞里歐斯先生有經過商店街。{wait}
			}
			TextWait
			TextTalk char[1] {
				還帶著一位嬌小可愛的女孩，
				似乎是往主題樂園去了……
				這是什麼情況啊？{wait}
			}
			TextWait
	elif flag[2605]:
	elif flag[2601]:
		if !flag[3]:
			Call fn[0,9]
		else:
			TextTalk self {
				拜託～
				我希望能由我來服務瓦奇先生～！{wait}
			}
			TextWait
			TextTalk self {
				下次請妳吃義式冰淇淋～！{wait}
			}
			TextWait
	elif flag[2597]:
		if !flag[1]:
			CharTurnToChar self name[4] 0deg/s
			TextTalk self {
				咦？客人是……瓦奇先生！？{wait}
			}
			TextWait
			TextTalk self {
				難、難不成
				今天要住在ＶＩＰ樓層的
				客人就是……？{wait}
			}
			TextWait
			TextTalk name[4] {
				#10300F沒錯，我想
				那應該就是指我們。{wait}
			}
			TextWait
			TextTalk self {
				！！！！！！{wait}
			}
			TextWait
			TextTalk self {
				（我、我也太倒楣了……
				　為什麼偏偏今天輪到我
				　負責一般樓層啊！？）{wait}
			}
			TextWait
			TextTalk name[0] {
				#00005F不、不知道她怎麼了，
				好像受了不小的打擊。{wait}
			}
			TextWait
			TextTalk name[4] {
				#10302F呵呵，真是個怪女孩。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				我、我也太倒楣了……
				為什麼偏偏今天輪到我
				負責一般樓層啊！？{wait}
			}
			TextWait
			TextTalk self {
				好不容易有機會
				服務瓦奇先生啊……{wait}
			}
			TextWait
	TextEnd self
	Return

