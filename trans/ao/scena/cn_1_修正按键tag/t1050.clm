fn[3]:
	CharSetChipBase char[4] chip[4]
	CharSetChipPattern char[4] 0
	ForkQuit char[4] fork[0]
	CharFlags2Set char[4] 0x0004
	if flag[3385]:
		CharFlagsUnset char[3] 0x0080
		CharFlagsUnset char[1] 0x0080
		CharFlagsUnset char[2] 0x0080
		CharSetPos char[2] (106130, 0, 11580) 0deg
		ForkFunc char[2] fork[0] fn[0,2]
		CharFlagsUnset char[4] 0x0080
	elif flag[3089]:
		CharFlagsUnset char[3] 0x0080
		CharFlagsUnset char[1] 0x0080
		CharSetPos char[1] (4270, 0, 7670) 90deg
		ForkFunc char[1] fork[0] fn[0,0]
		CharFlagsUnset char[2] 0x0080
		CharSetPos char[2] (5450, 0, 7670) 270deg
		CharFlagsUnset char[4] 0x0080
		if !flag[4]:
			CharFlagsSet char[4] 0x0010
	elif flag[2605]:
	elif flag[2601]:
		ForkFunc char[1] fork[0] fn[0,0]
		CharSetPos char[1] (-100710, 0, 8860) 270deg
		CharFlagsSet char[1] 0x0010
		CharFlagsUnset char[1] 0x0080
		CharFlagsSet char[2] 0x0010
		CharFlagsUnset char[2] 0x0080
	elif flag[2597]:
		CharFlagsUnset char[1] 0x0080
	if flag[272]:
		FlagUnset flag[272]
		Event fn[0,16]
	Return

fn[4]:
