		LookPointFlagsUnset look_point[0] 0x0001
		ObjFlagsUnset object[5] 0x0004
	Return

fn[4]:
	TextStart self
	if !flag[3634]:
		Call fn[0,6]
	elif !flag[2]:
		TextTalk self {
			另外，羅伯茲主任
			現在似乎正在
			愛普斯泰恩財團的樓層忙著。{wait}
		}
		TextWait
		TextTalk self {
			好像在找
			偷了蘭花塔設計圖的
			駭客，不過……{wait}
		}
		TextWait
		TextTalk self {
			駭客為什麼
			要偷這種東西呢？{wait}
		}
		TextWait
		FlagSet flag[2]
	else:
		TextTalk self {
			羅伯茲主任好像在找
			偷了蘭花塔設計圖的駭客，不過……{wait}
		}
		TextWait
		TextTalk self {
			駭客為什麼
			要偷這種東西呢？{wait}
		}
		TextWait
	TextEnd self
	Return

fn[5]:
	TextStart self
	if !flag[3634]:
		Call fn[0,6]
	elif !flag[3]:
		TextTalk self {
			瑪利亞貝爾大小姐
			可真會使喚人，不過……{wait}
		}
		TextWait
		TextTalk self {
			她都將管理系統
			這重責大任交給我了。
			我可要打起精神努力才行。{wait}
		}
		TextWait
		TextTalk self {
			你們是來
			找大小姐
			被偷走的人偶吧？{wait}
		}
		TextWait
		TextTalk self {
			你們
			也要努力啊。{wait}
		}
		TextWait
		FlagSet flag[3]
	else:
		TextTalk self {
			你們是來
			找大小姐
			被偷走的人偶吧？{wait}
		}
		TextWait
		TextTalk self {
			你們
			也要努力啊。{wait}
		}
		TextWait
	TextEnd self
	Return

