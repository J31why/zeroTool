	} {
		#1000050118V#10102F我現在也不是穿著軍服，
		所以稱呼我為『上士』就有點……{wait}
	}
	TextWait
	TextTalk name[0] {
		#1000000197V#6P#00011F啊、嗯，這倒也是。{wait}
	} {
		#1000000198V#00000F不過怎麼樣會比較好呢？
		我可以直呼妳的名字嗎？{wait}
	}
	TextWait
	TextTalkNamed name[8] "諾艾兒上士" {
		#1000050119V#10109F#11P嗯，這樣就可以了。{wait}
	}
	TextWait
	TextTalk name[0] {
		#1000000199V#6P#00009F那麼諾艾兒──
		再一次請妳多多指教囉。{wait}
	} {
		#1000000200V#00002F對了，妳不嫌棄的話，
		妳講話也可以不用那麼拘謹。{wait}
	} {
		#1000000201V畢竟我們同年，而且還是同事，
		我希望妳別那麼拘束。{wait}
	}
	TextWait
	Emote name[8] 0mm 1700mm 2 7 80ms 1
	SoundPlay sound[28] 0 100 0
	Sleep 1000ms
	TextTalk name[8] {
		#1000050120V#10111F#11P咦咦！？
		我對羅伊德警官的語氣嗎！？{wait}
	} {
		#1000050121V#10106F…………
		不行不行，這是沒辦法的！{wait}
	} {
		#1000050122V#10101F我身為警官還只是個新人，
