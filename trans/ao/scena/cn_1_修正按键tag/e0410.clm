		Sleep 300ms
		TextTalk name[0] {
			#1000000271V#00008F#5P（夥伴啊……）{wait}
		} {
			#1000000272V#00003F（老實說，我現在還不認為自己
			　身為男人的格局能和他相稱啊。）{wait}
		} {
			#1000000273V#00000F（為了能真正與他並肩作戰，
			　我還必須要再加把勁……）{wait}
		}
		TextWait
		TextTalk name[8] {
			#1000050161V#12P#10105F……羅伊德？{wait}
		}
		TextWait
		Emote name[0] 0mm 1700mm 38 38 250ms 1
		Sleep 1000ms
		CrossFade 250ms
		CharSetChipBase name[0] chip[30]
		CharSetChipPattern name[0] 0
		CharFlagsUnset name[0] 0x0020
		CharFlagsUnset name[0] 0x0002
		CharFlagsUnset name[0] 0x0010
		FadeWait
		TextTalk name[0] {
			#1000000274V#00005F#5P啊、抱歉。{wait}
		} {
			#1000000275V#00000F這麼說來，從諾艾兒的角度看起來，
			蘭迪是個怎麼樣的人？{wait}
		} {
			#1000000276V不過比起警官時期，
			應該是比較多警備隊員時期吧……{wait}
		}
		TextWait
		TextTalk name[8] {
			#1000050162V#12P#10105F蘭迪學長嗎？{wait}
		} {
			#1000050163V#10104F這個嘛……
			應該還是覺得他難以度量吧。{wait}
		} {
			#1000050164V#10100F自身的戰鬥力不用說，
			聽說他就連部隊層級的戰術
			都相當厲害……{wait}
		} {
			#1000050165V現在正在進行的復健訓練，
			他好像也大顯了一番身手喔！{wait}
		}
		TextWait
		TextTalk name[0] {
			#1000000277V#00002F#5P這樣啊……{wait}
		} {
			#1000000278V#00008F（……這麼說起來，蘭迪他
			　有說過會在這次訓練中
			　使用步槍啊……）{wait}
		} {
			#1000000279V（他是不是對獵兵時代的事情
			　忘懷一些了……？）{wait}
		}
		TextWait
