fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	CharSetChipBase char[0] chip[0]
	CharSetChipPattern char[0] 0
	ForkQuit char[0] fork[0]
	CharFlags2Set char[0] 0x0004
	CharSetChipBase char[1] chip[1]
	CharSetChipPattern char[1] 0
	ForkQuit char[1] fork[0]
	CharFlags2Set char[1] 0x0004
	CharSetChipBase char[2] chip[2]
	CharSetChipPattern char[2] 0
	ForkQuit char[2] fork[0]
	CharFlags2Set char[2] 0x0004
	CharSetChipBase char[3] chip[3]
	CharSetChipPattern char[3] 0
	ForkQuit char[3] fork[0]
	CharFlags2Set char[3] 0x0004
	CharSetChipBase char[4] chip[4]
	CharSetChipPattern char[4] 0
	ForkQuit char[4] fork[0]
	CharFlags2Set char[4] 0x0004
	CharSetChipBase char[5] chip[5]
	CharSetChipPattern char[5] 0
	ForkQuit char[5] fork[0]
	CharFlags2Set char[5] 0x0004
	CharSetChipBase char[6] chip[6]
	CharSetChipPattern char[6] 0
	ForkQuit char[6] fork[0]
	CharFlags2Set char[6] 0x0004
	CharSetChipBase char[7] chip[7]
	CharSetChipPattern char[7] 0
	ForkQuit char[7] fork[0]
	CharFlags2Set char[7] 0x0004
	CharSetChipBase char[9] chip[9]
	CharSetChipPattern char[9] 0
	ForkQuit char[9] fork[0]
	CharFlags2Set char[9] 0x0004
	CharSetChipBase char[10] chip[10]
	CharSetChipPattern char[10] 0
	ForkQuit char[10] fork[0]
	CharFlags2Set char[10] 0x0004
	CharSetChipPattern char[9] 1
	CharFlagsSet char[9] 0x0010
	if flag[272]:
		FlagUnset flag[272]
		Event fn[0,14]
	elif flag[273]:
		FlagUnset flag[273]
		Event fn[0,16]
	elif flag[274]:
		FlagUnset flag[274]
		Event fn[0,17]
	elif flag[275]:
		FlagUnset flag[275]
		Event fn[0,18]
	elif flag[276]:
		FlagUnset flag[276]
		Event fn[0,43]
	elif flag[277]:
		FlagUnset flag[277]
		Event fn[0,44]
	Return

fn[2]:
	ObjFlagsUnset object[0] 0x0010
	ObjFlagsUnset object[1] 0x0010
	TriggerFlagsSet trigger[0] 0x0080
	TriggerFlagsSet trigger[1] 0x0080
	TriggerFlagsSet trigger[3] 0x0080
	TriggerFlagsSet trigger[4] 0x0080
	TriggerFlagsSet trigger[5] 0x0080
	ObjFlagsSet object[6] 0x0004
	if QuestFlagsGet quest[121] 0x02 && (!QuestFlagsGet quest[121] 0x10 && !QuestFlagsGet quest[121] 0x40):
		TriggerFlagsUnset trigger[0] 0x0080
		TriggerFlagsUnset trigger[1] 0x0080
		TriggerFlagsUnset trigger[4] 0x0080
		TriggerFlagsUnset trigger[5] 0x0080
		TriggerFlagsUnset trigger[3] 0x0080
		ObjFlagsSet object[2] 0x0010
		ObjFrame object[2] 0
		if !flag[2743]:
			TriggerFlagsUnset trigger[0] 0x0080
			TriggerFlagsSet trigger[1] 0x0080
			if flag[2758]:
				TriggerFlagsSet trigger[3] 0x0080
			ED7_78 object[3] char[11]
			CharSetPos char[11] (0, 0, -9450) 0deg
			ObjFlagsUnset object[3] 0x0004
			ObjFlagsSet object[3] 0x0002
			CharFlagsUnset char[0] 0x0080
			CharFlagsUnset char[1] 0x0080
			CharFlagsUnset char[2] 0x0080
			CharFlagsUnset char[3] 0x0080
			CharFlagsUnset char[4] 0x0080
			CharFlagsSet char[5] 0x0080
			CharFlagsSet char[6] 0x0080
			CharFlagsSet char[7] 0x0080
			CharFlagsSet char[8] 0x0080
			CharFlagsSet char[9] 0x0080
			CharFlagsSet char[10] 0x0080
		else:
			TriggerFlagsSet trigger[0] 0x0080
			TriggerFlagsUnset trigger[1] 0x0080
			ObjFlagsUnset object[2] 0x0010
			ObjFlagsSet object[2] 0x0002
			ObjFlagsSet object[3] 0x0004
			ObjFlagsUnset object[3] 0x0002
			CharFlagsSet char[0] 0x0080
			CharFlagsSet char[1] 0x0080
			CharFlagsSet char[2] 0x0080
			CharFlagsSet char[3] 0x0080
			CharFlagsSet char[4] 0x0080
			CharFlagsUnset char[5] 0x0080
			CharFlagsUnset char[6] 0x0080
			CharFlagsUnset char[7] 0x0080
			CharFlagsUnset char[8] 0x0080
			CharFlagsUnset char[9] 0x0080
			CharFlagsUnset char[10] 0x0080
	elif QuestFlagsGet quest[129] 0x02 && !QuestFlagsGet quest[129] 0x10 && !QuestFlagsGet quest[129] 0x40:
		ObjFlagsSet object[2] 0x0010
		ForkFunc char[11] fork[3] fn[0,15]
		ObjFlagsSet object[4] 0x0004
		ED7_74 object[5] 0 45
		ED7ObjPlay object[5] 240 0 0 32
	Return

fn[3]:
	TextStart self
	if flag[3665]:
		TextTalk self {
			抱、抱歉，
			請你再等一下好嗎？{wait}
		}
		TextWait
		TextTalk self {
			車票是一定有的。
			我一定會把它找出來的！{wait}
		}
		TextWait
	else:
		Call fn[0,25]
		if flag[3665] && flag[3666] && flag[3667] && flag[3668]:
			Call fn[0,26]
	TextEnd self
	Return

fn[4]:
	TextStart self
	if flag[3666]:
		TextTalk self {
			只要這次商業會議能成功，
			一定能大賺一筆！{wait}
		}
		TextWait
		TextTalk self {
			哦呵呵，真是迫不及待啊！{wait}
		}
		TextWait
	else:
		Call fn[0,24]
		if flag[3665] && flag[3666] && flag[3667] && flag[3668]:
			Call fn[0,26]
	TextEnd self
	Return

fn[5]:
	if flag[3667]:
		TextStart self
		TextTalk self {
			我們今天要
			出發前往在共和國的
			老家一趟。{wait}
		}
		TextWait
		TextTalk self {
			我女兒也很久
			沒看到她祖父母了，
			她現在可開心得很。{wait}
		}
		TextWait
		TextEnd self
	else:
		Call fn[0,23]
		if flag[3665] && flag[3666] && flag[3667] && flag[3668]:
			Call fn[0,26]
	Return

