fn[22]:
	EventBegin 0
	CrossFade 500ms
	CamSetDistance -2120 1000 -1250 0ms
	ED7CamRotate 315deg 25deg 0deg 0ms
	CamPers 500 0ms
	CamZoom 20000 0ms
	CharSetPos field_party[0] (-500, 0, -2100) 270deg
	CharSetPos field_party[1] (-500, 0, -3080) 315deg
	FadeWait
	TextTalk name[0] {
		#00000F不好意思，
		我們是代理安檢官。{wait}
	} {
		可以麻煩你
		將手提行李以及入境申請書
		交給我們檢查一下嗎？{wait}
	}
	TextWait
	TextTalk char[4] {
		……媽媽……{wait}
	}
	TextWait
	if PartyPosition name[1] > -1:
		TextTalk name[1] {
			#00105F（看來他似乎是
			　沒有聽到的樣子。）{wait}
		}
		TextWait
	elif PartyPosition name[2] > -1:
		TextTalk name[2] {
			#00205F（看來他似乎是
			　沒有聽到的樣子。）{wait}
		}
		TextWait
	elif PartyPosition name[3] > -1:
		TextTalk name[3] {
			#00305F（唔，他沒聽見啊。）{wait}
		}
		TextWait
	elif PartyPosition name[8] > -1:
		TextTalk name[8] {
			#10105F（呃……
			　他好像沒有聽到的樣子。）{wait}
		}
		TextWait
	elif PartyPosition name[4] > -1:
		TextTalk name[4] {
			#10302F（呵呵，看來
			　他應該是沒有聽見吧。）{wait}
		}
		TextWait
	TextTalk name[0] {
		#00006F#4S那個，不好意思──{wait}
	}
	TextWait
	Emote char[4] 0mm 1700mm 38 38 250ms 1
	Sleep 1000ms
	field_party[0].5 = char[4].4
	char[4].5 = char[4].4
	CharFlagsUnset char[4] 0x0010
	CharTurnToChar char[4] field_party[0] 0deg/s
	char[4].4 = (char[4].4 + 360) % 360
	char[4].4 = char[4].4 + 360 - char[4].5
	char[4].5 = char[4].4 / 180
	if char[4].4 <= 45 | char[4].4 >= 315 && char[4].4 <= 405 | char[4].4 >= 675:
	elif char[4].5 < 1:
		char[4].8 = 2
	elif char[4].5 > 2:
		char[4].8 = 1
	else:
		char[4].8 = char[4].5
	char[4].4 = field_party[0].5
	field_party[0].5 = 0
	char[4].5 = 0
	CharFlagsSet char[4] 0x0010
	TextTalk char[4] {
		咦，啊……對不起。{wait}
	}
	TextWait
	TextTalk char[4] {
		我稍微發了個呆。{wait}
	}
	TextWait
	TextTalk char[4] {
		呃，是臨檢對吧？
		要麻煩你們檢查了。{wait}
	}
	TextWait
	TextTalk name[0] {
		#00000F好的，那麼我們就馬上開始──{wait}
	}
	TextWait
	FadeOut 500ms 0x00000000 255
	FadeWait
	Sleep 1000ms
	FadeIn 500ms 0x00000000
	FadeWait
	TextTalk name[0] {
		#00004F──手提行李以及入境申請書
		都已經檢查完畢了。
		非常感謝你的配合。{wait}
	}
	TextWait
	TextTalk char[4] {
		啊、不會，不用客氣。{wait}
	}
	TextWait
	FlagSet flag[3668]
	QuestTaskSet quest[121] 5
	CharFlagsUnset char[4] 0x0010
	CharSetChipPattern char[4] 0
	EventEnd 5
	Return

