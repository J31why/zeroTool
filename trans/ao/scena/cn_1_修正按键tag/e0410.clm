fn[18]:
	EventBegin 0
	FadeOut 0ms 0x00000000 255
	FlagUnset flag[2743]
	CamSetDistance 270 1000 -8380 0ms
	ED7CamRotate 315deg 25deg 0deg 0ms
	CamPers 500 0ms
	CamZoom 20000 0ms
	CharSetPos field_party[0] (-570, 0, -8020) 0deg
	CharSetPos field_party[1] (990, 0, -8210) 0deg
	CharFlagsUnset char[0] 0x0080
	CharFlagsUnset char[1] 0x0080
	CharFlagsUnset char[2] 0x0080
	CharFlagsUnset char[3] 0x0080
	CharFlagsUnset char[4] 0x0080
	CharFlagsSet char[5] 0x0080
	CharFlagsSet char[6] 0x0080
	CharFlagsSet char[7] 0x0080
	CharFlagsSet char[8] 0x0080
	CharFlagsSet char[9] 0x0080
	CharFlagsSet char[10] 0x0080
	FadeIn 1000ms 0x00000000
	FadeWait
	TextTalk name[0] {
		#00004F好了，我們要負責的是
		後半這兩輛車廂。{wait}
	} {
		#00001F乘客數……
		看來是蠻多的。{wait}
	}
	TextWait
	if PartyPosition name[1] > -1:
		TextTalk name[1] {
			#00100F看來是這樣，總之每一個人
			都要確實做好檢查。{wait}
		}
		TextWait
		QuestTaskSet quest[121] 0
	elif PartyPosition name[2] > -1:
		TextTalk name[2] {
			#00200F的確，總之要將所有人
			都照順序確實做完檢查。{wait}
		}
		TextWait
		QuestTaskSet quest[121] 1
	elif PartyPosition name[3] > -1:
		TextTalk name[3] {
			#00304F嗯，總之也只能
			一個一個去檢查了。{wait}
		}
		TextWait
		QuestTaskSet quest[121] 2
	elif PartyPosition name[8] > -1:
		TextTalk name[8] {
			#10100F是的，總之要確實
			做好檢查吧。{wait}
		}
		TextWait
		QuestTaskSet quest[121] 3
	elif PartyPosition name[4] > -1:
		TextTalk name[4] {
			#10300F呼，總之也只能
			一個一個檢查清楚了。{wait}
		}
		TextWait
		QuestTaskSet quest[121] 4
	ED7_Cam69 255 0
	EventEnd 5
	Return

fn[19]:
	EventBegin 1
	if !flag[2743]:
		TextTalk name[0] {
			#00003F……這邊是第三節車廂。
			先把所有第四節車廂的乘客都檢查完吧。{wait}
		}
		TextWait
	else:
		TextTalk name[0] {
			#00003F……更前面的車廂不是我們的負責範圍。
			專注在我們負責區域的臨檢吧。{wait}
		}
		TextWait
	Sleep 50ms
	CharSetPos field_party[0] (-10, 0, 7470) 180deg
	EventEnd 4
	Return

