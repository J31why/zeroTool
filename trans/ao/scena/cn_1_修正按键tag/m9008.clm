		Sleep 700ms
		SoundPlay sound[13] 0 100 0
		FadeWait
		PartySetAttr name[255] 254 0
		CamLookChar field_party[0] 0ms
		ED7_31 1
		Sleep 3500ms
		ObjFrame object[0] 0
		BgmResume
		FadeIn 1000ms 0x00000000
		TextClose 0
		TextEnd null
		Return
	else:
		FadeIn 300ms 0x00000000
		TextEnd null
		Return
	Return
	Return

