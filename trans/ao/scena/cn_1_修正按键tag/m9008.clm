	if flag[3402]:
		ObjFlagsUnset object[2] 0x0002
		ObjFlagsSet object[2] 0x0004
	ED7_76_0 object[255] "CA_stop" 1
	if flag[3404]:
		ED7_76_1 object[255] "CA_stop" 2
	if flag[3404] && flag[3405]:
		ED7_76_0 object[255] "magi_07d_add" 1
	ED7ObjPlay object[1] 0 0 0 4096
	SoundPlay sound[112] 1 50 0
	Return

fn[2]:
	ED7_F2 2
	FadeOut 300ms 0x00000000 100
	TextMessage name[742] {
		{color 5}有可恢復導力器的裝置。{color 0}{wait}
	}
	Menu menu[0] -1 -1 1
		"在此地休息" // 0
		"放棄" // 1
	MenuWait var[0]
	MenuClose menu[0]
	TextClose 0
	if var[0] == 0:
		FadeIn 100ms 0x00000000
		Sleep 500ms
		SoundLoad sound[13]
		ED7_74 object[0] 0 30
		SoundPlay sound[7] 0 100 0
		ObjFrame object[0] 0
		ED7ObjPlay object[0] 0 30 0 0
		ObjWait object[0]
		ED7ObjPlay object[0] 31 390 0 32
		Sleep 1000ms
		BgmStop 3000ms
