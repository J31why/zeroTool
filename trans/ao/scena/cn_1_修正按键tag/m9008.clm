		Event fn[0,5]
	if flag[3404] && !flag[3405]:
		Event fn[0,8]
	if flag[272]:
		FlagUnset flag[272]
		Event fn[0,7]
	Return

fn[1]:
	ED7_EE 1 800
	EntranceSetFunc entrance[2] fn[0,4]
	if flag[3405] && !flag[3406]:
		EntranceSetFunc entrance[1] fn[0,9]
	else:
