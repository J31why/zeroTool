fn[5]:
	if QuestFlagsGet quest[142] 0x02 && !QuestFlagsGet quest[142] 0x10 && !QuestFlagsGet quest[142] 0x40 && flag[3250] && !flag[3301]:
		Call fn[0,15]
		Return
	TextStart self
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"交談" // 0
			"買東西" // 1
			"放棄" // 2
		MenuWait var[0]
		if var[0] != 1:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			ShopOpen shop[129]
			var[0] = 99
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			if flag[6]:
				TextTalk char[0] {
					只要有那個醬汁，
					一定可以做成很棒的
					賑災食物。{wait}
				}
				TextWait
				TextTalk char[0] {
					唯一的小缺點就是
					會有一點點苦味吧。{wait}
				}
				TextWait
			elif !flag[0]:
				TextTalk self {
					歡迎光臨～！{wait}
				}
				TextWait
				TextTalk self {
					要不要來一杯很受部分族群
					喜愛的『苦番茄蘇打』呢？{wait}
				}
				TextWait
				TextTalk self {
					大家都來喝一杯這個，
					打起精神來吧！{wait}
				}
				TextWait
				FlagSet flag[0]
			else:
				TextTalk self {
					要不要來一杯很受部分族群
					喜愛的『苦番茄蘇打』呢？{wait}
				}
				TextWait
				TextTalk self {
					大家都來喝一杯這個，
					打起精神來吧！{wait}
				}
				TextWait
	TextEnd self
	Return

fn[6]:
	TextStart self
	if !flag[1]:
		TextTalk self {
			我到現在都還忘不了那個景象……
			沒想到伊莉雅大人居然會那樣……！{wait}
		}
		TextWait
		TextTalk self {
			唔……武裝集團真是不可原諒！
			還有，帝國政府也不可原諒！！{wait}
		}
		TextWait
		TextTalk self {
			既然如此，我們只能堅持獨立，
			抗戰到底了……！{wait}
		}
		TextWait
		FlagSet flag[1]
	else:
		TextTalk self {
			唔……武裝集團真是不可原諒！
			還有，帝國政府也不可原諒！！{wait}
		}
		TextWait
		TextTalk self {
			既然如此，我們只能堅持獨立，
			抗戰到底了……！{wait}
		}
		TextWait
	TextEnd self
	Return

fn[7]:
	TextStart self
	if !flag[2]:
		TextTalk self {
			來來來，要不要氣球呢～？{wait}
		}
		TextWait
		TextTalk self {
			一個、兩個、三個，
			今天不管要拿幾個都可以喔。{wait}
		}
		TextWait
		FlagSet flag[2]
	else:
		TextTalk self {
			下午開始
			預計要開辦
			造型氣球教室～{wait}
		}
		TextWait
		TextTalk self {
			希望有興趣的人
			一定要來參加喔～{wait}
		}
		TextWait
	TextEnd self
	Return

fn[8]:
	TextStart self
	if !flag[3196]:
		TextTalk self {
			哎呀，是支援課的各位吧。{wait}
		}
		TextWait
		TextTalk name[0] {
			#00000F嗯，辛苦了。{wait}
		}
		TextWait
		TextTalk name[1] {
			#00100F總部還在修復中吧？{wait}
		}
		TextWait
		TextTalk self {
			嗯，雖然算是
			大致整理過一遍了……{wait}
		}
		TextWait
		TextTalk self {
			但入口大廳的
			損害狀況非常嚴重。{wait}
		}
		TextWait
		TextTalk self {
			還得要花一些時間
			才能恢復櫃檯的機能。{wait}
		}
		TextWait
		TextTalk self {
			順道一提，跟櫃檯相關的
			事務工作將會暫時
			轉移到警察學校辦理。{wait}
		}
		TextWait
		TextTalk self {
			瑞貝卡小姐也在，如果有
			工作方面的事務要處理，
			那邊應該都能因應。{wait}
		}
		TextWait
		TextTalk name[0] {
			#00002F原來如此，我瞭解了。{wait}
		}
		TextWait
		TextTalk name[2] {
			#00200F真的是非常感謝。{wait}
		}
		TextWait
		FlagSet flag[3196]
	else:
		TextTalk self {
			總部還要花一段時間
			才能修復完成。{wait}
		}
		TextWait
		TextTalk self {
			如果有什麼事務要處理，
			就去警察學校那邊吧。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[9]:
	TextStart self
	if !flag[3]:
		TextTalk self {
			你也聽說了嗎？
			之前那件攻擊事件，
			好像是帝國的陰謀。{wait}
		}
		TextWait
		TextTalk self {
			我真的沒辦法原諒
			帝國這個國家。{wait}
		}
		TextWait
		FlagSet flag[3]
	else:
		TextTalk self {
			不過，經過這次，我終於知道了。
			即使服從帝國，他們也根本
			沒有要保護我們的意思……{wait}
		}
		TextWait
		TextTalk self {
			所以我們只能
			堅持獨立的理念了。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[10]:
	TextStart self
	TextTalk self {
		帝國真的很壞……
		對大家做了這麼過分的事情。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[11]:
	TextStart self
	TextTalk self {
		現在市民會館那邊
		正在舉行慈善活動，
		有很多不同的表演，很有趣喔。{wait}
	}
	TextWait
	TextTalk self {
		更重要的是，藉由這種
		熱鬧活動推動復興的想法
		真的很棒呢。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[12]:
	TextStart self
	TextTalk self {
		聽說籌畫這場活動的是
		克洛斯貝爾工商會。{wait}
	}
	TextWait
	TextTalk self {
		呵呵，每年紀念慶典時，我都覺得
		工商會的人真的很有活力，
		也很擅長炒熱氣氛呢。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[13]:
	EventBegin 0
	FadeOut 0ms 0x00000000 255
	CharFlagsUnset char[5] 0x0080
	CharFlagsUnset char[6] 0x0080
	CharFlagsUnset char[2] 0x0080
	CharFlagsUnset char[7] 0x0080
