fn[4]:
	if flag[4]:
		system[1] = 0
		FlagUnset flag[4]
	if flag[5]:
		SoundStop sound[123]
		FlagUnset flag[5]
	else:
		SoundPlayContinuously sound[123] (-19670, 2460, -15580) 10000 100000 100 0
	ObjFlagsUnset object[6] 0x0004
	ObjFlagsSet object[6] 0x0002
	ObjFlagsUnset object[5] 0x0004
