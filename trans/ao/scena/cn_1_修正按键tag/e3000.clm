fn[3]:
	TextStart self
	if flag[2608]:
	elif flag[2604]:
	elif 0:
	elif flag[2605]:
	elif flag[2602]:
	elif flag[2601]:
	elif flag[2600]:
	elif flag[2597]:
	elif flag[2592]:
		if !flag[2768]:
			TextTalk char[0] {
				#00204F嗯哼，總之……
				希望今天能夠盡情地
				享受久違的假期。{wait}
			} {
				#00200F上次因為還要調查
				『拍賣會』，幾乎都
				沒有時間好好享樂。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00004F對啊，這還是
				第一次在米修拉姆
				好好地玩呢。{wait}
			} {
				#00009F哈哈，緹歐的
				目的果然是
				主題樂園嗎？{wait}
			}
			TextWait
			TextTalk char[0] {
				#00204F那還用說。{wait}
			} {
				《米修拉姆・奇幻樂園》
				（MICHERAM WONDER LAND）……{wait}
			} {
				──簡稱為Ｍ・Ｗ・Ｌ。{wait}
			} {
				#00202F真期待能夠見到咪西。{wait}
			}
			TextWait
			if flag[300]:
				Emote name[0] 0mm 2000mm 24 27 250ms 0
				Sleep 2000ms
				EmoteStop name[0]
				TextTalk name[0] {
					#00004F……這麼說來，那個。
					妳還記得那個『約定』嗎？{wait}
				} {
					#00002F教團事件結束後，
					要找時間去主題樂園
					玩的那件約定。{wait}
				}
				TextWait
				TextTalk char[0] {
					#00204F……我當然還記得。{wait}
				} {
					『首先是和支援課的大家一起去……
					　在那之後，則是羅伊德前輩和我一起去。』{wait}
				} {
					#00200F從這個角度來看，可以說因為
					這次的邀請，總算是進入了
					第一階段呢。{wait}
				}
				TextWait
				TextTalk name[0] {
					#00009F哈哈，雖然我不太懂
					妳為什麼要繞著彎說話……{wait}
				} {
					#00000F近期之內，一定要再找個機會
					兩個人一起來玩。{wait}
				}
				TextWait
				TextTalk char[0] {
					#00209F呵呵……
					是啊，我很期待喔。{wait}
				}
				TextWait
			else:
				TextTalk name[0] {
					#00004F緹歐對於咪西
					特別瞭解呢。{wait}
				} {
					#00002F到了主題樂園後，
					要多告訴我一些喔！{wait}
				}
				TextWait
				TextTalk char[0] {
					#00204F……瞭解了。{wait}
				} {
					#00202F那麼，首先就將咪西的誕生秘話、
					家庭成員等資訊徹底地
					敲進羅伊德前輩的腦袋中……{wait}
				}
				TextWait
				TextTalk name[0] {
					#00006F不、不用啦，不需要那麼詳細啦。{wait}
				}
				TextWait
			FlagSet flag[2768]
		else:
			TextTalk char[0] {
				#00202F關於咪西的事情，
				等到了主題樂園後
				再好好告訴你吧。{wait}
			} {
				#00204F總之，現在還是先去大家那裡
				和大家談談會比較好。{wait}
			}
			TextWait
	TextEnd self
	Return

