fn[0]:
	switch random % 8:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharWalkToPos self (-6300, -750, 390) 2000mm/s 0
		CharWalkToPos self (-7800, -750, -1400) 2000mm/s 0
		Sleep 1800ms
		CharTurnTo self 45deg 400deg/s
		Sleep 100ms
		CharWalkToPos self (-6300, -750, 390) 2000mm/s 0
		CharWalkToPos self (-6300, -750, 3160) 2000mm/s 0
		CharTurnTo self 315deg 400deg/s
		Sleep 1800ms
		CharTurnTo self 180deg 400deg/s
		Sleep 100ms
	Return

