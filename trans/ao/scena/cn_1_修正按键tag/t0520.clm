fn[4]:
	TextSetName ""
	TextSetPos -1 -1 -1 -1
	TextMessage null {
		{color 5}★紅磚亭・精選食譜★
		　　～基本款
		　　　炸魚排～{wait}
	}
	TextWait
	TextMessage null {
		{color 5}上面寫著炸魚排的食譜。{wait}
	}
	TextWait
	TextClose 0
	_59
	TextSetPos -1 280 60 3
	if ItemHas item[2] 0:
		if !RecipeLearn 8:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextSetName ""
			TextMessage null {
				記住了{color 2}『炸魚排』{color 0}的食譜。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			FadeWait
			_59
			TextSetPos -1 280 60 3
	TextEnd null
	Return

fn[5]:
	Call fn[0,6]
	Return

fn[6]:
	if QuestFlagsGet quest[128] 0x02 && !QuestFlagsGet quest[128] 0x10 && !QuestFlagsGet quest[128] 0x40 && flag[2960] && !flag[2968]:
		Call fn[0,35]
		Return
	elif QuestFlagsGet quest[133] 0x02 && !QuestFlagsGet quest[133] 0x10 && !QuestFlagsGet quest[133] 0x40 && flag[2989] && !flag[2990]:
		Call fn[0,36]
		Return
	TextStart char[0]
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"交談" // 0
			"買東西" // 1
			"休息" // 2
			"放棄" // 3
		MenuWait var[0]
		if var[0] < 1 | var[0] > 2:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			ShopOpen shop[82]
			var[0] = 99
		elif var[0] == 2:
			ShopOpen shop[80]
			var[0] = 99
		elif var[0] == 3:
		elif var[0] != 0:
			TextEnd char[0]
			Return
		elif var[0] == 0:
			var[0] = 99
			if flag[16]:
				TextTalk char[0] {
					呵呵，吃下礦山鎮的
					特色肉排，就會
					立刻湧出力量喔。{wait}
				}
				TextWait
				TextTalk char[0] {
					你們想要
					大吃一頓時，
					歡迎再來光臨。{wait}
				}
				TextWait
			elif flag[3385]:
				if !flag[0]:
					TextTalk char[0] {
						在街上發生那場騷動後，
						精疲力盡的遊擊士們
						和哭腫眼睛的女孩來到這裡。{wait}
					}
					TextWait
					TextTalk char[0] {
						他們似乎也參與了
						在克洛斯貝爾市的解放作戰。{wait}
					}
					TextWait
					TextTalk char[0] {
						畢竟我們一直協助
						反抗軍，所以很想要
						慰勞他們就是了。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[0] {
						在下面休息的那些遊擊士
						似乎參與了在克洛斯貝爾市的
						解放作戰。{wait}
					}
					TextWait
					TextTalk char[0] {
						剛才還有別的遊擊士來
						幫忙趕走魔獸……我們真的
						受到他們很多的幫助。{wait}
					}
					TextWait
			elif flag[3362]:
				if !flag[0]:
					TextTalk char[0] {
						現在反抗軍的隊長
						米蕾優正來到這裡進行補給。{wait}
					}
					TextWait
					TextTalk char[0] {
						聽說你們最近要
						展開大規模的作戰呀？{wait}
					}
					TextWait
					TextTalk char[0] {
						我們支持你們喔。
						鼓起幹勁加油吧。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[0] {
						聽說你們最近要
						展開大規模的作戰呀？{wait}
					}
					TextWait
					TextTalk char[0] {
						我們支持你們喔。
						鼓起幹勁加油吧。{wait}
					}
					TextWait
			elif flag[3328]:
				if !flag[3439]:
					CharTurnToChar char[0] name[3] 0deg/s
					TextTalk char[0] {
						蘭迪，聽說你
						暫時離開反抗軍了呀？{wait}
					}
					TextWait
					TextTalk name[3] {
						#00304F是啊，因為有必須拯救的
						寶貝女兒在等我。{wait}
					} {
						#00302F大嬸，這陣子除了
						瑪因茲的傢伙們，米蕾優他們
						也要請妳關照囉。{wait}
					}
					TextWait
					TextTalk char[0] {
						哈哈，知道了。
						你也要保重喔。{wait}
					}
					TextWait
					FlagSet flag[3439]
				elif !flag[0]:
					TextTalk char[0] {
						我們告訴反抗軍的那些人
						山岳地帶哪裡適合藏身，
						幫他們補給糧食和藥……{wait}
					}
					TextWait
					TextTalk char[0] {
						即使國防軍那群人來搜索，
						我們也徹底裝傻，
						總之幫了許多忙。{wait}
					}
					TextWait
					TextTalk char[0] {
						雖然不是什麼大不了的事，
						但我們想要盡可能協助。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[0] {
						希望反抗軍
						能夠努力。{wait}
					}
					TextWait
					TextTalk char[0] {
						雖然幫不上什麼大忙，
						還是想要盡可能協助。{wait}
					}
					TextWait
			elif flag[3074]:
				if !flag[0]:
					TextTalk char[0] {
						結果武裝集團的
						那些人完全沒有對鎮裡的
						人和糧食下手。{wait}
					}
					TextWait
					TextTalk char[0] {
						雖然那還是一次很可怕的經驗，
						但和損傷慘重的警備隊相較下，
						或許算好了吧。{wait}
					}
					TextWait
					TextTalk char[0] {
						……不過，那些傢伙的目的到底是什麼啊？
						真的是莫名其妙。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[0] {
						武裝集團的那些人……
						目的到底是什麼啊？{wait}
					}
					TextWait
					TextTalk char[0] {
						真的是莫名其妙。{wait}
					}
					TextWait
			elif flag[2848]:
				TextTalk char[0] {
					嗯──真舒服的雨呢。{wait}
				}
				TextWait
				TextTalk char[0] {
					在這樣的日子，
					晚上客人會比較少，
					我就放鬆吧。{wait}
				}
				TextWait
			elif flag[2832]:
				if !QuestFlagsGet quest[133] 0x10 && flag[2990]:
					if !flag[0]:
						TextTalk char[0] {
							利貝爾製的玻璃杯
							有好好送到真是太好了。{wait}
						}
						TextWait
						TextTalk char[0] {
							當時看到送錯的包裹中
							有手術刀什麼的時候，
							真的被嚇到了。{wait}
						}
						TextWait
						TextTalk char[0] {
							哈哈，總之，
							也辛苦你們了。
							讓我道個謝吧。{wait}
						}
						TextWait
						FlagSet flag[0]
					else:
						TextTalk char[0] {
							不久前訂的
							利貝爾製的玻璃杯，
							幸好有好好送達。{wait}
						} {
							那時我真的被嚇到了。{wait}
						}
						TextWait
						TextTalk char[0] {
							哈哈，總之，
							也辛苦你們了。
							讓我道個謝吧。{wait}
						}
						TextWait
				elif !flag[0]:
					TextTalk char[0] {
						聽說瑪爾羅先生
						終於回復精神了喔。{wait}
					}
					TextWait
					TextTalk char[0] {
						雖然我從旁人角度看，
						也覺得琉卡的安慰方式
						很冷淡，不過……{wait}
					}
					TextWait
					TextTalk char[0] {
						既然能讓他本人
						恢復精神就好。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[0] {
						總之，瑪爾羅先生似乎
						也已恢復精神……算是
						解決了一件事吧。{wait}
					}
					TextWait
			elif flag[2816]:
				if !flag[0]:
					TextTalk char[0] {
						最近瑪爾羅先生
						似乎擅自認為他一定是
						被琉卡討厭了。{wait}
					}
					TextWait
					TextTalk char[0] {
						他既不來酒館，
						又無法專心工作，
						似乎很困擾。{wait}
					}
					TextWait
					TextTalk char[0] {
						因為琉卡本人沒有自覺，
						所以事情有點難搞……{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[0] {
						話說回來，岡茲先生
						也是有優點的嘛。
						竟然為了朋友直接來問清楚。{wait}
					}
