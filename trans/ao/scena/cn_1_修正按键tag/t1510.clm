fn[7]:
	if QuestFlagsGet quest[128] 0x02 && !QuestFlagsGet quest[128] 0x10 && !QuestFlagsGet quest[128] 0x40 && flag[2960] && !flag[2969]:
		if flag[2848]:
			Call fn[0,33]
			Return
		elif !flag[3017]:
			Call fn[0,32]
			Return
	TextStart char[0]
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"交談" // 0
			"買東西" // 1
			"休息" // 2
			"放棄" // 3
		MenuWait var[0]
		if var[0] < 1 | var[0] > 2:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			if flag[3328]:
				ShopOpen shop[95]
			elif flag[2848]:
				ShopOpen shop[94]
			elif flag[2816]:
				ShopOpen shop[93]
			else:
				ShopOpen shop[92]
			var[0] = 99
		elif var[0] == 2:
			ShopOpen shop[90]
			var[0] = 99
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			if flag[11]:
				if flag[2969]:
					TextTalk char[0] {
						呵呵，我煮的燉菜
						味道是不是很棒啊？{wait}
					}
					TextWait
					TextTalk char[0] {
						病人和外來客都說
						喝了會很有精神。
						你們有機會再來喝吧。{wait}
					}
					TextWait
				else:
					TextTalk char[0] {
						我們這裡的推薦料理
						需要花很多時間
						慢慢燉煮。{wait}
					}
					TextWait
					if !flag[2832]:
						TextTalk char[0] {
							這道料理應該會在
							兩天後完成吧。{wait}
						}
						TextWait
						TextTalk char[0] {
							那個時候
							你們別忘了要過來啊。{wait}
						}
						TextWait
					else:
						TextTalk char[0] {
							這道料理應該會在
							明天完成吧。{wait}
						}
						TextWait
						TextTalk char[0] {
							很快就會完成了，
							你們別忘了要過來啊。{wait}
						}
						TextWait
			elif flag[3385]:
				if !flag[0]:
					TextTalk char[0] {
						哈羅德先生有跟我聯絡。
						他之後好像會來醫院這裡。{wait}
					}
					TextWait
					TextTalk char[0] {
						我拜託他多帶一些
						阿爾摩利卡產的蔬菜過來，
						那樣我才能做出像樣的料理。{wait}
					}
					TextWait
					TextTalk char[0] {
						豐盛的餐點可是最重要的。
						這樣一來，病人們
						也能打起精神了吧。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[0] {
						我拜託哈羅德先生多帶一些
						阿爾摩利卡產的蔬菜過來，
						那樣才能做些像樣的菜。{wait}
					}
					TextWait
					TextTalk char[0] {
						豐盛的餐點可是最重要的。
						這樣一來，病人們
						也能打起精神了吧。{wait}
					}
					TextWait
			elif flag[3362]:
				TextTalk char[0] {
					待在這裡的
					那些外來客，看起來
					也越來越疲倦。{wait}
				}
				TextWait
				TextTalk char[0] {
					如果有辦法讓他們早點
					回到克洛斯貝爾市就好了。{wait}
				}
				TextWait
			elif flag[3338]:
				if !flag[0]:
					TextTalk char[0] {
						雖然城裡有
						配給我們糧食，
						但基本上都是乾糧居多。{wait}
					}
					TextWait
					TextTalk char[0] {
						傷腦筋，就算
						我想做營養餐，但不管
						怎麼做，營養都不太均衡。{wait}
					}
					TextWait
					TextTalk char[0] {
						是我的錯覺嗎？
						感覺病人和外來客表情都很灰暗……
						真想為他們做點什麼。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[0] {
						只依靠城裡配給的糧食
						來做營養餐的話，不管我怎麼做
						營養都不太均衡。{wait}
					}
					TextWait
					TextTalk char[0] {
						如果能像以前一樣
						從阿爾摩利卡村進一些
						新鮮蔬菜的話就好了。{wait}
					}
					TextWait
			elif flag[3328]:
				if !flag[0]:
					TextTalk char[0] {
						那邊那群城裡的孩子，
						好像是彩虹劇團的粉絲。{wait}
					}
					TextWait
					TextTalk char[0] {
						他們是來探望伊莉雅的，不過……
						獨立宣言後，他們留在醫院，
						幫了很多的忙。{wait}
					}
					TextWait
					TextTalk char[0] {
						呵呵，真是一群親切的孩子。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[0] {
						那群孩子是伊莉雅的粉絲，
						他們在獨立宣言後留在醫院，
						幫了很多的忙。{wait}
					}
					TextWait
					TextTalk char[0] {
						呵呵，真是一群親切的孩子。{wait}
					}
					TextWait
			elif flag[3074]:
				if !flag[0]:
					TextTalk char[0] {
						我負責營養餐的
						菜單，不過……{wait}
					}
					TextWait
					TextTalk char[0] {
						這次住院病人裡面，
						有很多人傷勢嚴重到
						甚至沒辦法進食。{wait}
					}
					TextWait
					TextTalk char[0] {
						食物會影響一個人的活力。
						真想讓他們
						也吃點什麼。{wait}
