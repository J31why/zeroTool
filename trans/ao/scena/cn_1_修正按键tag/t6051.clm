fn[0]:
	if flag[3101] && !flag[3102]:
		Event fn[0,8]
	elif system[0] == 105 && flag[3102] && !flag[3103]:
		Event fn[0,14]
	Return

fn[1]:
	if flag[3100] && !flag[3108]:
		system[1] = 540
	elif flag[3385]:
		system[1] = 563
	name[10].45 = 1100
	name[10].46 = 1100
	name[10].47 = 1100
	TriggerFlagsSet trigger[0] 0x0080
	if flag[3103] && !flag[3105]:
		TriggerFlagsUnset trigger[0] 0x0080
	TriggerFlagsSet trigger[1] 0x0080
	if flag[3106] && !flag[3107]:
		TriggerFlagsUnset trigger[1] 0x0080
	LookPointFlagsSet look_point[0] 0x0001
	if flag[3105] && !flag[3106]:
		LookPointFlagsUnset look_point[0] 0x0001
	LookPointFlagsSet look_point[1] 0x0001
	if flag[3105] && !flag[3107]:
		LookPointFlagsUnset look_point[1] 0x0001
	LookPointFlagsSet look_point[4] 0x0001
	LookPointFlagsSet look_point[5] 0x0001
	LookPointFlagsSet look_point[6] 0x0001
	if flag[3100] && !flag[3108]:
		LookPointFlagsUnset look_point[4] 0x0001
		LookPointFlagsUnset look_point[5] 0x0001
		LookPointFlagsUnset look_point[6] 0x0001
	if flag[3102] && !flag[3108]:
		Call fn[0,13]
	if flag[3103] && !flag[3108]:
		Call fn[0,23]
	if flag[3105] && !flag[3108]:
		Call fn[0,30]
	if flag[3100] && !flag[3106]:
		ObjFrame object[10] 45
		ObjFlagsSet object[10] 0x0002
		ObjFlagsUnset object[1] 0x0004
		ObjFlagsSet object[2] 0x0004
	else:
		ObjFrame object[10] 0
		ObjFlagsUnset object[10] 0x0002
		ObjFlagsSet object[1] 0x0004
		ObjFlagsUnset object[2] 0x0004
	if !flag[4019]:
		ObjFrame object[12] 0
	else:
		ObjFrame object[12] 30
	if !flag[4020]:
		ObjFrame object[13] 0
	else:
		ObjFrame object[13] 30
	if flag[3107] && !flag[3108]:
		ObjFrame object[0] 10
	Return

fn[2]:
	ED7_F2 1
	SystemFlagsSet 0x08000000
	FadeOut 300ms 0x00000000 100
	if !flag[4019]:
		SoundPlay sound[14] 0 100 0
		ED7_74 object[12] 0 30
		ED7ObjPlay object[12] 0 30 0 0
		Sleep 500ms
		ObjFrame object[12] 30
		SoundPlay sound[17] 0 100 0
		TextSetPos -1 -1 -1 -1
		TextSetPos -1 -1 -1 -1
		FadeOut 300ms 0x00000000 100
		SoundPlay sound[17] 0 100 0
		TextSetName ""
		TextMessage name[742] {
			{color 0}已取得１０個{item[502]}{color 0}。{wait}
		}
		TextWait
		TextClose 0
		FadeIn 300ms 0x00000000
		ItemAdd item[502] 10
		TextSetPos -1 280 60 3
		TextWait
		TextClose 0
		TextSetPos -1 280 60 3
		FlagSet flag[4019]
		ED7_DE 5
	else:
		TextMessage name[742] {
			{0x06}{color 5}寶箱裡什麼都沒有。{wait}
		}
		TextWait
		TextClose 0
	FadeIn 300ms 0x00000000
	TextEnd null
	SystemFlagsUnset 0x08000000
	Return

fn[3]:
	ED7_F2 1
	SystemFlagsSet 0x08000000
	if !flag[4020]:
		SoundPlay sound[14] 0 100 0
		ED7_74 object[13] 0 30
		ED7ObjPlay object[13] 0 30 0 0
		Sleep 500ms
		if ItemAdd item[510] 1:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextSetName ""
			TextMessage name[742] {
				{color 0}已取得{item[510]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			TextSetPos -1 280 60 3
			FadeIn 300ms 0x00000000
			FlagSet flag[4020]
			ED7_DE 5
		else:
			FadeOut 300ms 0x00000000 100
			TextSetName ""
			TextMessage name[742] {
				寶箱裡裝有{item[510]}{color 0}。
				因持有物品已達上限，已放棄{item[510]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			SoundPlay sound[15] 0 100 0
			ED7ObjPlay object[13] 30 0 0 0
	else:
		FadeOut 300ms 0x00000000 100
		TextSetPos -1 -1 -1 -1
		TextSetName ""
		TextMessage name[742] {
			{0x06}{color 5}寶箱裡什麼都沒有。{color 0}{wait}
		}
		TextWait
		TextClose 0
		FadeIn 300ms 0x00000000
	Sleep 30ms
	TextEnd null
	SystemFlagsUnset 0x08000000
	Return

fn[4]:
	TextStart self
	if !flag[0]:
		TextTalk self {
			…………{wait}
		}
		TextWait
		TextSetName ""
		TextMessage null {
			{color 5}國防軍士兵已經昏厥。{color 0}{wait}
		}
		TextWait
		TextClose 0
		_59
		FlagSet flag[0]
	else:
		TextSetName ""
		TextMessage null {
			{color 5}國防軍士兵已經昏厥。{color 0}{wait}
		}
		TextWait
		TextClose 0
		_59
	TextEnd self
	Return

fn[5]:
	TextStart null
	if !flag[3225]:
		TextSetPos 120 10 -1 -1
		TextSetName "傲慢的聲音"
		TextMessage null {
			{color 0}你、你們是……
			這場騷動是你們引起的嗎！？{color 0}{wait}
		}
		TextWait
		TextClose 0
		_59
		Emote name[0] 0mm 2000mm 38 38 250ms 1
		Sleep 1000ms
		TextTalk name[0] {
			#00005F這、這個聲音……
			該不會是瑪律克尼會長？{wait}
		}
		TextWait
		TextSetPos 100 10 -1 -1
		TextSetName "瑪律克尼的聲音"
		TextMessage null {
			{color 0}在、在那裡的是警察的小鬼！？{color 0}{wait}
		}
		TextWait
		TextClose 0
		_59
		TextSetPos -1 280 60 3
		TextSetPos 100 10 -1 -1
		TextSetName "瑪律克尼的聲音"
		TextMessage null {
			{color 0}加爾西亞，你為什麼跟他在一起……！？
			你、你要離開的話，就也帶我一起走！{color 0}{wait}
		}
		TextWait
		TextClose 0
		_59
		TextSetPos -1 280 60 3
		TextTalk name[10] {
			#11103F……會長，雖然很抱歉，
			不過我辦不到。{wait}
		} {
			#11101F我馬上就會回來，
			請你老實地待在這裡。{wait}
		}
		TextWait
		TextSetPos 100 10 -1 -1
		TextSetName "瑪律克尼的聲音"
		TextMessage null {
			{color 0}喂、喂，等等！加爾西亞──！！{color 0}{wait}
		}
		TextWait
		TextClose 0
		_59
		TextSetPos -1 280 60 3
		Emote name[0] 0mm 2000mm 16 19 250ms 1
		SoundPlay sound[23] 0 100 0
		Sleep 1000ms
		TextTalk name[0] {
			#00011F（還、還真有精神呢……）{wait}
		} {
			#00006F（……那種傲慢的個性
			　似乎也沒變呢。）{wait}
		}
		TextWait
		TextTalk name[10] {
			#11100F（呵呵，的確如此呢。）{wait}
		} {
			#11104F（對我來說，
			　他也是給了我魯巴徹
			　這個好地方的恩人呢。）{wait}
		}
		TextWait
		TextTalk name[0] {
			#00005F（……你們想必也有不少過往吧。）{wait}
		}
		TextWait
		TextTalk name[10] {
			#11103F（……哼，看來我說了
			　不像是我會說的話啊。）{wait}
		} {
			#11101F（快走吧，小鬼。）{wait}
		}
		TextWait
		FlagSet flag[3225]
	else:
		TextSetPos 100 10 -1 -1
		TextSetName "瑪律克尼的聲音"
		TextMessage null {
			{color 0}加爾西亞、警察的小鬼！！
			你、你們要離開的話，就也帶我一起走！{color 0}{wait}
		}
		TextWait
		TextClose 0
		_59
		TextSetPos -1 280 60 3
	TextEnd null
	Return

fn[6]:
	TextStart null
	if !flag[3226]:
		TextSetPos 160 160 -1 -1
		TextSetName "害怕的聲音"
		TextMessage null {
			{color 0}究、究竟發生了什麼事！？{color 0}{wait}
		}
		TextWait
		TextClose 0
		_59
		TextSetPos -1 280 60 3
		TextSetPos 160 160 -1 -1
		TextSetName "害怕的聲音"
		TextMessage null {
			{color 0}看守員……都到哪裡去了！
			快、快點來處理這個狀況！{color 0}{wait}
		}
		TextWait
		TextClose 0
		_59
		TextSetPos -1 280 60 3
		TextTalk name[10] {
			#11103F（……被關在這個房間裡的，
			　我記得是哈爾特曼那傢伙。）{wait}
		}
		TextWait
		TextTalk name[0] {
			#00001F（哈爾特曼前議長……
			　在阿勒泰爾據點之後就沒見過了。）{wait}
		} {
			#00003F（總覺得他似乎變成
			　膽子很小的樣子……）{wait}
		}
		TextWait
		TextTalk name[10] {
			#11104F（自從他被關進拘留所之後，
			　似乎就一直是這樣。）{wait}
		} {
			#11102F（失去財富與地位，
			　能夠支撐自己的東西
			　也全都喪失了吧。）{wait}
		}
		TextWait
		TextTalk name[0] {
			#00003F（……雖然有點擔心他……
			　不過這也是對他的懲罰吧。）{wait}
		} {
			#00001F（……我們也差不多該走了。）{wait}
		}
		TextWait
		FlagSet flag[3226]
	else:
		TextSetPos 160 160 -1 -1
		TextSetName "哈爾特曼的聲音"
		TextMessage null {
			{color 0}究、究竟發生了什麼事！？{color 0}{wait}
		}
		TextWait
		TextClose 0
		_59
		TextSetPos -1 280 60 3
		TextSetPos 160 160 -1 -1
		TextSetName "哈爾特曼的聲音"
		TextMessage null {
			{color 0}看守員……都到哪裡去了！
			快、快點來處理這個狀況！{color 0}{wait}
		}
		TextWait
		TextClose 0
		_59
		TextSetPos -1 280 60 3
	TextEnd null
	Return

fn[7]:
	TextStart null
	if !flag[3227]:
		TextSetPos 160 160 -1 -1
		TextSetName "冷靜的聲音"
		TextMessage null {
			{color 0}在那邊的人……
			該不會是羅伊德吧？{color 0}{wait}
		}
		TextWait
		TextClose 0
		_59
		TextSetPos -1 280 60 3
		TextSetPos 160 160 -1 -1
		TextSetName "冷靜的聲音"
		TextMessage null {
