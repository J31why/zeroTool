	}
	TextWait
	TextTalk char[19] {
		是這樣的，分部長在東克洛斯
		貝爾街道那邊，找到一棟可以
		當成新事務所的房子了喔。{wait}
	}
	TextWait
	TextTalk char[19] {
		那是自從幾年前荒廢以來，
		一直都沒人使用的
		出租小船屋。{wait}
	}
	TextWait
	TextTalk char[18] {
		雖然裡面又窄又破，
		不過在附近的河川就可以釣魚，
		老實說還蠻舒適的喔！{wait}
	}
	TextWait
	TextTalk char[17] {
