fn[0]:
	switch random % 8:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if !flag[3089] && flag[2353]:
		if system[0] == 104 && PartyPosition name[0] > -1 && !flag[2528] && ItemHas item[841] 0:
			Event fn[0,14]
		if system[0] == 104 && PartyPosition name[0] > -1 && !flag[2529] && ItemHas item[840] 0:
			Event fn[0,15]
		if system[0] == 104 && PartyPosition name[0] > -1 && flag[2529] && flag[2528] && !flag[2411]:
			if !(!flag[2848] && flag[2837] | !flag[2832] && flag[2816]):
				Event fn[0,37]
		if system[0] == 106 && PartyPosition name[3] > -1 && !flag[2531] && ItemHas item[847] 0:
			Event fn[0,18]
		if system[0] == 106 && PartyPosition name[3] > -1 && !flag[2530] && ItemHas item[846] 0:
			Event fn[0,17]
		if system[0] == 115 && PartyPosition name[4] > -1 && !flag[2533] && ItemHas item[851] 0:
			Event fn[0,20]
		if system[0] == 115 && PartyPosition name[4] > -1 && !flag[2532] && ItemHas item[850] 0:
			Event fn[0,19]
		if system[0] == 115 && !flag[2560] && !flag[2525]:
			Event fn[0,6]
	if flag[3089]:
	elif flag[3074]:
	elif flag[2866]:
		CharFlagsUnset char[1] 0x0080
		CharSetPos char[1] (49960, 30, 123630) 0deg
		ForkFunc char[1] fork[0] fn[0,0]
	elif flag[2832]:
	elif flag[2816]:
		if flag[2947]:
			CharFlagsUnset char[0] 0x0080
			CharSetPos char[0] (99500, 30, 65530) 180deg
	elif flag[2573]:
	if flag[273]:
		FlagUnset flag[273]
		FlagSet flag[1]
		Event fn[0,41]
	elif flag[282]:
		FlagUnset flag[282]
		FlagSet flag[1]
		Event fn[0,43]
	Return

fn[2]:
	if flag[1]:
		system[1] = 0
		FlagUnset flag[1]
	if flag[3328] && !flag[3385]:
		MapColor 0x00E6D2D2 0ms
		ED7_76_0 object[255] "wlight_add" 1
		ED7_76_0 object[255] "ylight_add" 1
		ED7_76_0 object[255] "out_add" 1
	if flag[2848] && !flag[2858] | flag[2369] && system[4] == 1:
		ED7_76_0 object[255] "wlight_add" 1
		ED7_76_0 object[255] "ylight_add" 1
		ED7_76_0 object[255] "out_add" 1
		SoundPlay sound[128] 1 50 0
	if flag[2861] && !flag[3072]:
		ED7_76_0 object[255] "01" 1
		ED7_76_1 object[255] "02" 1
	else:
		ED7_76_1 object[255] "01" 1
		ED7_76_0 object[255] "02" 1
	if flag[3089]:
		ED7_76_0 object[255] "asihuki" 1
	else:
		ED7_76_1 object[255] "asihuki" 1
	if flag[2560] && !flag[2561]:
		EntranceSetFunc entrance[2] fn[0,42]
	if !flag[2528]:
		ObjFlagsSet object[9] 0x0004
		ObjFlagsUnset object[9] 0x0002
		LookPointFlagsSet look_point[2] 0x0001
	if !flag[2529]:
		ObjFlagsSet object[10] 0x0004
		ObjFlagsUnset object[10] 0x0002
		LookPointFlagsSet look_point[3] 0x0001
	else:
		ObjFlagsSet object[16] 0x0004
		ObjFlagsUnset object[16] 0x0002
	if !flag[2530]:
		ObjFlagsSet object[11] 0x0004
		ObjFlagsUnset object[11] 0x0002
		LookPointFlagsSet look_point[4] 0x0001
	if !flag[2531]:
		ObjFlagsSet object[12] 0x0004
		ObjFlagsUnset object[12] 0x0002
		LookPointFlagsSet look_point[5] 0x0001
	else:
		ObjFlagsSet object[15] 0x0004
	if !flag[2532]:
		ObjFlagsSet object[13] 0x0004
		ObjFlagsUnset object[13] 0x0002
		LookPointFlagsSet look_point[6] 0x0001
	if !flag[2533]:
		ObjFlagsSet object[14] 0x0004
		ObjFlagsUnset object[14] 0x0002
		LookPointFlagsSet look_point[7] 0x0001
	ObjFlagsUnset object[1] 0x0010
	ObjFlagsUnset object[4] 0x0010
	if flag[2560]:
		ObjFlagsSet object[1] 0x0010
		LookPointFlagsSet look_point[0] 0x0001
	if flag[2573]:
		ObjFlagsSet object[4] 0x0010
		LookPointFlagsSet look_point[1] 0x0001
	TriggerFlagsSet trigger[0] 0x0080
	TriggerFlagsSet trigger[1] 0x0080
	if flag[2353] && !flag[2354]:
		TriggerFlagsUnset trigger[0] 0x0080
		TriggerFlagsUnset trigger[1] 0x0080
	TriggerFlagsSet trigger[2] 0x0080
	if flag[2354] && !flag[2355]:
		TriggerFlagsUnset trigger[2] 0x0080
	Return

fn[3]:
	TextStart self
	if flag[2832]:
		if !flag[0]:
			TextTalk char[0] {
				#01000F關於國家獨立的公民投票，
				我們現在收到了很多文件。{wait}
			} {
				雖然有些案件很令人在意……
				但這就交給其他課去處理吧。{wait}
			} {
				總之現在要以風險管理為優先。
				不僅要打聽人偶工房的消息，
				更要解決支援請求。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				#01000F對了，琪雅剛才好像
				出去買晚餐的食材了。{wait}
			} {
				她說還會繞去圖書館一趟……
				總之，擔心的話就去看看情況吧。{wait}
			}
			TextWait
	elif flag[2816]:
		if !flag[0]:
			TextTalk char[0] {
				#01000F嗨，我也是
				剛剛才從醫院回來的。{wait}
			} {
				#01003F你們就繼續調查
				《幻獸》的事情吧。{wait}
			} {
				#01002F趁著《風之劍聖》無法行動，
				努力建立功績吧。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				#01003F你們就繼續調查
				《幻獸》的事情吧。{wait}
			} {
				#01002F趁著《風之劍聖》無法行動，
				努力建立功績吧。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[4]:
	TextStart self
	if flag[2866]:
		if !flag[2910]:
			Call fn[0,5]
		else:
			TextTalk char[1] {
				#01100F大家要努力喔。{wait}
			} {
				#01109F琪雅會在這裡
				等大家回來。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[5]:
	EventBegin 0
	CrossFade 500ms
	CamSetDistance 49470 1300 122080 0ms
	ED7CamRotate 49deg 30deg 0deg 0ms
	CamPers 350 0ms
	CamZoom 22450 0ms
	CharSetPos name[0] (49340, 0, 122340) 0deg
	CharSetPos name[1] (50640, 0, 122340) 0deg
	CharSetPos name[2] (49970, 0, 121240) 0deg
	CharSetPos name[8] (48730, 0, 121240) 0deg
	CharSetPos name[4] (51310, 0, 121240) 0deg
	CharFlagsUnset field_party[4] 0x0080
	CharFlags2Unset field_party[4] 0x8000
	_Char4A char[1] 255
	CharTurnTo char[1] 0deg 0deg/s
	FadeWait
	TextTalk name[1] {
		#00100F琪雅……妳在這裡呀。{wait}
	}
	TextWait
	CharTurnTo char[1] 180deg 300deg/s
	TextTalk char[1] {
		#5P#01100F啊，嗯……{wait}
	}
	TextWait
	Emote char[1] 0mm 1700mm 24 27 250ms 0
	Sleep 2000ms
	EmoteStop char[1]
	TextTalk char[1] {
		#5P#01108F……蘭迪寫那封信的時候，
		不知道懷著
		怎樣的心情。{wait}
	} {
		#01103F他是不是打算……再也不跟
		琪雅和大家見面了呢？{wait}
	}
	TextWait
	TextTalk name[2] {
		#12P#00205F琪雅……{wait}
	}
	TextWait
	TextTalk name[4] {
		#10300F……因為蘭迪想對付的對手
		實在太強大了。{wait}
	} {
		#10303F即使要做出拋下一切的覺悟
		前去挑戰，也沒什麼好奇怪的。{wait}
	} {
		#10308F拋下容身之處、夥伴……甚至自己的生命。{wait}
	}
	TextWait
	TextTalk name[0] {
		#11P#00003F……怎麼可以讓他以這種
		自私的想法離開支援課？{wait}
	} {
		艾莉、緹歐、蘭迪……
		諾艾兒、瓦奇、賽爾蓋課長，
		還有琪雅和賽特……{wait}
	} {
		#00001F在這當中少了任何一個人，
		我們就不再是『支援課』了。{wait}
	}
	TextWait
	TextTalk name[1] {
		#00104F羅伊德……你說得對。{wait}
	} {
		#00108F連這種事情都不懂，
		擅自決定要賭上自己的生命……{wait}
	}
	TextWait
	TextTalk name[2] {
		#12P#00203F嗯，一定要好好懲罰他。{wait}
	}
	TextWait
	TextTalk char[1] {
		#5P#01108F…………{wait}
	}
	TextWait
	TextTalk name[8] {
		#12P#10100F琪雅，不用擔心。
		我們一定會把學長帶回來！{wait}
	}
	TextWait
	TextTalk name[4] {
		#10302F呵呵，畢竟我們終於
		拿到有力的線索了嘛。{wait}
	}
	TextWait
	TextTalk char[1] {
		#5P#01110F這樣啊……{wait}
	} {
		#01104F……大家要努力喔。{wait}
	} {
		#01109F琪雅會在這裡
		等大家回來。{wait}
	}
	TextWait
	TextTalk name[0] {
		#11P#00000F嗯，我們一定會
		跟蘭迪一起回到這裡。{wait}
	}
	TextWait
	_59
	FlagSet flag[2910]
	system[100] += 2
	ED7_Cam69 255 0
	CharFlagsSet field_party[4] 0x0080
	CharFlags2Set field_party[4] 0x8000
	CharSetPos field_party[0] (49970, 0, 121240) 0deg
	_Char4B char[1] 255
	CharTurnTo char[1] 0deg 0deg/s
	EventEnd 5
	Return

fn[6]:
	EventBegin 0
	CrossFade 500ms
	CamSetDistance 100360 630 124300 0ms
	ED7CamRotate 36deg 22deg 0deg 0ms
	CamPers 350 0ms
	CamZoom 25000 0ms
	CharSetPos field_party[0] (98820, 0, 123690) 315deg
	CharSetPos field_party[1] (100820, 0, 123690) 45deg
	CharSetPos field_party[2] (100680, 30, 121540) 0deg
	CharSetPos field_party[3] (99070, 30, 121530) 0deg
	CharSetPos field_party[4] (100020, 0, 124500) 0deg
	FadeWait
	TextTalk name[4] {
		#12P#10302F呵呵，歡迎來到我的城堡。
		……開玩笑的啦。{wait}
	}
	TextWait
	if PartyPosition name[164] > -1:
		TextTalk name[164] {
			#5P#01105F哇～好漂亮的房間喔～{wait}
		}
		TextWait
	else:
		TextTalk name[0] {
			#5P#00005F這房間……
			還真是有格調啊。{wait}
		}
		TextWait
	TextTalk name[8] {
		#12P#10105F就、就是說啊……
		只有這間房間布置得
		像裝潢展示間一樣。{wait}
	} {
		#10106F該怎麼說，
		你融入這裡的速度也太快了吧？{wait}
	}
	TextWait
	TextTalk name[1] {
		#11P#00100F對啊，
		而且裡面好像還
		擺了很多感覺很貴的家具……{wait}
	}
	TextWait
	TextTalk name[4] {
		#12P#10304F呵呵，那是我拜託朋友
		幫我送過來的。{wait}
	} {
		#10300F總之，大家如果累了，
		隨時都可以過來休息。{wait}
	} {
		難得大家都在，
		開那瓶酒來慶祝入住
		好像也不錯呢。{wait}
	}
	TextWait
	TextTalk name[0] {
		#5P#00006F呃，這不行吧……{wait}
	}
	TextWait
	_59
	CharSetPos field_party[0] (100020, 30, 121290) 0deg
	FlagSet flag[2525]
	EventEnd 5
	Return

