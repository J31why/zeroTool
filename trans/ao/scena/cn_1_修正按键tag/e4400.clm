fn[4]:
	TextTalk char[0] {
		#00103F『克洛斯貝爾獨立國』無效宣言……
		再來似乎只剩決定
		入侵系統的時機了。{wait}
	} {
		#00106F……呼，我好像開始緊張了。{wait}
	}
	TextWait
	TextTalk name[0] {
		#00002F哈哈……這也難怪。{wait}
	} {
		#00003F本來存在於克洛斯貝爾的
		短暫和平，就要被我們
		親手撼動了。{wait}
	}
	TextWait
	Emote char[0] 0mm 2000mm 24 27 250ms 0
	Sleep 2000ms
	EmoteStop char[0]
	TextTalk char[0] {
		#00108F……我們打算做的事，
		真的是正確的嗎？{wait}
	} {
		#00103F多虧叔叔他們的努力，
		克洛斯貝爾的眾多居民，
		才能夾在兩大國之下還過著和平的生活……{wait}
	} {
		#00108F而我們卻準備
		剝奪這份和平……{wait}
	}
	TextWait
	TextTalk name[0] {
		#00003F……嗯。{wait}
	} {
		#00001F但是，現在的和平
		是建立在迪塔總統他們
		利用琪雅的前提之上。{wait}
	} {
		#00003F就算大多數市民
		不清楚這個狀況……
		對我們來說卻是重大的問題。{wait}
	}
	TextWait
	TextTalk char[0] {
		#00108F……嗯，是啊。{wait}
	} {
		#00103F要靠犧牲琪雅
		才能得到的和平，
		絕對是錯的。{wait}
	} {
		#00100F……呵呵，謝謝你，羅伊德。
		多虧有你，
		讓我稍微不再那麼迷惘了。{wait}
	}
	TextWait
	TextTalk name[0] {
		#00009F哈哈，很高興能幫上妳。{wait}
	} {
		#00000F為了搶回琪雅……
		這次作戰
		一定要成功。{wait}
	}
	TextWait
	TextTalk char[0] {
		#00100F是啊……一起加油吧。{wait}
	}
	TextWait
	FlagSet flag[3760]
	Return

