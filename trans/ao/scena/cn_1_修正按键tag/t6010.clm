fn[24]:
	TextStart self
	if flag[3385]:
		if !flag[3]:
			TextTalk self {
				哦，你們是賽爾蓋那邊的孩子們啊──{wait}
			}
			TextWait
			TextTalk self {
				其實因為人手不足，
				所以我奉命負責警察學校
				附近的警備任務呢──{wait}
			}
			TextWait
			TextTalk self {
				雖然是久違的現場指揮，
				不過為了各位年輕警察，
				我得想辦法達成任務才行。{wait}
			}
			TextWait
			FlagSet flag[3]
		else:
			TextTalk self {
				自從當上公共安全課的課長之後，
				雖然文書工作比較多，不過……{wait}
			}
			TextWait
			TextTalk self {
				在這種非常時期，
				為了各位年輕警察，
				我得想辦法達成任務才行。{wait}
			}
			TextWait
	TextEnd self
	Return

