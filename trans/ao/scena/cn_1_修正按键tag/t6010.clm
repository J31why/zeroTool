fn[17]:
	var[0] = 0
	while var[0] != 255:
		FadeOut 300ms 0x00000000 100
		FadeWait
		TextSetPos 173 40 -1 -1
		TextSetName ""
		Menu menu[0] -1 -1 1
			"【關於教團】" // 0
			"【關於真知】" // 1
			"【關於御子】" // 2
			"【什麼都不做】" // 3
		MenuWait var[0]
		MenuClose menu[0]
		TextClose 0
		FadeIn 300ms 0x00000000
		FadeWait
		TextSetPos -1 280 60 3
		switch var[0]:
			case 0:
				SoundPlay sound[72] 0 100 0
				Call fn[0,18]
				break
			case 1:
				SoundPlay sound[72] 0 100 0
				Call fn[0,19]
				break
			case 2:
				SoundPlay sound[72] 0 100 0
				Call fn[0,20]
				break
			case 3:
				var[0] = 255
				break
			default:
				var[0] = 255
				break
	Return

fn[18]:
	FadeOut 300ms 0x00000000 100
	TextSetPos -1 -1 44 -1
	if global[2] == 0:
		TextSetName ""
		TextMessage null {
