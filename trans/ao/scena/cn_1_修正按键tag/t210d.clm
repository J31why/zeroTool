calmare ao_k scena
scena:
	name "t210d" "t210d" "t210d"
	town town[89]
	bgm bgm[151]
	flags 8192
	item_use fn[0,255]
	unk 255 28

entry:
	pos (0, 0, -1000)
	unk1 0
	cam_from (0, 0, 24000)
	cam_pers 500
	unk2 30
	cam_deg 45deg
	cam_limit 0deg 360deg
	cam_at (0, 0, 0)
	unk3 0
	unk4 0
	flags 0x0001
	town town[1]
	init fn[0,1]
	reinit fn[0,2]

chip[0] "chr/ch12200.itc"
chip[1] "chr/ch41400.itc"
chip[2] "chr/ch41800.itc"
chip[3] "chr/ch33000.itc"

npc char[0]:
	name "索妮亞司令"
