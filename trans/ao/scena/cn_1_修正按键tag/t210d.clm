look_point[0]:
	pos (1500, 5050, -20000)
	radius 1200
	bubble_pos (1500, 6050, -20000)
	unk1 124
	unk2 0
	function fn[0,3]
	unk3 0
	unk4 0

fn[0]:
	switch random % 8:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if flag[3385]:
		CharFlagsUnset char[3] 0x0080
	Return

fn[2]:
	if flag[3355]:
		system[1] = 566
	if flag[3100]:
		MapColor 0x00FFEBDC 0ms
	else:
	if !flag[3950]:
		ObjFrame object[2] 0
	else:
		ObjFrame object[2] 30
	Return

fn[3]:
	ED7_F2 1
	SystemFlagsSet 0x08000000
	if !flag[3950]:
		SoundPlay sound[14] 0 100 0
		ED7_74 object[2] 0 30
		ED7ObjPlay object[2] 0 30 0 0
		Sleep 500ms
		if ItemAdd item[500] 1:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextSetName ""
			TextMessage name[742] {
				{color 0}已取得{item[500]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			TextSetPos -1 280 60 3
			FadeIn 300ms 0x00000000
			FlagSet flag[3950]
			ED7_DE 5
		else:
			FadeOut 300ms 0x00000000 100
			TextSetName ""
			TextMessage name[742] {
				寶箱裡裝有{item[500]}{color 0}。
				因持有物品已達上限，已放棄{item[500]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			SoundPlay sound[15] 0 100 0
			ED7ObjPlay object[2] 30 0 0 0
	else:
		FadeOut 300ms 0x00000000 100
		TextSetPos -1 -1 -1 -1
		TextSetName ""
		TextMessage name[742] {
			{0x06}{color 5}寶箱裡什麼都沒有。{color 0}{wait}
		}
		TextWait
		TextClose 0
		FadeIn 300ms 0x00000000
	Sleep 30ms
	TextEnd null
	SystemFlagsUnset 0x08000000
	Return

fn[4]:
	if !flag[3424]:
		Call fn[0,8]
		Return
	TextStart self
	if !flag[0]:
		TextTalk char[0] {
			#10600F關於今後的處理方式，
			道格拉斯副司令正在和
			麥克道爾議長討論。{wait}
		} {
			我身為正規軍的司令官，
			必須使面對帝國與共和國的警戒體制
			處於萬全的狀態。{wait}
		} {
			#10603F雖然還不知道在一切結束後
			要怎麼做，不過……{wait}
		} {
			#10600F我現在只管把司令官的份內工作
			盡可能做好就是了。{wait}
		}
		TextWait
		FlagSet flag[0]
	else:
		TextTalk char[0] {
			#10603F雖然還不知道在一切結束後
			要怎麼做，不過……{wait}
		} {
			#10600F我現在只管把司令官的份內工作
			盡可能做好就是了。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[5]:
	TextStart self
	if !flag[1]:
		TextTalk char[1] {
			據說帝國在內戰發生時
			開發了類似
			『飛行軍艦』的東西。{wait}
		}
		TextWait
		TextTalk char[1] {
			如果那種東西加進帝國軍的
			機甲師團，老實說，
			就應付不來了……{wait}
		}
		TextWait
		TextTalk char[1] {
			要是有那台《神機》就好了……
			只有我會忍不住
			這麼想嗎……{wait}
		}
		TextWait
		FlagSet flag[1]
	else:
		TextTalk char[1] {
			萬一『飛行軍艦』那種東西
			加入機甲師團，
			帝國軍就會變得所向無敵。{wait}
		}
		TextWait
		TextTalk char[1] {
			要是有那台《神機》就好了……
			只有我會忍不住
			這麼想嗎……{wait}
		}
		TextWait
	TextEnd self
	Return

fn[6]:
	TextStart self
	if !flag[2]:
		TextTalk char[2] {
			我認為失去了《神機》
			是一件好事。{wait}
		}
		TextWait
		TextTalk char[2] {
			因為我覺得
			就憑我們實在不該使用
			那麼強大的兵器。{wait}
		}
		TextWait
		FlagSet flag[2]
	else:
		TextTalk char[2] {
			《神機》……我認為我們
			不可能掌控得了那種兵器。{wait}
		}
		TextWait
		TextTalk char[2] {
			……看到加雷利亞要塞的慘狀，
			我到現在還是會背脊發涼。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[7]:
	TextStart self
	if flag[3385]:
		if !flag[3]:
			TextTalk char[3] {
				我想要想辦法回帝國，
				所以來到貝爾加德門，但是……{wait}
			}
			TextWait
			TextTalk char[3] {
				沒、沒想到《加雷利亞要塞》
				會變成那樣……！{wait}
			}
			TextWait
			TextTalk char[3] {
				這、這樣的話，
				不就不可能回得去了嗎……{wait}
			}
			TextWait
			FlagSet flag[3]
		else:
			TextTalk char[3] {
				沒、沒想到《加雷利亞要塞》
				會變成那樣……！{wait}
			}
			TextWait
			TextTalk char[3] {
				這、這樣的話，
				不就不可能回得去了嗎……{wait}
			}
			TextWait
	TextEnd self
	Return

fn[8]:
	EventBegin 0
	FadeOut 500ms 0x00000000 255
	FadeWait
	system[1] = 566
	CamSetDistance -6780 12170 -1160 0ms
	ED7CamRotate 303deg 28deg 0deg 0ms
	CamPers 650 0ms
	CamZoom 12280 0ms
	CharSetPos name[0] (-8000, 10000, 500) 270deg
	CharSetPos name[1] (-7900, 10000, -500) 270deg
	CharSetPos name[2] (-7000, 10000, 1400) 270deg
	CharSetPos name[3] (-6800, 10000, -1500) 270deg
	CharSetPos custom[0] (-6000, 10000, 500) 270deg
	CharSetPos custom[1] (-5800, 10000, -500) 270deg
