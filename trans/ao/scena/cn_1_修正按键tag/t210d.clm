	CharFlags2Unset field_party[4] 0x8000
	CharFlagsUnset field_party[5] 0x0080
	CharFlags2Unset field_party[5] 0x8000
	_Char4A char[0] 255
	FadeIn 500ms 0x00000000
	FadeWait
	TextTalk name[0] {
		#12P#00002F索妮亞司令……
		您原來在這裡啊。{wait}
	}
	TextWait
	CharTurnTo char[0] 90deg 500deg/s
	Sleep 300ms
	TextTalk char[0] {
		#10605F#5P你們……{wait}
	}
	TextWait
	_59
	CrossFade 500ms
	CamSetDistance -68290 12670 -3030 0ms
	ED7CamRotate 239deg 21deg 0deg 0ms
	CamPers 650 0ms
	CamZoom 127990 0ms
	FadeWait
	ED7CamRotate 303deg 17deg 0deg 40000ms
	Sleep 1000ms
	TextSetPos -1 280 -1 3
	TextMessage name[3] {
		#00301F……還真驚人。{wait}
	} {
		#00303F雖然我有看過
		那個白色人偶把列車砲
		消滅得不留痕跡的影像……{wait}
	}
	TextWait
	_59
	TextMessage name[0] {
		#00008F……是琪雅的力量
		間接造成了
		這樣的狀況吧……{wait}
	}
	TextWait
	_59
	TextMessage char[0] {
		#10603F……這是從帝國
		那邊傳來的
		未經過證實的情報……{wait}
	} {
		#10600F聽說在那台《神機》的攻擊下，
		帝國軍幾乎沒有
		人員上的傷亡喔。{wait}
	}
	TextWait
	_59
	TextMessage name[0] {
		#12P#00005F真、真的嗎！？{wait}
	}
	TextWait
	_59
	TextMessage name[1] {
		#12P#00105F以、以那個狀況來看，
		這只能說是奇蹟吧……{wait}
	}
	TextWait
	_59
	TextMessage char[0] {
		#10600F因為無法做確認，
		所以並不知道實際上是如何……{wait}
	} {
		#10604F但也許那是
		不牽連人類，只消滅
		無機物的力量。{wait}
	}
	TextWait
	_59
	TextMessage name[2] {
		#12P#00202F假如那是事實，
		可能是琪雅下意識地
		干涉了《奇蹟》。{wait}
	} {
		#00204F雖然帝國確實損失慘重……
		這消息還是令人稍微
		鬆了一口氣。{wait}
	}
	TextWait
	_59
	TextSetPos -1 280 60 3
	CrossFade 500ms
	CamSetDistance -6780 12170 -1160 0ms
	ED7CamRotate 303deg 28deg 0deg 0ms
	CamPers 650 0ms
	CamZoom 12280 0ms
	FadeWait
	TextTalk char[0] {
		#10604F#5P……我有聽到關於你們的消息。{wait}
	} {
		#10602F據說克洛斯貝爾市的解放作戰
		進行得很成功，太好了呢。{wait}
	}
	TextWait
	TextTalk name[3] {
		#12P#00309F哈哈，老實說是運氣太好了啦。{wait}
	}
	TextWait
	if PartyPosition name[8] > -1:
		TextTalk name[8] {
			#12P#10104F這都是托索妮亞司令的福！{wait}
		} {
			#10102F正因為妳給了那個建議，
			才能夠找到獨立無效宣言
			這條活路呀！{wait}
		}
		TextWait
	elif PartyPosition name[4] > -1:
		TextTalk name[4] {
			#12P#10400F呵呵，這是司令妳的功勞吧。{wait}
		} {
			#10404F正因為有妳的那個建議，
			才成功找出獨立無效宣言
			這條活路。{wait}
		}
		TextWait
	elif PartyPosition name[5] > -1:
		TextTalk name[5] {
			#12P#10704F都是托您的福。{wait}
		} {
			#10702F正因為有您的建言，
			才能找到獨立無效宣言
			這條活路。{wait}
		}
		TextWait
	TextTalk char[0] {
		#10602F#5P呵呵，我什麼都沒做。
		一切都是你們辦到的事……{wait}
	} {
		#10603F……若說我做了什麼，就只有
		遵從總統的方針
		指揮國防軍而已。{wait}
	} {
		#10608F在獨立國的正當性受損的如今，
		我這個人也許已經
		沒資格當司令官了。{wait}
	}
	TextWait
	Emote field_party[0] 0mm 2000mm 38 38 250ms 1
	Sleep 10ms
	Emote field_party[1] 0mm 2000mm 38 38 250ms 1
	Emote field_party[2] 0mm 2000mm 38 38 250ms 1
	Sleep 10ms
	Emote field_party[3] 0mm 2000mm 38 38 250ms 1
	Emote field_party[4] 0mm 2000mm 38 38 250ms 1
	Sleep 10ms
	Emote field_party[5] 0mm 2000mm 38 38 250ms 1
	Sleep 1000ms
	TextTalk name[0] {
		#12P#00011F這、這個……{wait}
	}
	TextWait
	if PartyPosition name[9] > -1:
		TextTalk name[9] {
			#12P#00606F……我認為您沒必要
			那麼苦惱。{wait}
		}
		TextWait
	elif PartyPosition name[4] > -1:
		TextTalk name[4] {
			#12P#10406F……妳應該沒必要
			那麼想不開吧？{wait}
		}
		TextWait
	elif PartyPosition name[8] > -1:
		TextTalk name[8] {
			#12P#10113F不、不需要
			那麼想不開吧……！？{wait}
		}
		TextWait
	TextTalk char[0] {
		#10602F#5P呵呵，我當然明白
		我現在該做什麼。{wait}
	} {
		#10604F雖然還不知道在一切結束後
		要怎麼做，不過……{wait}
	} {
		#10600F我現在只管把司令官的份內工作
		盡可能做好就是了。{wait}
	}
	TextWait
	_59
	FadeOut 1000ms 0x00000000 255
