fn[0]:
	switch random % 8:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if QuestFlagsGet quest[133] 0x02 && !QuestFlagsGet quest[133] 0x10 && !QuestFlagsGet quest[133] 0x40 && flag[2993]:
		Event fn[0,5]
	if QuestFlagsGet quest[133] 0x10 && !flag[2848]:
		CharFlagsUnset char[0] 0x0080
		CharFlagsUnset char[1] 0x0080
		CharFlagsUnset char[2] 0x0080
		CharFlagsSet char[1] 0x0002
		CharFlagsSet char[2] 0x0002
		char[1].45 = 450
		char[1].46 = 450
		char[1].47 = 450
		char[2].45 = 450
		char[2].46 = 450
		char[2].47 = 450
	Return

fn[2]:
	if flag[2848] && !flag[2858] | flag[2369] && system[4] == 1:
		ED7_76_0 object[255] "hikari00_add" 1
		ED7_76_0 object[255] "hikari01_add" 1
		SoundPlay sound[128] 1 50 0
	if !flag[3385] && flag[3370]:
		MapColor 0x00E6D2D2 0ms
		ED7_76_0 object[255] "hikari00_add" 1
		ED7_76_0 object[255] "hikari01_add" 1
	Return

fn[3]:
	TextSetName ""
	TextMessage null {
		{color 5}有一本導力車雜誌『車迷月刊vol.3』。{color 0}{wait}
	}
	TextWait
	TextClose 0
	_59
	TextSetPos -1 280 60 3
	if flag[393] && !ItemHas item[884] 0:
		SoundPlay sound[17] 0 100 0
		TextSetPos -1 -1 -1 -1
		TextSetName ""
		TextMessage null {
			記住了
			{color 2}『穩重配色』{color 0}的噴漆樣式。{wait}
		}
		TextWait
		TextClose 0
		_59
		TextSetPos -1 280 60 3
		ItemAdd item[884] 1
	TextEnd null
	Return

fn[4]:
	TextStart char[0]
	if !flag[3018]:
		TextTalk char[0] {
			嘻嘻嘻！不過啊……
			還真是辛苦你們了。{wait}
		}
		TextWait
		TextTalk char[0] {
			多虧你們的幫忙，說不定終於可以找到
			這對姊妹人偶的買家囉。{wait}
		}
		TextWait
		TextTalk name[1] {
			#00101F那個……伊美黛夫人，
			妳不會害怕嗎？{wait}
		} {
			#00106F妳這樣子把會作祟的人偶
			賣掉的話，
			會、會不會被詛咒啊……？{wait}
		}
		TextWait
		TextTalk char[0] {
			嘻嘻嘻！要是我會怕鬼，
			哪有辦法做這種生意咧！？{wait}
		}
		TextWait
		TextTalk char[0] {
			說到存放在這倉庫裡的東西，
			還有幾樣詭異的玩意呢。{wait}
		}
		TextWait
		TextTalk char[0] {
			不然這樣吧？你們要不要摸看看
			讓每一任主人都遭遇不幸的問題戒指呢？{wait}
		}
		TextWait
		if system[10] != 255:
			Emote field_party[0] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Sleep 50ms
		if system[11] != 255:
			Emote field_party[1] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Sleep 50ms
		if system[12] != 255:
			Emote field_party[2] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Sleep 50ms
		if system[13] != 255:
			Emote field_party[3] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
		Sleep 1000ms
		TextTalk name[0] {
			#00012F不、不用了。{wait}
		}
		TextWait
		TextTalk name[2] {
			#00203F（……也許就是因為她
			　把這種東西放在同一個地方，
			　才會讓這裡變成靈力集結的場所吧。）{wait}
		}
		TextWait
		TextTalk name[3] {
			#00306F（結、結果這個老婆婆就是原因喔……？）{wait}
		}
		TextWait
		FlagSet flag[3018]
	else:
		TextTalk char[0] {
			多虧你們的幫忙，說不定終於可以找到
			這對姊妹人偶的買家囉。{wait}
		}
		TextWait
		TextTalk char[0] {
			嘻嘻嘻！我要好好
			謝謝你們才行。{wait}
		}
		TextWait
	TextEnd char[0]
	Return

