		也都有不尋常的舉動……{wait}
	} {
		#1110010150V#00101F魯巴徹毀滅所帶來的餘波
		似乎正在檯面下展開了。{wait}
	}
	TextWait
	TextTalk char[0] {
		#1110100076V#01006F#6P說是檯面下，
		應該是有點露骨了吧。{wait}
	} {
		#1110100077V#01000F這個月底還有通商會議。{wait}
	} {
		#1110100078V你們也會變得相當忙碌吧。{wait}
	}
	TextWait
