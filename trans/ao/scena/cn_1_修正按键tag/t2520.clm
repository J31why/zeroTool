fn[22]:
	TextTalk name[0] {
		#6P#00000F嗯，那就拜託你了。{wait}
	}
	TextWait
	TextTalk char[1] {
		#11P嗯，太感謝你們了。{wait}
	}
	TextWait
	TextTalk char[1] {
		#11P──正如委託上所寫，
		最近我們收到
		神秘『黑色魔獸』的目擊情報。{wait}
	}
	TextWait
	TextTalk char[1] {
		#11P在阿爾摩利卡村附近，
		似乎有農作物跟家畜等
		災情發生。{wait}
	}
	TextWait
	TextTalk name[1] {
		#6P#00105F黑色魔獸……
		我記得似乎有在哪裡
		聽過呢。{wait}
	}
	TextWait
	TextTalk name[3] {
		#6P#00303F我也記得有聽過
		襲擊農作物的事件呢。{wait}
	}
	TextWait
	TextTalk name[8] {
		#10105F說不定……
		和以前發生的
		『狼型魔獸』事件很類似呢。{wait}
	} {
		#10103F那時的犯人是
		黑手黨操縱的軍犬……{wait}
	}
	TextWait
	TextTalk char[1] {
		#11P……那個事件
		我也有看過報告，
		讓人有點在意呢。{wait}
	}
	TextWait
	TextTalk char[1] {
		#11P實際上，
		魯巴徹雖然瓦解，但是他們擁有的
		大多數軍犬都不知去向。{wait}
	}
	TextWait
	TextTalk char[1] {
		#11P可能性絕對不會太低吧。{wait}
	}
	TextWait
	TextTalk name[2] {
		#00200F警備隊已經調查到
		什麼程度了呢？{wait}
	}
	TextWait
	TextTalk char[1] {
		#11P受害現場跟
		周圍居民的調查
		大致上都結束了。{wait}
	}
	TextWait
	TextTalk char[1] {
		#11P結果，我們得知
		『黑色魔獸』是從
		古戰場方向過來的。{wait}
	}
	TextWait
	TextTalk char[1] {
		#11P因此我想請你們
		前往古戰場。{wait}
	}
	TextWait
	TextTalk char[1] {
		#11P調查這些魔獸，
		可以的話就擊退他們。{wait}
	}
	TextWait
	TextTalk name[4] {
		#6P#10302F我大概瞭解事情經過了。{wait}
	} {
		#10303F話說回來，看來你們
		似乎真的很忙，是嗎？{wait}
	} {
		#10300F我還以為
		這種工作是由
		警備隊負責才對……{wait}
	}
	TextWait
	TextTalk char[1] {
		#11P雖然我也想這麼做……
		不過就像我剛才說的，
		警備隊目前是高度戒備狀態。{wait}
	}
	TextWait
	TextTalk char[1] {
		#11P被認為是克洛斯貝爾市襲擊犯的
		《紅色星座》也消失無蹤，
		連一點線索都沒有。{wait}
	}
	TextWait
	TextTalk char[1] {
		#11P再加上，帝國跟共和國
		打算開始進行大規模演習的
		這個狀況……{wait}
	}
	TextWait
	if QuestFlagsGet quest[147] 0x02:
		TextTalk char[1] {
			#11P為了不讓剛才的事重演，
			身為警備隊，有必要特別加強
			國界的警備吧。{wait}
		}
		TextWait
	else:
		TextTalk char[1] {
			#11P身為警備隊，有必要特別加強
			國界的警備吧。{wait}
		}
		TextWait
	TextTalk name[1] {
		#6P#00108F《不戰條約》締結之前……
		變成和當時一樣的
		狀況了呢。{wait}
	}
	TextWait
	TextTalk char[1] {
		#11P……嗯。{wait}
	}
	TextWait
	TextTalk char[1] {
		#11P就算是魔獸造成的災情，
		在這種狀況下，
		優先順序也會因此降低。{wait}
	}
	TextWait
	TextTalk char[1] {
		#11P畢竟沒有發現
		非常嚴重的災情，
		實在無法撥出人手呢。{wait}
	}
	TextWait
	TextTalk name[3] {
		#6P#00304F……的確，
		現在不是讓警備隊
		去擊退魔獸的時候呢。{wait}
	}
	TextWait
	TextTalk name[0] {
		#6P#00003F……我大概瞭解狀況了。{wait}
	} {
		#00000F那麼，『黑色魔獸』的調查
		就交給我們吧。{wait}
	}
	TextWait
	TextTalk char[1] {
		#11P嗯，很抱歉。{wait}
	}
	TextWait
	TextTalk char[1] {
		#11P那就拜託你們了，特務支援課。{wait}
	}
	TextWait
	FadeOut 300ms 0x00000000 100
	SoundPlay sound[80] 0 100 0
	TextSetPos -1 -1 -1 -1
	TextSetName ""
	TextMessage null {
		開始進行{color 2}委託【調查古戰場】{color 0}！{wait}
	}
	TextWait
	TextClose 0
	FadeIn 300ms 0x00000000
	FadeWait
	_59
	TextSetPos -1 280 60 3
	FadeOut 1000ms 0x00000000 255
	FadeWait
	FlagSet flag[3292]
	QuestTaskSet quest[145] 0
	ED7_Cam69 255 0
	CharSetPos field_party[0] (2710, 0, -330) 270deg
	CharFlagsSet field_party[4] 0x0080
	CharFlags2Set field_party[4] 0x8000
	CharFlagsSet field_party[5] 0x0080
	CharFlags2Set field_party[5] 0x8000
	EventEnd 5
	Return

