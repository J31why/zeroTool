				case 0:
					break
				case 1:
					QuestFlagsSet quest[105] 0x10
					break
				case 2:
					QuestFlagsUnset quest[105] 0x10
					break
		if QuestFlagsGet quest[105] 0x10:
			TextTalk name[8] {
				#10103F狂飆車輛……
				這件事好像在哪聽過。{wait}
			} {
				#10101F該不會……
				是我們以前在市內逮捕的
				那個青年幫派嗎？{wait}
			}
			TextWait
			TextTalk name[1] {
				#00101F我記得是叫《高貴之血》。
				可能性或許很高呢……{wait}
			}
			TextWait
		else:
			TextTalk name[8] {
				#10103F嗯……這種情況
				的確不太好呢。{wait}
			}
			TextWait
		TextTalk char[7] {
			#07901F在帝國・共和國都認為
			我們有治安問題的這個時候……{wait}
		} {
			#07903F如果發生波及外國人的
			意外的話，那就糟糕了。{wait}
		} {
			#07901F而且昨天才剛發生
			脫軌意外而已。{wait}
		}
		TextWait
		TextTalk name[4] {
			#10303F原來如此，克洛斯貝爾的立場
			會變得更加岌岌可危吧。{wait}
		}
		TextWait
		TextTalk char[7] {
			#07900F還有，這件事我們有跟
			警察的公共安全課
			合作處理。{wait}
		} {
			狂飆車輛的行駛路線
			也有可能在街道上，
			這邊就由我們負責。{wait}
		}
		TextWait
		TextTalk name[0] {
			#00000F原來如此……{wait}
		}
		TextWait
		TextTalk name[2] {
			#00205F具體來說，要怎樣取締
			比較好呢？{wait}
		}
		TextWait
		TextTalk char[7] {
			#07903F經由西克洛斯貝爾街道，
			到貝爾加德門再折返……
			這是他們的行車路線。{wait}
		} {
			#07900F你們先埋伏在貝爾加德門，
			確認狂飆車輛出現之後，
			再用導力車進行追蹤。{wait}
		} {
			追蹤同時聯絡公共安全課，
			讓他們在西邊出口等候。{wait}
		}
		TextWait
		TextTalk name[0] {
			#00003F原來如此……要左右夾擊啊。{wait}
		}
		TextWait
		TextTalk char[7] {
			#07900F是的，沒錯。
			……如何？可以拜託你們嗎？{wait}
		}
		TextWait
		QuestTaskSet quest[139] 0
	else:
		TextTalk char[7] {
			#07900F狂飆車輛會經由西克洛斯貝爾
			街道，到貝爾加德門再折返……
			這是他們的行車路線。{wait}
		} {
