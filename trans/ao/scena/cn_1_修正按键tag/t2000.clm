		VisWait vis[0] 0
		TextTalk name[0] {
			#00000F米蕾優三尉，辛苦妳了。{wait}
		} {
			#00004F昨天的鐵路搶修
			真是辛苦妳了。{wait}
		}
		TextWait
		TextTalk char[7] {
			#07902F嗯，搶修總算完成，
			雖然是好消息，不過……{wait}
		} {
			#07903F結果還是沒有找到
			那個巨大怪物的蹤跡。{wait}
		} {
			#07908F今天我也命令
			自治州內的巡邏部隊尋找它，
			至於找不找得到就難說了……{wait}
		}
		TextWait
		TextTalk name[4] {
			#10308F…………{wait}
		}
		TextWait
		TextTalk name[3] {
			#00303F……嗯，畢竟最優先的
			還是搶修鐵路吧。{wait}
		} {
			#00300F暫時忘掉怪物的事情，
			先專注在眼前的工作上
			比較好吧？{wait}
		}
		TextWait
		TextTalk char[7] {
			#07903F……嗯，說的也是。{wait}
		}
		TextWait
		TextTalk name[1] {
			#00100F呃，今天我們是
			看到委託才過來的。{wait}
		} {
			事不宜遲，請告訴我們
			委託內容好嗎？{wait}
		}
		TextWait
		TextTalk char[7] {
			#07900F好，我知道了。{wait}
		} {
			#07903F最近在西克洛斯貝爾街道
			常有車輛超速……也就是
			有狂飆車輛出沒。{wait}
		} {
			#07900F帝國旅客和定期巴士
			都因此而倍感困擾。{wait}
		} {
			希望你們
			可以協助取締
			這些狂飆車輛。{wait}
		}
		TextWait
		if !flag[258]:
			FadeOut 300ms 0x00000000 100
			FadeWait
