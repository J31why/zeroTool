fn[3]:
	TextStart self
	if system[106] >= 11:
		if !flag[3416]:
			Call fn[0,5]
		else:
			TextTalk char[0] {
				#1520180076V#10704F……我會暫時待在這裡
				吹一下風。{wait}
			} {
				#1520180077V#10702F你不需要著急，
				請慢慢做好準備後再來吧。{wait}
			}
			TextWait
	elif !flag[3802]:
		CharTurnToChar char[0] name[0] 0deg/s
		TextTalk char[0] {
			#10708F……明天終於……
			就要潛入克洛斯貝爾市了呢。{wait}
		} {
			#10702F明明離開沒有
			多久的時間，感覺卻
			已經很懷念了。{wait}
		}
		TextWait
		TextTalk name[0] {
			#00000F這樣啊……{wait}
		} {
			#00006F聽說因為結界消失，《神機》目前
			專注在都市防衛上……{wait}
		} {
			#00008F現在彩虹劇團的人們
			不知道怎麼樣了。{wait}
		}
		TextWait
		TextTalk char[0] {
			#10704F大概……恐怕現在也還是
			繼續在練習吧。{wait}
		} {
			不管是在何時，發生了何事，
			只為了提高演出的完成度，
			專注向前、絕不動搖……{wait}
		} {
			#10710F這就是伊莉雅小姐的意志……
			也是彩虹劇團的生活方式。{wait}
		}
		TextWait
		TextTalk name[0] {
			#00004F哈哈，的確可能是這樣。{wait}
		} {
			#00000F……在解放了克洛斯貝爾市，
			解決掉這次事件之後……
			妳打算要做什麼？{wait}
		}
		TextWait
		TextTalk char[0] {
			#10704F……我想去見見伊莉雅小姐，
			也希望能夠和原來一樣，
			以演員的身分繼續在彩虹劇團跳舞……{wait}
		} {
			雖然我有這個意思，
			只是現在還不敢確定。{wait}
		} {
			#10708F當我與伊莉雅小姐還有
			修莉她們重逢時，該說些什麼……
			就連這些事我都還沒有頭緒呢。{wait}
		}
		TextWait
		TextTalk name[0] {
			#00006F……這樣啊。{wait}
		} {
			#00000F可是，伊莉雅小姐還有
			彩虹劇團的成員，
			大家都一定會接受妳的。{wait}
		} {
			不用想得太複雜，現在只要
			專注在自己眼前的事情就好了吧？{wait}
		}
		TextWait
		TextTalk char[0] {
			#10704F……呵呵，你說得沒錯。{wait}
		}
		TextWait
		TextTalk name[0] {
			#00003F總之，不先解放
			克洛斯貝爾市，什麼事都不用談。{wait}
		} {
			#00000F明天我們彼此都要努力啊。{wait}
		}
		TextWait
		TextTalk char[0] {
			#10702F是……！{wait}
		}
		TextWait
		CharTurnTo char[0] 90deg 0deg/s
		FlagSet flag[3802]
	else:
		CharTurnToChar char[0] name[0] 0deg/s
		TextTalk char[0] {
			#10704F今晚我打算在這裡靜靜看著月亮，
			安定一下心情。{wait}
		} {
			#10710F為了解放克洛斯貝爾市與
			彩虹劇團……明天我們還要
			打起十足精神努力才行呢。{wait}
		}
		TextWait
		CharTurnTo char[0] 90deg 0deg/s
	TextEnd self
	Return

fn[4]:
	TextStart self
	if !flag[3806]:
		TextTalk char[1] {
			#01200F#3C明天的克洛斯貝爾市解放作戰……
			我也打算要以
			偵查隊的身分進入城市裡面。{wait}
		} {
			#01203F雖然和你們會在不同的地點，
			但一有要事我會也立刻馳援的。{wait}
		}
		TextWait
		TextTalk name[0] {
			#00000F嗯，拜託你了。{wait}
		} {
			#00004F話說回來，
			在山岳地區的神狼牠們
			也都會來幫忙，對吧？{wait}
		}
		TextWait
		TextTalk char[1] {
			#01200F#3C嗯，我已經對牠們說過
			要支援警備隊的
			反抗活動了。{wait}
		} {
			只要有地形作為掩護，
			就算是對上《紅色星座》的獵兵
			也能打個不相上下吧。{wait}
		}
		TextWait
		TextTalk name[0] {
			#00000F原來如此……
			看來應該可以拜託牠們
			支援米蕾優三尉等人吧。{wait}
		}
		TextWait
		TextTalk char[1] {
			#01200F#3C嗯，畢竟我們神狼能做的
			也就只有這程度了。{wait}
		} {
			如果要救回琪雅，
			還是得靠你們自己。{wait}
		} {
			#01203F想要辦到這件事，
			一路上會有多少困難等著，
			實在是難以估計……{wait}
		}
		TextWait
		TextTalk name[0] {
			#00004F嗯……但是，不管會有什麼事等著，
			也都要救回琪雅。{wait}
		} {
			#00000F賽特你就好好看著我們吧。{wait}
		}
		TextWait
		TextTalk char[1] {
			#01200F#3C嗯……
			我會看到最後一刻的。{wait}
		}
		TextWait
		FlagSet flag[3806]
	else:
		TextTalk char[1] {
			#01200F#3C如果要救回琪雅，
			還是得靠你們自己。{wait}
		} {
			而你們是否能達成這使命……
			就讓我看到最後一刻吧。{wait}
		}
		TextWait
	TextEnd self
	Return

