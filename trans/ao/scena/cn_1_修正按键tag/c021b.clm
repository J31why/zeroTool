fn[0]:
	switch random % 8:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	CharFlagsSet char[2] 0x0010
	CharSetPos char[4] (-68850, 0, -980) 0deg
	if !flag[2]:
		CharFlagsSet char[4] 0x0010
	CharSetPos char[5] (-68700, 0, 340) 180deg
	CharFlagsSet char[5] 0x0010
	Return

fn[2]:
	Return

fn[3]:
	TextSetName ""
	TextMessage null {
		{color 5}放有『點心王國　第一卷』。{wait}
	}
	TextWait
	TextClose 0
	_59
	TextSetPos -1 280 60 3
	if ItemHas item[2] 0:
		if !RecipeLearn 19:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextSetName ""
			TextMessage null {
				記住了{color 2}『混合冰淇淋』{color 0}的食譜。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			FadeWait
			_59
			TextSetPos -1 280 60 3
	TextEnd null
	Return

fn[4]:
	Call fn[0,5]
	Return

fn[5]:
	TextStart char[0]
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"交談" // 0
			"買東西" // 1
			"放棄" // 2
		MenuWait var[0]
		if var[0] != 1:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			ShopOpen shop[201]
			var[0] = 99
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			Call fn[0,6]
	TextEnd char[0]
	Return

fn[6]:
	if !flag[0]:
		TextTalk char[0] {
			難得看到你
			這種時間
			在外面閒晃呢。{wait}
		}
		TextWait
		TextTalk char[0] {
			本店已經過了
			打烊時間，不過……{wait}
		}
		TextWait
		TextTalk char[0] {
			嗯，是你的話倒無所謂。
			別客氣，儘管看吧。{wait}
		}
		TextWait
		TextTalk name[0] {
			#00000F謝啦，奧斯卡。
			那我就不客氣了……{wait}
		}
		TextWait
		TextTalk name[9] {
			#00603F…………{wait}
		}
		TextWait
		TextTalk name[0] {
			#00006F（要、要買東西的話，
			　最好趕快買一買比較好呢。）{wait}
		}
		TextWait
		FlagSet flag[0]
	else:
		TextTalk char[0] {
			本店已經過了
			打烊時間，不過……{wait}
		}
		TextWait
		TextTalk char[0] {
			嗯，是你的話倒無所謂。
			別客氣，儘管看吧。{wait}
		}
		TextWait
	Return

fn[7]:
	TextStart self
	TextTalk self {
		好了，我差不多
		該來做整理了。{wait}
	}
	TextWait
	TextTalk self {
		麵包店要從早上三點
		就開始備料呢。
		為了明天的工作，我得早點休息。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[8]:
	TextStart self
	TextTalk self {
		我做的麵包
		賣得居然比
		奧斯卡做的還差……！？{wait}
	}
	TextWait
	TextTalk self {
		唔唔唔！明天我一定要……！{wait}
	}
	TextWait
	TextEnd self
	Return

fn[9]:
	Call fn[0,10]
	Return

fn[10]:
	TextStart char[3]
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"交談" // 0
			"買東西" // 1
			"放棄" // 2
		MenuWait var[0]
		if var[0] != 1:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			ShopOpen shop[41]
			var[0] = 99
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			TextTalk char[3] {
				哎呀，歡迎光臨，
				請問你需要什麼嗎？{wait}
			}
			TextWait
			TextTalk char[3] {
				本店稍後
				才會打烊，請慢慢逛
				沒關係喔。{wait}
			}
			TextWait
	TextEnd char[3]
	Return

fn[11]:
	TextStart self
	if !flag[2]:
		Call fn[0,12]
	else:
		TextTalk self {
			呵呵，桃真是的，
			好像玩得很開心呢。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[12]:
	_Char4A char[4] 255
	_Char4A char[5] 255
	TextTalk char[5] {
		……然後啊，還有喔。
		龍他打算
		偷偷溜進蘭花塔。{wait}
	}
	TextWait
	TextTalk char[5] {
		結果，害桃和安里
		也被警察罵了……{wait}
	}
	TextWait
	TextTalk char[4] {
		哎呀哎呀……
		那還真是糟糕呢。{wait}
	}
	TextWait
	TextTalk char[5] {
		可是呢，
		我覺得非常開心……！{wait}
	}
	TextWait
	FlagSet flag[2]
	FlagSet flag[3]
	CharFlagsUnset char[4] 0x0010
	_Char4B char[4] 255
	_Char4B char[5] 255
	Return

fn[13]:
	TextStart self
	if !flag[3]:
		Call fn[0,12]
	else:
		TextTalk self {
			不過，龍很搞笑喔。
			他想要把錯全部
			推到安里身上……{wait}
		}
		TextWait
		TextTalk self {
			但是馬上就漏餡了，
			然後他又被罵得更慘了。
			嘻嘻嘻……{wait}
		}
		TextWait
	TextEnd self
	Return
