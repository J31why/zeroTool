			擔任緊急的支援人手，
			所以恰可也決定要留下來了。{wait}
		}
		TextWait
		TextTalk char[0] {
			雖然覺得做了
			有點對不起爸爸的事情，
			但他一定可以諒解的。{wait}
		}
		TextWait
