	Return

fn[11]:
	TextTalk char[1] {
		ＯＫ。
		你想問什麼呢？{wait}
	}
	TextWait
	var[3] = 0
	while var[3] != 255:
		FadeOut 300ms 0x00000000 100
		Menu menu[1] -1 -1 1
			"關於戰術導力器" // 0
			"關於結晶迴路" // 1
			"關於插槽解鎖" // 2
			"關於強化插槽" // 3
			"關於導力魔法（魔法）" // 4
			"關於ＥＮＩＧＭＡⅡ" // 5
			"關於核心迴路" // 6
			"放棄" // 7
		MenuWait var[3]
		MenuClose menu[1]
		if var[3] != 7 && var[3] != -2:
			FadeIn 300ms 0x00000000
			_59
		switch var[3]:
			case 0:
				TextTalk char[1] {
					《戰術導力器》是特別設計，
					專供戰鬥使用的
					小型攜帶式導力器。{wait}
				}
				TextWait
				TextTalk char[1] {
					不僅可以強化使用者的能力，
					還能輔助我們使用導力魔法。{wait}
				}
				TextWait
				TextTalk char[1] {
					一般也常直接稱呼它為
					『導力器』。{wait}
				}
				TextWait
				TextTalk char[1] {
					導力器可以完美地
					配合個人進行調整，所以
					構造也會依持有人而改變。{wait}
				}
				TextWait
				TextTalk char[1] {
					有些插槽有限定屬性，
					連接插槽的線的形式也不太一樣。
					可以比較一下大家的導力器看看喔。{wait}
				}
				TextWait
				break
			case 1:
				TextTalk char[1] {
					結晶迴路是用耀晶石提煉而成的，
					是導力器專用的結晶狀迴路。{wait}
				}
				TextWait
				TextTalk char[1] {
					只要提供迴路所需的耀晶石，
					我們就可以幫忙合成。{wait}
				}
				TextWait
				TextTalk char[1] {
					不同的結晶迴路有不同的效果，
					屬性值累積到某個程度以上，
					就能使用導力魔法。{wait}
				}
				TextWait
				TextTalk char[1] {
					蒐集到耀晶石之後，可以多方嘗試看看喔。{wait}
				}
				TextWait
				break
			case 2:
				TextTalk char[1] {
					導力器的插槽
					一開始幾乎都是未解鎖的狀態。{wait}
				}
				TextWait
				TextTalk char[1] {
					所以安裝結晶迴路之前，
					需要進行插槽的解鎖。{wait}
				}
				TextWait
				TextTalk char[1] {
					只要將插槽解鎖，
					就能安裝很多結晶迴路，
					ＥＰ上限也會提昇。{wait}
				}
				TextWait
				TextTalk char[1] {
					解鎖時會需要使用耀晶石，
					不過早點解鎖是沒有壞處的喔。{wait}
				}
				TextWait
				break
			case 3:
				TextTalk char[1] {
					在結晶迴路中，
					有些被稱為『高階結晶迴路』。{wait}
				}
				TextWait
				TextTalk char[1] {
					這些結晶迴路太過強大，
					沒辦法裝在一般的插槽裡。{wait}
				}
				TextWait
				TextTalk char[1] {
					所以插槽本身
					必須經過強化才行。{wait}
				}
				TextWait
				TextTalk char[1] {
					強化跟解鎖一樣都需要耀晶石，
					但也可以提高ＥＰ上限。{wait}
				}
				TextWait
				TextTalk char[1] {
					我覺得是不需要急著強化啦，
					但強化可以說是提昇
					導力器威力不可或缺的要素。{wait}
				}
				TextWait
				break
			case 4:
				TextTalk char[1] {
					使用戰術導力器發動的魔法，
					就是所謂的導力魔法。{wait}
				}
				TextWait
				TextTalk char[1] {
					導力魔法也常常簡稱為『魔法』。{wait}
				}
				TextWait
				TextTalk char[1] {
					這會依照安裝的結晶迴路的
					『每一條線的屬性值總和』，
					來決定可以發動的魔法的種類。{wait}
				}
				TextWait
				TextTalk char[1] {
					也就是說，
					安裝的結晶迴路屬性值越高，
					能用的魔法也越多。{wait}
				}
				TextWait
				TextTalk char[1] {
					順道一提，
					如果想使用更強力的魔法，
					屬性值的組合也會變得非常重要。{wait}
				}
				TextWait
				TextTalk char[1] {
					這方面的詳細資訊
					都條列在搜查手冊上面，
					記得參考一下喔。{wait}
				}
				TextWait
				break
			case 5:
				TextTalk char[1] {
					繼承ＥＮＩＧＭＡ的通訊功能，
					再加上大膽改造的後繼機種──
					就是『ＥＮＩＧＭＡⅡ』。{wait}
				}
				TextWait
				TextTalk char[1] {
					唯一且最大的變更點，
					就是能夠支援名叫『核心迴路』的
					特殊結晶迴路。{wait}
				}
				TextWait
				TextTalk char[1] {
					順道一提，雖然一般都是這樣……
					但透過這次的昇級，
					基本的構造也將有所改變。{wait}
				}
				TextWait
				TextTalk char[1] {
					基於相容性的問題，
					舊ＥＮＩＧＭＡ上用的結晶迴路
					都是無法安裝上去的。{wait}
				}
				TextWait
				TextTalk char[1] {
					所以啦，如果要使用ＥＮＩＧＭＡⅡ，
					就需要新規格的結晶迴路。{wait}
				}
				TextWait
				break
			case 6:
				TextTalk char[1] {
					核心迴路是
					鑲嵌在ＥＮＩＧＭＡⅡ中央的
					特殊結晶迴路。{wait}
				}
				TextWait
				TextTalk char[1] {
					這跟舊型結晶迴路之間有個決定性的
					差異，就是它本身會『成長』。{wait}
				}
				TextWait
				TextTalk char[1] {
					只要在導力器安裝有核心迴路的
					狀態下進行多次戰鬥，就能
					提昇等級，發揮更強的效果。{wait}
				}
				TextWait
				TextTalk char[1] {
					強化使用者的能力，
					結晶迴路的特殊效果，還有屬性值……
					成長要素大致上就是以上三點。{wait}
				}
				TextWait
				TextTalk char[1] {
					順道一提，不管是哪一種
					核心迴路，只要耐心培育到最後，
					好像都會變得非常強大喔。{wait}
				}
				TextWait
				TextTalk char[1] {
					再加上昇級似乎要花費
					非常多的時間……{wait}
				}
				TextWait
				TextTalk char[1] {
					重點或許就在於不要三心二意，
					持續使用自己喜歡的核心迴路。{wait}
				}
				TextWait
				break
			default:
				var[3] = 255
				break
	Sleep 150ms
	var[3] = 0
	Return

