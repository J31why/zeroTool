fn[0]:
	if system[0] == 101:
		Event fn[0,4]
	if flag[272]:
		FlagUnset flag[272]
		FlagSet flag[0]
		FlagSet flag[1]
		Event fn[0,24]
	elif flag[273]:
		FlagUnset flag[273]
		Event fn[0,27]
	Return

fn[1]:
	ED7_EE 1 800
	if flag[0]:
		system[1] = 0
		FlagUnset flag[0]
	if flag[3395]:
		ED7_76_1 object[255] "magi10_add" 1
		ED7_76_1 object[255] "magi11_add" 1
		ED7_76_1 object[255] "point_add" 1
		ED7_76_0 object[255] "magi_04_add" 1
		ED7_76_1 object[255] "hasira_7s" 1
		ED7_76_1 object[255] "hasira_0s" 1
		ED7_76_0 object[255] "hasira_5d" 1
		ED7_76_0 object[255] "hasira_6n" 1
		ED7_76_0 object[255] "hasira_0d" 1
		ED7_76_0 object[255] "hasira_0n" 1
	else:
		ED7_76_0 object[255] "magi10_add" 1
		ED7_76_0 object[255] "magi11_add" 1
		ED7_76_0 object[255] "point_add" 1
		ED7_76_1 object[255] "magi_04_add" 1
		ED7_76_0 object[255] "hasira_7s" 1
		ED7_76_0 object[255] "hasira_0s" 1
		ED7_76_1 object[255] "hasira_5d" 1
		ED7_76_1 object[255] "hasira_6n" 1
		ED7_76_1 object[255] "hasira_0d" 1
		ED7_76_1 object[255] "hasira_0n" 1
	EntranceSetFunc entrance[1] fn[0,5]
	TriggerFlagsSet trigger[0] 0x0080
	if flag[3393] && !flag[3395]:
		TriggerFlagsUnset trigger[0] 0x0080
	if flag[3395] && !flag[3397] && !flag[3396]:
		EntranceSetFunc entrance[1] fn[0,34]
	if flag[3395] && !flag[3404]:
		Call fn[0,38]
	if flag[1]:
		SoundPlay sound[124] 1 60 0
		FlagUnset flag[1]
	else:
		SoundPlay sound[124] 1 80 0
	Return

fn[2]:
	CharFlagsSet char[0] 0x0010
	TextStart char[0]
	if !flag[3702]:
		TextTalk char[0] {
			…………{wait}
		}
		TextWait
		TextTalk name[2] {
			#00203F……她好像暈過去了。
			看來沒有受到致命傷，不過……{wait}
		}
		TextWait
		if PartyPosition name[5] > -1:
			TextTalk name[5] {
				#10701F……怎麼辦？
				好像也是可以把她
				抬去梅爾卡巴……{wait}
			}
			TextWait
		else:
			TextTalk name[1] {
				#00101F怎麼辦？
				好像也是可以把她
				抬去梅爾卡巴……{wait}
			}
			TextWait
		TextTalk name[3] {
			#00301F不，最好別把
			這傢伙抬回去吧。{wait}
		} {
			#00306F要是她在艦上醒過來
			好像也會很麻煩，
			總之就先放著她別管吧。{wait}
		}
		TextWait
		TextTalk name[0] {
			#00003F是啊……
			畢竟她終究還是敵人。{wait}
		} {
			#00000F不過為了保險起見，或許應該
			至少先為她做最低限度的治療。{wait}
		}
		TextWait
		TextTalk name[1] {
			#00100F也對，那麼……{wait}
		}
		TextWait
		FadeOut 1000ms 0x00000000 255
		FadeWait
		TextSetName ""
		TextMessage null {
			{color 5}羅伊德一行人對謝莉
			做了暫時性的急救處理。{color 0}{wait}
		}
		TextWait
		TextClose 0
		_59
		FadeIn 1000ms 0x00000000
		FadeWait
		TextTalk name[1] {
			#00104F……嗯，這樣應該就行了吧。{wait}
		}
		TextWait
		TextTalk name[0] {
			#00000F那我們就出發吧。{wait}
		}
		TextWait
		FlagSet flag[3702]
	else:
		TextTalk char[0] {
			…………{wait}
		}
		TextWait
		TextSetName ""
		TextMessage null {
			{color 5}似乎完全暈過去了。{color 0}{wait}
		}
		TextWait
		TextClose 0
		_59
	TextEnd char[0]
	Return

