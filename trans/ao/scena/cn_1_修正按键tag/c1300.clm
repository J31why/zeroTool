fn[3]:
	TextStart self
	if flag[3089]:
	elif flag[3074]:
	elif flag[2861]:
		TextTalk self {
			竟然在瑪因茲發生占領事件……
			難道真是帝國在背後搞鬼嗎……？{wait}
		}
		TextWait
		TextTalk self {
			……總之，要提高警覺。{wait}
		}
		TextWait
	elif flag[2848]:
		if !flag[0]:
			TextTalk self {
				早安，特務支援課的各位。
				雖然大家都淋了雨，
				不過今天還是努力工作吧。{wait}
			}
			TextWait
			TextTalk self {
				聽蘭菲小姐說，
				雨下午好像就會停了，
				就忍耐一下吧。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				雖然大家都淋了雨，
				不過今天還是努力工作吧。{wait}
			}
			TextWait
			TextTalk self {
				聽蘭菲小姐說，
				雨下午好像就會停了，
				就忍耐一下吧。{wait}
			}
			TextWait
	elif flag[2837]:
		if !flag[0]:
			TextTalk self {
				嗯，難得會有
				這麼小的孩子
				一個人來訪。{wait}
			}
			TextWait
			TextTalk self {
				是來找
				大樓裡的家人嗎？{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				哎呀，糟糕糟糕。
				我也真是的，
				怎麼開始探起客人的底了。{wait}
			}
			TextWait
			TextTalk self {
				身為保安部的人，嘴巴可得小心點。{wait}
			}
			TextWait
	elif flag[2832]:
		TextTalk self {
			早安。
			今天早上的天氣也很舒服呢。{wait}
		}
		TextWait
		TextTalk self {
			這地方還是老樣子，
			視野良好、
			空氣又新鮮，最棒了。{wait}
		}
		TextWait
	elif flag[2816]:
		TextTalk self {
			克洛斯貝爾能否
			獨立成一個國家……
			真是值得玩味的話題呢。{wait}
		}
		TextWait
		TextTalk self {
			雖然我覺得這件事
			也和ＩＢＣ的方針有關……
			不過憑我實在想像不出細節呢。{wait}
		}
		TextWait
	elif flag[2573]:
		if !QuestFlagsGet quest[122] 0x10:
			if !flag[0]:
				TextTalk self {
					昨天我在近距離下
					看到來訪ＩＢＣ的
					洛克史密斯總統了……{wait}
				}
				TextWait
				TextTalk self {
					果然啊，一個人能當上
					統領那麼一個大國的領導者，
					連存在感都不同凡響呢。{wait}
				}
				TextWait
				TextTalk self {
					不是說他外表長得如何，
					怎麼說呢、就是可以感覺到
					氣勢之類的東西吧。{wait}
				}
				TextWait
				FlagSet flag[0]
			else:
				TextTalk self {
					話說回來，今天早上好像
					有不明人士闖進我們ＩＢＣ。{wait}
				}
				TextWait
				TextTalk self {
					雖然我想沒有
					發生什麼怪事……
					不過沒能發現他讓我很震驚。{wait}
				}
				TextWait
		else:
			TextTalk self {
				怪盜Ｂ像傳聞中的一樣，
				真是個怪人。{wait}
			}
			TextWait
			TextTalk self {
				竟然把偷來的東西
				亂丟在自治州各地……
				那傢伙到底想做什麼啊？{wait}
			}
			TextWait
	elif flag[2564]:
		if !flag[0]:
			TextTalk self {
				啊，你們等一下。
				不好意思，
				今天ＩＢＣ休息喔。{wait}
			}
			TextWait
			TextTalk self {
				說是這麼說，
				其實是洛克史密斯總統
				現在正在裡面視察啦。{wait}
			}
			TextWait
			TextTalk self {
				如果有事的話，
				麻煩明天再來吧。{wait}
			}
			TextWait
			if flag[2647]:
				TextTalk name[0] {
					#00005F總統視察嗎……？{wait}
				} {
					#00003F記得昨天蘭菲小姐
					也是這麼說的。{wait}
				}
				TextWait
			else:
				TextTalk name[0] {
					#00005F總統視察嗎……？{wait}
				}
				TextWait
			TextTalk name[3] {
				#00300F警備狀態好像
				還真不是蓋的。{wait}
			}
			TextWait
			TextTalk name[1] {
				#00100F是啊，總之我們
				還是在沒妨礙到人之前
				乖乖離開好了。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				不好意思，
				今天ＩＢＣ休息喔。{wait}
			}
			TextWait
			TextTalk self {
				如果有事的話，
				麻煩明天再來吧。{wait}
			}
			TextWait
	elif flag[2560]:
		TextTalk self {
			明天就要舉行通商會議了。{wait}
		}
		TextWait
		TextTalk self {
			街上的警戒等級已經提高，
			我們保安部自然也充滿幹勁。{wait}
		}
		TextWait
	elif flag[2369]:
		if !flag[2453]:
			if !flag[0]:
				TextTalk self {
					我剛才看到
					庫羅伊斯總裁、不對，
					是庫羅伊斯市長前來。{wait}
				}
				TextWait
				TextTalk self {
					市長基本上
					都窩在新市政廳大樓裡，
					不過有時候也會像這樣跑來。{wait}
				}
				TextWait
				TextTalk self {
					……話說回來，能兼顧兩邊
					真是不得了啊。{wait}
				}
				TextWait
				TextTalk self {
					而且兩邊的工作
					都處理得很好，
					實在令人佩服。{wait}
				}
				TextWait
				FlagSet flag[0]
			else:
				TextTalk self {
					克洛斯貝爾市長和ＩＢＣ總裁……
					仔細想想，
					能兼顧兩邊真是不得了。{wait}
				}
				TextWait
				TextTalk self {
					而且兩邊的工作
					都處理得很好，
					實在令人佩服。{wait}
				}
				TextWait
		else:
			TextTalk self {
				你問庫羅伊斯市長的話，
				他早就回市政廳了喔。{wait}
			}
			TextWait
			TextTalk self {
				動作還是那麼快。{wait}
			}
			TextWait
	elif flag[2353]:
		if !flag[0]:
			TextTalk self {
				你好。
				歡迎來到ＩＢＣ總公司大樓。{wait}
			}
			TextWait
			TextTalk self {
				有事的話請去找櫃檯吧。{wait}
			}
			TextWait
			TextTalk self {
				我們自豪的櫃檯小姐應該會
				無微不至地為你服務。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				有事的話請去找櫃檯吧。{wait}
			}
			TextWait
			TextTalk self {
				我們自豪的櫃檯小姐應該會
				無微不至地為你服務。{wait}
			}
			TextWait
	TextEnd self
	Return

