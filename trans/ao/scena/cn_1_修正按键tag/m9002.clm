fn[0]:
	while 1:
		ED7CharAnimation self 1000ms 0
	Return

fn[1]:
	while 1:
		ED7CharAnimation self 1000ms 0 1 2 3 4 5 6 7
	Return

fn[2]:
	if system[0] == 108:
		Event fn[0,8]
	if system[0] == 109:
		Event fn[0,10]
	if flag[3391] && !flag[3392]:
		Event fn[0,39]
	if flag[3395] && !flag[3397]:
		Event fn[0,40]
	if flag[272]:
		FlagUnset flag[272]
		Event fn[0,41]
	elif flag[273]:
		FlagUnset flag[273]
		Event fn[0,42]
	Return

fn[3]:
	ED7_EE 1 800
	EntranceSetFunc entrance[8] fn[0,9]
	EntranceSetFunc entrance[9] fn[0,11]
	TriggerFlagsSet trigger[0] 0x0080
	if flag[3386] && !flag[3387]:
		TriggerFlagsUnset trigger[0] 0x0080
	TriggerFlagsSet trigger[1] 0x0080
	if flag[3386] && !flag[3392]:
		if PartyPosition name[4] == -1 | !flag[3409]:
			TriggerFlagsUnset trigger[1] 0x0080
	TriggerFlagsSet trigger[2] 0x0080
	if flag[3386] && !flag[3397]:
		if PartyPosition name[5] == -1 | !flag[3410]:
			TriggerFlagsUnset trigger[2] 0x0080
	if system[4] < 7 | flag[3522]:
		TriggerFlagsSet trigger[3] 0x0080
		ObjFlagsSet object[5] 0x0004
	else:
		ED7_78 object[5] char[1]
		ObjFlagsUnset object[5] 0x0004
		CharFlagsUnset char[1] 0x0080
		CharFlagsUnset char[1] 0x0008
		CharFlagsSet char[1] 0x8000
		CharFlagsSet char[1] 0x0001
		CharSetPos char[1] (125100, 0, -64560) 207deg
		CharTurnTo char[1] 207deg 0deg/s
		char[1].7 = 8000
		char[1].40 = 9
		ED7_1D_0 0 2 0 (125100, 0, -64560) 3000 3000 207000
