				無風不起浪。{wait}
			}
			TextWait
			TextTalk char[1] {
				看看帝國至今為止的做法，
				這是真相的可能性很高……
				情況讓人不得不這麼想。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk char[1] {
				那起克洛斯貝爾攻擊事件，
