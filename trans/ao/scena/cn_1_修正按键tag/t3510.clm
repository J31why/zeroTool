fn[9]:
	Call fn[0,10]
	Return

fn[10]:
	TextStart char[1]
	if flag[3385]:
		if !flag[1]:
			TextTalk char[1] {
				自從宣布獨立宣言以來，
				這個機場也變成
				對抗兩大國攻打的迎擊據點。{wait}
			}
			TextWait
			TextTalk char[1] {
				以前襲擊城鎮的那些獵兵，
				似乎曾以總統私人部隊的身分
				進駐過這裡。{wait}
			}
			TextWait
			TextTalk char[1] {
				……真不知該怎麼說才好。
				我們相信總統的話、贊成獨立的
				這份心情，到底算什麼呢……？{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk char[1] {
				我們相信總統的話、贊成獨立的
				這份心情，到底算什麼呢……？{wait}
			}
			TextWait
	elif flag[3074]:
		if !flag[1]:
			TextTalk char[1] {
