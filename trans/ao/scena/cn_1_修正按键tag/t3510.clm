fn[0]:
	switch random % 8:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	ObjFlagsSet object[0] 0x2000000
	ObjFlagsSet object[2] 0x2000000
	ObjFlagsSet object[5] 0x2000000
	if flag[272]:
		ObjFlagsUnset object[5] 0x2000000
	elif flag[273]:
		ObjFlagsUnset object[5] 0x2000000
	if QuestFlagsGet quest[133] 0x02 && !flag[2848]:
		ObjFlagsUnset object[0] 0x2000000
	Return

fn[2]:
	if QuestFlagsGet quest[133] 0x02 && !flag[2848]:
		CharFlagsUnset char[9] 0x0080
		CharSetPos char[9] (6600, 0, -3500) 180deg
	if flag[3385]:
		CharSetPos char[0] (0, 0, -5500) 90deg
		CharSetPos char[1] (1500, 0, -5500) 270deg
		CharSetPos char[2] (340, 0, 6490) 180deg
	elif flag[3371]:
	elif flag[3089]:
	elif flag[3074]:
		CharFlagsUnset char[6] 0x0080
		CharFlagsUnset char[7] 0x0080
		CharFlagsUnset char[8] 0x0080
		CharSetChipBase char[7] chip[9]
		CharSetChipPattern char[7] 0
		ForkQuit char[7] fork[0]
		CharFlags2Set char[7] 0x0004
		CharSetChipBase char[8] chip[10]
		CharSetChipPattern char[8] 0
		ForkQuit char[8] fork[0]
		CharFlags2Set char[8] 0x0004
		if !QuestFlagsGet quest[147] 0x10 && !QuestFlagsGet quest[147] 0x40 && flag[3079] && flag[3080] && flag[3081]:
			CharFlagsUnset char[10] 0x0080
			CharSetPos char[10] (5480, 0, 5530) 90deg
			CharTurnToChar char[2] char[10] 0deg/s
	elif flag[2832]:
	elif flag[2816]:
		CharFlagsUnset char[3] 0x0080
		CharFlagsUnset char[4] 0x0080
		CharFlagsUnset char[5] 0x0080
		CharFlagsSet char[3] 0x0010
	elif flag[2573]:
	if flag[272]:
		FlagUnset flag[272]
		FlagSet flag[4]
		Event fn[0,19]
	elif flag[273]:
		FlagUnset flag[273]
		FlagSet flag[4]
		Event fn[0,21]
	elif flag[274]:
		FlagUnset flag[274]
		SystemFlagsSet 0x10000000
		Event fn[0,26]
	Return

fn[3]:
	if flag[4]:
		SoundStop sound[134]
		FlagUnset flag[4]
	else:
		SoundPlayContinuously sound[134] (5840, 0, 9630) 5000 200000 100 0
	if flag[3328]:
		LookPointFlagsSet look_point[0] 0x0001
		LookPointFlagsSet look_point[1] 0x0001
	if flag[3328]:
		TriggerFlagsSet trigger[0] 0x0080
		ObjFlagsUnset object[3] 0x0010
		ObjFlagsUnset object[4] 0x0010
	if QuestFlagsGet quest[133] 0x02 && !flag[2848]:
		ObjFlagsUnset object[0] 0x0004
	Return

fn[4]:
	if QuestFlagsGet quest[133] 0x02 && !QuestFlagsGet quest[133] 0x10 && !QuestFlagsGet quest[133] 0x40 && !flag[2989]:
		if !flag[2988]:
			Call fn[0,22]
			Return
		else:
			Call fn[0,23]
			Return
	TextStart self
	if !QuestFlagsGet quest[133] 0x10:
		if !flag[3]:
			TextTalk self {
				請你照順序到
				送錯貨物的地方，
				交換成正確的貨物。{wait}
			}
			TextWait
			TextTalk self {
				首先是瑪因茲，然後是烏爾斯拉醫院，
				最後到住宅區的民宅就可以了吧。{wait}
			}
			TextWait
			TextTalk self {
				住宅區民宅的地址
				有寫在送貨單上，最後去的時候
				你再重新確認一次。{wait}
			}
			TextWait
			TextTalk self {
				雖然很麻煩，不過就拜託你們了。{wait}
			}
			TextWait
			FlagSet flag[3]
		else:
			TextTalk self {
				首先是瑪因茲，然後是烏爾斯拉醫院，
				最後到住宅區的民宅就可以了吧。{wait}
			}
			TextWait
			TextTalk self {
				雖然很麻煩，不過就拜託你們了。{wait}
			}
			TextWait
	elif !flag[3]:
		TextTalk self {
			辛苦了，多虧有你們的幫忙。{wait}
		}
		TextWait
		TextTalk self {
			那麼，既然都順利結束了，就跟老大……{wait}
		}
		TextWait
		TextTalk self {
			不對，是跟社長報告一聲。{wait}
		}
		TextWait
		FlagSet flag[3]
	else:
		TextTalk self {
			辛苦了，多虧有你們的幫忙。{wait}
		}
		TextWait
		TextTalk self {
			下次有事的話，我會再拜託各位。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[5]:
	if !flag[3089] && !QuestFlagsGet quest[147] 0x02 && !QuestFlagsGet quest[147] 0x10 && !QuestFlagsGet quest[147] 0x40 && flag[3079] && flag[3080] && flag[3081]:
		if flag[3294]:
			Call fn[0,28]
		else:
			Call fn[0,27]
		Return
	TextStart char[10]
	TextTalk self {
		克洛斯貝爾都陷入危難了，
		居然有人騙取醫療物資……
		絕不能原諒這種事。{wait}
	}
	TextWait
	TextTalk self {
		你們一定要把
		犯人抓起來！{wait}
	}
	TextWait
	TextEnd char[10]
	Return

fn[6]:
	if !flag[3089] && !QuestFlagsGet quest[147] 0x02 && !QuestFlagsGet quest[147] 0x10 && !QuestFlagsGet quest[147] 0x40 && flag[3079] && flag[3080] && flag[3081]:
		if flag[3294]:
			Call fn[0,28]
		else:
			Call fn[0,27]
		Return
	TextStart self
	if flag[3385]:
		TextTalk char[2] {
			剛才有些警官來過這裡。
			他們似乎在調查起降場有沒有獵兵的痕跡。{wait}
		}
		TextWait
		TextTalk char[2] {
			很抱歉，請不要再往前走了。{wait}
		}
		TextWait
	elif flag[3371]:
	elif flag[3089]:
	elif flag[3074]:
		if QuestFlagsGet quest[147] 0x10:
			if !flag[2]:
				TextTalk self {
					真虧你們能將
					醫療物資找回來呢。{wait}
				}
				TextWait
				TextTalk self {
					剛才烏爾斯拉醫院說
					貨物已經送到了，
					我也總算可以放心了。{wait}
				}
				TextWait
				TextTalk self {
					為了確保以後不再發生
					這種事，我得更加
					小心確認才行呢。{wait}
				}
				TextWait
				FlagSet flag[2]
			else:
				TextTalk self {
					剛才烏爾斯拉醫院說
					貨物已經送到了，
					我也總算可以放心了。{wait}
				}
				TextWait
				TextTalk self {
					為了確保以後不再發生
					這種事，我得更加
					小心確認才行呢。{wait}
				}
				TextWait
		elif QuestFlagsGet quest[147] 0x40:
			if !flag[2]:
				TextTalk self {
					……結果，
					醫療物資被偷走了呢。{wait}
				}
				TextWait
				TextTalk self {
					不，這不是你們的錯。
					都怪我不小心被騙，是我不好。{wait}
				}
				TextWait
				TextTalk self {
					以後我得更加小心
					確認才行呢……{wait}
				}
				TextWait
				FlagSet flag[2]
			else:
				TextTalk self {
					……結果，
					醫療物資被偷走了呢。{wait}
				}
				TextWait
				TextTalk self {
					以後我得更加小心
					確認才行呢……{wait}
				}
				TextWait
		else:
			TextTalk self {
				沒想到居然會被偽造的文件欺騙……
				可惡，都是我的錯。{wait}
			}
			TextWait
			TextTalk self {
				待會還得先跟烏爾斯拉醫院
				那邊聯絡一聲才行……{wait}
			}
			TextWait
	elif flag[2832]:
		if !flag[2]:
			TextTalk self {
				卡普亞宅急便那些人
				在機場也混熟了呢。{wait}
			}
			TextWait
			TextTalk self {
				以自營的貨運公司來說，
				營收似乎非常高呢。{wait}
			}
			TextWait
			TextTalk self {
				哎呀，業務蒸蒸日上啊。{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			TextTalk self {
				卡普亞宅急便
				以自營的貨運公司來說，
				營收似乎非常高呢。{wait}
			}
			TextWait
			TextTalk self {
				哎呀，業務蒸蒸日上啊。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[7]:
	Call fn[0,8]
	Return

fn[8]:
	TextStart char[0]
	if flag[3385]:
		if !flag[0]:
			TextTalk char[0] {
				獵兵跟在城鎮上出沒的怪物消失之後，
				我姑且試著回到工作岡位，不過……{wait}
			}
			TextWait
			TextTalk char[0] {
				空運是完全無法復航的狀態，
				未來該怎麼辦呢……？{wait}
			}
			TextWait
			TextTalk char[0] {
				我們真的有辦法找回
				本來的日常生活嗎……？{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				空運是完全無法復航的狀態，
				未來該怎麼辦呢……？{wait}
			}
			TextWait
			TextTalk char[0] {
				我們真的有辦法找回
				本來的日常生活嗎……？{wait}
			}
			TextWait
	elif flag[3074]:
		if !flag[0]:
			TextTalk char[0] {
				利貝爾及雷米菲利亞
				都有大力支援這次的
				克洛斯貝爾市重建。{wait}
			}
			TextWait
			TextTalk char[0] {
				也有金援和物資，
				重建工程似乎也能
				因此較快完成。{wait}
			}
			TextWait
			TextTalk char[0] {
				身為克洛斯貝爾的居民，
				我真的很想表達謝意。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				利貝爾及雷米菲利亞
				都有大力支援這次的
				克洛斯貝爾市重建。{wait}
			}
			TextWait
			TextTalk char[0] {
				身為克洛斯貝爾的居民，
				我真的很想表達謝意。{wait}
			}
			TextWait
	elif flag[2832]:
		if !flag[0]:
			TextTalk char[0] {
				自從提倡獨立以來，似乎
				也有些客人對克洛斯貝爾的局勢
