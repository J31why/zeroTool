				情況讓人不得不這麼想。{wait}
			}
			TextWait
	elif flag[2832]:
		if !flag[1]:
			TextTalk char[1] {
				這裡是出入境的櫃檯，
				同時也負責保管隨身行李。{wait}
			}
			TextWait
			TextTalk char[1] {
