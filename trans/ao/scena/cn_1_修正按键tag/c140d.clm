fn[0]:
	switch random % 8:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharIdle self (-29690, null, -24760) (-27310, null, -30490) 1000mm/s
		Sleep 300ms
	Return

fn[2]:
	while 1:
		CharIdle self (36100, null, -37250) (30720, null, -40660) 1000mm/s
		Sleep 300ms
	Return

fn[3]:
	if system[0] == 107:
		CharSetPos field_party[0] (2050, 0, 14590) 180deg
		CharSetPos field_party[1] (2050, 0, 14590) 180deg
		CharSetPos field_party[2] (2050, 0, 14590) 180deg
		CharSetPos field_party[3] (2050, 0, 14590) 180deg
		if system[15] != 255:
			CharSetPos field_party[4] (2050, 0, 14590) 180deg
			CharSetPos field_party[5] (2050, 0, 14590) 180deg
		elif system[14] != 255:
			CharSetPos field_party[4] (2050, 0, 14590) 180deg
		CamSetDistance 2050 2000 14590 0ms
		ED7CamRotate 45deg 34deg 0deg 0ms
		CamPers 500 0ms
		CamZoom 24500 0ms
		system[0] = 100
	global[7] = 8
	CharSetChipBase char[0] chip[9]
	CharSetChipPattern char[0] 0
	ForkQuit char[0] fork[0]
	CharFlags2Set char[0] 0x0004
	if flag[3385]:
		CharFlagsUnset char[14] 0x0080
		CharSetPos char[14] (2800, 0, -4440) 270deg
		ForkFunc char[14] fork[0] fn[0,0]
		CharFlagsUnset char[12] 0x0080
		CharSetPos char[12] (1100, 0, -4440) 90deg
		CharFlagsUnset char[13] 0x0080
		CharSetPos char[13] (590, 0, -6640) 135deg
		CharFlagsUnset char[6] 0x0080
		CharSetPos char[6] (-28960, 2800, -28390) 315deg
		ForkFunc char[6] fork[0] fn[0,1]
		ForkFunc char[3] fork[0] fn[0,2]
	elif flag[3371]:
		CharFlagsSet char[4] 0x0080
		CharFlagsSet char[0] 0x0080
		CharFlagsSet char[1] 0x0080
		CharFlagsSet char[2] 0x0080
		CharFlagsSet char[3] 0x0080
	elif flag[3089]:
		CharSetPos char[3] (8290, 0, -1190) 45deg
		ForkFunc char[3] fork[0] fn[0,0]
		CharSetPos char[1] (9640, 0, 850) 180deg
		CharSetPos char[2] (10280, 0, -550) 315deg
	elif flag[3074]:
		CharFlagsSet char[4] 0x0080
		CharFlagsUnset char[6] 0x0080
		CharFlagsUnset char[8] 0x0080
		CharFlagsUnset char[7] 0x0080
		CharFlagsUnset char[9] 0x0080
		CharFlagsUnset char[10] 0x0080
		if !QuestFlagsGet quest[142] 0x10:
			CharSetPos char[9] (-200, 0, -8460) 180deg
			CharSetPos char[10] (30390, -2500, -21970) 0deg
			CharSetPos char[8] (6500, 0, 5410) 0deg
			CharSetPos char[7] (5490, 0, 5600) 0deg
		else:
			CharFlagsUnset char[15] 0x0080
			CharFlagsUnset char[11] 0x0080
			CharSetPos char[11] (2520, -10, -4059) 225deg
			CharSetPos char[9] (2120, -10, -6060) 315deg
			CharSetPos char[10] (310, -10, -4250) 90deg
			CharSetPos char[15] (10930, 0, -3700) 90deg
			CharSetPos char[8] (6500, 0, 5410) 0deg
			CharSetPos char[7] (5490, 0, 5600) 0deg
			CharFlagsSet char[7] 0x0010
		CharFlagsSet char[0] 0x0080
		CharSetPos char[1] (34490, -6500, -37750) 315deg
		CharSetPos char[2] (34490, -6500, -38950) 315deg
		CharSetPos char[3] (34840, -2220, -19610) 0deg
		ForkFunc char[3] fork[0] fn[0,0]
		if !flag[3252]:
			CharFlagsSet char[3] 0x0010
	if flag[272]:
		FlagUnset flag[272]
		Event fn[0,24]
	elif flag[273]:
		FlagUnset flag[273]
		Event fn[0,25]
	elif flag[274]:
		FlagUnset flag[274]
		SystemFlagsSet 0x10000000
		Event fn[0,45]
	Return

fn[4]:
	LookPointFlagsSet look_point[0] 0x0001
	LookPointFlagsSet look_point[1] 0x0001
	LookPointFlagsSet look_point[2] 0x0001
	LookPointFlagsSet look_point[3] 0x0001
	LookPointFlagsSet look_point[4] 0x0001
	LookPointFlagsSet look_point[5] 0x0001
	LookPointFlagsSet look_point[6] 0x0001
	LookPointFlagsSet look_point[7] 0x0001
	LookPointFlagsSet look_point[8] 0x0001
	LookPointFlagsSet look_point[9] 0x0001
	LookPointFlagsSet look_point[10] 0x0001
	LookPointFlagsSet look_point[11] 0x0001
	LookPointFlagsSet look_point[12] 0x0001
	LookPointFlagsSet look_point[13] 0x0001
	if ItemHas item[885] 0:
		if QuestFlagsGet quest[142] 0x02 && !QuestFlagsGet quest[142] 0x10 && !QuestFlagsGet quest[142] 0x40 && flag[3248] && !flag[3264]:
			EffLoad eff[7] "event/ev10016.eff"
	if flag[3074] && !flag[3089] && QuestFlagsGet quest[142] 0x10:
		ObjFlagsUnset object[7] 0x0004
	if flag[3328]:
		ED7_76_0 object[255] "koge2" 1
		ED7_76_1 object[255] "kenzai" 1
		ED7_76_1 object[255] "blue" 1
	elif flag[3089]:
		ED7_76_0 object[255] "koge2" 1
		ED7_76_1 object[255] "kenzai" 1
		ED7_76_1 object[255] "blue" 1
	else:
		ED7_76_1 object[255] "koge2" 1
		ED7_76_0 object[255] "kenzai" 1
		ED7_76_0 object[255] "blue" 1
	if !flag[3385] && flag[3370]:
		EffLoad eff[9] "map/mpmoya.eff"
		EffPlay eff[9] eff_instance[7] null 0 (0, 0, 0) 0 0 0 1000 1000 1000 null (0, 0, 0) 1000ms
		MapColor 0x00FF9678 0ms
		Fog 0xFFFFB47B 13 110 0
		ED7_76_0 object[255] "sd_mul" 1
	if flag[3385]:
		MapColor 0x00FFEBDC 0ms
		Fog 0xFFD5B47B 36 140 0
		ED7_76_0 object[255] "sd_mul" 1
	if !flag[3933]:
		ObjFrame object[5] 0
	else:
		ObjFrame object[5] 30
	Return

fn[5]:
	ED7_F2 1
	SystemFlagsSet 0x08000000
	if !flag[3933]:
		SoundPlay sound[14] 0 100 0
		ED7_74 object[5] 0 30
		ED7ObjPlay object[5] 0 30 0 0
		Sleep 500ms
		if ItemAdd item[61] 1:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextSetName ""
			TextMessage name[742] {
				{color 0}已取得{item[61]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			TextSetPos -1 280 60 3
			FadeIn 300ms 0x00000000
			FlagSet flag[3933]
			ED7_DE 5
		else:
			FadeOut 300ms 0x00000000 100
			TextSetName ""
			TextMessage name[742] {
