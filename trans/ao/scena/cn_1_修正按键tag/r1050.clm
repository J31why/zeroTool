fn[4]:
	if !flag[3030]:
		EventBegin 0
		CrossFade 500ms
		CharFlagsUnset field_party[4] 0x0080
		CharFlags2Unset field_party[4] 0x8000
		CharFlagsUnset field_party[5] 0x0080
		CharFlags2Unset field_party[5] 0x8000
		CharSetPos name[0] (-50420, 0, -17890) 270deg
		CharSetPos name[1] (-50870, 0, -16710) 225deg
		CharSetPos name[3] (-49670, 0, -18710) 270deg
		CharSetPos name[2] (-49820, 0, -17210) 270deg
		CharSetPos name[8] (-50030, 0, -15940) 225deg
		CharSetPos name[4] (-49100, 0, -15920) 225deg
		CamSetDistance -48700 2210 -19060 0ms
		ED7CamRotate 302deg 24deg 0deg 0ms
		CamPers 580 0ms
		CamZoom 12640 0ms
		FadeWait
		Sleep 500ms
		TextTalk self {
			唉，真是倒楣啊。{wait}
		}
		TextWait
		TextTalk self {
			跟被送醫的人比起來，
			毫髮無傷的我
			倒還算好的，但是……{wait}
		}
		TextWait
		TextTalk self {
			真沒想到列車
			竟然會像這樣脫軌呢。{wait}
		}
		TextWait
		TextTalk name[0] {
			#12P#00003F你好像是這個
			列車的車掌呢。{wait}
		} {
			#00000F如果可以的話，請說明一下
			發生意外當時的狀況好嗎？{wait}
		}
		TextWait
		TextTalk self {
			嗯，只要是我能說的，
			我什麼都願意說，但是……{wait}
		}
		TextWait
		TextTalk self {
			剛才被那邊那位刑警問話時，
			其實我也沒辦法好好說清楚。{wait}
		}
		TextWait
		TextTalk self {
			畢竟那是發生在
			一轉眼之間的事情。
			情況其實滿混亂的……{wait}
		}
		TextWait
		TextTalk name[8] {
			#12P#10106F嗯，發生了這麼嚴重的意外，
			沒辦法明確地回想起來，
			我想也是無可厚非的吧。{wait}
		}
		TextWait
		TextTalk name[1] {
			#12P#00108F事故的驚嚇應該
			也有影響，不過……{wait}
		}
		TextWait
		TextTalk name[0] {
			#12P#00003F此時此刻，無論是多細微的小事
			都不要緊。{wait}
		} {
			#00001F請問有沒有什麼
			令你在意的事情呢？{wait}
		}
		TextWait
		TextTalk self {
			令我在意的事情……
			嗯……{wait}
		}
		TextWait
		Emote self 0mm 2000mm 38 38 250ms 1
		Sleep 1000ms
		TextTalk self {
			啊，我想起來了……！{wait}
		}
		TextWait
		TextTalk name[3] {
			#12P#00305F#6P想到什麼了嗎？{wait}
		}
		TextWait
		TextTalk self {
			在發生脫軌意外的前一刻，
			我打給司機進行工作聯絡……{wait}
		}
		TextWait
		TextTalk self {
			才講到一半，他就突然大叫起來。{wait}
		}
		TextWait
		Shake 0 100 3000 200ms
		TextTalk self {
			『唔哇！這啥啊！？』……就這句話。{wait}
		}
		TextWait
		TextTalk self {
			而脫軌意外就在下一瞬間發生了。
			由於前方車輛脫軌，後方的連結車輛
			也接二連三地相繼滑出軌道。{wait}
		}
		TextWait
		TextTalk self {
			於是……
			就演變成現在這個狀況。{wait}
		}
		TextWait
		TextTalk name[2] {
			#12P#00200F『唔哇！這啥啊！？』……
			這樣的叫聲……{wait}
		}
		TextWait
		TextTalk name[4] {
			#12P#10302F簡直就像是親眼目睹#8R・　・　・　・#了
			難以置信的事物#14R・　・　・　・　・　・　・#才會講的話呢。{wait}
		}
		TextWait
		TextTalk name[0] {
			#12P#00003F司機他究竟
			看到了什麼啊……？{wait}
		}
		TextWait
		_59
		FlagSet flag[3030]
		QuestTaskSet quest[168] 4
		if flag[3027] && flag[3028] && flag[3029] && flag[3030]:
			Call fn[0,26]
			Return
		CharFlagsSet field_party[4] 0x0080
		CharFlags2Set field_party[4] 0x8000
		CharFlagsSet field_party[5] 0x0080
		CharFlags2Set field_party[5] 0x8000
		CharSetPos field_party[0] (-50180, 0, -17560) 257deg
		EventEnd 5
	else:
		TextStart self
		TextTalk self {
			在脫軌意外發生的前一刻，
			進行工作聯絡時，
			那時司機突然大叫了一聲。{wait}
		}
		TextWait
		TextTalk self {
			『唔哇！這啥啊！？』……就這句話。
			而脫軌意外就在那下一瞬間發生了。{wait}
		}
		TextWait
		TextEnd self
	Return

fn[5]:
	TextStart self
	if flag[2840]:
		if !flag[3032]:
			Call fn[0,11]
		else:
			TextTalk self {
				#02003F在重型機具抵達之前，
				我們警備隊也會協助在現場
				進行蒐證。{wait}
			} {
				#02000F我也已經事先
				叮囑過隊員了，
				你們可以自由進行調查。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[6]:
	TextStart self
	if !flag[3034]:
		TextTalk self {
			唉，仔細一看，
			這起意外還真是嚴重啊。{wait}
		}
		TextWait
		TextTalk self {
			情況如此嚴重，居然
			沒有任何人罹難。{wait}
		}
		TextWait
		TextTalk name[2] {
			#00200F大部分的乘客好像
			都由共和國以調度運輸方式送走，
			或是直接送往醫院了。{wait}
		}
		TextWait
		TextTalk name[0] {
			#00006F可以的話，我也想跟那些人
			打聽一下情報，可是……{wait}
		}
		TextWait
		TextTalk self {
			算了，這也沒辦法。{wait}
		}
		TextWait
		TextTalk self {
			對了，你們去找在對面休息的
			車掌聊過了嗎？{wait}
		}
		TextWait
		TextTalk self {
			我們剛才向他問話時
			並沒有得到什麼有用的情報，
			但是他現在說不定會想起些什麼。{wait}
		}
		TextWait
		TextTalk self {
			可別忘記去問問他。{wait}
		}
		TextWait
		FlagSet flag[3034]
	else:
		TextTalk self {
			你們去找在對面休息的
			車掌聊過了嗎？{wait}
		}
		TextWait
		TextTalk self {
			他是唯一馬上能打聽到意外
			發生時的狀況的人，
			可別忘了去問問他。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[7]:
	TextStart self
	if !flag[3033]:
		TextTalk self {
			#02102F如何？羅伊德。
			有掌握到什麼新的線索嗎？{wait}
		}
		TextWait
		TextTalk name[0] {
			#00006F不，目前還很難說呢。{wait}
		} {
			#00001F格蕾絲小姐
			有沒有注意到什麼事？{wait}
		}
		TextWait
		TextTalk self {
			#02106F嗯，我想想。
			雖說列車事故難免會發生，可是……{wait}
		} {
			#02101F我認為這次
			無論是時機還是地點
			都是最糟的呢。{wait}
		}
		TextWait
		TextTalk name[1] {
			#00108F……妳說得對。
			原本這陣子就因為提倡獨立的關係，
			一直持續著緊張狀態……{wait}
		} {
			#00103F說不定這起脫軌意外的背後
			可能會有某種意圖……{wait}
		}
		TextWait
		TextTalk self {
			#02106F不過這個推測也沒有任何根據，
			我不打算把個人的想法
			強加在你們身上。{wait}
		} {
			#02109F總之，調查方面
			就麻煩你們努力了！
			要是有什麼消息，可要讓我採訪喔。{wait}
		}
		TextWait
		TextTalk name[0] {
			#00002F哈哈，我明白了。{wait}
		}
		TextWait
		CharFlagsUnset self 0x0010
		FlagSet flag[3033]
	else:
		TextTalk self {
			#02103F雖說列車事故難免會發生……
			但這次時機和場所都是最糟的。{wait}
		} {
			#02109F總之，調查方面
			就麻煩你們努力了！
			要是有什麼消息，可要讓我採訪喔。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[8]:
	TextStart self
	if !flag[3036]:
		TextTalk name[3] {
			#00300F米蕾優，
			那邊的搶修工程進行得如何了？{wait}
		}
		TextWait
		TextTalk self {
			#07901F嗯，和你們的調查
			算是同步進行，可是……{wait}
		} {
			#07906F還是必須先使用重型機具
			移動列車本體，否則
			根本就無從下手呢。{wait}
		} {
			#07900F總之，現在正在把四散的
			碎片之類的物品清除。{wait}
		}
		TextWait
		TextTalk name[0] {
			#00003F還是讓我們也幫忙吧……{wait}
		}
		TextWait
		TextTalk self {
			#07904F不，沒那個必要。
			我希望你們能
			專心進行調查。{wait}
		} {
			#07902F我們這邊如果釐清了什麼事情
			也會向你們報告。{wait}
		}
		TextWait
		FlagSet flag[3036]
	else:
		TextTalk self {
			#07904F我希望你們能
			專心進行調查。{wait}
		} {
			#07902F我們這邊如果釐清了什麼事情
			也會向你們報告。{wait}
		}
		TextWait
	TextEnd self
