		CharSetChipPattern self 3
		Sleep 150ms
		CharSetChipPattern self 4
		Sleep 150ms
		CharSetChipPattern self 3
		Sleep 150ms
		CharSetChipPattern self 0
		Sleep 150ms
		while var[1] == 1:
			Sleep 150ms
		if var[1] == 2:
			break
	Return

