fn[3]:
	TextStart self
	if flag[3089]:
	elif flag[3074]:
		if !flag[3309]:
			Call fn[0,74]
		else:
			TextTalk char[0] {
				#01108F諾艾兒離開之後，
				琪雅也會很寂寞，但是……
				諾艾兒，妳要保重喔。{wait}
			} {
				#01102F我會等妳跟康復後的芙蘭
				一起過來玩。{wait}
			}
			TextWait
	elif flag[2848]:
	elif flag[2816]:
		if !flag[2949]:
			TextEnd self
			Call fn[0,6]
			Return
	elif flag[2369]:
		if !flag[2545]:
			TextTalk char[0] {
				#01105F啊，羅伊德你們要出門嗎？{wait}
			}
			TextWait
			TextTalk name[0] {
				#00000F嗯，琪雅在寫主日學校的作業嗎？{wait}
			}
			TextWait
			TextTalk char[0] {
				#01100F嗯，今天不能到外面玩，
				所以想說先寫一寫。{wait}
			} {
				#01106F但其實我很想要
				坐上那輛車看看。{wait}
			}
			TextWait
			TextTalk name[8] {
				#10106F嗚嗚，真的很可惜呢。{wait}
			} {
				#10109F下次休假天氣好的時候，
				再大家一起去兜風吧。{wait}
			}
			TextWait
			TextTalk char[0] {
				#01109F嗯！我會期待的～{wait}
			}
			TextWait
			FlagSet flag[2545]
		else:
			TextTalk char[0] {
				#01109F耶嘿嘿，
				好期待下次放晴喔～{wait}
			} {
				#01110F好～今天我要
				努力把作業寫完！{wait}
			}
			TextWait
	TextEnd self
	Return

fn[4]:
	TextStart self
	if flag[3074]:
		if !flag[0]:
			TextTalk char[2] {
				#01203F吼喔喔喔……汪。{wait}
			}
			TextWait
			TextTalk name[2] {
				#00200F賽特跟諾艾兒小姐說，
				『要保重喔』。{wait}
			}
			TextWait
			TextTalk name[8] {
				#10109F啊哈哈……
				謝謝你喔，賽特。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[2] {
				#01203F吼喔喔喔……汪。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[5]:
	EventBegin 0
	CrossFade 500ms
	CamSetDistance 256649 800 124480 0ms
	ED7CamRotate 26deg 22deg 0deg 0ms
	CamPers 350 0ms
	CamZoom 24500 0ms
	CharSetPos name[1] (257410, 0, 124690) 45deg
	CharSetPos name[0] (255000, 0, 124690) 315deg
	CharSetPos name[8] (256829, 0, 121730) 0deg
	CharSetPos name[4] (255220, 0, 122530) 0deg
	if PartyPosition name[164] > -1:
		CharSetPos name[164] (256209, 0, 125400) 0deg
	FadeWait
	TextTalk name[8] {
		#12P#10100F呃，這裡是我的房間。{wait}
	} {
		#10106F沒什麼有趣的東西，
		有點不好意思……{wait}
	}
	TextWait
	TextTalk name[4] {
		#6P#10300F呵呵，整理得很整齊，
		挺不錯的嘛。{wait}
	}
	TextWait
	TextTalk name[1] {
		#11P#00102F嗯，很有諾艾兒的風格，
		我覺得很棒呢。{wait}
	}
	TextWait
	if PartyPosition name[164] > -1:
		CharTurnTo name[164] 135deg 500deg/s
		Sleep 300ms
		TextTalk name[164] {
			#5P#01105F那個那個，放在那裡的
			小熊是怎麼回事啊？{wait}
		}
		TextWait
		Fork name[0] fork[1]:
			CharTurnTo self 90deg 500deg/s
		Fork name[1] fork[1]:
			CharTurnTo self 135deg 500deg/s
		Sleep 50ms
		Fork name[4] fork[1]:
			CharTurnTo self 90deg 500deg/s
		Sleep 50ms
		Fork name[8] fork[1]:
			CharTurnTo self 45deg 500deg/s
		ForkWait name[8] fork[1]
		TextTalk name[8] {
			#12P#10109F啊哈哈……
			那是我跟芙蘭
			一人一隻的玩偶。{wait}
		} {
			#10100F我把本來放在警備隊駐紮點的
			玩偶帶過來了。{wait}
		}
		TextWait
	else:
		CharTurnTo name[0] 135deg 500deg/s
		TextTalk name[0] {
			#5P#00000F咦？放在那裡的
			玩偶是……{wait}
		}
		TextWait
		Fork name[1] fork[1]:
			CharTurnTo self 135deg 500deg/s
		Sleep 50ms
		Fork name[4] fork[1]:
			CharTurnTo self 90deg 500deg/s
		Sleep 50ms
		Fork name[8] fork[1]:
			CharTurnTo self 45deg 500deg/s
		ForkWait name[8] fork[1]
		TextTalk name[8] {
			#12P#10109F啊哈哈……
			那是我跟芙蘭
			一人一隻的玩偶。{wait}
		} {
			#10100F我把本來放在警備隊駐紮點的
			玩偶帶過來了。{wait}
		}
		TextWait
	TextTalk name[0] {
		#5P#00000F哈哈！原來如此。
		用玩偶點綴房間，感覺很不錯。{wait}
	}
	TextWait
	TextTalk name[8] {
		#12P#10100F呵呵，謝謝你。{wait}
	} {
		#10104F呃，那就再次說聲……
		我還不夠成熟，懇請多多指教。{wait}
	}
	TextWait
	_59
	CharSetPos field_party[0] (256010, 0, 121130) 0deg
	FlagSet flag[2526]
	EventEnd 5
	Return

