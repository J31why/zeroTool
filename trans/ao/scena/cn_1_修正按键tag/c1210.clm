fn[5]:
	TextStart self
	if QuestFlagsGet quest[115] 0x02 && !QuestFlagsGet quest[115] 0x10 && !QuestFlagsGet quest[115] 0x40 && !flag[3625] && flag[2726]:
		TextTalk char[1] {
			若各位願意接下委託，
			希望能盡早返回。{wait}
		}
		TextWait
		TextTalk char[1] {
			星少就不用說了，
			我們能等待的時間也有限。{wait}
		}
		TextWait
	else:
		TextTalk char[1] {
			星少，您請慢走，
			路上小心。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[6]:
	TextStart self
	if QuestFlagsGet quest[115] 0x02 && !QuestFlagsGet quest[115] 0x10 && !QuestFlagsGet quest[115] 0x40 && flag[2726]:
		if system[10] == 1:
			TextTalk char[2] {
				大姊姊，
				我在這裡等妳。{wait}
			}
			TextWait
			TextTalk char[2] {
				妳一定要回來哦！{wait}
			}
			TextWait
			TextTalk name[1] {
				#00100F呃，我雖然不能向你保證……
				但我會好好處理的。{wait}
			}
			TextWait
		else:
			TextTalk char[2] {
				我是不知道你們有什麼事，
				反正快點處理完，回來就是了。{wait}
			}
			TextWait
			TextTalk char[2] {
				告訴你們，
				你們可是沒有拒絕這個選項可選！{wait}
			}
			TextWait
	TextEnd self
	Return

