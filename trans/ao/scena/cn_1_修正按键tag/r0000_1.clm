fn[0]:
	TextSetName ""
	TextMessage null {
		{color 5}發現物品了。{wait}
	}
	TextWait
	TextClose 0
	_59
	var[0] = random
	if flag[495] && system[4] >= 7 && random % 4 == 0:
		Call fn[1,5]
	elif flag[494] && system[4] >= 4 && random % 4 == 0:
		Call fn[1,4]
	elif flag[493] && random % 4 == 0:
		Call fn[1,3]
	else:
		Call fn[1,2]
	Return

fn[1]:
	var[0] = random
	if system[4] >= 7 && random % 2 == 0:
		Call fn[1,5]
	elif system[4] >= 4 && random % 2 == 0:
		Call fn[1,4]
	else:
		Call fn[1,3]
	Return

