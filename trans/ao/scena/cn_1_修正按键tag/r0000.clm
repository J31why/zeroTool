fn[0]:
	FlagUnset flag[394]
	if random % 100 < 50 && !flag[3089]:
		FlagSet flag[394]
	ED7_B1 1
	if system[4] < 7:
		if flag[394]:
			if random % 100 < 50:
				SoundPlay sound[2499] 255 100 0
			else:
				SoundPlay sound[3537] 255 100 0
		else:
			SoundPlay sound[3344] 255 100 0
	ED7_B1 2
	if system[4] < 7:
		if flag[394]:
			if random % 100 < 50:
				SoundPlay sound[2500] 255 100 0
			else:
				SoundPlay sound[3538] 255 100 0
		else:
			SoundPlay sound[3345] 255 100 0
	Return

fn[1]:
	while 1:
		ED7CharAnimation self 1000ms 0 1 2 3 4 3 2 1
	Return

fn[2]:
	while 1:
		ED7CharAnimation self 1000ms 0 1 2 3 4 3 2 1
	Return

fn[3]:
	ObjFlagsSet object[13] 0x2000000
	ObjFlagsSet object[14] 0x2000000
	ObjFlagsSet object[15] 0x2000000
	ObjFlagsSet object[16] 0x2000000
	ObjFlagsSet object[17] 0x2000000
