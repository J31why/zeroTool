fn[5]:
	TextStart self
	if flag[3404]:
		if !flag[3784]:
			Call fn[0,6]
		elif !flag[0]:
			TextTalk char[1] {
				#01203F#3C過去《幻之至寶#8RDemiurgos#》選擇了
				自我毀滅……{wait}
			} {
				#01200F我們無法肯定
				琪雅最終不會選擇
				走上同一條路。{wait}
			} {
				人子啊，去找回琪雅，
				然後阻止這件事發生吧。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[1] {
				#01203F#3C我們無法肯定
				琪雅最終不會選擇
				走上與《幻之至寶#8RDemiurgos#》同樣的道路。{wait}
			} {
				#01200F人子啊，去找回琪雅，
				然後阻止這件事發生吧。{wait}
			}
			TextWait
	elif flag[3386]:
		if !flag[0]:
			TextTalk char[1] {
				#01203F#3C琪雅肯定就在
				《大樹》的某處。{wait}
			} {
				#01200F恐怕是在最深處……
				和那個庫羅伊斯家的女孩、以及
				那個幕後黑手律師在一起。{wait}
			} {
				如果你們需要我的協助，
				可以隨時呼叫我。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[1] {
				#01203F#3C琪雅肯定就在
				《大樹》的某處。{wait}
			} {
				#01200F如果你們需要我的協助，
				可以隨時呼叫我。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[6]:
	TextTalk char[1] {
		#01203F#3C過去《幻之至寶#8RDemiurgos#》選擇了
		自我毀滅……{wait}
	} {
		羅伊德，我有跟你說過吧。{wait}
	}
	TextWait
	TextTalk name[0] {
		#00001F她是為了避免自己失控
		而傷害她應該保護的人們才……
		是這樣沒錯吧。{wait}
	} {
		#00003F……身為《零之至寶》的琪雅
		也會走上這條路嗎……？{wait}
	}
	TextWait
	TextTalk char[1] {
		#01200F#3C……我無法肯定。{wait}
	} {
		但是，琪雅成為《零之至寶》後，
		最終甚至創造出了力量
		足以與女神匹敵的《大樹》。{wait}
	} {
		目前無人能肯定
		她今後是否能永遠控制住
		如此巨大的力量。{wait}
	} {
		#01203F我們無法肯定
		她最終不會選擇
		走上與《幻之至寶#8RDemiurgos#》同樣的道路。{wait}
	}
	TextWait
	TextTalk name[0] {
		#00003F這樣啊……{wait}
	} {
		#00001F不，我們絕對不會讓她那麼做。
		只要我們還在……！{wait}
	}
	TextWait
	TextTalk char[1] {
		#01200F#3C……呵呵，這樣才像你啊。{wait}
	}
	TextWait
	FlagSet flag[3784]
	Return

fn[7]:
	TextStart self
	if flag[3404]:
		if !flag[3792]:
			Call fn[0,8]
		elif !flag[1]:
			TextTalk char[0] {
				#02105F沒想到羅伊德你們
				竟然能打倒那個
				亞里歐斯・馬克萊因。{wait}
			} {
				#02102F呵呵，
				你們成長了這麼多，
				大姊姊我很高興喔☆{wait}
			} {
				#02104F我現在覺得你們幾個無論
				碰上什麼難關都能順利度過。{wait}
			} {
				#02109F就這樣保持下去，
				我們大家一起迎接最棒的快樂結局吧！{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk char[0] {
				#02104F我現在覺得你們幾個無論
				碰上什麼難關都能順利度過。{wait}
			} {
				#02109F就這樣保持下去，
				我們大家一起迎接最棒的快樂結局吧！{wait}
			}
			TextWait
	elif flag[3386]:
		if !flag[1]:
			TextTalk char[0] {
				#02104F在我待在《大樹》的這段期間，
				我會盡可能多拍些照片。{wait}
			} {
				#02100F還有，回到通訊社之後，
				我一定要把這次事件的真相
				寫成報導才行……{wait}
			} {
				#02102F所以，羅伊德你們
				要努力解決這次事件喔！{wait}
			} {
				#02109F讓我寫出一篇超棒的
				社會新聞吧！{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk char[0] {
				#02100F羅伊德你們
				要努力解決這次事件喔！{wait}
			} {
				#02109F讓我寫出一篇超棒的
				社會新聞吧！{wait}
			}
			TextWait
	TextEnd self
	Return

fn[8]:
	TextTalk char[0] {
		#02105F聽說你們打倒了那個
		亞里歐斯・馬克萊因？{wait}
	} {
		#02106F噢～……
		真沒想到羅伊德你們
		竟然這麼能幹……{wait}
	} {
		#02109F《克洛斯貝爾的英雄》
		是不是也到了該換人當的時候啦？
		哎呀，真是個超級獨家新聞！{wait}
	}
	TextWait
	TextTalk name[0] {
		#00004F哈哈……妳太抬舉了啦。{wait}
	} {
		#00000F而且，亞里歐斯先生依然是
		克洛斯貝爾的英雄，
		我認為這個事實永遠不會變。{wait}
	}
	TextWait
	TextTalk char[0] {
		#02104F呵呵……
		羅伊德，你也成長了不少呢。{wait}
	} {
		#02102F既然你們的實力已經
		超越了亞里歐斯先生，我相信你們
		無論碰上什麼難關都能順利度過。{wait}
	} {
		#02109F就這樣保持下去，
		我們大家一起迎接最棒的快樂結局吧！{wait}
	}
	TextWait
	TextTalk name[0] {
		#00000F是！！{wait}
	}
	TextWait
	FlagSet flag[3792]
	Return

