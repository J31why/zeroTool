		ED7_76_2 object[3] "black_add" "day"
		ED7_76_2 object[3] "blue" "day"
		ED7_76_1 object[255] "CA_stop" 2
	if !flag[3457]:
		ObjFrame object[2] 60
	else:
		ObjFrame object[2] 0
	Return

