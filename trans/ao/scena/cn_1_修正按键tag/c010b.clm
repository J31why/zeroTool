	EntranceSetFunc entrance[0] fn[255,65535]
	EntranceSetFunc entrance[1] fn[255,65535]
	EntranceSetFunc entrance[3] fn[255,65535]
	if !flag[2573] && flag[2568]:
		EntranceSetFunc entrance[0] fn[0,47]
		EntranceSetFunc entrance[1] fn[0,48]
		EntranceSetFunc entrance[3] fn[0,49]
	Return

fn[6]:
	TextStart self
	TextTalk self {
		哎呀呀，已經這麼晚啦。{wait}
	}
	TextWait
	TextTalk self {
		我得快點回家
		幫媽媽的忙才行。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[7]:
	TextStart self
	if !flag[0]:
		TextTalk self {
			哎呀，一回過神才發現，
			天色都暗下來了啊。{wait}
		}
		TextWait
		TextTalk self {
			呵呵，沒注意到時間，大概也是受到
			通商會議氣氛的影響吧。{wait}
		}
		TextWait
		TextTalk self {
			我得趕快回家，免得老伴擔心才行。{wait}
		}
		TextWait
		FlagSet flag[0]
	else:
		TextTalk self {
			哎呀，一回過神才發現，
			天色都暗下來了啊。{wait}
		}
		TextWait
		TextTalk self {
			我得趕快回家，免得老伴擔心才行。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[8]:
	TextStart self
	TextTalk self {
		好啦，讓你久等了，
		抱歉啊。{wait}
	}
	TextWait
	TextTalk self {
		那我們快走吧。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[9]:
	TextStart self
	TextTalk self {
		嗯，我們快走吧。
		咪咪跟我都餓壞了。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[10]:
	TextStart self
	TextTalk self {
		上館子、上館子，今天要在外面吃飯♪{wait}
	}
	TextWait
	TextTalk self {
		咪咪想去東側大道的
		『東方料理店』。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[11]:
	TextStart self
	if !flag[1]:
		Call fn[0,12]
	else:
		TextTalk self {
			嗯～原來如此～{wait}
		}
		TextWait
		TextTalk self {
			（……看這樣子，
			　應該是根本沒去吧。）{wait}
		}
		TextWait
	TextEnd self
	Return

fn[12]:
	_Char4A char[4] 255
	_Char4A char[5] 255
	TextTalk char[4] {
		對了，瑞娜莉還有在
		繼續慢跑嗎？{wait}
	}
	TextWait
	TextTalk char[5] {
		咦？啊，嗯……
		算是有啦。{wait}
	}
	TextWait
	TextTalk char[5] {
		想說勉強自己減肥
		也不好，所以
		最近都是想到才去……{wait}
	}
	TextWait
	TextTalk char[4] {
		嗯～這樣啊。{wait}
	}
	TextWait
	TextTalk char[4] {
		（……看這樣子，
		　應該是根本沒去吧。）{wait}
	}
	TextWait
	_Char4B char[4] 255
	_Char4B char[5] 255
	FlagSet flag[1]
	FlagSet flag[2]
	Return

fn[13]:
	TextStart self
	if !flag[2]:
		Call fn[0,12]
	else:
		TextTalk self {
			雖、雖然我說是想到才去，
			但真的有在繼續喔！{wait}
		}
		TextWait
		TextTalk self {
			呃，那今天就
			用跑的回去吧。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[14]:
	TextStart self
	TextTalk self {
		好，今天也差不多該回家了吧。{wait}
	}
	TextWait
	TextTalk self {
		托大家的福，今天路人很多，
		我發了很多氣球出去。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[15]:
	TextStart self
	if !flag[2633]:
		Call fn[0,16]
	else:
		TextTalk self {
			將各國領導人送達到
			米修拉姆之前，
			前方都禁止通行。{wait}
		}
		TextWait
		TextTalk self {
			希望支援課的各位
			也能夠諒解與配合。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[16]:
	_Char4A char[8] 255
	_Char4A char[9] 255
	CharTurnToChar char[8] field_party[0] 0deg/s
	TextTalk char[8] {
		支援課的各位，
		還有達德利搜查官……{wait}
	}
	TextWait
	CharTurnToChar char[9] field_party[0] 500deg/s
	TextTalk char[9] {
		在各國領導人觀賞完戲劇之前，
		前方都將處於封鎖狀態，
		你們要進去嗎？{wait}
	}
	TextWait
	TextTalk name[9] {
		#00600F不了，沒關係。
		請你們繼續努力巡視。{wait}
	}
	TextWait
	TextTalk char[8] {
		瞭解！{wait}
	}
	TextWait
	TextTalk char[9] {
		瞭解！{wait}
	}
	TextWait
	CharTurnTo char[8] 180deg 0deg/s
	CharTurnTo char[9] 180deg 0deg/s
	_Char4B char[8] 255
	_Char4B char[9] 255
	FlagSet flag[2633]
	Return

fn[17]:
	TextStart self
	if !flag[2633]:
		Call fn[0,16]
	else:
		TextTalk self {
			在各國領導人觀賞完戲劇之前，
			從歡樂街到港灣區一帶
			都將處於封鎖狀態。{wait}
		}
		TextWait
		TextTalk self {
			這裡連一隻螞蟻都別想通過。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[18]:
	TextStart self
	if !flag[3]:
		TextTalk char[10] {
			喵──嗚。{wait}
		}
		TextWait
		TextTalk name[9] {
			#00600F這是支援課養的貓嗎？{wait}
		} {
			#00603F（摸摸……）
			……你也真是選了一個
			麻煩的地方當窩啊。{wait}
		}
		TextWait
		TextTalk char[10] {
			喵啊～～喔……㈱{wait}
		}
		TextWait
		TextTalk name[0] {
			#00002F（沒想到達德利警官
			　很擅長逗貓啊……）{wait}
		}
		TextWait
		FlagSet flag[3]
	else:
		TextTalk char[10] {
			喵嗯……{wait}
		}
		TextWait
	TextEnd self
	Return

