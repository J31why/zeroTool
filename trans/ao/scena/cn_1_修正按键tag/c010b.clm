fn[5]:
	if flag[4]:
		system[1] = 0
		FlagUnset flag[4]
	ObjFlagsSet object[15] 0x0004
	ObjFlagsSet object[16] 0x0004
	ObjFlagsSet object[17] 0x0004
	ObjFlagsSet object[18] 0x0004
	ObjFlagsSet object[19] 0x0004
	ObjFlagsSet object[20] 0x0004
	ObjFlagsSet object[21] 0x0004
	ED7_76_0 object[255] "black" 1
