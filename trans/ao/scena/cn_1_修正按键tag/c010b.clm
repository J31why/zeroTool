fn[0]:
	switch random % 8:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharWalkToPos self (11850, 0, -1800) 2000mm/s 0
		CharWalkToPos self (11850, 0, 39440) 2000mm/s 0
		Sleep 2000ms
		CharSetPos self (30000, 0, -3010) 270deg
	Return

fn[2]:
	while 1:
		CharIdle self (-23420, null, -19640) (-22750, null, -17990) 1000mm/s
		Sleep 300ms
	Return

fn[3]:
	ObjFlagsSet object[23] 0x2000000
	if flag[274]:
		ObjFlagsUnset object[23] 0x2000000
	elif flag[275]:
		ObjFlagsUnset object[23] 0x2000000
	Return

fn[4]:
	CharSetChipBase char[1] chip[1]
	CharSetChipPattern char[1] 0
	ForkQuit char[1] fork[0]
	CharFlags2Set char[1] 0x0004
	CharFlagsUnset char[7] 0x0080
