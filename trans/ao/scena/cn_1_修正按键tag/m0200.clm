fn[0]:
	switch random % 8:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if system[0] == 132 | system[0] == 134:
		Sc_C4Unset 4096
	if !flag[3087]:
		if system[0] == 133 && PartyPosition name[61] <= -1:
			SystemFlagsSet 0x10000000
			Event fn[0,9]
	if flag[272]:
		FlagUnset flag[272]
		Event fn[0,34]
	elif flag[273]:
		FlagUnset flag[273]
		Event fn[0,17]
	if system[0] == 109 && flag[3084] && !flag[3085]:
		Event fn[0,26]
	if system[0] == 119 && flag[3085] && !flag[3086]:
		Event fn[0,27]
	if system[0] == 104:
		FlagSet flag[3232]
	if system[0] == 100 | system[0] == 133:
		FlagUnset flag[0]
	else:
		FlagSet flag[0]
	if system[0] == 1 + 100:
		Event fn[0,14]
	if system[0] == 24 + 100:
		Event fn[0,16]
	Return

fn[2]:
	if flag[3232]:
		ED7_76_1 object[3] "lock_g" 1
		ED7_76_0 object[3] "lock_r" 1
		ObjFlagsSet object[3] 0x0010
	else:
		ED7_76_0 object[3] "lock_g" 1
		ED7_76_1 object[3] "lock_r" 1
		ObjFlagsUnset object[3] 0x0010
	if !flag[0]:
		ED7ObjPlay object[16] 0 5 0 32
	else:
		ED7ObjPlay object[16] 120 125 0 32
	EntranceSetDisabled entrance[1] 0
	EntranceSetDisabled entrance[24] 0
	if !flag[3385] && flag[3371]:
		ED7_76_0 object[18] "Null_color" 1
		ED7_76_0 object[18] "Null_color2" 1
		ED7_76_0 object[17] "Null_color2" 1
		ED7_76_0 object[17] "Null_color" 1
	else:
		if system[0] == 1 + 100:
			ED7_76_0 object[18] "Null_color" 1
			ED7_76_1 object[18] "Null_color2" 1
		else:
			ED7_76_1 object[18] "Null_color" 1
			ED7_76_0 object[18] "Null_color2" 1
		if system[0] == 24 + 100:
			ED7_76_1 object[17] "Null_color" 1
			ED7_76_0 object[17] "Null_color2" 1
		else:
			ED7_76_0 object[17] "Null_color" 1
			ED7_76_1 object[17] "Null_color2" 1
	ObjFlagsUnset object[5] 0x0010
	if !flag[263]:
		ObjFrame object[5] 0
		ObjFlagsSet object[20] 0x0004
	elif flag[3328]:
		ObjFlagsSet object[20] 0x0004
		ObjFrame object[5] 40
		ObjFlagsUnset object[5] 0x0002
	EntranceSetDisabled entrance[32] 0
	EntranceSetDisabled entrance[34] 0
	EntranceSetDisabled entrance[0] 0
	EntranceSetDisabled entrance[33] 1
	if !flag[4064]:
		ObjFrame object[0] 0
	else:
		ObjFrame object[0] 30
	if !flag[4065]:
		ObjFrame object[1] 0
	else:
		ObjFrame object[1] 30
	if !flag[4066]:
		ObjFrame object[19] 0
	else:
		ObjFrame object[19] 30
	if !flag[3918]:
		ObjFrame object[21] 0
	else:
		ObjFrame object[21] 30
	if !flag[3919]:
		ObjFrame object[22] 0
	else:
		ObjFrame object[22] 30
	if system[0] == 133 | system[0] == 132 | system[0] == 128 | system[0] == 102 | system[0] == 100:
		SoundStop sound[133]
	else:
		SoundPlay sound[133] 1 100 0
	Return

fn[3]:
	ED7_F2 1
	SystemFlagsSet 0x08000000
	if !flag[4064]:
		SoundPlay sound[14] 0 100 0
		ED7_74 object[0] 0 30
		ED7ObjPlay object[0] 0 30 0 0
		Sleep 500ms
		if ItemAdd item[74] 1:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextSetName ""
			TextMessage name[742] {
				{color 0}已取得{item[74]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			TextSetPos -1 280 60 3
			FadeIn 300ms 0x00000000
			FlagSet flag[4064]
			ED7_DE 5
		else:
			FadeOut 300ms 0x00000000 100
			TextSetName ""
			TextMessage name[742] {
				寶箱裡裝有{item[74]}{color 0}。
				因持有物品已達上限，已放棄{item[74]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			SoundPlay sound[15] 0 100 0
			ED7ObjPlay object[0] 30 0 0 0
	else:
		FadeOut 300ms 0x00000000 100
		TextSetPos -1 -1 -1 -1
		TextSetName ""
		TextMessage name[742] {
			{0x06}{color 5}寶箱裡什麼都沒有。{color 0}{wait}
		}
		TextWait
		TextClose 0
		FadeIn 300ms 0x00000000
	Sleep 30ms
	TextEnd null
	SystemFlagsUnset 0x08000000
	Return

fn[4]:
	ED7_F2 1
	SystemFlagsSet 0x08000000
	FadeOut 300ms 0x00000000 100
	if !flag[4065]:
		SoundPlay sound[14] 0 100 0
		ED7_74 object[1] 0 30
		ED7ObjPlay object[1] 0 30 0 0
		Sleep 500ms
		ObjFrame object[1] 30
		SoundPlay sound[17] 0 100 0
		TextSetPos -1 -1 -1 -1
		SepithAdd 0 100
		SepithAdd 1 100
		SepithAdd 2 100
		SepithAdd 3 100
		SepithAdd 4 100
		SepithAdd 5 100
		SepithAdd 6 100
		TextMessage null {
			已取得
			{color 2}#56I地之耀晶石×１００{color 0}
			{color 2}#57I水之耀晶石×１００{color 0}
			{color 2}#58I火之耀晶石×１００{color 0}
			{color 2}#59I風之耀晶石×１００{color 0}
