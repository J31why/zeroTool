			{color 2}#61I空之耀晶石×１００{color 0}
			{color 2}#62I幻之耀晶石×１００{color 0}。{wait}
		}
		TextWait
		TextClose 0
		TextSetPos -1 280 60 3
		FlagSet flag[4065]
		ED7_DE 5
	else:
		TextMessage name[742] {
			{0x06}{color 5}寶箱裡什麼都沒有。{wait}
		}
		TextWait
		TextClose 0
	FadeIn 300ms 0x00000000
	TextEnd null
	SystemFlagsUnset 0x08000000
	Return

fn[5]:
	ED7_F2 1
	SystemFlagsSet 0x08000000
