fn[0]:
	if flag[261] && flag[397]:
		system[30] = 46
	if flag[261]:
		if system[0] == 99:
			CharSetPos field_party[0] (500, 0, 3000) 315deg
			ED7_31 1
			ED7_Cam69 255 0
			SystemFlagsUnset 0x08000000
	Return

fn[1]:
	Minigame 47 -1 0 0 0 0 0 0 0
	if flag[4343]:
		TriggerFlagsSet trigger[0] 0x0080
		ObjFlagsSet object[1] 0x0004
	else:
		ED7_78 object[1] char[0]
		ObjFlagsUnset object[1] 0x0004
		CharFlagsUnset char[0] 0x0080
		CharFlagsUnset char[0] 0x0008
		CharFlagsSet char[0] 0x8000
		CharFlagsSet char[0] 0x0001
		CharSetPos char[0] (18000, 0, 70000) 180deg
		CharTurnTo char[0] 180deg 0deg/s
		char[0].7 = 8000
		char[0].40 = 9
		ED7_1D_0 0 2 0 (18000, 0, 70000) 3000 3000 90000
	SoundPlay sound[123] 1 80 0
	Return

fn[2]:
	SystemFlagsSet 0x00000080
	SystemFlagsSet 0x08000000
	var[0] = 0
	FlagUnset flag[394]
	if random % 100 < 50 && !flag[3089]:
		FlagSet flag[394]
	if system[4] < 7:
		if flag[394]:
			if random % 100 < 50:
				SoundPlay sound[2499] 255 100 0
			else:
				SoundPlay sound[3537] 255 100 0
		else:
			SoundPlay sound[3344] 255 100 0
	while var[0] != 255:
		if flag[261]:
			ED7MenuNew menu[0]
			ED7MenuAdd menu[0] "搭乘梅爾卡巴"
			ED7MenuAdd menu[0] "放棄"
			ED7MenuShow menu[0] 65535 65535 1
			MenuWait var[0]
			MenuClose menu[0]
			switch var[0]:
				case 0:
					FlagSet flag[272]
					NewScene "scena/e3020.bin" 0 0 0
					Hcf
					break
				default:
					var[0] = 255
		else:
			ED7MenuNew menu[0]
			ED7MenuAdd menu[0] "搭乘導力車移動"
			if flag[390]:
				ED7MenuAdd menu[0] "在導力車上休息"
			ED7MenuAdd menu[0] "放棄"
			ED7MenuShow menu[0] 65535 65535 1
			MenuWait var[0]
			MenuClose menu[0]
			switch var[0]:
				case 0:
					ED7_76_0 object[0] "light" 1
					ED7_74 object[0] 0 30
					if 1:
						ObjFrame object[0] 300
						ED7ObjPlay object[0] 300 330 0 0
					else:
						ObjFrame object[0] 240
						ED7ObjPlay object[0] 240 270 0 0
					SoundPlay sound[462] 0 100 0
					SoundLoad sound[2500]
					SoundLoad sound[3538]
					SoundLoad sound[3345]
					Sleep 700ms
					FadeOut 300ms 0x00000000 255
					FadeWait
					if Minigame 46 0 0 0 0 0 0 0 0 == 2:
						var[0] = 255
					FadeOut 0ms 0x00000000 255
					FadeIn 300ms 0x00000000
					if !flag[3750]:
						SoundPlay sound[461] 0 100 0
					if 1:
						ObjFrame object[0] 330
						ED7ObjPlay object[0] 330 300 0 0
					else:
						ObjFrame object[0] 270
						ED7ObjPlay object[0] 270 240 0 0
					Sleep 1000ms
					FadeWait
					ED7_76_1 object[0] "light" 1
					ObjFrame object[0] 0
					continue
				case 1:
					if flag[390]:
						TextClose 0
						BgmStop 3000ms
						FadeOut 1000ms 0x00000000 255
						FadeWait
						_59
						SoundPlay sound[13] 0 100 0
						if flag[392]:
							PartySetAttr name[255] 255 0
						elif flag[391]:
							PartySetAttr name[255] 254 0
						else:
							PartySetAttr name[255] 250 0
						CamLookChar field_party[0] 0ms
						Sleep 3500ms
						BgmResume
						FadeIn 1000ms 0x00000000
						TextClose 0
						var[0] = 255
					else:
						var[0] = 255
					break
				case 2:
					if !flag[390]:
						var[0] = 255
					else:
						var[0] = 255
					break
				default:
					var[0] = 255
	SystemFlagsUnset 0x08000000
	MenuClose menu[0]
	TextClose 0
	TextEnd null
	Return

fn[3]:
	if flag[4343]:
		Return
	EventBegin 1
	field_party[0].11 = 0
	field_party[1].11 = 0
	field_party[2].11 = 0
	field_party[3].11 = 0
	field_party[4].11 = 0
	field_party[5].11 = 0
	field_party[6].11 = 0
	field_party[7].11 = 0
	CharSetChipPattern field_party[0] 0
	CharSetChipPattern field_party[1] 0
	CharSetChipPattern field_party[2] 0
	CharSetChipPattern field_party[3] 0
	CharSetChipPattern field_party[4] 0
	CharSetChipPattern field_party[5] 0
	CharSetChipPattern field_party[6] 0
	CharSetChipPattern field_party[7] 0
	TextSetName ""
	TextMessage name[742] {
		{color 5}有蘊含強大力量的魔獸在前方。{wait}
	}
	Menu menu[0] -1 -1 0
		"【動手驅除】" // 0
		"【放棄】" // 1
	MenuWait var[0]
	MenuClose menu[0]
	TextClose 0
	switch var[0]:
		case 1:
			Sleep 500ms
			ED7_E0 2
			CharSetPos2 field_party[0] (18000, 0, 57000) 180deg
			EventEnd 5
			Return
	ED7Battle battle[0] null 0 256 12 null
	ED7_E0 2
	EventBegin 1
	CamSetDistance 18000 1000 57000 0ms
	CharSetPos2 field_party[0] (18000, 0, 57000) 180deg
	CharSetPos2 field_party[1] (18000, 0, 57000) 180deg
	CharSetPos2 field_party[2] (18000, 0, 57000) 180deg
	CharSetPos2 field_party[3] (18000, 0, 57000) 180deg
	CharSetPos2 field_party[4] (18000, 0, 57000) 180deg
	CharSetPos2 field_party[5] (18000, 0, 57000) 180deg
	CharSetPos2 field_party[6] (18000, 0, 57000) 180deg
	CharSetPos2 field_party[7] (18000, 0, 57000) 180deg
	switch system[3]:
		case 2:
			ED7_E0 2
			EventEnd 5
			Return
		case 1:
			ReturnToTitle 0
			Return
	EventBegin 0
	FadeOut 0ms 0x00000000 255
	CharFlagsSet char[0] 0x0080
	ED7_E0 3
	Sleep 400ms
	SoundPlay sound[9] 0 100 0
	TextSetPos -1 -1 -1 -1
	ED7_DE 43
	TextSetName ""
	TextMessage null {
		{color 5}擊退了魔獸！{wait}
	}
	TextWait
	TextClose 0
	TextSetPos -1 -1 -1 -1
	TextSetName ""
	SoundPlay sound[17] 0 100 0
	if system[74] == 3:
		TextMessage null {
			已取得{item[57]}{color 0}。{wait}
		}
		ItemAdd item[57] 1
	else:
		TextMessage null {
			已取得{item[56]}{color 0}。{wait}
		}
		ItemAdd item[56] 1
	TextWait
	TextClose 0
	_59
	TextSetPos -1 280 60 3
	FlagSet flag[4343]
	TriggerFlagsSet trigger[0] 0x0080
	ObjFlagsSet object[1] 0x0004
	ED7_1D_2 0 1
	CharFlagsSet char[0] 0x0080
	CharFlagsSet char[0] 0x0008
	ED7_E0 2
	EventEnd 5
	Return
