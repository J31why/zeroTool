	TextTalk char[1] {
		哎呀，特務支援課的各位。{wait}
	}
	TextWait
	TextTalk char[1] {
		今天我們劇場休息，
		各位來此有什麼事情嗎？{wait}
	}
	TextWait
	TextTalk name[0] {
		#00000F沒什麼事情，
		只是剛好經過而已。{wait}
	}
	TextWait
	TextTalk name[1] {
		#00100F劇團改版公演的日子……
		明天就要開演了呢。{wait}
	} {
		各位今天休息，是為了
		明天的表演養精蓄銳嗎？{wait}
	}
	TextWait
	TextTalk char[1] {
		是的，沒錯。{wait}
	}
	TextWait
	TextTalk char[1] {
		不過，有一個人
		現在還在練習。{wait}
	}
	TextWait
	TextTalk name[8] {
		#10105F哦？還真努力啊。
		該不會是……？{wait}
	}
	TextWait
	TextTalk char[1] {
		您已經猜到了嗎？
		沒錯，就是修莉。{wait}
	}
	TextWait
	TextTalk char[1] {
		不管怎麼說，明天可是她
		展現本領的大好機會……{wait}
	}
	TextWait
	TextTalk char[1] {
		看來她不先活動一下筋骨
		是靜不下心來的。{wait}
	}
	TextWait
	TextTalk char[1] {
		如果時間充裕的話，還請各位
		去探望她一下。{wait}
	}
	TextWait
	TextTalk name[0] {
		#00005F真、真的可以嗎？{wait}
	}
	TextWait
	TextTalk char[1] {
		嗯，以各位和本劇團之間
		深厚的交情，
		我想大家都不會有意見的。{wait}
	}
	TextWait
	TextTalk char[1] {
		而且，她似乎從
		早上開始就沒有休息，
		一直苦練著……{wait}
	}
	TextWait
	TextTalk char[1] {
		如果方便的話，還請各位
		去和她打個招呼。{wait}
	}
	TextWait
	TextTalk char[1] {
		對她來說，我想這會是一個
		喘口氣的好機會。{wait}
	}
	TextWait
	TextTalk name[0] {
		#00000F原來如此，我明白了。{wait}
	}
	TextWait
	TextTalk name[1] {
		#00100F非常感謝您。{wait}
	}
	TextWait
