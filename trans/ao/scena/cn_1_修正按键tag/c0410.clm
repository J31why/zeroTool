fn[8]:
	TextStart self
	if flag[3385]:
		TextTalk self {
			其實，剛剛伊莉雅
			用導力通訊給團員們
			送來聲援的訊息了。{wait}
		}
		TextWait
		TextTalk self {
			該怎麼說呢？伊莉雅真的
			很努力，讓我們勇氣百倍喔。{wait}
		}
		TextWait
	elif flag[3371]:
	elif flag[3089]:
	elif flag[3074]:
	elif flag[2861]:
	elif flag[2848]:
	elif flag[2837]:
	elif flag[2832]:
	elif flag[2816]:
	elif flag[2573]:
		if !flag[2653]:
			Call fn[0,9]
		elif !flag[0]:
			TextTalk char[3] {
				唔……我也真是的。
				激動過度，完全沒注意到你們啊。{wait}
			}
			TextWait
			TextTalk char[3] {
				不過，還好是你們。{wait}
			}
			TextWait
			TextTalk char[3] {
				要是被其他團員看到的話……
				伊莉雅肯定會賞我一百大板。{wait}
			}
			TextWait
			Emote field_party[0] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Emote field_party[1] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Emote field_party[2] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Emote field_party[3] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Sleep 1000ms
			FlagSet flag[0]
		else:
			TextTalk self {
				唔……我也真是的。
				激動過度，完全沒注意到你們啊。{wait}
			}
			TextWait
			TextTalk self {
				要是被其他團員看到的話……
				伊莉雅肯定會賞我一百大板。{wait}
			}
			TextWait
	elif flag[2564]:
	elif flag[2560]:
	elif flag[2369]:
	elif flag[2353]:
	TextEnd self
	Return

fn[9]:
	_Char4A char[3] 255
	_Char4A char[0] 255
	TextTalk char[0] {
		上次提過的服裝設計圖，
		我已經畫出來了……{wait}
	}
	TextWait
	TextTalk char[0] {
		這樣看起來如何呢？{wait}
	}
	TextWait
	TextTalk char[3] {
		嗯！挺棒的啊！
		照這個方向去做，
		基本上就沒問題了。{wait}
	}
	TextWait
	TextTalk char[3] {
		我會拿去給伊莉雅看，
		整合好我們的意見之後，
		再進行討論吧。{wait}
	}
	TextWait
	TextTalk name[0] {
		#00005F（新服裝的設計圖……？）{wait}
	}
	TextWait
	TextTalk name[1] {
		#00100F（……挺有意思的嘛。）{wait}
	}
	TextWait
	Emote char[0] 0mm 2000mm 38 38 250ms 1
	Sleep 1000ms
	CharTurnToChar char[0] field_party[0] 0deg/s
	TextTalk char[0] {
		哎呀呀，你們是……？{wait}
	}
	TextWait
	TextTalk char[3] {
		唔，是誰啊……（迅速收起來）{wait}
	}
	TextWait
	CharTurnToChar char[3] field_party[0] 0deg/s
	TextTalk char[3] {
		哎呀，你們是……
		……你們聽到剛剛的話了嗎？{wait}
	}
	TextWait
	if system[10] == 0:
		TextTalk name[0] {
			#00006F呃……
			不好意思。{wait}
		}
		TextWait
	elif system[10] == 1:
