fn[0]:
	while 1:
		ED7CharAnimation self 1000ms 0 1 2 3 4
	Return

fn[1]:
	if system[0] == 105:
		Event fn[0,7]
	if flag[3400] && !flag[3401]:
		Event fn[0,25]
	if flag[272]:
		FlagUnset flag[272]
		Event fn[0,24]
	if system[0] == 0:
		if global[0] == 4:
			global[0] = 0
			Event fn[0,10]
		elif global[0] == 7:
			global[0] = 0
			Event fn[0,12]
	Return

