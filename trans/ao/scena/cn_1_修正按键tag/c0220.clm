		SystemFlagsSet 0x10000000
		Event fn[0,13]
	Return

fn[2]:
	if flag[2848] && !flag[2858] | flag[2369] && system[4] == 1:
		ED7_76_0 object[255] "hikari00_add" 1
		ED7_76_0 object[255] "hikari01_add" 1
		SoundPlay sound[128] 1 50 0
	if !flag[3385] && flag[3370]:
		MapColor 0x00E6D2D2 0ms
		ED7_76_0 object[255] "hikari00_add" 1
		ED7_76_0 object[255] "hikari01_add" 1
	ObjFlagsUnset object[0] 0x0010
	if flag[3385]:
		LookPointFlagsSet look_point[0] 0x0001
		ObjFlagsSet object[0] 0x0010
	Return

fn[3]:
	TextStart self
	if !flag[2560] && !flag[2404]:
		Call fn[0,12]
	elif flag[3089]:
		if !flag[3169]:
			TextTalk self {
				#02200F是你們啊……
				你們看過迪塔先生的演講了嗎？{wait}
			}
			TextWait
			TextTalk name[0] {
				#00001F是的，不過……{wait}
			}
			TextWait
			TextTalk self {
				#02200F對於情況如此急速變化
				感到困惑……
				我想是這麼一回事吧？{wait}
			} {
				#02203F大部份的市民應該
				也抱著這種心態。{wait}
			} {
				#02201F但是，兩大國之間曾發生過『暗鬥』
				也是不爭的事實。{wait}
			}
			TextWait
			TextTalk name[1] {
				#00108F……這就是叔叔他所說的，
				無法解釋的『事故』對吧。{wait}
			}
			TextWait
			TextTalk self {
				#02203F嗯……{wait}
			} {
				#02201F但是一直以來，
				我們都對真相視而不見，
				只去享受眼前的幸福……{wait}
			} {
				這就是迪塔所說，
				所有住在克洛斯貝爾
				居民的共業吧。{wait}
			} {
				#02203F為了面對這一切，
				我認為有必要成為一個
				獨立的國家。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00005F伊安律師……{wait}
			}
			TextWait
			TextTalk self {
				#02203F……抱歉，
				可能是受到他演講的影響，
				我也跟著激動起來了。{wait}
			} {
				#02200F無論如何……
				此事都已勢在必行。{wait}
			} {
				#02203F接下來要怎麼做……
				我想這是每一位居民
				都必須思考的問題。{wait}
			}
			TextWait
			FlagSet flag[3169]
		else:
			TextTalk self {
				#02203F此事都已勢在必行。{wait}
			} {
				#02200F接下來要怎麼做……
				我想這是每一位居民
				都必須思考的問題。{wait}
			}
			TextWait
	elif flag[3074]:
		if !flag[3168]:
			TextTalk self {
				#02203F呼……
				那個客人的公司
				資料在……{wait}
			}
			TextWait
			TextTalk name[0] {
				#00000F伊安律師……
				你看起來好忙喔。{wait}
			}
			TextWait
			Emote self 0mm 2000mm 38 38 250ms 1
			Sleep 1000ms
			CharTurnToChar self field_party[0] 500deg/s
			TextTalk self {
				#02205F喔，是你們啊……{wait}
			} {
				#02203F因為上次那個襲擊事件，
				造成許多企業蒙受損失。{wait}
			} {
				#02200F過去這一個禮拜，
				我一直接到他們的諮詢委託，
				完全沒有休息的時間。{wait}
			}
			TextWait
			TextTalk name[3] {
				#00303F……還真是辛苦啊。{wait}
			}
			TextWait
			TextTalk self {
				#02203F嗯……
				不過這也是沒辦法的事。{wait}
			} {
				#02200F因為ＩＢＣ遭受破壞，
				有許多人因此
				失去客戶或甚至是工作。{wait}
			} {
				身為一名律師，
				我也必須盡我的全力
				來協助他們……{wait}
			}
			TextWait
			TextTalk name[4] {
				#10300F呵呵，真不愧是
				大家口中的熊鬍子律師。{wait}
			}
			TextWait
			TextTalk name[1] {
				#00105F但、但是……
				你不是還忙著
				制定憲法草案嗎？{wait}
			}
			TextWait
			TextTalk self {
				#02200F嗯，關於這件事，
				我總算是把它給完成，
				才剛提交給自治州政府而已。{wait}
			} {
				#02202F嗯，人類真是有志者事竟成啊。
				害我最近連睡覺的時間都沒有。{wait}
			}
			TextWait
			TextTalk name[2] {
				#00200F所以你是不眠不休嗎……{wait}
			}
			TextWait
			TextTalk name[8] {
				#10100F呃，請你不要
				太勉強自己喔。{wait}
			}
			TextWait
			TextTalk self {
				#02202F呵呵，謝謝妳的關心。{wait}
			} {
				#02203F今天的諮詢委託結束後，
				工作算是到了一個段落，
				所以我打算今晚好好休息。{wait}
			} {
				#02200F……那麼，因為有客人在等我，
				我先告辭了。{wait}
			} {
				我想各位一定也接到了
				很多委託，
				你們也要多努力啊。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00000F是，非常感謝你。{wait}
			}
			TextWait
			FlagSet flag[3168]
			CharFlagsUnset char[0] 0x0010
		else:
			TextTalk self {
				#02200F我會以一名
				律師的立場，
				為市民盡力而為。{wait}
			} {
				我想各位一定也接到了
				很多委託，
				你們也要多努力啊。{wait}
			}
			TextWait
	elif flag[2861]:
		if !flag[0]:
			TextTalk self {
