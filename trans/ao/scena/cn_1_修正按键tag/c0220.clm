			}
			TextWait
	elif flag[2837]:
		TextTalk char[0] {
			#02200F這次的事件……
			若是時間允許，
			也讓我幫各位忙吧。{wait}
		} {
			#02202F呵呵，
			我晚一點也會過去，
			你們先去努力搜查吧。{wait}
		}
		TextWait
	elif flag[2832]:
		TextTalk char[0] {
			#02200F這次的事件……
			若是時間允許，
			也讓我幫各位忙吧。{wait}
		} {
			#02202F呵呵，
			我晚一點也會過去，
			你們先去努力搜查吧。{wait}
		}
		TextWait
	elif flag[2816]:
	elif flag[2573]:
	elif flag[2568]:
		if !flag[0]:
			TextTalk self {
				#02205F哎呀，是你們啊。
				難得這麼晚了還來找我。{wait}
