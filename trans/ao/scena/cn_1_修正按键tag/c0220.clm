			} {
				#02203F……事情竟然
				會演變成這樣，
				我實在完全沒預料到。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				#02200F一般認為這次事件可能是帝國
				或共和國的技倆，想要讓我們
				收回提倡獨立的念頭。{wait}
			} {
				#02203F……事情竟然
				會演變成這樣，
				我實在完全沒預料到。{wait}
			}
			TextWait
	elif flag[2848]:
		if !flag[2912]:
			TextTalk self {
				#02200F喔，是你們……{wait}
			}
			TextWait
			if QuestFlagsGet quest[135] 0x10:
				TextTalk name[0] {
					#00004F伊安律師……
					昨天真的是
					謝謝你了。{wait}
				} {
					#00000F律師你找到的證據
					派上用場了呢。{wait}
				}
				TextWait
				TextTalk self {
					#02203F喔，彼特已經把事情始末告訴我了。
					看來總算能夠對那個
					叫做明涅斯的男子發出通緝了。{wait}
				} {
					#02202F哈哈，不過再怎麼說，
					我也只是幫了一點小忙而已。{wait}
				}
				TextWait
				TextTalk name[0] {
					#00004F不會，真的是幫了我們大忙。{wait}
				} {
					#00000F而且還是在你
					忙著制定憲法草案的時候……{wait}
				}
				TextWait
			else:
				TextTalk name[0] {
					#00000F伊安律師……
					好久不見了。{wait}
				} {
					聽說你忙著
					制定憲法草案。{wait}
				}
				TextWait
			TextTalk self {
				#02200F是啊，不過這部份
				我這邊也多少有些頭緒了。{wait}
			} {
				我正想要煮杯咖啡，
				稍微休息一下。{wait}
			}
			TextWait
			TextTalk name[1] {
				#00105F啊……
				我們是不是打擾到
				你的休息時間了？{wait}
			}
			TextWait
			TextTalk self {
				#02202F不會，才沒這種事。
				和你們聊個天，
				也是轉換心情的好方法啊。{wait}
			} {
				#02205F……話說回來，各位。
				聽說你們在調查
				昨天的脫軌意外……{wait}
			}
			TextWait
			TextTalk name[0] {
				#00000F是的，目前我們已經
				先查出原因了。{wait}
			}
			TextWait
			TextTalk name[2] {
				#00203F細節先不多做說明……
				不過這確實是
				人為造成的意外沒錯。{wait}
			}
			TextWait
			TextTalk self {
				#02205F嗯，這樣啊……{wait}
			} {
				#02203F…………{wait}
			}
			TextWait
			TextTalk name[3] {
				#00305F伊安律師……
				怎麼了嗎？{wait}
			}
			TextWait
			TextTalk self {
				#02203F……沒什麼，我只是在想，
				真是幸好沒有人因此喪命。{wait}
			} {
				#02200F總之，最近的局勢很亂。
				你們自己也要多小心一點。{wait}
			}
			TextWait
			FlagSet flag[2912]
		else:
			TextTalk self {
				#02200F憲法草案算是慢慢成型了……
				不過看來還需要再改良一下。{wait}
			} {
				#02203F雖然體力有點吃不消，
