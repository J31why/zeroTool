fn[6]:
	TextStart self
	if flag[3371]:
		if !flag[3709]:
			TextTalk self {
				如何？大家都很拚命吧？{wait}
			}
			TextWait
			TextTalk self {
				大家現在為了
				盡早讓公演繼續舉辦下去，
				正全心全力努力著。{wait}
			}
			TextWait
			TextTalk self {
				聽說伊莉雅也
				已經醒過來了……
				我們可不能辜負她的期望。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00000F（……看來劇團的成員們
				　連莉夏目前人在哪裡
				　都不知道吧。）{wait}
			} {
				（雖然很想讓他們
				　見上一面，不過……）{wait}
			}
			TextWait
		else:
			TextTalk self {
				我們就跟往常一樣，
				在這裡努力鑽研表演，
				並繼續等候她。{wait}
			}
			TextWait
			TextTalk self {
				羅伊德、還有各位，
				莉夏的事情
				就拜託你們了。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00000F好，我明白了。{wait}
			}
			TextWait
			if PartyPosition name[5] > -1:
				TextTalk name[5] {
					#10700F團長……
					謝謝您。{wait}
				}
				TextWait
	elif flag[3089]:
		TextTalk self {
			大家真的
			都做得很好。{wait}
		}
		TextWait
		TextTalk self {
			伊莉雅、莉夏……
			我們一定會等妳們回來的。{wait}
		}
		TextWait
	elif flag[3074]:
		if !flag[3176]:
			Emote char[3] 0mm 2000mm 38 38 250ms 1
			Sleep 1000ms
			CharTurnToChar self name[0] 0deg/s
			TextTalk char[3] {
				喔，是羅伊德啊……{wait}
			}
			TextWait
			TextTalk char[3] {
				…………{wait}
			}
			TextWait
			TextTalk name[0] {
				#00003F團長……{wait}
			}
			TextWait
			TextTalk char[3] {
				啊……抱歉。{wait}
			}
			TextWait
			TextTalk char[3] {
				我左思右想之，
				還是覺得很不安。{wait}
			}
			TextWait
			TextTalk char[3] {
				伊莉雅是個堅強的人。
				我相信她一定能清醒過來，
				不過……{wait}
			}
			TextWait
			TextTalk name[1] {
				#00108F團長先生……{wait}
			}
			TextWait
			TextTalk char[3] {
				呼，不過，我再怎麼擔心
				也改變不了什麼。{wait}
			}
			TextWait
			TextTalk char[3] {
				我……我也得
				再堅強一點才行。{wait}
			}
			TextWait
			CharFlagsUnset char[3] 0x0010
			FlagSet flag[3176]
		else:
			TextTalk self {
				呼，我也差不多
				該振作起來了。{wait}
			}
			TextWait
			TextTalk self {
				老是這樣沮喪的話，
				伊莉雅一定會罵我吧。{wait}
			}
			TextWait
	elif flag[2861]:
		TextTalk self {
			羅伊德，還有各位，不好意思啊。{wait}
		}
		TextWait
		TextTalk self {
			正式表演就快開始了。
			大家都想好好利用時間，
			準備到最後一刻。{wait}
		}
		TextWait
	elif flag[2848]:
	elif flag[2837]:
	elif flag[2832]:
	elif flag[2816]:
	elif flag[2573]:
	elif flag[2564]:
	elif flag[2560]:
		if !flag[2654]:
			Call fn[0,8]
		else:
			TextTalk self {
				伊莉雅真是
				太可靠啦。{wait}
			}
			TextWait
			TextTalk self {
				看這情況，她一定可以讓
				明天的表演進行得很順利。{wait}
			}
			TextWait
	elif flag[2369]:
	elif flag[2353]:
		if !flag[0]:
			Call fn[0,7]
		else:
			TextTalk self {
				這要求或許有點勉強，
				不過還是拜託你們。{wait}
			}
			TextWait
			TextTalk self {
				這也是為了實現
				伊莉雅的構想。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[7]:
	_Char4A char[3] 255
	_Char4A char[4] 255
	if !flag[2484]:
