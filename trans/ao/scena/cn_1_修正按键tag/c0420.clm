		#5P#01703F…………{wait}
	}
	TextWait
	TextTalk name[0] {
		#12P#00000F伊莉雅小姐……
		原來妳在這裡啊。{wait}
	}
	TextWait
	Emote char[0] 0mm 2000mm 38 38 250ms 1
	Sleep 1000ms
	CharTurnToChar char[0] name[1] 500deg/s
	TextTalk char[0] {
		#5P#01705F啊，是弟弟你們啊。{wait}
	} {
		#01709F呵呵，改版公演就快上演了，
		大家是來鼓勵我們的嗎？{wait}
	}
	TextWait
	TextTalk name[1] {
		#6P#00100F呵呵，算是吧。{wait}
	} {
		伊莉雅小姐就是
		在這裡看著莉夏小姐和修莉
		她們練習的吧？{wait}
	}
	TextWait
	CharTurnTo char[0] 45deg 500deg/s
	Sleep 300ms
	TextTalk char[0] {
		#5P#01704F嗯，二樓的座位可以把
		整個舞台都看得很清楚。{wait}
	} {
		#01702F哎呀，話說回來，
		年輕女孩們努力的模樣，
		真是令人百看不厭呢～{wait}
	} {
		這麼看著看著，都讓我
		回憶起自己剛出道的時候了。{wait}
	}
	TextWait
	TextTalk name[0] {
		#12P#00005F伊莉雅小姐剛出道的時候……{wait}
	}
	TextWait
	TextTalk name[3] {
		#12P#00302F哈哈，好像有點難以想像啊。{wait}
	}
	TextWait
	TextTalk name[4] {
		#6P#10302F呵呵，有機會的話，我還真想
		知道當時發生了什麼事。{wait}
	}
	TextWait
	CharTurnToChar char[0] name[1] 500deg/s
	TextTalk char[0] {
		#5P#01700F呵呵，要我說也行，不過……
		那並不是什麼有趣的事喔！{wait}
	}
	TextWait
	TextTalk name[8] {
		#12P#10109F哇哇！請務必告訴我們！！{wait}
	} {
		#10100F我記得您剛出道時，
		雜誌就以『萬眾矚目的重量級新人』
		為標題大幅報導過吧。{wait}
	}
	TextWait
	TextTalk name[2] {
		#6P#00205F原來如此，一出道就那麼紅了。{wait}
	} {
		#00202F順道請教一下……
		您當初之所以會想當演員，
		有什麼特別的原因嗎？{wait}
	}
	TextWait
	TextTalk char[0] {
		#5P#01703F嗯，我想想。{wait}
	} {
		#01700F在我小的時候就看過
		彩虹劇團的表演，
		這大概就是契機吧。{wait}
	}
	TextWait
	TextTalk name[3] {
		#12P#00300F原來如此，所以心生憧憬──
		差不多是這樣吧？{wait}
	}
	TextWait
	TextTalk char[0] {
		#5P#01703F嗯，有點不太對。{wait}
	} {
		#01700F當時演員們的演技
		以及舞台裝置的效果都已經
		很棒了，不過……{wait}
	} {
		#01706F看完表演後，我還是
		覺得少了什麼東西，所以一直
		沒辦法認同他們。{wait}
	}
	TextWait
	Emote name[0] 0mm 2000mm 16 19 250ms 1
	SoundPlay sound[23] 0 100 0
	Emote name[1] 0mm 2000mm 16 19 250ms 1
	SoundPlay sound[23] 0 100 0
	Emote name[2] 0mm 2000mm 16 19 250ms 1
	SoundPlay sound[23] 0 100 0
	Emote name[3] 0mm 2000mm 16 19 250ms 1
	SoundPlay sound[23] 0 100 0
	Emote name[8] 0mm 2000mm 16 19 250ms 1
	SoundPlay sound[23] 0 100 0
	Emote name[4] 0mm 2000mm 16 19 250ms 1
	SoundPlay sound[23] 0 100 0
	Sleep 1000ms
	TextTalk name[0] {
		#12P#00011F沒、沒辦法認同……{wait}
	}
	TextWait
	TextTalk char[0] {
		#5P#01700F當時周圍的觀眾和我父母
		的確都讚不絕口，所以
		表演肯定是很精彩的，不過……{wait}
	} {
		#01703F該怎麼說呢？如果是我的話，
		我一定能演得更棒！
		我當時是這麼想的吧。{wait}
	} {
		#01702F呵呵，不過說來奇怪，
		我那時只是個沒有任何
		相關知識的外行人罷了。{wait}
	}
	TextWait
	TextTalk name[8] {
		#12P#10105F哦，您小時候有過那樣的經驗……{wait}
	}
	TextWait
	TextTalk name[4] {
		#6P#10300F嗯，不過，如果妳是因此而
		加入彩虹劇團的話，應該會
		時常跟他們發生衝突吧？{wait}
	}
	TextWait
	TextTalk char[0] {
		#5P#01706F是啊，我這個菜鳥中的菜鳥
		開口閉口卻都是批評，
		衝突當然是免不了的。{wait}
	} {
		#01700F不過，我那時可是懷著
		極為明確的信念，我相信
		自己能表演變得更好……{wait}
	} {
		#01709F在我堅持一段時間之後，
		大家自然而然開始理解，
		摩擦也漸漸減少了。{wait}
	}
	TextWait
	TextTalk name[2] {
		#6P#00202F原來如此……
		是因為這樣，然後才有了
		現在的伊莉雅小姐啊。{wait}
	}
	TextWait
	TextTalk char[0] {
		#5P#01704F呵呵，只不過，目前幾乎還沒有
		一場表演是我百分之百滿意的。{wait}
	} {
		#01702F不過，前途無量的莉夏和修莉
		都加入我們了……{wait}
	} {
		反正接下來就繼續
		以呈現最棒的表演
		為目標，差不多是這樣吧？{wait}
	}
	TextWait
	TextTalk name[0] {
		#12P#00002F哈哈，伊莉雅小姐
		真是貪心啊……{wait}
	}
	TextWait
	TextTalk name[1] {
		#6P#00104F呵呵，雖然人家常說努力比天分更重要……{wait}
	} {
		#00109F不過伊莉雅小姐可是有天分又努力呀。
		這樣感覺真是天下無敵了。{wait}
	}
	TextWait
	TextTalk name[3] {
		#12P#00309F嗯，說得沒錯。{wait}
	}
	TextWait
	TextTalk char[0] {
		#5P#01709F呵呵，我好像不小心
		說了些無聊的私事。{wait}
	} {
		#01704F嗯，若不嫌棄的話，
		請大家一定要來欣賞
		這次的改版公演喔。{wait}
	} {
		#01700F莉夏和修莉……
		肯定也都會
		獻上最精采的演技。{wait}
	}
	TextWait
	TextTalk name[0] {
		#12P#00004F嗯，那當然。{wait}
	} {
		#00000F伊莉雅小姐和大家一起獻上的精彩表演……
		我會好好期待的。{wait}
	}
	TextWait
	TextClose 0
