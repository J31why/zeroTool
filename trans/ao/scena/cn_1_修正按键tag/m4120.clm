fn[6]:
	ED7_F2 2
	FadeOut 300ms 0x00000000 100
	TextMessage name[742] {
		{color 5}有可恢復導力器的裝置。{color 0}{wait}
	}
	Menu menu[0] -1 -1 1
		"在此地休息" // 0
		"放棄" // 1
	MenuWait var[0]
	MenuClose menu[0]
	TextClose 0
	if var[0] == 0:
		FadeIn 100ms 0x00000000
		Sleep 500ms
		SoundLoad sound[13]
		ED7_74 object[4] 0 30
		SoundPlay sound[7] 0 100 0
		ObjFrame object[4] 0
		ED7ObjPlay object[4] 0 30 0 0
		ObjWait object[4]
		ED7ObjPlay object[4] 31 390 0 32
		Sleep 1000ms
		BgmStop 3000ms
		FadeOut 1000ms 0x00000000 255
		Sleep 700ms
		SoundPlay sound[13] 0 100 0
		FadeWait
		PartySetAttr name[255] 254 0
		CamLookChar field_party[0] 0ms
		ED7_31 1
		Sleep 3500ms
		ObjFrame object[4] 0
		BgmResume
		FadeIn 1000ms 0x00000000
		TextClose 0
		TextEnd null
		Return
	else:
		FadeIn 300ms 0x00000000
		TextEnd null
		Return
	Return
	Return

fn[7]:
	EventBegin 1
	if flag[2560]:
		TextMessage null {
			{color 5}這裡有梯子。
			是否要攀爬？{wait}
		}
		Menu menu[0] -1 -1 1
			"是" // 0
			"否" // 1
		MenuWait var[0]
		MenuClose menu[0]
		TextClose 0
		_59
		if var[0] == 0:
			FadeOut 500ms 0x00000000 255
			FadeWait
			EventEnd 5
			NewScene "scena/m4160.bin" 106 0 0
			Hcf
	else:
		TextMessage null {
			{color 5}這裡有壞掉的梯子。{wait}
		}
		TextWait
		TextClose 0
		_59
	EventEnd 5
	Return

fn[8]:
	EventBegin 0
	FadeOut 0ms 0x00000000 255
	ED7_E0 3
	SoundLoad sound[814]
	CamSetDistance -10 3330 -15780 0ms
	ED7CamRotate 65deg 25deg 0deg 0ms
	CamPers 700 0ms
	CamZoom 16910 0ms
	CharSetPos name[0] (-800, 2330, -15700) 0deg
	CharSetPos name[1] (800, 2330, -15700) 0deg
	CharSetPos name[8] (-800, 2330, -17300) 0deg
	CharSetPos name[4] (800, 3330, -17300) 0deg
	FadeIn 1000ms 0x00000000
	CamSetDistance 0 1160 -7500 5000ms
	CamZoom 14430 5000ms
	Sleep 50ms
	Fork name[0] fork[1]:
		_94 0 self 0deg 9000 2000mm/s 0
	Sleep 50ms
	Fork name[1] fork[1]:
		_94 0 self 0deg 9000 2000mm/s 0
	Sleep 50ms
	Fork name[8] fork[1]:
		_94 0 self 0deg 9000 2000mm/s 0
	Sleep 50ms
	Fork name[4] fork[1]:
		_94 0 self 0deg 9000 2000mm/s 0
	Sleep 50ms
	ForkWait name[0] fork[3]
	ForkWait name[1] fork[3]
	ForkWait name[8] fork[3]
	ForkWait name[4] fork[3]
	CamWait 121
	Sleep 300ms
	TextTalk name[0] {
		#1120000168V#00008F#6P這樣看上去……
		這紫光好像是植物發出來的。{wait}
	} {
		#1120000169V#00001F似乎有很多苔蘚和蕈類。{wait}
	}
	TextWait
	TextTalk name[8] {
		#1120050056V#10106F#12P這個地方不管怎麼看
		都不像是普通的礦山遺跡……{wait}
	}
	TextWait
	CharTurnTo name[1] 225deg 500deg/s
	Sleep 300ms
	TextTalk name[1] {
		#1120010084V#00103F#5P我好像有在哪裡聽說過
		會發光的苔蘚。{wait}
	} {
		#1120010085V#00101F名字叫做《塞姆利亞苔》，
		似乎也有人拿來當作藥材……{wait}
	}
	TextWait
	Fork name[8] fork[1]:
		CharTurnTo self 45deg 500deg/s
	Sleep 100ms
	CharTurnTo name[0] 90deg 500deg/s
	TextTalk name[0] {
		#1120000170V#00005F#6P哦，還有這種東西啊。{wait}
	}
	TextWait
	TextTalk name[1] {
		#1120010086V#00106F#5P不過，這顏色跟我
		聽說過的完全不同……{wait}
	} {
		#1120010087V#00100F說不定是不同的種類。{wait}
	}
	TextWait
	CharTurnTo name[4] 315deg 500deg/s
	Sleep 200ms
	TextTalk name[4] {
		#1120040098V#10302F#11P不……
		是《塞姆利亞苔》沒錯喔。{wait}
	}
	TextWait
	Fork name[1] fork[1]:
		CharTurnTo self 180deg 500deg/s
	Sleep 50ms
	Fork name[0] fork[1]:
		CharTurnTo self 135deg 500deg/s
	Sleep 50ms
	Fork name[8] fork[1]:
		CharTurnTo self 90deg 500deg/s
	Sleep 100ms
	TextTalk name[1] {
		#1120010088V#00105F#5P咦？{wait}
	}
	TextWait
	TextTalk name[4] {
		#1120040099V#10304F#11P原本塞姆利亞苔就會
		發出金色的光芒，但是……{wait}
	} {
		#1120040100V#10300F它們偶而會受到七耀脈的影響
