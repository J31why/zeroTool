fn[7]:
	TextStart self
	if flag[3385]:
		if !flag[0]:
			TextTalk self {
				那棵散發清白色光芒的大樹，
				是因為怎樣的因果
				才出現在克洛斯貝爾呢？{wait}
			}
			TextWait
			TextTalk self {
				它會為這裡帶來光芒，
				還是會帶來災禍……
				就連我們神職人員也不清楚。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				那棵散發清白色光芒的大樹究竟是……{wait}
			}
			TextWait
			TextTalk self {
				這也是女神的旨意嗎？{wait}
			}
			TextWait
	elif flag[3371]:
		if !flag[0]:
			TextTalk self {
				我還想說結界突然消失，
				城鎮中似乎就開始出現
				穿甲冑的怪物徘徊……{wait}
			}
			TextWait
			TextTalk self {
				如果這也是迪塔總統的
				意思的話，這是絕對不能
				原諒的行徑。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				居然讓怪物在城鎮中徘徊……
				這是絕對不能原諒的行徑。{wait}
			}
			TextWait
	elif flag[3089]:
		if !flag[0]:
			TextTalk self {
				迪塔似乎在
				城鎮裡演講了呢。{wait}
			}
			TextWait
			TextTalk self {
				因為克洛斯貝爾獨立，
				就無法避免
				為大陸帶來混亂了吧。{wait}
			}
			TextWait
			TextTalk self {
				女神啊，請妳務必要指引人們……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				已經無法避免
				與帝國跟共和國的衝突了吧。{wait}
			}
			TextWait
			TextTalk self {
				女神啊，請妳務必要指引人們……{wait}
			}
			TextWait
	elif flag[3074]:
		if !flag[0]:
			TextTalk self {
				今天會在大教堂的
				禮拜堂舉行彌撒。{wait}
			}
			TextWait
			TextTalk self {
				這場彌撒是為了讓攻擊事件的犧牲者，
				都能受到女神的指引而舉辦的。{wait}
			}
			TextWait
			TextTalk self {
				如果有空的話，
				請各位也務必前來參加。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				為了哀悼之前的攻擊事件，
				今天的彌撒
				有許多訪客參加。{wait}
			}
			TextWait
			TextTalk self {
				如果有空的話，
				請各位也務必前來參加。{wait}
			}
			TextWait
			FlagSet flag[0]
	elif flag[2861]:
		if !flag[0]:
			TextTalk self {
				從昨晚開始，
				就一直頻繁聽到槍聲和爆炸聲。{wait}
			}
			TextWait
			TextTalk self {
				看來
				在瑪因茲方向的
				戰鬥變得很激烈呢……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				總之……
				沒人能保證武裝集團
				絕對不會過來這裡。{wait}
			}
			TextWait
			TextTalk self {
				我們必須儘快討論
				如何防禦大教堂才行……{wait}
			}
			TextWait
	elif flag[2848]:
		TextTalk self {
			今天在克洛斯貝爾自治州
			全區似乎都有下雨。{wait}
		}
		TextWait
		TextTalk self {
			看來連這種天氣都
			前往街道的人真的很少呢。{wait}
		}
		TextWait
	elif flag[2837]:
		TextTalk self {
			哈哈……
			久久修女
			真的很受小孩歡迎呢。{wait}
		}
		TextWait
		TextTalk self {
			那也是一種才能啊。
			真令人羨慕。{wait}
		}
		TextWait
	elif flag[2832]:
		if !flag[0]:
			TextTalk self {
				羅贊貝爾克工房……
				有時候會聽到這個名字呢。{wait}
			}
			TextWait
			TextTalk self {
				雖然是很久以前就有的工房，
				不過我想工房主人
				應該沒有來過大教堂。{wait}
			}
			TextWait
			TextTalk self {
				究竟是怎樣的人
				會過來呢？{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				羅贊貝爾克工房的主人
				沒有來過大教堂。{wait}
			}
			TextWait
			TextTalk self {
				究竟是怎樣的人
				會過來呢？{wait}
			}
			TextWait
	elif flag[2831]:
		TextTalk self {
			泰米爾跟哈米爾
			似乎回家了呢。{wait}
		}
		TextWait
		TextTalk self {
			那麼，差不多該開始
			傍晚的打掃了……{wait}
		}
		TextWait
	elif flag[2829]:
		if !flag[0]:
			TextTalk self {
				伊安偶爾會像那樣，
				出現在大教堂裡。{wait}
			}
			TextWait
			TextTalk self {
				特別是在
				處理棘手案件的時候，
				似乎常常會過來呢。{wait}
			}
			TextWait
			TextTalk self {
				雖然我不知道
				他現在究竟在煩惱什麼，
				不過……希望他能夠努力。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				伊安偶爾會像那樣，
				出現在大教堂裡。{wait}
			}
			TextWait
			TextTalk self {
				雖然我不知道
				他現在究竟在煩惱什麼，
				不過……希望他能夠努力。{wait}
			}
			TextWait
	elif flag[2816]:
		if !flag[0]:
			TextTalk self {
				最近在各地目擊到
				來路不明的怪物。{wait}
			}
			TextWait
			TextTalk self {
				警備隊似乎也
				呼籲大家不要一個人
				到偏僻的地方去。{wait}
			}
			TextWait
			TextTalk self {
				你們也要多加小心。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				聽說最近
				在各地都有目擊到
				來路不明的怪物。{wait}
			}
			TextWait
			TextTalk self {
				你們也要多加小心，
				不要到偏僻的地方去。{wait}
			}
			TextWait
	elif flag[2573]:
		if !flag[2649]:
			TextTalk self {
				剛才，
				利貝爾的克蘿蒂雅王儲
				來到了大教堂。{wait}
			}
			TextWait
			TextTalk self {
				她跟艾拉爾達大主教打過招呼之後，
				似乎便前往墓地了。{wait}
			}
			TextWait
		else:
			TextTalk self {
				克蘿蒂雅王儲
				剛才似乎前往
				蘭花塔了。{wait}
			}
			TextWait
			TextTalk self {
				今天通商會議的走向……
				王儲的動向也讓人很在意呢。{wait}
			}
			TextWait
	elif flag[2564]:
		if !flag[0]:
			TextTalk self {
				揭幕儀式
				在位於高地的這裡
				雖然也看得到，不過……{wait}
			}
			TextWait
			TextTalk self {
				揭開布幕後的蘭花塔，
				真的是非常震撼啊。{wait}
			}
			TextWait
			TextTalk self {
				人類居然能
				建造出那種建築物……
				哎呀呀，真讓人驚訝。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				蘭花塔的模樣
				真的是非常震撼啊。{wait}
			}
			TextWait
			TextTalk self {
				人類居然能建造出那種建築物……
				哎呀呀，真讓人驚訝。{wait}
			}
			TextWait
	elif flag[2560]:
		TextTalk self {
			為了通商會議，
			已經強化了城鎮中的警備。{wait}
		}
		TextWait
		TextTalk self {
			我在巡邏大教堂時
			也會多加留意。{wait}
		}
		TextWait
	elif flag[2369]:
		if !flag[0]:
			TextTalk self {
				今天的天氣不好，讓人很遺憾。{wait}
			}
			TextWait
			TextTalk self {
				不過，下雨的似乎只有城鎮，
				只要到了瑪因茲山道方向的話，
				聽說就是爽朗的晴天喔。{wait}
			}
			TextWait
			TextTalk self {
				天氣說不定
				只是女神的
				心情起伏而已呢。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				下雨的似乎只有城鎮，
				到瑪因茲山道方向的話，
				就是爽朗的晴天喔。{wait}
			}
			TextWait
			TextTalk self {
				天氣說不定
				只是女神的
				心情起伏而已呢。{wait}
			}
			TextWait
	elif flag[2368]:
		if !flag[0]:
