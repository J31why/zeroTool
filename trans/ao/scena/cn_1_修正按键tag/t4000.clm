fn[23]:
	if !flag[3273]:
		TextTalk char[2] {
			今天是彌撒的日子。{wait}
		}
		TextWait
		TextTalk char[2] {
			各位也要
			一起來參加嗎～？{wait}
		}
		TextWait
		TextTalk name[0] {
			#00003F（能請她參加選美大會的
			　『修女』項目嗎……？）{wait}
		} {
			#00000F呃，不好意思。
			我有點事想跟妳商量……{wait}
		}
		TextWait
		TextSetName ""
		TextMessage null {
			{color 5}嘗試拜託她參加
			慈善活動的選美大會。{color 0}{wait}
		}
		TextWait
		TextClose 0
		_59
		TextTalk char[2] {
			咦？什麼……？
			要我參加選美大會……{wait}
		}
		TextWait
		TextTalk char[2] {
			我、我不行啦～
			像我這樣的人，
			而且也一點都不性感……{wait}
		}
		TextWait
		TextTalk char[2] {
			雖然很抱歉，
			不過請你找別人參加吧。{wait}
		}
		TextWait
		TextTalk name[0] {
			#00012F這、這樣啊……{wait}
		}
		TextWait
		FlagSet flag[3273]
	else:
		TextTalk char[2] {
			像、像我這樣的人
			哪能參加選美大會呢？{wait}
		}
		TextWait
		TextTalk char[2] {
			我想一定還有其他人
			更適合你的條件。{wait}
		}
		TextWait
	TextEnd char[2]
	Return

