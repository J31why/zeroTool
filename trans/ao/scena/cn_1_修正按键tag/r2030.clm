		}
		TextWait
		TextTalk name[0] {
			#00001F的確，以這情形來推測，
			這可能性很高。{wait}
		}
		TextWait
		TextTalk name[4] {
			#10402F呵呵，還真是不容小覷呢。{wait}
		}
		TextWait
		_59
		FlagSet flag[3697]
	EventEnd 3
	Return

