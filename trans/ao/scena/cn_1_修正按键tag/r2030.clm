fn[43]:
	while 1:
		if random % 100 < 80:
			_Char4B self 3
		else:
			_Char4A self 3
		Sleep 500ms
	Return

fn[44]:
	while 1:
		EffPlay eff[4] eff_instance[255] self 3 (100, 1100, 900) 0 0 0 500 500 500 null (0, 0, 0) 0ms
		ED7CharAnimation self 3000ms 2 3
	Return

