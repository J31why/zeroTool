			FadeWait
		if var[0] == 1:
			ShopOpen shop[107]
			var[0] = 99
		elif var[0] == 2:
		elif var[0] != 0:
			TextEnd char[13]
			Return
		elif var[0] == 0:
			var[0] = 99
			if ItemHas item[861] 0 != 1:
				TextTalk char[13] {
