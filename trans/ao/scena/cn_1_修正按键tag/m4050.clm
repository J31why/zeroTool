		CharTurnToChar self name[8] 500deg/s
	Sleep 100ms
	CharTurnToChar name[8] name[0] 500deg/s
	Sleep 200ms
	TextTalk name[0] {
		#1000000079V#12P#00004F嗯，但總會有辦法的。{wait}
	} {
		#1000000080V#00002F警備隊員果然可靠，
		像蘭迪也是一樣。{wait}
	} {
		#1000000081V應該說鍛鍊方式
		跟普通警察不同吧。{wait}
	}
	TextWait
	Emote name[8] 0mm 2000mm 40 43 100ms 3
	Sleep 800ms
	TextTalk name[8] {
		#1000050043V#10112F#5P啊哈哈……
		請別這麼抬舉我。{wait}
	} {
		#1000050044V#10102F真要說的話，很多地方
		是靠裝備的強度來彌補的。{wait}
	}
	TextWait
	TextTalk name[0] {
		#1000000082V#12P#00004F但妳能熟練地使用強力的裝備，
		也是拜訓練和資質所賜。{wait}
	} {
		#1000000083V#00000F而且上士妳明明和我同齡，
		卻連開車都很擅長。{wait}
	}
	TextWait
	TextTalk name[8] {
		#1000050045V#10104F#5P呵呵，因為我從十五歲入隊後，
		每天都在專心訓練啊。{wait}
	} {
		#1000050046V#10100F還有，索妮亞司令指導有方，
		這點也很有幫助吧。{wait}
	} {
		#1000050047V#10106F……但她超級嚴厲的就是了。{wait}
	}
	TextWait
	TextTalk name[0] {
		#1000000084V#12P#00002F哈哈，索妮亞副司令……
		不對，是司令啊。{wait}
	} {
		#1000000085V#00004F如果是接受了她的指導，
		確實能練就一身功夫吧。{wait}
	} {
		#1000000086V#00000F好像就連蘭迪也在演習的時候
		被她徹底訓練了一頓。{wait}
	}
	TextWait
	TextTalk name[8] {
		#1000050048V#10112F#5P啊哈哈，好像是這樣沒錯。{wait}
	} {
		#1000050049V#10100F蘭迪學長他……
		現在應該正在陪同
		進行復健訓練吧？{wait}
	}
	TextWait
	TextTalk name[0] {
		#1000000087V#12P#00000F嗯，應該是吧。{wait}
	} {
		#1000000088V#00006F如果蘭迪在這裡──
		不對，還有艾莉和緹歐也是。{wait}
	} {
		#1000000089V#00008F如果他們三個人在這裡，
		就沒什麼好怕的了。{wait}
	}
	TextWait
	TextTalk name[8] {
		#1000050050V#10104F#5P呵呵，的確。{wait}
	} {
		#1000050051V#10102F仔細想想，特務支援課
		還真是個相當平衡的隊伍呢！{wait}
	} {
		#1000050052V因為分工得當，
		所以能夠應對各種狀況。{wait}
	}
	TextWait
	TextTalk name[0] {
		#1000000090V#12P#00000F我真的受到大家很多幫助。{wait}
	} {
		#1000000091V因為除了戰鬥之外，大家在各方面
		擅長的領域也各不相同……{wait}
	}
	TextWait
	BgmVolume 70 1000ms
	VisSet vis[0] 3 0xFFFFFFFF 800ms 0 0
	VisWait vis[0] 3
