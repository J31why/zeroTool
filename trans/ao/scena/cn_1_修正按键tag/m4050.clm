	TextTalk name[0] {
		#1000000078V#6P#00008F呼……{wait}
	}
	TextWait
	TextTalk name[8] {
		#1000050042V#10106F#5P只有我們兩人
		果然還是有點難以應付……{wait}
	}
	TextWait
	TextClose 0
	_59
	CrossFade 250ms
	CharSetChipBase name[0] chip[255]
	CharSetChipPattern name[0] 0
	CharSetChipBase name[8] chip[255]
