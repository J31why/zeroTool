		剩下的事就交給你了。{color 0}{wait}
	}
	TextWait
	TextSetPos 30 130 -1 -1
	TextMessage null {
		{color 13}#1000010001V#30W琪雅
		就拜託你了。{color 0}{wait}
	}
	TextWait
	TextSetPos -1 160 -1 -1
	TextMessage null {
		{color 13}#1000020001V#30W賽特和柯貝也要
