			ED7Battle battle[5] null 0 0 11 null
			CharFlagsSet char[1] 0x0080
			CharFlagsUnset char[1] 0x8000
			switch system[3]:
				case 0:
					FlagSet flag[4311]
					ObjFrame object[3] 30
					Sleep 500ms
					break
				case 2:
					ObjFrame object[3] 0
					TextEnd null
					SystemFlagsUnset 0x08000000
					Return
				case 1:
					ReturnToTitle 0
					Return
		if ItemAdd item[146] 1:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextMessage name[742] {
				{color 0}已取得{item[146]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			TextSetPos -1 280 60 3
			FadeIn 300ms 0x00000000
			FlagSet flag[3852]
			ED7_DE 5
		else:
			FadeOut 300ms 0x00000000 100
			TextMessage name[742] {
				寶箱裡裝有{item[146]}{color 0}。
				因持有物品已達上限，已放棄{item[146]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			SoundPlay sound[15] 0 100 0
			ED7ObjPlay object[3] 30 0 0 0
	else:
		FadeOut 300ms 0x00000000 100
		TextMessage name[742] {
			{0x06}{color 5}寶箱裡什麼都沒有。{color 0}{wait}
		}
		TextWait
		TextClose 0
		FadeIn 300ms 0x00000000
	Sleep 30ms
	TextEnd null
	SystemFlagsUnset 0x08000000
	Return

