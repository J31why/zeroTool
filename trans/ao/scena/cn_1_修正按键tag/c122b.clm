fn[0]:
	switch random % 8:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if flag[3074]:
	elif flag[3072]:
		CharFlagsUnset char[0] 0x0080
		if flag[3218]:
			CharFlagsUnset char[3] 0x0080
			CharFlagsUnset char[5] 0x0080
			CharFlagsUnset char[1] 0x0080
			CharFlagsUnset char[2] 0x0080
			CharFlagsUnset char[4] 0x0080
			CharFlagsUnset char[6] 0x0080
			CharSetChipBase char[0] chip[1]
			CharSetChipPattern char[0] 0
			ForkQuit char[0] fork[0]
			CharFlags2Set char[0] 0x0004
			CharSetChipBase char[5] chip[7]
			CharSetChipPattern char[5] 0
			ForkQuit char[5] fork[0]
			CharFlags2Set char[5] 0x0004
			if !flag[3]:
				CharFlagsSet char[2] 0x0010
			if !flag[3219]:
				CharFlagsSet char[1] 0x0010
		elif flag[3217]:
			CharSetChipBase char[0] chip[0]
			CharSetChipBase char[5] chip[6]
			CharSetPos char[0] (3450, 20, -20) 270deg
			ForkFunc char[0] fork[0] fn[0,0]
		else:
			CharSetChipBase char[0] chip[0]
			CharSetChipBase char[5] chip[6]
	if flag[3072] && !flag[3074] && !flag[3217]:
		Event fn[0,10]
	elif flag[3072] && !flag[3074] && flag[3217] && !flag[3218] && system[0] == 104:
		Event fn[0,28]
	Return

fn[2]:
	if flag[3072] && !flag[3074] && flag[3218]:
		ObjFrame object[11] 11
	if flag[3072] && !flag[3074] && flag[3218]:
		LookPointFlagsUnset look_point[0] 0x0001
	else:
		LookPointFlagsSet look_point[0] 0x0001
	TriggerFlagsSet trigger[0] 0x0080
	if flag[3072] && !flag[3074] && !flag[3218]:
		TriggerFlagsUnset trigger[0] 0x0080
	Return

fn[3]:
	TextStart char[0]
	if flag[3074]:
	elif flag[3072]:
		if flag[3218]:
			if !flag[0]:
				TextTalk char[0] {
					真的很感謝你們
					把大家平安救出來。{wait}
				}
				TextWait
				TextTalk char[0] {
					如果沒有各位協助，
					我現在可能還在
					接待室的角落發抖。{wait}
				}
				TextWait
				FlagSet flag[0]
			else:
				TextTalk char[0] {
					如果沒有各位協助，
					我現在可能還在
					接待室的角落發抖。{wait}
				}
				TextWait
				TextTalk char[0] {
					真的很感謝你們。{wait}
				}
				TextWait
		else:
			FadeOut 300ms 0x00000000 100
			FadeWait
			Menu menu[0] -1 -1 1
				"談話" // 0
				"休息" // 1
				"放棄" // 2
			MenuWait var[0]
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
			switch var[0]:
				case 0:
					TextTalk char[0] {
						（這裡有急救箱，
						　應該可以做些緊急處理。）{wait}
					}
					TextWait
					TextTalk char[0] {
						（格蕾絲小姐他們……
						　就拜託各位了。）{wait}
					}
					TextWait
					break
				case 1:
					TextTalk char[0] {
						（我明白了，
						　請不要亂動喔。）{wait}
					}
					TextWait
					BgmStop 3000ms
					FadeOut 1000ms 0x00000000 255
					FadeWait
					SoundPlay sound[13] 0 100 0
					PartySetAttr name[255] 254 0
					Sleep 3500ms
					BgmResume
					FadeIn 1000ms 0x00000000
					FadeWait
					TextTalk char[0] {
						（格蕾絲小姐他們……
						　就拜託各位了。）{wait}
					}
					TextWait
					break
				case 2:
					break
	TextEnd char[0]
	Return

fn[4]:
	TextStart self
	if flag[3074]:
	elif flag[3072]:
		if !flag[1]:
			TextTalk self {
				傷腦筋，我們還真是
				被捲入一個大麻煩了呢。{wait}
			}
			TextWait
			TextTalk self {
				幸好沒有任何人受傷……
				但格蕾絲也真是太亂來了。{wait}
			}
			TextWait
			TextTalk self {
				積極行動是好事，但像她那樣
				有幾條命都不夠啊。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				幸好沒有任何人受傷……
				但格蕾絲也真是太亂來了。{wait}
			}
			TextWait
			TextTalk self {
				積極行動是好事，但像她那樣
				有幾條命都不夠啊。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[5]:
	TextStart self
	if flag[3074]:
	elif flag[3072]:
		if !flag[2]:
			TextTalk self {
				我只是送外賣來這裡，
				結果剛才那群武裝男子
				突然衝進來。{wait}
			}
			TextWait
			TextTalk self {
				外頭也是一團亂，
				不知道我丟在原地的
				攤子有沒有事……{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			TextTalk self {
				那是長年來跟我同甘共苦一起
				在克洛斯貝爾賣麵的攤子……{wait}
			}
			TextWait
			TextTalk self {
				……希望它沒事。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[6]:
	TextStart self
	if flag[3074]:
	elif flag[3072]:
		if !flag[3219]:
			_Char4A char[2] 0
			TextTalk self {
				#02101F雷因茲，你有帶相機吧！？{wait}
			}
			TextWait
			TextTalk char[2] {
				有、有的！我做了萬全的準備！{wait}
			}
			TextWait
			TextTalk name[0] {
				#00011F格蕾絲小姐……
				妳該不會是想要去採訪吧！？{wait}
			}
			TextWait
			TextTalk name[1] {
				#00101F外面非常危險，
				還是不要去比較好……{wait}
			}
			TextWait
			CharFlagsUnset self 0x0010
			CharTurnToChar self field_party[0] 500deg/s
			TextTalk self {
				#02103F妳在胡說什麼啊？這麼
				重大的事件，我怎能放過呢！？{wait}
			} {
				#02101F身為一個記者，
				我的使命就是親眼目擊真相，
				並把真相傳達給市民！{wait}
			}
			TextWait
			TextTalk name[2] {
				#00206F……看來阻止她也沒用吧。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00006F唉……看來是這樣。{wait}
			} {
				#00001F我們不知道現在究竟是什麼狀況。
				請千萬要提高警覺。{wait}
			}
			TextWait
			TextTalk self {
				#02102F呵呵！我知道啦。{wait}
			} {
				羅伊德，你們行動時
				也要注意安全喔！{wait}
			}
			TextWait
			FlagSet flag[3219]
			_Char4B char[2] 0
		else:
			TextTalk self {
				#02103F這麼重大的事件，
				我是絕對不會放過的！{wait}
			} {
				#02101F身為一個記者，
				我的使命就是
				把真相傳達給市民！{wait}
			}
			TextWait
	TextEnd self
	Return

fn[7]:
	TextStart self
	if flag[3074]:
	elif flag[3072]:
		if !flag[3]:
			_Char4A char[1] 0
			TextTalk char[1] {
				#02102F雷因茲！萬事拜託囉！{wait}
			} {
				#02109F拿出剛才那種膽識，
				緊緊跟著我一起來吧！{wait}
			}
			TextWait
			TextTalk self {
				那、那其實只是
				身體不由自主動起來罷了……{wait}
			}
			TextWait
			FlagSet flag[3]
			CharFlagsUnset self 0x0010
			_Char4B char[1] 0
		else:
			TextTalk self {
				呼，但也沒辦法。
				既然身為前輩的搭檔，
				總不能逃避危險啊……{wait}
			}
			TextWait
			TextTalk self {
				既然如此，
				我會盡量多拍一些照片！{wait}
			}
			TextWait
	TextEnd self
	Return

