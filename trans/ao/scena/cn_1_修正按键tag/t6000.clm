fn[4]:
	EventBegin 1
	SystemFlagsSet 0x08000000
	FadeOut 0ms 0x00000000 255
	Sleep 100ms
	SoundPlay sound[459] 0 100 0
	Sleep 2000ms
	ED7_12 459 1000 100
	SoundPlay sound[492] 0 70 0
	if flag[394]:
		if random % 100 < 50:
			SoundPlay sound[2502] 255 100 0
		else:
			SoundPlay sound[2503] 255 100 0
	elif random % 100 < 50:
		SoundPlay sound[3347] 255 100 0
	else:
		SoundPlay sound[3348] 255 100 0
	Sleep 500ms
	FadeIn 500ms 0x00000000
	FadeWait
	SystemFlagsUnset 0x08000000
	EventEnd 5
	Return

fn[5]:
	TextStart self
	if flag[3385]:
		if !flag[0]:
			TextTalk self {
				拘留所的警備也從國防軍
				回到我們的管轄之下。{wait}
			}
			TextWait
			TextTalk self {
				因為可以說是有點
				太過森嚴的狀態……{wait}
			}
			TextWait
			TextTalk name[1] {
				#00101F雖說帝國跟共和國
				有持續侵略……不過的確是這樣
				也說不定呢。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00008F大概是從我被拘留開始，
				看守才強化的吧。{wait}
			} {
				#00003F迪塔似乎對
				我們支援課團結一致
				感到提防的樣子……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				拘留所的警備也從國防軍
				回到我們的管轄之下。{wait}
			}
			TextWait
			TextTalk self {
				在適當的場所分配
				適當的人員，就可以像以前那樣
				有效率的執行警備吧。{wait}
			}
			TextWait
	elif flag[3074]:
		if !flag[0]:
			TextTalk char[1] {
				聽說攻擊事件之後，
				拘留所裡的囚犯們
				似乎也無法掩飾動搖。{wait}
			}
			TextWait
			TextTalk char[1] {
				我們姑且也有確認過
				囚犯的家人是否平安無事，
				果然其中也有受害者。{wait}
			}
			TextWait
			TextTalk char[1] {
				……就算對方是罪犯，
				要傳達這件事還是讓人心痛。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[1] {
				在他們當中，有許多人的家人
				都還留在克洛斯貝爾。{wait}
			}
			TextWait
			TextTalk char[1] {
				……就算對方是犯罪者，
				無法告訴他們家人平安，還是讓人心痛。{wait}
			}
			TextWait
	elif flag[2848]:
		TextTalk char[1] {
			這次的脫軌意外
			是某人刻意
			造成的嗎？{wait}
		}
		TextWait
		TextTalk char[1] {
			如果是這樣的話，真是罪孽深重。
			畢竟對無辜的一般人
			帶來那麼重大的災情……{wait}
		}
		TextWait
	elif flag[2842]:
		if !flag[0]:
			TextTalk char[1] {
				剛才那個彷彿是從
				地心深處傳來的吼聲……{wait}
			}
			TextWait
			TextTalk char[1] {
				拘留所內的囚犯們
				似乎也一陣騷動。{wait}
			}
			TextWait
			TextTalk char[1] {
