fn[0]:
	while 1:
		ED7CharAnimation self 1000ms 0 1 2 3 4
	Return

fn[1]:
	while 1:
		ED7CharAnimation self 1000ms 0 1 2 3 4
	Return

fn[2]:
	if system[0] == 0 + 100:
		Event fn[0,11]
	if system[0] == 1 + 100:
		Event fn[0,13]
	Return

fn[3]:
	EntranceSetDisabled entrance[0] 0
	EntranceSetDisabled entrance[1] 0
	if system[0] == 0 + 100:
		ED7_76_1 object[10] "Null_color" 1
		ED7_76_0 object[10] "Null_color2" 1
	else:
		ED7_76_0 object[10] "Null_color" 1
		ED7_76_1 object[10] "Null_color2" 1
	if system[0] == 1 + 100:
		ED7_76_1 object[11] "Null_color" 1
		ED7_76_0 object[11] "Null_color2" 1
	else:
		ED7_76_0 object[11] "Null_color" 1
		ED7_76_1 object[11] "Null_color2" 1
	if flag[3233]:
		ED7_76_1 object[12] "lock_g" 1
		ED7_76_0 object[12] "lock_r" 1
		ED7_76_2 object[255] "Null_gm01" "off"
	else:
		ED7_76_0 object[12] "lock_g" 1
		ED7_76_1 object[12] "lock_r" 1
		ED7_76_2 object[255] "Null_gm01" "on"
		Sc_BE 0 1 3 0 500 0 2 -198000 -17000 -174000 -206000 -15000 -190000
	if flag[3234]:
		ED7_76_1 object[13] "lock_g" 1
		ED7_76_0 object[13] "lock_r" 1
		ED7_76_2 object[255] "Null_gm02" "off"
	else:
		ED7_76_0 object[13] "lock_g" 1
		ED7_76_1 object[13] "lock_r" 1
		ED7_76_2 object[255] "Null_gm02" "on"
		Sc_BE 1 1 3 0 1000 0 2 -200500 -1000 -314500 -208500 1000 -322500
	EffLoad eff[17] "eff\\\\trapdmg1.eff"
	if !flag[4067]:
		ObjFrame object[0] 0
	else:
		ObjFrame object[0] 30
	if !flag[4068]:
		ObjFrame object[1] 0
	else:
		ObjFrame object[1] 30
	if !flag[4069]:
		ObjFrame object[2] 0
	else:
		ObjFrame object[2] 30
	if !flag[4070]:
		ObjFrame object[14] 0
	else:
		ObjFrame object[14] 30
	SoundPlay sound[133] 1 100 0
	Return

fn[4]:
	SystemFlagsSet 0x08000000
	if !flag[4067]:
		SoundPlay sound[14] 0 100 0
		ED7_74 object[0] 0 30
		ED7ObjPlay object[0] 0 30 0 0
		Sleep 500ms
		if !flag[4154]:
			CharColor char[0] 0x00FFFFFF 0ms
			CharTurnToChar char[0] field_party[0] 0deg/s
			_Char91 char[0] 0 1000 0 0 0
			Fork char[0] fork[1]:
				_Char91 self 0 -1000 0 1000 0
			Fork char[0] fork[2]:
				CharColor self 0xFFFFFFFF 1000ms
			CharFlagsUnset char[0] 0x0080
			CharFlagsSet char[0] 0x8000
			TextMessage name[742] {
				{color 5}魔獸出現了！{color 0}{wait}
			}
			TextWait
			TextClose 0
			ForkWait char[0] fork[1]
			ED7Battle battle[3] null 0 0 11 null
			CharFlagsSet char[0] 0x0080
			CharFlagsUnset char[0] 0x8000
			switch system[3]:
				case 0:
					FlagSet flag[4154]
					ObjFrame object[0] 30
					Sleep 500ms
					break
				case 2:
					ObjFrame object[0] 0
					TextEnd null
					SystemFlagsUnset 0x08000000
					Return
				case 1:
					ReturnToTitle 0
					Return
		if ItemAdd item[181] 1:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextMessage name[742] {
				{color 0}已取得{item[181]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			TextSetPos -1 280 60 3
			FadeIn 300ms 0x00000000
			FlagSet flag[4067]
			ED7_DE 5
		else:
			FadeOut 300ms 0x00000000 100
			TextMessage name[742] {
				寶箱裡裝有{item[181]}{color 0}。
				因持有物品已達上限，已放棄{item[181]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			SoundPlay sound[15] 0 100 0
			ED7ObjPlay object[0] 30 0 0 0
	else:
		FadeOut 300ms 0x00000000 100
		TextMessage name[742] {
			{0x06}{color 5}寶箱裡什麼都沒有。{color 0}{wait}
		}
		TextWait
		TextClose 0
		FadeIn 300ms 0x00000000
	Sleep 30ms
	TextEnd null
	SystemFlagsUnset 0x08000000
	Return

