fn[1]:
	if flag[3100]:
		system[1] = 251
	MapColor 0x00FFEBDC 0ms
	Fog 0xFFD5B47B 5 90 0
	if !flag[3370] && flag[3100]:
		Fog 0xFFFFC3AA 0 140 0
		ObjFlagsUnset object[3] 0x0004
		ED7_74 object[3] 0 30
		ED7ObjPlay object[3] 0 600 0 32
		Sc_BE 0 1 3 0 0 0 1 28900 0 6700 2000 2000 0
		Sc_BE 1 1 3 0 0 0 1 29360 0 4250 2000 2000 0
		Sc_BE 2 1 3 0 0 0 1 29900 0 1510 2000 2000 0
		Sc_BE 3 1 3 0 0 0 1 30430 0 -1250 2000 2000 0
		Sc_BE 4 1 3 0 0 0 1 30960 0 -3990 2000 2000 0
		Sc_BE 5 1 3 0 0 0 1 31500 0 -6740 2000 2000 0
		Sc_BE 6 1 3 0 0 0 1 31940 0 -9220 2000 2000 0
		Sc_BE 7 1 3 0 0 0 1 32560 0 -12230 2000 2000 0
		Sc_BE 8 1 3 0 0 0 1 32910 0 -13570 2000 2000 0
		EffLoad eff[17] "eff\\\\trapdmg2.eff"
	else:
		ObjFlagsSet object[3] 0x0004
	TriggerFlagsSet trigger[0] 0x0080
	if flag[3385]:
		TriggerFlagsUnset trigger[0] 0x0080
	Return

fn[2]:
