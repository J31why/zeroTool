	else:
		ObjFrame object[24] 30
	ObjFlagsUnset object[28] 0x0004
	ObjFlagsSet object[28] 0x1000
	ED7_76_0 object[28] "light" 1
	Return

fn[3]:
	ED7_F2 1
	SystemFlagsSet 0x08000000
	if !flag[3934]:
		SoundPlay sound[14] 0 100 0
		ED7_74 object[24] 0 30
		ED7ObjPlay object[24] 0 30 0 0
		Sleep 500ms
		if ItemAdd item[1502] 1:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextSetName ""
			TextMessage name[742] {
				{color 0}已取得{item[1502]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			TextSetPos -1 280 60 3
			FadeIn 300ms 0x00000000
			FlagSet flag[3934]
			ED7_DE 5
		else:
			FadeOut 300ms 0x00000000 100
			TextSetName ""
			TextMessage name[742] {
				寶箱裡裝有{item[1502]}{color 0}。
				因持有物品已達上限，已放棄{item[1502]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			SoundPlay sound[15] 0 100 0
			ED7ObjPlay object[24] 30 0 0 0
	else:
		FadeOut 300ms 0x00000000 100
		TextSetPos -1 -1 -1 -1
		TextSetName ""
		TextMessage name[742] {
			{0x06}{color 5}寶箱裡什麼都沒有。{color 0}{wait}
		}
		TextWait
		TextClose 0
		FadeIn 300ms 0x00000000
	Sleep 30ms
	TextEnd null
	SystemFlagsUnset 0x08000000
	Return

fn[4]:
	TextStart self
	TextTalk self {
		哦，天色已經
		變得這麼暗了啊。{wait}
	}
	TextWait
	TextTalk self {
		也該是我
		踏上歸途的時候了。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[5]:
	TextStart self
	if !flag[1]:
		TextTalk self {
			我總覺得聽到
			那間房子傳來
			很像是女孩的聲音。{wait}
		}
		TextWait
		TextTalk self {
			不過，這間房子應該
			沒有人住才對啊……{wait}
		}
		TextWait
		TextTalk self {
			嗯，大概是我聽錯了吧。{wait}
		}
		TextWait
		FlagSet flag[1]
	else:
		TextTalk self {
			這麼說來，
			大約在十年前，曾經有過
			這間房子鬧鬼的傳聞吧。{wait}
		}
		TextWait
		TextTalk self {
			不過，那只是
			愚蠢的謠言罷了。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[6]:
	TextStart self
	if flag[2568]:
		if !flag[2]:
			TextTalk self {
				抱歉，為了配合會議期間的警備，
				目前正在實施夜間道路管制。{wait}
			}
			TextWait
			TextTalk self {
				如果想要通過這裡，
				能否請您出示身分證？{wait}
			}
			TextWait
			TextTalk name[0] {
				#00008F（只要表明我們的身分，
				　應該就會讓我們通過了，不過……）{wait}
			}
			TextWait
			TextTalk name[9] {
				#00603F（沒有這個必要。
				　我們快點去地下區域吧。）{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			TextTalk self {
				抱歉，為了配合會議期間的警備，
				目前正在實施夜間道路管制。{wait}
			}
			TextWait
			TextTalk self {
				如果想要通過這裡，
				能否請您出示身分證？{wait}
			}
			TextWait
	TextEnd self
	Return

fn[7]:
	TextStart self
	if !flag[2634]:
		Call fn[0,8]
	else:
		TextTalk self {
			各位辛苦了。{wait}
		}
		TextWait
		TextTalk self {
			目前這裡
			並無異狀。{wait}
		}
		TextWait
	TextEnd self
	Return

