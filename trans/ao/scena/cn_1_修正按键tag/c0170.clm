fn[3]:
	if flag[3074]:
		LookPointFlagsSet look_point[1] 0x0001
	if !flag[3385] && flag[3371]:
		LookPointFlagsSet look_point[0] 0x0001
	if flag[2848] && !flag[2858] | flag[2369] && system[4] == 1:
		ED7_76_0 object[255] "hikari00_add" 1
		ED7_76_0 object[255] "hikari01_add" 1
		SoundPlay sound[128] 1 50 0
	if !flag[3385] && flag[3370]:
		MapColor 0x00E6D2D2 0ms
		ED7_76_0 object[255] "hikari00_add" 1
		ED7_76_0 object[255] "hikari01_add" 1
	if system[0] == 102:
		ED7_76_1 object[255] "model5" 1
	else:
		ED7_76_0 object[255] "model5" 1
	LookPointFlagsSet look_point[9] 0x0001
	if QuestFlagsGet quest[115] 0x02 && !QuestFlagsGet quest[115] 0x10 && !QuestFlagsGet quest[115] 0x40 && flag[2723]:
		EntranceSetFunc entrance[0] fn[0,53]
		LookPointFlagsUnset look_point[9] 0x0001
	Return

fn[4]:
	TextSetName ""
	TextSetPos -1 -1 -1 -1
	TextMessage null {
		{color 5}　　★　瑞瓊食品・備忘　★
		提供來店的客人口感清爽的
		鈴莓果汁。{wait}
	}
	TextWait
	TextMessage null {
		{color 5}這裡寫著鈴莓果汁的食譜。{wait}
	}
	TextWait
	TextClose 0
	_59
	TextSetPos -1 280 60 3
	if ItemHas item[2] 0:
		if !RecipeLearn 22:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextSetName ""
			TextMessage null {
				記住了{color 2}『鈴莓果汁』{color 0}的食譜。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			FadeWait
			_59
			TextSetPos -1 280 60 3
	TextEnd null
	Return

fn[5]:
	Call fn[0,6]
	Return

fn[6]:
	TextStart char[0]
	if flag[3385]:
		TextTalk char[0] {
			不久前史考特先生來露過臉了，
			看起來很有精神的樣子，
			真是太好了。{wait}
		}
		TextWait
		TextTalk char[0] {
			畢竟他那麼努力……
			我也得盡我所能
			好好努力才行！{wait}
		}
		TextWait
	elif flag[3371]:
		if !flag[3548]:
			Call fn[0,23]
		elif !flag[0]:
			TextTalk char[0] {
				幸好這個地方
				目前還不缺
				食材和日用品，不過……{wait}
			}
			TextWait
			TextTalk char[0] {
				如果這個狀況持續得太久，
				反而讓人擔心有些家庭
				缺少這方面的庫存呢。{wait}
			}
			TextWait
			TextTalk char[0] {
				說真的……政府到底
				在想些什麼呢？{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				說真的……政府到底
				在想些什麼呢？{wait}
			}
			TextWait
			TextTalk char[0] {
				希望史考特先生
				平安無事……{wait}
			}
			TextWait
	elif flag[3089]:
		if !flag[0]:
			TextTalk char[0] {
				辛西亞學姊在公民投票的隔天，
				就回到故鄉雷米菲利亞了。{wait}
			}
			TextWait
			TextTalk char[0] {
				學姊應該也
				沒預料到現在克洛斯貝爾
				會是這種情況……{wait}
			}
			TextWait
			TextTalk char[0] {
				她的家人好像
				從以前就很擔心她的樣子，
				能提早回國真是太好了。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				辛西亞學姊跟我約好了，
				她一定還會再回到
				這間百貨。{wait}
			}
			TextWait
			TextTalk char[0] {
				雖然很擔心將來的事情……
				但我相信一定有天可以跟學姊
				相聚，總之現在要好好努力。{wait}
			}
			TextWait
	elif flag[3074]:
		if !flag[0]:
			TextTalk char[0] {
				辛西亞學姊去幫忙
				在行政區舉辦的
				慈善活動了。{wait}
			}
			TextWait
			TextTalk char[0] {
				而且聽說她
				還參加了選美比賽。
				等一下要請她給我看照片♪{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
