		CharFlagsUnset char[26] 0x0080
		CharSetPos char[9] (-13470, 0, 6510) 135deg
		CharSetPos char[26] (-12670, 0, 5710) 315deg
	elif flag[3371]:
		CharSetPos char[10] (-17370, 30, 22740) 45deg
		CharFlagsSet char[1] 0x0080
		CharSetPos char[0] (-1360, 0, 9830) 270deg
