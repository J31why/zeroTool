		CharFlagsUnset char[7] 0x0080
		CharSetPos char[8] (8060, 8000, 2080) 90deg
		CharSetPos char[7] (9560, 8000, 2080) 270deg
	elif flag[3089]:
		CharFlagsSet char[1] 0x0080
		CharSetPos char[14] (-13640, 8029, 7380) 45deg
		CharFlagsSet char[5] 0x0010
		CharFlagsSet char[14] 0x0010
		CharSetPos char[13] (8020, 8000, 17270) 90deg
		CharSetPos char[12] (9070, 8000, 17290) 270deg
		ForkFunc char[12] fork[0] fn[0,0]
	elif flag[3074]:
		CharFlagsSet char[1] 0x0080
		CharSetPos char[14] (-13640, 8029, 7380) 45deg
		CharFlagsSet char[5] 0x0010
		CharFlagsSet char[14] 0x0010
	elif flag[2861]:
		CharSetPos char[14] (-13640, 8029, 7380) 45deg
		CharFlagsSet char[5] 0x0010
		CharFlagsSet char[14] 0x0010
	elif flag[2848]:
		CharSetPos char[14] (-13640, 8029, 7380) 45deg
		CharFlagsSet char[5] 0x0010
		CharFlagsSet char[14] 0x0010
		CharFlagsUnset char[8] 0x0080
		CharFlagsUnset char[7] 0x0080
		CharFlagsUnset char[18] 0x0080
	elif flag[2837]:
		CharFlagsUnset char[27] 0x0080
	elif flag[2832]:
		CharFlagsUnset char[25] 0x0080
	elif flag[2816]:
		CharFlagsSet char[10] 0x0080
	elif flag[2573]:
		CharFlagsUnset char[19] 0x0080
		CharFlagsSet char[19] 0x0010
		CharFlagsUnset char[20] 0x0080
		if !flag[16]:
			CharFlagsSet char[20] 0x0010
		CharFlagsUnset char[22] 0x0080
		CharFlagsUnset char[23] 0x0080
		CharSetChipBase char[22] chip[19]
		CharSetChipPattern char[22] 0
		ForkQuit char[22] fork[0]
		CharFlags2Set char[22] 0x0004
		CharSetChipBase char[23] chip[20]
		CharSetChipPattern char[23] 0
		ForkQuit char[23] fork[0]
		CharFlags2Set char[23] 0x0004
		CharFlagsSet char[11] 0x0080
		CharFlagsUnset char[24] 0x0080
	elif flag[2568]:
		CharSetPos char[13] (8020, 8000, 17270) 90deg
		CharSetPos char[12] (9070, 8000, 17290) 270deg
		ForkFunc char[12] fork[0] fn[0,0]
		CharFlagsSet char[12] 0x0010
		CharFlagsSet char[11] 0x0080
	elif flag[2564]:
		CharFlagsUnset char[18] 0x0080
		CharFlagsUnset char[22] 0x0080
		CharFlagsUnset char[23] 0x0080
		CharSetChipBase char[22] chip[19]
