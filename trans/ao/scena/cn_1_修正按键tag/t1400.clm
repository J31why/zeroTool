fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if flag[2608]:
	elif flag[2607]:
	elif flag[2605]:
	elif flag[2604]:
		Call fn[0,26]
	elif flag[2602]:
	elif flag[2601]:
	elif flag[2600]:
	elif flag[2597]:
	elif flag[2592]:
	if flag[272]:
		FlagUnset flag[272]
		Event fn[0,37]
	if flag[273]:
		FlagUnset flag[273]
		Event fn[0,34]
	Return

fn[2]:
	if flag[3385]:
		system[1] = 563
	if flag[3093] && !flag[3100]:
		SoundStop sound[821]
		SoundLoad sound[918]
		ForkFunc char[24] fork[3] fn[0,39]
	elif flag[3100]:
		SoundStop sound[821]
	else:
		SoundPlay sound[821] 1 50 0
	SoundPlay sound[126] 1 80 0
	TriggerFlagsSet trigger[0] 0x0080
	if flag[3095] && !flag[3096]:
		TriggerFlagsUnset trigger[0] 0x0080
	if !flag[3093]:
		ED7_76_2 object[255] "water" "loop_off"
		ED7_76_2 object[255] "main" "loop_off"
	if flag[2604] && !flag[2605] && ItemHas item[861] 0 <= 1:
		ED7_76_0 object[255] "sky01" 1
		ED7_76_1 object[255] "sky_y" 1
		ED7_76_1 object[255] "sky01_y" 1
		MapColor 0x00B4BEFF 0ms
		Fog 0xFF7B8FD5 38 500 0
	else:
		ED7_76_1 object[255] "sky01" 1
		ED7_76_0 object[255] "sky_y" 1
		ED7_76_0 object[255] "sky01_y" 1
	if flag[3385]:
		MapColor 0x00FFEBDC 0ms
		Fog 0xFFD5B47B 20 300 0
	elif flag[3355]:
		MapColor 0x00FFEBDC 0ms
		Fog 0xFFD5B47B 20 300 0
	if flag[2604] && !flag[2605]:
		ObjFlagsUnset object[0] 0x0010
	LookPointFlagsSet look_point[0] 0x0001
	if QuestFlagsGet quest[127] 0x02 && !QuestFlagsGet quest[127] 0x10 && !QuestFlagsGet quest[127] 0x40 && !flag[3663] && flag[3662]:
		LookPointFlagsUnset look_point[0] 0x0001
	Return

fn[3]:
	TextStart self
	if ItemHas item[861] 0 == 5:
	elif ItemHas item[861] 0 == 4:
	elif ItemHas item[861] 0 == 3:
	elif ItemHas item[861] 0 == 2:
		TextTalk char[0] {
			#00100F剛才從城那邊
			傳來了很悅耳的鐘聲。{wait}
		} {
			#00109F呵呵，不知道是哪對情侶
			對鏡子許了願望呢？{wait}
		}
		TextWait
	elif ItemHas item[861] 0 == 1:
	TextEnd self
	Return

fn[4]:
	TextStart self
	if ItemHas item[861] 0 == 5:
	elif ItemHas item[861] 0 == 4:
	elif ItemHas item[861] 0 == 3:
	elif ItemHas item[861] 0 == 2:
	elif ItemHas item[861] 0 == 1:
		if !flag[0]:
			TextTalk char[1] {
				#00302F晚上的時候，聽說那座鏡之城
				會把燈光全部點起來喔。{wait}
			} {
				#00304F同時還會有煙火跟遊行，
				就像是幫主題樂園
				劃下一日的完美句點。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[1] {
				#00302F機會這麼難得，
				我還真想和美麗的大姊姊
				一起欣賞晚上的表演……{wait}
			} {
				#00306F不過還有晚宴，
				我看也沒辦法。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[5]:
	TextStart self
	if ItemHas item[861] 0 == 5:
	elif ItemHas item[861] 0 == 4:
	elif ItemHas item[861] 0 == 3:
	elif ItemHas item[861] 0 == 2:
		TextTalk char[2] {
			#10103F『實現願望的鏡子』的傳說……
			真的能夠實現願望嗎？{wait}
		} {
			#10100F不過所謂『無風不起浪』，
			我想還是可以
			稍微期待一下效果吧？{wait}
		}
		TextWait
	elif ItemHas item[861] 0 == 1:
	TextEnd self
	Return

fn[6]:
	TextStart self
	if ItemHas item[861] 0 == 5:
	elif ItemHas item[861] 0 == 4:
	elif ItemHas item[861] 0 == 3:
		if !flag[1]:
			Call fn[0,7]
		else:
			TextTalk char[3] {
				#10302F不相信的話就沒意思了……是嗎？
				呵呵，的確是這樣沒錯。{wait}
			} {
				#10304F也好，也讓我好好
				享受一下吧。{wait}
			}
			TextWait
	elif ItemHas item[861] 0 == 2:
	elif ItemHas item[861] 0 == 1:
	TextEnd self
	Return

fn[7]:
	_Char4A char[3] 255
	_Char4A char[5] 255
	TextTalk char[3] {
		#10300F『實現願望的鏡子』……{wait}
	} {
		#10302F妳真的相信
		那能夠實現願望嗎？{wait}
	}
	TextWait
	TextTalk char[5] {
		#06409F那當然！{wait}
	} {
		#06400F因為，如果不相信的話，
		這設施就
		一點都不好玩了嘛～！{wait}
	}
	TextWait
	TextTalk char[3] {
		#10300F呵呵，原來如此。
		妳說得沒錯。{wait}
	}
	TextWait
	FlagSet flag[1]
	CharFlagsUnset char[3] 0x0010
	CharFlagsUnset char[5] 0x0010
	_Char4B char[3] 255
	_Char4B char[5] 255
	Return

