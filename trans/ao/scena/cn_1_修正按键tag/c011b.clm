	unk3 0
	unk4 0

look_point[1]:
	pos (16960, 850, 10840)
	radius 2000
	bubble_pos (16960, 1300, 10840)
	unk1 124
	unk2 0
	function fn[0,25]
	unk3 0
	unk4 0

fn[0]:
	switch random % 8:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		ED7CharAnimation self 1500ms 0 1 2 3 4
	Return

fn[2]:
	if !flag[2573] && flag[2568]:
		CharFlagsUnset char[0] 0x0080
		CharSetPos char[0] (14400, 850, 12500) 0deg
		ForkFunc char[0] fork[0] fn[0,0]
		CharFlagsUnset char[0] 0x0040
		CharFlagsUnset char[2] 0x0080
		CharSetChipBase char[2] chip[3]
		CharSetChipPattern char[2] 0
		ForkQuit char[2] fork[0]
		CharFlags2Set char[2] 0x0004
		CharSetPos char[2] (5570, 150, 6230) 180deg
		CharFlagsUnset char[1] 0x0080
		CharSetChipBase char[1] chip[5]
		CharSetPos char[1] (2880, 0, 1750) 225deg
		CharFlagsSet char[1] 0x0010
		CharFlagsUnset char[1] 0x0040
	if flag[272]:
		FlagUnset flag[272]
		Event fn[0,8]
	elif flag[273]:
		FlagUnset flag[273]
		Event fn[0,10]
	elif flag[274]:
		FlagUnset flag[274]
		Event fn[0,17]
	elif flag[275]:
		FlagUnset flag[275]
		Event fn[0,19]
	elif flag[276]:
		FlagUnset flag[276]
		Event fn[0,20]
	elif flag[277]:
		FlagUnset flag[277]
		FlagSet flag[4]
		Event fn[0,22]
	elif flag[278]:
		FlagUnset flag[278]
		Event fn[0,23]
	elif flag[279]:
		FlagUnset flag[279]
	elif flag[280]:
		FlagUnset flag[280]
		Event fn[0,24]
	Return

fn[3]:
	if flag[4]:
		system[1] = 515
		FlagUnset flag[4]
	ObjFlagsSet object[25] 0x0004
	if flag[3089]:
		ED7_76_0 object[255] "asihuki" 1
	else:
		ED7_76_1 object[255] "asihuki" 1
	ObjFlagsUnset object[6] 0x0010
	if flag[2573]:
		ObjFlagsSet object[6] 0x0010
		LookPointFlagsSet look_point[0] 0x0001
	Return

fn[4]:
	TextStart self
	if !flag[0]:
		TextTalk char[0] {
			#01000F我會先把恐怖分子的情報
			彙報給市長和警備隊那邊。{wait}
		} {
			達德利，我的部下們
			就交給你照顧了。{wait}
		}
		TextWait
		TextTalk name[9] {
			#00603F嗯，請交給我吧。{wait}
		} {
			#00601F……好了，各位，我們出發吧。{wait}
		}
		TextWait
		TextTalk name[0] {
			#00000F是！{wait}
		}
		TextWait
		FlagSet flag[0]
	else:
		TextTalk char[0] {
			#01000F雖然我不知道地下區域
			發生了什麼事，
			但你們要提高警覺啊。{wait}
		} {
			達德利，我的部下們
			就交給你照顧了。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[5]:
	TextStart self
	if !flag[1]:
		TextTalk char[2] {
			#01100F大家路上小心啊！{wait}
		} {
			#01109F耶嘿嘿！達德利也要注意安全喔！{wait}
		}
		TextWait
		TextTalk name[9] {
			#00603F就叫妳不要直呼我的名字了……！{wait}
		}
		TextWait
		TextTalk char[2] {
			#01105F嗯？{wait}
		}
		TextWait
		Emote name[9] 0mm 2000mm 16 19 250ms 1
		SoundPlay sound[23] 0 100 0
		Sleep 1000ms
		TextTalk name[9] {
			#00606F……可惡！真是夠了！
			你們幾個，快點出發吧！{wait}
		}
		TextWait
		TextTalk name[0] {
			#00012F（嗯，看來就連達德利警官
			　也拿琪雅沒轍。）{wait}
		}
		TextWait
		FlagSet flag[1]
	else:
		TextTalk char[2] {
			#01109F大家路上小心啊！{wait}
		} {
			耶嘿嘿！達德利也要注意安全喔！{wait}
		}
		TextWait
		TextTalk name[9] {
			#00603F（真是的……）{wait}
		}
		TextWait
	TextEnd self
	Return

fn[6]:
	TextStart self
	if !flag[2]:
		TextTalk char[1] {
			#01200F吼喔喔喔喔……{wait}
		}
		TextWait
		TextTalk name[9] {
			#00603F哼，這隻狼還是一樣傲慢。{wait}
		} {
			#00600F不過，既然你身為警犬，
			我們遲早會需要你的能力。
			你可要做好準備，以便隨時出動。{wait}
		}
		TextWait
		TextTalk char[1] {
			#01200F……汪。{wait}
		}
		TextWait
		if PartyPosition name[0] >= 0 && PartyPosition name[0] < 4:
			Emote name[0] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Sleep 50ms
		if PartyPosition name[1] >= 0 && PartyPosition name[1] < 4:
			Emote name[1] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Sleep 50ms
		if PartyPosition name[3] >= 0 && PartyPosition name[3] < 4:
			Emote name[3] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Sleep 50ms
		if PartyPosition name[8] >= 0 && PartyPosition name[8] < 4:
			Emote name[8] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Sleep 50ms
		if PartyPosition name[4] >= 0 && PartyPosition name[4] < 4:
			Emote name[4] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Sleep 50ms
		Sleep 1000ms
		TextTalk name[3] {
			#00306F（他根本沒資格
			　說別人傲慢吧……）{wait}
		}
		TextWait
		TextTalk name[1] {
			#00100F（呵呵，這應該是達德利警官
			　獨特的鼓勵別人的方式吧。）{wait}
		}
		TextWait
		FlagSet flag[2]
	else:
		TextTalk char[1] {
			#01200F吼喔喔喔……汪。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[7]:
	TextStart null
	TextTalk name[0] {
		#00000F這裡是緹歐的房間。
		還是別進去吧。{wait}
	}
	TextWait
	TextEnd null
	Return

