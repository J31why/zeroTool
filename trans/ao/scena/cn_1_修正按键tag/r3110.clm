fn[4]:
	TextStart self
	CharSetChipPattern self 0
	if !flag[3573]:
		if PartyPosition name[0] < 4:
			CharTurnToChar self name[0] 0deg/s
		TextTalk name[0] {
			#00005F你是黑月的……{wait}
		}
		TextWait
		TextTalk self {
			……辛苦了。{wait}
		}
		TextWait
		FlagSet flag[3573]
	if flag[3362]:
		if !flag[3575]:
			Call fn[0,5]
		else:
			TextTalk self {
				……曹先生忙著擬定《紅色星座》的
				對策，暫時騰不出時間來
				跟你們會面吧。{wait}
			}
			TextWait
			TextTalk self {
				請在解除《結界》後
				再來這裡與我們聯絡。{wait}
			}
			TextWait
	elif flag[3361]:
		TextTalk self {
			曹先生現在
			在藏身處非常忙碌。{wait}
		}
		TextWait
		TextTalk self {
			請你們下次有機會再來。{wait}
		}
		TextWait
	elif flag[3343]:
		if !flag[3574]:
			Call fn[0,5]
		else:
			TextTalk self {
				若是情況有所進展，
				請各位再來此處拜訪。{wait}
			}
			TextWait
			TextTalk self {
				如果各位前來時
				曹先生能出來會面，我會
				再帶各位前往大人的藏身處。{wait}
			}
			TextWait
			TextTalk self {
				……那麼，就此別過。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[5]:
