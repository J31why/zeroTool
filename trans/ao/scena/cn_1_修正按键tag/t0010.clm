	}
	TextWait
	TextTalk char[10] {
		#4P但我當時不但沒放在心上，
		還覺得痛快多了。{wait}
	}
	TextWait
	TextTalk char[10] {
		#4P離婚協議書正式受理後，
		才第二天，我就把其他情婦
