		企圖轉移自己的注意力。{wait}
	}
	TextWait
	TextTalk char[10] {
		#4P於是我越來越得寸進尺，
		有一天……我做了件
		有孩子的人絕對不該做的事。{wait}
	}
	TextWait
	TextTalk char[10] {
		#4P趁內人出門的空檔，
		我把當時的情婦找進家裡。{wait}
	}
