		CharSetPos char[5] (-47480, 0, -1230) 90deg
		CharSetChipBase char[3] chip[11]
		CharFlags2Unset char[3] 0x0004
		CharFlagsUnset char[3] 0x0040
		ForkFunc char[3] fork[0] fn[0,0]
		CharSetPos char[3] (-46490, 0, -1230) 270deg
		if !flag[3436]:
			CharFlagsSet char[5] 0x0010
			CharFlagsSet char[3] 0x0010
		CharSetChipBase char[2] chip[10]
		CharSetChipPattern char[2] 0
		ForkQuit char[2] fork[0]
		CharFlags2Set char[2] 0x0004
		CharSetPos char[2] (38320, 180, -2250) 0deg
		if !flag[6]:
			CharFlagsSet char[1] 0x0010
			CharFlagsSet char[2] 0x0010
	elif flag[3362]:
	elif flag[3343]:
	elif flag[3328]:
	elif flag[3074]:
