fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharIdle self (-3290, null, 2920) (4110, null, -290) 2000mm/s
		Sleep 250ms
	Return

fn[2]:
	CharSetChipBase char[3] chip[0]
	CharSetChipPattern char[3] 0
	ForkQuit char[3] fork[0]
	CharFlags2Set char[3] 0x0004
	CharSetChipBase char[0] chip[5]
	CharSetChipPattern char[0] 0
	ForkQuit char[0] fork[0]
	CharFlags2Set char[0] 0x0004
	CharSetChipBase char[1] chip[6]
	CharSetChipPattern char[1] 0
	ForkQuit char[1] fork[0]
	CharFlags2Set char[1] 0x0004
	CharFlagsSet char[9] 0x0080
	CharFlagsSet char[10] 0x0080
	if flag[3385]:
