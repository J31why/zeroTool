fn[3]:
	if flag[3100]:
		system[1] = 563
	if flag[2848] && !flag[2858]:
		ED7_76_0 object[255] "hikari_add" 1
		SoundPlay sound[128] 1 50 0
	Return

fn[4]:
	TextStart self
	if flag[3385]:
		if !flag[0]:
			TextTalk self {
				聽說總統好像
				在克洛斯貝爾市被逮捕了。{wait}
			}
			TextWait
			TextTalk self {
				協會的遊擊士
				能自由行動後，
				馬上就到村裡來關心了。{wait}
			}
			TextWait
			TextTalk self {
				身處這樣的狀況，
				全克洛斯貝爾
				更應該要通力合作。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				協會的遊擊士
				能自由行動後，
				馬上就到村裡來關心了。{wait}
			}
			TextWait
			TextTalk self {
				身處這樣的狀況，
				全克洛斯貝爾
				更應該要通力合作。{wait}
			}
			TextWait
	elif flag[3362]:
		if !flag[0]:
			TextTalk self {
				最近德瑞克常挨家挨戶造訪村裡，
				順便確認大家是否平安。{wait}
			}
			TextWait
			TextTalk self {
				現在這種狀況，
				光是看到熟人的臉孔，
				就能放心不少嘛。{wait}
			}
			TextWait
			TextTalk self {
				這作法真有德瑞克的風格，
				認真又誠懇。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				最近德瑞克常挨家挨戶造訪村裡，
				順便確認大家是否平安。{wait}
			}
			TextWait
			TextTalk self {
				光是看到熟人的臉孔，
				就能放心不少嘛。
				呵呵，真有德瑞克的風格。{wait}
			}
			TextWait
	elif flag[3328]:
		if !flag[0]:
			TextTalk self {
				我弟弟艾爾琴每天
				嚷著『不能開車兜風』，
				一直不停在嘆氣。{wait}
			}
			TextWait
			TextTalk self {
				現在處處受限的狀況
				已經夠煩了，
				他還一直抱怨抱怨抱怨……{wait}
			}
			TextWait
			TextTalk self {
				現在這種情況，
				每天能吃到新鮮的食物
				就該心存感激了。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				我弟弟艾爾琴每天
				嚷著『不能開車兜風』，
				一直不停在嘆氣。{wait}
			}
			TextWait
			TextTalk self {
				現在這種情況，
				每天能吃到新鮮的食物
				就該心存感激了。{wait}
			}
			TextWait
	elif flag[3074]:
		TextTalk self {
			最近在古戰場一帶，
			不時會有像是穿著鎧甲的
			詭異魔獸出沒。{wait}
		}
		TextWait
		TextTalk self {
			會不會是哪個有錢人養的魔獸
			偷跑出來了啊……？{wait}
		}
		TextWait
	elif flag[2848]:
		if !flag[0]:
			TextTalk self {
				對我們農家來說，
				雨水能滋養作物，
				是上天賜予的恩惠。{wait}
			}
			TextWait
			TextTalk self {
				幸好有女神庇佑，
				我們才能有食物吃。
				一定要心存感謝。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				對我們農家來說，
				雨水能滋養作物，
				是上天的恩惠。{wait}
			}
			TextWait
			TextTalk self {
				一定要
				好好感謝女神才行。{wait}
			}
			TextWait
	elif flag[2832]:
		if !QuestFlagsGet quest[135] 0x10:
			if !flag[0]:
				TextTalk self {
					德瑞克推動的村莊改革……
					我實在不太能夠認同啊。{wait}
				}
				TextWait
				TextTalk self {
					將導力器導入農田，
					據說能輕鬆不少，可是……{wait}
				}
				TextWait
				TextTalk self {
					我就是喜歡做農務嘛。
					工作被機器搶走，心情會很複雜吧。{wait}
				}
				TextWait
				FlagSet flag[0]
			else:
				TextTalk self {
					村莊改革是要
					讓生活變得更方便，
					這點是很好，可是……{wait}
				}
				TextWait
				TextTalk self {
					我就是喜歡做農務嘛。
					要是變得太方便，心情會很複雜吧。{wait}
				}
				TextWait
		elif !flag[0]:
			TextTalk self {
				我們全體村民都
				被那個叫明涅斯的人騙了。{wait}
			}
			TextWait
			TextTalk self {
				原來社會上
				也有人能若無其事地
				欺騙他人……{wait}
			}
			TextWait
			TextTalk self {
				真是上了一課啊。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				原來社會上
				也有人能若無其事地
				欺騙他人……{wait}
			}
			TextWait
			TextTalk self {
				真是上了一課啊。{wait}
			}
			TextWait
	elif flag[2816]:
		if !flag[2980]:
			if !flag[0]:
				TextTalk self {
					要找艾爾琴的話，他載著作物
					去城裡卸貨了。{wait}
				}
				TextWait
				TextTalk self {
					最近他好像很亢奮。
					常常繞遠路，順便去兜風完
					才回村子。{wait}
				}
				TextWait
				TextTalk self {
					唉，能便宜買到
					那樣的東西，當然很開心，
					我也不是不能體會啦。{wait}
				}
				TextWait
				FlagSet flag[0]
			else:
				TextTalk self {
					要找艾爾琴的話，他
					去城裡卸貨了。{wait}
				}
				TextWait
				TextTalk self {
					應該不久之後
					就會回來了吧。{wait}
				}
				TextWait
		else:
			TextTalk self {
				艾爾琴他啊，自從明涅斯先生
				把導力貨車便宜賣他之後，
				就一直非常興奮。{wait}
			}
			TextWait
			TextTalk self {
				雖然我懂他的心情……
				但還是得提醒他要小心駕駛，
				以免發生意外。{wait}
			}
			TextWait
	elif flag[2573]:
		if !flag[0]:
			TextTalk self {
				這個村子的村長，每屆
				都是由村民表決選出適合的人。{wait}
			}
			TextWait
			TextTalk self {
				村長的兒子德瑞克最適合擔任下屆村長，
				村裡的人都認同這點，不過……{wait}
			}
			TextWait
			TextTalk self {
				德瑞克個性太死板，所以
				什麼事都會想得很複雜。{wait}
			}
			TextWait
			TextTalk self {
				思考村子的未來
				當然是好事……不過，希望他能
				讓我們多幫他一點。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				德瑞克個性太死板，所以
				什麼事都會想得很複雜。{wait}
			}
			TextWait
			TextTalk self {
				希望他不會獨自煩惱，
				最後做出些傻事來。{wait}
			}
			TextWait
	elif flag[2564]:
		if !flag[0]:
			TextTalk self {
				艾爾琴的腔調，
				我們稱為『阿爾摩利卡腔』。{wait}
			}
			TextWait
			TextTalk self {
				現在村裡只有
				多納爾德大叔跟艾爾琴會講，
				是過去流傳下來的腔調。{wait}
			}
			TextWait
			TextTalk self {
				這種腔調給人『道地的
				阿爾摩利卡村人』的感覺，
				我覺得不用勉強矯正，只是……{wait}
			}
			TextWait
			TextTalk self {
				男人還真常為一些
				不重要的小事煩惱呢。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				艾爾琴的阿爾摩利卡腔，
				是過去流傳下來，
				可說是很寶貴的腔調。{wait}
			}
			TextWait
			TextTalk self {
				我並不討厭，
				也覺得不用勉強去矯正。{wait}
			}
			TextWait
	elif flag[2560]:
		if !flag[0]:
			TextTalk self {
				最近真的好平靜喔。
				加上有適量的雨水，
				作物也長得很好……{wait}
			}
			TextWait
			TextTalk self {
				像今天這樣的好天氣，
				曬曬太陽真是舒服。{wait}
			}
			TextWait
			TextTalk self {
				嗯，乾脆在導力貨車上
				鋪個稻草睡個午覺好了。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				像今天這樣的好天氣，
				曬曬太陽真是舒服。{wait}
			}
			TextWait
			TextTalk self {
				嗯，乾脆在導力貨車上
				鋪個稻草睡個午覺好了。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[5]:
	TextStart self
	if flag[3385]:
		if !flag[6]:
			Call fn[0,6]
		else:
			TextTalk self {
				唉，安潔說得對。{wait}
			}
			TextWait
			TextTalk self {
				為了不讓村裡糧食短缺，
				我們農家一定要
				好好努力才行。{wait}
			}
			TextWait
	elif flag[3362]:
		if !flag[1]:
			TextTalk self {
				雖然獨立宣言發表後，
				村裡的貨車就不能再開進
				克洛斯貝爾市了，不過……{wait}
			}
			TextWait
			TextTalk self {
				克洛斯貝爾市那邊，
				一定也有人很期待我們送
				新鮮的蔬菜去唄。{wait}
			}
			TextWait
			TextTalk self {
				沒辦法把農產品
				送去給他們，身為
				生產者，我也很難受唄。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				克洛斯貝爾市那邊，
				一定也有人很期待我們送
				新鮮的蔬菜去唄。{wait}
			}
			TextWait
			TextTalk self {
				希望這次發表無效宣言後，
				可以恢復過往的交易。{wait}
			}
			TextWait
	elif flag[3328]:
		if !flag[1]:
			TextTalk self {
				《幻獸》這種怪物
				會破壞街道上的農田。{wait}
			}
			TextWait
			TextTalk self {
				加上移動管制的關係，
				收成量也大幅銳減，
				說真的根本沒辦法做生意。{wait}
			}
			TextWait
			TextTalk self {
				唉，話雖如此，如果只是供應
				村裡的話，勉強還能自給自足。
				可得感謝女神庇祐啊。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				只是供應村裡的話，
				勉強還能自給自足。{wait}
			}
			TextWait
			TextTalk self {
