			CharFlagsUnset char[7] 0x0080
			CharSetChipBase char[7] chip[2]
			CharSetChipPattern char[7] 0
			ForkQuit char[7] fork[0]
			CharFlags2Set char[7] 0x0004
			CharFlagsUnset char[8] 0x0080
		else:
			CharFlagsSet char[3] 0x0080
	elif flag[2816]:
		if QuestFlagsGet quest[130] 0x02:
			CharFlagsUnset char[7] 0x0080
			CharSetChipBase char[7] chip[2]
			CharSetChipPattern char[7] 0
			ForkQuit char[7] fork[0]
			CharFlags2Set char[7] 0x0004
	elif flag[2573]:
	elif flag[2564]:
