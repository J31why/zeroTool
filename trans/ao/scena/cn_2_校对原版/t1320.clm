fn[0]:
	switch random % 8:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if flag[3356]:
		CharFlagsSet char[0] 0x0080
	if !flag[2816] && flag[2602]:
		CharFlagsUnset char[1] 0x0080
		CharFlagsUnset char[2] 0x0080
		CharFlagsUnset char[3] 0x0080
		CharSetChipBase char[1] chip[1]
		CharSetChipPattern char[1] 0
		ForkQuit char[1] fork[0]
		CharFlags2Set char[1] 0x0004
	if !flag[2816] && flag[2602] && !QuestFlagsGet quest[126] 0x10 && !QuestFlagsGet quest[126] 0x40:
		CharSetPos char[0] (96490, 0, 1360) 90deg
		_Char4A char[0] 255
		CharFlagsSet char[1] 0x0080
		CharFlagsSet char[2] 0x0080
		CharFlagsSet char[3] 0x0080
	if flag[272]:
		FlagUnset flag[272]
		Event fn[0,16]
	elif flag[275]:
		FlagUnset flag[275]
		Event fn[0,21]
	if flag[2602] && !flag[2604] && !flag[2780]:
		SystemFlagsSet 0x10000000
		Event fn[0,17]
	if flag[2780] && !QuestFlagsGet quest[126] 0x10 && !QuestFlagsGet quest[126] 0x40:
		if system[0] == 102:
			SystemFlagsSet 0x10000000
			Event fn[0,18]
	if flag[2597] && !flag[2598]:
		Event fn[0,12]
	Return

fn[2]:
	if flag[3385]:
		system[1] = 563
	TriggerFlagsSet trigger[0] 0x0080
	if !flag[2603] && flag[2602]:
		TriggerFlagsUnset trigger[0] 0x0080
	if flag[2599] && !flag[2602]:
		TriggerFlagsUnset trigger[0] 0x0080
	if flag[2816]:
		TriggerFlagsSet trigger[0] 0x0080
	LookPointFlagsSet look_point[2] 0x0001
	LookPointFlagsSet look_point[3] 0x0001
	if flag[3356]:
		ObjFlagsUnset object[0] 0x0010
		ObjFlagsUnset object[1] 0x0010
		LookPointFlagsUnset look_point[2] 0x0001
		LookPointFlagsUnset look_point[3] 0x0001
	TriggerFlagsSet trigger[1] 0x0080
	if flag[2597] && !flag[2599]:
		TriggerFlagsUnset trigger[1] 0x0080
	if !flag[2816] && QuestFlagsGet quest[126] 0x10:
		TriggerFlagsUnset trigger[1] 0x0080
	TriggerFlagsSet trigger[2] 0x0080
	if flag[2599] && !flag[2602]:
		TriggerFlagsUnset trigger[2] 0x0080
	if flag[2602] && !QuestFlagsGet quest[126] 0x10:
		LookPointFlagsSet look_point[0] 0x0001
	if flag[3356]:
		LookPointFlagsSet look_point[0] 0x0001
	Return

fn[3]:
	Call fn[0,4]
	Return

fn[4]:
	if flag[2598] && !flag[2599]:
		Call fn[0,13]
		Return
	else:
		TextStart char[0]
		if flag[2602]:
			if !flag[0]:
				TextTalk char[0] {
					真的非常謝謝你們，
					幫我們擊退割破泳裝的兇手。{wait}
				}
				TextWait
				TextTalk char[0] {
					由於兇手是魔獸，
					無法保證說
					從今以後它們就不會出現，不過……{wait}
				}
				TextWait
				TextTalk char[0] {
					看來往後米修拉姆事業部本身
					得針對這件事情想些對策了。{wait}
				}
				TextWait
				FlagSet flag[0]
			else:
				TextTalk char[0] {
					真的非常謝謝你們，
					幫我們擊退割破泳裝的兇手。{wait}
				}
				TextWait
				TextTalk char[0] {
					看來往後米修拉姆事業部本身
					得針對這件事情想些對策了。{wait}
				}
				TextWait
		elif flag[2600]:
		TextEnd char[0]
	Return

fn[5]:
	TextStart self
	TextTalk self {
		我的女朋友現在正在挑泳裝。{wait}
	}
	TextWait
	TextTalk self {
		……真希望她動作能快一點。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[6]:
	TextStart self
	TextTalk self {
		哇啊～好多好可愛的泳裝喔。{wait}
	}
	TextWait
	TextTalk self {
		挑哪一件好呢～？{wait}
	}
	TextWait
	TextEnd self
	Return

fn[7]:
	TextStart self
	if !flag[1]:
		Emote self 0mm 2000mm 2 7 80ms 1
		SoundPlay sound[28] 0 100 0
		Sleep 1000ms
		TextTalk self {
			嗚哇啊啊啊啊啊！？{wait}
		}
		TextWait
		TextTalk self {
			別、別把女孩子
			帶進男性更衣室來啦！？{wait}
		}
		TextWait
		TextTalk name[0] {
			#00005F這、這麼說也是。
			……真是抱歉。{wait}
		}
		TextWait
		TextTalk name[82] {
			#01105F咦？？{wait}
		}
		TextWait
		FlagSet flag[1]
	else:
		TextTalk self {
			真、真是的……
			一點都不能鬆懈啊。{wait}
		}
		TextWait
		TextTalk self {
			差一點就要被女孩子
			把屁股看光光了。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[8]:
	TextStart null
	FadeOut 300ms 0x00000000 100
	TextSetPos -1 -1 -1 -1
	TextSetName ""
	TextMessage null {
		{color 5}{0x06}　　　遊玩湖水浴時請注意
		──────────────────
		・請務必做好暖身運動。
		・請不要直接穿著身上衣物下水。
		　（櫃檯提供租借泳裝）
		・請聽從救生員的指示。
		──────────────────
		　遵守禮儀，快樂玩耍。
		　　　　　　──米修拉姆事業部敬上{color 0}{wait}
	}
	TextWait
	TextClose 0
	FadeIn 300ms 0x00000000
	FadeWait
	_59
	TextSetPos -1 280 60 3
	TextEnd null
	Return

fn[9]:
	EventBegin 1
	if flag[2599] && !flag[2602]:
		TextTalk name[0] {
			#12500F……這裡是女性更衣室。
			在被人誤會前快點離開吧。{wait}
		}
		TextWait
	if !flag[2603] && flag[2602]:
		if !flag[2]:
			TextTalk name[0] {
				#00000F……呃。
				這裡是女性更衣室。{wait}
			}
			TextWait
			TextTalk name[82] {
				#01105F羅伊德，要進去嗎──？{wait}
			}
			TextWait
			TextTalk name[0] {
				#00006F不、沒有啦，沒有要進去。{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			TextTalk name[0] {
				#00000F這裡是女性更衣室。
				……還是別進去吧。{wait}
			}
			TextWait
	CharSetPos field_party[0] (104470, 0, 2310) 180deg
	EventEnd 4
	Return

fn[10]:
