	Call fn[0,23]
	ForkFunc name[101] fork[3] fn[0,25]
	ForkWait name[101] fork[3]
	if (global[4] & 134152192) == 0:
		TextTalk name[0] {
			#00000F#1260000769V那麼就
			快點來許願吧。{wait}
		} {
			#00005F#1260000770V呃……只要在這個鏡子前面
			說出願望就可以了嗎？{wait}
		}
		TextWait
		TextTalk name[101] {
			#14000F#1260420085V應該只需要在腦中
			想好自己的願望就好了吧？{wait}
		} {
			#14003F#1260420086V要的話就快點開始吧。{wait}
		}
		TextWait
	else:
		TextTalk name[0] {
			#00000F#1260000771V那麼就
			快點來許願吧。{wait}
		} {
			#00004F#1260000772V只要在這個鏡子前，
			想像自己的願望就行了。{wait}
		}
		TextWait
		TextTalk name[101] {
			#14003F#1260420087V……管他的，要的話
			就快點做吧。{wait}
		}
		TextWait
	ForkFunc name[101] fork[3] fn[0,26]
	ForkWait name[101] fork[3]
	TextTalk name[0] {
		#00003F#1260000773V……………………………………{wait}
	}
	TextWait
	TextTalk name[101] {
		#14008F#1260420088V……………………………………{wait}
	}
	TextWait
	ForkFunc name[101] fork[3] fn[0,27]
	ForkWait name[101] fork[3]
	Call fn[0,24]
	ForkFunc name[101] fork[3] fn[0,25]
	ForkWait name[101] fork[3]
	TextTalk name[0] {
		#00000F#1260000774V……大概就這樣吧？{wait}
	}
	TextWait
	TextTalk name[101] {
		#14003F#1260420089V嗯，我也好了。{wait}
	} {
		#14000F#1260420090V……那，
		你許了什麼願望啊？{wait}
	}
	TextWait
	if (global[4] & 134152192) == 0:
		TextTalk name[0] {
			#00000F#1260000775V哈哈，因為太普通了，
			說出來有點害羞……{wait}
		} {
			#00004F#1260000776V我許的是『希望接下來也能繼續
			保護克洛斯貝爾』。{wait}
		} {
			#00000F#1260000777V當然，修莉還有
			彩虹劇團的各位也包含在內。{wait}
		}
		TextWait
		TextTalk name[101] {
			#14000F#1260420091V哦～……
			嗯，還算是不錯啦。{wait}
		}
		TextWait
		TextTalk name[0] {
			#00009F#1260000778V哈哈，我就當作是稱讚了。{wait}
		} {
			#00000F#1260000779V那麼修莉
			又許了什麼樣的願望？{wait}
		}
		TextWait
	else:
		TextTalk name[0] {
			#00000F#1260000780V我第一次來這裡的時候，
			就已經許了最想要的願望了。{wait}
		} {
			#00004F#1260000781V重複的願望再許一次也沒意義，
			所以我就許了
			『希望修莉的願望可以實現』。{wait}
		}
		TextWait
		TextTalk name[101] {
			#14006F#1260420092V嘖，不用你多管閒事。{wait}
		}
		TextWait
		TextTalk name[0] {
			#00000F#1260000782V哈哈……
			看來我管太多了。{wait}
		} {
			#00000F#1260000783V那麼修莉
			又許了什麼樣的願望？{wait}
		}
		TextWait
	Emote name[101] 0mm 2000mm 24 27 250ms 0
	Sleep 1500ms
	EmoteStop name[101]
	TextTalk name[101] {
		#14003F#1260420093V我啊……
		才沒有許什麼願望。{wait}
	}
	TextWait
	TextTalk name[0] {
		#00006F#1260000784V呃……
		什麼嘛，虧妳還特地問我。{wait}
	}
	TextWait
	TextTalk name[101] {
		#14006F#1260420094V……更何況，所謂的願望，
		本來就不是隨便就會實現的。{wait}
	} {
		#14008F#1260420095V我以前住的貧民窟就是這樣。{wait}
	}
	TextWait
	Emote name[0] 0mm 2000mm 38 38 250ms 1
	Sleep 1000ms
	TextTalk name[101] {
		#14000F#1260420096V……在我故鄉的貧民窟，
		像我這樣的傢伙
		還有一大票。{wait}
	} {
		#14003F#1260420097V雖然我輾轉來到克洛斯貝爾，
		還被伊莉雅小姐收留……
		但這單純只是我運氣好罷了。{wait}
	} {
		#14008F#1260420098V都比別人運氣好了，
		還想奢求更多，
		那我也太沒有自知之明了。{wait}
	}
	TextWait
	Emote name[0] 0mm 2000mm 24 27 250ms 0
	Sleep 1500ms
	EmoteStop name[0]
	TextTalk name[0] {
		#00004F#1260000785V修莉……
		……妳很溫柔呢。{wait}
	}
	TextWait
	TextTalk name[101] {
		#14005F#1260420099V……咦……？{wait}
	}
	TextWait
	TextTalk name[0] {
		#00002F#1260000786V我認為很少有人
		在思考的時候，
		能夠這麼去為他人著想。{wait}
	} {
		#00004F#1260000787V那是因為妳很溫柔，
		有著一顆為他人著想的心，所以才能做到。{wait}
	} {
		#00000F#1260000788V不過……就算是這樣，
		這也不代表
		妳沒資格獲得幸福不是嗎？{wait}
	}
	TextWait
	TextTalk name[101] {
		#14008F#1260420100V可、可是……{wait}
	}
	TextWait
	TextTalk name[0] {
		#00000F#1260000789V不需要想得那麼複雜。
		簡單來說，只是許個願而已，
		應該沒什麼可不可以的啦。{wait}
	}
	TextWait
	Emote name[101] 0mm 2000mm 14 15 250ms 2
	SoundPlay sound[23] 0 100 0
	Sleep 1000ms
	TextTalk name[101] {
		#14006F#1260420101V真是的，我知道了啦……
		真是愛說教又囉嗦的哥哥耶。{wait}
	}
	TextWait
	TextTalk name[0] {
		#00006F#1260000790V愛、愛說教還真是抱歉了喔。{wait}
	}
	TextWait
	Emote name[101] 0mm 2000mm 24 27 250ms 0
	Sleep 1500ms
	EmoteStop name[101]
	TextTalk name[101] {
		#14003F#1260420102V……雖然我不知道未來會怎麼樣，
