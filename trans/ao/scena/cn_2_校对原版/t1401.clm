	} {
		#14000F#1260420103V『要讓這次的改版公演成功』……
		至少我希望這件事能實現。{wait}
	} {
		#14009F#1260420104V……這樣你覺得可以嗎？{wait}
	}
	TextWait
	TextTalk name[0] {
		#00002F#1260000791V嗯，我想這樣就夠了。{wait}
	} {
		#1260000792V我也會許願，
		希望妳的願望能實現。{wait}
	}
	TextWait
	TextTalk name[101] {
		#14012F#1260420105V不、不要對著人家
		講這麼害羞的話啦。{wait}
	}
	TextWait
	FadeOut 1000ms 0x00000000 255
	FadeWait
	Return

