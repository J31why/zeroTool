fn[4]:
	FlagSet flag[4264]
	if !flag[4259]:
		TextStart null
		SystemFlagsSet 0x08000000
		TextSetName ""
		TextMessage null {
			{color 5}寶箱中發出強力魔獸的氣息。
			【推測魔獸等級８５】
			要打開寶箱嗎？{wait}
		}
		Menu menu[0] -1 -1 1
			"是" // 0
			"否" // 1
		MenuWait var[0]
		MenuClose menu[0]
		TextClose 0
		_59
		if var[0] != 0:
			SystemFlagsUnset 0x08000000
			TextEnd null
			Return
	SystemFlagsSet 0x08000000
	if !flag[4058]:
		SoundPlay sound[14] 0 100 0
		ED7_74 object[0] 0 30
		ED7ObjPlay object[0] 0 30 0 0
		Sleep 500ms
		if !flag[4259]:
			CharColor char[2] 0x00FFFFFF 0ms
			CharTurnToChar char[2] field_party[0] 0deg/s
			_Char91 char[2] 0 1000 0 0 0
			Fork char[2] fork[1]:
				_Char91 self 0 -1000 0 1000 0
			Fork char[2] fork[2]:
				CharColor self 0xFFFFFFFF 1000ms
			CharFlagsUnset char[2] 0x0080
			CharFlagsSet char[2] 0x8000
			TextMessage name[742] {
				{color 5}魔獸出現了！{color 0}{wait}
			}
			TextWait
			TextClose 0
			ForkWait char[2] fork[1]
			ED7Battle battle[4] null 0 0 11 null
			CharFlagsSet char[2] 0x0080
			CharFlagsUnset char[2] 0x8000
			switch system[3]:
				case 0:
					FlagSet flag[4259]
					ObjFrame object[0] 30
					Sleep 500ms
					break
				case 2:
					ObjFrame object[0] 0
					TextEnd null
					SystemFlagsUnset 0x08000000
					Return
				case 1:
					ReturnToTitle 0
					Return
		if ItemAdd item[168] 1:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextMessage name[742] {
				{color 0}已取得{item[168]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			TextSetPos -1 280 60 3
			FadeIn 300ms 0x00000000
			FlagSet flag[4058]
			ED7_DE 5
		else:
			FadeOut 300ms 0x00000000 100
			TextMessage name[742] {
				寶箱裡裝有{item[168]}{color 0}。
				因持有物品已達上限，已放棄{item[168]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			SoundPlay sound[15] 0 100 0
			ED7ObjPlay object[0] 30 0 0 0
	else:
		FadeOut 300ms 0x00000000 100
		TextMessage name[742] {
			{0x06}{color 5}寶箱裡什麼都沒有。{color 0}{wait}
		}
		TextWait
		TextClose 0
		FadeIn 300ms 0x00000000
	Sleep 30ms
	TextEnd null
	SystemFlagsUnset 0x08000000
	Return

