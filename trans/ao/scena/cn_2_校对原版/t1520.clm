fn[3]:
	while 1:
		CharIdle self (-101350, null, 52570) (-96560, null, 54600) 1000mm/s
		Sleep 400ms
	Return

fn[4]:
	Emote self 0mm 1700mm 28 33 250ms 0
	Return

fn[5]:
