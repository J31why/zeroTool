fn[10]:
	TextStart self
	if flag[3385]:
		if !flag[0]:
			TextTalk char[0] {
				掃掃掃、掃啊掃……♪{wait}
			}
			TextWait
			TextTalk char[0] {
				醫院重新開放門診，
				看來員工都卯足了勁。{wait}
			}
			TextWait
			TextTalk char[0] {
				為了讓大家更有精神，
				我也得比平常更認真打掃才行！{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				掃掃掃、掃啊掃……♪{wait}
			}
			TextWait
			TextTalk char[0] {
				為了讓大家更有精神，
				我也得比平常更認真打掃才行！{wait}
			}
			TextWait
	elif flag[3362]:
		TextTalk char[0] {
			最近從宿舍走出去的醫師和
			實習醫生臉色都有點陰沉。{wait}
		}
		TextWait
		TextTalk char[0] {
			城裡需要複診的病患
			幾乎都沒有再來就醫，
			這讓我很擔心。{wait}
		}
		TextWait
	elif flag[3338]:
		TextTalk char[0] {
			寶莉榭小姐和塔普先生
			幫忙我打掃宿舍和運送食物，
			讓我輕鬆了不少。{wait}
		}
		TextWait
		TextTalk char[0] {
			難得有這機會，如果他們能
			留在醫院裡工作的話，我就輕鬆多了。{wait}
		}
		TextWait
	elif flag[3328]:
		TextTalk char[0] {
			今天梅花小姐
			好像在房間裡休息。{wait}
		}
		TextWait
		TextTalk char[0] {
			大家平常都工作得太努力了，
			我希望他們能趁這個機會好好休息。{wait}
		}
		TextWait
	elif flag[3074]:
		if !flag[0]:
			TextTalk char[0] {
				最近這幾天，
				好像有很多人來探望
				攻擊事件中受傷的傷者。{wait}
			}
			TextWait
			TextTalk char[0] {
				特別是傷亡慘重的
				警察和警備隊他們的家屬，
				表情都慘不忍睹……{wait}
			}
			TextWait
			TextTalk char[0] {
				一想到如果我的家人也被捲入
				那樣的事件裡……
				我就覺得心如刀割。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				最近這幾天，
				好像有很多人來探望
				攻擊事件中受傷的傷者。{wait}
			}
			TextWait
			TextTalk char[0] {
				一想到如果我的家人也被捲入
				那樣的事件裡……
				我就覺得心如刀割。{wait}
			}
			TextWait
	elif flag[2848]:
		TextTalk char[0] {
			發生了鐵路事故，
			那些醫師和實習醫生
			好像都出宿舍了。{wait}
		}
		TextWait
		TextTalk char[0] {
			我就趁現在把各個角落
			都打掃乾淨吧。{wait}
		}
		TextWait
	elif flag[2832]:
		if !flag[0]:
			TextTalk char[0] {
				聽事務長說
				明日早上好像會下雨。{wait}
			}
			TextWait
			TextTalk char[0] {
				他說在導力網路上
				可以看天氣預報。{wait}
			}
			TextWait
			TextTalk char[0] {
				嗯，生活變得
				還真方便啊。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				明天早上好像會下雨。{wait}
			}
			TextWait
			TextTalk char[0] {
				竟然能用導力網路
				看天氣預報，生活
				變得還真方便啊。{wait}
			}
			TextWait
	elif flag[2816]:
		if !flag[0]:
			TextTalk char[0] {
				亞里歐斯先生
				在他女兒開刀的時候，
				一直坐立難安。{wait}
			}
			TextWait
			TextTalk char[0] {
				因為他被稱為《風之劍聖》，
				應該有很多人覺得
				他不是一般人吧，不過……{wait}
			}
			TextWait
			TextTalk char[0] {
				看他那個樣子，
				我只覺得他跟任何一位
				疼愛女兒的父親沒兩樣。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				亞里歐斯先生
				在他女兒開刀的時候，
				一直坐立難安。{wait}
			}
			TextWait
			TextTalk char[0] {
				看他那個樣子，
				我只覺得他跟任何一位
				疼愛女兒的父親沒兩樣。{wait}
			}
			TextWait
	elif flag[2573]:
		TextTalk char[0] {
			貝爾達因醫生今天
			好像休假，還真是稀奇。{wait}
		}
		TextWait
		TextTalk char[0] {
			他最近都連續工作
			沒有休息，
			我希望他能好好休息。{wait}
		}
		TextWait
	elif flag[2564]:
		if !flag[0]:
			TextTalk char[0] {
				掃掃掃……♪
				這邊是女子宿舍喔。{wait}
			}
			TextWait
			TextTalk char[0] {
				我得掃得比男子宿舍
