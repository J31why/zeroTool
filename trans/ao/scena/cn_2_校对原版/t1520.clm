			}
			TextWait
			TextTalk char[0] {
				……呵呵，開玩笑的啦。
				只要是跟打掃有關的事，我都是很認真的。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				哎呀呀，莫非……
				亞蘇拉主任
				還在賴床嗎？{wait}
			}
			TextWait
			TextTalk char[0] {
				嗯，她昨天好像在
				研究大樓待得很晚，
				硬是把她叫醒好像很可憐。{wait}
			}
			TextWait
	elif flag[2560]:
		if !flag[0]:
			TextTalk char[0] {
				掃掃掃……♪
				打・掃・真・快・樂～☆{wait}
			}
