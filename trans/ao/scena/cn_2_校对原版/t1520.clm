fn[7]:
	TextSetName ""
	TextMessage null {
		{color 5}放有一本『克洛斯貝爾鄉土料理入門』。{wait}
	}
	TextWait
	TextClose 0
	_59
	TextSetPos -1 280 60 3
	if ItemHas item[2] 0:
		if !RecipeLearn 5:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextSetName ""
			TextMessage null {
				記住了{color 2}『久煮燉菜』{color 0}的食譜。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			FadeWait
			_59
			TextSetPos -1 280 60 3
	TextEnd null
	Return

fn[8]:
	TextStart self
	if !flag[3675]:
		Call fn[0,9]
	else:
		TextTalk char[4] {
			#01303F如果能查清蓋那起事件的真相，
			或許我也能繼續向前邁進，不過……{wait}
		} {
			#01300F千萬別逞強。
			你們平安無事
			才是我最大的願望。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[9]:
	EventBegin 0
	CrossFade 500ms
	CamSetDistance 153430 700 53830 0ms
	ED7CamRotate 45deg 27deg 0deg 0ms
	CamPers 440 0ms
	CamZoom 20790 0ms
	CharSetPos name[0] (153010, 0, 53370) 90deg
	CharSetPos name[1] (152340, 0, 54310) 90deg
	CharSetPos name[3] (151800, 0, 52830) 90deg
