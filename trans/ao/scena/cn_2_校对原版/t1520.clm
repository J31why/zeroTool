	CharTurnTo char[4] 270deg 0deg/s
	FadeWait
	TextTalk char[4] {
		#11P#01300F……哎呀呀，是羅伊德和各位啊。{wait}
	} {
		賽蘭德教授
		交代的工作完成了嗎？{wait}
	}
	TextWait
	TextTalk name[0] {
		#6P#00000F嗯，剛剛完成。{wait}
	}
	TextWait
	TextTalk name[3] {
		#6P#00300F賽西兒小姐正在休息嗎？{wait}
	}
	TextWait
	TextTalk char[4] {
		#11P#01302F呵呵，今天輪到我值宿，
		我正打算回去準備一些東西。{wait}
	} {
		#01304F為了提神，
		我還打算把喜歡的
		紅茶帶去備用。{wait}
	}
	TextWait
	TextTalk name[1] {
		#00105F賽西兒小姐還是一樣很忙啊……{wait}
	}
	TextWait
	TextTalk name[0] {
		#6P#00001F請妳一定要注意自己的身體啊。{wait}
	}
	TextWait
	TextTalk char[4] {
		#11P#01309F呵呵，別擔心。
		別看我這樣，我可是很硬朗的。{wait}
	} {
		#01304F……這個特質有一部分
		是受到蓋的影響吧。{wait}
	}
	TextWait
	Emote name[0] 0mm 2000mm 38 38 250ms 1
	Sleep 50ms
	Emote name[1] 0mm 2000mm 38 38 250ms 1
	Sleep 50ms
	Emote name[3] 0mm 2000mm 38 38 250ms 1
	Sleep 50ms
	Emote name[8] 0mm 2000mm 38 38 250ms 1
	Sleep 50ms
	Emote name[4] 0mm 2000mm 38 38 250ms 1
	Sleep 1000ms
	TextTalk name[8] {
		#6P#10105F對了，妳剛剛好像
		在看照片……{wait}
	}
	TextWait
	TextTalk name[4] {
		#6P#10300F該不會
		照片上的人就是蓋嗎？{wait}
	}
	TextWait
	TextTalk char[4] {
		#11P#01300F呵呵，你們要看看嗎？{wait}
	}
	TextWait
	TextClose 0
	_59
	VisSet vis[0] 3 0xFFFFFFFF 500ms 0 0
	VisWait vis[0] 3
	Sleep 500ms
	TextMessage name[0] {
		#00003F這張照片應該是五、六年前拍的吧。{wait}
	} {
		#00002F右邊這位是我大哥
		蓋・班寧斯。{wait}
	}
	TextWait
	TextMessage name[8] {
		#10105F哦，這位就是……{wait}
	} {
		#10102F呵呵，不愧是羅伊德的哥哥，
		看起來非常正直呢。{wait}
	}
	TextWait
	TextMessage name[3] {
		#00309F賽西兒小姐也很漂亮喔！！{wait}
	} {
		#00306F可惡！我也想當
		賽西兒小姐的青梅竹馬啊……{wait}
	}
	TextWait
	TextMessage name[1] {
		#00106F唉，蘭迪你真是的。{wait}
	} {
		#00102F不過，這樣看起來……
		他跟賽西兒小姐看起來
		的確是很相配呢。{wait}
	}
	TextWait
	TextMessage char[4] {
		#01309F呵呵，謝謝妳。
		聽妳這麼說，我很開心喔。{wait}
	}
	TextWait
	TextMessage name[4] {
		#10302F呵呵，照片上還有小時候的羅伊德，
		這張臉還真可愛呢。{wait}
	} {
		#10304F光看這張照片，
		就已經看得出來一點你那種
		魅惑良家婦女的魅力了喔。{wait}
	}
	TextWait
	TextMessage name[0] {
		#00011F#4S什麼……！？{wait}
	}
	TextWait
	TextMessage name[8] {
		#10106F（的、的確……）{wait}
	}
	TextWait
	TextMessage name[1] {
		#00111F（如果他小時候的言行舉止就和現在
		　一樣，那麼毋庸置疑是個危險人物……）{wait}
	}
	TextWait
	TextMessage name[0] {
		#00006F……怎麼感覺我好像
		被人貼上了奇怪的標籤啊？{wait}
	}
	TextWait
	TextMessage char[4] {
		#01309F呵呵……！{wait}
	}
	TextWait
	TextClose 0
	_59
	VisSet vis[0] 3 0x00FFFFFF 500ms 0 0
	VisWait vis[0] 3
	Sleep 500ms
	TextTalk char[4] {
		#11P#01303F……現在回想起來，自從我們拍了
		這張照片之後，很多事情都改變了。{wait}
	} {
		#01308F從蓋過世的那一天起到現在，
		還沒走出悲傷的人
		說不定只剩下我了……{wait}
	}
	TextWait
	TextTalk name[0] {
		#6P#00005F賽西兒姊姊……{wait}
	} {
		#00003F雖然可能會花不少時間……
		但請妳等著。{wait}
	} {
		#00000F大哥那件事，
		我一定會查個水落石出。{wait}
	}
	TextWait
	TextTalk name[1] {
		#00100F嗯，我們也會
		助他一臂之力。{wait}
	}
	TextWait
	TextTalk char[4] {
		#11P#01304F……呵呵，謝謝各位。{wait}
	} {
		#01300F不過，你們千萬別逞強。
		你們平安無事
		才是我最大的願望。{wait}
	} {
		#01309F如果你們被送來醫院的話，
		我會請賽蘭德教授
		開很苦很苦的藥給你們吃喔！{wait}
	}
	TextWait
	Emote name[0] 0mm 2000mm 16 19 250ms 1
	SoundPlay sound[23] 0 100 0
	Emote name[1] 0mm 2000mm 16 19 250ms 1
	SoundPlay sound[23] 0 100 0
	Emote name[3] 0mm 2000mm 16 19 250ms 1
	SoundPlay sound[23] 0 100 0
	Emote name[8] 0mm 2000mm 16 19 250ms 1
	SoundPlay sound[23] 0 100 0
	Emote name[4] 0mm 2000mm 16 19 250ms 1
	SoundPlay sound[23] 0 100 0
	Sleep 1000ms
	TextTalk name[3] {
		#6P#00306F那個女醫生開的藥
		應該會很有效吧，不過……{wait}
	}
	TextWait
	TextTalk name[4] {
		#6P#10302F呵呵，如果她認真起來的話，
		連藥有多苦都能任意調整吧。{wait}
	}
	TextWait
	TextTalk name[0] {
		#6P#00012F我、我們會提高警覺的。{wait}
	}
	TextWait
	TextClose 0
