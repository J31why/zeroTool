	elif flag[3362]:
		CharSetPos char[0] (98920, 0, 10770) 270deg
		ForkFunc char[0] fork[0] fn[0,2]
	elif flag[3338]:
		ForkFunc char[0] fork[0] fn[0,1]
	elif flag[3328]:
		CharSetPos char[0] (98920, 0, 10770) 270deg
		ForkFunc char[0] fork[0] fn[0,2]
		CharFlagsUnset char[3] 0x0080
	elif flag[3074]:
		CharSetPos char[0] (98920, 0, 10770) 270deg
		ForkFunc char[0] fork[0] fn[0,2]
	elif flag[2848]:
		ForkFunc char[0] fork[0] fn[0,1]
	elif flag[2832]:
		CharSetPos char[0] (98920, 0, 10770) 270deg
		ForkFunc char[0] fork[0] fn[0,2]
	elif flag[2816]:
		ForkFunc char[0] fork[0] fn[0,1]
	elif flag[2573]:
		ForkFunc char[0] fork[0] fn[0,1]
		CharFlagsUnset char[2] 0x0080
	elif flag[2564]:
		CharSetPos char[0] (98920, 0, 10770) 270deg
		ForkFunc char[0] fork[0] fn[0,2]
		CharFlagsUnset char[1] 0x0080
