	}
	TextWait
	TextTalk char[0] {
		咦？有這麼一回事喔？
		我忘得一乾二淨了。{wait}
	}
	TextWait
	TextTalk char[0] {
		算了，無所謂啦，
		總之為了紀念再次見面，
