fn[4]:
	TextSetName ""
	TextMessage null {
		{color 5}放有『點心王國　第一卷』。{wait}
	}
	TextWait
	TextClose 0
	_59
	TextSetPos -1 280 60 3
	if ItemHas item[2] 0:
		if !RecipeLearn 19:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextSetName ""
			TextMessage null {
				記住了{color 2}『混合冰淇淋』{color 0}的食譜。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			FadeWait
			_59
			TextSetPos -1 280 60 3
	TextEnd null
	Return

fn[5]:
	if !flag[3089] && flag[3074]:
		Call fn[0,13]
	else:
		Call fn[0,6]
	Return

fn[6]:
	if QuestFlagsGet quest[128] 0x02 && !QuestFlagsGet quest[128] 0x10 && !QuestFlagsGet quest[128] 0x40 && flag[2960] && !flag[2966]:
		if !flag[2837] | flag[2848]:
			Call fn[0,28]
			Return
	elif QuestFlagsGet quest[107] 0x02 && !QuestFlagsGet quest[107] 0x10 && !QuestFlagsGet quest[107] 0x40 && !flag[2451]:
		Call fn[0,26]
		Return
	TextStart char[0]
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"交談" // 0
			"買東西" // 1
			"放棄" // 2
		MenuWait var[0]
		if var[0] != 1:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			if flag[3385]:
				ShopOpen shop[204]
			elif flag[3074]:
				ShopOpen shop[203]
			elif flag[2816]:
				ShopOpen shop[202]
			elif flag[2560]:
				ShopOpen shop[201]
			else:
				ShopOpen shop[200]
			var[0] = 99
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			Call fn[0,7]
	TextEnd char[0]
	Return

fn[7]:
	if system[4] == 1 && !flag[2400]:
