			正想要慢慢來研究新麵包的說……{wait}
		}
		TextWait
		TextTalk self {
			這到底是怎麼回事？{wait}
		}
		TextWait
	elif flag[3089]:
		if !flag[1]:
			TextTalk self {
				因為食材的進口
				一定要透過兩大國，
				這下子可叫我頭痛了。{wait}
			}
			TextWait
			TextTalk self {
				畢竟不管怎麼說，
				大部份的麵包材料
				都是從其他國家進口的。{wait}
			}
			TextWait
			TextTalk self {
