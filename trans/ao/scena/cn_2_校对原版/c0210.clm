fn[8]:
	TextTalk char[0] {
		喔喔，這不是羅伊德嗎！？{wait}
	}
	TextWait
	TextTalk name[0] {
		#00000F嗨，奧斯卡，好久不見。
		工作做得如何？{wait}
	}
	TextWait
	TextTalk char[0] {
		喔，日復一日
		都和烤麵包為伍啊。{wait}
	}
	TextWait
	TextTalk char[0] {
		話說回來，
		好久沒看到你了，
		你跑到哪裡去啦？{wait}
	}
	TextWait
	TextTalk char[0] {
		難道是跑去米修拉姆
		長住了嗎？{wait}
	}
	TextWait
	Emote name[0] 0mm 2000mm 16 19 250ms 1
	SoundPlay sound[23] 0 100 0
	Sleep 1000ms
	TextTalk name[0] {
		#00006F拜託……
		怎麼可能啦。{wait}
	} {
