fn[12]:
	TextStart self
	if flag[3385]:
		if !flag[1]:
			TextTalk self {
				原本使用政府提供的小麥粉，
				實在是做不出
				好吃的麵包……{wait}
			}
			TextWait
			TextTalk self {
				現在交通恢復通行，
				總算可以買到阿爾摩利卡產的新鮮原料。
				看來總算可以重回軌道了。{wait}
			}
			TextWait
			TextTalk self {
				也要請奧斯卡和貝奈特
				比現在更加努力才行。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
