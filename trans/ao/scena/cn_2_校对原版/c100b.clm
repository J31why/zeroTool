fn[0]:
	switch random % 8:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if flag[272]:
		FlagUnset flag[272]
		Event fn[0,5]
	elif flag[273]:
		FlagUnset flag[273]
		Event fn[0,8]
	Return

fn[2]:
	if !flag[3930]:
		ObjFrame object[10] 0
	else:
		ObjFrame object[10] 30
	if !flag[3931]:
		ObjFrame object[11] 0
	else:
		ObjFrame object[11] 30
	Return

fn[3]:
	ED7_F2 1
	SystemFlagsSet 0x08000000
	if !flag[3930]:
		SoundPlay sound[14] 0 100 0
		ED7_74 object[10] 0 30
		ED7ObjPlay object[10] 0 30 0 0
		Sleep 500ms
		if ItemAdd item[910] 1:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextSetName ""
			TextMessage name[742] {
				{color 0}已取得{item[910]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			TextSetPos -1 280 60 3
			FadeIn 300ms 0x00000000
			FlagSet flag[3930]
			ED7_DE 5
		else:
			FadeOut 300ms 0x00000000 100
			TextSetName ""
			TextMessage name[742] {
				寶箱裡裝有{item[910]}{color 0}。
				因持有物品已達上限，已放棄{item[910]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			SoundPlay sound[15] 0 100 0
			ED7ObjPlay object[10] 30 0 0 0
	else:
		FadeOut 300ms 0x00000000 100
		TextSetPos -1 -1 -1 -1
		TextSetName ""
		TextMessage name[742] {
			{0x06}{color 5}寶箱裡什麼都沒有。{color 0}{wait}
		}
		TextWait
		TextClose 0
		FadeIn 300ms 0x00000000
	Sleep 30ms
	TextEnd null
	SystemFlagsUnset 0x08000000
	Return

