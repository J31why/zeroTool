	CharFlagsSet char[0] 0x0002
	CharFlagsSet char[0] 0x0020
	CharFlagsUnset char[0] 0x0080
	CharFlagsSet char[0] 0x8000
	CharSetPos char[0] (50400, 150, 350) 180deg
	CharSetChipBase char[1] chip[31]
	CharSetChipPattern char[1] 0
	CharFlagsSet char[1] 0x0002
	CharFlagsUnset char[1] 0x0080
	CharFlagsSet char[1] 0x8000
	CharSetPos char[1] (47800, 100, 700) 0deg
	ForkFunc name[0] fork[3] fn[0,2]
	CamSetDistance 44700 1100 0 0ms
	ED7CamRotate 319deg 19deg 0deg 0ms
	CamPers 500 0ms
	CamZoom 17100 0ms
	SoundPlay sound[460] 2 100 0
	CamSetDistance 50700 1100 0 7000ms
	FadeIn 2000ms 0x00000000
	FadeWait
	CamWait 121
	Sleep 800ms
	TextTalk name[4] {
		#1210040037V#12P#10302F呵呵，還真大手筆。{wait}
	} {
		#1210040038V獵兵團這工作
		有這麼賺錢嗎？{wait}
	}
	TextWait
	CharSetChipPattern char[0] 2
	Sleep 300ms
	TextTalk char[0] {
		#1210460037V#04600F#5P嗯，應該是我們這裡比較特別吧？{wait}
	} {
		#1210460038V#04604F有不少富豪和名門貴族是我們的常客，
		報酬有個一千萬米拉也不奇怪喔。{wait}
	}
	TextWait
	TextTalk name[4] {
		#1210040039V#12P#10305F咻♪{wait}
	}
	TextWait
	TextTalk name[0] {
		#1210000111V#12P#00011F有這麼多……{wait}
	}
	TextWait
	TextTalk name[3] {
		#1210030093V#00303F……畢竟僱用了頂級的獵兵，
		當然需要相當的經費啊。{wait}
	} {
		#1210030094V#00301F當然，連武裝都是最新的──
		差不多也該連飛行船都要有了吧？{wait}
	}
	TextWait
	TextTalk char[0] {
		#1210460039V#04604F#5P啊哈哈，這倒是還沒。{wait}
	} {
		#1210460040V#04602F如果考慮堅固耐用的話，
		利貝爾的軍用艇倒是不錯，
		問題是黑市很難買到。{wait}
	} {
		#1210460041V#04609F不過，真的有需要的話，
		也是可以偷偷潛入搶奪過來就是了♪{wait}
	}
	TextWait
	Emote name[0] 0mm 1700mm 16 19 250ms 1
	SoundPlay sound[23] 0 100 0
	Sleep 1000ms
	TextTalk name[0] {
		#1210000112V#12P#00008F（……這是在開玩笑的吧？）{wait}
	}
	TextWait
	TextTalk name[3] {
		#1210030095V#00306F（唉，你就當作是吧。）{wait}
	}
	TextWait
	ED7_12 460 2000 100
	CamSetDistance 53000 1100 0 2000ms
	FadeOut 2000ms 0x00000000 255
