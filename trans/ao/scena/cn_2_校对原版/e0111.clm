npc char[1]:
	name "獵兵加雷斯"
	pos (0, 0, 0)
	angle 0deg
	flags 0x01C5
	unk2 0
	chip chip[0]
	init fn[255,255]
	talk fn[255,255]
	unk4 255

fn[0]:
	if flag[272]:
		FlagUnset flag[272]
		Event fn[0,3]
	Return

fn[1]:
	Return

fn[2]:
	while 1:
		Shake 10 10 3000 500ms
		Sleep 500ms
	Return

fn[3]:
	EventBegin 0
	FadeOut 0ms 0x00000000 255
	ED7LoadChip "apl/ch51201.itc" chip[30]
