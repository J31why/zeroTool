	}
	TextWait
	TextTalk char[1] {
		嗯，就耐心等他們吧。
		他們說還需要再多加調查一下。{wait}
	}
	TextWait
	TextTalk char[1] {
		話說回來，你們那邊
		也沒什麼收獲，不是嗎？{wait}
	}
	TextWait
	TextTalk char[0] {
		是沒錯啦……{wait}
	}
	TextWait
	TextTalk char[3] {
		對、對不起。{wait}
	}
	TextWait
	TextTalk char[2] {
		我們想得到的地方
		都去問過一遍了，可是每個人
		都說最近真的都沒看到他…{wait}
	}
	TextWait
	TextTalk char[1] {
		……這樣啊。{wait}
	}
	TextWait
	TextTalk char[1] {
		瓦魯多大哥……
		他到底到哪裡去了啊？{wait}
	}
