	}
	TextWait
	TextTalk char[0] {
		哇噢，真的假的……{wait}
	}
	TextWait
	TextTalk char[2] {
		瓦、瓦魯多大哥到底
		從哪裡生出了那麼多米拉……？{wait}
	}
	TextWait
