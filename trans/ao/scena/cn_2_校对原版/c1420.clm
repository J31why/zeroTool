fn[3]:
	TriggerFlagsSet trigger[0] 0x0080
	if !flag[2573] && flag[2564] && !flag[2665]:
		TriggerFlagsUnset trigger[0] 0x0080
	if system[4] >= 5:
		EntranceSetDisabled entrance[0] 0
		EntranceSetDisabled entrance[1] 1
	else:
		EntranceSetDisabled entrance[0] 1
		EntranceSetDisabled entrance[1] 0
	if flag[2848] && !flag[2858] | flag[2369] && system[4] == 1:
		SoundPlay sound[128] 1 50 0
	if !flag[3385] && flag[3370]:
		MapColor 0x00E6D2D2 0ms
	Return

fn[4]:
	TextStart self
	if flag[3385]:
		if !flag[0]:
			TextTalk self {
				耶、耶～！！{wait}
			}
			TextWait
			TextTalk self {
				我才不害怕～！！
				沒時間去管那種
				莫名其妙的事～！！{wait}
			}
			TextWait
			TextTalk self {
				嘿！唱唱歌吹開陰霾吧！
				呀～～呼～～！！{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				那棵巨大的樹根本不算什麼～！
				我才不害怕～！！{wait}
			}
			TextWait
			TextTalk self {
				嘿！唱唱歌吹開陰霾吧！
				呀～～呼～～！！{wait}
			}
			TextWait
	elif flag[3371]:
	elif flag[3089]:
	elif flag[3074]:
	elif flag[2861]:
		TextTalk self {
			嗚哦哦……
			可惡，總覺得心煩意燥啊～！{wait}
		}
		TextWait
		TextTalk self {
			瑪因茲發生了攻擊事件！？
			先別說這個，
			瓦魯多大哥在哪裡啊～！？{wait}
		}
		TextWait
	elif flag[2848]:
		TextTalk self {
			哼！我先講明一點，
			這筆帳之後要算清楚啊！{wait}
		}
		TextWait
	elif flag[2837]:
		if !flag[2932]:
			Call fn[0,5]
		else:
			TextTalk self {
				瓦魯多大哥……
				他該不會在賭場中大獎了吧？{wait}
			}
			TextWait
			TextTalk self {
				不過，那又是為什麼
				不告訴我啊～？{wait}
			}
			TextWait
	elif flag[2832]:
		if !flag[0]:
			Call fn[0,6]
		else:
			TextTalk self {
				唉，話說回來，瓦魯多大哥不在，
				實在是很無聊啊……{wait}
			}
			TextWait
	elif flag[2816]:
		Call fn[0,7]
	elif flag[2573]:
		Call fn[0,8]
	elif flag[2564]:
		if !flag[0]:
			TextTalk self {
				瓦魯多大哥～！
				拜託你一定要露個臉啊！{wait}
			}
			TextWait
			TextTalk self {
				想喝酒的話，我們會去買，
				拜託你就在這裡喝吧～！{wait}
			}
			TextWait
			TextTalk self {
				你不在的話，
				我們什麼都做不了啊～！！{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				想喝酒的話，我們會去買，
				拜託你就在這裡喝吧～！{wait}
			}
			TextWait
			TextTalk self {
				你不在的話，
				我們什麼都做不了啊～！！{wait}
			}
			TextWait
	elif flag[2560]:
		if !flag[2664]:
			Call fn[0,9]
		else:
			TextTalk self {
				無法置信……
				我是絕對不會相信的！{wait}
			}
			TextWait
			TextTalk self {
				怎麼可能會發生
				那種荒唐的事……！？{wait}
			}
			TextWait
	elif flag[2369]:
		if !flag[0]:
			TextTalk self {
				耶～呀啊～！{wait}
			}
			TextWait
			TextTalk self {
				聖約幫的傢伙！
				你們要囂張也只能趁現在了！{wait}
			}
			TextWait
			TextTalk self {
				#4S……呀～呼～！！#3S{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				聖約幫的傢伙！
				你們要囂張也只能趁現在了！{wait}
			}
			TextWait
			TextTalk self {
				#4S……呀～呼～！！#3S{wait}
			}
			TextWait
	elif flag[2353]:
	TextEnd self
	Return

fn[5]:
	_Char4A char[5] 255
	_Char4A char[0] 255
	_Char4A char[1] 255
	_Char4A char[3] 255
	_Char4A char[2] 255
	_Char4A char[4] 255
