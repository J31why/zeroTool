	}
	TextWait
	Emote char[3] 0mm 2000mm 38 38 250ms 1
	Emote char[0] 0mm 2000mm 38 38 250ms 1
	Emote char[2] 0mm 2000mm 38 38 250ms 1
	Sleep 1000ms
	TextTalk char[4] {
