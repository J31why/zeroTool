fn[0]:
	if flag[3100]:
		CharFlagsSet char[0] 0x0080
	elif flag[3089]:
		CharFlagsUnset char[0] 0x0080
		CharSetChipBase char[0] chip[0]
		CharSetChipPattern char[0] 0
		ForkQuit char[0] fork[0]
		CharFlags2Set char[0] 0x0004
	elif flag[3087]:
		CharFlagsUnset char[0] 0x0080
		CharSetChipBase char[0] chip[0]
		CharSetChipPattern char[0] 0
		ForkQuit char[0] fork[0]
		CharFlags2Set char[0] 0x0004
		CharFlagsSet char[0] 0x0010
	if flag[272]:
		FlagUnset flag[272]
	elif flag[273]:
		FlagUnset flag[273]
		Event fn[0,14]
	elif flag[274]:
		FlagUnset flag[274]
		FlagSet flag[0]
		FlagSet flag[1]
		Event fn[0,24]
	elif flag[275]:
		FlagUnset flag[275]
		Event fn[0,29]
	if system[0] == 108 && flag[3087] && !flag[3088]:
		Event fn[0,17]
	if system[0] == 0 + 100:
		Event fn[0,10]
	if system[0] == 1 + 100:
		Event fn[0,8]
	Return

fn[1]:
	if flag[0]:
		system[1] = 0
		FlagUnset flag[0]
	if system[0] == 109:
		system[1] = 521
	elif system[0] == 108:
		system[1] = 300
	TriggerFlagsSet trigger[0] 0x0080
	if flag[3086] && !flag[3087]:
		TriggerFlagsUnset trigger[0] 0x0080
	TriggerFlagsSet trigger[2] 0x0080
	if flag[3088] && !flag[3089]:
		TriggerFlagsUnset trigger[2] 0x0080
	if !flag[3100] && flag[3089]:
		if !flag[4329]:
			CharFlagsUnset char[5] 0x0080
			TriggerFlagsUnset trigger[1] 0x0080
			CharFlagsSet char[5] 0x8000
	else:
		CharFlagsSet char[5] 0x0080
		TriggerFlagsSet trigger[1] 0x0080
	char[5].12 = 128
	char[5].20 = 223
	char[5].13 = 128
	char[5].21 = 223
	char[5].14 = 128
	char[5].22 = 223
	char[5].15 = 128
	char[5].23 = 223
	char[5].16 = 128
	char[5].24 = 223
	char[5].17 = 128
	char[5].25 = 223
	char[5].18 = 128
	char[5].26 = 223
	char[5].19 = 128
	char[5].27 = 223
	char[5].51 = 800
	char[5].7 = 2000
	EntranceSetDisabled entrance[0] 0
	EntranceSetDisabled entrance[1] 0
	if system[0] == 1 + 100:
		ED7_76_0 object[8] "Null_color" 1
		ED7_76_1 object[8] "Null_color2" 1
	else:
		ED7_76_1 object[8] "Null_color" 1
		ED7_76_0 object[8] "Null_color2" 1
	if system[0] == 0 + 100:
		ED7_76_0 object[7] "Null_color" 1
		ED7_76_1 object[7] "Null_color2" 1
	else:
		ED7_76_1 object[7] "Null_color" 1
		ED7_76_0 object[7] "Null_color2" 1
	if flag[3385]:
		ED7_76_0 object[255] "yo_before" 1
		ED7_76_1 object[255] "yo_after" 1
		ED7_76_2 object[255] "monita_" "off"
	elif flag[3089]:
		ED7_76_0 object[255] "yo_before" 1
		ED7_76_1 object[255] "yo_after" 1
		ED7_76_2 object[255] "monita_" "on"
	else:
		ED7_76_1 object[255] "yo_before" 1
		ED7_76_0 object[255] "yo_after" 1
		ED7_76_2 object[255] "monita_" "on"
	if !flag[4071]:
		ObjFrame object[10] 0
	else:
		ObjFrame object[10] 30
	ED7_76_0 object[255] "ev_wall" 1
	LookPointFlagsSet look_point[3] 0x0001
	ObjFlagsSet object[6] 0x0004
	if flag[3089]:
		LookPointFlagsUnset look_point[3] 0x0001
		ObjFlagsUnset object[6] 0x0004
	if flag[1]:
		SoundStop sound[133]
		SoundPlay sound[134] 1 100 0
		FlagUnset flag[1]
	elif system[0] == 109:
		SoundStop sound[133]
		SoundPlay sound[134] 1 100 0
	else:
		SoundPlay sound[133] 1 100 0
		SoundStop sound[134]
	Return

fn[2]:
	ED7_F2 1
	SystemFlagsSet 0x08000000
	if !flag[4071]:
		SoundPlay sound[14] 0 100 0
		ED7_74 object[10] 0 30
		ED7ObjPlay object[10] 0 30 0 0
		Sleep 500ms
		if ItemAdd item[506] 1:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextSetName ""
			TextMessage name[742] {
				{color 0}已取得{item[506]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			TextSetPos -1 280 60 3
			FadeIn 300ms 0x00000000
			FlagSet flag[4071]
			ED7_DE 5
		else:
			FadeOut 300ms 0x00000000 100
			TextSetName ""
			TextMessage name[742] {
				寶箱裡裝有{item[506]}{color 0}。
				因持有物品已達上限，已放棄{item[506]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			SoundPlay sound[15] 0 100 0
			ED7ObjPlay object[10] 30 0 0 0
	else:
		FadeOut 300ms 0x00000000 100
		TextSetPos -1 -1 -1 -1
		TextSetName ""
		TextMessage name[742] {
			{0x06}{color 5}寶箱裡什麼都沒有。{color 0}{wait}
		}
		TextWait
		TextClose 0
		FadeIn 300ms 0x00000000
	Sleep 30ms
	TextEnd null
	SystemFlagsUnset 0x08000000
	Return

fn[3]:
	TextSetName ""
	TextMessage null {
		{color 5}披薩盒上貼了一張寫著簡易食譜的紙。{wait}
	}
	TextWait
	TextClose 0
	_59
	TextSetPos -1 280 60 3
	if ItemHas item[2] 0:
