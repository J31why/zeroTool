			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			FadeWait
			_59
			TextSetPos -1 280 60 3
	TextEnd null
	Return

fn[4]:
	TextStart self
	if flag[3089]:
		if !flag[3201]:
			CharSetChipPattern char[0] 0
			TextTalk char[0] {
				#02301F（喀噠噠達、喀噠噠噠噠噠噠……）{wait}
			} {
				#02310F……可惡，這個方法也不行嗎！？
				那就試試看這個代碼……{wait}
			}
			TextWait
			TextTalk name[1] {
				#00105F（看起來好像很投入呢……）{wait}
			}
			TextWait
			TextTalk name[2] {
				#00205F約納……你在做什麼？{wait}
			}
			TextWait
			Emote char[0] 0mm 2000mm 38 38 250ms 1
			Sleep 1000ms
			field_party[0].5 = char[0].4
			char[0].5 = char[0].4
			CharFlagsUnset char[0] 0x0010
			CharTurnToChar char[0] field_party[0] 0deg/s
			char[0].4 = (char[0].4 + 360) % 360
			char[0].4 = char[0].4 + 360 - char[0].5
			char[0].5 = char[0].4 / 180
			if char[0].4 <= 45 | char[0].4 >= 315 && char[0].4 <= 405 | char[0].4 >= 675:
			elif char[0].5 < 1:
				char[0].8 = 2
			elif char[0].5 > 2:
				char[0].8 = 1
			else:
				char[0].8 = char[0].5
			char[0].4 = field_party[0].5
			field_party[0].5 = 0
			char[0].5 = 0
			CharFlagsSet char[0] 0x0010
			Sleep 300ms
			TextTalk char[0] {
				#02305F……啊，是你們啊。{wait}
			} {
				#02302F沒有啦，我找到了一些
				令人很在意的東西。{wait}
			} {
				#02306F我正在努力
				分析當中，不過……
				這東西相當複雜啊。{wait}
			} {
				#02309F嘿嘿，本天才ＳＥ約納
				正在熱血沸騰呢。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00006F這、這樣啊……你高興就好。{wait}
			} {
				#00001F……約納有看到那場演講嗎？{wait}
			}
			TextWait
			TextTalk char[0] {
				#02305F呃……
				你是說那個獨立怎樣的嗎？{wait}
			} {
				#02303F我是有用終端機看轉播啦，不過……
				老實說，我現在對那個沒興趣。{wait}
			} {
				#02301F總之，要是沒事的話，
				可以請你們離席嗎？{wait}
			} {
				我現在想專心
				分析這些資料。{wait}
			}
			TextWait
			CharSetChipPattern char[0] 0
			Emote field_party[0] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Emote field_party[1] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Emote field_party[2] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Emote field_party[3] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Sleep 1000ms
			TextTalk name[3] {
				#00303F（嗯……
				　他好像完全沉浸在
				　自己的世界裡了。）{wait}
			}
			TextWait
			TextTalk name[2] {
				#00203F（約納這小子這麼囂張……
				　待會要好好教訓他。）{wait}
			}
			TextWait
			TextTalk name[0] {
				#00012F（好、好了好了……
				　我們也不該一直打擾他，
				　下次有機會再來吧。）{wait}
			}
			TextWait
			FlagSet flag[3201]
		else:
			CharSetChipPattern char[0] 0
			TextTalk char[0] {
				#02301F（喀噠噠達、喀噠噠噠噠噠噠……）{wait}
			} {
				#02310F呃，這樣的話……
				……啊！還是不行嗎！{wait}
			} {
				#02303F不然就從另一個路徑……
				……嘀嘀咕咕……{wait}
			}
			TextWait
			TextTalk name[0] {
				#00003F（完全投入其中了……
				　下次有機會再來吧。）{wait}
			}
			TextWait
	elif flag[3087]:
		if !flag[3]:
			TextTalk char[0] {
				#02304F空調完善、網路環境也是最頂級的，
				再加上這種與現實隔絕的感覺……{wait}
			} {
				#02302F嗯，第４控制終端機
				比我想像中更棒呢。{wait}
			} {
				#02309F好啦，我也得把這個終端的環境
				重新設定成我喜歡的樣子才行♪{wait}
			}
			TextWait
			TextTalk name[0] {
				#00006F（嗯，感覺很像
				　在幫助別人過不健康的生活，
				　有點內疚啊……）{wait}
			}
			TextWait
			TextTalk name[2] {
				#00203F（不過，他在一定程度上
				　是可以照顧好自己的，
				　我想應該沒問題吧。）{wait}
			} {
				#00200F（我晚點也主動
				　和主任那邊聯絡一下吧。）{wait}
			}
			TextWait
			FlagSet flag[3]
		else:
			TextTalk char[0] {
				#02305F……嗯？你們還在啊？{wait}
			} {
				#02306F我現在很忙的。
				好了好了，你們快回去吧。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00006F（這、這小子好欠揍啊……）{wait}
			}
			TextWait
	TextEnd self
	Return

fn[5]:
	ED7_F2 2
	FadeOut 300ms 0x00000000 100
	TextMessage name[742] {
		{color 5}有可恢復導力器的裝置。{color 0}{wait}
	}
	Menu menu[0] -1 -1 1
		"在此地休息" // 0
		"放棄" // 1
	MenuWait var[0]
	MenuClose menu[0]
	TextClose 0
	if var[0] == 0:
		FadeIn 100ms 0x00000000
		Sleep 500ms
		SoundLoad sound[13]
		ED7_74 object[9] 0 30
		SoundPlay sound[7] 0 100 0
		ObjFrame object[9] 0
		ED7ObjPlay object[9] 0 30 0 0
		ObjWait object[9]
		ED7ObjPlay object[9] 31 390 0 32
		Sleep 1000ms
		BgmStop 3000ms
		FadeOut 1000ms 0x00000000 255
		Sleep 700ms
		SoundPlay sound[13] 0 100 0
		FadeWait
		PartySetAttr name[255] 254 0
		CamLookChar field_party[0] 0ms
		ED7_31 1
		Sleep 3500ms
		ObjFrame object[9] 0
		BgmResume
		FadeIn 1000ms 0x00000000
		TextClose 0
		TextEnd null
		Return
	else:
		FadeIn 300ms 0x00000000
		TextEnd null
		Return
	Return
	Return

fn[6]:
	if flag[4329]:
		Return
	EventBegin 1
	field_party[0].11 = 0
	field_party[1].11 = 0
	field_party[2].11 = 0
