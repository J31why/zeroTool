fn[5]:
	while 1:
		CharSetChipBase self chip[42]
		ED7CharAnimation self 1000ms 0 1
		Sleep 300ms
		Fork self fork[1]:
			_94 1 self 0deg 250 5000mm/s 0
		SoundPlay sound[538] 0 60 0
		ED7CharAnimation self 3000ms 2 3
		Shake 100 0 3000 500ms
		SoundPlay sound[880] 0 80 0
		SoundPlay sound[196] 0 50 0
		EffPlay eff[1] eff_instance[255] self 5 (-750, 1200, 1000) 0 0 0 750 750 750 null (0, 0, 0) 0ms
		Sleep 500ms
		CharSetChipPattern self 4
		Sleep 50ms
		CharSetChipBase self chip[40]
		CharSetChipPattern self 0
		_94 1 self 0deg -250 5000mm/s 0
		if random % 2 == 0:
			Sleep 1000ms
		else:
			Sleep 500ms
	Return
