fn[32]:
	switch random % 8:
		case 0:
			Sleep 200ms
			break
		case 1:
			Sleep 400ms
			break
		case 2:
			Sleep 600ms
			break
		case 3:
			Sleep 800ms
			break
		case 4:
			Sleep 1000ms
			break
		case 5:
			Sleep 1200ms
			break
		case 6:
			Sleep 1400ms
			break
		default:
			Sleep 1600ms
			break
	while 1:
		Emote self 0mm 1700mm 38 39 250ms 2
		Sleep 1000ms
		EmoteStop self
		Sleep 1000ms
	Return

