fn[5]:
	TextStart self
	if flag[3089]:
	elif flag[2816]:
		if !flag[0]:
			TextTalk self {
				唉，那天晚上的撒札克先生
				真的好帥喔……{wait}
			}
			TextWait
			TextTalk self {
				居然用那麼認真的表情
				對我說『妳的好我都知道』……{wait}
			}
			TextWait
			TextTalk self {
				哦呵呵，那真是最美好的一刻啊。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				還有，沒想到他
				居然還送我
				彩虹劇團的門票……{wait}
			}
			TextWait
			TextTalk self {
				哦呵呵，我真的好幸福喔。{wait}
			}
			TextWait
	elif flag[2564]:
	elif flag[2560]:
		if !flag[0]:
			TextTalk self {
				唉，我也好想跟帕露小姐一樣，
				交到一個可靠又出色的男朋友喔。{wait}
			}
			TextWait
			Emote char[0] 0mm 2000mm 38 38 250ms 1
			Sleep 1000ms
			TextTalk self {
				啊，糟糕糟糕……
				我得要澆花才行。{wait}
			}
			TextWait
			TextTalk self {
				哦呵呵，對不起唷。
				我現在就替你澆好多水水唷～！{wait}
			}
			TextWait
			TextTalk name[3] {
				#00305F（什麼？竟然會是童言童語……
				　這加分超多的啦！）{wait}
			}
			TextWait
			TextTalk name[8] {
				#10106F（加、加什麼分啊……）{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				哦呵呵，對不起唷。
				我現在就替你澆好多水水唷～！{wait}
			}
			TextWait
	elif flag[2369]:
	elif flag[2353]:
		if !flag[0]:
			TextTalk self {
				呼，這裡視野很好，
				真是太棒了。{wait}
			}
			TextWait
			TextTalk self {
				啊，順道一提，
				我沒有在偷懶喔。{wait}
			}
			TextWait
			TextTalk self {
				經理有交代說
