		SoundStop sound[444]
	elif flag[2605] && !flag[2607] && !flag[2778]:
		SoundPlay sound[821] 1 40 0
		SoundStop sound[444]
	else:
		SoundPlay sound[821] 1 40 0
		SoundPlay sound[444] 1 100 0
	SoundPlayContinuously sound[123] (-70, 4250, -9760) 10000 100000 80 0
	Return

fn[3]:
	TextStart self
	if flag[2605]:
		if !flag[0]:
			TextTalk char[0] {
				主題樂園內
				正在舉辦夜間活動。{wait}
			}
			TextWait
			TextTalk char[0] {
				咪西他們巡遊園內的
				夜間遊行也盛況空前喔。{wait}
			}
			TextWait
			if PartyPosition name[2] > -1:
				TextTalk name[2] {
					#00203F……老實說，我很想看。{wait}
				}
				TextWait
				TextTalk name[0] {
					#00002F哈哈，這次沒辦法啊。
					下次有機會再去看吧。{wait}
				}
				TextWait
				TextTalk name[2] {
					#00202F呵呵……就這麼說定了喔。{wait}
				}
				TextWait
			else:
				TextTalk name[0] {
					#00003F（嗯～如果緹歐聽到，
					　一定會想去看吧……）{wait}
				}
				TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				主題樂園內
				正在舉辦夜間活動。{wait}
			}
			TextWait
			TextTalk char[0] {
				咪西他們巡遊園內的
				夜間遊行也盛況空前喔。{wait}
			}
			TextWait
	elif flag[2601]:
	elif flag[2597]:
	TextEnd self
	Return

