	if flag[2608] && !flag[2609]:
		SystemFlagsSet 0x10000000
		Event fn[0,11]
	elif flag[2605] && !flag[2607] && !flag[2778]:
		SystemFlagsSet 0x10000000
		Event fn[0,12]
	Return

fn[2]:
	if flag[2608] && !flag[2610]:
		ED7_76_0 object[255] "board0a" 1
		ED7_76_0 object[255] "board0b" 1
	else:
		ED7_76_0 object[255] "board1a" 1
		ED7_76_0 object[255] "board1b" 1
	TriggerFlagsSet trigger[0] 0x0080
	if flag[2606] && !flag[2607]:
		TriggerFlagsUnset trigger[0] 0x0080
	if flag[2608] && !flag[2816]:
