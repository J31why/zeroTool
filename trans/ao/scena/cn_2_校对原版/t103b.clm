	SystemFlagsUnset 0x00000020
	FadeOut 300ms 0x00000000 100
	TextSetName ""
	TextSetPos -1 -1 -1 -1
	TextMessage null {
		{color 5}   ～給入園遊客的提醒～

		本主題樂園嚴禁
		任何不當暴力行為，
		並禁止攜帶危險物品入園。

		另外，
		孩童在園區中遊玩時，
		請家長務必隨時陪同。{wait}
	}
	TextWait
	TextClose 0
	FadeIn 300ms 0x00000000
	_59
	TextSetPos -1 280 60 3
	EventEnd 3
	Return
