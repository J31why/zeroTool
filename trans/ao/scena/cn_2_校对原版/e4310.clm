				break
			case 1:
				EffPlay2 eff[3] eff_instance[255] object[2] "Null_bp_hou(16)" 7 (0, 0, 0) 170 -45 0 250 250 250 0ms
				break
			case 2:
				EffPlay2 eff[3] eff_instance[255] object[2] "Null_bp_hou(16)" 7 (0, 0, 0) 175 -45 0 250 250 250 0ms
				break
			case 3:
				EffPlay2 eff[3] eff_instance[255] object[2] "Null_bp_hou(16)" 7 (0, 0, 0) 185 -45 0 250 250 250 0ms
				break
			case 4:
				EffPlay2 eff[3] eff_instance[255] object[2] "Null_bp_hou(16)" 7 (0, 0, 0) 190 -45 0 250 250 250 0ms
				break
			default:
				EffPlay2 eff[3] eff_instance[255] object[2] "Null_bp_hou(16)" 7 (0, 0, 0) 180 -45 0 250 250 250 0ms
				break
		Sleep 100ms
	Return

