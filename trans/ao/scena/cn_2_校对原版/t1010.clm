battle[0]:
	flags 74
	level 255
	unk1 6
	vision_range 45
	move_range 3
	can_move 3
	move_speed 30
	unk2 0
	battlefield "bt1010"
	sepith null
	setup 100:
		enemies "ms86100.dat" "ms82002.dat" "ms82002.dat" "ms82002.dat" null null null null
		placement placement[5] placement[4]
		bgm bgm[540] bgm[453]
		at_roll at_roll[3]

fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharWalkToPos self (26860, -2000, 2200) 2000mm/s 0
		CharWalkToPos self (-4019, -1800, 2200) 2000mm/s 0
		CharWalkToPos self (-3510, -1800, -1500) 2000mm/s 0
		CharWalkToPos self (26860, -2000, -2060) 2000mm/s 0
	Return

fn[2]:
	while 1:
		CharWalkToPos self (-1970, -2000, 34720) 2000mm/s 0
		CharWalkToPos self (-1970, -2000, 8940) 2000mm/s 0
		CharWalkToPos self (2029, -2000, 8940) 2000mm/s 0
		CharWalkToPos self (2029, -2000, 34720) 2000mm/s 0
	Return

fn[3]:
	CharSetChipBase char[0] chip[0]
	CharSetChipPattern char[0] 0
	ForkQuit char[0] fork[0]
	CharFlags2Set char[0] 0x0004
	CharSetChipPattern char[0] 1
	CharFlagsSet char[0] 0x0010
	CharSetChipBase char[1] chip[1]
	CharSetChipPattern char[1] 0
	ForkQuit char[1] fork[0]
	CharFlags2Set char[1] 0x0004
	CharSetChipPattern char[1] 2
	CharFlagsSet char[1] 0x0010
	if flag[2605]:
		CharFlagsSet char[0] 0x0080
		CharFlagsSet char[1] 0x0080
		CharFlagsSet char[2] 0x0080
		CharFlagsSet char[3] 0x0080
	if !flag[2605] && flag[2601]:
		CharFlagsUnset char[4] 0x0080
		CharFlagsSet char[4] 0x0010
	Return

fn[4]:
	ED7_76_1 object[255] "t1010_sky" 1
	ED7_76_0 object[255] "t1010_sky_y" 1
	if flag[3385]:
		system[1] = 563
	SoundPlay sound[126] 1 80 0
	TriggerFlagsSet trigger[0] 0x0080
	if flag[3358] && !flag[3359]:
		TriggerFlagsUnset trigger[0] 0x0080
	if flag[3385]:
		MapColor 0x00FFEBDC 0ms
		Fog 0xFFD5B47B 13 120 0
	elif flag[3355]:
		MapColor 0x00FFEBDC 0ms
		Fog 0xFFD5B47B 13 120 0
	Return

fn[5]:
	TextStart self
	if flag[2605]:
	elif flag[2601]:
		if !flag[2]:
			Call fn[0,6]
		else:
			TextTalk char[0] {
				瑟爾你這樣不行啦，真的不行。{wait}
			}
			TextWait
			TextTalk char[0] {
				竟然讓淑女丟臉，
				這不是紳士該做的行為喔。{wait}
			}
			TextWait
	elif flag[2597]:
		if !flag[2]:
			Call fn[0,6]
		else:
			TextTalk char[0] {
				瑟爾你這樣不行啦，真的不行。{wait}
			}
			TextWait
			TextTalk char[0] {
				為了成為我優秀的丈夫，
				至少得為我做到這麼多才行。{wait}
			}
			TextWait
	TextEnd self
	CharSetChipPattern char[0] 1
	Return

fn[6]:
	if flag[2601]:
		TextTalk char[0] {
			聽好了！瑟爾！
			你既然身為我的未婚夫，
			我認為你得要有遠大的眼光。{wait}
		}
		TextWait
		TextTalk char[0] {
			『還是先生女後生男最理想』
			……我媽是這麼說的啦……你覺得呢？{wait}
		}
		TextWait
		TextTalk char[1] {
			先生女後生男……？{wait}
		}
		TextWait
		TextTalk char[1] {
			我、我聽不懂，妳在說什麼？{wait}
		}
		TextWait
		TextTalk char[0] {
			……討、討厭啦！{wait}
		}
		TextWait
		TextTalk char[1] {
			？？？{wait}
		}
		TextWait
	elif flag[2597]:
		TextTalk char[0] {
			聽好了！瑟爾！
			你既然身為我的未婚夫，
			就得成為帥氣的男人才行。{wait}
		}
		TextWait
		TextTalk char[0] {
			我希望你頭腦聰明、
			擅長運動，而且對我也很溫柔。{wait}
		}
		TextWait
		TextTalk char[1] {
			妳、妳這麼說我也……
			具體來說我該怎麼做？{wait}
		}
		TextWait
		TextTalk char[0] {
			首先要每天做一百次
			伏地挺身和仰臥起坐。{wait}
		}
		TextWait
		TextTalk char[0] {
			然後主日學校的小考
			一定都要考滿分。{wait}
		}
		TextWait
		TextTalk char[1] {
			妳、妳這要求也太高了吧……{wait}
		}
		TextWait
	CharFlagsUnset char[0] 0x0010
	CharFlagsUnset char[1] 0x0010
	FlagSet flag[2]
	Return

fn[7]:
	TextStart self
	if flag[2605]:
	elif flag[2601]:
		if !flag[2]:
			Call fn[0,6]
		else:
			TextTalk char[1] {
				我有時真的搞不懂
				艾美到底在說什麼。{wait}
			}
			TextWait
			TextTalk char[1] {
				先生女後生男……
				到底是什麼意思啊？{wait}
			}
			TextWait
	elif flag[2597]:
		if !flag[2]:
			Call fn[0,6]
		else:
			TextTalk char[1] {
				艾美的理想太高了啦。{wait}
			}
			TextWait
			TextTalk char[1] {
				人生又不能隨心所願，
				像這樣一直拉高門檻，
				我也很難達成啊。{wait}
			}
			TextWait
	TextEnd self
	CharSetChipPattern char[1] 2
	Return

fn[8]:
	TextStart self
	if flag[2605]:
	elif flag[2602]:
		if !flag[0]:
			TextTalk char[2] {
				呵，幾位平民在這地方
				究竟在做些什麼啊？{wait}
			}
			TextWait
			TextTalk name[82] {
				#01105F咦～？{wait}
			}
			TextWait
			Emote name[82] 300mm 1300mm 54 57 250ms 0
			SoundPlay sound[822] 0 100 0
			Sleep 1000ms
			Emote char[2] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Sleep 1000ms
			EmoteStop name[82]
			TextTalk char[2] {
				……不，沒什麼。{wait}
			}
			TextWait
			TextTalk char[2] {
				當我沒說，
				拜託妳別用那麼
				天真無邪的笑容看著我……！{wait}
			}
			TextWait
			TextTalk name[0] {
				#00012F（哈哈……琪雅真是無敵啊。）{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[2] {
				……拜託你們走開。{wait}
			}
			TextWait
			TextTalk char[2] {
				我為自己莫名其妙諷刺別人的
				言行覺得很窩囊……{wait}
			}
			TextWait
	elif flag[2601]:
		TextTalk char[2] {
			剛剛往迎賓館方向走去的
			那位綠色頭髮的女孩，
			總覺得很久以前也看過她……{wait}
		}
		TextWait
		TextTalk char[2] {
			咦？是什麼時候的事啊？{wait}
		}
		TextWait
	elif flag[2597]:
		if !flag[0]:
			TextTalk char[2] {
				哎呀哎呀，你們來這裡有什麼事嗎？{wait}
			}
			TextWait
			TextTalk char[2] {
				這裡是高級別墅區，
				照理說和平民無關才對啊……{wait}
			}
			TextWait
			TextTalk char[2] {
				……呵，算了無所謂。
				咱們有錢人住的豪宅究竟有
				多氣派，就讓你們開開眼界吧。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[2] {
				……呵，算了無所謂。
				咱們有錢人住的豪宅究竟有
				多氣派，就讓你們開開眼界吧。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[9]:
	TextStart self
	if flag[2605]:
	elif flag[2601]:
		TextTalk char[3] {
			自從哈爾特曼前議長下台後，
			這附近就沒再出現
			可疑的傢伙了。{wait}
		}
		TextWait
		TextTalk char[3] {
			在那棟宅邸成為迎賓館後，
			警備也變得更加森嚴。
			治安也比以前好多了。{wait}
		}
		TextWait
	elif flag[2597]:
		if !flag[1]:
			TextTalk char[3] {
				哈爾特曼前議長的宅邸，
				不久前改裝成了迎賓館。{wait}
			}
			TextWait
			TextTalk char[3] {
				前陣子召開通商會議時，
				似乎也用這座迎賓館
				來接待各國領袖。{wait}
			}
			TextWait
			TextTalk char[3] {
				和過去整天辦可疑派對的時期相比，
				現在的迎賓館的確變成一個
				有意義又健全許多的場所。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk char[3] {
				哈爾特曼前議長的宅邸，
				不久前改裝成了迎賓館。{wait}
			}
			TextWait
			TextTalk char[3] {
				和過去整天辦可疑派對的時期相比，
				現在的迎賓館的確變成一個
				有意義又健全許多的場所。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[10]:
	TextStart self
	if !flag[3]:
		TextTalk self {
			傳單上寫的宅邸
			看來就是這裡了。{wait}
		}
		TextWait
		TextTalk self {
			能將湖景一覽無遺的絕佳地點……
			看來蠻不錯的。{wait}
		}
		TextWait
		FlagSet flag[3]
	else:
		TextTalk self {
			能將湖景一覽無遺的絕佳地點……
			看來蠻不錯的。{wait}
		}
		TextWait
		TextTalk self {
			我是不是該決定買下它呢？{wait}
		}
		TextWait
	TextEnd self
	Return

