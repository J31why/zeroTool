calmare zero_k scena
scena:
	name "t106b" "t106b" "t106b"
	town town[66]
	bgm bgm[513]
	flags 8192
	item_use fn[0,255]
	unk 255 26

entry:
	pos (0, 0, -1000)
	unk1 0
	cam_from (0, 0, 24000)
	cam_pers 500
	unk2 30
	cam_deg 45deg
	cam_limit 0deg 360deg
	cam_at (0, 0, 0)
	unk3 0
	unk4 0
	flags 0x0001
	town town[66]
	init fn[0,1]
	reinit fn[0,2]

chip[0] "chr/ch27600.itc"
chip[1] "chr/ch33300.itc"
chip[2] "chr/ch23402.itc"
chip[3] "chr/ch23500.itc"
chip[4] "chr/ch23800.itc"

npc char[0]:
	name "觀光客"
	pos (-101040, 0, 1070)
	angle 180deg
	flags 0x0185
	unk2 0
	chip chip[0]
	init fn[0,0]
	talk fn[0,3]
	unk4 255

