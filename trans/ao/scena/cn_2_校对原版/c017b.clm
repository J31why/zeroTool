fn[4]:
	Call fn[0,5]
	Return

fn[5]:
	TextStart char[0]
	if !flag[0]:
		TextTalk char[0] {
			今天下班之後，
			我要和辛西亞學姊還有珍妮塔
			三個人一起去吃飯。{wait}
		}
		TextWait
		TextTalk char[0] {
			久違的聚餐，
			呵呵，真令人期待。{wait}
		}
		TextWait
		FlagSet flag[0]
	else:
		TextTalk char[0] {
			久違的聚餐，
			呵呵，真令人期待。{wait}
		}
		TextWait
	TextEnd char[0]
	Return

