fn[9]:
	TextStart char[2]
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"交談" // 0
			"買東西" // 1
			"放棄" // 2
		MenuWait var[0]
		if var[0] != 1:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			if flag[3074]:
				ShopOpen shop[38]
			elif flag[2816]:
				ShopOpen shop[37]
			elif flag[2560]:
				ShopOpen shop[36]
			else:
				ShopOpen shop[35]
			var[0] = 99
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			if !flag[2]:
				TextTalk char[2] {
					各位知道在傍晚之後
					選購鞋子比較好嗎？{wait}
				}
				TextWait
				TextTalk char[2] {
					因為人類在早上起床後，
					腳會開始慢慢膨脹，到了傍晚
					最多會膨脹大約１里矩。{wait}
				}
				TextWait
				TextTalk char[2] {
					因此，傍晚後腳會是最大的，
					在那個時段挑選鞋子的尺寸是最好的喔。{wait}
				}
				TextWait
				FlagSet flag[2]
			else:
				TextTalk char[2] {
					實際上，人類在早上起床後，
					腳會開始慢慢膨脹，到了傍晚
					最多會膨脹大約１里矩。{wait}
				}
				TextWait
				TextTalk char[2] {
					因此，傍晚後腳會是最大的，
					在那個時段挑選鞋子的尺寸是最好的喔。{wait}
				}
				TextWait
	TextEnd char[2]
	Return

