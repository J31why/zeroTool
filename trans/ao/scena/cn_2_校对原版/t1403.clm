fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if flag[2608]:
	elif flag[2607]:
	elif flag[2605]:
	elif flag[2604]:
		CharFlagsUnset char[0] 0x0080
		CharFlagsUnset char[1] 0x0080
		CharFlagsUnset char[2] 0x0080
		CharFlagsSet char[2] 0x0010
		CharFlagsUnset char[3] 0x0080
		CharFlagsSet char[3] 0x0010
		CharFlagsUnset char[4] 0x0080
		CharFlagsSet char[4] 0x0010
		CharFlagsUnset char[5] 0x0080
		CharFlagsSet char[5] 0x0010
	elif flag[2602]:
	elif flag[2601]:
	elif flag[2600]:
	elif flag[2597]:
	elif flag[2592]:
	Return

fn[2]:
	if flag[3093] && !flag[3385]:
		system[1] = 251
	elif flag[3385]:
		system[1] = 351
	if system[0] == 100 | system[0] == 101:
		SoundPlay sound[135] 1 100 0
	else:
		SoundStop sound[135]
	if system[4] <= 4:
		SystemFlagsSet 0x00002000
	else:
		SystemFlagsUnset 0x00002000
	Return

fn[3]:
	TextStart self
	TextTalk self {
		呵呵呵，不用擔心。
		我年紀還沒有大到
		會輸給年輕人。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[4]:
	TextStart self
	TextTalk self {
		爺爺，這樓梯挺長的，
		你還好嗎？{wait}
	}
	TextWait
	TextEnd self
	Return

fn[5]:
	TextStart self
	TextTalk self {
		呼、呼……
		還真的是有點累了……{wait}
	}
	TextWait
	TextEnd self
	Return

fn[6]:
	TextStart self
	TextTalk self {
		來，再加把勁。
		距離頂樓只差一點點而已了。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[7]:
	TextStart self
	TextTalk self {
		哇……真的好高啊……{wait}
	}
	TextWait
	TextEnd self
	Return

fn[8]:
	TextStart self
	TextTalk self {
		真的……
		都覺得頭有點暈了{wait}
	}
	TextWait
	TextEnd self
	Return
