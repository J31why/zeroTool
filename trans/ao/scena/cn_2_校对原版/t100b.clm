fn[9]:
	EventBegin 1
	SoundPlay sound[2094] 255 100 0
	TextTalk name[0] {
		#0000F這裡應該能釣到點什麼吧。{wait}
	}
	TextWait
	CamSetDistance 27760 -3400 -57630 1500ms
	ED7CamRotate 315deg 28deg 0deg 1500ms
	CamPers 300 1500ms
	CamZoom 35500 1500ms
	Sleep 1000ms
	TextSetName ""
	TextMessage null {
		{color 5}要釣魚嗎？{color 0}{wait}
	}
	Menu menu[0] -1 -1 1
		"開始釣魚" // 0
		"放棄" // 1
	MenuWait var[0]
	MenuClose menu[0]
	TextClose 0
	_59
	CamWait 1
	if var[0] == 0:
		ED7_E0 2
		Minigame 6 5 23450 -5000 -54930 90 29380 -6000 -55430
	ED7_E0 2
	EventEnd 5
	Return

