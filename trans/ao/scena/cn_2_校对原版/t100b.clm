fn[0]:
	switch random % 8:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if flag[2608]:
	elif flag[2607]:
	elif flag[2605]:
		CharFlagsUnset char[0] 0x0080
		CharFlagsUnset char[1] 0x0080
		CharFlagsUnset char[2] 0x0080
		CharFlagsSet char[2] 0x0010
		CharFlagsUnset char[3] 0x0080
		CharFlagsSet char[3] 0x0010
		CharFlagsUnset char[4] 0x0080
		CharFlagsUnset char[5] 0x0080
	elif flag[2604]:
	elif flag[2602]:
	elif flag[2601]:
	elif flag[2600]:
	elif flag[2597]:
	elif flag[2592]:
	if flag[272]:
		FlagUnset flag[272]
		Event fn[0,10]
	Return

fn[2]:
	ObjFlagsSet object[1] 0x0004
	if flag[2605] && !flag[2816]:
		ObjFlagsUnset object[0] 0x0004
		ObjFrame object[0] 30
	else:
		ObjFlagsSet object[0] 0x0004
	if flag[2605] && !flag[2816]:
		ObjFlagsUnset object[12] 0x0004
		ObjFlagsUnset object[13] 0x0004
		ObjFlagsUnset object[14] 0x0004
	else:
		ObjFlagsSet object[12] 0x0004
		ObjFlagsSet object[13] 0x0004
		ObjFlagsSet object[14] 0x0004
	SoundPlay sound[126] 1 80 0
	EffLoad eff[15] "eff\\mgm03_02.eff"
	EffPlay eff[15] eff_instance[8] null 0 (29380, -6000, -55430) 0 0 0 1000 1000 1000 null (0, 0, 0) 0ms
	Return

fn[3]:
	TextStart self
	if flag[2605]:
		TextTalk char[0] {
			本巴士即將出發。{wait}
		}
		TextWait
		TextTalk char[0] {
			返回克洛斯貝爾市的旅客
			請盡速搭乘。{wait}
		}
		TextWait
	elif flag[2601]:
	elif flag[2597]:
	elif flag[2592]:
	TextEnd self
	Return

fn[4]:
	TextStart self
	if flag[2605]:
		TextTalk char[1] {
			自從主題樂園完成後，
			我是第一次來米修拉姆……
			哎呀，真的很有趣呢。{wait}
		}
		TextWait
		TextTalk char[1] {
			尤其是那個叫『恐怖雲霄飛車』的，
			真的很刺激有趣。{wait}
		}
		TextWait
	elif flag[2601]:
	elif flag[2597]:
	TextEnd self
	Return

fn[5]:
	TextStart self
	if flag[2605]:
		TextTalk char[2] {
			真是的，不要這麼任性。{wait}
		}
		TextWait
		TextTalk char[2] {
			媽媽會再帶妳來的，好不好？{wait}
		}
		TextWait
	elif flag[2601]:
	elif flag[2597]:
	TextEnd self
	Return

fn[6]:
	TextStart self
	if flag[2605]:
		TextTalk char[3] {
			不──要──！
			人家還想繼續玩啦──！{wait}
		}
		TextWait
	elif flag[2601]:
	elif flag[2597]:
	TextEnd self
	Return

fn[7]:
	TextStart self
	if flag[2605]:
		TextTalk char[4] {
			呵呵，爺爺似乎
			非常喜歡主題樂園。{wait}
		}
		TextWait
		TextTalk char[4] {
			下次一定要再來喔。{wait}
		}
		TextWait
	elif flag[2601]:
	elif flag[2597]:
	TextEnd self
	Return

fn[8]:
	TextStart self
	if flag[2605]:
		TextTalk char[5] {
			我們兄妹送爺爺這場旅行
			慶祝爺爺生日。{wait}
		}
		TextWait
		TextTalk char[5] {
			看到爺爺玩得這麼開心，
			就感覺一切都值得了。{wait}
		}
		TextWait
	elif flag[2601]:
	elif flag[2597]:
	TextEnd self
