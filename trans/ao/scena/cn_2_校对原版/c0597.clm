	FadeWait
	TextTalk name[0] {
		#1430000078V#00003F#11P（隸屬於帝國軍情報局的
		　雷克多・亞蘭德爾。）{wait}
	} {
		#1430000079V#00013F（在他面前絕對大意不得……
		　進去前得先做好心理準備。）{wait}
	}
	TextWait
	FadeOut 300ms 0x00000000 100
	SoundPlay sound[814] 0 100 0
	TextSetPos -1 -1 -1 -1
	TextSetName ""
	TextMessage null {
		{color 5}一旦進入房間，
		就沒辦法調整裝備、道具和
		導力器了。{wait}
	} {
		同時，尚未完成的委託也將
		全部結束，請特別注意。{color 0}{wait}
	}
	TextWait
	TextClose 0
	_59
	TextSetPos -1 280 60 3
	Sleep 300ms
	Menu menu[0] -1 -1 0
		"【還有其他事要辦】" // 0
		"【開門進入房間】" // 1
	MenuWait var[0]
	MenuClose menu[0]
	FadeIn 300ms 0x00000000
	FadeWait
	switch var[0]:
		case 1:
			SoundPlay sound[103] 0 100 0
			ED7ObjPlay object[16] 0 10 0 0
			ObjWait object[16]
			BgmStop 4000ms
			FadeOut 1000ms 0x00000000 255
			Fork name[0] fork[1]:
				CharWalkToPos2 self (0, 0, 67000) 2000mm/s 0
			Sleep 300ms
			Fork name[1] fork[1]:
				CharWalkToPos2 self (0, 0, 67000) 2000mm/s 0
			Sleep 300ms
			Fork name[3] fork[1]:
				CharWalkToPos2 self (0, 0, 67000) 2000mm/s 0
			Sleep 300ms
			Fork name[2] fork[1]:
				CharWalkToPos2 self (0, 0, 67000) 2000mm/s 0
			FadeWait
			ForkQuit name[0] fork[255]
			ForkQuit name[1] fork[255]
			ForkQuit name[3] fork[255]
			ForkQuit name[2] fork[255]
			BgmWait
			Call fn[0,3]
			break
		case 0:
			CharSetPos field_party[0] (0, 30, 61800) 180deg
			ED7_Cam69 255 0
			EventEnd 5
			break
	Return

