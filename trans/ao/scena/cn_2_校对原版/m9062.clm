		ED7_76_0 object[255] "hikari05_add" 1
		ED7_76_0 object[255] "hikari99_add" 1
	else:
		Sc_BE 0 6 3 0 30 0 1 -20000 -4000 40000 5000 30000 0
		Sc_BE 1 6 3 0 30 0 1 20000 -4000 40000 5000 30000 0
		Sc_BE 2 6 3 0 30 0 1 20000 -4000 27000 5000 30000 0
		Sc_BE 3 6 3 0 30 0 1 -20000 -4000 27000 5000 30000 0
		EffLoad eff[17] "eff\\\\trapdmg0.eff"
	if flag[3391]:
		Call fn[0,50]
	Return

fn[2]:
	CharFlagsSet char[0] 0x0010
	TextStart char[0]
	if !flag[3701]:
		TextTalk char[0] {
			…………{wait}
		}
		TextWait
		TextTalk name[0] {
			#00001F瓦魯多……
			似乎徹底暈過去了。{wait}
		} {
			#00004F他剛才鼓勵了我們耶……
			這傢伙也很不坦率啊。{wait}
		}
		TextWait
		TextTalk name[1] {
			#00102F呵呵，是啊。
			而且還關心了一下
			琪雅的狀況……{wait}
		}
		TextWait
		TextTalk name[2] {
			#00200F總之，最好先把他抬到
			梅爾卡巴上……{wait}
		}
		TextWait
		TextTalk name[3] {
			#00306F不過，就連我
			也抬不太動這個人喔！{wait}
		}
		TextWait
		if PartyPosition name[4] > -1:
			TextTalk name[4] {
				#10400F算了，等等再帶阿巴斯過來
				請他幫忙吧。{wait}
			} {
				#10403F而且這一帶似乎已經安全了，
				應該不需要為他擔心。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00000F嗯，你說得對。
				現在就先繼續前進吧。{wait}
			}
			TextWait
		else:
			TextTalk name[0] {
				#00003F等等再帶阿巴斯過來
				請他幫忙吧。{wait}
			} {
				#00000F而且這一帶似乎已經安全了……
				現在就先繼續前進吧。{wait}
			}
			TextWait
		FlagSet flag[3701]
	else:
		TextTalk char[0] {
			…………{wait}
		}
		TextWait
		TextSetName ""
		TextMessage null {
			{color 5}似乎完全暈過去了。{color 0}{wait}
		}
		TextWait
		TextClose 0
		_59
	TextEnd char[0]
	Return

