		CharFlagsSet char[0] 0x8000
		CharFlagsSet char[0] 0x0010
		CharFlagsSet char[0] 0x0002
		CharFlagsSet char[0] 0x1000
		CharFlagsSet char[0] 0x0800
		CharSetPos char[0] (0, -200, 38500) 225deg
		CharSetChipPattern char[0] 0
	Return

fn[1]:
	ED7_EE 1 800
	if flag[0]:
		system[1] = 0
		FlagUnset flag[0]
	EntranceSetFunc entrance[0] fn[0,4]
	ObjFlagsSet object[0] 0x0004
	if flag[3391]:
		ED7_76_1 object[255] "magi10_add" 1
		ED7_76_1 object[255] "magi11_add" 1
		ED7_76_1 object[255] "point_add" 1
		ED7_76_0 object[255] "magi_04_add" 1
