fn[0]:
	if system[0] == 100:
		Event fn[0,3]
	if flag[3390] && !flag[3391]:
		Event fn[0,7]
	if flag[272]:
		FlagUnset flag[272]
		FlagSet flag[0]
		Event fn[0,28]
	elif flag[273]:
		FlagUnset flag[273]
		Event fn[0,48]
