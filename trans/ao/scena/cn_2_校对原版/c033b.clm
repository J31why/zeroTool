calmare zero_k scena
scena:
	name "c033b" "c033b" "c033b"
	town town[44]
	bgm bgm[513]
	flags 8192
	item_use fn[0,255]
	unk 255 0

entry:
	pos (0, 0, -1000)
	unk1 0
	cam_from (0, 0, 24000)
	cam_pers 500
	unk2 30
	cam_deg 45deg
	cam_limit 0deg 360deg
	cam_at (0, 0, 0)
	unk3 0
	unk4 0
	flags 0x0001
	town town[1]
	init fn[0,1]
	reinit fn[0,2]

chip[0] "chr/ch09300.itc"
chip[1] "chr/ch09302.itc"
chip[2] "chr/ch09400.itc"
chip[3] "chr/ch09402.itc"
chip[4] "chr/ch07200.itc"
chip[5] "chr/ch07202.itc"

npc char[0]:
	name "哈羅德"
	pos (-340, 0, 4410)
	angle 315deg
	flags 0x0105
	unk2 0
	chip chip[0]
	init fn[0,0]
	talk fn[0,4]
	unk4 255

npc char[1]:
	name "蘇菲亞"
	pos (550, 0, 2040)
	angle 180deg
	flags 0x0105
	unk2 0
	chip chip[2]
	init fn[0,0]
	talk fn[0,5]
	unk4 255

npc char[2]:
	name "柯林"
	pos (37480, 0, 3800)
	angle 180deg
	flags 0x0105
	unk2 0
	chip chip[4]
	init fn[0,0]
	talk fn[0,6]
	unk4 255

look_point[0]:
	pos (34620, 0, 7280)
	radius 1200
	bubble_pos (34620, 1750, 7280)
	unk1 124
	unk2 0
	function fn[0,3]
	unk3 0
	unk4 0

fn[0]:
	switch random % 8:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	CharSetPos char[0] (1940, 200, 6910) 270deg
	CharSetChipBase char[0] chip[1]
	CharSetChipPattern char[0] 0
	ForkQuit char[0] fork[0]
	CharFlags2Set char[0] 0x0004
	CharSetPos char[1] (40940, 0, -550) 180deg
	CharFlagsSet char[1] 0x0010
	CharSetPos char[2] (40930, 0, -1640) 90deg
	Return

fn[2]:
	Return

fn[3]:
	TextSetName ""
	TextMessage null {
		{color 5}有一本導力車雜誌『車迷月刊vol.1』。{color 0}{wait}
	}
	TextWait
	TextClose 0
	_59
	TextSetPos -1 280 60 3
	if flag[393] && !ItemHas item[876] 0:
		SoundPlay sound[17] 0 100 0
		TextSetPos -1 -1 -1 -1
		TextSetName ""
		TextMessage null {
			記住了
			{color 2}『藍天配色』{color 0}的噴漆樣式。{wait}
		}
		TextWait
		TextClose 0
		_59
		TextSetPos -1 280 60 3
		ItemAdd item[876] 1
	TextEnd null
	Return

fn[4]:
	TextStart self
	if !flag[2646]:
		TextTalk char[0] {
			#03605F哎呀，各位。{wait}
		}
		TextWait
		TextTalk name[0] {
			#00000F晚安，哈羅德先生。{wait}
		}
		TextWait
		TextTalk name[1] {
			#00104F二樓傳來了香味……
			夫人好像正在
			準備晚餐呢。{wait}
		}
		TextWait
		TextTalk char[0] {
			#03600F嗯，沒錯。
			而且今天柯林似乎
			也有幫忙的樣子。{wait}
		} {
			#03609F哎呀，我也是
			剛回到家，肚子
			已經餓壞了。{wait}
		}
		TextWait
		FlagSet flag[2646]
	else:
		TextTalk char[0] {
			#03600F看來今天
			柯林有幫忙
			煮飯的樣子呢。{wait}
		} {
			#03609F呵呵，我很期待
			會端出什麼料理來喔。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[5]:
	TextStart self
	TextTalk char[1] {
		#03700F好，接下來只要等它煮沸就好了。{wait}
	} {
		#03709F呵呵，你做得很好喔，柯林。
		爸爸一定也會很高興的。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[6]:
	TextStart self
	TextTalk char[2] {
		#03802F今天的晚餐
		是咖哩喔～{wait}
	} {
		#03809F耶嘿嘿，蔬菜
		是我負責切的～
		很厲害吧～？{wait}
	}
	TextWait
	TextEnd self
	Return
