fn[0]:
	switch random % 8:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharWalkToPos self (-240, 0, 1400) 1000mm/s 0
		CharWalkToPos self (-240, 0, 15530) 1000mm/s 0
		Sleep 3600ms
		CharWalkToPos self (-240, 0, 1400) 1000mm/s 0
		CharWalkToPos self (-24330, 0, 1400) 1000mm/s 0
		Sleep 1200ms
	Return

fn[2]:
	while 1:
		CharWalkToPos self (-240, 0, 1400) 1000mm/s 0
		CharTurnTo self 0deg 500deg/s
		Sleep 1800ms
		CharTurnTo self 90deg 500deg/s
		CharWalkToPos self (8240, 0, 1400) 1000mm/s 0
		Sleep 3600ms
		CharWalkToPos self (740, 0, 1400) 1000mm/s 0
		CharTurnTo self 0deg 500deg/s
		Sleep 1800ms
		CharTurnTo self 270deg 500deg/s
		CharWalkToPos self (-24330, 0, 1400) 1000mm/s 0
		Sleep 1200ms
	Return

