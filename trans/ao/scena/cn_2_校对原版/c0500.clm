				很難打聽到什麼有用的情報。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00003F嗯……
				現在就先算了吧。{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			TextTalk name[0] {
				#00003F從通商會議結束至今，緋紅商會
				一直都沒有太大的動靜。{wait}
			} {
				#00001F進去了應該也打聽不到
				有用的情報，所以現在先算了吧。{wait}
			}
			TextWait
		CharSetPos field_party[0] (90, 0, 80) 180deg
		EventEnd 4
	elif flag[2564]:
		EventBegin 1
		TextTalk name[0] {
			#00000F緋紅商會現在
			正由搜查一課負責盯著。{wait}
		} {
			這裡先交給他們，
			我們就先專注在我們自己的工作上吧。{wait}
		}
		TextWait
		CharSetPos field_party[0] (90, 0, 80) 180deg
		EventEnd 4
	elif flag[2560]:
		if !flag[2675]:
			Call fn[0,11]
		else:
			EventBegin 1
			TextTalk name[0] {
				#00003F這裡應該很難打聽到
				『紅色星座』的動向吧。{wait}
			} {
				#00000F我們就一邊處理支援請求，
				一邊四處打聽消息吧。{wait}
			}
			TextWait
			Sleep 50ms
			CharSetPos field_party[0] (90, 0, 80) 180deg
			EventEnd 4
	elif flag[2388]:
	elif flag[2369]:
	elif flag[2353]:
		if !flag[2434]:
			if !flag[2505]:
				Call fn[0,10]
			else:
				EventBegin 1
				TextTalk name[0] {
					#00000F現在不動產業者似乎
					正在等待交易對象現身。{wait}
				} {
					去打擾人家也不太好，先離開吧。{wait}
				}
				TextWait
				CharSetPos field_party[0] (90, 0, 80) 180deg
				EventEnd 4
	Return

