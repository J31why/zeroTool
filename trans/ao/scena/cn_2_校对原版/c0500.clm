fn[5]:
	TextStart self
	if flag[3385]:
		if !flag[1]:
			TextTalk self {
				在這種時局艱困的時候，
				店裡感覺也特別團結呢。{wait}
			}
			TextWait
			TextTalk self {
				我也已經無心
				跟競爭對手去
				爭奪紅牌的寶座了。{wait}
			}
			TextWait
			TextTalk self {
				身為公關小姐，只要客人
				能開開心心地喝酒，
				我就心滿意足了☆{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				我已經無心
				跟競爭對手去
				爭奪紅牌的寶座了。{wait}
			}
			TextWait
			TextTalk self {
				身為公關小姐，只要客人
				能開開心心地喝酒，
				我就心滿意足了☆{wait}
			}
			TextWait
	elif flag[3371]:
	elif flag[3089]:
		if !flag[1]:
			TextTalk self {
				國家獨立……
				聽起來挺不錯的。{wait}
			}
			TextWait
			TextTalk self {
				店裡的人
				看了總統的演講後，
				似乎也都很開心。{wait}
			}
			TextWait
			TextTalk self {
				……感覺好像連我也
				跟著開心起來了♪{wait}
