calmare zero_k scena
scena:
	name "c034b" "c034b" "c034b"
	town town[45]
	bgm bgm[513]
	flags 8192
	item_use fn[0,255]
	unk 255 0

entry:
	pos (0, 0, -1000)
	unk1 0
	cam_from (0, 0, 24000)
	cam_pers 500
	unk2 30
	cam_deg 45deg
	cam_limit 0deg 360deg
	cam_at (0, 0, 0)
	unk3 0
	unk4 0
	flags 0x0001
	town town[1]
	init fn[0,3]
	reinit fn[0,4]

chip[0] "chr/ch21700.itc"
chip[1] "chr/ch21702.itc"
chip[2] "chr/ch22000.itc"
chip[3] "chr/ch22100.itc"
chip[4] "chr/ch22200.itc"
chip[5] "chr/ch27600.itc"
chip[6] "chr/ch21900.itc"
chip[7] "chr/ch22102.itc"
chip[8] "chr/ch22202.itc"
chip[9] "chr/ch27602.itc"

npc char[0]:
	name "伊茲麗夫人"
	pos (40670, 0, 9600)
	angle 360deg
	flags 0x0105
	unk2 0
	chip chip[0]
	init fn[0,0]
	talk fn[0,5]
	unk4 255

npc char[1]:
	name "菲利克"
	pos (32660, 0, 5680)
	angle 180deg
	flags 0x0105
	unk2 0
	chip chip[2]
	init fn[0,2]
	talk fn[0,7]
	unk4 255

npc char[2]:
	name "辛蒂"
	pos (4980, 0, 8990)
	angle 89deg
	flags 0x0105
	unk2 0
	chip chip[3]
	init fn[0,0]
	talk fn[0,8]
	unk4 255

npc char[3]:
	name "安里"
	pos (5330, 0, 3990)
	angle 90deg
	flags 0x0185
	unk2 0
	chip chip[4]
	init fn[0,0]
	talk fn[0,9]
	unk4 255

npc char[4]:
	name "約庫斯"
	pos (690, 0, 990)
	angle 225deg
	flags 0x0185
	unk2 0
	chip chip[5]
	init fn[0,0]
	talk fn[0,10]
	unk4 255

fn[0]:
	switch random % 8:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharIdle self (5330, null, -850) (-2380, null, 2380) 1000mm/s
	Return

fn[2]:
	while 1:
		CharIdle self (30520, null, 4390) (34090, null, 7480) 1000mm/s
		Sleep 300ms
	Return

fn[3]:
	CharSetPos char[0] (2560, 350, 6660) 225deg
	CharSetChipBase char[0] chip[1]
	CharSetChipPattern char[0] 0
	ForkQuit char[0] fork[0]
	CharFlags2Set char[0] 0x0004
	CharFlagsUnset char[4] 0x0080
	CharSetPos char[4] (-630, 200, 6750) 135deg
	CharSetChipBase char[4] chip[9]
	CharSetChipPattern char[4] 0
	ForkQuit char[4] fork[0]
	CharFlags2Set char[4] 0x0004
	if !flag[0]:
		CharFlagsSet char[0] 0x0010
		CharFlagsSet char[4] 0x0010
	CharSetPos char[2] (2380, 200, 3690) 315deg
	CharSetChipBase char[2] chip[7]
	CharSetChipPattern char[2] 0
	ForkQuit char[2] fork[0]
	CharFlags2Set char[2] 0x0004
	CharSetChipPattern char[2] 1
	CharFlagsSet char[2] 0x0010
	CharFlagsUnset char[3] 0x0080
	CharSetPos char[3] (-380, 200, 3780) 45deg
	CharSetChipBase char[3] chip[8]
	CharSetChipPattern char[3] 0
	ForkQuit char[3] fork[0]
	CharFlags2Set char[3] 0x0004
	CharSetPos char[1] (700, 0, 0) 270deg
	ForkFunc char[1] fork[0] fn[0,1]
	Return

fn[4]:
	Return

fn[5]:
	TextStart self
	if !flag[0]:
		Call fn[0,6]
	else:
		TextTalk self {
			瑪麗埃塔小姐
			好像也很忙碌……{wait}
		}
		TextWait
		TextTalk self {
			看來可能要很久以後
			才能全家一起吃飯了。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[6]:
	TextTalk char[0] {
		話說回來，
		約庫斯啊，瑪麗埃塔小姐
		有辦法回國了嗎？{wait}
	}
	TextWait
	TextTalk char[4] {
		嗯，暫時還很困難吧。
		她好像很忙的樣子……{wait}
	}
	TextWait
	TextTalk char[0] {
		這樣啊……
		看來可能要很久以後
		才能全家一起吃飯了。{wait}
	}
	TextWait
	CharFlagsUnset char[0] 0x0010
	CharFlagsUnset char[4] 0x0010
	FlagSet flag[0]
	Return

fn[7]:
	TextStart self
	if !flag[1]:
		TextTalk self {
			爸爸工作非常忙碌，
			不過他很難得
			在晚餐時間就回來了。{wait}
		}
		TextWait
		TextTalk self {
			哎呀，話說回來，
			椅子不夠呢。
			得從雜物間搬出來才行……{wait}
		}
		TextWait
		FlagSet flag[1]
	else:
		TextTalk self {
			哎呀，話說回來，
			椅子不夠呢。
			得從雜物間搬出來才行……{wait}
		}
		TextWait
	TextEnd self
	Return

fn[8]:
	TextStart self
	if !flag[2]:
		TextTalk self {
			安里，你不是跑去
			近距離看蘭花塔了嗎？
			感想如何？{wait}
		}
		TextWait
		TextTalk self {
			塔果然很大嗎？
			是不是感覺花了很多米拉？
			人有沒有很多？{wait}
		}
		TextWait
		TextTalk char[3] {
			等、等一下啦，姊姊。
			妳一下子問這麼多，
			我沒辦法回答啦～{wait}
		}
		TextWait
		FlagSet flag[2]
	else:
		TextTalk self {
			有什麼關係嘛，
			別小氣，快說嘛。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[9]:
	TextStart self
	if !flag[3]:
		TextTalk self {
			嚼嚼嚼……{wait}
		}
		TextWait
		TextTalk self {
			啊，支援課的各位。
			來我們家有什麼事情嗎？{wait}
		}
		TextWait
		TextTalk self {
			方便的話，
			要不要一起吃個晚餐？{wait}
		}
		TextWait
		FlagSet flag[3]
	else:
		TextTalk self {
			話說回來，白天的揭幕儀式
			還真壯觀呢。{wait}
		}
		TextWait
		TextTalk self {
			各位警察同仁想必
			會非常忙碌，
			請你們要努力喔。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[10]:
	TextStart self
	if !flag[0]:
		Call fn[0,6]
	else:
		TextTalk self {
			我太太瑪麗埃塔
			在國外的ＩＢＣ分公司工作。{wait}
		}
		TextWait
		TextTalk self {
			那邊好像很忙的樣子，她大概
			要很久之後才能回來了吧……{wait}
		}
		TextWait
	TextEnd self
	Return
