	elif flag[273]:
		FlagUnset flag[273]
		FlagSet flag[0]
		Event fn[0,12]
	Return

fn[2]:
	if flag[1]:
		system[1] = 354
		FlagUnset flag[1]
	elif flag[0]:
		system[1] = 117
		FlagUnset flag[0]
	Return

