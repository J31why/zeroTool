	if flag[3519]:
		ED7_76_2 object[1] "Null_color00" "off_"
	if flag[3520]:
		ED7_76_2 object[2] "Null_color00" "off_"
	Call fn[0,4]
	TriggerFlagsSet trigger[0] 0x0080
	TriggerFlagsSet trigger[1] 0x0080
	if flag[3366] && !flag[3367]:
		TriggerFlagsUnset trigger[0] 0x0080
	if QuestFlagsGet quest[113] 0x02 && !QuestFlagsGet quest[113] 0x10 && !QuestFlagsGet quest[113] 0x40 && !flag[2715] && flag[2714]:
		TriggerFlagsUnset trigger[1] 0x0080
	char[6].55 = 4
	char[9].55 = 4
	char[11].55 = 4
	Return

