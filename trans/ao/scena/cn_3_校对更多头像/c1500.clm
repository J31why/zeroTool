	CharTurnTo name[2] 315deg 500deg/s
	TextTalk name[3] {
		#00305F#12P你該不會是卡塔吧？{wait}
	} {
		#00302F哈哈，你穿著那身白色軍服，
		我都認不出你了。{wait}
	} {
		你不是被發派到
		貝爾加德門嗎？{wait}
	}
	TextWait
	TextTalk char[90] {
		嗯，因為總統演說的關係，
		國界門也有好幾個人
		被調來支援警備工作。{wait}
	}
	TextWait
	TextTalk char[90] {
		羅金斯也在那邊
		巡邏喔。{wait}
	}
	TextWait
	TextTalk name[3] {
		#00302F#12P哈哈，原來是這樣。{wait}
	}
	TextWait
	TextTalk name[0] {
		#00000F#12P（他是……）{wait}
	}
	TextWait
	TextTalk name[1] {
		#00100F#6P（好像是蘭迪在警備隊時的
		　同袍。）{wait}
	}
	TextWait
	TextTalk char[90] {
		哎呀，話說回來，
		事情還真是不得了。{wait}
	}
	TextWait
	TextTalk char[90] {
		我們突然
		拿到這套軍服，
		一開始也是嚇了一跳。{wait}
	}
	TextWait
	TextTalk name[3] {
		#00306F#12P嗯，事情發生得太突然，
		讓人摸不著頭緒……{wait}
	} {
		#00300F仔細一想，包括這套軍服在內，
		一切都準備得太周到了。{wait}
	}
	TextWait
	TextTalk char[90] {
		總統一定是從很早之前
		就開始做準備了吧？{wait}
	}
	TextWait
	TextTalk char[90] {
		國防軍的裝備好像也
		可望獲得強化，
		我們得打起精神來才行。{wait}
	}
	TextWait
	TextTalk name[3] {
		#00305F#12P嗯，好吧……{wait}
	}
	TextWait
	TextTalk name[2] {
		#00201F#12P（……國防軍的士兵們
		　好像都相當樂見
		　這次的重新編組。）{wait}
	}
	TextWait
	TextTalk name[1] {
		#00106F#6P（跟其他國家的正規軍比起來，
		　他們的待遇確實比較不好，
		　是可以理解他們的心情，不過……）{wait}
	}
	TextWait
	TextTalk char[90] {
		順道一提，成了國防軍之後，
		我們也可以用一般軍隊的
		階級稱號了。{wait}
	}
	TextWait
	TextTalk char[90] {
		以前都叫一尉、二尉、三尉，
		現在改稱上尉、中尉、少尉了。{wait}
	}
	TextWait
	TextTalk char[90] {
		稱呼軍官的時候叫錯階級非常失禮，
		所以得要小心一點喔！{wait}
	}
	TextWait
	TextTalk name[3] {
		#00300F#12P嗯，謝謝忠告。{wait}
	} {
		#00303F也就是說，
		米蕾優原本是『三尉』……
		從今以後就變成『少尉』了吧？{wait}
	} {
		#00309F哈哈，捉弄她的材料又多了一個。{wait}
	}
	TextWait
	TextTalk name[0] {
		#00006F#12P喂喂喂……{wait}
	}
	TextWait
	TextTalk char[90] {
		呃，這個嘛……
		嗯，算是吧……{wait}
	}
	TextWait
	Emote name[0] 0mm 2000mm 0 1 250ms 2
