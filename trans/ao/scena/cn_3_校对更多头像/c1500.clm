	TextTalk name[4] {
		#6P#10300F……妳還好嗎？{wait}
	}
	TextWait
	TextTalk char[9] {
		#07903F……嗯，我沒事。
		不過……{wait}
	} {
		#07901F蘭迪之所以會失蹤，
		應該跟他的過去有關……
		對吧？{wait}
	}
	TextWait
	TextTalk name[0] {
		#6P#00008F這、這個嘛……{wait}
	}
	TextWait
	TextTalk char[9] {
		#07908F……雖然很不甘心，
		但我不是很瞭解
		蘭迪的過去。{wait}
	} {
		也不知道
		在實戰訓練的時候，
		他一直不使用步槍的原因。{wait}
	} {
		#07901F不過……我知道他這次的舉動，
		讓大家非常擔心他，
		真的是很笨的行為。{wait}
	}
	TextWait
	TextTalk name[8] {
		#6P#10108F米蕾優三尉……{wait}
	}
	TextWait
	TextTalk name[2] {
		#6P#00203F……的確，不只是笨，而是大笨蛋。{wait}
	}
	TextWait
	TextTalk char[9] {
		#07903F……警備隊也損失慘重。
		司令他們之後應該會
		再編組一支救援部隊。{wait}
	} {
		我們在接到命令前不能行動……
		更不能為了蘭迪一個人
		擅自出動。{wait}
	} {
		#07900F所以，各位……
		那個笨蛋就拜託你們了。{wait}
	}
	TextWait
	TextTalk name[0] {
		#6P#00000F……交給我們吧。
		我們一定會把蘭迪帶回來……！{wait}
	}
	TextWait
