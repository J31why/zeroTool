	}
	TextWait
	TextTalk name[1] {
		#6P#00108F那裡是叔叔發表獨立宣言的地方，
		這點防備是理所當然的吧？{wait}
	}
	TextWait
	Sleep 200ms
	Emote char[90] 0mm 2000mm 38 38 250ms 1
	Sleep 1000ms
	_Char4A char[90] 1
	TextTalk char[90] {
		咦？你……
