	EmoteStop char[9]
	TextTalk char[9] {
		#07901F……你們幾個。
		關於今天早上你們課長
		問我的事情……{wait}
	} {
		聽說蘭迪
		下落不明？{wait}
	}
	TextWait
	TextTalk name[0] {
		#6P#00003F……是的。{wait}
	} {
		#00001F根據推測，
		他恐怕是……
		去瑪因茲山道了吧？{wait}
	}
	TextWait
	TextTalk char[9] {
		#07908F……這樣啊……{wait}
	}
	TextWait
