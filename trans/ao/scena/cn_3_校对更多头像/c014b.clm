				}
				TextWait
				break
			case 6:
				TextTalk char[1] {
					#08100F核心迴路是
					鑲嵌在ＥＮＩＧＭＡⅡ中央的
					特殊結晶迴路。{wait}
				} {
					#08102F這跟舊型結晶迴路之間有個決定性的
