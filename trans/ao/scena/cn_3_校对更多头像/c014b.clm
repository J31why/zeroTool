					好像都會變得非常強大喔。{wait}
				} {
					#08103F再加上昇級似乎要花費
					非常多的時間……{wait}
				} {
					#08110F重點或許就在於不要三心二意，
					持續使用自己喜歡的核心迴路。{wait}
				}
				TextWait
				break
			default:
				var[3] = 255
				break
	Sleep 150ms
	var[3] = 0
	Return

