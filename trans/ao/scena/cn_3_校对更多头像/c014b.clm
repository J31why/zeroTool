			FadeIn 300ms 0x00000000
			_59
		switch var[3]:
			case 0:
				TextTalk char[1] {
					#08100F《戰術導力器》是特別設計，
					專供戰鬥使用的
					小型攜帶式導力器。{wait}
				} {
					#08102F不僅可以強化使用者的能力，
					還能輔助我們使用導力魔法。{wait}
				} {
					#08110F一般也常直接稱呼它為
					『導力器』。{wait}
				} {
					#08104F導力器可以完美地
					配合個人進行調整，所以
					構造也會依持有人而改變。{wait}
				} {
					#08100F有些插槽有限定屬性，
					連接插槽的線的形式也不太一樣。
					可以比較一下大家的導力器看看喔。{wait}
				}
				TextWait
				break
			case 1:
				TextTalk char[1] {
					#08100F結晶迴路是用耀晶石提煉而成的，
					是導力器專用的結晶狀迴路。{wait}
				} {
					#08102F只要提供迴路所需的耀晶石，
					我們就可以幫忙合成。{wait}
				} {
					#08100F不同的結晶迴路有不同的效果，
					屬性值累積到某個程度以上，
					就能使用導力魔法。{wait}
				} {
					#08110F蒐集到耀晶石之後，可以多方嘗試看看喔。{wait}
				}
				TextWait
				break
			case 2:
				TextTalk char[1] {
					#08100F導力器的插槽
					一開始幾乎都是未解鎖的狀態。{wait}
				} {
					#08104F所以安裝結晶迴路之前，
					需要進行插槽的解鎖。{wait}
				} {
					#08102F只要將插槽解鎖，
					就能安裝很多結晶迴路，
					ＥＰ上限也會提昇。{wait}
				} {
					#08110F解鎖時會需要使用耀晶石，
					不過早點解鎖是沒有壞處的喔。{wait}
				}
				TextWait
				break
			case 3:
				TextTalk char[1] {
					#08100F在結晶迴路中，
					有些被稱為『高階結晶迴路』。{wait}
				} {
					#08103F這些結晶迴路太過強大，
					沒辦法裝在一般的插槽裡。{wait}
				} {
					#08100F所以插槽本身
					必須經過強化才行。{wait}
				} {
					#08102F強化跟解鎖一樣都需要耀晶石，
					但也可以提高ＥＰ上限。{wait}
				} {
					#08110F我覺得是不需要急著強化啦，
					但強化可以說是提昇
					導力器威力不可或缺的要素。{wait}
				}
				TextWait
