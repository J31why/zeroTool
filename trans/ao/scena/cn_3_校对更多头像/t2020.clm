fn[5]:
	TextStart self
	if flag[2573]:
		if !flag[2636]:
			Call fn[0,12]
		else:
			TextTalk self {
				#07900F現在，索妮亞司令跟道格拉斯
				副司令正在討論恐攻對策。{wait}
			} {
				#07903F請不要去打擾他們喔。{wait}
			}
			TextWait
	elif flag[2564]:
		if !flag[2636]:
			Call fn[0,12]
		elif !flag[1]:
			TextTalk self {
				#07900F要找索妮亞司令的話，
				她今天在遊憩區米修拉姆
				指揮警備。{wait}
			} {
				#07903F因為是在迎賓館招待
				各國貴賓，所以那裡是
				最重要的警備地點。{wait}
			}
			TextWait
			TextTalk name[3] {
				#00305F也就是說，
				今天是由妳來代替司令
				指揮貝爾加德門的隊員啊。{wait}
			} {
				#00306F唉，就憑米蕾優
				真的有辦法代替
				那位索妮亞司令嗎？{wait}
			}
			TextWait
			CharTurnToChar self name[3] 500deg/s
			TextTalk self {
				#07901F沒、沒禮貌……！{wait}
			} {
				#07903F……哼，才不需要你來操心。
				前司令還在的時候，
				我就常常做類似的事情了。{wait}
			} {
				#07907F索妮亞司令不在的時候，
				我絕對會保護大家給你看！{wait}
			}
			TextWait
			TextTalk name[3] {
				#00309F哈哈，有這種氣勢應該就沒問題了吧。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				#07903F前司令還在的時候，
				我經常被任命為代理，
				負責國界門的指揮。{wait}
			} {
				#07901F索妮亞司令不在的時候，
				我絕對會保護大家給你看！{wait}
			}
			TextWait
	elif flag[2560]:
		if !flag[2636]:
			Call fn[0,12]
		elif !flag[1]:
			TextTalk self {
				#07904F不、不過，
				先不提我晉升的事……{wait}
			} {
				#07900F為了迎接通商會議，
				國界門也會加強警戒。{wait}
			} {
				請你們留意，
				不要跟旅客
				發生糾紛喔。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				#07900F為了迎接通商會議，
				國界門也會加強警戒。{wait}
			} {
				請你們留意，
				不要跟旅客
				發生糾紛喔。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[6]:
	TextStart self
	if flag[3074]:
	elif flag[2861]:
	elif flag[2848]:
	elif flag[2832]:
		if !flag[1]:
			TextTalk self {
				#07900F啊，你們……{wait}
			} {
				在來貝爾加德門的路上，
				沒有碰到什麼危險的狀況？{wait}
			}
			TextWait
			TextTalk name[0] {
				#00005F咦……？{wait}
			}
			TextWait
			TextTalk name[3] {
				#00305F跟平常差不多，應該
				沒什麼不一樣的地方吧。{wait}
			}
			TextWait
			TextTalk self {
				#07900F這樣啊……{wait}
			} {
				#07903F……看來今天似乎是
				不會出現了吧。{wait}
			}
			TextWait
			Emote field_party[0] 0mm 2000mm 0 1 250ms 2
			SoundPlay sound[29] 0 100 0
			Emote field_party[1] 0mm 2000mm 0 1 250ms 2
			SoundPlay sound[29] 0 100 0
			Emote field_party[2] 0mm 2000mm 0 1 250ms 2
			SoundPlay sound[29] 0 100 0
			Emote field_party[3] 0mm 2000mm 0 1 250ms 2
			SoundPlay sound[29] 0 100 0
			Sleep 1000ms
			TextTalk self {
				#07900F不，別放在心上。
				畢竟這是我們的工作。{wait}
			} {
				#07903F不過，如果搞不好的話，
				我最近有可能會找你們
				商量這件事就是了……{wait}
			}
			TextWait
			TextTalk name[3] {
				#00303F嗯，雖然不太清楚，不過……
				需要幫助的話，隨時都可以來找我們。{wait}
			}
			TextWait
			TextTalk self {
				#07902F沒問題，到時還請多多指教。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				#07903F……看來今天似乎是
				不會出現了吧……{wait}
			} {
				#07901F總之，目前要全力對抗
				兩大國的緊張狀態才行呢。{wait}
			}
			TextWait
	elif flag[2816]:
		if !flag[2900]:
			TextTalk name[3] {
				#00309F嗨！米蕾優准尉。
				最近過得好嗎？{wait}
			}
			TextWait
			CharTurnToChar self name[3] 500deg/s
			TextTalk self {
				#07901F……你啊，
				你是故意的吧？{wait}
			} {
				#07906F之前明明才說過
				我已經晉升到三尉的事情……
				真是的。{wait}
			}
			TextWait
			TextTalk name[8] {
				#10109F啊哈哈……無論如何，
				恭喜妳晉升。{wait}
			}
			TextWait
			CharTurnToChar self name[8] 500deg/s
			TextTalk self {
				#07909F呵呵，謝謝妳，上士。{wait}
			} {
				#07903F雖然我很感激能夠晉升，不過……
				背負的責任也變得
				越來越大了吧。{wait}
			} {
				#07901F今後必須精益求精、
				加倍努力才行呢。{wait}
			}
			TextWait
			TextTalk name[3] {
				#00306F傷腦筋，妳還是老樣子，
				總是認真過度呢。{wait}
			} {
				#00302F只知道努力的話，遲早會累壞喔。
				隨便敷衍一下就行了啦，要敷衍喔。{wait}
			}
			TextWait
			CharTurnToChar self name[3] 500deg/s
			Emote self 0mm 2000mm 12 13 250ms 2
			SoundPlay sound[23] 0 100 0
			Sleep 1000ms
			TextTalk self {
				#07901F難得人家在說
				這麼正經的事情……
				蘭迪你這個笨蛋！{wait}
			}
			TextWait
			TextTalk name[8] {
				#10112F啊、啊哈哈……
				（就算晉升了，她也還是老樣子呢……）{wait}
			}
			TextWait
			FlagSet flag[2900]
			CharTurnTo self 180deg 0deg/s
		elif !flag[2901]:
			TextTalk name[3] {
				#00300F喔，對了……
				慶祝妳晉升送的那個禮物，
				妳有戴上嗎？{wait}
			} {
				就是我在米修拉姆珠寶店
				買的那個啊。{wait}
			}
			TextWait
			if !flag[2769]:
				TextTalk name[0] {
					#00005F哦……
					你有送她禮物啊？{wait}
				}
				TextWait
			else:
				TextTalk name[0] {
					#00002F嗯……這麼說來，
					你買的好像是胸針對吧？{wait}
				}
				TextWait
			CharTurnToChar self name[3] 500deg/s
			TextTalk self {
				#07906F我說你呀……
				當然不可能戴啊。{wait}
			} {
				#07900F身為警備隊的軍官，
				當然不能表現得那麼輕浮，
				所以我有妥善收藏起來……{wait}
			}
			TextWait
			Emote self 0mm 2000mm 2 7 80ms 1
			SoundPlay sound[28] 0 100 0
			Sleep 1000ms
			Emote self 0mm 2000mm 40 43 100ms 0
			Sleep 1000ms
			EmoteStop self
			TextTalk self {
				#07911F不、不對……不是這樣的！
				我才沒有妥善收藏呢！{wait}
			} {
				#07909F沒、沒錯！我很粗魯地把它丟到
				櫃子裡面的最裡面去了……！{wait}
			}
			TextWait
			TextTalk name[3] {
				#00309F哇哈哈，別害羞啦。{wait}
			}
			TextWait
			TextTalk name[2] {
				#00204F（……這場面好溫馨。）{wait}
			}
			TextWait
			FlagSet flag[2901]
			CharTurnTo self 180deg 0deg/s
		else:
			TextTalk self {
				#07902F嗯、嗯哼，總之……
				既然已經晉升了，
				我當然會比之前更加努力喔。{wait}
			} {
				#07903F為了多少能夠幫上司令的忙，
				我也得精益求精、加倍努力才行。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[7]:
	Call fn[0,8]
	Return

fn[8]:
	TextStart char[2]
	if flag[3074]:
		name[8].5 = char[2].4
		char[2].5 = char[2].4
		CharFlagsUnset char[2] 0x0010
		CharTurnToChar char[2] name[8] 0deg/s
		char[2].4 = (char[2].4 + 360) % 360
		char[2].4 = char[2].4 + 360 - char[2].5
		char[2].5 = char[2].4 / 180
		if char[2].4 <= 45 | char[2].4 >= 315 && char[2].4 <= 405 | char[2].4 >= 675:
		elif char[2].5 < 1:
			char[2].8 = 2
		elif char[2].5 > 2:
			char[2].8 = 1
		else:
			char[2].8 = char[2].5
		char[2].4 = name[8].5
		name[8].5 = 0
		char[2].5 = 0
		CharFlagsSet char[2] 0x0010
		if !flag[2]:
			TextTalk char[2] {
				#02008F…………{wait}
			}
			TextWait
			TextTalk name[0] {
				#00001F索妮亞司令……
				妳有什麼煩惱嗎？{wait}
			}
			TextWait
			TextTalk char[2] {
				#02003F……關於警備隊的編組，我有點煩惱。{wait}
			} {
				#02000F警備隊在瑪因茲山道嚴重受創，
				要復原成原本的狀態，
				一定需要很多時間吧。{wait}
			}
			TextWait
			TextTalk name[1] {
				#00108F果然是這樣啊……{wait}
			}
			TextWait
			TextTalk name[8] {
				#10108F…………{wait}
			}
			TextWait
			TextTalk char[2] {
				#02000F……諾艾兒上士。
				妳看起來悶悶不樂呢。{wait}
			} {
				#02003F妳在後悔做了
				回到警備隊的決定嗎？{wait}
			}
			TextWait
			TextTalk name[8] {
				#10103F……不、沒有這回事。{wait}
			} {
				#10108F只是，支援課明明也很忙碌卻只有我一個人離開，
				我覺得有點不忍心……{wait}
			}
			TextWait
			TextTalk name[0] {
				#00003F諾艾兒……{wait}
			}
			TextWait
			TextTalk char[2] {
				#02003F……為了重建警備隊，
				我非常需要妳的力量，不過……{wait}
			} {
				#02000F妳要放棄回到警備隊嗎？{wait}
			}
			TextWait
			TextTalk name[8] {
				#10103F不……
				畢竟是我自己決定的事。{wait}
			} {
				#10101F諾艾兒・希卡，
				本日任務結束後，
				就會回到警備隊！{wait}
			}
			TextWait
			TextTalk char[2] {
				#02004F很好。{wait}
			} {
				#02000F不過，現在的妳當然還是
				調派到支援課的身分。{wait}
			} {
				別讓自己留下遺憾，把剩下的工作
				全部處理完畢再回來。
				……沒問題吧？{wait}
			}
			TextWait
