fn[104]:
	EventBegin 1
	if !flag[18]:
		TextTalk name[161] {
			這邊是東側大道嗎？{wait}
		}
		TextWait
		TextTalk name[0] {
			#00000F不，不是……{wait}
		}
		TextWait
		Emote name[161] 0mm 1700mm 12 13 250ms 2
		SoundPlay sound[23] 0 100 0
		Sleep 1000ms
		TextTalk name[161] {
			我就知道。{wait}
		}
		TextWait
		TextTalk name[161] {
			……我記得我有說，
			要從東側大道過去。{wait}
		}
		TextWait
		TextTalk name[0] {
			#00006F是沒錯……真抱歉。{wait}
		}
		TextWait
		FlagSet flag[18]
	else:
		TextTalk name[161] {
			喂，順道去一些地方是無所謂，
			但我可不想繞遠路啊。{wait}
		}
		TextWait
		TextTalk name[161] {
			快點帶我去東側大道。{wait}
		}
		TextWait
	CharSetPos field_party[0] (-28110, 2000, 23520) 90deg
	EventEnd 4
	Return

fn[105]:
	if !flag[2837] && flag[2832] && QuestFlagsGet quest[134] 0x02 && !QuestFlagsGet quest[134] 0x10 && !QuestFlagsGet quest[134] 0x40:
		EventBegin 1
		TextTalk name[0] {
			#00003F（一旦到了米修拉姆，
			　除非有什麼其他狀況，
			　不然接下委託好像會比較好。）{wait}
		} {
			（就這樣直接過去嗎……？）{wait}
		}
		TextWait
		Call fn[0,94]
	else:
		EventBegin 2
		SystemFlagsUnset 0x00000020
		TextSetPos -1 -1 -1 -1
		TextSetName ""
		TextMessage null {
			{color 5}往《米修拉姆》的水上巴士・時刻表

			※米修拉姆最引以為傲的主題樂園
			『奇幻樂園』營業中！
			　敬請享受歡樂時光！{color 0}{wait}
		}
		TextWait
		TextClose 0
		_59
		EventEnd 3
	Return

fn[106]:
	EventBegin 2
	SystemFlagsUnset 0x00000020
	TextSetPos -1 -1 -1 -1
	TextSetName ""
	TextMessage null {
		{color 5}　《羽扇河・第一燈塔》

		非相關人士請勿進入。
		　　　　　～克洛斯貝爾市～{color 0}{wait}
	}
	TextWait
	TextClose 0
	_59
	EventEnd 3
	Return
