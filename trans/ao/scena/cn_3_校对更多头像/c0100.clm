		追蹤某個人……{wait}
	} {
		#00001F剛才有沒有一輛萊恩福爾特公司製的
		黑色運輸車經過這裡？{wait}
	}
	TextWait
	TextTalk char[12] {
		#14503F黑色運輸車……？{wait}
	} {
		#14505F喔，這麼說來，不久之前
		好像有一輛那樣的車子經過。{wait}
	} {
		#14501F我記得應該是
		往東側大道的方向開走了。{wait}
	}
	TextWait
	Emote name[0] 0mm 2000mm 38 38 250ms 1
	Emote name[1] 0mm 2000mm 38 38 250ms 1
	Sleep 50ms
