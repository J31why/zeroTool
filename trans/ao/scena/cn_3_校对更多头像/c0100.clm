fn[24]:
	switch random % 8:
		case 0:
			Sleep 100ms
			break
		case 1:
			Sleep 200ms
			break
		case 2:
			Sleep 300ms
			break
		case 3:
			Sleep 400ms
			break
		case 4:
			Sleep 500ms
			break
		case 5:
			Sleep 600ms
			break
		case 6:
			Sleep 700ms
			break
		default:
			Sleep 800ms
			break
	while 1:
		Emote self 0mm 2000mm 38 39 250ms 2
		Sleep 1000ms
		EmoteStop self
		Sleep 500ms
	Return

