fn[2]:
	if system[4] >= 5:
		EntranceSetDisabled entrance[0] 0
		EntranceSetDisabled entrance[5] 1
	else:
		EntranceSetDisabled entrance[0] 1
		EntranceSetDisabled entrance[5] 0
	if flag[3328]:
		TriggerFlagsSet trigger[0] 0x0080
	if flag[2848] && !flag[2858] | flag[2369] && system[4] == 1:
		ED7_76_0 object[255] "light1" 1
		ED7_76_0 object[255] "light0" 1
