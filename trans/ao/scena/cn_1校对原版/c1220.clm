				"報告採訪內容" // 1
				"放棄" // 2
			MenuWait var[0]
			MenuClose menu[0]
			TextClose 0
			TextSetPos -1 280 60 3
			FadeIn 300ms 0x00000000
			FadeWait
			if var[0] == 2:
				TextEnd char[0]
				Return
			elif var[0] == 1:
				var[2] = 0
				if flag[2961]:
					var[2] += 1
				if flag[2962]:
					var[2] += 1
				if flag[2963]:
					var[2] += 1
				if flag[2964]:
