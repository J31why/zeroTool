	TextStart char[0]
	if flag[6]:
		if !QuestFlagsGet quest[128] 0x10:
			TextTalk char[0] {
				各位，美食導覽的採訪
				要請你們多多努力了。{wait}
			}
			TextWait
			TextTalk char[0] {
				難得過程中可以吃到美味的食物，
				各位就請樂在其中，
				努力地採訪吧。{wait}
			}
			TextWait
		else:
			TextTalk char[0] {
				各位，真是辛苦你們了。{wait}
			}
			TextWait
			TextTalk char[0] {
				要是還有其他委託要麻煩各位，
