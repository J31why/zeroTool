				TextTalk char[0] {
					特務支援課的各位……
					各位是不是接到敝社的委託
					所以才前來這裡的？{wait}
				}
				TextWait
				TextTalk char[0] {
					其實，負責人現在
					正因為去採訪脫軌意外而外出……{wait}
				}
				TextWait
				TextTalk char[0] {
					真的非常抱歉，
					請各位改天再來一趟。{wait}
				}
				TextWait
				FlagSet flag[0]
			elif flag[2842]:
				TextTalk char[0] {
