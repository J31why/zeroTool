							"《龍宮》輝夜" // 2
							"《水狂》納西斯" // 3
							"《海刃》沙克曼" // 4
							"取消" // 5
						MenuWait var[0]
						MenuClose menu[0]
						if var[0] == 0:
							TextTalk char[1] {
								想挑戰名副其實君臨
