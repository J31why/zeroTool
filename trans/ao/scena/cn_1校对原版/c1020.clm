fn[5]:
	TextStart char[1]
	FlagUnset flag[2]
	if !flag[3089]:
		if !flag[3586] && !flag[3584]:
			FlagSet flag[2]
		if flag[3209]:
			FlagSet flag[2]
	var[0] = 99
	while var[0] == 99:
		if !flag[2]:
			if !flag[3089]:
				Menu menu[0] -1 -1 1
					"交談" // 0
					"聽爆釣比賽的說明" // 1
					"放棄" // 2
				MenuWait var[0]
				MenuClose menu[0]
			else:
				FadeOut 300ms 0x00000000 100
				Menu menu[0] -1 -1 1
					"交談" // 0
					"買東西" // 1
					"放棄" // 2
				MenuWait var[0]
				if var[0] != 1:
					MenuClose menu[0]
					FadeIn 300ms 0x00000000
					FadeWait
				else:
					var[0] = 3
		else:
			var[0] = 0
		if var[0] == 3:
			if !flag[3205]:
				ShopOpen shop[54]
			else:
				ShopOpen shop[55]
			var[0] = 99
		elif var[0] == 1:
			var[0] = 99
			while var[0] == 99:
				Menu menu[0] -1 -1 1
					"關於勝負的判定方式" // 0
					"關於挑戰所需的資格" // 1
					"關於釣皇四天王的所在地" // 2
					"放棄" // 3
				MenuWait var[0]
				MenuClose menu[0]
				if var[0] == 0:
					TextTalk char[1] {
						約定就是只要能在爆釣比賽中獲勝……
						就可以奪回這間事務所，
						並且可以任意下達一道命令。{wait}
					}
