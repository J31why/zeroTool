fn[8]:
	TextStart char[0]
	if flag[3385]:
		if !flag[1]:
			TextTalkNamed char[0] "士兵柯納斯" {
				架在國界上的橋，目前
				雖然還無法使用，不過
				已經加強對帝國軍的警戒了。{wait}
			}
			TextWait
			TextTalkNamed char[0] "士兵柯納斯" {
				他們如果想攻打過來的話，
				坍塌的橋這種小意思，
				應該馬上就能修復吧。{wait}
			}
			TextWait
			TextTalkNamed char[0] "士兵柯納斯" {
				不知是幸還是不幸，
				帝國正在內戰中……我們也得
				趁現在做好準備才行。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalkNamed char[0] "士兵柯納斯" {
				帝國軍如果想攻打過來的話，
				坍塌的橋這種小意思，
				應該馬上就能修復吧。{wait}
			}
			TextWait
			TextTalkNamed char[0] "士兵柯納斯" {
				不知是幸還是不幸，
				帝國正在內戰中……我們也得
				趁現在做好準備才行。{wait}
			}
			TextWait
	elif flag[3074]:
		TextTalk char[0] {
			有鑑於最近的緊張狀態，
			離開克洛斯貝爾的
			外國人也不在少數。{wait}
		}
		TextWait
		TextTalk char[0] {
			就算不是這樣，
			最近也一直發生危險的事件……
			這也無可奈何呢。{wait}
		}
		TextWait
	elif flag[2848]:
		if !flag[1]:
			TextTalk char[0] {
				昨天，米蕾優三尉率領的部隊
				似乎目擊了巨大的怪物。{wait}
			}
			TextWait
			TextTalk char[0] {
				為了警戒逃走的怪物，似乎
				暫時要以一個中隊的兵力
				在自治州內巡邏。{wait}
			}
			TextWait
			TextTalk char[0] {
				傷腦筋……
				在緊張狀態持續的狀況下
				越來越忙了呢。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk char[0] {
				為了警戒逃走的怪物，似乎
				暫時要以一個中隊的兵力
				在自治州內巡邏。{wait}
			}
			TextWait
			TextTalk char[0] {
				傷腦筋……
				在緊張狀態持續的狀況下
				越來越忙了呢。{wait}
			}
			TextWait
	elif flag[2832]:
