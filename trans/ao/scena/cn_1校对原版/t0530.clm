fn[7]:
	TextStart self
	if flag[3074]:
		if !flag[2]:
			TextTalk name[0] {
				#00000F哈羅德先生……
				你來到瑪因茲了啊。{wait}
			}
			TextWait
			TextTalk char[2] {
				#03600F嗯，我把從阿爾摩利卡
				那邊買進的
				農產送來這裡。{wait}
			} {
				#03603F……受到襲擊的那場惡夢
				似乎使鎮裡的人最近
				日子過得很不安。{wait}
			} {
				#03608F雖然沒有人犧牲，
				但襲擊的爪痕
				確實留在人們心中……{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			TextTalk char[2] {
				#03603F雖然像我這樣的商人
				幫不上什麼忙……{wait}
			} {
				#03600F還是希望大家能
				恢復活力。{wait}
			}
			TextWait
	elif flag[2564]:
		if !flag[3]:
			Call fn[0,6]
		else:
			TextTalk char[2] {
				#03609F哈哈……
				小孩子還是
				有精神最好了。{wait}
			}
			TextWait
	TextEnd self
	Return
