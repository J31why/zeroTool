					}
					TextWait
					TextTalk char[0] {
						我不能再讓琦咪
						蒙羞了。
						必須小心別再犯。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[0] {
						不久前，我曾經因為
						太擔心琦咪，忍不住闖進
						主日學校上課的教室。{wait}
					}
					TextWait
					TextTalk char[0] {
						我不能再讓琦咪
						蒙羞了。
						必須小心別再犯。{wait}
					}
					TextWait
			elif flag[2564]:
				if !flag[0]:
					TextTalk char[0] {
						喔，哈羅德那小子
						好像來了。{wait}
					}
					TextWait
					TextTalk char[0] {
						上次進的食材
