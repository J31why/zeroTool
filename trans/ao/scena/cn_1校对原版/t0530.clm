					}
					TextWait
			elif flag[2560]:
				if !flag[0]:
					TextTalk char[0] {
						畢竟我沒啥學問。
						不懂複雜的事，但……{wait}
					}
					TextWait
					TextTalk char[0] {
						所謂的通商會議，
						簡單說就是一些聰明的傢伙
