fn[4]:
	TextStart char[0]
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"交談" // 0
			"買東西" // 1
			"放棄" // 2
		MenuWait var[0]
		if var[0] != 1:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			if flag[3328]:
				ShopOpen shop[88]
			elif flag[2816]:
				ShopOpen shop[87]
			elif flag[2560]:
				ShopOpen shop[86]
			else:
				ShopOpen shop[85]
			var[0] = 99
		elif var[0] == 2:
		elif var[0] != 0:
			TextEnd char[0]
			Return
		elif var[0] == 0:
			var[0] = 99
			if flag[3385]:
				if !flag[0]:
					TextTalk char[0] {
						礦山是瑪因茲居民
						不可妥協的尊嚴。{wait}
					}
					TextWait
					TextTalk char[0] {
						不論陷入什麼樣的異常狀況，
						只要不忘尊嚴，
						一定能越過難關。{wait}
					}
					TextWait
					TextTalk char[0] {
						一定也有些事對你們來說
						是不可妥協的。
						絕對別忘了。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[0] {
						不論陷入什麼樣的異常狀況，
						只要不忘尊嚴，
						一定能越過難關。{wait}
					}
					TextWait
					TextTalk char[0] {
						一定也有些事對你們來說
						是不可妥協的。
						絕對別忘了。{wait}
					}
					TextWait
			elif flag[3362]:
				if !flag[0]:
					TextTalk char[0] {
						我沒什麼學問，
						不太懂什麼
						無效宣言的……{wait}
					}
					TextWait
					TextTalk char[0] {
						真希望早點
						成為讓琦咪和小孩子們
						能夠安心生活的世界。{wait}
					}
					TextWait
					TextTalk char[0] {
						……但為此，把危險的事情
						都交給反抗軍做，
						說來很慚愧就是了。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[0] {
						雖然把危險的事都交給反抗軍，
						說來很慚愧，不過……{wait}
					}
					TextWait
					TextTalk char[0] {
						為了早點讓琦咪和小孩子們
						過安心的生活，
						希望他們能努力。{wait}
					}
					TextWait
			elif flag[3328]:
				if !flag[0]:
					TextTalk char[0] {
						聽說那群獵兵在開始
						獵反抗軍之前，還到
						鎮長的家打招呼。{wait}
					}
					TextWait
					TextTalk char[0] {
						據說他們很高姿態，
						還故意說什麼『請注意，
						別離開城鎮』。{wait}
					}
					TextWait
					TextTalk char[0] {
						用意八成是牽制
						協助反抗軍的我們……{wait}
					}
					TextWait
					TextTalk char[0] {
						嘖，要是我當時在場，
						就會揍那傢伙一拳，
						回報占領事件時的仇。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[0] {
						一問之下，那群獵兵似乎還在山道的
						隧道裡安裝了地雷啊。{wait}
					}
					TextWait
					TextTalk char[0] {
						嘖，要是我當時在場
						絕對會揍他。{wait}
					}
					TextWait
			elif flag[3074]:
				if !flag[0]:
					TextTalk char[0] {
						因為被獵兵占領，
						瑪因茲的傢伙們
						還在消沉。{wait}
					}
					TextWait
					TextTalk char[0] {
						我也是當事人，
						所以可以理解那種心情……
						但一直消沉下去也不是辦法。{wait}
					}
					TextWait
					TextTalk char[0] {
						總之，像我和礦工這種傢伙，
						有活力是唯一的長處，
						必須鼓勵大家才行。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[0] {
						那群獵兵很可怕……
						但一直消沉下去也不是辦法。{wait}
					}
					TextWait
					TextTalk char[0] {
						像我和礦工這種傢伙，
						有活力是唯一的長處，
						必須鼓勵大家才行。{wait}
					}
					TextWait
			elif flag[2848]:
				TextTalk char[0] {
					我腿負傷，
					辭去礦工工作
					也是在這樣的雨天。{wait}
				}
				TextWait
				TextTalk char[0] {
					……舊傷在發疼了。{wait}
				}
				TextWait
			elif flag[2832]:
				if !flag[0]:
					TextTalk char[0] {
						琦咪今天似乎去找
