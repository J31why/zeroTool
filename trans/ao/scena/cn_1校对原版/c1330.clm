calmare ao_k scena
scena:
	name "c1330" "c1330" "c1330"
	town town[27]
	bgm bgm[150]
	flags 8192
	item_use fn[0,255]
	unk 255 0

entry:
	pos (0, 0, -1000)
	unk1 0
	cam_from (0, 0, 24000)
	cam_pers 500
	unk2 30
	cam_deg 45deg
	cam_limit 0deg 360deg
	cam_at (0, 0, 0)
	unk3 0
	unk4 0
	flags 0x0001
	town town[27]
	init fn[0,0]
	reinit fn[0,1]

fn[0]:
	Event fn[0,2]
	Return

fn[1]:
	Return

fn[2]:
	EventBegin 1
	FadeOut 0ms 0x00000000 255
	CamSetDistance 600 1000 0 0ms
	ED7CamRotate 45deg 23deg 0deg 0ms
	CamPers 500 0ms
	CamZoom 19000 0ms
	CharSetPos field_party[0] (2200, 0, 0) 90deg
	if system[11] != 255:
		CharSetPos field_party[1] (500, 0, -500) 90deg
	if system[12] != 255:
		CharSetPos field_party[2] (500, 0, 500) 90deg
	if system[13] != 255:
		CharSetPos field_party[3] (-700, 0, 0) 90deg
	if system[14] != 255:
		CharSetPos field_party[4] (-1900, 0, -600) 90deg
	if system[15] != 255:
		CharSetPos field_party[5] (-1900, 0, 600) 90deg
	FadeIn 500ms 0x00000000
	FadeWait
	var[0] = 0
	if system[0] == 101:
		Menu menu[0] 10 10 0
			"★【１６Ｆ】" // 0
			"　【 １Ｆ 】" // 1
			"　【 Ｂ５ 】" // 2
			"　【離開】" // 3
		var[2] = 0
	elif system[0] == 100:
		Menu menu[0] 10 10 0
			"　【１６Ｆ】" // 0
			"★【 １Ｆ 】" // 1
			"　【 Ｂ５ 】" // 2
			"　【離開】" // 3
		var[2] = 1
	elif system[0] == 102:
		Menu menu[0] 10 10 0
			"　【１６Ｆ】" // 0
			"　【 １Ｆ 】" // 1
			"★【 Ｂ５ 】" // 2
			"　【離開】" // 3
		var[2] = 2
	MenuWait var[0]
	MenuClose menu[0]
	TextClose 0
	if var[0] == 3:
		FadeOut 500ms 0x00000000 255
		FadeWait
	elif var[2] < var[0]:
		FadeOut 2000ms 0x00000000 255
		SoundPlay sound[159] 0 100 0
		CamSetDistance 600 16000 0 2000ms
		FadeWait
		CamWait 1
		Sleep 800ms
		SoundStop sound[103]
	elif var[2] > var[0]:
		FadeOut 2000ms 0x00000000 255
		SoundPlay sound[159] 0 100 0
		CamSetDistance 600 -14000 0 2000ms
		FadeWait
		CamWait 1
		Sleep 800ms
		SoundStop sound[103]
	else:
		FadeOut 500ms 0x00000000 255
		FadeWait
	if var[0] == 3:
		switch var[2]:
			case 0:
				EventEnd 5
				NewScene "scena/c1340.bin" 100 0 0
				Hcf
				break
			case 1:
				EventEnd 5
				NewScene "scena/c1310.bin" 101 0 0
				Hcf
				break
			case 2:
				EventEnd 5
				NewScene "scena/c1320.bin" 102 0 0
				Hcf
				break
	else:
		switch var[0]:
			case 0:
				FlagSet flag[297]
				Sleep 500ms
				EventEnd 5
				NewScene "scena/c1340.bin" 100 0 0
				Hcf
				break
			case 1:
				FlagSet flag[297]
				Sleep 500ms
				EventEnd 5
				NewScene "scena/c1310.bin" 101 0 0
				Hcf
				break
			case 2:
				FlagSet flag[297]
				Sleep 500ms
				EventEnd 5
				NewScene "scena/c1320.bin" 102 0 0
				Hcf
				break
	Return
