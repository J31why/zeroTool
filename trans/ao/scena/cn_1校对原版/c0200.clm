	CharFlags2Unset field_party[4] 0x8000
	CharFlagsUnset field_party[5] 0x0080
	CharFlags2Unset field_party[5] 0x8000
	FadeWait
	Sleep 300ms
	TextTalk name[2] {
		#1420020007V#00206F#12P這麼說來……{wait}
	} {
		#1420020008V#00200F今天是最後一次
		坐諾艾兒小姐開的車了吧？{wait}
	}
	TextWait
	Fork name[8] fork[1]:
		CharTurnTo name[8] 179deg 500deg/s
	Sleep 400ms
	TextTalk name[0] {
		#1420000011V#12P#00006F這樣啊……說的也是。{wait}
	}
	TextWait
	TextTalk name[8] {
		#1420050025V#10112F#5P啊哈哈……
		我也覺得很可惜。{wait}
	} {
		#1420050026V其實我自己也
		很喜歡這孩子#2R這台車#。{wait}
	} {
		#1420050027V#10100F不過，羅伊德你們
		也已經很會開車了吧？{wait}
	}
	TextWait
	TextTalk name[0] {
		#1420000012V#12P#00004F嗯，在休假之類的時候
		被諾艾兒訓練過了嘛。{wait}
	}
	TextWait
	TextTalk name[1] {
		#1420010009V#6P#00109F呵呵！諾艾兒的教法
		簡單易懂，真的很感謝妳喔。{wait}
	}
	TextWait
	TextTalk name[4] {
		#1420040006V#6P#10306F嗯，不過
		那算是斯巴達教育吧？{wait}
	} {
		#1420040007V#10302F與其稱妳為上士，
		不如說是魔鬼班長吧？{wait}
	}
	TextWait
	Emote name[8] 0mm 2000mm 40 43 100ms 3
	CharTurnToChar name[8] name[4] 500deg/s
	Sleep 300ms
	TextTalk name[8] {
