	} {
		#1420050029V#10106F只要認真學，一定學得會，
		你卻連交通規則都不肯背。{wait}
	}
	TextWait
	TextTalk name[3] {
		#1420030010V#00304F#11P嗯，能夠嚴厲指導學員，
		也是軍人必備的資質嘛。{wait}
	} {
		#1420030011V#00300F總之，今天就來好好享受
		專業駕駛開的車吧。{wait}
	}
	TextWait
	TextTalk name[0] {
		#1420000013V#12P#00002F是啊，
		諾艾兒，拜託妳了。{wait}
	}
	TextWait
	CharTurnToChar name[8] name[0] 500deg/s
	TextTalk name[8] {
		#1420050030V#10109F#5P是！包在我身上！{wait}
	}
