	Hcf
	Return

fn[54]:
	if flag[2353] && !flag[2357]:
		EventBegin 1
		TextTalk name[0] {
			#00000F前面是西克洛斯貝爾街道吧。{wait}
		} {
			那裡有通緝魔獸，不過……
			先完成市內的工作吧。{wait}
		}
		TextWait
		CharSetPos field_party[0] (-34230, 0, 4210) 90deg
		EventEnd 4
		Return
	if flag[2369] && !flag[2560]:
		EventBegin 1
		if !flag[9]:
			TextTalk name[0] {
				#00000F前面是西克洛斯貝爾街道吧。{wait}
			} {
				反正也沒什麼事要辦，
				還是別去了吧。{wait}
			}
			TextWait
			FlagSet flag[9]
		else:
			TextTalk name[0] {
				#00000F這邊沒有事情要處理。
				還是別去了吧。{wait}
			}
			TextWait
		CharSetPos field_party[0] (-34230, 0, 4210) 90deg
		EventEnd 4
		Return
	if flag[2861] && !flag[3074]:
		EventBegin 1
		TextTalk name[0] {
			#00001F現在最要緊的事情，
			就是要追上蘭迪──
			這可不是走岔路的時候。{wait}
		}
		TextWait
		CharSetPos field_party[0] (-34230, 0, 4210) 90deg
		EventEnd 4
		Return
	if flag[3089] && !flag[3100]:
		EventBegin 1
		TextTalk name[0] {
			#00001F現在不是到市外的時候。
			還是先回頭吧。{wait}
		}
		TextWait
		CharSetPos field_party[0] (-34230, 0, 4210) 90deg
		EventEnd 4
		Return
	if flag[3371] && !flag[3385]:
		EventBegin 1
		TextTalk name[0] {
			#00001F都到這地步了，
			可不能隨便離開市內。{wait}
		} {
			蘭花塔闖入作戰──
			只許成功，不許失敗。{wait}
		}
		TextWait
		CharSetPos field_party[0] (-34230, 0, 4210) 90deg
		EventEnd 4
		Return
	Return

fn[55]:
	TextStart null
	SoundPlay sound[807] 0 100 0
	if !flag[10]:
		TextTalk name[0] {
			#00000F門似乎從裡面
			被鎖上了。{wait}
		} {
			要從正面入口進去嗎？{wait}
		}
		TextWait
		FlagSet flag[10]
	else:
		TextSetName ""
		TextMessage null {
			{color 5}門上鎖了。
			看樣子是從裡面
			被鎖上的。{color 0}{wait}
		}
		TextWait
		TextClose 0
		_59
		TextSetPos -1 280 60 3
	TextEnd null
	Return
