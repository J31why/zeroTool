				CharTurnToChar name[3] name[9] 500deg/s
			Sleep 50ms
			Fork custom[0] fork[0]:
				CharTurnToChar custom[0] name[9] 500deg/s
			Sleep 50ms
			Fork custom[1] fork[0]:
				CharTurnToChar custom[1] name[9] 500deg/s
			ForkWait name[1] fork[0]
			ForkWait name[2] fork[0]
			ForkWait name[0] fork[0]
			ForkWait name[3] fork[0]
			ForkWait custom[0] fork[0]
			ForkWait custom[1] fork[0]
			TextTalk name[1] {
				#1530010022V#12P#00108F這、這麼說來……{wait}
			}
			TextWait
			if PartyPosition name[8] > -1:
				TextTalk name[8] {
					#1530050017V#6P#10106F賽爾蓋課長確實
					有這麼說過……{wait}
				}
				TextWait
			TextTalk name[2] {
				#1530020028V#00211F……還真是諷刺啊。{wait}
			}
			TextWait
	else:
		TextTalk name[8] {
			#1530050018V#6P#10104F太好了……總算可以放心了。{wait}
		} {
			#1530050019V#10105F……說起來，
			這台車是迪塔市長
			特別通融才拿到的，是吧？{wait}
		}
		TextWait
