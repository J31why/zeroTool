				CharTurnToChar custom[0] name[4] 500deg/s
			Sleep 50ms
			Fork custom[1] fork[0]:
				CharTurnToChar custom[1] name[4] 500deg/s
			ForkWait name[1] fork[0]
			ForkWait name[2] fork[0]
			ForkWait name[0] fork[0]
			ForkWait name[3] fork[0]
			ForkWait custom[0] fork[0]
			ForkWait custom[1] fork[0]
			TextTalk name[1] {
				#1530010021V#12P#00106F……嗯，就是說啊。{wait}
			}
			TextWait
			if PartyPosition name[8] > -1:
				if Ao_FB 244 2048 > -1:
					TextTalk name[8] {
						#1530050016V#12P#10101F瓦奇，我說啊……{wait}
					}
					TextWait
				else:
					TextTalk name[8] {
						#1530050016V#6P#10101F瓦奇，我說啊……{wait}
					}
					TextWait
			TextTalk name[2] {
				#1530020027V#00211F這玩笑一點也不好笑……{wait}
			}
			TextWait
		elif PartyPosition name[9] > -1:
			TextTalk name[9] {
				#1530060020V#6P#00603F嗯……
				看來沒什麼問題。{wait}
			} {
				#1530060021V#00600F不過，我好像聽說過
				這台車是迪塔前市長
				特別通融才拿到的，是吧？{wait}
			}
			TextWait
			Fork name[1] fork[0]:
				CharTurnToChar name[1] name[9] 500deg/s
			Sleep 50ms
			Fork name[2] fork[0]:
				CharTurnToChar name[2] name[9] 500deg/s
			Sleep 50ms
			Fork name[0] fork[0]:
				CharTurnToChar name[0] name[9] 500deg/s
			Sleep 50ms
