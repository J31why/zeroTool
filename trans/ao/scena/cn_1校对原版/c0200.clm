	CharFlagsUnset field_party[5] 0x0080
	CharFlags2Unset field_party[5] 0x8000
	FadeWait
	TextTalk name[0] {
		#1530000033V#11P#00002F我們的車……
		看來是平安無事。{wait}
	}
	TextWait
	if PartyPosition name[4] > -1 | PartyPosition name[9] > -1:
		if PartyPosition name[8] > -1:
			TextTalk name[8] {
				#1530050015V#6P#10109F太好了……總算可以放心了。{wait}
			}
			TextWait
		if PartyPosition name[4] > -1:
			TextTalk name[4] {
				#1530040015V#6P#10405F不過，我沒記錯的話，
				這台車是迪塔市長
				特別通融才拿到的吧？{wait}
			} {
				#1530040016V#10409F呵呵，結果我們
				還開這台車去逮捕他，
				還真是諷刺。{wait}
			}
			TextWait
			Fork name[1] fork[0]:
