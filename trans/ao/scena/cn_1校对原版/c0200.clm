		ForkWait name[2] fork[0]
		ForkWait name[0] fork[0]
		ForkWait name[3] fork[0]
		ForkWait custom[0] fork[0]
		ForkWait custom[1] fork[0]
		TextTalk name[1] {
			#1530010023V#12P#00108F這、這麼說來……{wait}
		}
		TextWait
		TextTalk name[2] {
			#1530020029V#00211F……還真是諷刺啊。{wait}
		}
		TextWait
	CharTurnTo name[3] 315deg 500deg/s
	Sleep 150ms
	TextTalk name[3] {
		#1530030018V#00304F嗯，無論經過如何，
		它也是支援課的一員。{wait}
	} {
		#1530030019V#00302F為了確認能否正常使用，
		檢查看看裡面吧。{wait}
	}
	TextWait
	CharTurnTo name[0] 0deg 500deg/s
	TextTalk name[0] {
		#1530000034V#11P#00000F嗯，你說得對。{wait}
	}
