calmare ao_k scena
scena:
	name "c025b" "c025b" "c025b"
	town town[14]
	bgm bgm[513]
	flags 8192
	item_use fn[0,255]
	unk 255 0

entry:
	pos (0, 0, -1000)
	unk1 0
	cam_from (0, 0, 24000)
	cam_pers 500
	unk2 30
	cam_deg 45deg
	cam_limit 0deg 360deg
	cam_at (0, 0, 0)
	unk3 0
	unk4 0
	flags 0x0001
	town town[1]
	init fn[0,2]
	reinit fn[0,3]

chip[0] "chr/ch10300.itc"
chip[1] "chr/ch22300.itc"
chip[2] "chr/ch22302.itc"
chip[3] "chr/ch32700.itc"
chip[4] "chr/ch32702.itc"
chip[5] "apl/ch50148.itc"
chip[6] "chr/ch21000.itc"
chip[7] "chr/ch21002.itc"

npc char[0]:
	name "雷緹"
	pos (51830, 0, 115930)
	angle 0deg
	flags 0x0105
	unk2 0
	chip chip[0]
	init fn[0,0]
	talk fn[0,4]
	unk4 255

npc char[1]:
	name "潘莎"
	pos (-54310, 0, 52840)
	angle 90deg
	flags 0x0105
	unk2 0
	chip chip[1]
	init fn[0,1]
	talk fn[0,5]
	unk4 255

npc char[2]:
	name "寇肯"
	pos (-51920, 0, 108370)
	angle 90deg
	flags 0x0105
	unk2 0
	chip chip[6]
	init fn[0,0]
	talk fn[0,6]
	unk4 255

fn[0]:
	switch random % 8:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharIdle self (-55110, null, 51620) (-53050, null, 53960) 1000mm/s
		Sleep 300ms
	Return

fn[2]:
	CharSetPos char[1] (-58130, 0, 58620) 0deg
	if !flag[1]:
		CharFlagsSet char[1] 0x0010
	ForkFunc char[1] fork[0] fn[0,0]
	Return

fn[3]:
	Return

fn[4]:
	TextStart self
	TextTalk self {
		哎呀呀，不知不覺間，
		天色已經完全暗下來了。{wait}
	}
	TextWait
	TextTalk self {
		爸爸也快要回到家了，
		我得快點煮飯才行。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[5]:
	TextStart self
	if !flag[1]:
		TextTalk self {
			……啊！
			我放時尚雜誌的書櫃裡
			混著鐵路相關的書……{wait}
		}
		TextWait
		TextTalk self {
			這一定是爸爸幹的好事。
			他到底打算用幾次
			同樣的招數啊？{wait}
		}
		TextWait
		FlagSet flag[1]
		CharFlagsUnset self 0x0010
	else:
		TextTalk self {
			爸爸他偶爾會這麼做，
			為的是想讓我喜歡上鐵路。{wait}
		}
		TextWait
		TextTalk self {
			真是的，有夠煩人的。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[6]:
	TextStart self
	if !flag[3]:
		TextTalk self {
			雖然我一直想讓龍
			繼承批發商的工作，不過……{wait}
		}
		TextWait
		TextTalk self {
			那個傢伙
			卻只知道玩啊。
			真是傷腦筋。{wait}
		}
		TextWait
		FlagSet flag[3]
	else:
		TextTalk self {
			龍在主日學校的成績
			也是非常糟糕。{wait}
		}
		TextWait
		TextTalk self {
			不能讓他只顧著玩，
			得叫他多用功一點才行。{wait}
		}
		TextWait
	TextEnd self
	Return
