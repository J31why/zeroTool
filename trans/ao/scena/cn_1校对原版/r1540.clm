fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		ED7CharAnimation self 1000ms 0 1 2 3 4 3 2 1
	Return

fn[2]:
	while 1:
		ED7CharAnimation self 1000ms 0 1 2 1 0 3 4 3
	Return

fn[3]:
	while 1:
		ED7CharAnimation self 1000ms 0 1 2 3 4 3 2 1
	Return

fn[4]:
	if flag[3590]:
		CharSetPos char[0] (-37300, -440, -76070) 270deg
	if flag[3089]:
		CharFlagsSet char[0] 0x0080
	elif flag[3074]:
		if flag[3209]:
			CharFlagsSet char[0] 0x0080
	elif flag[2861]:
	elif flag[2848]:
	elif flag[2837]:
	elif flag[2832]:
	elif flag[2816]:
	elif flag[2573]:
	elif flag[2564]:
	elif flag[2560]:
	elif flag[2353]:
		CharFlagsSet char[0] 0x0080
	if flag[272]:
