fn[0]:
	while 1:
		ED7CharAnimation self 1000ms 0 1 2 3 4 3 2 1
	Return

fn[1]:
	while 1:
		ED7CharAnimation self 1000ms 0 1 2 3 4 3 2 1
	Return

fn[2]:
	if system[0] == 0:
		if global[0] == 17:
			global[0] = 0
			Event fn[0,15]
	if flag[272]:
		FlagUnset flag[272]
		FlagSet flag[0]
		Event fn[0,16]
	elif flag[273]:
		FlagUnset flag[273]
		Event fn[0,19]
	elif flag[274]:
		FlagUnset flag[274]
		Event fn[0,18]
	elif flag[275]:
		FlagUnset flag[275]
		Event fn[0,46]
	if system[0] == 133 && flag[2571] && !flag[2572]:
		Event fn[0,20]
	Return

fn[3]:
	if flag[0]:
		system[1] = 0
		FlagUnset flag[0]
	if flag[2571] && !flag[2573]:
		if system[0] == 133 | system[0] == 134 | system[0] == 139:
			system[1] = 577
			BgmVolume 50 200ms
			SystemFlagsSet 0x00000002
		elif system[0] == 135:
			system[1] = 577
			BgmVolume 100 200ms
	LookPointFlagsSet look_point[0] 0x0001
	if flag[2572] && !flag[2573]:
		ObjFlagsUnset object[19] 0x0010
		LookPointFlagsUnset look_point[0] 0x0001
	if system[0] == 133 | system[0] == 134 | system[0] == 135 | system[0] == 139:
		SystemFlagsSet 0x00002000
		ED7_E0 0
	else:
		SystemFlagsUnset 0x00002000
	ED7_1D_0 0 1 0 (106000, -6000, 0) 6000 2000 90000
	ED7_1D_0 1 1 0 (98000, -6000, 0) 6000 2000 90000
	ED7_1D_0 2 1 0 (100000, -7380, 89000) 4000 2000 0
	ED7_1D_0 3 1 0 (100000, -7800, 110000) 4000 2000 0
	ED7_1D_0 4 1 0 (96000, -7000, 100000) 4000 2000 90000
	ED7_1D_0 5 1 0 (104000, -7000, 100000) 4000 2000 90000
	ED7_1D_0 6 1 0 (92000, -8000, 96000) 4000 2000 0
	ED7_1D_0 7 1 0 (0, -7000, 100000) 4000 2000 0
	ED7_1D_0 8 1 0 (0, -7000, 92000) 4000 2000 0
	ED7_1D_0 9 1 0 (200000, -8000, 190000) 8000 2000 0
	ED7_1D_0 10 1 0 (200000, -8000, 210000) 8000 2000 0
	if flag[2688]:
		ED7_1D_2 0 1
		ED7_1D_2 1 1
		ED7_1D_3 2 1
		ED7_1D_3 3 1
		ED7_1D_2 4 1
		ED7_1D_2 5 1
		ED7_1D_3 6 1
		ED7_1D_2 7 1
		ED7_1D_2 8 1
		ED7_1D_3 9 1
		ED7_1D_3 10 1
		ED7_76_2 object[14] "m01gim01" "on_kp"
		ED7_76_2 object[15] "m01gim01" "on_kp"
		ED7_76_2 object[16] "m01gim01" "on_kp"
		ED7_76_2 object[255] "Null" "high"
	else:
		ED7_1D_3 0 1
		ED7_1D_3 1 1
		ED7_1D_2 2 1
		ED7_1D_2 3 1
		ED7_1D_3 4 1
		ED7_1D_3 5 1
		ED7_1D_2 6 1
		ED7_1D_3 7 1
