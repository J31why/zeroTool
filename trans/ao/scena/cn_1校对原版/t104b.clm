fn[4]:
	Call fn[0,5]
	Return

fn[5]:
	TextStart char[0]
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"交談" // 0
			"買東西" // 1
			"放棄" // 2
		MenuWait var[0]
		if var[0] != 1:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			ShopOpen shop[102]
			var[0] = 99
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			if flag[2605]:
				if !flag[0]:
					TextTalk char[0] {
						慶生、迎新、歡送，
						或是對心愛的人求婚……{wait}
					}
					TextWait
					TextTalk char[0] {
						本店會盡可能協助客人
						策划以上活動。{wait}
					}
					TextWait
					TextTalk char[0] {
						如果有興趣，歡迎找我商量。
						祝客人度過極致的一夜……{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[0] {
						本店會盡可能協助客人
						策划各種活動。{wait}
					}
					TextWait
					TextTalk char[0] {
						如果有興趣，歡迎找我商量。
						祝客人度過極致的一夜……{wait}
					}
					TextWait
			elif flag[2601]:
			elif flag[2597]:
	TextEnd char[0]
	Return

fn[6]:
	TextStart self
	if flag[2605]:
		if !flag[1]:
			TextTalk self {
				據說今天是坐在
				中央餐桌的客人生日。{wait}
			}
			TextWait
			TextTalk self {
				剛才在那位男性的安排下，
				店裡的人全部一起
				鼓掌，唱歌慶生喔。{wait}
			}
			TextWait
			TextTalk self {
				別看我們的店長那樣，
				他其實蠻喜歡驚喜的，
				所以偶爾會有這種事。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				嗯，今晚有很多晚餐的
				訂桌客人，很忙呢。{wait}
			}
			TextWait
			TextTalk self {
				不好意思，沒有訂桌的客人
				請去裡面的櫃台。{wait}
			}
			TextWait
	elif flag[2601]:
	elif flag[2597]:
	TextEnd self
	Return

fn[7]:
	TextStart self
	if flag[2605]:
		TextTalk self {
			坐在中央餐桌的那位年輕人
			相當上道呢。{wait}
		}
		TextWait
		TextTalk self {
			讓我也想在下次孫子生日時
			給孫子驚喜。{wait}
		}
		TextWait
	elif flag[2601]:
	elif flag[2597]:
	TextEnd self
	Return

fn[8]:
	TextStart self
	if flag[2605]:
		TextTalk self {
			哎呀，店長突然來搭話，
