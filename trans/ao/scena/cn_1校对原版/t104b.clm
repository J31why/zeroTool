fn[12]:
	_Char4A char[6] 255
	_Char4A char[7] 255
	if !flag[4]:
		TextTalk char[7] {
			唉，剛才真是
			嚇了一跳。{wait}
		}
		TextWait
		TextTalk char[7] {
			沒想到會所有店員和客人
			一起慶祝我生日。{wait}
		}
		TextWait
		TextTalk char[6] {
			哈哈，是我拜託店裡的人協助。
			是給妳一點小驚喜啦。{wait}
		}
		TextWait
		TextTalk char[7] {
			呵呵，我非常高興！{wait}
		}
		TextWait
		TextTalk char[7] {
			可是可是，為什麼撒札克先生
			要為我做到這個地步呢？{wait}
		}
		TextWait
		TextTalk char[6] {
			呵呵，我看到妳沮喪的模樣，
			就無法放下妳不管呀。{wait}
		}
		TextWait
		TextTalk char[7] {
			咦，那……{wait}
		}
		TextWait
		FlagSet flag[4]
	else:
		TextTalk char[6] {
			……沒、沒有啦。
			哈哈，是不是有點太耍帥了呢？{wait}
		}
		TextWait
		TextTalk char[6] {
			……咳哼。
			夜晚還很長，今天
			就好好樂在其中吧。{wait}
		}
		TextWait
		TextTalk char[7] {
			好、好的㈱{wait}
		}
		TextWait
	_Char4B char[6] 255
	_Char4B char[7] 255
	Return

