fn[9]:
	TextStart self
	if flag[2605]:
		TextTalk self {
			實際上這種驚喜，
			如果自己是當事人，
			會很難為情吧。{wait}
		}
		TextWait
		TextTalk self {
			呵呵，但只是旁觀的話
			很有趣，所以沒關係。{wait}
		}
		TextWait
	elif flag[2601]:
	elif flag[2597]:
	TextEnd self
	Return

