		if flag[3081]:
			CharFlagsUnset char[2] 0x0080
			CharSetPos char[2] (2840, 0, -530) 270deg
		CharFlagsUnset char[7] 0x0080
		CharSetPos char[7] (2490, 0, 2350) 0deg
		CharFlagsSet char[1] 0x0080
