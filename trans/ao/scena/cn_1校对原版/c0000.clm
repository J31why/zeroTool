fn[0]:
	switch random % 8:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharTurnTo self 180deg 500deg/s
		Sleep 300ms
		CharWalkToPos self (-1830, 0, -9000) 2000mm/s 0
		Sleep 300ms
		CharTurnTo self 0deg 500deg/s
		Sleep 300ms
		CharWalkToPos self (-1830, 0, 13000) 2000mm/s 0
		Sleep 300ms
	Return

fn[2]:
	while 1:
		CharWalkToPos self (-1830, 0, -23430) 2000mm/s 0
		Sleep 800ms
		CharSetPos self (-1830, 0, 25870) 180deg
	Return

fn[3]:
	if system[0] == 104:
		CharSetPos field_party[0] (0, 0, 21840) 180deg
		CharSetPos field_party[1] (0, 0, 21840) 180deg
		CharSetPos field_party[2] (0, 0, 21840) 180deg
		CharSetPos field_party[3] (0, 0, 21840) 180deg
		if system[15] != 255:
			CharSetPos field_party[4] (0, 0, 21840) 180deg
			CharSetPos field_party[5] (0, 0, 21840) 180deg
		elif system[14] != 255:
			CharSetPos field_party[4] (0, 0, 21840) 180deg
		system[0] = 100
	global[7] = 9
	if flag[3385]:
	elif flag[3371]:
		CharFlagsSet char[0] 0x0080
		CharFlagsSet char[1] 0x0080
	elif flag[3328]:
		CharFlagsSet char[0] 0x0080
		CharFlagsSet char[1] 0x0080
