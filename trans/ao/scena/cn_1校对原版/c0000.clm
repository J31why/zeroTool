		CharFlagsUnset char[6] 0x0080
		CharSetPos char[6] (1830, 0, -6290) 360deg
		CharFlagsUnset char[9] 0x0080
		CharSetPos char[9] (170, 0, -5890) 90deg
		CharFlagsUnset char[8] 0x0080
		CharSetPos char[8] (2890, 0, -2500) 90deg
	elif flag[3074]:
		CharFlagsUnset char[3] 0x0080
