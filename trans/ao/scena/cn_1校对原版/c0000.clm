fn[16]:
	TextStart self
	if flag[2573]:
		TextTalk self {
			恐怖分子到底打算
			從什麼地方進來
			克洛斯貝爾啊……？{wait}
		}
		TextWait
		TextTalk self {
			這裡應該沒有死角才對……
