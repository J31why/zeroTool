		TextTalk self {
			所以，這件事
			就交給我，妳就努力
			做好自己的工作吧。{wait}
		}
		TextWait
		TextTalk name[8] {
			#10100F嗯，我知道。{wait}
		}
		TextWait
		FlagSet flag[3223]
	else:
		TextTalk self {
			諾艾兒，妳外派到支援課的期限，
			是到今天為止吧？{wait}
		}
		TextWait
		TextTalk self {
			為了不要留下遺憾，
			至少要打起精神好好工作才行哦。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[8]:
	TextStart self
	if flag[3089]:
		TextTalkNamed self "外國人" {
			唔唔，竟然說錯過今天
			就回不去帝國了……！？{wait}
		}
		TextWait
		TextTalkNamed self "外國人" {
			可惡！什麼國防軍啊！
			盡說些自作主張的話！{wait}
		}
		TextWait
	elif flag[3074]:
		TextTalkNamed self "市民" {
			沒想到克洛斯貝爾市
			會發生攻擊事件啊……{wait}
		}
		TextWait
		TextTalkNamed self "市民" {
			我們做錯了什麼嗎……？
			希望不要再發生那種事了。{wait}
		}
		TextWait
	elif flag[2816]:
		TextTalkNamed self "市民" {
			國家獨立啊……
			提倡這種主張的日子
			居然來臨了……{wait}
		}
		TextWait
		TextTalkNamed self "市民" {
			無論如何，
			我都希望可以實現。{wait}
		}
		TextWait
	elif flag[2560]:
		TextTalk self {
			哦哦，這是多麼……
			多麼壯觀的城市風貌啊！{wait}
		}
		TextWait
		TextTalk self {
			呵呵，雖然一把年紀了，
			但我還是好興奮！{wait}
		}
		TextWait
	TextEnd self
	Return

fn[9]:
	TextStart self
	if flag[3089]:
		TextTalkNamed self "外國人" {
			爺爺，請你冷靜下來……{wait}
		}
		TextWait
		TextTalkNamed self "外國人" {
			總之，我們快點
			去買票吧。{wait}
		}
		TextWait
	elif flag[2837]:
		TextTalk self {
			有好多救護車開過去……
			到、到底發生了什麼事啊？{wait}
		}
		TextWait
	elif flag[2832]:
		TextTalk self {
			克洛斯貝爾
			果然很大啊。{wait}
		}
		TextWait
		TextTalk self {
			早知道就先買一份
			觀光指南就好了。{wait}
		}
		TextWait
	elif flag[2560]:
		TextTalk self {
			雖然爺爺非常開心，
			但我總覺得有點焦躁不安。{wait}
		}
		TextWait
		TextTalk self {
			畢竟克洛斯貝爾被大家
			稱為『魔都』，對吧？{wait}
		}
		TextWait
	TextEnd self
	Return

fn[10]:
	TextStart self
	if flag[3089]:
		TextTalkNamed self "外國人" {
			雖然丟了在克洛斯貝爾的工作
			讓我心痛，但總比回不去故鄉好。{wait}
		}
		TextWait
		TextTalkNamed self "外國人" {
			現在就算沒座位可坐也無所謂。
			我得趕快離開克洛斯貝爾，
			免得被捲入奇怪的事件。{wait}
		}
		TextWait
	elif flag[2861]:
		TextTalk self {
			竟然被武裝集團佔領了，
			到底為什麼會發生這種事件……？{wait}
		}
		TextWait
		TextTalk self {
			不知道瑪因茲是否平安，
			我好擔心啊……{wait}
		}
		TextWait
	elif flag[2573]:
		TextTalk self {
			呃，今天我預約好
			要住的飯店在哪裡呢？{wait}
		}
		TextWait
		TextTalk self {
			我豁出去直接找了間在歡樂街的旅店。
			出來旅行就是要玩得開心啊。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[11]:
	TextStart self
	if flag[3089]:
		TextTalkNamed self "外國人" {
			前一陣子，我收到了
			帝國那邊的回國通知……{wait}
		}
		TextWait
		TextTalkNamed self "外國人" {
			唉，我可是很喜歡
			住在克洛斯貝爾的生活啊……{wait}
		}
		TextWait
	elif flag[2861]:
		TextTalk self {
			我也很擔心武裝集團
			會來克洛斯貝爾。{wait}
		}
		TextWait
		TextTalk self {
			警備隊怎麼還不
			快點做出對策呢……？{wait}
		}
		TextWait
	elif flag[2353]:
		TextTalk self {
			呵呵，這孩子真是的，
			居然這麼興奮。{wait}
		}
		TextWait
		TextTalk self {
			不過，我大概明白他的心情。
			畢竟克洛斯貝爾
			是個很厲害的都市。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[12]:
	TextStart self
	if flag[3074]:
		TextTalk self {
			我想要盡早離開
			克洛斯貝爾。{wait}
		}
		TextWait
		TextTalk self {
			這麼危險的地方，
			我連一秒都不想待了。{wait}
		}
		TextWait
	elif flag[2816]:
		TextTalk self {
			就算說要獨立，
			我也不太懂是
			怎麼回事啊。{wait}
		}
		TextWait
		TextTalk self {
			在公民投票日之前，
			我先來稍微調查看看吧……{wait}
		}
		TextWait
	elif flag[2564]:
		TextTalk self {
			今天早上非常熱鬧哦。{wait}
		}
		TextWait
		TextTalk self {
			有那種豪華禮車來接送，
			真不愧是 ＶＩＰ呢。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[13]:
	TextStart self
	if flag[3089]:
		TextTalkNamed self "外國人" {
			該怎麼辦……
			車站裡人太多了，我根本進不去。{wait}
		}
		TextWait
		TextTalkNamed self "外國人" {
			嗚嗚，我回得了
			共和國嗎……？{wait}
		}
		TextWait
	else:
		TextTalk self {
			你在百貨的屋頂
			看到揭幕儀式了吧。{wait}
		}
		TextWait
		TextTalk self {
			唉～我好想親眼拜見
			尤莉亞大人的臉龐哦～{wait}
		}
		TextWait
	TextEnd self
	Return

fn[14]:
	TextStart self
	if flag[3089]:
		TextTalk self {
			我說啊，為什麼我們
			非得回帝國不可呢？{wait}
		}
		TextWait
		TextTalk self {
			我明明好不容易
			交到了很多朋友……{wait}
		}
		TextWait
	elif flag[2837]:
		TextTalk self {
			我們在車站裡玩了一下就
			被站員罵了，然後還被趕出來。{wait}
		}
		TextWait
		TextTalk self {
			嘖！真小氣。{wait}
		}
		TextWait
	elif flag[2832]:
		TextTalk self {
