		}
		TextWait
		TextTalk self {
			我說啊，我們快點走嘛，媽媽～！！{wait}
		}
		TextWait
	TextEnd self
	Return

fn[15]:
	TextStart self
	if flag[2837]:
		TextTalk self {
			討厭，哥哥真是的……
