		else:
			TextTalk char[0] {
				總之蘭迪，
				你千萬不要忘了
				我借過你多少東西。{wait}
			}
			TextWait
			TextTalk char[0] {
				我不會特別設期限，不過
				你總有一天一定要給我好好還清。{wait}
			}
			TextWait
	elif flag[2861]:
