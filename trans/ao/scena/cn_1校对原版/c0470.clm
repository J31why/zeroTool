			}
			TextWait
			FlagSet flag[3680]
		elif !flag[0]:
			TextTalk char[0] {
				現在或許正是克洛斯貝爾
				要面臨考驗的時刻。{wait}
			}
			TextWait
			TextTalk char[0] {
				……各位，蘭迪
				就拜託你們了。{wait}
			}
			TextWait
			TextTalk char[0] {
				那傢伙
				賒帳欠的酒錢
				還沒還清。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00003F嗯，包在我們身上。{wait}
			}
			TextWait
			TextTalk name[3] {
				#00309F我遲早會好好還錢的，
				放心吧。{wait}
			}
			TextWait
