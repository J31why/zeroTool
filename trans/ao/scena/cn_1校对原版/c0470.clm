			}
			TextWait
			TextTalk char[0] {
				……各位，蘭迪
				就拜託你們了。{wait}
			}
			TextWait
	elif flag[3371]:
		if !flag[3583]:
			TextTalk char[0] {
				喔，是你們啊……{wait}
			}
			TextWait
			TextTalk name[3] {
				#00300F好久不見啦，老闆。
				看來你過得還不錯嘛？{wait}
			}
			TextWait
			CharTurnToChar char[0] name[3] 500deg/s
			TextTalk char[0] {
				你也是啊，蘭迪。{wait}
			}
			TextWait
			TextTalk char[0] {
				我有聽說你投入了瑪因茲的
				反抗軍活動，不過看來你現在已經
				順利和夥伴們會合了，那就好。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00000F這邊沒有出現
				任何災情嗎？{wait}
			}
			TextWait
			CharTurnToChar char[0] name[0] 500deg/s
			TextTalk char[0] {
				是的，目前還沒。{wait}
			}
			TextWait
			TextTalk char[0] {
				各位若要在市區四處走動的話，
				也請一定要多加小心。{wait}
			}
			TextWait
			TextTalk name[3] {
				#00300F嗯，你也小心啊。{wait}
			}
			TextWait
			FlagSet flag[3583]
		elif !flag[0]:
			TextTalk char[0] {
				話說回來，頒布戒嚴令後，
				把營業規模縮小果然是正確的。{wait}
			}
			TextWait
			TextTalk char[0] {
				人數減少後，靠著目前店裡的庫存
				應該還能撐一段時間。{wait}
			}
			TextWait
			TextTalk char[0] {
				請別擔心我們。
				請各位專注在自己的
				工作上就好。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				人數減少後，靠著目前店裡的庫存
				應該還能撐一段時間。{wait}
			}
			TextWait
			TextTalk char[0] {
				請別擔心我們。
				請各位專注在自己的
				工作上就好。{wait}
			}
			TextWait
	elif flag[3089]:
		if !flag[0]:
			TextTalk char[0] {
				嗯……早上看到的那些
				穿著陌生制服的傢伙，
				原來就是國防軍的士兵啊。{wait}
			}
			TextWait
			TextTalk char[0] {
				他們看起來
				還真是準備萬全……{wait}
			}
			TextWait
			TextTalk char[0] {
				庫羅伊斯到底
				是從什麼時候開始
				計畫這件事的呢？{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				現在想想，從公民投票結束到今天
				才過了短短一星期……{wait}
			}
			TextWait
			TextTalk char[0] {
				庫羅伊斯到底
				是從什麼時候開始
				計畫這件事的呢？{wait}
			}
			TextWait
	elif flag[3074]:
		if !flag[3177]:
			TextTalk char[0] {
				喔，蘭迪。
				我是不清楚你怎麼了，
				不過你看起來好像一派輕鬆嘛。{wait}
			}
			TextWait
			TextTalk char[0] {
				碰上這種情況，店裡
				可是已經門可羅雀了，
				你到底是什麼意思啊？{wait}
			}
			TextWait
			TextTalk name[3] {
				#00305F嗯？我是覺得
				沒什麼不同啊。{wait}
			} {
				#00309F我看是因為我
				有一陣子沒來這裡露臉，
				老闆你覺得寂寞吧？{wait}
			}
			TextWait
			TextTalk char[0] {
				哼，少鬼扯了。
				少一個囉嗦的傢伙，
				我耳根反而清靜了不少。{wait}
			}
			TextWait
			TextTalk char[0] {
				不管怎樣，這一路走來，
				你欠了我不少東西。{wait}
			}
			TextWait
			TextTalk char[0] {
				在全部還清之前，
				我可不許你隨便給我搞失蹤喔。{wait}
			}
			TextWait
			TextTalk name[3] {
