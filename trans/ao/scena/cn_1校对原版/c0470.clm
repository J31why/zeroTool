fn[2]:
	ED7_76_0 object[255] "white00" 1
	TriggerFlagsSet trigger[0] 0x0080
	if QuestFlagsGet quest[102] 0x02 && !QuestFlagsGet quest[102] 0x10 && !QuestFlagsGet quest[102] 0x40 && flag[2436]:
		TriggerFlagsUnset trigger[0] 0x0080
		ED7_76_0 object[255] "white00" 2
	LookPointFlagsSet look_point[5] 0x0001
	if !flag[2573] && flag[2564]:
		LookPointFlagsSet look_point[7] 0x0001
	if flag[3089] && !flag[3371]:
		LookPointFlagsSet look_point[7] 0x0001
	if !flag[3385] && flag[3371]:
		LookPointFlagsSet look_point[2] 0x0001
		LookPointFlagsSet look_point[3] 0x0001
	if !flag[2573] && flag[2568]:
		EntranceSetDisabled entrance[0] 0
		EntranceSetDisabled entrance[4] 0
		EntranceSetDisabled entrance[3] 1
	elif system[4] >= 5:
		EntranceSetDisabled entrance[0] 0
		EntranceSetDisabled entrance[4] 1
		EntranceSetDisabled entrance[3] 0
	else:
		EntranceSetDisabled entrance[0] 1
		EntranceSetDisabled entrance[4] 0
		EntranceSetDisabled entrance[3] 0
	if flag[2848] && !flag[2858] | flag[2369] && system[4] == 1:
		SoundPlay sound[128] 1 30 0
	if !flag[3385] && flag[3370]:
		MapColor 0x00E6D2D2 0ms
	Return

fn[3]:
	Call fn[0,4]
	Return

fn[4]:
	if flag[2861] && !flag[2864]:
		Call fn[0,28]
		Return
	TextStart char[0]
	if flag[3385]:
		if !flag[3680]:
			CharTurnToChar char[0] name[3] 0deg/s
			TextTalk char[0] {
				……蘭迪，你打算
				去《大樹》那邊吧？{wait}
			}
			TextWait
			TextTalk name[3] {
				#00300F哈哈，你還真清楚啊。
				真不愧是多雷克老闆。{wait}
			}
			TextWait
			TextTalk char[0] {
				哼，我們都
				認識這麼久了。{wait}
			}
			TextWait
			TextTalk char[0] {
				……蘭迪，
				你賒帳欠的酒錢
				可還沒還完。{wait}
			}
			TextWait
			TextTalk char[0] {
				你要是不給我平安回來，
				我可饒不了你。{wait}
			}
			TextWait
			TextTalk name[3] {
				#00304F……嗯，我知道了。{wait}
			} {
				#00309F我遲早會好好還錢的，
				放心吧。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00002F（哈哈……這兩個人
