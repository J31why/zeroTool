		CharFlags2Unset field_party[4] 0x8000
	FadeIn 1000ms 0x00000000
	FadeWait
	CamSetDistance -800 3200 -27100 7000ms
	ED7CamRotate 47deg -8deg 0deg 7000ms
	CamPers 550 7000ms
	CamZoom 13600 7000ms
	CamWait 121
	Sleep 1000ms
	CrossFade 500ms
	CamSetDistance -1030 3900 -2690 0ms
	ED7CamRotate 23deg 14deg 0deg 0ms
	CamPers 550 0ms
	CamZoom 55250 0ms
	FadeWait
	CamSetDistance -1030 3900 -2690 7000ms
	ED7CamRotate 23deg 14deg 0deg 7000ms
	CamPers 550 7000ms
	CamZoom 79120 7000ms
	Sc_C8 340 200 "c_plac28" 0 3000
	CamWait 121
	Sleep 3000ms
	CrossFade 1000ms
	CamSetDistance -5050 4000 -37070 0ms
	ED7CamRotate 44deg 21deg 0deg 0ms
	CamPers 550 0ms
	CamZoom 13920 0ms
	CharColor name[0] 0xFFFFFFFF 0ms
	CharColor name[1] 0xFFFFFFFF 0ms
	CharColor name[3] 0xFFFFFFFF 0ms
	CharColor name[8] 0xFFFFFFFF 0ms
	CharColor name[4] 0xFFFFFFFF 0ms
	if PartyPosition name[2] > -1:
		CharColor name[2] 0xFFFFFFFF 0ms
	FadeWait
	TextTalk name[0] {
		#00003F……好安靜……{wait}
	}
	TextWait
	TextTalk name[8] {
		#10104F根據報告，自從教團事件解決後，
		魔物的氣息就消失了。{wait}
	} {
		#10100F嗯，不過也因此
		平民也開始獲准
		進行調查了。{wait}
	}
	TextWait
	TextTalk name[1] {
		#00108F會不會也和《僧院》一樣，
		跟頂樓的那口《鐘》
		有什麼關係呢……？{wait}
	}
	TextWait
	if PartyPosition name[2] > -1:
		TextTalk name[2] {
			#00203F那口《鐘》啊……
			說不定真的是這樣。{wait}
		}
		TextWait
		TextTalk name[4] {
			#10305F這麼說來，之前確實
			有說到這件事。{wait}
		}
		TextWait
	else:
		TextTalk name[4] {
			#10303F《鐘》啊……
			這麼說來，之前確實
			有說到這件事。{wait}
		}
		TextWait
	TextTalk name[3] {
		#00302F嗯，不過既然沒有敵人，
		我們也可以算是蠻幸運的嘛。{wait}
	} {
		#00309F我們加快腳步前進吧。{wait}
	}
	TextWait
	TextTalk name[0] {
		#00000F嗯……
		但還是要小心
		不要疏於戒備。{wait}
	}
	TextWait
	if PartyPosition name[2] > -1:
		CharFlagsSet field_party[4] 0x0080
		CharFlags2Set field_party[4] 0x8000
		CharFlagsSet field_party[5] 0x0080
		CharFlags2Set field_party[5] 0x8000
	else:
		CharFlagsSet field_party[4] 0x0080
		CharFlags2Set field_party[4] 0x8000
	CharSetPos field_party[0] (100, 0, -34300) 0deg
	ED7_Cam69 255 0
	QuestTaskSet quest[113] 3
	FlagSet flag[2714]
	SystemFlagsUnset 0x10000000
	EventEnd 5
	Return
