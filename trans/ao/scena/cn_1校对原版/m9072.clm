fn[0]:
	if system[0] == 101:
		Event fn[0,4]
	if flag[272]:
		FlagUnset flag[272]
		FlagSet flag[0]
		FlagSet flag[1]
		Event fn[0,30]
	elif flag[273]:
		FlagUnset flag[273]
		FlagSet flag[2]
		Event fn[0,32]
	Return

fn[1]:
	ED7_EE 1 800
	if flag[0]:
		system[1] = 0
		FlagUnset flag[0]
	char[0].45 = 1100
	char[0].46 = 1100
	char[0].47 = 1100
	EntranceSetFunc entrance[1] fn[0,5]
	TriggerFlagsSet trigger[0] 0x0080
	if flag[3399] && !flag[3400]:
		TriggerFlagsUnset trigger[0] 0x0080
	if flag[3400]:
		ED7_76_1 object[255] "magi10_add" 1
		ED7_76_1 object[255] "magi11_add" 1
		ED7_76_1 object[255] "point_add" 1
		ED7_76_0 object[255] "magi_04_add" 1
		ED7_76_0 object[255] "point16_add" 1
		ED7_76_0 object[255] "yuka_15_add" 1
		ED7_76_0 object[255] "fire00_add" 1
		ED7_76_0 object[255] "fire02_add" 1
	else:
		ED7_76_0 object[255] "magi10_add" 1
		ED7_76_0 object[255] "magi11_add" 1
		ED7_76_0 object[255] "point_add" 1
		ED7_76_1 object[255] "magi_04_add" 1
		ED7_76_1 object[255] "point16_add" 1
		ED7_76_1 object[255] "yuka_15_add" 1
		ED7_76_1 object[255] "fire00_add" 1
		ED7_76_1 object[255] "fire02_add" 1
	if flag[3400] && !flag[3404]:
		Call fn[0,41]
	if flag[3400] | flag[2]:
		SoundStop sound[130]
		SoundPlay sound[825] 1 40 0
	elif flag[1]:
		SoundStop sound[130]
		SoundPlay sound[825] 1 60 0
		FlagUnset flag[1]
	else:
		SoundPlay sound[130] 1 60 0
		SoundPlay sound[825] 1 60 0
	Return

fn[2]:
	CharFlagsSet char[0] 0x0010
	TextStart char[0]
	if !flag[3703]:
		TextTalk char[0] {
			…………{wait}
		}
		TextWait
		TextTalk name[3] {
			#00301F他好像徹底暈過去了……{wait}
		} {
			#00306F不過傷勢似乎並不致命。
			……唉，真是有夠耐打。{wait}
		}
		TextWait
		TextTalk name[1] {
			#00104F……是不是把他抬回梅爾卡巴比較好？{wait}
		}
		TextWait
		TextTalk name[0] {
			#00001F是啊……
			他畢竟是克洛斯貝爾市攻擊事件的罪魁禍首，
			可以的話我是很想逮捕他。{wait}
		}
		TextWait
		TextTalk name[2] {
			#00203F……我認為有點危險。{wait}
		} {
			#00200F既然他沒有生命危險，我認為
			將他留在原處才是明智之舉。{wait}
		}
		TextWait
		TextTalk name[3] {
			#00303F嗯，反正他短時間內應該也不會醒來，
			所以大概也不用擔心他追擊我們吧。{wait}
		} {
			#00300F我們就先繼續前進吧。{wait}
		}
		TextWait
		FlagSet flag[3703]
	else:
		TextTalk char[0] {
			…………{wait}
		}
		TextWait
		TextSetName ""
		TextMessage null {
			{color 5}似乎完全暈過去了。{color 0}{wait}
		}
		TextWait
		TextClose 0
		_59
	TextEnd char[0]
	Return

fn[3]:
