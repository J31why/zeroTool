fn[3]:
	if !flag[3089] && flag[3074]:
		EntranceSetDisabled entrance[0] 0
		EntranceSetDisabled entrance[1] 1
	else:
		EntranceSetDisabled entrance[0] 1
		EntranceSetDisabled entrance[1] 0
	if flag[2848] && !flag[2858] | flag[2369] && system[4] == 1:
		ED7_76_0 object[255] "hikari00_add" 1
		ED7_76_0 object[255] "hikari01_add" 1
		SoundPlay sound[128] 1 50 0
	if !flag[3385] && flag[3370]:
		MapColor 0x00E6D2D2 0ms
		ED7_76_0 object[255] "hikari00_add" 1
		ED7_76_0 object[255] "hikari01_add" 1
	LookPointFlagsSet look_point[22] 0x0001
	if flag[2353]:
		LookPointFlagsUnset look_point[22] 0x0001
	LookPointFlagsSet look_point[21] 0x0001
	if flag[2560]:
		LookPointFlagsUnset look_point[21] 0x0001
	LookPointFlagsSet look_point[2] 0x0001
	if flag[2816]:
		LookPointFlagsUnset look_point[2] 0x0001
	LookPointFlagsSet look_point[20] 0x0001
	if flag[3074]:
		LookPointFlagsUnset look_point[20] 0x0001
	LookPointFlagsSet look_point[19] 0x0001
	if flag[3328]:
		LookPointFlagsUnset look_point[19] 0x0001
	Return

fn[4]:
	TextSetName ""
	TextMessage null {
		{color 5}有本『一分料理・甜點篇』。{wait}
	}
	TextWait
	TextClose 0
	_59
	TextSetPos -1 280 60 3
	if ItemHas item[2] 0:
		if !RecipeLearn 20:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextSetName ""
			TextMessage null {
				記住了{color 2}『輕快爆米花』{color 0}的食譜。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			FadeWait
			_59
			TextSetPos -1 280 60 3
	TextEnd null
	Return

fn[5]:
	TextStart self
	if flag[3385]:
		if !flag[0]:
			TextTalk self {
				你好，歡迎來到
				克洛斯貝爾市立圖書館。{wait}
			}
			TextWait
			TextTalk self {
				……唉，今天也沒什麼人
				前來利用本館呢。{wait}
			}
			TextWait
			TextTalk self {
				突然冒出那樣可怕的大樹，
				是不是有不少人
				乾脆就盡量避免外出了？{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				今天也沒什麼人
				前來利用本館，不過……{wait}
			}
			TextWait
			TextTalk self {
				我會盡圖書館館員的本分，
				誠心誠意地為前來
				借書的人們提供服務。{wait}
			}
			TextWait
	elif flag[3371]:
		TextTalk self {
			感覺就像獵兵攻擊城市那時
			一樣令人心驚膽顫。{wait}
		}
		TextWait
		TextTalk self {
			「怎麼會發生這種事……」
			心裡都是這樣不平的聲音。{wait}
		}
		TextWait
	elif flag[3089]:
		TextTalk self {
			『克洛斯貝爾獨立國』……
			或許我們真的走到一個
			無法回頭的局面了。{wait}
		}
		TextWait
		TextTalk self {
			兩大國對於這份宣言，
			究竟會採取怎樣的態度呢？
			……老實說，我真的很擔心……{wait}
		}
		TextWait
	elif flag[3074]:
		if !flag[0]:
			TextTalk self {
				發生攻擊事件的當晚，我是已經結束
				手邊的工作離開這裡了，可是……{wait}
			}
			TextWait
			TextTalk self {
				以警察總部為中心，
				這個行政區好像真的
				蒙受了很嚴重的損失。{wait}
			}
			TextWait
			TextTalk self {
				事件雖然已經過去一週了……
				但我還是無法忘記
				那晚城市被烈焰吞噬的景象。{wait}
			}
