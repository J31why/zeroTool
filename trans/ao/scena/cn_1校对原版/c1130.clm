		MenuWait var[0]
		MenuClose menu[0]
		ED7_DB
		if var[0] == 0:
			ScMenuSetTitle 65535 25 0 "七耀教會"
			TextSetPos -1 70 -1 -1
			TextSetName ""
			TextMessage null {
				{color 5}供奉《空之女神愛德斯》，
				為塞姆利亞大陸最廣為人信仰的宗教組織。
				亞爾特利亞法典國為其大本營。{wait}
			} {
				儘管自導力革命發生以來，其影響力有下降的趨勢，
				但教會至今仍對整個大陸有不小的影響力，
				於學術、教育、醫療等領域擔任啟迪民智的角色。{color 0}{wait}
			}
			TextWait
			ED7_DB
			TextClose 0
			TextSetPos -1 280 60 3
			_59
			var[0] = 99
		if var[0] == 1:
			ScMenuSetTitle 65535 25 0 "七耀石／Septium"
			TextSetPos -1 70 -1 -1
			TextSetName ""
			TextMessage null {
				{color 5}遍布於大陸全境的七種珍貴礦物。
				自古便被視為寶石
				以及神秘的象徵，備受人們珍視。{wait}
			} {
				到了近代，
				由於發明出將過小而無法製成寶石的碎片《耀晶石》精製、
				加工為結晶迴路的技術，
				七耀石資源的重要性
				在大陸各國之間瞬間大幅提升。{color 0}{wait}
			}
			TextWait
			ED7_DB
			TextClose 0
			TextSetPos -1 280 60 3
			_59
			var[0] = 99
	FadeIn 300ms 0x00000000
	TextEnd null
	Return

fn[47]:
	TextStart null
	FadeOut 300ms 0x00000000 100
	var[0] = 99
	while var[0] == 99:
		var[0] = 0
		ScMenuSetTitle 65535 25 0 "書架４"
		TextSetName ""
		Menu menu[0] -1 -1 1
			"【大崩壞】" // 0
			"【釣公師團】" // 1
			"【導力革命】" // 2
			"【導力器／Orbment】" // 3
			"【放棄】" // 4
		MenuWait var[0]
		MenuClose menu[0]
		ED7_DB
		if var[0] == 0:
			ScMenuSetTitle 65535 25 0 "大崩壞"
			TextSetPos -1 70 -1 -1
			TextSetName ""
			TextMessage null {
				{color 5}指古代塞姆利亞文明
				約於一千二百年前發生的崩壞事件。
				傳說是因為天災所致，但詳情不明。{wait}
			} {
				文明被《大崩壞》破壞殆盡以後，
				人類便迎來了漫長的《黑暗時代》。{wait}
			}
			TextWait
			ED7_DB
			TextClose 0
			TextSetPos -1 280 60 3
			_59
			var[0] = 99
		if var[0] == 1:
			ScMenuSetTitle 65535 25 0 "釣公師團"
			TextSetPos -1 70 -1 -1
			TextSetName ""
			TextMessage null {
				{color 5}為釣魚專家們組成的團體，
				旨在推廣釣魚文化。
				由原為貴族的釣魚愛好者──
				Ｈ・費瑟爾所成立，
				總部設於利貝爾王國的格蘭賽爾市。{wait}
			} {
				從釣場的探訪、調查、開拓，
				一直到發掘、教育新世代的釣師都是其活動內容，
				近年甚至涉足了釣具、釣餌的開發，
				年年逐步增加活動的領域。{color 0}{wait}
			}
			TextWait
			ED7_DB
			TextClose 0
			TextSetPos -1 280 60 3
			_59
			var[0] = 99
		if var[0] == 2:
			ScMenuSetTitle 65535 25 0 "導力革命"
			TextSetPos -1 70 -1 -1
			TextSetName ""
			TextMessage null {
				{color 5}指約在五十年前，
				因導力器問世而導致整個大陸
				發生技術革新的事件。{wait}
			} {
				導力器在當時雖為劃時代的發明，
				但依舊無法消除人們對新技術的疑慮，
				一直到愛普斯泰恩財團的導力通訊器
				和ＺＣＦ的導力飛行船問世以後，
				才一改全大陸對導力技術的認知。{wait}
			} {
				現在從暖氣和燈具之類的日常用品，
				一直到鐵路和飛行船、
				戰車和大砲等兵器都已被導力化，
				對現代人而言導力器已是
				不可或缺的生活必需品。{wait}
			} {
				另外，近年隨著導力機關的小型化，
				烏爾努公司和萊恩福爾特公司開始著手
				研發高性能的導力驅動車，
				並將其逐步推廣至一般平民的生活當中。{color 0}{wait}
			}
			TextWait
			ED7_DB
			TextClose 0
			TextSetPos -1 280 60 3
			_59
			var[0] = 99
		if var[0] == 3:
			ScMenuSetTitle 65535 25 0 "導力器／Orbment"
			TextSetPos -1 70 -1 -1
			TextSetName ""
			TextMessage null {
				{color 5}由Ｃ・愛普斯泰恩博士發明，
				能從七耀石中汲取導力、
				引發各種現象之機器的總稱。{wait}
			} {
				透過導力器內的構造及齒輪轉動的方向，
				使利用七耀石加工而成的結晶迴路彼此干涉，
				可產生出無數種特殊現象。{wait}
			} {
				導力器的實用之處，
				不僅在於能引發多種現象，還有『隨著時間經過，
				內部導力會自然恢復』的特性，
				其經濟效益遠大於傳統的外燃機和內燃機。{color 0}{wait}
			}
			TextWait
			ED7_DB
			TextClose 0
			TextSetPos -1 280 60 3
			_59
			var[0] = 99
	FadeIn 300ms 0x00000000
	TextEnd null
	Return

