fn[49]:
	TextStart null
	FadeOut 300ms 0x00000000 100
	var[0] = 99
	while var[0] == 99:
		var[0] = 0
		ScMenuSetTitle 65535 25 0 "書架６"
		TextSetName ""
		Menu menu[0] -1 -1 1
			"【百日戰役】" // 0
			"【不戰條約】" // 1
			"【放棄】" // 2
		MenuWait var[0]
		MenuClose menu[0]
		ED7_DB
		if var[0] == 0:
			ScMenuSetTitle 65535 25 0 "百日戰役"
			TextSetPos -1 70 -1 -1
			TextSetName ""
			TextMessage null {
				{color 5}七耀曆１１９２年，埃雷波尼亞帝國
				與利貝爾王國發生的侵略戰爭之稱。
				從帝國的宣戰聲明開始，
				一直到七耀教會從中牽線引導戰爭結束的
				這段期間約經過百日，
				故得其名。{wait}
			} {
				起初利貝爾雖居於劣勢，
				被帝國軍佔領了大半國土，
				但後來凭借當時最先進的警備飛行艇
				發動閃電作戰進行反攻，
				轉眼間便使戰況逆轉。{wait}
			} {
				至於最根本的開戰原因，
				由於兩國皆對此保持緘默，
				故至今仍不明朗。
				帝國政府後來以
				「一個不幸的誤會所導致的錯誤」為說辭，
				向利貝爾提出了正式的道歉聲明。{color 0}{wait}
			}
			TextWait
			ED7_DB
			TextClose 0
			TextSetPos -1 280 60 3
			_59
			var[0] = 99
		if var[0] == 1:
			ScMenuSetTitle 65535 25 0 "不戰條約"
			TextSetPos -1 70 -1 -1
			TextSetName ""
			TextMessage null {
				{color 5}七耀曆１２０２年，由利貝爾王國、
				埃雷波尼亞帝國、卡爾瓦德共和國
				這三大國締結的國際條約。
				發起人為利貝爾的艾莉西亞女王，
				並於同國的艾爾貝離宮舉行簽署儀式。{wait}
			} {
				本條約雖無法律強制力，
				但在締結條約以後，帝國、共和國各自撤回了
				原本在克洛斯貝爾自治州近郊
				舉行的大規模軍事演習，大幅緩和了
				戰爭一觸即發的緊張狀態，
				著實展現了條約的效果。{color 0}{wait}
			}
			TextWait
			ED7_DB
			TextClose 0
			TextSetPos -1 280 60 3
			_59
			var[0] = 99
