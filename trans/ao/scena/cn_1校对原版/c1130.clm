		Menu menu[0] -1 -1 1
			"【米修拉姆】" // 0
			"【遊擊士協會／Bracer Guild】" // 1
			"【放棄】" // 2
		MenuWait var[0]
		MenuClose menu[0]
		ED7_DB
		if var[0] == 0:
			ScMenuSetTitle 65535 25 0 "米修拉姆"
			TextSetPos -1 70 -1 -1
			TextSetName ""
			TextMessage null {
				{color 5}位於艾魯姆湖東南方的高級遊憩區。
				自從ＩＢＣ在兩年前著手開發此地以後，
				就成了蓋有度假飯店、主題樂園
				等設施的人氣景點。{wait}
			} {
				名字叫做《咪西》的
				當地吉祥物也頗受市民
				和觀光客喜愛。{color 0}{wait}
			}
			TextWait
			ED7_DB
			TextClose 0
			TextSetPos -1 280 60 3
			_59
			var[0] = 99
		if var[0] == 1:
			ScMenuSetTitle 65535 25 0 "遊擊士協會／Bracer Guild"
			TextSetPos -1 70 -1 -1
			TextSetName ""
			TextMessage null {
				{color 5}為了守護平民以及各地的和平，
				遊擊士們自發組成的民間團體。
				在塞姆利亞大陸各地均設有分部，
				其發言與行動在社會上有不小的影響力。{wait}
			} {
				以平民的人身安全為第一順位的
				行動理念雖然相當美好，
				但反過來只要平民的生命沒有受到威脅，
				協會就沒有像國家公權力那般行使搜查、逮捕的權限，
				此為其組織規約上的缺點。{wait}
			} {
				在克洛斯貝爾當中，
				因其參與許多國際案件，
				集聚了不少如《風之劍聖》亞里歐斯・馬克萊因
				那樣優秀的人才，深受市民所支持。{color 0}{wait}
			}
			TextWait
			ED7_DB
			TextClose 0
			TextSetPos -1 280 60 3
			_59
			var[0] = 99
	FadeIn 300ms 0x00000000
	TextEnd null
	Return

fn[51]:
	TextStart null
	FadeOut 300ms 0x00000000 100
	var[0] = 99
	while var[0] == 99:
		var[0] = 0
		ScMenuSetTitle 65535 25 0 "書架８"
		TextSetName ""
		Menu menu[0] -1 -1 1
			"【萊恩福爾特公司】" // 0
			"【雷米菲利亞公國】" // 1
			"【列曼自治州】" // 2
			"【利貝爾王國】" // 3
			"【獵兵團／Jaeger】" // 4
			"【放棄】" // 5
		MenuWait var[0]
		MenuClose menu[0]
		ED7_DB
		if var[0] == 0:
			ScMenuSetTitle 65535 25 0 "萊恩福爾特公司"
			TextSetPos -1 70 -1 -1
			TextSetName ""
			TextMessage null {
				{color 5}總公司位於埃雷波尼亞帝國的
				大型綜合技術企業。
				原本為專門生產製造使用火藥的
				大砲、重型槍砲的兵器工房。{wait}
			} {
				自從導力器問世以後，
				除了導力鎗、導力兵器之外，
				也涉足了導力鐵路和飛行船等交通領域，
				成長為與卡爾瓦德共和國的《烏爾努公司》
				並稱世界兩大導力品牌的大型企業。{color 0}{wait}
			}
			TextWait
			ED7_DB
			TextClose 0
			TextSetPos -1 280 60 3
			_59
			var[0] = 99
		if var[0] == 1:
			ScMenuSetTitle 65535 25 0 "雷米菲利亞公國"
			TextSetPos -1 70 -1 -1
			TextSetName ""
			TextMessage null {
				{color 5}位於塞姆利亞大陸北部的公國。
				雖為氣候環境嚴峻的北方國家，
				但境內多處皆為森林與湖泊，
				故前去一睹自然美景、
				遊賞觀光的旅客也不在少數。{wait}
			} {
				此外，公國先進的醫療技術也相當有名，
				大陸主要的醫療機器品牌都在此設廠，
				醫術高明的醫師層出不窮。
				克洛斯貝爾自治州的聖烏爾斯拉醫科大學
				也是雷米菲利亞公國協助設立的。{color 0}{wait}
			}
			TextWait
			ED7_DB
			TextClose 0
			TextSetPos -1 280 60 3
			_59
			var[0] = 99
		if var[0] == 2:
			ScMenuSetTitle 65535 25 0 "列曼自治州"
			TextSetPos -1 70 -1 -1
			TextSetName ""
			TextMessage null {
				{color 5}位於塞姆利亞大陸中部的自治州。
				愛普斯泰恩財團的總部所在地，
				同時也是Ｃ・愛普斯泰恩博士的故鄉。{wait}
			} {
				除此之外，也是在大陸各地均設有分部的
				遊擊士協會著名的總部所在地。{color 0}{wait}
			}
			TextWait
			ED7_DB
			TextClose 0
			TextSetPos -1 280 60 3
			_59
			var[0] = 99
		if var[0] == 3:
			ScMenuSetTitle 65535 25 0 "利貝爾王國"
			TextSetPos -1 70 -1 -1
			TextSetName ""
			TextMessage null {
				{color 5}位於塞姆利亞大陸西部的王國。
				自然色彩濃厚的傳統國家，
				目前在老女王艾莉西亞Ⅱ世的治理之下，
				維持著光榮的和平。{wait}
			} {
				國力雖劣於周邊各國，
				但憑著境內豐富的七耀石資源、
				先進的技術以及精湛的外交策略，
				在國際上的地位也不落於人後。{wait}
			} {
				去年，謎樣的巨大建築物（細節不明）
				出現在王國中央的瓦雷利亞湖上，
				導致王國全境發生異變，陷入無法使用導力的狀況，
				最後經過軍方和遊擊士協會的努力，
				平安解決了此次事件，讓王國逐漸恢復平穩。{color 0}{wait}
			}
			TextWait
			ED7_DB
			TextClose 0
			TextSetPos -1 280 60 3
			_59
			var[0] = 99
		if var[0] == 4:
			ScMenuSetTitle 65535 25 0 "獵兵團／Jaeger"
			TextSetPos -1 70 -1 -1
			TextSetName ""
			TextMessage null {
				{color 5}專指在大陸各國活動的傭兵部隊當中，
				表現格外優異的部隊。{wait}
			} {
				由於其能因應戰鬥的規模與目的
				靈活改變合約、發揮強大的戰鬥力，
				故常被雇為私人部隊，
				大陸也有些國家明文禁止雇用獵兵團。{color 0}{wait}
			}
			TextWait
			ED7_DB
			TextClose 0
			TextSetPos -1 280 60 3
			_59
			var[0] = 99
	FadeIn 300ms 0x00000000
	TextEnd null
	Return

