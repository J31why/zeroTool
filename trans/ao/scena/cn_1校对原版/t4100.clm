fn[28]:
	FadeOut 300ms 0x00000000 100
	FadeWait
	TextSetPos -1 30 -1 -1
	TextSetName ""
	Menu menu[0] -1 -1 0
		"陪尼爾森分析事件" // 0
		"再考慮一下" // 1
	MenuWait var[0]
	MenuClose menu[0]
	TextClose 0
	TextSetPos -1 280 60 3
	FadeIn 300ms 0x00000000
	FadeWait
	switch var[0]:
		case 0:
			TextTalk name[0] {
				#00003F…………{wait}
			} {
				#00001F我知道了。
				請務必讓我一起分析。{wait}
			}
			TextWait
			TextTalk char[6] {
				謝謝你們。{wait}
			}
			TextWait
			TextTalk char[6] {
				在這裡不太方便，
				總之先回到城鎮裡吧。{wait}
			}
			TextWait
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[80] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextSetName ""
			TextMessage null {
				開始進行{color 2}委託【蓋・班寧斯遇害事件的分析】{color 0}！{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			FadeWait
			_59
			TextSetPos -1 280 60 3
			QuestFlagsSet quest[149] 0x02
			ED7_12 132 1000 50
			FadeOut 1000ms 0x00000000 255
			FadeWait
			BgmStop 4000ms
			BgmWait
			FlagSet flag[272]
			NewScene "scena/c0570.bin" 0 0 0
			Hcf
			break
		case 1:
			TextTalk name[0] {
				#00003F……不好意思。
				可以讓我考慮一下嗎？{wait}
			}
			TextWait
			TextTalk char[6] {
				嗯，沒問題。{wait}
			}
			TextWait
			TextTalk char[6] {
				我暫時會待在這裡，
				你準備好再來找我。{wait}
			}
			TextWait
			if !flag[9]:
				CharTurnTo char[6] 0deg 500deg/s
				_Char4B char[6] 255
				EventEnd 5
			FlagSet flag[3294]
			break
	Return

