fn[3]:
	if flag[2848] && !flag[2858] | flag[2369] && system[4] == 1:
		EffLoad eff[9] "map/mprain00.eff"
		EffPlay eff[9] eff_instance[7] null 0 (0, 0, 0) 0 0 0 1000 1000 1000 null (0, 0, 0) 1000ms
		MapColor 0x00B4B4B4 0ms
		Fog 0xFFD5B47B 0 360 0
		SoundPlay sound[128] 1 100 0
	if flag[3100]:
		MapColor 0x00FFEBDC 0ms
	else:
	if flag[2831] && !flag[2832]:
		MapColor 0x00B4BEFF 0ms
		Fog 0xFFA0B4DC 20 400 0
	elif flag[2367] && !flag[2369]:
		MapColor 0x00B4BEFF 0ms
		Fog 0xFFA0B4DC 20 400 0
	if !flag[2573] && flag[2564]:
		LookPointFlagsSet look_point[4] 0x0001
	SoundPlayContinuously sound[132] (-10120, 4000, 57000) 10000 100000 100 0
	ED7_E1 (1730, 4000, 57000)
	ED7_E1 (20320, 4000, 57000)
	TriggerFlagsSet trigger[0] 0x0080
	if !flag[2816] && flag[2573] && !flag[2649]:
		TriggerFlagsUnset trigger[0] 0x0080
	LookPointFlagsUnset look_point[1] 0x0001
	if flag[3090] && !flag[3093] && QuestFlagsGet quest[137] 0x10 && !QuestFlagsGet quest[149] 0x10:
		LookPointFlagsSet look_point[1] 0x0001
	Return

fn[4]:
	TextStart self
	if flag[3385]:
		if !flag[1]:
			TextTalk self {
				剛才警察有來找我做筆錄。{wait}
			}
			TextWait
			TextTalk self {
				沒想到伊安居然會做出這種事……
				我完全無法相信。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00001F……嗯，我們也是這麼想的。{wait}
			} {
				#00003F（……但是，這就是事實。
				　他的意圖只能透過訊問
				　才能了解吧……）{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				沒想到伊安居然會
				做出這種事……
				我完全無法相信。{wait}
			}
			TextWait
			TextTalk self {
				究竟是什麼原因
				讓他這麼做……？{wait}
			}
			TextWait
	elif flag[3371]:
		if !flag[3692]:
			TextTalk self {
				我才想說那個屏障終於消失，
				接著馬上就
				發生不得了的事。{wait}
			}
			TextWait
			TextTalk self {
				自從那個獨立宣言以來，
				來掃墓的人也變少了。{wait}
			}
			TextWait
			TextTalk self {
				在這種情況下，
				我能做的也只有打掃墳墓而已。{wait}
			}
			TextWait
			if QuestFlagsGet quest[149] 0x10:
				Emote name[0] 0mm 2000mm 24 27 250ms 0
				Sleep 1500ms
				EmoteStop name[65278]
				TextTalk name[0] {
					#00003F……請問，{wait}
				} {
					#00008F這邊的墳墓
					究竟是誰的呢？{wait}
				}
				TextWait
				Emote self 0mm 2000mm 38 38 250ms 1
				Sleep 1000ms
				TextTalk self {
					什麼？原來你不知道啊？{wait}
				}
				TextWait
				TextTalk self {
					……嗯，如果是你們的話，
					說出來也沒問題吧。
					畢竟你們似乎也跟『他』很親近。{wait}
				}
				TextWait
				TextTalk name[1] {
					#00105F咦……？{wait}
				}
				TextWait
				TextTalk name[3] {
					#00305F是我們認識的人嗎？{wait}
				}
				TextWait
				TextTalk self {
					……嗯。{wait}
				}
				TextWait
				TextTalk self {
					長眠在這裡的人們，
					姓氏是『格林伍德』……{wait}
				}
				TextWait
				TextTalk self {
					也就是
					伊安・格林伍德的家人。{wait}
				}
				TextWait
				Emote field_party[0] 0mm 2000mm 2 7 80ms 1
				SoundPlay sound[28] 0 100 0
				Sleep 30ms
				Emote field_party[1] 0mm 2000mm 2 7 80ms 1
				SoundPlay sound[28] 0 100 0
				Sleep 30ms
				Emote field_party[2] 0mm 2000mm 2 7 80ms 1
				SoundPlay sound[28] 0 100 0
				Sleep 30ms
				Emote field_party[3] 0mm 2000mm 2 7 80ms 1
				SoundPlay sound[28] 0 100 0
				Sleep 1000ms
				TextTalk name[2] {
					#00205F伊安律師的家人……！？{wait}
				}
				TextWait
				TextTalk name[1] {
					#00108F是、是這樣嗎……！？{wait}
				}
				TextWait
				TextTalk self {
					……肯定不會錯。{wait}
				}
				TextWait
				TextTalk self {
					大約在十五年前，
					因為一場不幸的意外，
					他的妻子跟孩子兩人喪生……{wait}
				}
				TextWait
				TextTalk self {
					他總是會在週末來掃墓，
					緬懷家人。{wait}
				}
				TextWait
				TextTalk self {
					雖然墳墓遭到風雨損傷……
					不過他似乎許下了某個心願。{wait}
				}
				TextWait
				TextTalk self {
					在心願實現之前，他刻意不進行修繕，
					只拜託我維護而已。{wait}
				}
				TextWait
				TextTalk name[1] {
					#00106F原來是這樣啊……{wait}
				}
				TextWait
				TextTalk name[3] {
					#00308F那位律師似乎經歷了許多事呢……{wait}
				}
				TextWait
				TextTalk self {
					在獨立宣言之後，他似乎也很忙碌，
					所以很難抽空過來……{wait}
				}
				TextWait
				TextTalk self {
					不介意的話，
					之後你們也來掃墓吧。
					……不然她們也會很寂寞吧。{wait}
				}
				TextWait
				TextTalk name[0] {
					#00003F…………{wait}
				} {
					#00000F……好的，我明白了。{wait}
				}
				TextWait
				FlagSet flag[3692]
		else:
			TextTalk self {
				在這種情況下，
				我能做的也只有打掃墳墓而已。{wait}
			}
			TextWait
			TextTalk self {
				……你們也要小心點喔。{wait}
			}
			TextWait
	elif flag[3089]:
	elif flag[2829]:
		if !flag[1]:
			TextTalk self {
				剛才伊安有過來教堂。{wait}
			}
			TextWait
			TextTalk self {
				看來是來為蓋跟
				亞里歐斯的妻子掃墓的樣子。{wait}
			}
			TextWait
			Emote self 0mm 2000mm 24 27 250ms 0
			Sleep 1000ms
			EmoteStop self
			TextTalk name[0] {
				#00005F呃……怎麼了嗎？{wait}
			}
			TextWait
			TextTalk self {
				……不，沒什麼。
				沒什麼大不了的。{wait}
			}
			TextWait
			TextTalk self {
				他最近似乎很忙，
				要是能散散心的話就好了。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				剛才，
				伊安有來掃蓋跟
				亞里歐斯的妻子墳墓。{wait}
			}
			TextWait
			TextTalk self {
				他最近似乎很忙，
				要是能散散心的話就好了。{wait}
			}
			TextWait
	elif flag[2816]:
		if !flag[1]:
			TextTalk self {
				如同市長所說，
				克洛斯貝爾或許真的
				需要成為獨立的國家。{wait}
			}
			TextWait
			TextTalk self {
				帝國跟共和國想必也會
				出手施壓吧，不過……{wait}
			}
			TextWait
			TextTalk self {
				為了接下來的年輕世代，
				無論如何都希望他成功呢。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
