fn[8]:
	TextStart self
	if flag[3385]:
		if PartyPosition name[8] > -1:
			if !flag[3539]:
				Call fn[0,9]
			elif !flag[3]:
				TextTalk self {
					如果老公還活著的話……{wait}
				}
				TextWait
				TextTalk self {
