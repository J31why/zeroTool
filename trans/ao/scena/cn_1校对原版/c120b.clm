fn[3]:
	ED7_F2 1
	SystemFlagsSet 0x08000000
	if !flag[3932]:
		SoundPlay sound[14] 0 100 0
		ED7_74 object[17] 0 30
		ED7ObjPlay object[17] 0 30 0 0
		Sleep 500ms
		if ItemAdd item[471] 1:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextSetName ""
			TextMessage name[742] {
				{color 0}已取得{item[471]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			TextSetPos -1 280 60 3
			FadeIn 300ms 0x00000000
			FlagSet flag[3932]
			ED7_DE 5
		else:
			FadeOut 300ms 0x00000000 100
			TextSetName ""
			TextMessage name[742] {
				寶箱裡裝有{item[471]}{color 0}。
				因持有物品已達上限，已放棄{item[471]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			SoundPlay sound[15] 0 100 0
			ED7ObjPlay object[17] 30 0 0 0
	else:
		FadeOut 300ms 0x00000000 100
		TextSetPos -1 -1 -1 -1
		TextSetName ""
		TextMessage name[742] {
			{0x06}{color 5}寶箱裡什麼都沒有。{color 0}{wait}
		}
		TextWait
		TextClose 0
		FadeIn 300ms 0x00000000
	Sleep 30ms
	TextEnd null
	SystemFlagsUnset 0x08000000
	Return

fn[4]:
	TextStart self
	if !flag[0]:
		TextTalk char[3] {
			#02306F導力網路上偶爾也會
			流傳那些傢伙的情報……{wait}
		} {
			#02310F但我從沒聽說他們是
			這麼危險的人物啊！？{wait}
		} {
			#02301F你們如果打算要去，
			一定要提高警覺喔！！{wait}
		}
		TextWait
		TextTalk name[0] {
			#00001F嗯……
			你們也要提高警覺，避難去吧。{wait}
		}
		TextWait
		FlagSet flag[0]
	else:
		TextTalk char[3] {
			#02306F那些人……尤其是紅髮大叔，
			實在太可怕了。{wait}
		} {
			#02301F你們如果打算要去，
			一定要提高警覺喔！！{wait}
		}
		TextWait
	TextEnd self
	Return

fn[5]:
	TextStart self
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"談話" // 0
			"請求回復" // 1
			"放棄" // 2
		MenuWait var[0]
		MenuClose menu[0]
		FadeIn 300ms 0x00000000
		FadeWait
		if var[0] == 1:
			TextTalk self {
				我知道了，交給我吧。{wait}
			}
			TextWait
			MenuClose menu[0]
			TextClose 0
			BgmStop 3000ms
			FadeOut 1000ms 0x00000000 255
			FadeWait
			_59
			SoundPlay sound[13] 0 100 0
			PartySetAttr name[255] 254 0
			CamLookChar field_party[0] 0ms
			Sleep 3500ms
			BgmResume
			FadeIn 1000ms 0x00000000
			TextClose 0
			TextTalk self {
				你們可要當心點啊！{wait}
			}
			TextWait
			var[0] = 99
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			TextTalk self {
				我把愛普斯泰恩財團
				正在開發中的攜帶型回復裝置
				帶出來了。{wait}
			}
			TextWait
			TextTalk self {
				你們如果需要治療，
				歡迎隨時跟我說！{wait}
			}
			TextWait
	TextEnd self
	Return

