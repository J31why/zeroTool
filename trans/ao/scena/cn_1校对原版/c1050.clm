npc char[3]:
	name "梅琳"
	pos (-2150, 100, 7010)
	angle 90deg
	flags 0x0185
	unk2 0
	chip chip[4]
	init fn[255,255]
	talk fn[0,7]
	unk4 255

fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharIdle self (1410, null, 9460) (-780, null, 4870) 1000mm/s
		Sleep 300ms
	Return

fn[2]:
	if flag[3385]:
	elif flag[3371]:
		CharFlagsUnset char[2] 0x0080
		CharSetChipBase char[2] chip[5]
		ForkFunc char[2] fork[0] fn[0,0]
		CharSetPos char[2] (1020, 0, 3500) 270deg
		CharSetPos char[0] (-800, 0, 3500) 90deg
		ForkFunc char[0] fork[0] fn[0,0]
		if !flag[2]:
			CharFlagsSet char[2] 0x0010
		CharFlagsSet char[0] 0x0010
		CharFlagsUnset char[3] 0x0080
		CharSetChipBase char[3] chip[6]
		ForkFunc char[3] fork[0] fn[0,0]
		CharSetPos char[3] (1040, 4019, 7540) 0deg
		CharSetPos char[1] (1040, 4019, 8540) 180deg
		CharFlagsSet char[1] 0x0010
	elif flag[3089]:
	elif flag[3074]:
		CharFlagsSet char[0] 0x0080
	elif flag[2861]:
	elif flag[2848]:
	elif flag[2837]:
		CharFlagsSet char[0] 0x0080
	elif flag[2832]:
		CharFlagsSet char[0] 0x0080
	elif flag[2816]:
	elif flag[2573]:
	elif flag[2564]:
	elif flag[2560]:
	elif flag[2369]:
		if QuestFlagsGet quest[107] 0x10:
			CharSetChipBase char[2] chip[3]
			CharSetChipPattern char[2] 0
			ForkQuit char[2] fork[0]
			CharFlags2Set char[2] 0x0004
			CharFlagsUnset char[2] 0x0080
			CharSetChipBase char[3] chip[4]
			CharSetChipPattern char[3] 0
			ForkQuit char[3] fork[0]
			CharFlags2Set char[3] 0x0004
			CharFlagsUnset char[3] 0x0080
	elif flag[2353]:
	Return

fn[3]:
	if flag[2848] && !flag[2858] | flag[2369] && system[4] == 1:
		ED7_76_0 object[255] "hikari00_add" 1
		ED7_76_0 object[255] "hikari01_add" 1
		SoundPlay sound[128] 1 50 0
	if !flag[3385] && flag[3370]:
		MapColor 0x00E6D2D2 0ms
		ED7_76_0 object[255] "hikari00_add" 1
		ED7_76_0 object[255] "hikari01_add" 1
	Return

fn[4]:
	TextStart self
	if flag[3385]:
		if !flag[0]:
			TextTalk self {
				雖然克洛斯貝爾
				已經漸漸恢復往常的平靜，
				但還有許多問題需要解決。{wait}
			}
			TextWait
			TextTalk self {
				因為與兩大國斷絕往來的關係，
				不管哪間商店都沒辦法
				準備足夠的商品。{wait}
			}
			TextWait
			TextTalk self {
				所以我們正一面努力和
				麥克道爾議長取得聯絡，
				一面努力思考對策。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				雖然克洛斯貝爾
				已經漸漸恢復往常的平靜，
				但還有許多問題需要解決。{wait}
			}
			TextWait
			TextTalk self {
				所以我們正一面努力和
				麥克道爾議長取得聯絡，
				一面努力思考對策。{wait}
			}
			TextWait
	elif flag[3371]:
		if !flag[0]:
			TextTalk self {
				嗯，我真擔心
				攤商們的安危啊。{wait}
			}
			TextWait
			TextTalk self {
				因為就算下達戒嚴令，還是有人
				無論如何都想繼續營業，
				所以我勉強答應了他們，可是……{wait}
			}
			TextWait
			TextTalk self {
				如果他們有什麼萬一，
				那可都是我的責任。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				嗯，我真擔心
				攤商們的安危啊。{wait}
			}
			TextWait
			TextTalk self {
				如果他們有什麼萬一，
				那都是在戒嚴令下允許他們營業的
				我的責任。{wait}
			}
			TextWait
	elif flag[3089]:
		if !flag[0]:
			TextTalk self {
				之前迪塔先生那次演說……
				麥克道爾議長完全
				沒有露面，這點挺讓人在意的。{wait}
			}
			TextWait
			TextTalk self {
				艾莉，
				妳知道什麼內情嗎？{wait}
			}
			TextWait
			TextTalk name[1] {
				#00103F……我也不知道。
				其實我也蠻在意這個的……{wait}
			}
			TextWait
			TextTalk self {
				嗯，這樣啊……
				妳一定也很擔心吧。{wait}
			}
			TextWait
			TextTalk self {
				無論如何，
				既然狀況已經變成這樣，
				那我們勢必會和兩大國間形成對立。{wait}
			}
			TextWait
			TextTalk self {
				為了預防萬一，我得透過
				工商會呼籲大家做好準備才行……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				既然事已至此，那我們
				勢必會和兩大國間形成對立。{wait}
			}
			TextWait
			TextTalk self {
				為了預防萬一，我得透過
				工商會呼籲大家做好準備才行……{wait}
			}
			TextWait
	elif flag[3074]:
	elif flag[2861]:
		if !flag[0]:
			TextTalk self {
				嗯，真沒想到竟然會在
				這公民投票即將舉行的時期
				發生這樣的事件……{wait}
			}
			TextWait
			TextTalk self {
				萬一沒弄好的話，
				這可能會成為帝國和共和國
				趁機介入的最好藉口。{wait}
			}
			TextWait
			TextTalk self {
				無論如何我們都得
				盡早解決這個問題才行。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				我們原本就已經
				在治安方面被帝國和
				共和國看出弱點了。{wait}
			}
			TextWait
			TextTalk self {
				無論如何我們都得
				盡早解決這個問題才行。{wait}
			}
			TextWait
	elif flag[2848]:
		if !flag[0]:
			TextTalk self {
				聽說昨天的列車事故
				其實是由身分不詳的怪物
				所引起的……{wait}
			}
			TextWait
			TextTalk self {
				嗯，那該不會跟
				最近常有人目擊的
				神秘怪物是同一種吧？{wait}
			}
			TextWait
			TextTalk self {
				不過最近各種狀況頻傳，
				你們也要提高警覺才行。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				雖然不知道引發列車事故的怪物
				和最近常有人目擊的
				神秘怪物是不是同一種……{wait}
			}
			TextWait
			TextTalk self {
				不過最近各種狀況頻傳，
				你們也要提高警覺才行。{wait}
			}
			TextWait
	elif flag[2837]:
	elif flag[2832]:
	elif flag[2816]:
		if !flag[0]:
			TextTalk self {
				克洛斯貝爾自治州的獨立……
				迪塔市長這宣言
				還真是大膽啊。{wait}
			}
			TextWait
			TextTalk self {
				不過，在這對國內外影響力
				都達到前所未有的巔峰的現在，
				說不定正是最好的時機啊。{wait}
			}
			TextWait
			TextTalk self {
				克洛斯貝爾的尊嚴已經因為長年
				遭到兩大國支配而逐漸喪失……{wait}
			}
			TextWait
			TextTalk self {
				雖然可能遭遇各種阻礙，
				不過我們還是希望能透過
				實現獨立的結果來重拾這份尊嚴。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				……對了，為了呼應
				推動獨立的市長最近逐漸拉抬的聲勢，
				我們正計畫舉行某項活動。{wait}
			}
			TextWait
			TextTalk self {
				這是跟克洛斯貝爾通訊社共同
				舉辦的企劃，應該能為市民帶來活力，
				各位就好好期待吧。{wait}
			}
			TextWait
	elif flag[2573]:
		if !flag[0]:
			TextTalk self {
				通商會議終於要開始了。{wait}
			}
			TextWait
			TextTalk self {
				我們小市民
				也只能等克洛斯貝爾
				時報周刊發佈結果了。{wait}
			}
			TextWait
			TextTalk self {
				好……這次會議
				到底會有什麼樣的結果呢？{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				如果可以的話，我真想
				親眼目睹會議進行的樣子。{wait}
			}
			TextWait
			TextTalk self {
				好……這次會議
				到底會有什麼樣的結果呢？{wait}
			}
			TextWait
	elif flag[2564]:
		TextTalk self {
			看來我孫子洛伊
			似乎開始對攤商的工作
			產生興趣了。{wait}
		}
		TextWait
		TextTalk self {
			……其實我原本也是個攤商，
			嗯，這也算是遺傳吧。{wait}
		}
		TextWait
	elif flag[2560]:
		if flag[3627] && !QuestFlagsGet quest[115] 0x10 && !QuestFlagsGet quest[115] 0x40:
			if !flag[3664]:
				Call fn[0,9]
			elif flag[3664]:
				TextTalk char[0] {
					嗯，真沒想到黑月
					長老的孫子竟然會
					跑到我們這裡來。{wait}
				}
				TextWait
				TextTalk char[0] {
					無論如何，
					如果他能喜歡上這個城市，
					我也會覺得很開心的。{wait}
				}
				TextWait
		else:
			TextTalk self {
				通商會議室由各國代表
				就經濟關係的議題
				進行各種協議。{wait}
			}
			TextWait
			TextTalk self {
				我們工商會也非常注意
				這會議的動向。{wait}
			}
			TextWait
	elif flag[2369]:
		if QuestFlagsGet quest[107] 0x02 && flag[2451]:
			if !QuestFlagsGet quest[107] 0x10:
				if !flag[2452]:
					if !flag[0]:
						TextTalk self {
							哎呀？這不是羅伊德嗎？
							發生什麼事啦？{wait}
						}
						TextWait
						TextTalk name[0] {
							#00000F呃……
							請問梅琳
							在家嗎？{wait}
						}
						TextWait
						TextTalk self {
							嗯，我記得她剛剛
							應該有回來……
							這下又跑到哪裡去啦？{wait}
						}
						TextWait
						TextTalk self {
							不好意思，你可以
							去問問奶奶嗎？{wait}
						}
						TextWait
						FlagSet flag[0]
					else:
						TextTalk self {
							因為我一直在工作，
							所以沒注意到
							孫子跑出去了。{wait}
						}
						TextWait
						TextTalk self {
							關於孫子的去處，你可以
							去問問奶奶嗎？{wait}
						}
						TextWait
				else:
					TextTalk self {
						好了，我得繼續處理
						工商會的工作了……{wait}
					}
					TextWait
			else:
				TextTalk self {
					雖然我很想
					好好唸洛伊
					那傢伙幾句……{wait}
				}
				TextWait
				TextTalk self {
					不過有梅琳在場
					實在不太方便。{wait}
				}
				TextWait
				TextTalk self {
					今天就先放他一馬吧。{wait}
				}
				TextWait
			TextEnd self
			Return
		if !flag[0]:
			TextTalk self {
				原本在教團事件之前
				舉辦的克洛斯貝爾預算會議，
				現在決定要重新進行一次。{wait}
			}
			TextWait
			TextTalk self {
				這次似乎會在新市長跟新議長
				主導下，重新將預算編列成
				不受特權影響的方案。{wait}
			}
			TextWait
			TextTalk self {
				嗯，這也表示
				市政終於要開始朝
				好的方向前進了。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				市政終於要開始朝
				好的方向前進了。{wait}
			}
			TextWait
			TextTalk self {
				這都是托了
				新市長跟新議長的福啊。{wait}
			}
			TextWait
	elif flag[2353]:
		if !flag[2425]:
			TextTalk self {
				哎呀……這不是羅伊德和
				麥克道爾議長家的大小姐嗎？{wait}
			}
			TextWait
			TextTalk self {
				好久不見啦，
				看到你這麼有精神，真是太好了。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00000F你好，摩爾斯會長。{wait}
			}
			TextWait
			TextTalk name[1] {
				#00100F別來無恙。{wait}
			}
			TextWait
			TextTalk name[4] {
				#10300F我記得他是管理東側大道商人的
				工商會會長對吧。{wait}
			}
			TextWait
			TextTalk name[8] {
				#10105F哦，就是他嗎……
				（我記得媽媽還是攤商時
				　好像也受過他照顧。）{wait}
			}
			TextWait
			TextTalk self {
				嗯，看來你們也有加入新血，
				特務支援課也終於要
				重新出發了是吧。{wait}
			}
			TextWait
			TextTalk self {
				我們這些市民
				也很期待你們的表現，
				好好努力吧。{wait}
			}
			TextWait
			FlagSet flag[2425]
		else:
			TextTalk self {
				我們也很期待
				你們將來的表現喔。{wait}
			}
			TextWait
			TextTalk self {
				如果有什麼事情需要幫忙，
				隨時都可以來找我。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[5]:
	if QuestFlagsGet quest[107] 0x02 && !QuestFlagsGet quest[107] 0x10 && !QuestFlagsGet quest[107] 0x40 && flag[2451] && !flag[2452]:
		Call fn[0,8]
		Return
	TextStart self
	if flag[3385]:
		if !flag[1]:
			TextTalk self {
				經歷過總統的拘捕事件以後，
				將來到底該怎麼辦……{wait}
			}
			TextWait
			TextTalk self {
				這對居住在克洛斯貝爾的人來說，
				應該就是最重要的事了吧。{wait}
			}
			TextWait
			TextTalk self {
				只要大家能集思廣益，一定能讓
				未來走向更好的方向。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				將來到底該怎麼辦……
				這對居住在克洛斯貝爾的人來說，
				應該就是最重要的事了吧。{wait}
			}
			TextWait
			TextTalk self {
				只要大家能集思廣益，一定能讓
				未來走向更好的方向。{wait}
			}
			TextWait
	elif flag[3371]:
		TextTalk self {
			因為有洛伊和爺爺
			守在外面，可怕的東西都不會
			過來這邊的。{wait}
		}
		TextWait
		TextTalk self {
			所以梅琳
			妳不用擔心啦。{wait}
		}
		TextWait
	elif flag[3089]:
		if !flag[1]:
			TextTalk self {
				迪塔先生的獨立宣言……
				我覺得那似乎還有點太早了……{wait}
			}
			TextWait
			TextTalk self {
				雖然我知道
				這世上的事物都會
				不斷改變，可是……{wait}
			}
			TextWait
			TextTalk self {
				不……克洛斯貝爾
				說不定已經到了不改變
				就無法生存的狀態了……{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				快速變遷的事物
				對我們老人家來說
				是相當可怕的。{wait}
			}
			TextWait
			TextTalk self {
				克洛斯貝爾
				說不定已經走到無法回頭的
				處境中了……{wait}
			}
			TextWait
	elif flag[3074]:
		TextTalk self {
			如果要找爺爺的話，
			他去市民會館處理工商會的事了。{wait}
		}
		TextWait
		TextTalk self {
			雖然這次的慈善活動
			洛伊好像也會幫忙，不過……
			到底會變成怎樣呢？{wait}
		}
		TextWait
	elif flag[2861]:
		TextTalk self {
			現在我們能做的事，大概也只剩
			向女神祈禱了吧。{wait}
		}
		TextWait
