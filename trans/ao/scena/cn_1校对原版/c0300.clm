		FadeIn 300ms 0x00000000
		FadeWait
		if var[0] == 1:
			QuestFlagsSet quest[105] 0x10
		elif var[0] == 2:
			QuestFlagsUnset quest[105] 0x10
	if QuestFlagsGet quest[105] 0x10 && !flag[2446]:
		TextTalk name[0] {
			#00005F這就是……
			昨天那些不良份子
			開著到處跑的導力車吧？{wait}
		}
		TextWait
		TextTalk name[1] {
