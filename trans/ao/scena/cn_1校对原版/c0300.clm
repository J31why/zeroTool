fn[0]:
	switch random % 8:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharWalkToPos self (2630, 0, -4370) 1000mm/s 0
		CharWalkToPos self (240, 0, -7350) 1000mm/s 0
		CharWalkToPos self (240, -750, -48720) 1000mm/s 0
		Sleep 500ms
		CharSetPos self (35280, 0, -4370) 45deg
	Return

fn[2]:
	while 1:
		CharWalkToPos self (240, 0, -7350) 2000mm/s 0
		CharWalkToPos self (2630, 0, -4370) 2000mm/s 0
		CharWalkToPos self (35280, 0, -4370) 2000mm/s 0
		Sleep 500ms
		CharSetPos self (240, -750, -48720) 0deg
	Return

fn[3]:
	if system[0] == 110:
		if global[7] == 2:
			CharSetPos field_party[0] (230, -750, -38720) 0deg
			CharSetPos field_party[1] (230, -750, -38720) 0deg
			CharSetPos field_party[2] (230, -750, -38720) 0deg
			CharSetPos field_party[3] (230, -750, -38720) 0deg
			if system[15] != 255:
				CharSetPos field_party[4] (230, -750, -38720) 0deg
				CharSetPos field_party[5] (230, -750, -38720) 0deg
			elif system[14] != 255:
				CharSetPos field_party[4] (230, -750, -38720) 0deg
			system[0] = 100
		else:
			CharSetPos field_party[0] (24330, 0, -4050) 270deg
			CharSetPos field_party[1] (24330, 0, -4050) 270deg
			CharSetPos field_party[2] (24330, 0, -4050) 270deg
			CharSetPos field_party[3] (24330, 0, -4050) 270deg
			if system[15] != 255:
				CharSetPos field_party[4] (24330, 0, -4050) 270deg
				CharSetPos field_party[5] (24330, 0, -4050) 270deg
			elif system[14] != 255:
				CharSetPos field_party[4] (24330, 0, -4050) 270deg
			CamSetDistance 24330 2000 -4050 0ms
			ED7CamRotate 45deg 33deg 0deg 0ms
			CamPers 600 0ms
			CamZoom 19500 0ms
			system[0] = 101
	global[7] = 7
	if system[0] == 111:
		Sc_C4Set 4096
	CharSetChipBase char[0] chip[0]
	CharSetChipPattern char[0] 0
	ForkQuit char[0] fork[0]
	CharFlags2Set char[0] 0x0004
	if flag[3385]:
		CharFlagsUnset char[8] 0x0080
	elif flag[3371]:
		CharFlagsSet char[0] 0x0080
		CharFlagsSet char[1] 0x0080
	elif flag[3089]:
		CharFlagsUnset char[7] 0x0080
	elif flag[3074]:
	elif flag[2861]:
	elif flag[2848]:
		CharFlagsSet char[0] 0x0080
		CharFlagsSet char[1] 0x0080
		CharFlagsUnset char[5] 0x0080
	elif flag[2837]:
		CharFlagsSet char[0] 0x0010
	elif flag[2832]:
		CharFlagsUnset char[2] 0x0080
		CharFlagsUnset char[3] 0x0080
		CharFlagsUnset char[4] 0x0080
		CharSetPos char[2] (-7580, 0, -5670) 225deg
		CharSetPos char[3] (-9090, 0, -5710) 135deg
		CharSetPos char[4] (-8560, 0, -7100) 0deg
		CharFlagsSet char[2] 0x0010
		if !flag[4]:
			CharFlagsSet char[4] 0x0010
	elif flag[2816]:
	elif flag[2573]:
	elif flag[2568]:
		CharSetPos char[1] (13450, 0, -4760) 45deg
		ForkFunc char[1] fork[0] fn[0,0]
	elif flag[2564]:
		if flag[3642] && !flag[3643]:
			CharFlagsUnset char[6] 0x0080
			if flag[2727] && !QuestFlagsGet quest[116] 0x10 && !QuestFlagsGet quest[116] 0x40:
				CharFlagsSet char[6] 0x0080
	elif flag[2560]:
	elif flag[2369]:
		CharFlagsSet char[0] 0x0080
		CharFlagsSet char[1] 0x0080
		CharFlagsUnset char[5] 0x0080
	elif flag[2353]:
	if flag[272]:
		FlagUnset flag[272]
		Event fn[0,20]
	elif flag[273]:
		FlagUnset flag[273]
		Event fn[0,29]
	elif flag[274]:
		FlagUnset flag[274]
		Event fn[0,31]
	elif flag[2357] && !flag[2366] && !flag[2437]:
		if system[0] == 100 | system[0] == 101:
			SystemFlagsSet 0x10000000
			Event fn[0,24]
	if flag[2374] && QuestFlagsGet quest[106] 0x10 && QuestFlagsGet quest[107] 0x10 && QuestFlagsGet quest[108] 0x10 && !flag[2375]:
		SystemFlagsSet 0x10000000
		Event fn[1,0]
	Return

fn[4]:
	FlagUnset flag[7]
	FlagSet flag[8]
	if flag[2848] && !flag[2858] | flag[2369] && system[4] == 1:
		EffLoad eff[9] "map/mprain00.eff"
		EffPlay eff[9] eff_instance[7] null 0 (0, 0, 0) 0 0 0 1000 1000 1000 null (0, 0, 0) 1000ms
		MapColor 0x00B4B4B4 0ms
		Fog 0xFFD5B47B 13 100 0
