		}
		TextWait
		TextTalk name[4] {
			#10300F呵呵，還真是
			委屈這台車了。{wait}
		}
		TextWait
	else:
		TextTalk name[0] {
			#00005F這是……
			這台導力車好誇張喔。{wait}
		}
		TextWait
		TextTalk name[4] {
			#10300F嗯哼，這設計
			也實在太高調了點吧。{wait}
		} {
			#10304F算了，像這種車子啊，
			要是車主配不上車，
			只會惹人發笑而已。{wait}
		}
		TextWait
	TextEnd null
	Return

