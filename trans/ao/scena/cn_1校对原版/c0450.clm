fn[11]:
	TextStart char[3]
	if !flag[3385] && flag[3371] && !flag[3582]:
		Emote char[3] 0mm 2000mm 38 38 250ms 1
		Sleep 1000ms
		TextTalk char[3] {
			哎呀呀，你們是警察……{wait}
		}
		TextWait
		TextTalk name[0] {
			#00000F是的，可以請您告訴我們
			這裡的情況嗎？{wait}
		}
		TextWait
		TextTalk char[3] {
			好的，本飯店目前
			除了原本的客人，
			亦收容了許多避難民眾。{wait}
		}
		TextWait
		TextTalk char[3] {
			糧食仍有儲備，
			因此我估計至少可以撐一個月左右……{wait}
		}
		TextWait
		TextTalk char[3] {
			但總之，由於無從得知
			外面的詳細情況，
			大家都非常不安。{wait}
		}
		TextWait
		TextTalk char[3] {
			目前混亂的規模還很小，
			但要是事情繼續發展下去……{wait}
		}
		TextWait
		TextTalk name[1] {
			#00104F這樣啊……{wait}
		}
		TextWait
		TextTalk name[0] {
			#00001F我們現在會馬上展開行動，
			設法解決這件事情。{wait}
		} {
			所以，能請您先暫時
			靜觀其變嗎？{wait}
		}
		TextWait
		TextTalk char[3] {
			好，我瞭解了。
			各位也請多加小心。{wait}
		}
		TextWait
		FlagSet flag[3582]
	if !flag[2485] && system[4] < 7:
		TextTalk char[3] {
			歡迎光臨《千禧飯店》。{wait}
		}
		TextWait
		TextTalk char[3] {
			哦呵呵，本飯店提供
			許多服務，能滿足客人們
			各式各樣的需求。{wait}
		}
		TextWait
		TextTalk char[3] {
			若各位有什麼需要的話，
			歡迎隨時吩咐。{wait}
		}
		TextWait
		_59
		FadeOut 300ms 0x00000000 100
		TextSetPos -1 -1 -1 -1
		SoundPlay sound[814] 0 100 0
		TextSetName ""
		TextMessage null {
			{color 5}在飯店或酒館住宿，
			即可回復ＣＰ。{wait}
		}
		TextWait
		TextMessage null {
			{color 5}在普通的酒館可回復１００ＣＰ，
			而在高級飯店則可回復２００ＣＰ。{wait}
		}
		TextWait
		TextClose 0
		FadeIn 300ms 0x00000000
		TextSetPos -1 280 60 3
		_59
		if !flag[2369]:
			FlagSet flag[0]
		FlagSet flag[2485]
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"交談" // 0
			"休息" // 1
			"放棄" // 2
		MenuWait var[0]
		if var[0] != 1:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			ShopOpen shop[69]
			var[0] = 99
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			if flag[3385]:
				TextTalk char[3] {
					在得知總統被捕後，
					避難的民眾們
					也都各自回家了。{wait}
				}
				TextWait
				TextTalk char[3] {
					至於那棵大樹，詳細情況仍然不明……
					但至少在霧靄消散後，
					這座城市也算是恢復平靜了。{wait}
				}
				TextWait
				TextTalk char[3] {
					總之，我們得
					趁現在盡可能做足
					所有能做的準備。{wait}
				}
				TextWait
			elif flag[3371]:
				if !flag[0]:
					TextTalk char[3] {
						在收到了戒嚴令和外出禁止令的
						通知後，本飯店立即將
						收容難民一事納入考量，但是……{wait}
					}
					TextWait
					TextTalk char[3] {
						那片霧靄與傀儡士兵的出現，
						實在出乎我們預料。{wait}
					}
					TextWait
					TextTalk char[3] {
						看來大家對總統的不滿
						似乎已經升高到了極限……{wait}
					}
					TextWait
					TextTalk char[3] {
						但真要說的話，我認為現階段，
						大家心中的不安比不滿更為強烈。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[3] {
						看來大家對總統的不滿
						似乎已經升高到了極限……{wait}
					}
					TextWait
					TextTalk char[3] {
						但真要說的話，我認為現階段，
						大家心中的不安比不滿更為強烈。{wait}
					}
					TextWait
			elif flag[3089]:
				if !flag[0]:
					TextTalk char[3] {
						那場演說的情況
						我已經透過飯店的
						導力網路看到了……{wait}
					}
					TextWait
					TextTalk char[3] {
						有不少來自外國的
						客人們看了之後
						相當驚慌失措。{wait}
					}
					TextWait
					TextTalk char[3] {
						希望大家都能
						順利回國……{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[3] {
						導力鐵路似乎
						將於今日停止運行……{wait}
					}
					TextWait
					TextTalk char[3] {
						但無論如何，都不能讓
						各位客人回不了家。{wait}
					}
					TextWait
					TextTalk char[3] {
						我得先把飛行船的航行狀況等
						情報都徹底掌握清楚。{wait}
					}
					TextWait
			elif flag[3074]:
				TextTalk char[3] {
					被夕陽與火焰染成一片火紅的歡樂街……
					那一天的光景，簡直
					只能用惡夢來形容。{wait}
				}
				TextWait
				TextTalk char[3] {
					……總之，我得竭盡所能，
					盡快讓大家
					恢復日常生活。{wait}
				}
				TextWait
			elif flag[2861]:
				TextTalk char[3] {
					在瑪因茲那邊，
					目前警備隊的隊員們
					似乎仍在奮戰。{wait}
				}
				TextWait
				TextTalk char[3] {
					警備隊真的是
					我們市民的驕傲。{wait}
				}
				TextWait
			elif flag[2848]:
				if !flag[0]:
					TextTalk char[3] {
						昨天在列車事故的影響下，
						鐵路的時刻表已經徹底亂掉了……{wait}
					}
					TextWait
					TextTalk char[3] {
						結果，甚至有些人得因此
						在克洛斯貝爾多居留一天。{wait}
					}
					TextWait
					TextTalk char[3] {
						不過，幸好到了今天早上
						已經完全恢復行駛了。{wait}
					}
					TextWait
					TextTalk char[3] {
						今早，我已經把
						所有行程因此延誤的客人
						都順利送走了。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[3] {
						今早，我已經把
						所有行程因此延誤的客人
						都順利送走了。{wait}
					}
					TextWait
					TextTalk char[3] {
						這都多虧了
						警備隊的努力。{wait}
					}
					TextWait
			elif flag[2837]:
				TextTalk char[3] {
