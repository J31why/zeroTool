	TextStart char[1]
	if !flag[3271]:
		TextTalk char[1] {
			好，該打掃囉……{wait}
		}
		TextWait
		TextTalk name[0] {
			#00003F（她應該能參加
			　選美大會的『女僕』組。）{wait}
		} {
			#00000F呃，不好意思。
			我有點事想跟妳商量……{wait}
		}
		TextWait
		TextSetName ""
		TextMessage null {
			{color 5}嘗試拜託她參加
			慈善活動的選美大會。{color 0}{wait}
		}
		TextWait
		TextClose 0
		_59
		TextTalk char[1] {
			你、你是說……選美大會嗎？{wait}
		}
		TextWait
		TextTalk char[1] {
			呃、那個，不好意思……
			非常感謝你的盛情邀約，
			不過我還有工作，實在無法抽身……{wait}
		}
		TextWait
		TextTalk name[0] {
			#00003F這樣啊……
			沒關係，是我們冒昧打擾了。{wait}
		}
		TextWait
		FlagSet flag[3271]
	else:
		TextTalk char[1] {
			要我參加選美大會，
			實在有點……{wait}
		}
		TextWait
		TextTalk char[1] {
			非常感謝你的盛情邀請，
			不過我還有工作，實在無法抽身……{wait}
		}
		TextWait
	TextEnd char[1]
	Return
