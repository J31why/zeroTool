fn[4]:
	TextStart self
	if flag[2608]:
	elif flag[2605]:
	elif flag[2604]:
	elif flag[2602]:
	elif flag[2601]:
		if !flag[11]:
			Call fn[0,5]
		else:
			TextTalk char[10] {
				#10304F呵呵，正如你所見，
				我被俱樂部的常客給絆住了。{wait}
			} {
				#10300F不過，我會速速搞定，
				保證準時集合不會遲到，
				儘管放心吧。{wait}
			}
			TextWait
	elif flag[2600]:
	elif flag[2597]:
	elif flag[2592]:
	TextEnd self
	Return

fn[5]:
	TextTalk char[2] {
		呵呵，不過還真巧呢。
		瓦奇你居然會跑來這裡。{wait}
	}
	TextWait
	TextTalk char[2] {
		要是早點跟我聯絡的話，
		要我陪你多久都行啊～{wait}
	}
	TextWait
	TextTalk char[10] {
		#10304F呵呵，我今天是跟朋友一起來的。{wait}
	} {
		#10302F抱歉，我等一下還有事情，
		今天就沒法陪妳太久了喔！{wait}
	}
	TextWait
	TextTalk char[2] {
		討厭～你這樣酷酷的，也好帥哦～㈱{wait}
	}
	TextWait
	TextTalk name[0] {
		#00006F（男、男公關用這種態度
		　回應沒問題嗎……？）{wait}
	}
	TextWait
	FlagSet flag[11]
	CharFlagsUnset char[10] 0x0010
	CharFlagsUnset char[2] 0x0010
	Return

fn[6]:
	Call fn[0,7]
	Return

fn[7]:
	TextStart char[0]
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"交談" // 0
			"買東西" // 1
			"放棄" // 2
		MenuWait var[0]
		if var[0] != 1:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			ShopOpen shop[102]
			var[0] = 99
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			if flag[2605]:
			elif flag[2601]:
				if !flag[0]:
					TextTalk char[0] {
						本餐廳這
						『幸運』之名，
						代表著『幸福』的意思。{wait}
					}
					TextWait
					TextTalk char[0] {
						為了要讓客人沉浸幸福的用餐時光，
						我們會竭盡最大的誠意
						來服務客人。{wait}
					}
					TextWait
					TextTalk char[0] {
						如果有需要服務的地方，
						請別客氣，儘管吩咐。{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[0] {
						為了要讓客人體驗幸福的用餐時光，
						我們會竭盡最大的誠意
						來服務客人。{wait}
					}
					TextWait
					TextTalk char[0] {
						如果有需要服務的地方，
						請別客氣，儘管吩咐。{wait}
					}
					TextWait
			elif flag[2597]:
				if !flag[0]:
					TextTalk char[0] {
						歡迎光臨餐廳《幸運》。{wait}
					}
					TextWait
					TextTalk char[0] {
						本店使用最高級的食材來
						做出最棒的料理，並讓您在
						最美的景緻中享用。{wait}
					}
					TextWait
					TextTalk char[0] {
						請您好好享受
						這優雅幸福的時光吧……{wait}
					}
					TextWait
					FlagSet flag[0]
				else:
					TextTalk char[0] {
						本店使用最高級的食材來
						做出最棒的料理，並讓您在
						最美的景緻中享用。{wait}
					}
					TextWait
					TextTalk char[0] {
						請您好好享受
						這優雅幸福的時光吧……{wait}
					}
					TextWait
	TextEnd char[0]
	Return

fn[8]:
	TextStart self
	if flag[2605]:
	elif flag[2601]:
		TextTalk self {
			主題樂園最近
			好像設置了新的
			遊樂設施呢。{wait}
		}
		TextWait
		TextTalk self {
			聽說很可怕，
			到底是怎樣的設施呢？{wait}
		}
		TextWait
	elif flag[2597]:
		if !flag[1]:
			TextTalk self {
				之前開放的湖畔沙灘，
				不論男女老少都相當受歡迎呢。{wait}
			}
			TextWait
			TextTalk self {
				天氣還會繼續熱下去，
				到米修拉姆的客人，
				似乎也比往年來得還多呢。{wait}
			}
			TextWait
			TextTalk self {
				嗯，我也好想去一次喔。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				之前開放的湖畔沙灘，
				不論男女老少都相當受歡迎呢。{wait}
			}
			TextWait
			TextTalk self {
				嗯，我也好想去一次喔。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[9]:
	TextStart self
	if flag[2605]:
	elif flag[2602]:
		if !flag[2]:
			TextTalk self {
				唉，瓦奇走掉了。{wait}
			}
			TextWait
			TextTalk self {
				歡樂的時光結束了，回到家裡
				又得照顧我那
				無趣的老公……{wait}
			}
			TextWait
			TextTalk self {
				我還是自己一個人買醉吧。{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			TextTalk self {
				唉，瓦奇走掉了。{wait}
			}
			TextWait
			TextTalk self {
				回到家裡又得照顧我那無趣的老公，
				我還是自己買醉吧。{wait}
			}
			TextWait
	elif flag[2601]:
		if !flag[11]:
			Call fn[0,5]
			TextEnd self
			CharSetChipPattern char[2] 2
			Return
		else:
			TextTalk self {
				瓦奇雖然是男公關，
				但偶爾也好酷喔。{wait}
			}
			TextWait
			TextTalk self {
				……不過，這也是他迷人的地方㈱{wait}
			}
			TextWait
			TextEnd self
			CharSetChipPattern char[2] 2
			Return
	elif flag[2597]:
	TextEnd self
	Return

