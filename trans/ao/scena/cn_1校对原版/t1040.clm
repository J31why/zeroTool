fn[3]:
	ED7_76_1 object[255] "t1040_sky" 1
	ED7_76_0 object[255] "t1040_sky_y" 1
	ED7_76_1 object[255] "t1040_sky01" 1
	ED7_76_0 object[255] "t1040_sky01_y" 1
	if flag[3385]:
