		CharWalkToPos self (-92260, 0, 15180) 2000mm/s 0
		CharWalkToPos self (-101100, 0, 15180) 2000mm/s 0
		CharWalkToPos self (-101100, 0, 5880) 2000mm/s 0
	Return

