fn[0]:
	while 1:
		ED7CharAnimation self 1000ms 0 1 2 3 4 3 2 1
	Return

fn[1]:
	while 1:
		ED7CharAnimation self 1000ms 0 1 2 3 4 3 2 1
	Return

fn[2]:
	while 1:
		ED7CharAnimation self 1500ms 0
	Return

fn[3]:
	if flag[272]:
		ObjFlagsSet object[2] 0x2000000
