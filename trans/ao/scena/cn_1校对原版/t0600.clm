			}
			TextWait
			TextTalk self {
				挖啊挖啊拼命挖……
				我們礦工就是該這樣！{wait}
			}
			TextWait
			FlagSet flag[4]
		else:
			TextTalk self {
				好久沒挖礦了。
				鼓起幹勁吧！{wait}
			}
			TextWait
			TextTalk self {
				喔喔──燃燒起鬥志了──！{wait}
			}
			TextWait
	elif flag[3362]:
	elif flag[3328]:
	elif flag[3074]:
		if !flag[4]:
			TextTalk self {
