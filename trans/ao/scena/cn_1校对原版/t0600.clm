fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharIdle self (-22530, null, 32590) (-15440, null, 27300) 1000mm/s
		Sleep 300ms
	Return

fn[2]:
	if flag[3385]:
	elif flag[3362]:
	elif flag[3328]:
	elif flag[3074]:
	elif flag[2848]:
	elif flag[2832]:
	elif flag[2816]:
		CharFlagsSet char[2] 0x0080
	elif flag[2573]:
	elif flag[2564]:
		CharFlagsSet char[0] 0x0080
		CharFlagsSet char[4] 0x0080
		CharFlagsSet char[1] 0x0080
		CharFlagsSet char[2] 0x0080
		CharFlagsSet char[3] 0x0080
	elif flag[2560]:
		CharFlagsSet char[2] 0x0080
		CharFlagsUnset char[5] 0x0080
		CharSetPos char[5] (-400, 50, 3770) 0deg
	elif flag[2389]:
		CharFlagsSet char[2] 0x0080
		CharFlagsSet char[3] 0x0080
		if !flag[4]:
			CharFlagsSet char[4] 0x0010
	Return

fn[3]:
	ED7_1D_0 0 1 0 (-22700, 0, 54850) 10000 2000 45000
	Return

fn[4]:
	TextSetName ""
	TextMessage null {
		{color 5}放有一本導力車雜誌『導力車狂熱vol.1』。{color 0}{wait}
	}
	TextWait
	TextClose 0
	_59
	TextSetPos -1 280 60 3
	if flag[393] && !ItemHas item[878] 0:
		SoundPlay sound[17] 0 100 0
		TextSetPos -1 -1 -1 -1
		TextSetName ""
		TextMessage null {
			記住了
			{color 2}『魅惑配色』{color 0}的噴漆樣式。{wait}
		}
		TextWait
		TextClose 0
		_59
		TextSetPos -1 280 60 3
		ItemAdd item[878] 1
	TextEnd null
	Return

fn[5]:
	TextStart self
	if flag[3385]:
		if !flag[0]:
			TextTalk self {
				我和鎮長商量，
				決定讓礦山再次開工。{wait}
			}
			TextWait
			TextTalk self {
				因為我認為……
				想讓瑪因茲這個城鎮向前走，
				礦山依然是不可或缺的存在。{wait}
			}
			TextWait
			TextTalk self {
				……嘿嘿，久違的挖礦。
				我要鼓足幹勁！！{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				這是久違的挖礦！
				我要鼓起幹勁了！！{wait}
			}
			TextWait
	elif flag[3362]:
	elif flag[3328]:
	elif flag[3074]:
		if !flag[0]:
			TextTalk self {
				瑪因茲被占領時，
				我們本來打算憑自己的力量
				趕走那群獵兵……{wait}
			}
			TextWait
			TextTalk self {
				但我去對抗他們時，
				輕易地就被打飛，
				有點傷到腰了。{wait}
			}
			TextWait
			TextTalk self {
				雖然受到的不是重傷，
				但米蘭達說我太亂來了，
				痛罵了我一頓。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				雖然有點傷到腰，
				但我毫不後悔
				我有抵抗。{wait}
			}
			TextWait
			TextTalk self {
				總之，真的
				很慶幸其他礦工和
				鎮上的人沒受傷。{wait}
			}
			TextWait
	elif flag[2848]:
		if !flag[0]:
			TextTalk self {
				在礦山會發生崩坍等事故
				和出現魔獸，
				礦工是拚了命在工作的。{wait}
			}
			TextWait
			TextTalk self {
				要持續那樣的工作，
				對彼此的信賴和對這份工作的榮耀心
				就是最重要的。{wait}
			}
			TextWait
			TextTalk self {
				最近礦工們很有團結力，
				就是因為他們
				越來越懂這點了吧。{wait}
			}
			TextWait
			TextTalk self {
				嘿嘿，被這麼棒的夥伴們包圍，
				真是我身為礦山長的福氣。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				礦工就某種意義上來說
				是賭上性命的工作。
				所以對彼此的信任很重要。{wait}
			}
			TextWait
			TextTalk self {
				嘿嘿，被這麼棒的夥伴們包圍，
				真是我身為礦山長的福氣。{wait}
			}
			TextWait
	elif flag[2832]:
		if !flag[0]:
			TextTalk self {
				瑪爾羅那傢伙
				今天特別有精神啊。{wait}
			}
			TextWait
			TextTalk self {
				到昨天為止還
				一臉像是世界末日的樣子……{wait}
			}
			TextWait
			TextTalk self {
				不過只要他有好好工作，
				我都沒有意見就是了。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				瑪爾羅那傢伙和昨天之前完全不同，
				非常有幹勁。{wait}
			}
			TextWait
			TextTalk self {
				嗯──雖然不太清楚……
				但只要他有好好工作，
				我就沒意見啦。{wait}
			}
			TextWait
	elif flag[2816]:
		if !flag[0]:
			TextTalk self {
				最近瑪爾羅
				那傢伙似乎無法
				專注於工作。{wait}
			}
			TextWait
			TextTalk self {
				我邀他去喝一杯散散心，
				他也拒絕我……
				到底是怎樣啊？{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				話說，岡茲那傢伙
				怎麼休息得特別久。{wait}
			}
			TextWait
			TextTalk self {
				真是的，每個傢伙
				都有夠鬆懈。{wait}
			}
			TextWait
	elif flag[2573]:
		if !flag[0]:
			TextTalk self {
				我記得今天是亞雷庫
				要去主日學校的日子。{wait}
			}
			TextWait
			TextTalk self {
				希望他和
				貝卡萊家的琦咪
				一起好好學習。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				因為我們這些礦工
				都是些沒學問的傢伙，{wait}
			}
			TextWait
			TextTalk self {
				希望亞雷庫他們
				能好好念書。{wait}
			}
			TextWait
	elif flag[2564]:
	elif flag[2560]:
		if !flag[0]:
			TextTalk self {
				（咕嚕～～……）{wait}
			}
			TextWait
			TextTalk self {
				……啊，糟糕。
				我忘記
				帶便當來了。{wait}
			}
			TextWait
			TextTalk self {
				工作告一段落
				再去拿好了……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				我完全忘記
				帶便當來了。{wait}
			}
			TextWait
			TextTalk self {
				工作告一段落
				再去拿好了……{wait}
			}
			TextWait
	elif flag[2389]:
		if !flag[0]:
			TextTalk self {
				雖然舊礦山的事很令人在意……
				但礦工的本分就是挖礦。{wait}
			}
			TextWait
			TextTalk self {
				那邊的事就交給岡茲和鎮長，
				我們專心工作吧。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				礦工的本分就是挖礦。
				不管發生了什麼事，都得專注於工作。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[6]:
	TextStart self
	if flag[3385]:
		if !flag[1]:
			TextTalk self {
				雖然目前發生異常狀況，
				大家都很辛苦……但我們得
				盡心盡力讓瑪因茲興盛起來。{wait}
			}
			TextWait
			TextTalk self {
				哈哈，那麼以來，
				也許總有一天琉卡
				就會願意回應我的心意。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				雖然目前發生異常狀況，
				大家都很辛苦……但我們得
				盡心盡力讓瑪因茲興盛起來。{wait}
			}
			TextWait
	elif flag[3362]:
	elif flag[3328]:
	elif flag[3074]:
		if !flag[1]:
			TextTalk self {
				從昨天開始，瑪因茲礦山
				終於也重新開工了。{wait}
			}
			TextWait
			TextTalk self {
				關於克洛斯貝爾的今後，
				雖然會令人忍不住想很多……
				但我只要多活動身體就對了。{wait}
			}
			TextWait
			TextTalk self {
				因為挖礦是我們礦工
				唯一能做到的事嘛。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				酒館的琉卡
				在城鎮被占領時
				好像相當害怕。{wait}
			}
			TextWait
			TextTalk self {
				雖然我除了挖礦以外，
				什麼都辦不到……
				希望他能早點打起精神。{wait}
			}
			TextWait
	elif flag[2848]:
		TextTalk self {
			托岡茲的福，
			我終於能
			專注於工作了。{wait}
		}
		TextWait
		TextTalk self {
			至少今晚我就
			請他吃一頓，
			表達我的感謝吧。{wait}
		}
		TextWait
	elif flag[2832]:
		if !flag[1]:
			TextTalk self {
				昨天岡茲硬是把我
				帶去酒館。{wait}
			}
			TextWait
			TextTalk self {
				然後琉卡來
				鼓勵最近一直
				無精打采的我。{wait}
			}
			TextWait
			TextTalk self {
				呼，看來我
				並沒有被她討厭……
				真是太好了。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				琉卡來鼓勵
				最近一直
				無精打采的我。{wait}
			}
			TextWait
			TextTalk self {
				呼，看來我
				並沒有被她討厭……
				真是太好了。{wait}
			}
			TextWait
	elif flag[2816]:
		if !flag[1]:
			TextTalk self {
				唉……
				感覺沒精神做任何事情。{wait}
			}
			TextWait
			TextTalk self {
				因為我八成被琉卡
				討厭了，所以去酒館
				會很尷尬……{wait}
			}
			TextWait
			TextTalk self {
				今天拜託看看能不能
				提早下班好了……{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				因為我八成被琉卡
				討厭了，所以去酒館
				會很尷尬……{wait}
			}
			TextWait
			TextTalk self {
				唉……無法專心工作。{wait}
			}
			TextWait
	elif flag[2573]:
		if !flag[1]:
			TextTalk self {
				我為什麼會在宴會時
				對琉卡說那種話啊。{wait}
			}
			TextWait
			TextTalk self {
				被她徹底無視了，
				而且趁喝醉時說那種話，
				又令人感覺特別遜……{wait}
			}
			TextWait
			TextTalk self {
				啊～……好想揍昨天的我
				揍個一百拳啊……{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				照那樣子來看，
				我是被琉卡討厭了吧……{wait}
			}
			TextWait
			TextTalk self {
				啊～……好想揍昨天的我
				揍個一百拳啊……{wait}
			}
			TextWait
	elif flag[2564]:
	elif flag[2560]:
		if !flag[1]:
			TextTalk self {
				嗯，岡茲剛才
				去找鎮長了。{wait}
			}
			TextWait
			TextTalk self {
				……唉，話說回來，
				昨天的琉卡
				好可愛啊。{wait}
			}
			TextWait
			TextTalk self {
				只要是為了那張笑容，
				我可能什麼都辦得到。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				……咦，那個小孩……
				不是礦山長的兒子嗎？{wait}
			}
			TextWait
			TextTalk self {
				他一個人
				來這種地方做什麼？{wait}
			}
			TextWait
	elif flag[2389]:
		if !flag[1]:
			TextTalk self {
				最近岡茲很積極樂觀。
				和以前
				滿口怨言的他有天差地別。{wait}
			}
			TextWait
			TextTalk self {
				他受到那場教團事件牽連，
				讓我們很擔心的那件事，
				似乎帶給他很大的影響。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				雖然他還是一樣
				常拖著我陪他喝酒和
				去賭場啦……{wait}
			}
			TextWait
			TextTalk self {
				但畢竟是老朋友，這點程度
				就睜一隻眼閉一隻眼吧。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[7]:
	TextStart self
	if flag[3385]:
		if !flag[2]:
			TextTalk self {
				現在已經可以去市區，
				我本來覺得
				去賭場玩也不錯……{wait}
			}
			TextWait
			TextTalk self {
				但現在還是
				必須努力工作才行。{wait}
			}
			TextWait
			TextTalk self {
				好──我要認真了！{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			TextTalk self {
				等工作結束後，
				就要盡情地去賭場玩！{wait}
			}
			TextWait
			TextTalk self {
				好──我要認真了！{wait}
			}
			TextWait
	elif flag[3362]:
	elif flag[3328]:
	elif flag[3074]:
		if !flag[2]:
			TextTalk self {
				占領瑪因茲的獵兵團的
				幹部級人物的女兒，我之前
				總覺得有點眼熟……{wait}
			}
			TextWait
			TextTalk self {
				看來她就是之前在瑪因茲
				大量買走大顆七耀石的那群人
				當中的女孩子。{wait}
			}
			TextWait
			TextTalk self {
				那樣的女孩居然
				把警備隊打得落花流水……
				我到現在還是難以置信。{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			TextTalk self {
				那樣的女孩居然
				把警備隊打得落花流水……
				我到現在還是難以置信。{wait}
			}
			TextWait
			TextTalk self {
				真的是一場惡夢。{wait}
			}
			TextWait
	elif flag[2848]:
		if !flag[2]:
			TextTalk self {
				今天早上我挖到了這～麼大顆的
				蒼耀石結晶。{wait}
			}
			TextWait
			TextTalk self {
				嘿嘿，總覺得最近
				在工作方面的狀況也超好。{wait}
			}
			TextWait
			TextTalk self {
				希望就照這樣，
				在賭場的運氣也越來越好～{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			TextTalk self {
				嘿嘿，總覺得最近
				在工作方面的狀況也超好。{wait}
			}
			TextWait
			TextTalk self {
				希望就照這樣，
				在賭場的運氣也越來越好～{wait}
			}
			TextWait
	elif flag[2832]:
		TextTalk self {
			看來瑪爾羅那傢伙
			也恢復精神了。{wait}
		}
		TextWait
		TextTalk self {
			嘿嘿，真是讓人費心的傢伙。{wait}
		}
		TextWait
	elif flag[2816]:
	elif flag[2573]:
		if !flag[2]:
			TextTalk self {
