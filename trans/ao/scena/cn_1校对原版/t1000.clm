fn[4]:
	if flag[2602] && !flag[2604] && !flag[2773]:
		Call fn[0,12]
		Return
	TextStart self
	if flag[2608]:
	elif flag[2605]:
	elif flag[2604]:
	elif flag[2602]:
		if !flag[2773]:
	elif flag[2601]:
	elif flag[2600]:
	elif flag[2597]:
	TextEnd self
	Return

fn[5]:
	TextStart self
	if flag[2605]:
	elif flag[2601]:
		TextTalk char[0] {
			哎呀哎呀，邊看湖上美景邊等，
			也是別有樂趣啊。{wait}
		}
		TextWait
		TextTalk char[0] {
			四處走也是有點累，
			不如就在這裡等吧。{wait}
		}
		TextWait
	elif flag[2597]:
	TextEnd self
	Return

fn[6]:
	TextStart self
	if flag[2605]:
	elif flag[2601]:
		TextTalk char[1] {
			水上巴士
			好像還沒來呢。{wait}
		}
		TextWait
		TextTalk char[1] {
			我看我們
			還是再去玩一下吧。{wait}
		}
		TextWait
	elif flag[2597]:
	TextEnd self
	Return

fn[7]:
	TextStart self
	if flag[2605]:
	elif flag[2601]:
	elif flag[2597]:
		TextTalk char[2] {
			唉，你真是的……{wait}
		}
		TextWait
		TextTalk char[2] {
			別在真的要上船時，
			講些會讓人覺得
			不安的話好嗎？{wait}
		}
		TextWait
	TextEnd self
	Return

fn[8]:
	TextStart self
	if flag[2605]:
	elif flag[2601]:
		TextTalk char[3] {
			我想先暫時離開
			米修拉姆的喧囂。{wait}
		}
		TextWait
		TextTalk char[3] {
			這裡真是個好地方，感覺好療癒啊……{wait}
		}
		TextWait
	elif flag[2597]:
		TextTalk char[3] {
			呃，有沒有把東西
			忘在飯店了？{wait}
		}
		TextWait
		TextTalk char[3] {
			……應該沒有吧。
			………………大概啦。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[9]:
	TextStart self
	if flag[2605]:
	elif flag[2601]:
	elif flag[2597]:
		TextTalk char[4] {
			我和男朋友
			走散了。{wait}
		}
		TextWait
		TextTalk char[4] {
			真是的，要是他再不來，
			我就要先回家了。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[10]:
	TextStart self
	if flag[2605]:
	elif flag[2601]:
	elif flag[2597]:
		TextTalk char[5] {
			我的女朋友
			好像已經走到前面去了。{wait}
		}
		TextWait
		TextTalk char[5] {
			唉，她到底走到哪裡去了？
			我得在水上巴士出發前找到她……{wait}
		}
		TextWait
	TextEnd self
	Return

fn[11]:
	TextStart self
	if flag[2605]:
	elif flag[2601]:
	elif flag[2597]:
		TextTalk char[6] {
			本班水上巴士
			即將出發前往
			克洛斯貝爾碼頭。{wait}
		}
		TextWait
		TextTalk char[6] {
			要搭乘的旅客，
			請盡快搭乘──{wait}
		}
		TextWait
	elif flag[2592]:
	TextEnd self
	Return

fn[12]:
	EventBegin 0
	_Char4A char[7] 255
	CrossFade 500ms
	CamSetDistance -9680 -800 -26810 0ms
	ED7CamRotate 314deg 20deg 0deg 0ms
	CamPers 300 0ms
	CamZoom 30350 0ms
	CharSetPos name[0] (-7850, -2000, -27000) 270deg
	CharSetPos name[82] (-7850, -2000, -26200) 270deg
	FadeWait
	Sleep 2000ms
	EmoteStop char[7]
	TextTalk char[7] {
		#01803F……呼……{wait}
	}
	TextWait
	TextTalk name[0] {
		#12P#00005F……莉夏？
		原來妳在這裡啊。{wait}
	}
	TextWait
	Emote char[7] 0mm 2000mm 38 38 250ms 1
	Sleep 1000ms
	CharTurnTo char[7] 90deg 500deg/s
	TextTalk char[7] {
		#01805F羅伊德、琪雅……{wait}
	}
	TextWait
	TextTalk name[82] {
		#01105F我說啊，莉夏，
		妳怎麼看起來沒什麼精神啊？{wait}
	}
	TextWait
	TextTalk name[0] {
		#12P#00000F是不是有什麼煩惱？
		妳可以告訴我……{wait}
	}
	TextWait
	TextTalk char[7] {
		#01809F啊、沒有啦，沒什麼大不了的……{wait}
	} {
		#01804F我只是在想，原來除了歡樂街之外，
		還有這麼熱鬧的地方，
		所以有點精神疲勞。{wait}
	} {
		#01802F不過在這裡吹吹風後，
		感覺心情輕鬆多了。{wait}
	}
	TextWait
	TextTalk name[0] {
		#12P#00003F……這樣啊，那就好。{wait}
	}
	TextWait
	TextTalk name[82] {
		#01108F莉夏，妳真的沒事嗎？{wait}
	}
	TextWait
	TextTalk char[7] {
		#01809F嗯，我已經沒事了。{wait}
	} {
		#01803F那麼，羅伊德先生。
		我要去
		伊莉雅小姐那邊一下。{wait}
	} {
		#01802F集合時
		我會和大家一起去，
		請不用擔心。{wait}
	}
	TextWait
	TextTalk name[0] {
		#12P#00005F啊、好……{wait}
	}
	TextWait
	CharFlagsSet char[7] 0x0040
	CamSetDistance -7800 -800 -26950 4000ms
	ForkFunc char[7] fork[3] fn[0,13]
	Sleep 300ms
	ForkLoop name[0] fork[2]:
		CharTurnToChar self char[7] 500deg/s
	ForkLoop name[82] fork[2]:
		CharTurnToChar self char[7] 500deg/s
	ForkWait char[7] fork[3]
	CharFlagsSet char[7] 0x0080
	ForkQuit name[0] fork[255]
	ForkQuit name[82] fork[255]
	Emote name[0] 0mm 2000mm 24 27 250ms 0
	Sleep 2000ms
	EmoteStop name[0]
	CharTurnToChar name[82] name[0] 500deg/s
	Emote name[82] 0mm 1700mm 0 1 250ms 2
	SoundPlay sound[29] 0 100 0
	Sleep 1000ms
	TextTalk name[82] {
		#01105F羅伊德，你怎麼了？{wait}
	}
	TextWait
	CharTurnToChar name[0] name[82] 500deg/s
	TextTalk name[0] {
		#6P#00003F……不，沒什麼。{wait}
	} {
		#00000F我們也快出發吧。{wait}
	}
	TextWait
	_59
	FlagSet flag[2773]
	CharSetPos field_party[0] (-8850, -2000, -26600) 270deg
	ED7_Cam69 255 0
	EventEnd 5
	Return

