fn[41]:
	EventBegin 2
	SystemFlagsUnset 0x00000020
	FadeOut 300ms 0x00000000 100
	TextSetName ""
	TextSetPos -1 -1 -1 -1
	TextMessage null {
		{color 5}往《克洛斯貝爾》水上巴士・時刻表

		　 ※歡迎您
		　       再次搭乘！{wait}
	}
	TextWait
	TextClose 0
	FadeIn 300ms 0x00000000
	_59
	TextSetPos -1 280 60 3
	EventEnd 3
	Return

fn[42]:
	EventBegin 2
	SystemFlagsUnset 0x00000020
	if !flag[0]:
		TextTalk name[0] {
			#00005F這艘紅色的導力船……{wait}
		}
		TextWait
		TextTalk name[1] {
			#00101F嗯，看來這就是
			亞里歐斯他們
			搭乘的小船沒錯吧。{wait}
		}
		TextWait
		TextTalk name[0] {
			#00003F……總之，
			我們得快點追上他們才行。{wait}
		}
		TextWait
		FlagSet flag[0]
	else:
		TextSetName ""
		TextMessage null {
			{color 5}這裡停泊著一艘紅色的導力船。{color 0}{wait}
		}
		TextWait
		TextClose 0
		_59
		TextSetPos -1 280 60 3
	EventEnd 3
	Return
