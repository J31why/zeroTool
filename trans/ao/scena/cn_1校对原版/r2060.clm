				SoundPlay sound[807] 0 100 0
				TextSetName ""
				TextMessage null {
					{color 5}舊礦山的門牢牢關著。{color 0}{wait}
				}
				TextWait
				TextClose 0
				_59
				TextTalk name[0] {
					#00000F委託提到舊礦山這邊出現了
					通緝魔獸，可是……{wait}
				}
				TextWait
				TextTalk name[1] {
					#00100F或許我們應該先找鎮長
					商量一下比較好。{wait}
				}
				TextWait
				FlagSet flag[3]
			else:
				SoundPlay sound[807] 0 100 0
				TextSetName ""
				TextMessage null {
