	else:
		SoundPlay sound[807] 0 100 0
		TextSetName ""
		TextMessage null {
			{color 5}舊礦山的門牢牢關著。{wait}
		} {
			使用向鎮長借來的備用鑰匙
			應該就能打開了。{color 0}{wait}
		}
		TextWait
		TextClose 0
		_59
		FadeOut 300ms 0x00000000 100
		FadeWait
		Menu menu[0] -1 -1 0
			"使用鑰匙" // 0
			"不使用" // 1
		MenuWait var[0]
		MenuClose menu[0]
		FadeIn 300ms 0x00000000
		FadeWait
		if var[0] == 0:
			SoundPlay sound[806] 0 100 0
			TextSetName ""
			TextMessage null {
				{color 5}門鎖打開了。{color 0}{wait}
			}
			TextWait
			TextClose 0
			_59
			FlagSet flag[2684]
			ObjFlagsSet object[5] 0x0010
			LookPointFlagsSet look_point[6] 0x0001
		else:
	TextEnd null
	Return
