fn[11]:
	TextStart self
	if !flag[2]:
		TextTalk self {
			這裡是舊礦山的入口。
			各位要是準備好了，就開始調查吧。{wait}
		}
		TextWait
		TextTalk self {
			……可是，要破壞
			這麼堅固的門……{wait}
		}
		TextWait
		TextTalk self {
			即使我們平時有在鍛鍊，
			也沒有這樣的能耐啊。{wait}
		}
		TextWait
		TextTalk self {
			也不知道是什麼人破壞的……
			要去調查的話，千萬要當心啊。{wait}
		}
		TextWait
		FlagSet flag[2]
	else:
		TextTalk self {
			這裡是舊礦山的入口。
			各位要是準備好了，就開始調查吧。{wait}
		}
		TextWait
	TextEnd self
	Return

