look_point[0]:
	pos (-40820, 0, 40910)
	radius 1500
	bubble_pos (-40820, 1500, 40910)
	unk1 124
	unk2 0
	function fn[0,9]
	unk3 0
	unk4 0

fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharIdle self (-2500, null, 0) (2500, null, 1850) 1000mm/s
		Sleep 300ms
	Return

fn[2]:
	while 1:
		CharIdle self (-1870, null, 6710) (1860, null, 9950) 1000mm/s
		Sleep 300ms
	Return

fn[3]:
	while 1:
		CharIdle self (40970, null, 41050) (45850, null, 45600) 1000mm/s
		Sleep 300ms
	Return

fn[4]:
	if flag[3385]:
	elif flag[3371]:
		CharSetPos char[0] (810, 0, 500) 270deg
		ForkFunc char[0] fork[0] fn[0,0]
		CharSetPos char[1] (-810, 0, 500) 90deg
	elif flag[3089]:
	elif flag[3074]:
		if QuestFlagsGet quest[143] 0x10:
			CharFlagsSet char[1] 0x0080
	elif flag[2861]:
	elif flag[2848]:
	elif flag[2837]:
		CharFlagsSet char[1] 0x0080
	elif flag[2832]:
	elif flag[2816]:
	elif flag[2573]:
	elif flag[2568]:
	elif flag[2564]:
	elif flag[2560]:
	elif flag[2369]:
		CharSetPos char[1] (-42190, 0, 48970) 0deg
		CharFlagsSet char[1] 0x0010
	elif flag[2353]:
		if !flag[2465]:
			CharFlagsSet char[0] 0x0010
	Return

fn[5]:
	LookPointFlagsSet look_point[0] 0x0001
	if QuestFlagsGet quest[135] 0x02 && !QuestFlagsGet quest[135] 0x10 && !QuestFlagsGet quest[135] 0x40 && flag[3003]:
		LookPointFlagsUnset look_point[0] 0x0001
	if flag[2848] && !flag[2858] | flag[2369] && system[4] == 1:
		ED7_76_0 object[255] "light01" 1
		ED7_76_0 object[255] "model05_light" 1
		SoundPlay sound[128] 1 50 0
	if !flag[3385] && flag[3370]:
		MapColor 0x00E6D2D2 0ms
		ED7_76_0 object[255] "light01" 1
		ED7_76_0 object[255] "model05_light" 1
	Return

fn[6]:
	TextStart self
	if flag[3385]:
		if !flag[0]:
			TextTalk self {
				老爺他好像要接手
				今後蘭花塔的指揮權。{wait}
			}
			TextWait
			TextTalk self {
				現在總統已經被逮捕，
				能夠帶領克洛斯貝爾的，
				只有老爺一個人了。{wait}
			}
			TextWait
			TextTalk self {
				想必這會是很沉重的負荷……
				但也只能請老爺努力下去了。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				現在總統已經被逮捕，
				能夠帶領克洛斯貝爾的，
				只有老爺一個人了。{wait}
			}
			TextWait
			TextTalk self {
				想必這會是很沉重的負荷……
				但也只能請老爺努力下去了。{wait}
			}
			TextWait
	elif flag[3371]:
		if !flag[3687]:
			Call fn[0,7]
		else:
			TextTalk self {
				自從老爺和大小姐
				被拘束在米修拉姆後，
				我實在擔心得不得了，不過……{wait}
			}
			TextWait
			TextTalk self {
				現在親眼看到人，
				總算讓我真正放下心來。{wait}
			}
			TextWait
	elif flag[3089]:
		if !flag[3170]:
			CharTurnToChar self name[1] 0deg/s
			TextTalk self {
				……大小姐……
				老爺他有和您
				連絡嗎？{wait}
			}
			TextWait
			TextTalk name[1] {
