	if !flag[3269]:
		TextTalk char[3] {
			啊，歡迎光臨～{wait}
		}
		TextWait
		TextTalk char[3] {
			請自由選擇喜歡的位置入座。
			我稍後會為您點餐。{wait}
		}
		TextWait
		TextTalk name[0] {
			#00003F（如果是她，
			　或許可以邀請她參加
			　選美大會的『女服務生』項目。）{wait}
		} {
			#00000F呃，不好意思。
			我有點事想跟妳商量……{wait}
		}
		TextWait
		TextSetName ""
		TextMessage null {
			{color 5}嘗試拜託她參加
			慈善活動的選美大會。{color 0}{wait}
		}
		TextWait
		TextClose 0
		_59
		TextTalk char[3] {
			咦？咦咦？
			參加選美大會？{wait}
		}
		TextWait
		TextTalk char[3] {
			嗯……
			非常抱歉……
			我沒什麼興趣。{wait}
		}
		TextWait
		TextTalk name[0] {
			#00012F這、這樣啊……
			恕我們冒昧打擾了。{wait}
		}
		TextWait
		FlagSet flag[3269]
	else:
		TextTalk char[3] {
			我對參加選美大會
			沒什麼興趣。{wait}
		}
		TextWait
		TextTalk char[3] {
			如果只是當服務生
			去幫忙的話，
			或許還可以。{wait}
		}
		TextWait
	TextEnd char[3]
	Return
