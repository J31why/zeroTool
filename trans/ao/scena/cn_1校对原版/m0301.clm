fn[0]:
	while 1:
		ED7CharAnimation self 1000ms 0 1 2 3 4
	Return

fn[1]:
	if flag[272]:
		FlagUnset flag[272]
		Event fn[0,16]
	if system[0] == 106 && flag[2587] && !flag[2588]:
		Event fn[0,11]
	if system[0] == 116 && flag[2588] && !flag[2590]:
		Event fn[0,15]
	if system[0] == 0 + 100:
		Event fn[0,7]
	if system[0] == 21 + 100:
		Event fn[0,9]
	Return

fn[2]:
	Sc_C4Unset 32
	if flag[2585] && !flag[2591]:
		Sc_C4Set 8
	if flag[2586] && !flag[2587]:
		EntranceSetFunc entrance[5] fn[0,10]
	TriggerFlagsSet trigger[0] 0x0080
	if !flag[2589]:
		TriggerFlagsUnset trigger[0] 0x0080
	ObjFlagsSet object[2] 0x0004
	FlagSet flag[0]
	ED7_76_2 object[255] "Null_onoff" "on"
	EntranceSetDisabled entrance[0] 0
	EntranceSetDisabled entrance[21] 0
	if system[0] == 0 + 100:
		ED7_76_0 object[19] "Null_color" 1
		ED7_76_1 object[19] "Null_color2" 1
	else:
		ED7_76_1 object[19] "Null_color" 1
		ED7_76_0 object[19] "Null_color2" 1
	if system[0] == 21 + 100:
		ED7_76_1 object[20] "Null_color" 1
		ED7_76_0 object[20] "Null_color2" 1
	else:
		ED7_76_0 object[20] "Null_color" 1
		ED7_76_1 object[20] "Null_color2" 1
	if !flag[3973]:
		ObjFrame object[3] 0
	else:
		ObjFrame object[3] 30
	if !flag[3974]:
		ObjFrame object[4] 0
	else:
		ObjFrame object[4] 30
	ED7_1C 0 object[5] 0 50 fn[0,5] flag[0] 0
	EffLoad eff[16] "event\\eva00_00.eff"
	if !flag[2589] && system[0] == 110:
		SoundLoad sound[825]
		SoundLoad sound[455]
		SoundLoad sound[451]
	Return

fn[3]:
	SystemFlagsSet 0x08000000
	if !flag[3973]:
		SoundPlay sound[14] 0 100 0
		ED7_74 object[3] 0 30
		ED7ObjPlay object[3] 0 30 0 0
		Sleep 500ms
		if !flag[4317]:
			CharColor char[2] 0x00FFFFFF 0ms
			CharTurnToChar char[2] field_party[0] 0deg/s
			_Char91 char[2] 0 1000 0 0 0
			Fork char[2] fork[1]:
				_Char91 self 0 -1000 0 1000 0
			Fork char[2] fork[2]:
				CharColor self 0xFFFFFFFF 1000ms
			CharFlagsUnset char[2] 0x0080
			CharFlagsSet char[2] 0x8000
			TextMessage name[742] {
				{color 5}魔獸出現了！{color 0}{wait}
			}
			TextWait
			TextClose 0
			ForkWait char[2] fork[1]
			ED7Battle battle[3] null 0 0 11 null
			CharFlagsSet char[2] 0x0080
			CharFlagsUnset char[2] 0x8000
			switch system[3]:
				case 0:
					FlagSet flag[4317]
					ObjFrame object[3] 30
					Sleep 500ms
					break
				case 2:
					ObjFrame object[3] 0
					TextEnd null
					SystemFlagsUnset 0x08000000
					Return
				case 1:
					ReturnToTitle 0
					Return
		if ItemAdd item[160] 1:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextMessage name[742] {
				{color 0}已取得{item[160]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			TextSetPos -1 280 60 3
			FadeIn 300ms 0x00000000
			FlagSet flag[3973]
			ED7_DE 5
		else:
			FadeOut 300ms 0x00000000 100
			TextMessage name[742] {
				寶箱裡裝有{item[160]}{color 0}。
				因持有物品已達上限，已放棄{item[160]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			SoundPlay sound[15] 0 100 0
			ED7ObjPlay object[3] 30 0 0 0
	else:
		FadeOut 300ms 0x00000000 100
		TextMessage name[742] {
			{0x06}{color 5}寶箱裡什麼都沒有。{color 0}{wait}
		}
		TextWait
		TextClose 0
		FadeIn 300ms 0x00000000
	Sleep 30ms
	TextEnd null
	SystemFlagsUnset 0x08000000
	Return

