fn[0]:
	switch random % 8:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		ED7CharAnimation self 1000ms 0 1 2 3 4
	Return

fn[2]:
	if !flag[3385] && flag[3371]:
		Call fn[0,24]
	if flag[272]:
		FlagUnset flag[272]
		Event fn[0,34]
	elif flag[273]:
		FlagUnset flag[273]
		FlagSet flag[0]
		Event fn[0,35]
	if system[0] == 15 + 100:
		Event fn[0,28]
	if system[4] >= 7:
		CharFlagsSet char[17] 0x0080
		CharFlagsSet char[18] 0x0080
		CharFlagsSet char[19] 0x0080
		CharFlagsSet char[20] 0x0080
		CharFlagsSet char[21] 0x0080
		CharFlagsSet char[22] 0x0080
		CharFlagsSet char[23] 0x0080
		CharFlagsSet char[24] 0x0080
		CharFlagsSet char[25] 0x0080
		CharFlagsSet char[26] 0x0080
		CharFlagsSet char[27] 0x0080
		FlagSet flag[2697]
		FlagSet flag[2698]
		FlagSet flag[2699]
	Return

fn[3]:
	if system[4] >= 7:
		if system[0] == 128:
			SystemFlagsUnset 0x00002000
		else:
			SystemFlagsSet 0x00002000
	ObjFlagsSet object[0] 0x0004
	ObjFlagsSet object[1] 0x0004
	ObjFlagsSet object[2] 0x0004
	ObjFlagsSet object[21] 0x0004
	ObjFlagsSet object[22] 0x0004
	if !flag[3385] && flag[3371]:
		ObjFlagsUnset object[21] 0x0004
		ObjFlagsUnset object[22] 0x0004
		ObjFlagsUnset object[0] 0x0004
		ObjFlagsUnset object[2] 0x0004
		ObjFlagsUnset object[1] 0x0004
	if system[0] == 128:
		system[1] = 0
	elif flag[0]:
		system[1] = 0
		FlagUnset flag[0]
	elif flag[2585] && !flag[2591]:
		Sc_C4Set 8
	elif flag[3370] && !flag[3376]:
		system[1] = 566
	else:
		system[1] = 300
	if system[4] >= 5:
		EntranceSetDisabled entrance[0] 0
		EntranceSetDisabled entrance[26] 1
	else:
		EntranceSetDisabled entrance[0] 1
		EntranceSetDisabled entrance[26] 0
	if !flag[2907] && !flag[2861]:
		EntranceSetFunc entrance[1] fn[0,33]
	if flag[2697]:
		ED7_76_0 object[7] "moni_r" 1
		ED7_76_0 object[7] "light_r" 1
		ED7_76_1 object[7] "moni_g" 1
		ED7_76_1 object[7] "light_g" 1
		ED7_76_0 object[7] "moni_1" 1
		ED7_76_0 object[7] "moni_2" 1
	else:
		ED7_76_1 object[7] "moni_r" 1
		ED7_76_1 object[7] "light_r" 1
		ED7_76_0 object[7] "moni_g" 1
		ED7_76_0 object[7] "light_g" 1
		ED7_76_0 object[7] "moni_1" 1
		ED7_76_0 object[7] "moni_2" 1
	if flag[2698]:
		ED7_76_0 object[8] "moni_r" 1
		ED7_76_0 object[8] "light_r" 1
		ED7_76_1 object[8] "moni_g" 1
		ED7_76_1 object[8] "light_g" 1
		ED7_76_0 object[8] "moni_1" 1
		ED7_76_0 object[8] "moni_2" 1
	else:
		ED7_76_1 object[8] "moni_r" 1
		ED7_76_1 object[8] "light_r" 1
		ED7_76_0 object[8] "moni_g" 1
		ED7_76_0 object[8] "light_g" 1
		ED7_76_0 object[8] "moni_1" 1
		ED7_76_0 object[8] "moni_2" 1
	if flag[2699]:
		ED7_76_0 object[9] "moni_r" 1
		ED7_76_0 object[9] "light_r" 1
		ED7_76_1 object[9] "moni_g" 1
		ED7_76_1 object[9] "light_g" 1
		ED7_76_0 object[9] "moni_1" 1
		ED7_76_0 object[9] "moni_2" 1
	else:
		ED7_76_1 object[9] "moni_r" 1
		ED7_76_1 object[9] "light_r" 1
		ED7_76_0 object[9] "moni_g" 1
		ED7_76_0 object[9] "light_g" 1
		ED7_76_0 object[9] "moni_1" 1
		ED7_76_0 object[9] "moni_2" 1
	ObjFlagsUnset object[17] 0x0010
	if flag[2697] && flag[2698] && flag[2699]:
		ED7_76_0 object[17] "lock_r" 1
		ED7_76_1 object[17] "lock_g" 1
		ObjFrame object[17] 40
