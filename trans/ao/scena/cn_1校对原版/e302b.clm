fn[3]:
	Sc_C4Set 4
	Sc_C4Set 256
	ED7_E3 10
	FadeOut 300ms 0x00000000 255
	FadeWait
	ED7_E3 5
	var[5] = 0
	while var[5] != 255:
		var[5] = ED7_E3 0
		switch var[5]:
			case 0:
				if flag[3385]:
					QuestList quest[154] quest[155] quest[156] quest[150] quest[151] quest[152] quest[153]
				else:
					QuestList quest[150] quest[151] quest[152] quest[153]
				break
			case 1:
				SystemFlagsSet 0x40000000
				ED7_E3 7
				Sleep 500ms
				TextSetName "自動廣播"
				TextMessage null {
					這裡是克洛斯貝爾警察。{wait}
				}
				TextWait
				if ED7_E3 4:
					TextMessage null {
						我們將受理您的報告。{wait}
					}
					TextWait
					TextClose 0
					var[8] = system[47]
					ED7_E3 12
					TextSetName "自動廣播"
					TextMessage null {
						已結束報告受理。
						辛苦了。{wait}
					}
					TextWait
				else:
					TextMessage null {
						沒有可以報告的委託。{wait}
					}
					TextWait
				TextClose 0
				ED7_E3 8
				SystemFlagsUnset 0x40000000
				break
			case 2:
				Call fn[0,4]
				break
			case 3:
				var[5] = 255
				break
	ED7_E3 6
	Sc_C4Unset 4
	Sc_C4Unset 256
	if flag[322] && flag[323] && flag[324] && flag[325] && flag[326] && flag[327] && flag[328] && !flag[343]:
		ED7_E3 11
		TextEnd null
		Call fn[0,5]
		Return
	FadeIn 1000ms 0x00000000
	FadeWait
	ED7_E3 11
	TextEnd null
	Return

