fn[5]:
	EventBegin 0
	FadeOut 0ms 0x00000000 255
	ED7LoadChip "chr/ch00002.itc" chip[30]
	CharSetChipBase name[0] chip[30]
	CharSetChipPattern name[0] 0
	CharFlagsSet name[0] 0x0004
	CharSetChipBase char[3] chip[18]
	CharSetChipPattern char[3] 0
	CharSetChipBase char[0] chip[26]
	CharSetChipPattern char[0] 0
	CharSetChipBase char[4] chip[27]
	CharSetChipPattern char[4] 0
	_Char4A char[3] 255
	_Char4A char[0] 255
	_Char4A char[4] 255
	if flag[3360]:
		CharSetChipBase char[1] chip[1]
		CharSetChipPattern char[1] 0
		_Char4A char[1] 255
		CharSetPos char[1] (102700, 0, -102930) 180deg
	CamSetDistance 102970 1000 -104740 0ms
	ED7CamRotate 40deg 23deg 0deg 0ms
	CamPers 500 0ms
	CamZoom 14560 0ms
	CharSetPos name[0] (103020, 100, -105800) 90deg
	CharSetPos char[3] (101590, 0, -105440) 90deg
	CharSetPos char[4] (101470, 0, -104110) 135deg
	CharSetPos char[0] (103000, 0, -104100) 180deg
	FadeIn 1000ms 0x00000000
	FadeWait
	TextTalk char[3] {
		#00205F哎呀……{wait}
	} {
		#00204F看來羅伊德前輩似乎在
		『波姆碰！』中，贏過
		所有的人了呢。{wait}
	}
	TextWait
	TextTalk char[4] {
		#01905F咦！真的嗎～！？{wait}
	} {
		#01909F真不愧是羅伊德警官……
		真是太厲害了～！！{wait}
	}
	TextWait
	if flag[3360]:
		TextTalk char[1] {
			#02302F哦，這樣啊。
			你也蠻有一套的呢。{wait}
		}
		TextWait
	CharSetChipPattern name[0] 1
	TextTalk name[0] {
		#00009F哈哈，謝謝你。
		搞不好我只是運氣好而已……{wait}
	}
	TextWait
	TextTalk char[0] {
		#12100F不，這款拼圖遊戲不可能
		光靠運氣就獲得勝利。{wait}
	} {
		#12102F班寧斯，你就是
		真正的『波姆碰大師』。{wait}
	}
	TextWait
	TextTalk name[0] {
		#00012F……那、那還真是謝了。{wait}
	}
	TextWait
	if !ItemHas item[240] 4:
		TextTalk char[0] {
			#12100F嗯……對了。{wait}
		} {
			要是你不嫌棄的話就收下這個吧。{wait}
		}
		TextWait
		_94 0 char[0] 0deg 500 1500mm/s 0
		Sleep 500ms
		TextSetPos -1 -1 -1 -1
		FadeOut 300ms 0x00000000 100
		SoundPlay sound[17] 0 100 0
		TextSetName ""
		TextMessage name[742] {
			{color 0}已取得{item[240]}{color 0}。{wait}
		}
		TextWait
		TextClose 0
		FadeIn 300ms 0x00000000
		ItemAdd item[240] 1
		TextSetPos -1 280 60 3
		TextTalk char[0] {
			#12100F這是由教會和愛普斯泰恩財團
			以古代的法術為基礎，
			共同開發出來的禁斷核心迴路。{wait}
		} {
			因為太過強力而難以操作，
			是個難以實際運用的東西，不過……{wait}
		} {
			#12102F如果是你的話，應該能夠正確使用它吧。{wait}
		}
		TextWait
		TextTalk name[0] {
			#00000F嗯，我知道了。
			我會好好運用的。{wait}
		}
		TextWait
	else:
		TextTalk char[0] {
			#12100F嗯……對了。{wait}
		} {
			#12102F就送你這個作為獎賞吧。{wait}
		}
		TextWait
		_94 0 char[0] 0deg 500 1500mm/s 0
		TextSetPos -1 -1 -1 -1
		FadeOut 300ms 0x00000000 100
		SoundPlay sound[17] 0 100 0
		TextSetName ""
		TextMessage name[742] {
			{color 0}已取得{item[103]}{color 0}。{wait}
		}
		TextWait
		TextClose 0
		FadeIn 300ms 0x00000000
		ItemAdd item[103] 1
		TextSetPos -1 280 60 3
		Sleep 500ms
		TextTalk name[0] {
			#00000F哈哈，謝謝你。
			我會好好運用的。{wait}
		}
		TextWait
		TextClose 0
		_59
	FadeOut 1000ms 0x00000000 255
	FadeWait
	FlagSet flag[343]
	ED7_DE 53
	ED7_DE 128
	CharSetChipBase name[0] chip[255]
	CharSetChipPattern name[0] 0
	CharFlagsUnset name[0] 0x0004
	UnloadChip chip[30]
	EventEnd 5
	FlagSet flag[291]
	NewScene "scena/e302b.bin" 0 0 0
	Hcf
	Return

fn[6]:
	TextStart self
	if system[101] >= 20:
		if !flag[3411]:
			Call fn[0,22]
		else:
			TextTalk char[8] {
				#1520010079V#00102F（……待會見。）{wait}
			} {
				#1520010080V#00104F（晚一點也沒關係，
				　你慢慢準備完再來吧。）{wait}
			}
			TextWait
	elif !flag[3797]:
		TextTalk char[8] {
			#00103F克洛斯貝爾市解放作戰……
			就是明天了呢。{wait}
		} {
			#00108F如果能見到貝爾還有叔叔，
			我會問他們為何鬧出這一連串事件……
			可以的話還想說服他們。{wait}
		} {
			#00101F可是，如果這無法達成的話……{wait}
		}
		TextWait
		TextTalk name[0] {
			#00008F艾莉……{wait}
		}
		TextWait
		TextTalk char[8] {
			#00106F……對不起。
			我說了喪氣話。{wait}
		} {
			#00100F為了回報那麼多不顧危險
			幫助我們的人……{wait}
		} {
			而且也為了救回琪雅，
			我們不能認輸，對吧。{wait}
		}
		TextWait
		TextTalk name[0] {
			#00002F……明天我們一起努力吧，艾莉。
			我還有其他人都會陪伴妳的。{wait}
		}
		TextWait
		TextTalk char[8] {
			#00104F……呵呵，是啊。{wait}
		} {
			#00102F謝謝你，羅伊德。
			幸虧有你，
			我的心情才能輕鬆了一些。{wait}
		}
		TextWait
		FlagSet flag[3797]
	else:
		TextTalk char[8] {
			#00104F謝謝你，羅伊德。
			幸虧有你，
			我的心情才能輕鬆了一些。{wait}
		} {
			#00102F今天就好好休息……
			準備迎戰明天吧。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[7]:
	TextStart self
	if system[102] >= 20:
		if !flag[3412]:
			Call fn[0,23]
		else:
			TextTalk char[3] {
				#1520020061V#00204F這邊完成之後，
				我也會前往甲板的。{wait}
			} {
				#1520020062V#00202F關於商量的事……
				還要再麻煩你了。{wait}
			}
			TextWait
	elif !flag[3798]:
		TextTalk char[3] {
			#00203F（喀噠喀噠喀噠……）{wait}
		} {
			#00200F嗯，總之是做好萬全準備了。{wait}
		}
		TextWait
		TextTalk name[0] {
			#00005F緹歐……
			妳在做什麼？{wait}
		}
		TextWait
		Emote char[3] 0mm 1700mm 38 38 250ms 1
		Sleep 1000ms
		name[0].5 = char[3].4
		char[3].5 = char[3].4
		CharFlagsUnset char[3] 0x0010
		CharTurnToChar char[3] name[0] 0deg/s
		char[3].4 = (char[3].4 + 360) % 360
		char[3].4 = char[3].4 + 360 - char[3].5
		char[3].5 = char[3].4 / 180
		if char[3].4 <= 45 | char[3].4 >= 315 && char[3].4 <= 405 | char[3].4 >= 675:
		elif char[3].5 < 1:
			char[3].8 = 2
		elif char[3].5 > 2:
			char[3].8 = 1
		else:
			char[3].8 = char[3].5
		char[3].4 = name[0].5
		name[0].5 = 0
		char[3].5 = 0
		CharFlagsSet char[3] 0x0010
		TextTalk char[3] {
			#00202F為了明天的攻堅行動，
			我正在對梅爾卡巴的系統
			進行最終檢查。{wait}
		} {
			#00203F我會和羅伊德前輩你們
			一起離開梅爾卡巴，但是……{wait}
		} {
			#00200F佔領通訊終端機之後的
			駭入等工作，還必須要
			拜託約納和芙蘭小姐他們才行。{wait}
		}
		TextWait
		TextTalk name[0] {
			#00001F這樣啊……
			感覺很辛苦啊。{wait}
		}
		TextWait
		TextTalk char[3] {
			#00204F嗯，就快要結束了，
			不用擔心。{wait}
		} {
			#00202F羅伊德前輩只要像個隊長一樣，
			在那邊擺個樣子
			看著就可以了。{wait}
		}
		TextWait
		Emote name[0] 0mm 2000mm 16 19 250ms 1
		SoundPlay sound[23] 0 100 0
		Sleep 1000ms
		TextTalk name[0] {
			#00006F不不不，
			還有明天的準備工作之類的啊。{wait}
		} {
			#00000F嗯，不過看這樣子，
			這裡交給妳應該沒問題吧。{wait}
		} {
			緹歐妳們也要
			好好休息喔！{wait}
		}
		TextWait
		TextTalk char[3] {
			#00204F嗯，我明白了。
			請你也好好休息吧。{wait}
