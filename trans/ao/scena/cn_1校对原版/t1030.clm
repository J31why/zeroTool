fn[0]:
	switch random % 8:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if flag[272]:
		FlagUnset flag[272]
		Event fn[0,24]
	elif flag[273]:
		FlagUnset flag[273]
		FlagSet flag[9]
		Event fn[0,31]
	elif flag[274]:
		FlagUnset flag[274]
		Event fn[0,30]
	elif flag[2602] && !flag[2603] && !flag[2777]:
		SystemFlagsSet 0x10000000
		Event fn[0,29]
	if QuestFlagsGet quest[134] 0x02 && !QuestFlagsGet quest[134] 0x10 && !QuestFlagsGet quest[134] 0x40 && !flag[2848]:
		CharFlagsUnset char[15] 0x0080
	if flag[2608]:
	elif flag[2607]:
	elif flag[2605]:
	elif flag[2604]:
	elif flag[2602]:
