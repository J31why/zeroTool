		CharFlagsUnset char[12] 0x0080
		CharFlagsSet char[12] 0x0010
		CharFlagsUnset char[13] 0x0080
		CharFlagsUnset char[14] 0x0080
	elif flag[2592]:
	Return

fn[2]:
	ED7_76_1 object[255] "t1030_sky" 1
	ED7_76_0 object[255] "t1030_sky_y" 1
	if flag[9]:
		system[1] = 160
		FlagUnset flag[9]
	elif flag[3385]:
		system[1] = 563
	TriggerFlagsSet trigger[0] 0x0080
	if flag[3093] && !flag[3094]:
		TriggerFlagsUnset trigger[0] 0x0080
	if !flag[3093]:
		ED7_76_2 object[255] "t1030_water" "loop_off"
	if flag[3093] && !flag[3100]:
		SoundStop sound[821]
		SoundPlayContinuously sound[123] (-70, 4250, -9760) 10000 100000 80 0
		SoundLoad sound[918]
		ForkFunc char[29] fork[3] fn[0,37]
	elif flag[3100]:
		SoundStop sound[821]
		SoundPlayContinuously sound[123] (-70, 4250, -9760) 10000 100000 80 0
	else:
		SoundPlay sound[821] 1 40 0
	TriggerFlagsSet trigger[1] 0x0080
	if flag[2597] && !flag[2601]:
		TriggerFlagsUnset trigger[1] 0x0080
	if flag[2602] && !flag[2604]:
		TriggerFlagsUnset trigger[1] 0x0080
	if flag[3328]:
		TriggerFlagsSet trigger[1] 0x0080
	if flag[3385]:
		MapColor 0x00FFEBDC 0ms
		Fog 0xFFD5B47B 13 120 0
	elif flag[3355]:
		MapColor 0x00FFEBDC 0ms
		Fog 0xFFD5B47B 13 120 0
	Return

fn[3]:
	if flag[2602] && !flag[2604]:
		Call fn[0,19]
		Return
	else:
		TextStart self
