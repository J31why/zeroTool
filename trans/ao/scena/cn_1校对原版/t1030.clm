fn[6]:
	TextStart self
	if flag[2605]:
	elif flag[2601]:
	elif flag[2597]:
		if !flag[0]:
			TextTalk char[3] {
				{color 10}各位好！
				歡迎來到奇幻樂園。{color 0}{wait}
			}
			TextWait
			TextTalk char[3] {
				{color 10}咪嘻嘻！希望各位玩得開心～！{color 0}{wait}
			}
			TextWait
			TextTalk name[0] {
				#00002F喔，是咪西耶。{wait}
			}
			TextWait
			TextTalk name[3] {
				#00309F哈哈，早知道
				就該帶小緹來了。{wait}
			}
			TextWait
			TextTalk name[4] {
				#10304F沒關係，反正下午還會來，
				把樂子留到壓軸，
				她應該也會很開心的。{wait}
			}
			TextWait
			FlagSet flag[0]
		elif !flag[1]:
			TextTalk char[3] {
				{color 10}對了，各位大哥哥
				沒帶女生來啊～？{color 0}{wait}
			}
			TextWait
			TextTalk char[3] {
				{color 10}不過沒關係！
				就算沒有情人作伴，
				奇幻樂園還是很好玩的♪{color 0}{wait}
			}
			TextWait
			TextTalk char[3] {
				{color 10}咪嘻嘻！希望各位玩得開心～！{color 0}{wait}
			}
			TextWait
			TextTalk name[0] {
				#00006F（……怎麼有股
				　莫名的悲哀啊……）{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk char[3] {
				{color 10}就算沒有情人作伴，
				奇幻樂園還是很好玩的♪{color 0}{wait}
			}
			TextWait
			TextTalk char[3] {
				{color 10}咪嘻嘻！希望各位玩得開心～！{color 0}{wait}
			}
			TextWait
	TextEnd self
	Return

fn[7]:
	TextStart self
	if flag[2605]:
	elif flag[2601]:
		TextTalk char[4] {
			那邊站在導覽看板前的小朋友們，
			好像一直在熱烈討論
			有關咪西的事。{wait}
		}
		TextWait
		TextTalk char[4] {
			呵呵，身為奇幻樂園的工作人員，
			這真是令人開心啊。{wait}
		}
		TextWait
	elif flag[2597]:
		if !flag[2]:
			TextTalk char[4] {
				歡迎來到米修拉姆
				引以為傲的主題樂園。{wait}
			}
			TextWait
			TextTalk char[4] {
				最近新引進的遊樂設施
				相當受歡迎。{wait}
			}
			TextWait
			TextTalk char[4] {
				進場時請千萬別錯過！{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			TextTalk char[4] {
				本主題樂園
				最近新引進的遊樂設施
				相當受歡迎。{wait}
			}
			TextWait
			TextTalk char[4] {
				進場時請千萬別錯過！{wait}
			}
			TextWait
	TextEnd self
	Return

