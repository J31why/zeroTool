fn[2]:
	SoundPlay sound[480] 1 100 0
	if !flag[2594]:
		Emote char[0] 0mm 2000mm 24 27 250ms 0
		Emote char[1] 0mm 2000mm 24 27 250ms 0
	if !flag[2595]:
		CharSetChipPattern char[2] 1
		Emote char[2] 0mm 1700mm 24 27 250ms 0
	Return

fn[3]:
	if flag[2592] && !flag[2594]:
		Call fn[0,13]
		Return
	else:
		TextStart self
		if flag[2608]:
		elif flag[2605]:
		elif flag[2604]:
		elif 0:
		elif flag[2602]:
		elif flag[2601]:
		elif flag[2600]:
		elif flag[2597]:
		elif flag[2592]:
			if !flag[2594]:
			elif !flag[2]:
				TextTalk char[0] {
					#00100F難得來這裡渡假，
					不好好享受一番就太不划算了。{wait}
				} {
					#00104F我記得貝爾她也說過
					有為我們準備了一些驚喜……{wait}
				} {
					#00102F呵呵，這樣一想，
					我好像越來越期待了呢。{wait}
				}
				TextWait
				TextTalk name[0] {
					#00012F驚喜啊……
					我倒是覺得有點不安啊。{wait}
				} {
					#00003F如果是讓整個米修拉姆
					都來歡迎我們之類的，
					再怎麼說還是會讓人卻步吧。{wait}
				}
				TextWait
				TextTalk char[0] {
					#00109F就、就算貝爾喜歡熱鬧華麗，
					應該也不會準備這麼……{wait}
				} {
					#00103F……我也沒辦法完全否認這可能呢。{wait}
				} {
					#00102F只、只好向女神祈禱，
					希望不要是太奇怪的事情吧。{wait}
				}
				TextWait
				TextTalk name[0] {
					#00006F（實、實在很不安啊……）{wait}
				}
				TextWait
				FlagSet flag[2]
			else:
				TextTalk char[0] {
					#00103F唔～嗯，話說回來，
					到底貝爾的驚喜會是什麼呢？{wait}
				} {
					#00111F……希望不要是太奇怪的東西。{wait}
				}
				TextWait
		TextEnd self
	Return

fn[4]:
	if flag[2592] && !flag[2594]:
		Call fn[0,13]
		Return
	else:
		TextStart self
		if flag[2608]:
		elif flag[2605]:
		elif flag[2604]:
		elif 0:
		elif flag[2602]:
		elif flag[2601]:
		elif flag[2600]:
		elif flag[2597]:
		elif flag[2592]:
			if !flag[2594]:
			elif !flag[4]:
				TextTalk char[1] {
					#10105F這麼說起來，賽爾蓋課長
					沒能一起來，真是可惜呢。{wait}
				} {
					#10106F雖然他說過
					要我們去玩個痛快，
					但該說感覺還是有點內疚吧……{wait}
				}
				TextWait
				TextTalk name[0] {
					#00003F畢竟課長算是很忙的人啊……{wait}
				} {
					#00002F哈哈，說不定他只是
					不好意思讓別人看到他
					工作之外的樣子吧。{wait}
				}
				TextWait
				TextTalk char[1] {
					#10109F啊哈哈，那倒是會讓人意外，應該蠻有趣的。{wait}
				}
				TextWait
				FlagSet flag[4]
			else:
				TextTalk char[1] {
					#10103F賽爾蓋課長
					沒能一起來，真是可惜呢。{wait}
				} {
					#10102F說不定現在正在支援課裡
					一個人抽著香菸呢。{wait}
				}
				TextWait
		TextEnd self
	Return

fn[5]:
	if flag[2592] && !flag[2595]:
		Call fn[0,14]
		Return
	else:
		TextStart self
		if flag[2608]:
		elif flag[2605]:
		elif flag[2604]:
		elif flag[2602]:
		elif flag[2601]:
		elif flag[2600]:
		elif flag[2597]:
		elif flag[2592]:
			if !flag[2595]:
			else:
				if !flag[3]:
					TextTalk char[2] {
						#00303F哈──像那樣死氣沉沉的，
						果然不適合本大爺啊。{wait}
					} {
						#00301F既然如此，今天就要在
						這米修拉姆好好玩個痛快！{wait}
					} {
						#00309F羅伊德，晚上你也要一起來泡妞啊！{wait}
					}
					TextWait
					TextTalk name[0] {
						#00012F哈哈，雖然我大概只能看蘭迪表演，
						你不介意的話我就陪你吧。{wait}
					}
					TextWait
					TextTalk char[2] {
						#00306F怎麼了怎麼了，你這樣太消極了吧。{wait}
					} {
						#00309F你這塊材料也不錯，
						不如乾脆捨棄掉弟弟個性，
						變得勇往直前一點吧。{wait}
					}
					TextWait
					TextTalk name[0] {
						#00006F我、我聽不太懂你在說什麼……{wait}
					} {
						#00000F（……不過，他看來是有回到
						　往常的樣子了。）{wait}
					}
					TextWait
					FlagSet flag[3]
				else:
					TextTalk char[2] {
						#00305F啊對了，我還得幫那傢伙
						買些伴手禮才行啊……{wait}
					} {
						#00304F聽說她要晉陞了，
						我也找看看有沒有賣祝賀品的地方吧。{wait}
					}
					TextWait
				TextEnd self
				CharSetChipPattern char[2] 1
				Return
		TextEnd self
	Return

fn[6]:
	TextStart self
	if flag[2605]:
	elif flag[2601]:
	elif flag[2597]:
	elif flag[2592]:
		if !flag[0]:
			TextTalk char[3] {
				今天非常感謝各位
				搭乘水上巴士。{wait}
			}
			TextWait
			TextTalk char[3] {
				各位是受到瑪利亞貝爾小姐的
				邀請而來的吧？{wait}
			}
			TextWait
			TextTalk char[3] {
				在抵達米修拉姆之前，
				還請各位享受在水波上
				搖曳著的這段短暫時光。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[3] {
				要是感到暈船了，
				可以在甲板上眺望遠方
				風景轉移注意力。{wait}
			}
			TextWait
			TextTalk char[3] {
				另外我們也準備了暈船藥，
				還請各位放心。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[7]:
	TextStart self
	if flag[2592]:
		if !flag[1]:
			TextTalk char[4] {
				在通商會議上主張說要獨立，
				實在是太驚人了。{wait}
			}
			TextWait
			TextTalk char[4] {
				迪塔先生是打算
				要如何實現這個目標……？
				真是叫人期待啊。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk char[4] {
				迪塔先生是打算
				要如何實現獨立……？
				真是叫人期待啊。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[8]:
	TextStart self
	if flag[2592]:
		TextTalk char[5] {
			我夢寐以求的克洛斯貝爾之旅，
			而且是遊憩區米修拉姆的主題樂園！{wait}
		}
		TextWait
		TextTalk char[5] {
			哎呀──好期待啊。
			我要跟女朋友一起盡情地玩哦～！{wait}
		}
		TextWait
	TextEnd self
	Return

fn[9]:
	TextStart self
	if flag[2592]:
		TextTalk char[6] {
			就我個人來說，還想要去
			餐廳跟時裝店逛逛呢～{wait}
		}
		TextWait
		TextTalk char[6] {
			哦呵呵，今天要好好
			跟男朋友撒個嬌。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[10]:
	TextStart self
	if flag[2605]:
	elif flag[2604]:
	elif flag[2601]:
	elif flag[2597]:
	elif flag[2592]:
		if !flag[5]:
			TextTalk char[7] {
				克洛斯貝爾的獨立啊……
				真不愧是迪塔市長，
				有著十分獨到的想法呢。{wait}
			}
			TextWait
			TextTalk char[7] {
				雖說應該不會是
				一條簡單的路……
				但他的這些話能帶給人夢想呢。{wait}
			}
			TextWait
			TextTalk char[7] {
				市長一定能照亮
				克洛斯貝爾的未來。
				我是這麼覺得的。{wait}
			}
			TextWait
			FlagSet flag[5]
		else:
			TextTalk char[7] {
				啊，難得跟
				家人一起來玩，
				我講這些就太掃興了。{wait}
			}
			TextWait
			TextTalk char[7] {
				今天我要讓利瑪還有
				柯洛娜好好享受一下才行啊。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[11]:
	TextStart self
	if flag[2605]:
	elif flag[2604]:
	elif flag[2601]:
	elif flag[2597]:
	elif flag[2592]:
		if !flag[6]:
			TextTalk char[9] {
				蘭花塔建造完成之後，
				我丈夫獲得了一筆獎金，
				所以我們就全家一起來旅行。{wait}
			}
			TextWait
			TextTalk char[9] {
				原本是打算把這筆錢存起來，
				但我丈夫他說『偶爾也想服務一下家人』，
				盛情難卻呢。{wait}
			}
			TextWait
			TextTalk char[9] {
				不過，這旅行果然還是來對了。
				看看利瑪那麼開心的樣子。{wait}
			}
			TextWait
			FlagSet flag[6]
		else:
			TextTalk char[9] {
				我丈夫獲得了一筆獎金，
				所以我們就全家一起來旅行。{wait}
			}
			TextWait
			TextTalk char[9] {
				呵呵，這旅行果然還是來對了。
				看看利瑪那麼開心的樣子。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[12]:
	TextStart self
	if flag[2605]:
	elif flag[2604]:
	elif flag[2601]:
	elif flag[2597]:
	elif flag[2592]:
		TextTalk char[8] {
			爸爸──你看你看！！
			有魚在飛耶──！{wait}
		}
		TextWait
	TextEnd self
	Return

