	EventBegin 0
	SoundLoad sound[3515]
	SoundLoad sound[3394]
	VisShow vis[0] 234 0 490 256 0 0 512 512 0 0 512 512 0x00FFFFFF 0 "bu10100.itp"
	VisShow vis[1] 234 0 490 256 0 0 512 512 0 0 512 512 0x00FFFFFF 0 "bu00101.itp"
