		#1240000095V#00000F雖然你是個輕浮男又喜歡
		晚上遊蕩，還有點好戰而且
		容易熱衷起來，但還是有所分寸……{wait}
	} {
		#1240000096V#00002F並且，總是像個大哥一樣照顧
		我們這些年紀小的……{wait}
	} {
		#1240000097V#00009F這就是我所認識的，
		叫做蘭迪・奧蘭多的男人。{wait}
	}
	TextWait
	TextTalk char[2] {
		#1240030030V#00305F#5P…………………………………{wait}
	}
	TextWait
	TextTalk name[0] {
		#1240000098V#00003F#6P所以就算給我們
		看到有點糗的一面，
		也不用在意。{wait}
	} {
		#1240000099V#00000F反而該說我還有
		艾莉她們才是──{wait}
	}
	TextWait
	TextTalk char[2] {
		#1240030031V#00303F#5P──我知道了，你不用再說下去了。{wait}
	} {
		#1240030032V#00306F看來我還是太過小看
		你的潛力了……{wait}
	} {
		#1240030033V#00310F你這無自覺勾引人也太誇張了吧！？{wait}
	}
	TextWait
	TextTalk name[0] {
		#1240000100V#00011F#6P無、無自覺勾引人？{wait}
	} {
		#1240000101V#00006F雖然我不太懂什麼意思，
		但有必要這麼生氣地說嗎？{wait}
	}
	TextWait
	BgmStop 2000ms
	BgmWait
