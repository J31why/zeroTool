calmare ao_k scena
scena:
	name "c031b" "c031b" "c031b"
	town town[43]
	bgm bgm[513]
	flags 8192
	item_use fn[0,255]
	unk 255 0

entry:
	pos (0, 0, -1000)
	unk1 0
	cam_from (0, 0, 24000)
	cam_pers 500
	unk2 30
	cam_deg 45deg
	cam_limit 0deg 360deg
	cam_at (0, 0, 0)
	unk3 0
	unk4 0
	flags 0x0001
	town town[1]
	init fn[0,2]
	reinit fn[0,3]

chip[0] "chr/ch25800.itc"
chip[1] "chr/ch25700.itc"

npc char[0]:
	name "海爾瑪"
	pos (0, 4060, 7760)
	angle 180deg
	flags 0x0101
	unk2 0
	chip chip[0]
	init fn[0,1]
	talk fn[0,4]
	unk4 255

npc char[1]:
	name "瓊安娜"
	pos (-45350, 60, 3900)
	angle 360deg
	flags 0x0101
	unk2 0
	chip chip[1]
	init fn[0,0]
	talk fn[0,5]
	unk4 255

fn[0]:
	switch random % 8:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharIdle self (-1870, null, 6710) (1860, null, 9950) 1000mm/s
		Sleep 300ms
	Return

fn[2]:
	Return

fn[3]:
	Return

fn[4]:
	TextStart self
	if !flag[0]:
		TextTalk self {
			老爺最近很忙碌，
			常常沒回家，直接就在
			市政廳休息，不過……{wait}
		}
		TextWait
		TextTalk self {
			剛才我收到了聯絡，
			聽說他今天可以
			久違地回來家裡的樣子。{wait}
		}
		TextWait
		TextTalk self {
			希望他務必
			為明天的正式會議
			養精蓄銳。{wait}
		}
		TextWait
		FlagSet flag[0]
	else:
		TextTalk self {
			今晚我特意為老爺
			準備了營養價值
			豐富的料理。{wait}
		}
		TextWait
		TextTalk self {
			希望他務必要為了明天的
			正式會議養精蓄銳。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[5]:
	TextStart self
	if !flag[1]:
		TextTalk self {
			今天的晚餐是
			老爺愛吃的
			苦番茄料理。{wait}
		}
		TextWait
		TextTalk self {
			苦番茄沙拉、
			苦番茄醬義大利麵、
			１００％苦番茄純果汁……{wait}
		}
		TextWait
		TextTalk name[0] {
			#00012F（唔、唔哇……
			　這還真是徹頭徹尾的苦蕃茄全餐啊。）{wait}
		}
		TextWait
		TextTalk name[1] {
			#00106F（沒想到外公
			　竟然這麼喜歡苦蕃茄……）{wait}
		}
		TextWait
		FlagSet flag[1]
	else:
		TextTalk self {
			今天的餐點是老爺愛吃的
			苦番茄料理。{wait}
		}
		TextWait
		TextTalk self {
			聽說這食材好像對身體很好，
			我也要努力
			把它吃下去……{wait}
		}
		TextWait
		TextTalk name[1] {
			#00106F不、不要太勉強自己喔……{wait}
		}
		TextWait
	TextEnd self
	Return
