fn[4]:
	ObjFlagsUnset object[2] 0x0010
	LookPointFlagsUnset look_point[0] 0x0001
	if !flag[2568] && flag[2564]:
		LookPointFlagsSet look_point[0] 0x0001
		ObjFlagsSet object[2] 0x0010
	if flag[2848] && !flag[2858] | flag[2369] && system[4] == 1:
		ED7_76_0 object[255] "hikari00_add" 1
		ED7_76_0 object[255] "hikari01_add" 1
		SoundPlay sound[128] 1 50 0
	if !flag[3385] && flag[3370]:
		MapColor 0x00E6D2D2 0ms
		ED7_76_0 object[255] "hikari00_add" 1
		ED7_76_0 object[255] "hikari01_add" 1
	Return

fn[5]:
	TextStart self
	if flag[3385]:
		if !flag[0]:
			TextTalk self {
				濕地竟然出現那種東西……
				雖然讓人擔心，
				但工作還是得做。{wait}
			}
			TextWait
			TextTalk self {
				而且修莉她在彩虹劇團那邊
				也都很努力練習，我不能偷懶！{wait}
			}
			TextWait
			TextTalk self {
				為了隨時迎接伊莉雅小姐回來，
				我得把公寓整理得乾乾淨淨才行。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				而且修莉她在彩虹劇團那邊
				也都很努力練習，我不能偷懶！{wait}
			}
			TextWait
			TextTalk self {
				為了隨時迎接伊莉雅小姐回來，
				我得把公寓整理得乾乾淨淨才行。{wait}
			}
			TextWait
	elif flag[3371]:
		TextTalk self {
			啊啊！怎麼辦……
			城裡竟然會發生這種事。{wait}
		}
		TextWait
		TextTalk self {
			總、總之，我得先告訴屋裡所有人，
			千萬不要到外面去。{wait}
		}
		TextWait
	elif flag[3089]:
		TextTalk self {
			那場攻擊事件……
			聽說幕後黑手是帝國呢。{wait}
		}
		TextWait
		TextTalk self {
			絕對不能原諒他們。
			因為那事件，讓伊莉雅小姐……{wait}
		}
		TextWait
	elif flag[3074]:
		if !flag[0]:
			TextTalk self {
				住在這棟公寓
				三樓的人，
				原來是伊莉雅小姐……{wait}
			}
			TextWait
			TextTalk self {
				我看到
				回來拿東西的修莉，
				才總算發現到這件事。{wait}
			}
			TextWait
			TextTalk self {
				……本來是件令人高興的事，
				但伊莉雅小姐
				竟然變成那樣……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				修莉她總是一臉
				无精打采的樣子。
				真是可憐……{wait}
			}
			TextWait
			TextTalk self {
				唉，真希望她能夠
				重新打起精神。{wait}
			}
			TextWait
	elif flag[2861]:
		if !flag[0]:
			TextTalk self {
				《金之太陽、銀之月》的
				改版公演……
				就在今天晚上了。{wait}
			}
			TextWait
			TextTalk self {
				雖然很可惜
				我沒能買到票，不過……
				我會在這裡聲援她的。{wait}
			}
			TextWait
			TextTalk self {
				唉，真想要親眼欣賞
				修莉的英姿啊……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				《金之太陽、銀之月》的
				改版公演……
				就在今天晚上了。{wait}
			}
			TextWait
			TextTalk self {
				唉，真想要親眼欣賞
				修莉的英姿啊……{wait}
			}
			TextWait
	elif flag[2848]:
		if !QuestFlagsGet quest[141] 0x10:
			if !flag[0]:
				TextTalk self {
					今天修莉
					一大早就出門了。{wait}
				}
				TextWait
				TextTalk self {
					感覺她最近
					情緒一直都很緊繃……
					讓我有點擔心。{wait}
				}
				TextWait
				TextTalk self {
					果然是因為改版公演
					帶給她壓力嗎……？{wait}
				}
				TextWait
				FlagSet flag[0]
			else:
				TextTalk self {
					修莉她，
					果然是因為改版公演
					帶給她壓力嗎……？{wait}
				}
				TextWait
				TextTalk self {
					我必須努力
					支持她、鼓勵她才行。{wait}
				}
				TextWait
		elif !flag[0]:
			TextTalk self {
				剛、剛才……
				伊莉雅小姐從三樓修莉的房間
				走出來了。{wait}
			}
			TextWait
			TextTalk self {
				她、她和我打了招呼……
				我高興到快要哭出來了！{wait}
			}
			TextWait
			TextTalk self {
				伊莉雅小姐是來
				修莉的房間找她玩的嗎？
				唉，真令人羨慕……{wait}
			}
			TextWait
			TextTalk name[0] {
				#00006F（不，其實那是
				　伊莉雅的房間啦……）{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				唉，伊莉亞小姐竟然會來找她玩，
				真羨慕修莉……{wait}
			}
			TextWait
			TextTalk self {
				算了……
				能夠近距離看到伊莉雅小姐，
				就已經夠幸運了。{wait}
			}
			TextWait
	elif flag[2837]:
		TextTalk self {
			路維克先生那裡
			打掃好了……{wait}
		}
		TextWait
		TextTalk self {
			嗯，再來換三樓了。
			感覺一定又亂七八糟的……{wait}
		}
		TextWait
	elif flag[2832]:
		if !flag[0]:
			TextTalk self {
				路維克先生
				好像帶著他夫人
				開車去兜風了。{wait}
			}
			TextWait
			TextTalk self {
				他說要開車到
				國境門那附近。{wait}
			}
			TextWait
			TextTalk self {
				還真是悠閒自在的退休生活啊。
				真令人羨慕～～{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				咦？這麼說來……
				路維克先生好像和他夫人
				在吵架的樣子……{wait}
			}
			TextWait
			TextTalk self {
				……算了。
				總之我得完成
				他們委託的打掃工作。{wait}
			}
			TextWait
	elif flag[2816]:
		if !flag[0]:
			TextTalk self {
				這次彩虹劇團的
				改版公演……{wait}
			}
			TextWait
			TextTalk self {
				聽說住在三樓的修莉
				被破格提拔成為
				第二主角之一喔！{wait}
			}
			TextWait
			TextTalk self {
				哇──很厲害對吧！？
				我真的好想看喔！！{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				啊啊……
				修莉的大舞台，
				我好想去看……！{wait}
			}
			TextWait
			TextTalk self {
				……但是，
				我沒有買到票。
				唉……{wait}
			}
			TextWait
	elif flag[2573]:
		if !flag[0]:
			TextTalk self {
				路維克先生家，
				他們夫妻好像在吵架呢。{wait}
			}
			TextWait
			TextTalk self {
				我去收錢的時候，
				感覺氣氛好凝重……{wait}
			}
			TextWait
			TextTalk self {
				唉，明明不關我的事，
				害我說話還要特別留神。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				路維克先生和奧莉嘉女士
				這對夫妻好像在吵架呢。{wait}
			}
			TextWait
			TextTalk self {
				唉，饒了我吧。
				害我說話還要特別留神……{wait}
			}
			TextWait
	elif flag[2568]:
		if !flag[0]:
			TextTalk self {
				聽說今天各國領導人
				會去彩虹劇團
				觀看表演呢。{wait}
			}
			TextWait
			TextTalk self {
				嗯，我想他們應該都
				坐在好位置欣賞吧？{wait}
			}
			TextWait
			TextTalk self {
				可惡！好羨慕喔！{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				結果我沒能買到
				這次改版公演的門票。{wait}
			}
			TextWait
			TextTalk self {
				唉……{wait}
			}
			TextWait
	elif flag[2564]:
		if !flag[0]:
			TextTalk self {
				欸，你們知道嗎？聽說啊，
				那個《金之太陽、銀之月》公演
				要重新改版了。{wait}
			}
			TextWait
			TextTalk self {
				嗯，好期待喔。
				我要趕快去買門票才行！{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				聽說彩虹劇團的
				《金之太陽、銀之月》公演
				要重新改版了。{wait}
			}
			TextWait
			TextTalk self {
				絕對不能錯過……
