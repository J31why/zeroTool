	function fn[0,18]
	unk3 0
	unk4 0

fn[0]:
	switch random % 8:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharIdle self (-1960, null, 10820) (2150, null, 12570) 1000mm/s
		Sleep 300ms
	Return

fn[2]:
	while 1:
		CharIdle self (-46010, null, 58560) (-42710, null, 61560) 1000mm/s
		Sleep 300ms
	Return

