		CharFlagsUnset char[1] 0x0080
		CharFlagsUnset char[0] 0x0080
	Return

fn[1]:
	if flag[3]:
		system[1] = 0
		FlagUnset flag[3]
	elif flag[296]:
		system[1] = 0
		FlagUnset flag[296]
	TriggerFlagsSet trigger[0] 0x0080
	if flag[2583] && !flag[2584]:
		TriggerFlagsUnset trigger[0] 0x0080
	ObjFlagsUnset object[0] 0x0010
	ObjFlagsUnset object[1] 0x0010
	ObjFlagsUnset object[2] 0x0010
	TriggerFlagsSet trigger[1] 0x0080
	if flag[3385]:
		TriggerFlagsUnset trigger[1] 0x0080
		if system[0] == 100 | flag[0]:
			ObjFrame object[0] 40
			ObjFlagsUnset object[0] 0x0002
			FlagSet flag[0]
	if system[0] == 102 | flag[1]:
		ObjFrame object[1] 40
		ObjFlagsUnset object[1] 0x0002
		FlagSet flag[1]
	if system[0] == 101 | flag[2]:
		ObjFrame object[2] 40
		ObjFlagsUnset object[2] 0x0002
		FlagSet flag[2]
	TriggerFlagsSet trigger[5] 0x0080
	if flag[2582] && !flag[2592]:
		EntranceSetFunc entrance[0] fn[0,16]
		ObjFrame object[0] 40
		ObjFlagsUnset object[0] 0x0002
		TriggerFlagsUnset trigger[5] 0x0080
	LookPointFlagsSet look_point[0] 0x0001
	if system[4] == 5:
		LookPointFlagsUnset look_point[0] 0x0001
	TriggerFlagsSet trigger[4] 0x0080
	if system[4] == 5:
		TriggerFlagsUnset trigger[4] 0x0080
	Return

