fn[0]:
	while 1:
		ED7CharAnimation self 1000ms 0 1 2 3 4 5
	Return

fn[1]:
	while 1:
		ED7CharAnimation self 1000ms 0 1 2 3 4 3 2 1
	Return

fn[2]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[3]:
	switch random % 8:
		case 0:
			ED7_A0 self 950ms 0 3
			break
		case 1:
			ED7_A0 self 1050ms 0 3
			break
		case 2:
			ED7_A0 self 1100ms 0 3
			break
		case 3:
			ED7_A0 self 900ms 0 3
			break
		case 4:
			ED7_A0 self 1150ms 0 3
			break
		case 5:
			ED7_A0 self 850ms 0 3
			break
		case 6:
			ED7_A0 self 1000ms 0 3
			break
		default:
			ED7_A0 self 1000ms 0 3
			break
	while 1:
		ED7_A0 self 1000ms 0 3
	Return

