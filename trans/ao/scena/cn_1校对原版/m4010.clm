fn[18]:
	EventBegin 1
	if system[10] == 0:
		TextTalk name[0] {
			#00003F我們可不能回頭。{wait}
		} {
			#00001F無論如何都必須逮捕
			阿奈斯特他們。{wait}
		}
		TextWait
	elif system[10] == 8:
		TextTalk name[8] {
			#10101F我們可沒空
			在這裡拖拖拉拉的了──
			得快點前往深處。{wait}
		}
		TextWait
	elif system[10] == 9:
		TextTalk name[9] {
			#00603F阿奈斯特和哈爾特曼就在深處。
			──趕緊追上他們吧。{wait}
		}
		TextWait
	elif system[10] == 7:
		TextTalk name[7] {
			#01401F沒時間回頭了。
			──趕緊追上他們吧。{wait}
		}
		TextWait
	CharSetPos field_party[0] (2860, -8000, -8020) 0deg
	EventEnd 4
	Return

