fn[7]:
	if flag[2848] && !flag[2858] | flag[2369] && system[4] == 1:
		ED7_76_0 object[255] "light01" 1
		ED7_76_0 object[255] "model05_light" 1
		SoundPlay sound[128] 1 50 0
	if !flag[3385] && flag[3370]:
		MapColor 0x00E6D2D2 0ms
		ED7_76_0 object[255] "light01" 1
		ED7_76_0 object[255] "model05_light" 1
	Return

fn[8]:
	TextStart self
	if flag[3385]:
		if !flag[0]:
			TextTalk self {
				就是在這種時候，
				一家人才更應該待在一起啊。{wait}
			}
			TextWait
			TextTalk self {
				無論如何，我兒子和兒媳
				沒出事就好。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				幸好身為全家支柱的
				兒子和兒媳沒出事。{wait}
			}
			TextWait
			TextTalk self {
				就是在這種時候，
				一家人才更應該待在一起啊。{wait}
			}
			TextWait
	elif flag[3371]:
		if !flag[0]:
			TextTalk self {
				最重要的是，不管發生什麼事，
				都要用堅定的態度去面對。{wait}
			}
			TextWait
			TextTalk self {
				只要態度夠堅定，想必那些
				容易傳染給他人的恐慌與不安
				也不會影響到自己。{wait}
			}
			TextWait
			TextTalk self {
				雖然孩子們應該也很擔心
				兒子和兒媳他們……
				但我得振作一點才行。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				只要態度夠堅定，想必那些
				容易傳染給他人的恐慌與不安
				也不會影響到自己。{wait}
			}
			TextWait
			TextTalk self {
				雖然孩子們應該也很擔心
				兒子和兒媳他們……
				但我得振作一點才行。{wait}
			}
			TextWait
	elif flag[3089]:
		if !flag[0]:
			TextTalk self {
				接下來，克洛斯貝爾的局勢
				可能會變得越來越艱困。{wait}
			}
			TextWait
			TextTalk self {
				但是，只要我們一家人團結一致，
				一定會沒事的……{wait}
			}
			TextWait
			TextTalk self {
				不管發生什麼事，
				大家都要同心協力，
				克服萬難才行。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				接下來，克洛斯貝爾的局勢
				可能會變得越來越艱困。{wait}
			}
			TextWait
			TextTalk self {
				不管發生什麼事，
				大家都要同心協力，
				克服萬難才行。{wait}
			}
			TextWait
	elif flag[3074]:
		if !flag[0]:
			Call fn[0,9]
		else:
			TextTalk self {
				因為我兒子和瑪麗埃塔
				都在遭到破壞的ＩＢＣ上班，
				現在都非常忙碌。{wait}
			}
			TextWait
			TextTalk self {
				唉，真希望他們多注意自己，
				別把身子給弄壞了。{wait}
			}
			TextWait
	elif flag[2861]:
		if !flag[0]:
			TextTalk self {
				雖然不知道
				那些武裝集團分子
				到底是從哪裡冒出來的……{wait}
			}
			TextWait
			TextTalk self {
				把無辜的人們也拖下水，
				真是不可原諒。{wait}
			}
			TextWait
			TextTalk self {
				希望警備隊可以
				盡早把瑪因茲的居民
				給救出來。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				把無辜的人們也拖下水，
				真是不可原諒。{wait}
			}
			TextWait
			TextTalk self {
				希望警備隊可以
				盡早把瑪因茲的居民
				從武裝集團手裡救出來。{wait}
			}
			TextWait
	elif flag[2848]:
		if !flag[0]:
			TextTalk self {
				今天安里
				好像也出門了。{wait}
			}
			TextWait
			TextTalk self {
				我是不至於叫他
				下雨天要待在家裡，不過……{wait}
			}
			TextWait
			TextTalk self {
				希望他自己要小心一點，
				別淋雨感冒了。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				我是不至於叫他
				下雨天要待在家裡，不過……{wait}
			}
			TextWait
			TextTalk self {
				希望他自己要小心一點，
				別淋雨感冒了。{wait}
			}
			TextWait
	elif flag[2837]:
		TextTalk self {
			我剛才在
			教導莘蒂
			一些做菜的訣竅。{wait}
		}
		TextWait
		TextTalk self {
			呼……
			完成一項工作後，茶喝起來特別美味。{wait}
		}
		TextWait
	elif flag[2832]:
		if !flag[0]:
			Call fn[0,10]
		else:
			TextTalk self {
				好了，接下來只要等到烤好就好。
				自己試看看吧。{wait}
			}
			TextWait
	elif flag[2816]:
		if !flag[0]:
			TextTalk self {
				克洛斯貝爾獨立建國……
				若是能夠實現，
				我也覺得再好不過了。{wait}
			}
			TextWait
			TextTalk self {
				但想當然帝國和共和國
				一定會出手施壓，
				想達成並不容易。{wait}
			}
			TextWait
			TextTalk self {
				還是說迪塔市長
				有什麼好方法呢……？{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				克洛斯貝爾獨立建國……
				若是能夠實現，
				我也覺得再好不過了。{wait}
			}
			TextWait
			TextTalk self {
				迪塔市長
				有什麼好方法呢……{wait}
			}
			TextWait
	elif flag[2573]:
		if !flag[0]:
			TextTalk self {
				莘蒂她今天好像
				到隔壁鄰居家玩了。{wait}
			}
			TextWait
			TextTalk self {
				海瓦茲先生的太太
				似乎常常在烹飪教室
				照顧她的樣子……{wait}
			}
			TextWait
			TextTalk self {
				下次我要好好向她道謝才行。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				海瓦茲先生的太太
				常常在照顧莘蒂。{wait}
			}
			TextWait
			TextTalk self {
				下次我要好好向她道謝才行。{wait}
			}
			TextWait
	elif flag[2568]:
		if !flag[0]:
			Call fn[0,11]
		else:
			TextTalk self {
				瑪麗埃塔小姐
				好像也很忙碌……{wait}
			}
			TextWait
			TextTalk self {
				想要全家團圓在一起吃飯，
				看來還要等上一段時間了。{wait}
			}
			TextWait
	elif flag[2564]:
		if !flag[0]:
			TextTalk self {
				從住宅區這裡
				就能看到揭幕儀式，不過……{wait}
			}
			TextWait
			TextTalk self {
				以前想都不曾想過，
				竟然會蓋那麼高的建築物。{wait}
			}
			TextWait
			TextTalk self {
				內部的設備上也樣樣齊全，
				比起舊市政廳大樓要
				好上太多……{wait}
			}
			TextWait
			TextTalk self {
				那場揭幕儀式
				就像要昭告世人，
				歷史即將寫下新的一頁似的。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				蘭花塔……
				以前想都不曾想過，
				竟然會蓋那麼高的建築物。{wait}
			}
			TextWait
			TextTalk self {
				技術的進步
				還真是驚人呢。{wait}
			}
			TextWait
	elif flag[2560]:
		if !flag[0]:
			TextTalk self {
				之前搬過來的
				那些共和國出身的孩子們……{wait}
			}
			TextWait
			TextTalk self {
				他們似乎
				以找他人麻煩為樂呢。{wait}
			}
			TextWait
			TextTalk self {
				唉，真是悲哀……
				到底是受了什麼樣的教育啊？{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				孩子要怎麼成長，
				全看家長是怎麼樣去教育。{wait}
			}
			TextWait
			TextTalk self {
				我認為引領孩子不走入歧途，
				也是家長的任務。{wait}
			}
			TextWait
	elif flag[2369]:
		if !flag[0]:
			Call fn[0,12]
		else:
			TextTalk self {
				菲利克說話粗魯，
				也說不上有禮貌，
				不過他是個會為他人著想的溫柔孩子。{wait}
			}
			TextWait
			TextTalk self {
				呵呵，真高興他能
				長成一個好孩子。{wait}
			}
			TextWait
	elif flag[2353]:
		if !flag[0]:
			TextTalk self {
				安里他最近不只玩而已，
				看來對於學習
				也越來越有興趣。{wait}
			}
			TextWait
			TextTalk self {
				呵呵，是在主日學校
				有了競爭對手嗎？{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				多玩、多學……
				我認為這就是小孩子
				最應該有的模樣。{wait}
			}
			TextWait
			TextTalk self {
				希望安里不論是在
				遊戲還是學習上，
				都能全心全意投入。{wait}
			}
			TextWait
	TextEnd self
	Return

