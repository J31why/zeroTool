fn[4]:
	while 1:
		CharWalkToPos self (1790, 0, 500) 900mm/s 0
		Sleep 500ms
		CharTurnTo self 0deg 500deg/s
		CharWalkToPos self (1790, 0, 1500) 900mm/s 0
		Sleep 500ms
		CharTurnTo self 180deg 500deg/s
	Return

fn[5]:
	while 1:
		CharIdle self (3890, null, 710) (5020, null, 9780) 1000mm/s
		Sleep 300ms
	Return

