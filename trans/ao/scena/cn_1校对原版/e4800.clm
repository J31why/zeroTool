	FadeIn 1000ms 0x00000000
	FadeWait
	TextTalk name[0] {
		#00000F雷蒙德先生……
		你還好嗎！？{wait}
	} {
		其實你可以把這件事
		交給我們處理……{wait}
	}
	TextWait
	TextTalk char[0] {
		哎、哎呀……
		這好歹是警部
		交派給我的事件嘛～{wait}
	}
	TextWait
	TextTalk char[0] {
		不能只讓你們
		搶走所有風頭啊～{wait}
	}
	TextWait
	if PartyPosition name[1] > -1:
		TextTalk name[1] {
			#00100F呵呵……
			謝謝你。{wait}
		} {
			對了，
			假貨商人呢……？{wait}
		}
		TextWait
	elif PartyPosition name[2] > -1:
		TextTalk name[2] {
			#00200F呵呵……
			我對他刮目相看了。{wait}
		} {
			所以，
			假貨商人呢……？{wait}
		}
		TextWait
	elif PartyPosition name[3] > -1:
		TextTalk name[3] {
			#00300F哈哈……
			這毅力真讓人欽佩。{wait}
		} {
			所以那位老婆婆
			上哪去啦……？{wait}
		}
		TextWait
	elif PartyPosition name[8] > -1:
		TextTalk name[8] {
			#10100F啊哈哈……
			謝謝。{wait}
		} {
			對了，
			假貨商人呢……？{wait}
		}
		TextWait
	elif PartyPosition name[4] > -1:
		TextTalk name[4] {
			#10300F呵呵……
			有這氣勢很不錯。{wait}
		} {
			好啦，那位夫人呢……？{wait}
		}
		TextWait
	CharTurnTo name[0] 0deg 500deg/s
