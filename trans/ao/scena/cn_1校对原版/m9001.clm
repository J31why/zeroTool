	ED7_76_0 object[255] "CA_stop" 1
	ED7_1D_0 0 1 0 (83270, -14500, 52380) 6000 2000 320000
	if !flag[3457]:
		ObjFrame object[4] 60
		ED7_76_2 object[5] "black_add" "night"
		ED7_76_2 object[5] "blue" "night"
		ED7_76_0 object[255] "CA_stop" 2
	else:
