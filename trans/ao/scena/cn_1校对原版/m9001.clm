		ED7_76_2 object[5] "black_add" "day"
		ED7_76_2 object[5] "blue" "day"
		ED7_1D_2 0 1
		ED7_76_1 object[255] "CA_stop" 2
	if !flag[4096]:
		ObjFrame object[1] 0
	else:
		ObjFrame object[1] 30
	if !flag[4097]:
		ObjFrame object[2] 0
	else:
		ObjFrame object[2] 30
	if !flag[4098]:
		ObjFrame object[3] 0
	else:
