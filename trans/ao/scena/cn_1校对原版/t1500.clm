	Return

fn[2]:
	while 1:
		CharWalkToPos self (-23040, 0, -6950) 2000mm/s 0
		CharWalkToPos self (-24930, 0, -6950) 2000mm/s 0
		CharWalkToPos self (-24930, -1000, -23250) 2000mm/s 0
		CharWalkToPos self (-23040, -1000, -23250) 2000mm/s 0
	Return

fn[3]:
	ObjFlagsSet object[13] 0x2000000
	ObjFlagsSet object[17] 0x2000000
	if flag[272] | flag[273] | flag[274]:
		ObjFlagsUnset object[13] 0x2000000
		ObjFlagsSet object[7] 0x2000000
		ObjFlagsSet object[8] 0x2000000
		ObjFlagsSet object[10] 0x2000000
		ObjFlagsSet object[11] 0x2000000
		ObjFlagsSet object[12] 0x2000000
		ObjFlagsSet object[14] 0x2000000
	if flag[275]:
		ObjFlagsUnset object[17] 0x2000000
		ObjFlagsSet object[7] 0x2000000
		ObjFlagsSet object[8] 0x2000000
		ObjFlagsSet object[10] 0x2000000
		ObjFlagsSet object[11] 0x2000000
		ObjFlagsSet object[12] 0x2000000
		ObjFlagsSet object[14] 0x2000000
	Return

fn[4]:
	if flag[3385]:
		CharFlagsUnset char[8] 0x0080
		CharSetPos char[1] (-20070, 0, -3580) 270deg
	elif flag[3362]:
		ForkFunc char[1] fork[0] fn[0,2]
	elif flag[3338]:
		ForkFunc char[1] fork[0] fn[0,2]
	elif flag[3328]:
		ForkFunc char[1] fork[0] fn[0,2]
		CharFlagsUnset char[2] 0x0080
	elif flag[3074]:
		if flag[3079] && flag[3080] && flag[3081]:
			if QuestFlagsGet quest[147] 0x10 | QuestFlagsGet quest[147] 0x40:
				CharFlagsUnset char[6] 0x0080
			else:
				CharFlagsSet char[0] 0x0080
		else:
			CharFlagsSet char[0] 0x0010
		CharSetPos char[1] (-23040, -1000, -25910) 180deg
		CharFlagsUnset char[2] 0x0080
	elif flag[2848]:
		CharFlagsSet char[1] 0x0080
	elif flag[2832]:
		ForkFunc char[1] fork[0] fn[0,2]
		CharFlagsUnset char[2] 0x0080
		CharSetPos char[2] (-36570, 3000, 16290) 90deg
	elif flag[2816]:
		ForkFunc char[1] fork[0] fn[0,2]
		CharFlagsUnset char[2] 0x0080
		CharFlagsUnset char[3] 0x0080
		CharFlagsSet char[3] 0x0010
	elif flag[2573]:
		CharFlagsSet char[0] 0x0010
		ForkFunc char[1] fork[0] fn[0,2]
		CharFlagsUnset char[4] 0x0080
		CharFlagsSet char[4] 0x0010
	elif flag[2564]:
		ForkFunc char[1] fork[0] fn[0,2]
		CharFlagsUnset char[2] 0x0080
		if !QuestFlagsGet quest[120] 0x10:
			CharFlagsUnset char[7] 0x0080
	elif flag[2560]:
		CharSetPos char[1] (-12330, -1000, -17370) 90deg
	if flag[3434]:
		CharFlagsUnset char[5] 0x0080
	if flag[272]:
		FlagUnset flag[272]
		Event fn[0,41]
	elif flag[273]:
		FlagUnset flag[273]
		FlagSet flag[0]
		Event fn[0,45]
