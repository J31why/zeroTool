fn[4]:
	Call fn[0,5]
	Return

fn[5]:
	TextStart char[9]
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"交談" // 0
			"買東西" // 1
			"放棄" // 2
		MenuWait var[0]
		if var[0] != 1:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			if flag[3074]:
				ShopOpen shop[4]
			elif flag[2816]:
				ShopOpen shop[3]
			elif flag[2573]:
				ShopOpen shop[2]
			elif flag[2560]:
				ShopOpen shop[1]
			else:
				ShopOpen shop[0]
			var[0] = 99
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			if !flag[0]:
				TextTalk char[9] {
					嗨，這不是達德利嗎？
					你正在和支援課的人一起散步嗎？{wait}
				}
				TextWait
				TextTalk name[9] {
					#00603F不，發生了一些令人在意的事情。{wait}
				} {
					#00600F只靠他們處理的話，我放不下心，
					我只是跟他們同行而已。{wait}
				}
				TextWait
				TextTalk char[9] {
					嘿！你也還是老樣子啊。{wait}
				}
				TextWait
				TextTalk char[9] {
					那也無所謂，本店快要打烊了，
					你們要逛的話要快一點喔。{wait}
				}
				TextWait
				FlagSet flag[0]
			else:
				TextTalk char[9] {
					本店快要打烊了。
					你們要逛的話要快一點喔。{wait}
				}
				TextWait
				TextTalk char[9] {
					我好想早點收工，然後去喝一杯。{wait}
				}
				TextWait
	TextEnd char[9]
	Return

fn[6]:
	Call fn[0,7]
	Return

fn[7]:
	TextStart char[0]
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"交談" // 0
			"買東西" // 1
			"放棄" // 2
		MenuWait var[0]
		if var[0] != 1:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			if flag[2816]:
				ShopOpen shop[9]
			else:
				ShopOpen shop[8]
			var[0] = 99
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			if !flag[1]:
				TextTalk char[0] {
					根據布朗的說法，
					儂諾好像有成為
					廚師的資質呢。{wait}
				}
				TextWait
				TextTalk char[0] {
					當初我只是想讓她幫忙做一些
					簡單的事情而已……{wait}
				}
				TextWait
				TextTalk char[0] {
					嗯，這或許是
					意外的收穫呢。{wait}
				}
				TextWait
				FlagSet flag[1]
			else:
				TextTalk char[0] {
					我本來只是想讓儂諾幫忙做一些
					簡單的事情而已……{wait}
				}
				TextWait
				TextTalk char[0] {
					嗯，這或許是
					意外的收穫呢。{wait}
				}
				TextWait
	TextEnd char[0]
	Return

fn[8]:
	TextStart self
	TextTalk self {
		好！明天乾脆
		就試著讓儂諾
		來做料理吧。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[9]:
	TextStart self
	TextTalk self {
		我完全沒有注意到，
		儂諾在不知不覺間已經擔任起
		備料的工作了。{wait}
	}
	TextWait
	TextTalk self {
		她該不會就這樣
		逐漸成為一個廚師吧……{wait}
	}
	TextWait
	TextEnd self
	Return

fn[10]:
	TextStart self
	TextTalk self {
		這個備料工作完成後，
		接著是洗盤子。{wait}
	}
	TextWait
	TextTalk self {
		呼……我們這裡的
		晚餐時段真的很忙碌呢。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[11]:
	TextStart self
	TextTalk self {
		呼，我今天不小心沉迷於讀書，
		久違地待到太陽下山了。{wait}
	}
	TextWait
	TextTalk self {
		感覺實在是很對不起店員，
		我乾脆直接在這裡吃晚餐吧。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[12]:
	TextStart self
	TextTalk self {
		今天我們兩個女人各自把家人
		放在一旁，來這裡吃晚餐。{wait}
	}
	TextWait
	TextTalk self {
		偶爾也需要過過這樣的生活呢。
		主婦也是很辛苦的。{wait}
	}
	TextWait
	TextEnd self
	Return

fn[13]:
	TextStart self
	TextTalk self {
		吃著許多自己喜歡的食物，盡情聊天……
		這就是我們紓壓的方法喔。{wait}
	}
	TextWait
	TextTalk self {
		來吧，今天要好好享受喔～！{wait}
	}
	TextWait
	TextEnd self
	Return

fn[14]:
	TextStart self
	TextTalk self {
		哦呵呵，雖然是老套了，
		但我並不討厭喔。{wait}
	}
	TextWait
	TextTalk self {
		我覺得我好像已經醉了㈱{wait}
	}
	TextWait
	TextEnd self
	Return

fn[15]:
	TextStart self
	TextTalk self {
		──為妳的眼眸乾杯。
		今晚似乎會是個特別的夜晚呢。{wait}
	}
	TextWait
	TextEnd self
	Return
