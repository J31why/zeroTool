fn[12]:
	TextStart self
	if flag[3385]:
		TextTalk self {
			原以為霧靄終於散開，
			可以眺望天空了……
			那棵樹到底是怎麼回事？{wait}
		}
		TextWait
		TextTalk self {
			看起來不像是武器……
			那也是總統幹的好事嗎？{wait}
		}
		TextWait
	elif flag[3371]:
	elif flag[3089]:
		if !flag[0]:
			TextTalk self {
				事態突然轉變的確讓人驚訝……
				但是，若不如此堅定地表達意見，
				只會被兩大國看不起而已吧？{wait}
			}
			TextWait
			TextTalk self {
				既然如此，我將堅決
				支持迪塔總統！{wait}
			}
			TextWait
			TextTalk self {
				亞里歐斯長官也在……
				不能再一直任兩大國
				姿意妄為下去了！{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				我當然也會覺得不安……
				但我堅決
				支持迪塔總統！{wait}
			}
			TextWait
			TextTalk self {
				不能再一直任兩大國
				姿意妄為下去了！{wait}
			}
			TextWait
	elif flag[3074]:
		if !flag[0]:
			TextTalk self {
				公園附近整棟倒塌的公司……
				據說是受雇於共和國政府。{wait}
			}
			TextWait
			TextTalk self {
				也許就是知道這一點，才會遭受
				帝國僱用的獵兵團攻擊……{wait}
			}
			TextWait
			TextTalk self {
				背後的原因無所謂……總之，
				在這克洛斯貝爾，我不希望
				他們再做一些多餘的事了。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				會變成這種情況，
				是因為克洛斯貝爾一直
				都是從屬州……沒錯吧？{wait}
			}
			TextWait
			TextTalk self {
				既然如此，我想還是應該
				向周遭各國明確地表示
				我們想要獨立的意願吧。{wait}
			}
			TextWait
	TextEnd self
	Return

