	} {
		#02901F但是那個叫做《紅色星座》的
		獵兵團真是令人生氣。{wait}
	} {
		#02903F我已經夠忙的了，
		還來給我惹事生非……{wait}
	} {
		#02901F要是以後讓我碰上，
		我一定要用盡各種手段
		把他們大卸八塊！！{wait}
	}
