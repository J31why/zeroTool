fn[10]:
	while 1:
		CharFlagsSet char[12] 0x8000
		_Char96 self (24500, -5500, -19700) 2000 1000
		CharSetChipPattern char[11] 0
		CharSetChipPattern char[9] 1
		_Char96 self (27500, -4800, -18000) 3000 1000
		CharSetChipPattern char[9] 0
		CharSetChipPattern char[10] 1
		_Char96 self (24500, -5500, -12200) 2000 1000
		CharSetChipPattern char[10] 0
		CharSetChipPattern char[8] 1
		_Char96 self (27500, -4800, -13000) 3000 1000
		CharSetChipPattern char[8] 0
		CharSetChipPattern char[11] 1
	Return

fn[11]:
	while 1:
		CharFlagsSet self 0x8000
		Sleep 1ms
	Return

fn[12]:
	CharSetChipBase char[27] chip[19]
	CharSetChipPattern char[27] 0
	ForkQuit char[27] fork[0]
	CharFlags2Set char[27] 0x0004
	ForkFunc char[27] fork[0] fn[0,11]
	if flag[2816]:
		CharFlagsSet char[26] 0x0080
		CharFlagsSet char[27] 0x0080
		ForkQuit char[27] fork[0]
	elif flag[2602]:
	elif flag[2600]:
		CharFlagsUnset char[0] 0x0080
		CharFlagsUnset char[1] 0x0080
