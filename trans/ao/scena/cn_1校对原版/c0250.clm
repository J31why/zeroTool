fn[7]:
	TextStart self
	if flag[3385]:
		if !flag[0]:
			TextTalk self {
				剛才我和賽西兒聯絡過。
				總之可以先放心了。{wait}
			}
			TextWait
			TextTalk self {
				只不過我覺得她
				似乎若有所思。{wait}
			}
			TextWait
			TextTalk self {
				我想應該不是因為
				醫院工作突然變忙，不過……{wait}
			}
			TextWait
			TextTalk self {
				如果有時間的話，
				還請你們到醫院一趟。
				我想她應該有很多話想說。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				感覺賽西兒她
				似乎若有所思，有些憂慮。{wait}
			}
			TextWait
			TextTalk self {
				如果有時間的話，
				還請你們到醫院一趟。
				我想她應該有很多話想說。{wait}
			}
			TextWait
	elif flag[3371]:
		if !flag[3567]:
			Emote self 0mm 2000mm 38 38 250ms 1
			Sleep 1000ms
			TextTalk self {
				啊，這不是羅伊德嗎……！
				你之前跑到哪裡去了？{wait}
			}
			TextWait
			TextTalk self {
				對了，你見到賽西兒了嗎？
				我一直沒能找到她……{wait}
			}
			TextWait
			TextTalk name[0] {
				#00012F阿、阿姨，妳先冷靜點。
				……好久不見了，真高興能見到妳。{wait}
			} {
				#00000F賽西兒姊姊她現在人在醫院。
				她看起來還蠻有精神的啦。{wait}
			}
			TextWait
			TextTalk self {
				是嗎？太好了……
				既然羅伊德也回來，
				阿姨這下真的可以放心了。{wait}
			}
			TextWait
			TextTalk self {
				外面很危險，
				你就先躲在阿姨家吧。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00004F不了，雖然很感謝妳，不過……
				有個地方，
				我們非去不可。{wait}
			} {
				#00000F阿姨，
				請妳在這裡等著。{wait}
			}
			TextWait
			TextTalk self {
				是嗎……我明白了。{wait}
			}
			TextWait
			TextTalk self {
				不過，你們路上要小心喔。
				要是你們發生什麼事的話，
				我、我實在是……{wait}
			}
			TextWait
			TextTalk name[0] {
				#00000F嗯，我們一定會小心。
				……再見囉。{wait}
			}
			TextWait
			FlagSet flag[3567]
		else:
			TextTalk self {
				太好了……
				羅伊德也回來了，
				阿姨這下真的可以放心了。{wait}
			}
			TextWait
			TextTalk self {
				天空女神啊，
				還請您保佑他們……{wait}
			}
			TextWait
	elif flag[3089]:
	elif flag[3074]:
		if !flag[0]:
			TextTalk self {
				昨天我試著
				和醫院連繫，不過……{wait}
			}
			TextWait
			TextTalk self {
				但是賽西兒她們
				似乎很忙的樣子。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00003F……想來也是。{wait}
			} {
				#00008F因為那場攻擊事件，
				醫院看來多了
				不少住院的傷者……{wait}
			}
			TextWait
			TextTalk self {
				唉，真叫人擔心。{wait}
			}
			TextWait
			TextTalk self {
				因為賽西兒她個性
				天生就是容易努力過頭……
				希望她不要弄壞身體了。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				受到那次攻擊事件影響，
				醫院那邊看來變得很忙。{wait}
			}
			TextWait
			TextTalk self {
				不知道賽西兒她
				有沒有好好休息……？{wait}
			}
			TextWait
	elif flag[2861]:
		TextTalk self {
			竟然會發生佔領事件，
			住在瑪因茲的人們
			一定都很害怕吧……{wait}
		}
		TextWait
		TextTalk self {
			聽說警備隊也陷入苦戰，
			局勢究竟會演變成什麼樣子……？{wait}
		}
		TextWait
	elif flag[2848]:
		if !flag[2915]:
			TextTalk self {
				啊，對了，
				話說明天就是彩虹劇團
				改版公演的日子是吧。{wait}
			}
			TextWait
			TextTalk self {
				聽說門票一下子
				就賣完了……{wait}
			}
			TextWait
			TextTalk self {
				呵呵，不知不覺中
				伊莉雅妹妹也變得這麼出名了啊。{wait}
			}
			TextWait
			TextTalk name[8] {
				#10105F伊、伊莉雅『妹妹』……？{wait}
			}
			TextWait
			TextTalk name[0] {
				#00005F這麼說來……
				賽西兒姊姊和伊莉雅
				好像是兒時玩伴？{wait}
			}
			TextWait
			TextTalk self {
				嗯，那時她就是個引人注目的小孩。
				她和賽西兒特別處得來，
				經常兩個人玩在一起。{wait}
			}
			TextWait
			TextTalk self {
				她曾經痛毆過一個
				欺負賽西兒的男孩子，
				還把人家給揍哭了。{wait}
			}
			TextWait
			TextTalk name[1] {
				#00100F呵呵，這趣事
				果然有伊莉雅的風格。{wait}
			}
			TextWait
			TextTalk name[3] {
				#00306F是說這樣聽起來，被揍的那小鬼頭
				好像還挺可憐的……{wait}
			}
			TextWait
			TextTalk name[4] {
				#10302F呵呵，小孩子會欺負人，
				有時反而就是因為喜歡人家呀。{wait}
			}
			TextWait
			TextTalk name[2] {
				#00203F算了，可以被伊莉雅揍，
				就某種角度來看，
				也算是一種寶貴的回憶吧。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00012F這、這我就不確定了……{wait}
			}
			TextWait
			FlagSet flag[2915]
		TextTalk self {
			呵呵，以前頑皮的伊莉雅妹妹，
			現在也成為帶領彩虹劇團的
			超級明星……{wait}
		}
		TextWait
		TextTalk self {
			我這位看著她長大的阿姨，
			也覺得與有榮焉呢。{wait}
		}
		TextWait
	elif flag[2837]:
		TextTalk self {
			哎呀呀，剛才那個……
			不是救護車的聲音嗎？{wait}
		}
		TextWait
		TextTalk self {
			聽起來有好幾台開過去……
			是發生車禍了嗎？{wait}
		}
		TextWait
	elif flag[2832]:
	elif flag[2816]:
		if !flag[0]:
			TextTalk self {
				關於克洛斯貝爾市獨立建國……
				聽說要舉行公民投票，
				來決定是否要獨立。{wait}
			}
			TextWait
			TextTalk self {
				這還真是個難題呢。
				我要和孩子的爸好好商量，
