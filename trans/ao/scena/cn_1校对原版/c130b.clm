fn[0]:
	if flag[272]:
		FlagUnset flag[272]
		Event fn[0,2]
	elif flag[273]:
		FlagUnset flag[273]
		FlagSet flag[0]
		FlagSet flag[1]
		Event fn[0,6]
	Return

fn[1]:
	if flag[0]:
		system[1] = 0
		FlagUnset flag[0]
	TriggerFlagsSet trigger[0] 0x0080
	if flag[3073] && !flag[3074]:
		TriggerFlagsUnset trigger[0] 0x0080
		MapColor 0x00D2DCFF 0ms
	if flag[1]:
		SoundStop sound[868]
		FlagUnset flag[1]
	elif flag[3073] && !flag[3074]:
		SoundPlay sound[868] 1 40 0
	Return

