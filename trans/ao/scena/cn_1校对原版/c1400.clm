fn[53]:
	TextStart null
	FadeOut 300ms 0x00000000 100
	TextSetName ""
	TextSetPos -1 -1 -1 -1
	TextMessage null {
		{color 5}公寓『伊美黛館』

		　～　現在關閉中　～{wait}
	}
	TextWait
	TextClose 0
	if ItemHas item[801] 0:
		_59
		TextSetPos -1 280 60 3
		TextMessage null {
			{color 5}是否要使用伊美黛館的鑰匙？{wait}
		}
		Menu menu[0] -1 -1 1
			"是" // 0
			"否" // 1
		MenuWait var[0]
		MenuClose menu[0]
		TextClose 0
		if var[0] == 0:
			_59
			Sleep 500ms
			SoundPlay sound[806] 0 100 0
			Sleep 1000ms
			TextMessage null {
				{color 5}打開了『伊美黛館』的門鎖。{wait}
			}
			TextWait
			TextClose 0
			QuestTaskSet quest[103] 1
			FlagSet flag[2457]
			ObjFlagsSet object[1] 0x0010
			LookPointFlagsSet look_point[1] 0x0001
	else:
		FadeIn 300ms 0x00000000
		if !flag[13]:
			TextTalk name[0] {
				#00000F……門好像被鎖上了。{wait}
			}
			TextWait
			TextTalk name[1] {
				#00105F擊退魔獸的支援請求的
				地點是這間公寓沒錯吧。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00003F我記得這間公寓的
				管理員是古董店店長
				『伊美黛夫人』吧。{wait}
			} {
				#00000F我們到小巷裡的
				古董店去借
				鑰匙過來吧。{wait}
			}
			TextWait
			FlagSet flag[13]
		else:
			TextTalk name[0] {
				#00000F擊退魔獸的支援
				請託的地點應該是
				這間公寓沒錯。{wait}
			} {
				#00000F我們到小巷裡的
				古董店去借
				鑰匙過來吧。{wait}
			}
			TextWait
	FadeIn 300ms 0x00000000
	_59
	TextSetPos -1 280 60 3
	TextEnd null
	Return
