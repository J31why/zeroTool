	} {
		#1230700008V#07008F……真令人懷念呢。{wait}
		#1230700009V#07002F也都沒見到雷歐學長，
		真想總有一天辦個同學會。{wait}
	}
	TextWait
	TextTalk char[1] {
		#1230350007V#12P#11501F……………………………………{wait}
	}
	TextWait
	TextTalk char[0] {
		#1230700010V#5P#07003F……學長，你這樣不行哦？{wait}
	} {
		#1230700011V#07002F『嗯，就在米修拉姆這樣的地方
