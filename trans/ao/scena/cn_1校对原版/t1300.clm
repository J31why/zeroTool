	EntranceSetFunc entrance[3] fn[0,38]
	EntranceSetFunc entrance[2] fn[0,39]
	if !flag[3089]:
		EntranceSetFunc entrance[0] fn[0,40]
	LookPointFlagsSet look_point[0] 0x0001
	if QuestFlagsGet quest[127] 0x02 && !QuestFlagsGet quest[127] 0x10 && !QuestFlagsGet quest[127] 0x40 && !flag[3660] && flag[3659]:
		LookPointFlagsUnset look_point[0] 0x0001
	Return

fn[3]:
	TextStart self
	if ItemHas item[861] 0 == 5:
		if !flag[0]:
			TextTalk char[6] {
				#00102F來吧，緹歐，
				看這邊。{wait}
			} {
				我現在幫你們
				拍張雙人合照。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[6] {
				#00102F來，笑一個！{wait}
			}
			TextWait
	elif ItemHas item[861] 0 == 4:
	elif ItemHas item[861] 0 == 3:
	elif ItemHas item[861] 0 == 2:
	elif ItemHas item[861] 0 == 1:
	TextEnd self
	Return

fn[4]:
	TextStart self
	if ItemHas item[861] 0 == 5:
		if !flag[2]:
			Call fn[0,5]
		else:
			TextTalk char[7] {
				#00204F我總算、
				總算來到
				主題樂園玩了……{wait}
			} {
				#00202F……總之，
				要先和咪西握手……{wait}
			}
			TextWait
	elif ItemHas item[861] 0 == 4:
	elif ItemHas item[861] 0 == 3:
	elif ItemHas item[861] 0 == 2:
	elif ItemHas item[861] 0 == 1:
		if !flag[1]:
			TextTalk char[7] {
				#00203F我們沒辦法在這裡待到
				晚上的表演開始，對不對？{wait}
			}
			TextWait
			TextTalk name[0] {
				#00000F是啊，今晚我們受邀要去參加
				迎賓館的晚宴。{wait}
			}
			TextWait
			TextTalk char[7] {
				#00206F……唉……{wait}
			}
			TextWait
			TextTalk name[0] {
				#00012F（她看起來好失望……）{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk char[7] {
				#00200F本來還以為
				有機會能看到
				晚場的咪西遊行……{wait}
			} {
				#00206F……唉，看來只能留到
				下次機會了。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[5]:
