fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if flag[2608]:
	elif flag[2607]:
	elif flag[2605]:
	elif flag[2604]:
		Call fn[0,25]
	elif flag[2602]:
	elif flag[2601]:
	elif flag[2600]:
	elif flag[2597]:
	elif flag[2592]:
	if flag[272]:
		FlagUnset flag[272]
		Event fn[0,28]
	elif flag[273]:
		FlagUnset flag[273]
		FlagSet flag[11]
		FlagSet flag[12]
		Event fn[0,29]
	elif flag[274]:
		FlagUnset flag[274]
		FlagSet flag[13]
		Event fn[0,44]
	Return

fn[2]:
	if flag[11]:
		system[1] = 0
		FlagUnset flag[11]
	elif flag[3385]:
		system[1] = 563
	if flag[12]:
		SoundStop sound[126]
		SoundStop sound[821]
		FlagUnset flag[12]
	elif flag[13]:
		SoundPlay sound[821] 1 60 0
		SoundStop sound[126]
		FlagUnset flag[13]
	elif flag[3093] && !flag[3100]:
		SoundStop sound[821]
		SoundPlayContinuously sound[126] (-18990, 3000, -55560) 80000 50000 100 0
		ED7_E1 (25500, 3000, -55560)
		SoundLoad sound[918]
		ForkFunc char[37] fork[3] fn[0,53]
	elif flag[3100]:
		SoundStop sound[821]
		SoundPlayContinuously sound[126] (-18990, 3000, -55560) 80000 50000 100 0
		ED7_E1 (25500, 3000, -55560)
	else:
		SoundPlay sound[821] 1 60 0
		SoundPlayContinuously sound[126] (-18990, 3000, -55560) 80000 50000 100 0
		ED7_E1 (25500, 3000, -55560)
	TriggerFlagsSet trigger[0] 0x0080
	if flag[3094] && !flag[3095]:
		TriggerFlagsUnset trigger[0] 0x0080
	if flag[3385]:
		MapColor 0x00FFEBDC 0ms
		Fog 0xFFD5B47B 20 500 0
		ObjFlagsUnset object[8] 0x0004
