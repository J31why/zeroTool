fn[0]:
	if flag[2313] && !flag[2352]:
		Event fn[0,3]
	if flag[272]:
		FlagUnset flag[272]
		FlagSet flag[0]
		Event fn[0,6]
	elif flag[273]:
		FlagUnset flag[273]
		FlagSet flag[1]
		Event fn[0,19]
	Return

