fn[6]:
	TextStart self
	if !flag[0]:
		TextTalk self {
			…………{wait}
		}
		TextWait
		TextTalk name[0] {
			#00001F……似乎徹底暈過去了。{wait}
		}
		TextWait
		TextTalk name[10] {
			#11102F呵呵，怎麼說得好像不關你的事。
			是我們讓他暈過去的不是嗎？{wait}
		}
		TextWait
		TextTalk name[0] {
			#00003F……我知道。{wait}
		} {
			#00001F雖然對他們很抱歉，
			不過就這樣繼續前進吧。{wait}
		}
		TextWait
		FlagSet flag[0]
	else:
		TextSetName ""
		TextMessage null {
			{color 5}國防軍士兵已經昏厥。{color 0}{wait}
		}
		TextWait
		TextClose 0
		_59
	TextEnd self
	Return

