fn[6]:
	TextSetName ""
	TextMessage null {
		{color 5}放有一本導力車雜誌『導力車狂熱vol.２』。{color 0}{wait}
	}
	TextWait
	TextClose 0
	_59
	TextSetPos -1 280 60 3
	if flag[393] && !ItemHas item[882] 0:
		SoundPlay sound[17] 0 100 0
		TextSetPos -1 -1 -1 -1
		TextSetName ""
		TextMessage null {
			記住了
			{color 2}『流行配色』{color 0}的噴漆樣式。{wait}
		}
		TextWait
		TextClose 0
		_59
		TextSetPos -1 280 60 3
		ItemAdd item[882] 1
	TextEnd null
	Return

