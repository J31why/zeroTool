			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			FadeWait
			_59
			TextSetPos -1 280 60 3
	TextEnd null
	Return

fn[8]:
	TextStart self
	if QuestFlagsGet quest[130] 0x02 && !QuestFlagsGet quest[130] 0x10 && !QuestFlagsGet quest[130] 0x40 && flag[2976] && !flag[2978]:
		Call fn[0,42]
		TextEnd self
		Return
	if flag[3385]:
		if !flag[0]:
			TextTalk char[0] {
				那棵莫名其妙的大樹出現時，
				我本來還擔心傑克
				會不會被嚇到……{wait}
			}
			TextWait
			TextTalk char[0] {
				沒想到哈羅德一句話，
				反而讓他卯起勁來了。{wait}
			}
			TextWait
			TextTalk char[0] {
				商人最重要的就是想賺錢的氣魄……
				既然傑克開始有這股氣魄，
				以後肯定不用擔心了。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				商人最重要的就是想賺錢的氣魄……
				現在傑克也開始有這股氣魄了。{wait}
			}
			TextWait
			TextTalk char[0] {
				不管克洛斯貝爾這次會怎樣，
				我都已經沒有遺憾了。{wait}
			}
			TextWait
	elif flag[3362]:
		if !flag[0]:
			TextTalk char[0] {
				哈羅德有蘇菲亞小姐和
				柯林這兩個家人
				堅定地支持著他。{wait}
			}
			TextWait
			TextTalk char[0] {
				嗯，如果傑克身邊也有
				這樣的人，說不定……{wait}
			}
			TextWait
			TextTalk char[0] {
				等我退休後，開始認真
				替孫子找孫媳婦，
				似乎也不壞。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				嗯，如果傑克也能找到
				於公於私都能
				支持他的老婆……{wait}
			}
			TextWait
			TextTalk char[0] {
				替孫子找孫媳婦，
				似乎也不壞。{wait}
			}
			TextWait
	elif flag[3328]:
		if !flag[0]:
			TextTalk char[0] {
				在國防軍配給的
				物資方面，哈羅德幫我們
				進行了多次交涉。{wait}
			}
			TextWait
			TextTalk char[0] {
				就算這個村子有辦法
				自給自足，還是相當需要
				常備藥這類的物資。{wait}
			}
			TextWait
			TextTalk char[0] {
				傑克那小子要是
				也能做到那樣就好了……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				傑克那小子，
				要是也能成為哈羅德
				那麼積極的商人就好了……{wait}
			}
			TextWait
			TextTalk char[0] {
				……不行不行，最近他
				好不容易才提起幹勁。
				我可不能對他太嘮叨。{wait}
			}
			TextWait
	elif flag[3074]:
		if !flag[0]:
			TextTalk char[0] {
