fn[4]:
	TextStart self
	if flag[2608]:
		if !flag[3]:
			TextTalk char[0] {
				#06406F琪雅她
				一個人進入
				主題樂園了嗎？{wait}
			} {
				#06401F總、總之，如果發生什麼事，
				請馬上連絡我喔。{wait}
			} {
				如果狀況不對，
				我會向警察總部請求支援的！{wait}
			}
			TextWait
			FlagSet flag[3]
		else:
			TextTalk char[0] {
				#06406F在這麼晚的時間，
				琪雅一個人不要緊嗎？{wait}
			} {
				#06401F總、總之，如果發生什麼事，
				請馬上連絡我喔。{wait}
			}
			TextWait
	elif flag[2605]:
	elif flag[2604]:
	elif 0:
	elif flag[2602]:
	elif flag[2601]:
	elif flag[2600]:
	elif flag[2597]:
	TextEnd self
	Return

fn[5]:
	TextStart self
	if flag[2608]:
		var[0] = 99
		while var[0] == 99:
			FadeOut 300ms 0x00000000 100
			Menu menu[0] -1 -1 1
				"談話" // 0
				"請求治療" // 1
				"放棄" // 2
			MenuWait var[0]
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
			if var[0] == 0:
				var[0] = 99
				if !flag[4]:
					TextTalk char[1] {
						#05900F如果發生什麼事，
						請馬上呼叫我。{wait}
					} {
						#05903F我有帶急救箱之類的來，
