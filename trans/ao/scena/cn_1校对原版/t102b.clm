				}
				TextWait
			elif var[0] == 2:
			elif var[0] != 0:
				TextEnd char[1]
				Return
	elif flag[2605]:
	elif flag[2604]:
	elif flag[2602]:
	elif flag[2601]:
	elif flag[2600]:
	elif flag[2597]:
	TextEnd self
	Return

