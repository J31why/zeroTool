fn[0]:
	if system[0] == 0:
		if global[0] == 15:
			global[0] = 0
			Event fn[0,6]
		elif global[0] == 16:
			global[0] = 0
			Event fn[0,8]
		elif global[0] == 17:
			global[0] = 0
			Event fn[0,10]
	Return

fn[1]:
	SystemFlagsSet 0x00000002
	if system[0] == 133:
		BgmVolume 100 100ms
	ObjFlagsUnset object[20] 0x0010
	ED7_76_2 object[15] "m00ele00" "up_kp"
	ED7_76_2 object[16] "m00ele00" "up_kp"
	ED7_76_2 object[17] "m00ele00" "up_kp"
