	ED7_76_0 object[14] "light01" 1
	TriggerFlagsSet trigger[0] 0x0080
	if flag[2568] && !flag[2570]:
		TriggerFlagsUnset trigger[0] 0x0080
	if !flag[2573] && flag[2568]:
		EntranceSetDisabled entrance[30] 0
		EntranceSetDisabled entrance[40] 1
		EntranceSetDisabled entrance[31] 0
		EntranceSetDisabled entrance[41] 1
	else:
		EntranceSetDisabled entrance[30] 1
		EntranceSetDisabled entrance[40] 0
		EntranceSetDisabled entrance[31] 1
		EntranceSetDisabled entrance[41] 0
