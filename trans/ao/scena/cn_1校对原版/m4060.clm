fn[0]:
	while 1:
		CharSetChipPattern self 0
		Sleep 100ms
		CharSetChipPattern self 1
		Sleep 100ms
		CharSetChipPattern self 2
		Sleep 100ms
		CharSetChipPattern self 3
		Sleep 100ms
		CharSetChipPattern self 4
		Sleep 100ms
