fn[8]:
	ED7_F2 2
	FadeOut 300ms 0x00000000 100
	TextMessage name[742] {
		{color 5}有可恢復導力器的裝置。{color 0}{wait}
	}
	Menu menu[0] -1 -1 1
		"在此地休息" // 0
		"放棄" // 1
	MenuWait var[0]
	MenuClose menu[0]
	TextClose 0
	if var[0] == 0:
		FadeIn 100ms 0x00000000
		Sleep 500ms
		SoundLoad sound[13]
		ED7_74 object[5] 0 30
		SoundPlay sound[7] 0 100 0
		ObjFrame object[5] 0
		ED7ObjPlay object[5] 0 30 0 0
		ObjWait object[5]
		ED7ObjPlay object[5] 31 390 0 32
		Sleep 1000ms
		BgmStop 3000ms
