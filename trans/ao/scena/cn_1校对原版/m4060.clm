		TriggerFlagsUnset trigger[0] 0x0080
	LookPointFlagsSet look_point[5] 0x0001
	if !flag[2345]:
		LookPointFlagsUnset look_point[5] 0x0001
	ObjFlagsUnset object[3] 0x0010
	if !flag[2345]:
		ObjFrame object[3] 0
		ObjFrame object[4] 0
	else:
