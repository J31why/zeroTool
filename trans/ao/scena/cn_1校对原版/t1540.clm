fn[48]:
	TextStart self
	if flag[3385]:
		TextTalk self {
			東邊天空中那棵
			淡藍色的樹到底是……！？{wait}
		}
		TextWait
		TextTalk self {
			噢！女神啊！
			請救救我們吧……！{wait}
		}
		TextWait
	elif flag[3362]:
		TextTalk self {
			克洛斯貝爾會何去何從……
			只有女神知道答案。{wait}
		}
		TextWait
		TextTalk self {
			希望她能指引我們
			一條救贖之路……{wait}
		}
		TextWait
	TextEnd self
	Return

fn[49]:
	TextStart self
	if flag[3385]:
		TextTalk self {
			我今天可以出院了，
			讓我安心了不少。{wait}
		}
		TextWait
		TextTalk self {
			雖然外面是那樣的狀況，不過……
			我還是想回家讓家人放心。{wait}
		}
		TextWait
	elif flag[3362]:
		if !flag[29]:
			Call fn[0,15]
		else:
			TextTalk self {
				呼，既然醫生都那樣說了，
				應該是沒問題吧，不過……{wait}
			}
			TextWait
	TextEnd self
	Return

fn[50]:
	TextStart self
	if flag[3385]:
		TextTalk self {
			看來那些巡房的醫生也很忙啊。{wait}
		}
		TextWait
		TextTalk self {
			應該是因為門診病患大批湧入的關係吧。
			希望他們能堅持下去。{wait}
		}
		TextWait
	elif flag[3362]:
		TextTalk self {
			醫院好像也有難題要處理，不過……
			醫生們似乎都正在努力解決。{wait}
		}
		TextWait
		TextTalk self {
			烏爾斯拉醫院果然值得信賴……
			所以我們才能在這裡安心住院。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[51]:
	SoundPlay sound[160] 0 100 0
	Return

