fn[0]:
	if system[0] == 101:
		Event fn[0,4]
	if flag[272]:
		FlagUnset flag[272]
		Event fn[0,31]
	elif flag[273]:
		FlagUnset flag[273]
		Event fn[0,34]
	elif !flag[3404] && !flag[274]:
		Event fn[0,8]
	Return

fn[1]:
	ED7_EE 1 800
	if !flag[3404] && !flag[274]:
		system[1] = 0
	EntranceSetFunc entrance[1] fn[0,5]
	TriggerFlagsSet trigger[0] 0x0080
	if flag[3403] && !flag[3404]:
		TriggerFlagsUnset trigger[0] 0x0080
	char[0].45 = 1050
	char[0].46 = 1050
	char[0].47 = 1050
	ObjFlagsSet object[2] 0x1000
	ObjFlagsUnset object[2] 0x0004
	if flag[3404]:
		ObjFlagsSet object[2] 0x0004
		ED7_76_1 object[255] "magi10_add" 1
		ED7_76_1 object[255] "magi11_add" 1
		ED7_76_1 object[255] "point_add" 1
		ED7_76_0 object[255] "magi_04_add" 1
		ObjFrame object[1] 150
	else:
		ED7_76_0 object[255] "magi10_add" 1
		ED7_76_0 object[255] "magi11_add" 1
		ED7_76_0 object[255] "point_add" 1
		ED7_76_1 object[255] "magi_04_add" 1
		ObjFrame object[1] 60
	if flag[3404]:
		Call fn[0,42]
	Return

fn[2]:
	CharFlagsSet char[0] 0x0010
	TextStart char[0]
	if !flag[3704]:
		TextTalk char[0] {
			…………{wait}
		}
		TextWait
		TextTalk name[0] {
			#00001F……他似乎徹底暈過去了。
			好像也沒有生命危險。{wait}
		}
		TextWait
		TextTalk name[3] {
			#00306F真是個不得了的對手啊……
			一次對上我們全體，竟然還能打成這樣。{wait}
		}
		TextWait
		TextTalk name[2] {
			#00208F真不愧是《風之劍聖》……{wait}
		}
		TextWait
		if PartyPosition name[9] > -1:
			TextTalk name[9] {
				#00603F哼……竟然能打贏。{wait}
			}
			TextWait
		TextTalk name[0] {
			#00003F小滴想必也很擔心，所以我是很想
			馬上把他抬回梅爾卡巴去，但是……{wait}
		} {
			#00001F……瑪利亞貝爾小姐和伊安律師
			就在前方等著。{wait}
		} {
			#00003F雖然有點對不起他，
			但還是晚一點再處理吧。{wait}
		}
		TextWait
		TextTalk name[1] {
			#00100F是啊……我們走吧。{wait}
		}
		TextWait
		FlagSet flag[3704]
	else:
		TextTalk char[0] {
			…………{wait}
		}
		TextWait
		TextSetName ""
		TextMessage null {
			{color 5}似乎完全暈過去了。{color 0}{wait}
		}
		TextWait
		TextClose 0
		_59
	TextEnd char[0]
	Return

fn[3]:
	ED7_F2 2
	FadeOut 300ms 0x00000000 100
	TextMessage name[742] {
		{color 5}有可恢復導力器的裝置。{color 0}{wait}
	}
	Menu menu[0] -1 -1 1
		"在此地休息" // 0
		"放棄" // 1
	MenuWait var[0]
	MenuClose menu[0]
	TextClose 0
	if var[0] == 0:
		FadeIn 100ms 0x00000000
		Sleep 500ms
		SoundLoad sound[13]
		ED7_74 object[0] 0 30
		SoundPlay sound[7] 0 100 0
		ObjFrame object[0] 0
		ED7ObjPlay object[0] 0 30 0 0
		ObjWait object[0]
		ED7ObjPlay object[0] 31 390 0 32
		Sleep 1000ms
		BgmStop 3000ms
		FadeOut 1000ms 0x00000000 255
		Sleep 700ms
		SoundPlay sound[13] 0 100 0
		FadeWait
		PartySetAttr name[255] 254 0
		CamLookChar field_party[0] 0ms
		ED7_31 1
		Sleep 3500ms
		ObjFrame object[0] 0
		BgmResume
		FadeIn 1000ms 0x00000000
		TextClose 0
		TextEnd null
		Return
	else:
		FadeIn 300ms 0x00000000
		TextEnd null
		Return
	Return
	Return

