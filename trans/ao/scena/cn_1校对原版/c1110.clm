fn[10]:
	_Char4A char[8] 255
	_Char4A char[0] 255
	if !flag[0]:
		TextTalk char[8] {
			嗯，是想盡量找比較
			便宜的地方……{wait}
		}
		TextWait
		TextTalk char[8] {
			稍微小一點也無所謂，
			只要能讓一家三口住……
			有沒有什麼好地方呢？{wait}
		}
