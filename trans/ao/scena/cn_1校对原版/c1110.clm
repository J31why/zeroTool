fn[4]:
	Call fn[0,5]
	Return

fn[5]:
	if QuestFlagsGet quest[106] 0x02 && !QuestFlagsGet quest[106] 0x10 && !QuestFlagsGet quest[106] 0x40:
		if flag[2446] && flag[2447] && flag[2449] && flag[2450]:
			Call fn[0,28]
			Return
		elif !flag[2444]:
			Call fn[0,27]
			Return
	TextStart char[0]
	if flag[3385]:
		if !flag[0]:
			TextTalk char[0] {
				職員們有分頭去確認
				在戒嚴令的騷動下
				市民安全與否……{wait}
			}
			TextWait
			TextTalk char[0] {
				除了因為被捲入騷動
				而有十幾名市民受到輕傷之外，
				幾乎沒有出現傷亡。{wait}
			}
			TextWait
			TextTalk char[0] {
				至於需要治療的人，
				我們也安排了救護車……
				目前算是可以放心了。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				由於戒嚴令而引發的騷動，
				除了有十幾名市民受到輕傷之外，
				幾乎沒有出現傷亡。{wait}
			}
			TextWait
			TextTalk char[0] {
				至於需要治療的人，
				我們也安排了救護車……
				目前算是可以放心了。{wait}
			}
			TextWait
	elif flag[3371]:
		if !flag[0]:
			TextTalk char[0] {
				現在市民會館
				也已準備好，隨時可以收容
				回不了家的市民們。{wait}
			}
			TextWait
			TextTalk char[0] {
				如果有什麼不便的地方，
				請別客氣，儘管吩咐。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				市民會館也備有，食物和毯子等，
				急難用的民生用品。{wait}
			}
			TextWait
			TextTalk char[0] {
				如果有什麼不便的地方，
				請別客氣，儘管吩咐。{wait}
			}
			TextWait
	elif flag[3089]:
		TextTalk char[0] {
			連這邊都能清楚聽到，
			齊聲高喊萬歲的聲音。{wait}
		}
		TextWait
		TextTalk char[0] {
			不知道為什麼，
			這讓我感覺有點害怕……{wait}
		}
		TextWait
	elif flag[3074]:
		TextTalk char[0] {
			非常感謝您今天來到
			這場慈善活動。{wait}
		}
		TextWait
		TextTalk char[0] {
			如果有想要參加的
			企劃活動的話，
			請儘管向櫃檯詢問。{wait}
		}
		TextWait
	elif flag[2861]:
		if !flag[0]:
			TextTalk char[0] {
				我們接到了非常多的
				市民來詢問
				關於襲擊瑪因茲的武裝集團的相關消息……{wait}
			}
			TextWait
			TextTalk char[0] {
				但關係到犯人或是事件的目的時，
				就不是我能回答的問題了，
				這讓我很困擾呢。{wait}
			}
			TextWait
			TextTalk char[0] {
				雖然很多傳聞都說是帝國做的……
				但真相到底又是如何呢？{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				雖然很多傳聞都說是帝國做的……
				但真相到底又是如何呢？{wait}
			}
			TextWait
	elif flag[2848]:
		TextTalk char[0] {
			目前左手邊的複合式展演廳，
			正舉辦以國家獨立為主題的
			市民論壇。{wait}
		}
		TextWait
		TextTalk char[0] {
			不論是誰都可以旁聽，
			有興趣的話都可以前往參與喔。{wait}
		}
		TextWait
	elif flag[2837]:
		TextTalk char[0] {
			關於這點，旁聽的部分
			是可以當天參加的……{wait}
		}
		TextWait
		TextTalk char[0] {
			但很遺憾
			位子已經額滿了……{wait}
		}
		TextWait
	elif flag[2832]:
		TextTalk char[0] {
			歡迎光臨。
			歡迎來到克洛斯貝爾市民會館。{wait}
		}
		TextWait
		TextTalk char[0] {
			有想使用市民會館的來賓，
			請先至櫃檯旁，並且
			填妥這邊的申請表。{wait}
		}
		TextWait
	elif flag[2816]:
		if !flag[0]:
			TextTalk char[0] {
				因為收到提倡國家獨立的訊息，
				而想來這裡舉辦討論會的
				詢問有增加的趨勢。{wait}
			}
			TextWait
			TextTalk char[0] {
				瞭解到有這樣的需求，所以市府和通訊社
				便決定要在後天一起來
				舉辦市民論壇。{wait}
			}
			TextWait
			TextTalk char[0] {
				目前還在做各方面的調整，
				相信到時候一定能舉辦出
				對各位來說極具意義的論壇會。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				預計後天將在這市民會館，
				以克洛斯貝爾的國家獨立為主題，
				舉辦一場市民論壇。{wait}
			}
			TextWait
			TextTalk char[0] {
				目前還在做各方面的調整，
				相信到時候一定能舉辦出
				對各位來說極具意義的論壇會。{wait}
			}
			TextWait
	elif flag[2573]:
		TextTalk char[0] {
			非、非常抱歉。
			應該之前就
			已經有刊出告示了才對……{wait}
		}
		TextWait
		TextTalk char[0] {
			從保障安全這一點來看的話，
			是不可以讓一般民眾
			通過的。{wait}
		}
		TextWait
	elif flag[2564]:
		if !flag[0]:
			TextTalk char[0] {
				各國的領導人，終於
				都進到克洛斯貝爾來了。{wait}
			}
			TextWait
			TextTalk char[0] {
				我是聽說下午時，
				他們會各自行動的樣子……{wait}
			}
			TextWait
			TextTalk char[0] {
				他們這段時間
				是怎麼度過的呢？{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				我是聽說下午時，
				各國領導人會各自行動的樣子……{wait}
			}
			TextWait
			TextTalk char[0] {
				他們這段時間
				是怎麼度過的呢？{wait}
			}
			TextWait
	elif flag[2560]:
		TextTalk char[0] {
			在通商會議前後的期間裡，
			是無法使用
			市民會館的。{wait}
		}
		TextWait
		TextTalk char[0] {
			這邊離蘭花塔也很近，
			真的發生什麼事可就不好了。{wait}
		}
		TextWait
	elif flag[2369]:
		if QuestFlagsGet quest[106] 0x10:
			TextTalk char[0] {
				各位，非常感謝
				你們今天幫忙調查。{wait}
			}
			TextWait
			TextTalk char[0] {
				今後也請多多利用
				克洛斯貝爾市民會館。{wait}
			}
			TextWait
		elif QuestFlagsGet quest[106] 0x02:
			TextTalk char[0] {
				想拜託各位的是，
				調查合計三戶的可疑住戶，以及
				聯絡不到的前住戶的消息。{wait}
			}
			TextWait
			TextTalk char[0] {
				等各位全部確認完之後，
				就請回來這邊回報。{wait}
			}
			TextWait
		else:
	elif flag[2353]:
		Call fn[0,10]
	TextEnd char[0]
	Return

fn[6]:
	TextStart self
	if flag[2353]:
		TextTalk self {
			如果能找到
			好房子就好了。{wait}
		}
		TextWait
		TextTalk self {
