fn[18]:
	EventBegin 0
	CrossFade 500ms
	CamSetDistance 0 1000 5750 0ms
	ED7CamRotate 0deg 25deg 0deg 0ms
	CamPers 650 0ms
	CamZoom 14000 0ms
	_Char4A char[7] 255
	CharSetPos name[0] (0, 0, 5000) 0deg
	FadeWait
	TextTalk char[7] {
		#1264570001V歡迎來到《占卜館》！{wait}
	}
	TextWait
	TextTalk char[7] {
		#1264570002V在這裡可以請厲害的占卜師
		占卜許多事情！{wait}
	}
	TextWait
	TextTalk char[7] {
		#1264570003V一次最多可以有兩位進場，
		請問您打算怎麼辦呢～？{wait}
	}
	TextWait
	TextTalk name[0] {
		#00004F#6P#1260000308V（……邀請誰一起來吧？）{wait}
	}
	TextWait
	var[0] = 0
	FadeOut 300ms 0x00000000 100
	FadeWait
	TextSetPos -1 5 -1 -1
	TextSetName ""
	TextMessage null {
		{color 5}{0x06}{0x18}#1K要邀請誰？{color 0}{wait}
	}
