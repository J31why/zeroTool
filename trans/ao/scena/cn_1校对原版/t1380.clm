fn[10]:
	if QuestFlagsGet quest[127] 0x02 && !QuestFlagsGet quest[127] 0x10 && !QuestFlagsGet quest[127] 0x40:
		TextStart self
		TextTalk self {
			歡迎來到《占卜館》！{wait}
		}
		TextWait
		TextTalk self {
			在這裡可以請厲害的占卜師
			占卜許多事情！{wait}
		}
		TextWait
		TextTalk name[0] {
			#00003F（現在還在跟咪謝玩捉迷藏……
			　暫時還是先別去玩
			　遊樂設施吧。）{wait}
		}
		TextWait
		TextEnd self
	else:
		Call fn[0,18]
	Return

fn[11]:
	TextStart self
	if ItemHas item[861] 0 != 1:
		TextTalk char[8] {
			放眼望去，果然
			有很多女性客人啊～……{wait}
		}
		TextWait
		TextTalk char[8] {
			幸好我是跟女朋友一起來，不然
			要是自己來這裡，一定會很不自在吧。{wait}
		}
		TextWait
	else:
		TextTalk char[8] {
			因為在缘分占卜上得到好結果，
			我女朋友的心情好多了。{wait}
		}
		TextWait
		TextTalk char[8] {
			一想到要是得出難以解釋的結果……
			那大概不只是尷尬而已了吧。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[12]:
	TextStart self
	if ItemHas item[861] 0 != 1:
		TextTalk char[9] {
			呵呵呵，要占卜什麼才好呢？
			果然還是我和他的缘分吧。{wait}
		}
		TextWait
	else:
		TextTalk char[9] {
			占卜的結果顯示，
			我們兩人是被命運的絲線
			緊緊相繫呢！{wait}
		}
		TextWait
		TextTalk char[9] {
			呵呵呵呵呵……
			看上他的我
			眼光果然精準。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[13]:
	TextStart self
	if ItemHas item[861] 0 != 1:
		TextTalk char[10] {
			我瞞著老公
			來占卜自己弄丟的
			結婚戒指在哪裡。{wait}
		}
		TextWait
		TextTalk char[10] {
			怎麼還不趕快輪到我呢……{wait}
		}
		TextWait
	else:
		TextTalk char[10] {
			我請占卜師占卜我以為
			弄丟的結婚戒指在哪裡……
			結果居然在我的口袋裡。{wait}
		}
		TextWait
		TextTalk char[10] {
			遠在天邊近在眼前原來是真的啊……
			雖然很高興能找到戒指，
			不過總覺得很丟臉。{wait}
		}
		TextWait
	TextEnd self
	Return

