	EventBegin 1
	_Char4A char[1] 255
	if flag[3149] && !flag[3151]:
		TextTalk char[1] {
			你們打算要進倉庫嗎～？{wait}
		}
		TextWait
		TextTalk char[1] {
			嗯……
			算了，是客人你們就沒關係吧～{wait}
		}
		TextWait
		TextTalk char[1] {
			不要碰些奇怪的東西喔～
			要是死了也沒晶歌的事喔。{wait}
		}
		TextWait
		TextTalk name[0] {
			#00012F……感、感謝妳如此費心。{wait}
		}
		TextWait
		FlagSet flag[3151]
		TriggerFlagsSet trigger[0] 0x0080
	elif !flag[3]:
		TextTalk char[1] {
			……喂，客人。
			晶歌的眼睛可沒那麼容易騙過去喔。{wait}
		}
		TextWait
		TextTalk char[1] {
			那邊是地下倉庫，
			相關人員以外是禁止出入的。
			如果要買東西，在這裡買！{wait}
		}
		TextWait
		FlagSet flag[3]
	else:
		TextTalk char[1] {
			喂，客人？
			有聽清楚晶歌說的話嗎？{wait}
		}
		TextWait
		TextTalk char[1] {
			說過要你們別進去地下倉庫了啊！！
			如果要買東西，在這裡買！！{wait}
		}
		TextWait
	Sleep 50ms
	CharSetPos field_party[0] (9940, 0, 11910) 180deg
	_Char4B char[1] 255
	EventEnd 4
	Return
