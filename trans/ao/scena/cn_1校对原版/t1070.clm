			CharFlagsUnset char[8] 0x0010
			CharTurnToChar char[9] char[8] 0deg/s
			CharFlagsUnset char[9] 0x0010
		CharFlagsUnset char[7] 0x0080
		CharSetPos char[7] (-5340, 0, 1100) 90deg
		CharFlagsUnset char[6] 0x0080
		CharFlagsSet char[6] 0x0010
	elif flag[2601]:
