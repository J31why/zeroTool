look_point[0]:
	pos (-4700, 0, 5000)
	radius 1000
	bubble_pos (-6500, 1500, 5000)
	unk1 126
	unk2 0
	function fn[0,8]
	unk3 0
	unk4 0

fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if flag[2608]:
	elif flag[2607]:
	elif flag[2605]:
		CharFlagsUnset char[4] 0x0080
		CharSetPos char[4] (100, 0, 5000) 90deg
		CharFlagsUnset char[5] 0x0080
		CharSetPos char[5] (1200, 0, 5000) 270deg
		if flag[2620] && flag[2779]:
			CharFlagsUnset char[4] 0x0010
			CharFlagsUnset char[5] 0x0010
		else:
