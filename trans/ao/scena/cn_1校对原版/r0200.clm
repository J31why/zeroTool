	TextTalk name[0] {
		#6P#00003F好久不見了，塞爾當分部長。{wait}
	} {
		#00001F我聽說這邊出現了
		不可思議的大型魔獸《幻獸》。{wait}
	}
	TextWait
	TextTalk char[2] {
		《幻獸》……
		嗯，這個稱呼相當貼切啊。{wait}
	}
	TextWait
	TextTalk char[2] {
		沒錯，其實那隻《幻獸》
		昨天傍晚突然出現在沼澤地深處。{wait}
	}
	TextWait
	TextTalk char[2] {
		我們這邊已經
		聯絡警備隊了……{wait}
	}
	TextWait
	TextTalk char[0] {
		#11P該不會，
		羅伊德你們特務支援課
		就是前來處理此事的嗎？{wait}
	}
	TextWait
	TextTalk name[1] {
		#6P#00103F是的，我們接到了警備隊的委託。{wait}
	} {
		#00101F可以把詳細情況
		告訴我們嗎？{wait}
	}
	TextWait
	TextTalk char[2] {
		好的，就如我剛才所說，
		我們第一次看到幻獸
		是在昨天傍晚……{wait}
	}
	TextWait
	TextTalk char[2] {
		當時真的沒有任何前兆，
		我們突然聽到一陣
		奇怪的叫聲。{wait}
	}
	TextWait
	TextTalk char[1] {
		#12P並且有可疑的身影在長期
		封鎖的沼澤地深處忽隱忽現……{wait}
	}
	TextWait
	TextTalk char[1] {
		#12P所以我們小心翼翼地靠近那裡。{wait}
	}
	TextWait
	TextTalk char[0] {
		#11P然後就發現了那隻
		不可思議的《幻獸》。{wait}
	}
	TextWait
	TextTalk char[0] {
		#11P於是我們急忙
		向警備隊報告這件事。{wait}
	}
	TextWait
	TextTalk char[2] {
		我們本來想要立刻逃離……
		不過《幻獸》並沒有打算要
		離開那個地方的跡象。{wait}
	}
	TextWait
	TextTalk char[2] {
		所以從昨天開始，
		我們先輪流監視觀察情況。{wait}
	}
	TextWait
	TextTalk name[2] {
		#6P#00203F……那真是辛苦你們了。{wait}
	}
	TextWait
	TextTalk name[8] {
		#6P#10101F監視期間有出現
		任何異狀嗎？{wait}
	}
	TextWait
	TextTalk char[2] {
		不，更詭異的
		就是什麼事情都沒發生。{wait}
	}
	TextWait
	TextTalk char[2] {
		雖然可以遠遠感覺到
		一股帶著敵意的意志，不過……{wait}
	}
	TextWait
	TextTalk char[1] {
		#12P該怎麼說呢……
		又有一種對方不是不行動，
		而是無法行動的感覺。{wait}
	}
	TextWait
	TextTalk char[1] {
		#12P只是詳細情況
		我也搞不清楚……{wait}
	}
	TextWait
	TextTalk name[4] {
		#6P#10303F原來如此，突然出現之後
		又不離開該地嗎……？{wait}
	}
	TextWait
	TextTalk name[3] {
		#6P#00301F該怎麼說呢，顯然應該跟
		『力場扭曲現象』
		有關係吧。{wait}
	}
	TextWait
	TextTalk name[0] {
