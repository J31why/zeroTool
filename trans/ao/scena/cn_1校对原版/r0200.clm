fn[3]:
	TextStart self
	var[0] = 99
	while var[0] == 99:
		if flag[3385]:
			var[0] = 0
		else:
			FadeOut 300ms 0x00000000 100
			Menu menu[0] -1 -1 1
				"交談" // 0
				"買東西" // 1
				"放棄" // 2
			MenuWait var[0]
			if var[0] != 1:
				MenuClose menu[0]
				FadeIn 300ms 0x00000000
				FadeWait
			else:
		if var[0] == 1:
			if flag[3205]:
				ShopOpen shop[55]
			else:
				ShopOpen shop[54]
			var[0] = 99
		elif var[0] == 0:
			var[0] = 99
			if flag[3385]:
				if !flag[3]:
					Call fn[0,7]
				else:
					TextTalk char[2] {
						不過……竟然能在
						這間小屋裡生活將近一個月，
						這群人真是堅忍不拔啊。{wait}
					}
					TextWait
					TextTalk char[2] {
						看來是靠著自製魚乾、
						採集可食用的野菜等方式
						來勉強維生……{wait}
					}
					TextWait
					TextTalk char[2] {
						他們的毅力實在令人敬佩。{wait}
					}
					TextWait
				var[0] = 0
			elif flag[2816]:
				CharTurnToChar self name[0] 0deg/s
				TextTalk self {
					羅伊德團員，你要小心。{wait}
				}
				TextWait
				TextTalk self {
					我們會
					留在這裡等待。
					幻獸就交給你了。{wait}
				}
				TextWait
	TextEnd self
	Return

