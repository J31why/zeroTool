			現在還真是走投無路了。{wait}
		}
		TextWait
		TextTalk name[3] {
			#00303F#12P別說克洛斯貝爾市了，
			就連貝爾加德門和警察學校方向
			似乎也沒辦法過去了。{wait}
		}
		TextWait
		TextTalk name[5] {
			#10706F#6P真傷腦筋呢……{wait}
		}
		TextWait
		TextTalk name[4] {
