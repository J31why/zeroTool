fn[3]:
	ED7_F2 1
	SystemFlagsSet 0x08000000
	FadeOut 300ms 0x00000000 100
	if !flag[4055]:
		SoundPlay sound[14] 0 100 0
		ED7_74 object[0] 0 30
		ED7ObjPlay object[0] 0 30 0 0
		Sleep 500ms
		ObjFrame object[0] 30
		SoundPlay sound[17] 0 100 0
		TextSetPos -1 -1 -1 -1
		SepithAdd 0 50
		SepithAdd 1 50
		SepithAdd 2 50
		SepithAdd 3 50
		SepithAdd 4 50
		SepithAdd 5 50
		SepithAdd 6 50
		TextMessage null {
			已取得
			{color 2}#56I地之耀晶石×５０{color 0}
			{color 2}#57I水之耀晶石×５０{color 0}
			{color 2}#58I火之耀晶石×５０{color 0}
			{color 2}#59I風之耀晶石×５０{color 0}
			{color 2}#60I時之耀晶石×５０{color 0}
			{color 2}#61I空之耀晶石×５０{color 0}
			{color 2}#62I幻之耀晶石×５０{color 0}。{wait}
		}
		TextWait
		TextClose 0
		TextSetPos -1 280 60 3
		FlagSet flag[4055]
		ED7_DE 5
	else:
		TextMessage name[742] {
			{0x06}{color 5}寶箱裡什麼都沒有。{wait}
		}
		TextWait
		TextClose 0
	FadeIn 300ms 0x00000000
	TextEnd null
	SystemFlagsUnset 0x08000000
	Return

fn[4]:
	SystemFlagsSet 0x08000000
	if !flag[4056]:
		SoundPlay sound[14] 0 100 0
		ED7_74 object[1] 0 30
		ED7ObjPlay object[1] 0 30 0 0
		Sleep 500ms
		if !flag[4314]:
			CharColor char[0] 0x00FFFFFF 0ms
			CharTurnToChar char[0] field_party[0] 0deg/s
			_Char91 char[0] 0 1000 0 0 0
			Fork char[0] fork[1]:
				_Char91 self 0 -1000 0 1000 0
			Fork char[0] fork[2]:
				CharColor self 0xFFFFFFFF 1000ms
			CharFlagsUnset char[0] 0x0080
			CharFlagsSet char[0] 0x8000
			TextMessage name[742] {
				{color 5}魔獸出現了！{color 0}{wait}
			}
			TextWait
			TextClose 0
			ForkWait char[0] fork[1]
			ED7Battle battle[2] null 0 0 11 null
			CharFlagsSet char[0] 0x0080
			CharFlagsUnset char[0] 0x8000
			switch system[3]:
				case 0:
					FlagSet flag[4314]
					ObjFrame object[1] 30
					Sleep 500ms
					break
				case 2:
					ObjFrame object[1] 0
					TextEnd null
					SystemFlagsUnset 0x08000000
					Return
				case 1:
					ReturnToTitle 0
					Return
		if ItemAdd item[117] 1:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextMessage name[742] {
				{color 0}已取得{item[117]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			TextSetPos -1 280 60 3
			FadeIn 300ms 0x00000000
			FlagSet flag[4056]
			ED7_DE 5
		else:
			FadeOut 300ms 0x00000000 100
			TextMessage name[742] {
				寶箱裡裝有{item[117]}{color 0}。
				因持有物品已達上限，已放棄{item[117]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			SoundPlay sound[15] 0 100 0
			ED7ObjPlay object[1] 30 0 0 0
	else:
		FadeOut 300ms 0x00000000 100
		TextMessage name[742] {
			{0x06}{color 5}寶箱裡什麼都沒有。{color 0}{wait}
		}
		TextWait
		TextClose 0
		FadeIn 300ms 0x00000000
	Sleep 30ms
	TextEnd null
	SystemFlagsUnset 0x08000000
	Return

