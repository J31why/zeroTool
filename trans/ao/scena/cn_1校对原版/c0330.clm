fn[5]:
	TextSetName ""
	TextMessage null {
		{color 5}有一本導力車雜誌『車迷月刊vol.1』。{color 0}{wait}
	}
	TextWait
	TextClose 0
	_59
	TextSetPos -1 280 60 3
	if flag[393] && !ItemHas item[876] 0:
		SoundPlay sound[17] 0 100 0
		TextSetPos -1 -1 -1 -1
		TextSetName ""
		TextMessage null {
			記住了
			{color 2}『藍天配色』{color 0}的噴漆樣式。{wait}
		}
		TextWait
		TextClose 0
		_59
		TextSetPos -1 280 60 3
		ItemAdd item[876] 1
	TextEnd null
	Return

fn[6]:
	TextStart self
	if flag[3385]:
		if !flag[3688]:
			TextTalk char[0] {
				#03600F哎呀，各位。
				幸好大家都沒事。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00000F哈羅德先生，
				你從阿爾摩利卡村那邊回來啦？{wait}
			}
			TextWait
			TextTalk char[0] {
				#03604F是的，我看到結界消失了，
				才剛回到這裡。{wait}
			} {
				#03600F不過我接下來
				正打算要出門去。{wait}
			}
			TextWait
			TextTalk name[2] {
				#00203F你還真是忙啊。{wait}
			}
			TextWait
			TextTalk name[3] {
				#00300F你還有家人在，
				多待一下再走
				不是比較好嗎？{wait}
			}
			TextWait
			TextTalk char[0] {
				#03603F不，在這種時期，
				我只想盡我所能
				來幫助克洛斯貝爾各地的人們。{wait}
			} {
				#03600F首先，我打算先去
				瑪因茲那裡看看。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00004F是嗎……
				真不愧是哈羅德先生。{wait}
			} {
				#00002F還請你路上小心。{wait}
			}
			TextWait
			TextTalk char[0] {
				#03609F嗯，各位也是……
				願女神保佑你們。{wait}
			}
			TextWait
			FlagSet flag[3688]
		elif !flag[0]:
			TextTalk char[0] {
				#03600F首先，我打算先去
				瑪因茲那裡看看。{wait}
			} {
				#03603F現在我只想盡我所能
				來幫助克洛斯貝爾各地的人們……{wait}
			} {
				#03609F也希望女神
				保佑各位。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				#03600F首先，我打算先去
				瑪因茲那裡看看。{wait}
			} {
				#03609F也希望女神
				保佑各位。{wait}
			}
			TextWait
	elif flag[3371]:
	elif flag[3089]:
	elif flag[3074]:
	elif flag[2861]:
		if !flag[0]:
			TextTalk char[0] {
				#03601F我原本計畫
				今天去瑪因茲的……
				沒想到會發生這種事。{wait}
			} {
				#03603F……我曾經去瑪因茲
				做過好幾次生意，
				那裡的人對我都很好。{wait}
			} {
				#03608F但是我卻什麼忙也幫不上，
				我覺得自己真是太沒用了……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				#03603F……我曾經去瑪因茲
				做過好幾次生意，
				那裡的人對我都很好。{wait}
			} {
				#03608F但是我卻什麼忙也幫不上，
				我覺得自己真是太沒用了……{wait}
			}
			TextWait
	elif flag[2848]:
	elif flag[2837]:
	elif flag[2832]:
		if QuestFlagsGet quest[130] 0x10:
			if !flag[3002]:
				Call fn[0,15]
			elif !flag[3006]:
				Call fn[0,18]
			else:
				TextTalk char[0] {
					#03600F等一下我會用自己的車
					送村長他們回村子。{wait}
				} {
					各位也請
					千萬要小心。{wait}
				}
				TextWait
		else:
			TextTalk char[0] {
				#03601F總之，
				先統整一下
				昨天調查到的內容吧。{wait}
			} {
				#03603F然後再去找
				伊安律師商量，
				這樣應該也不錯。{wait}
			}
			TextWait
	elif flag[2816]:
	elif flag[2573]:
	elif flag[2568]:
		if !flag[2646]:
			TextTalk char[0] {
				#03605F哎呀，各位。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00000F晚安，哈羅德先生。{wait}
			}
			TextWait
			TextTalk name[1] {
				#00104F二樓傳來了香味……
				夫人好像正在
				準備晚餐呢。{wait}
			}
			TextWait
			TextTalk char[0] {
				#03609F嗯，是啊。
				而且今天柯林
				好像也有幫忙煮飯呢。{wait}
			} {
				#03604F哎呀，我也是
				剛回到家而已，
				肚子已經餓壞了。{wait}
			}
			TextWait
			FlagSet flag[2646]
		else:
			TextTalk char[0] {
				#03600F看來今天
				柯林好像也有
				幫忙煮飯呢。{wait}
			} {
				#03609F呵呵，我很期待
				會端出些什麼料理來喔。{wait}
			}
			TextWait
	elif flag[2564]:
	elif flag[2560]:
	elif flag[2369]:
		if !flag[2464]:
			TextTalk char[0] {
				#03603F像這樣子一個人
				安靜下來的時候，
				我總會想起一件事。{wait}
			} {
				以前救過柯林的那位
				一頭紫羅蘭髮色的女孩……{wait}
			} {
				#03608F我會想，真的沒有機會
				再見到那女孩了嗎？{wait}
			}
			TextWait
			TextTalk name[0] {
				#00005F這、這個嘛……{wait}
			}
			TextWait
			TextTalk char[0] {
				#03604F哈哈，目前為止，
				我什麼線索都沒有，
				所以也只是單純的希望而已。{wait}
			} {
				#03600F如果真有機會的話……
				我一定要向她道謝。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00008F（紫羅蘭髮色的女孩……
				　記得蕾恩已經和艾絲蒂爾她們一起
				　回去利貝爾了……）{wait}
			} {
				#00003F（我想她應該也需要
				　整理一下自己的心情……
				　希望有一天他們真的能見到面。）{wait}
			}
			TextWait
			FlagSet flag[2464]
		else:
			TextTalk char[0] {
				#03603F以前救過柯林的那位
				一頭紫羅蘭髮色的女孩……{wait}
			} {
				#03600F如果有一天能再見到她……
				我一定要向她道謝。{wait}
			}
			TextWait
	elif flag[2353]:
		if !flag[2431]:
			TextEnd self
			Call fn[0,14]
			Return
		elif !flag[0]:
			TextTalk char[0] {
				#03600F最近生意也開始
				越做越好了。{wait}
			} {
				#03604F總算能像現在這樣子，
				有空閒時間可以休息，
				帶家人出來走走。{wait}
			}
			TextWait
			TextTalk name[1] {
				#00100F呵呵，這是因為哈羅德先生做事牢靠，
				所以能做出成果啊。{wait}
			}
			TextWait
			TextTalk char[0] {
				#03609F哈哈，被妳這麼一說……
				還真讓我有點不好意思。{wait}
			} {
				#03600F我只要能賺到可以
				養活一家人的錢就好了。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				#03600F各位，要是又碰上什麼事的話，
				請一定要來找我。{wait}
			} {
				只要是能幫得上忙的地方，
				我一定會協助各位。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[7]:
	TextStart self
	if flag[3385]:
