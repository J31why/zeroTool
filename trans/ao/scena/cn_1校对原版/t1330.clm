fn[5]:
	TextStart self
	if ItemHas item[861] 0 == 5:
	elif ItemHas item[861] 0 == 4:
	elif ItemHas item[861] 0 == 3:
	elif ItemHas item[861] 0 == 2:
		if !flag[3]:
			TextTalk char[2] {
				#00300F剛剛看到有個正好是我喜歡的
				類型的大姊姊從摩天輪車廂裡下來，
				才正想說要去搭訕一下……{wait}
			} {
				#00306F結果她似乎是
				跟她男朋友一起來的。{wait}
			} {
				#00302F哎呀～想在主題樂園裡搭訕
				似乎真的有點困難呢。{wait}
			}
			TextWait
			FlagSet flag[3]
		else:
			TextTalk char[2] {
				#00306F其實仔細想想就知道，
				來這裡的不是情侶就是家人。{wait}
			} {
				#00302F想在主題樂園裡搭訕
				似乎真的有點困難呢。{wait}
			}
			TextWait
	elif ItemHas item[861] 0 == 1:
	TextEnd self
	Return

