fn[15]:
	if QuestFlagsGet quest[127] 0x02 && !QuestFlagsGet quest[127] 0x10 && !QuestFlagsGet quest[127] 0x40:
		TextStart self
		TextTalk self {
			歡迎搭乘
			大型摩天輪《陽光之輪》！{wait}
		}
		TextWait
		TextTalk self {
			您可以在緩緩運行的
			車廂裡將這米修拉姆
			最美的景致盡收眼底。{wait}
		}
		TextWait
		TextTalk name[0] {
			#00000F（現在還在跟咪謝玩捉迷藏……
			　暫時還是先別去玩
			　遊樂設施吧。）{wait}
		}
		TextWait
		TextEnd self
	else:
		Call fn[0,25]
	Return

fn[16]:
	TextStart self
