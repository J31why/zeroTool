fn[0]:
	var[2] = random % 8
	switch var[2]:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if flag[2608]:
	elif flag[2607]:
	elif flag[2605]:
	elif flag[2604]:
		Call fn[0,24]
	elif flag[2602]:
	elif flag[2601]:
	elif flag[2600]:
	elif flag[2597]:
	elif flag[2592]:
	if flag[272]:
		FlagUnset flag[272]
		Event fn[0,52]
	Return

fn[2]:
	system[81] = 4278397047
	ED7_EE 1 450
	Call fn[0,28]
	if flag[3093]:
		SoundStop sound[821]
	else:
		SoundPlay sound[821] 1 50 0
	SoundPlay sound[126] 1 80 0
	LookPointFlagsSet look_point[0] 0x0001
	if QuestFlagsGet quest[127] 0x02 && !QuestFlagsGet quest[127] 0x10 && !QuestFlagsGet quest[127] 0x40 && !flag[3661] && flag[3660]:
		LookPointFlagsUnset look_point[0] 0x0001
	Return

fn[3]:
	TextStart self
	if ItemHas item[861] 0 == 5:
	elif ItemHas item[861] 0 == 4:
	elif ItemHas item[861] 0 == 3:
		if !flag[0]:
			Call fn[0,21]
		else:
			TextTalk char[0] {
				#00102F呵呵，我去買點飲料回來，
				你們就好好休息一下吧。{wait}
			}
			TextWait
	elif ItemHas item[861] 0 == 2:
	elif ItemHas item[861] 0 == 1:
	TextEnd self
	Return

