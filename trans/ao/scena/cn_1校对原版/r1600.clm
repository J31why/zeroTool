	Sleep 400ms
	SoundPlay sound[9] 0 100 0
	TextSetPos -1 -1 -1 -1
	TextSetName ""
	TextMessage null {
		{color 5}擊退了魔獸！{wait}
	}
	TextWait
	TextClose 0
	TextSetPos -1 -1 -1 -1
	TextSetName ""
	SoundPlay sound[17] 0 100 0
	TextMessage null {
		已取得{item[916]}{color 0}。{wait}
	}
	TextWait
	TextClose 0
	_59
	ItemAdd item[916] 1
	TextSetPos -1 280 60 3
	FlagSet flag[4338]
	if !flag[4344] && flag[4338] && flag[4339] && flag[4340] && flag[4341] && flag[4342]:
		SoundPlay sound[629] 0 100 0
		SoundPlay sound[842] 0 100 0
		Sleep 3000ms
		TextSetPos -1 -1 -1 -1
