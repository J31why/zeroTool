fn[1]:
	if system[0] == 103:
		system[1] = 0
	elif flag[3100]:
		system[1] = 251
	if !flag[3948]:
		ObjFrame object[2] 0
	else:
		ObjFrame object[2] 30
	SoundPlay sound[127] 1 100 0
	ObjFlagsSet object[0] 0x0010
	if !flag[263]:
		ObjFrame object[0] 0
		ObjFlagsSet object[1] 0x0004
	elif flag[3328]:
		ObjFlagsSet object[1] 0x0004
		ObjFlagsSet object[0] 0x0004
	if !flag[4338]:
		CharFlagsUnset char[0] 0x0080
		TriggerFlagsUnset trigger[0] 0x0080
		CharFlagsSet char[0] 0x8000
	char[0].12 = 128
	char[0].20 = 223
	char[0].13 = 128
	char[0].21 = 223
	char[0].14 = 128
