	char[0].18 = 128
	char[0].26 = 223
	char[0].19 = 128
	char[0].27 = 223
	char[0].51 = 1000
	char[0].7 = 2000
	Return

fn[2]:
	ED7_F2 1
	SystemFlagsSet 0x08000000
	if !flag[3948]:
		SoundPlay sound[14] 0 100 0
		ED7_74 object[2] 0 30
		ED7ObjPlay object[2] 0 30 0 0
		Sleep 500ms
		if ItemAdd item[820] 1:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextSetName ""
			TextMessage name[742] {
				{color 0}已取得{item[820]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			TextSetPos -1 280 60 3
			FadeIn 300ms 0x00000000
			FlagSet flag[3948]
			ED7_DE 5
		else:
			FadeOut 300ms 0x00000000 100
			TextSetName ""
			TextMessage name[742] {
				寶箱裡裝有{item[820]}{color 0}。
				因持有物品已達上限，已放棄{item[820]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			SoundPlay sound[15] 0 100 0
			ED7ObjPlay object[2] 30 0 0 0
	else:
		FadeOut 300ms 0x00000000 100
		TextSetPos -1 -1 -1 -1
		TextSetName ""
		TextMessage name[742] {
			{0x06}{color 5}寶箱裡什麼都沒有。{color 0}{wait}
		}
		TextWait
		TextClose 0
		FadeIn 300ms 0x00000000
	Sleep 30ms
	TextEnd null
	SystemFlagsUnset 0x08000000
	Return

fn[3]:
	if flag[4338]:
		Return
	EventBegin 1
	field_party[0].11 = 0
