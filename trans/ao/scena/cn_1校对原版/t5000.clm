	TextTalk char[0] {
		#1000430021V#04306F#11P唉，其實我也很想
		這麼做就是了。{wait}
	} {
		#1000430022V#04300F畢竟對我們騎士團來說，
		克洛斯貝爾是個麻煩的地方……{wait}
	}
	TextWait
	TextTalk name[9] {
		#1000060065V#00606F#5P因為克洛斯貝爾教區負責人
		艾拉爾達大主教的意向嗎？{wait}
	}
	TextWait
	TextTalk name[0] {
		#1000000169V#6P#00005F對了，之前瑪布林老師所說的
		法術專家指的是……{wait}
	}
	TextWait
	CharTurnToChar char[0] name[0] 500deg/s
