	}
	TextWait
	TextTalk name[0] {
		#1000000171V#12P#00002F不，上士真的
		幫了很多忙。{wait}
	} {
		#1000000172V#00006F……我才是，
		果然還差得遠呢。{wait}
	} {
		#1000000173V#00008F真要說的話，
