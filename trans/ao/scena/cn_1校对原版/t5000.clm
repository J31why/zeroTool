	TextTalk char[0] {
		#1000430023V#04303F#11P嗯，是指我們吧。{wait}
	} {
		#1000430024V#04300F因為發生過不少事情，
		所以大主教非常討厭我們呢。{wait}
	} {
		#1000430025V他完全禁止
		星杯騎士團在克洛斯貝爾
		進行任何活動。{wait}
	}
	TextWait
	TextTalk name[8] {
		#1000050101V#6P#10108F艾拉爾達大主教嗎……{wait}
	} {
		#1000050102V#10106F我也有見過他，
		感覺是個很嚴格的人呢。{wait}
	}
	TextWait
	TextTalk char[0] {
		#1000430026V#04306F#11P說嚴格是很嚴格。
		我沒見過比他更頑固的人。{wait}
	} {
		#1000430027V#04308F嗯，畢竟我們也幹過不少好事，
		從他那種正直的人來看，
		說不定無法忍受吧。{wait}
	}
	TextWait
	TextTalk name[0] {
		#1000000170V#6P#00011F不、不少好事是指……{wait}
	}
	TextWait
	TextTalk name[7] {
		#1000140059V#5P#01403F嗯，跟《古代遺物》有關的事件，
		都不是只說漂亮話就可以解決的事情。{wait}
	} {
		#1000140060V#01402F──凱文神父。
		總之，這次感謝你的幫忙。{wait}
	} {
		#1000140061V請讓我向你鄭重道謝。{wait}
	}
	TextWait
	CharTurnTo char[0] 0deg 500deg/s
	Sleep 150ms
	TextTalk char[0] {
		#1000430028V#04302F#12P哈哈，畢竟之前我欠了
		亞里歐斯先生一份大恩情呢。{wait}
	} {
		#1000430029V#04304F真的要說的話，包含之前的教團事件，
		其實我也很想跟著一起去處理。{wait}
	} {
		#1000430030V#04311F不過，畢竟我不想刺激大主教，
