fn[2]:
	if flag[11]:
		system[1] = 0
		FlagUnset flag[11]
	char[7].45 = 1050
	char[7].46 = 1050
	char[7].47 = 1050
	if flag[12]:
		SoundStop sound[128]
		FlagUnset flag[12]
	elif flag[2848] && !flag[2858] | flag[2369] && system[4] == 1:
		ED7_76_0 object[255] "sunlight" 1
		SoundPlay sound[128] 1 50 0
	if !flag[3385] && flag[3370]:
		MapColor 0x00E6D2D2 0ms
		ED7_76_0 object[255] "sunlight" 1
	Return

fn[3]:
	Call fn[0,4]
	Return

fn[4]:
	if flag[2562] && !flag[2563]:
		Call fn[0,25]
		Return
	elif flag[2848] && !flag[2849]:
		Call fn[0,28]
		Return
	if flag[2560] && !flag[317]:
		if flag[3089] && !flag[3100]:
		elif flag[2837] && !flag[3074]:
		else:
			TextStart char[0]
			TextTalk char[0] {
				#04000F對了，其實人家最近
				開始玩一個叫做『波姆碰！』的
				導力遊戲。{wait}
			} {
				#04011F你們也有玩對吧？
				呵呵，如果有空的話
				就來陪人家玩一下吧㈱{wait}
			}
			TextWait
			TextSetPos -1 -1 -1 -1
			SoundPlay sound[17] 0 100 0
			TextMessage null {
				已取得{color 2}『蜜雪兒的帳號』{color 0}。{wait}
			}
			TextWait
			TextClose 0
			_59
			FlagSet flag[317]
			ED7Note_3
			TextEnd char[0]
			Return
	TextStart char[0]
	if flag[3404]:
		if !flag[3542]:
			TextTalk char[0] {
				#04001F這樣啊……你們打倒亞里歐斯了嗎？{wait}
			}
			TextWait
			TextTalk name[0] {
				#00008F……嗯，我們使盡渾身解數才總算將他打倒。{wait}
			}
			TextWait
			TextTalk name[3] {
				#00306F他的實力真的是
				超乎常人。{wait}
			}
			TextWait
			TextTalk char[0] {
				#04003F……畢竟亞里歐斯是
				悟透『真理』的真正高手。{wait}
			} {
				而且他的境界絕不是
				可以靠天賦實現……而是要歷經
				無數鍛鍊才能累積出的真正實力。{wait}
			} {
				#04011F呵呵，能通過這樣的考驗，
				就證明了你們也成長了不少對吧。{wait}
			}
			TextWait
			TextTalk name[2] {
				#00204F老實說，會贏也靠了幾分運氣。{wait}
			}
			TextWait
			TextTalk name[1] {
				#00100F雖然是場艱難的戰鬥，不過……
				我們總算是渡過難關了。{wait}
			}
			TextWait
			TextTalk char[0] {
				#04004F呵呵，那麼就只剩下
				那個叫琪雅的女孩了對吧。{wait}
			} {
				#04000F為了小滴著想，
				無論如何你們都要和
				亞里歐斯一起把她帶回來才行。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00000F嗯，那當然……！{wait}
			}
			TextWait
			FlagSet flag[3542]
		elif !flag[0]:
			TextTalk char[0] {
				#04003F亞里歐斯可是
				悟透『真理』的真正高手。{wait}
			} {
				#04011F呵呵，能通過這樣的考驗，
				就證明了你們也成長了不少對吧。{wait}
			} {
				#04000F為了小滴著想，無論如何
				你們都得和他一起
				把那個叫琪雅的女孩帶回來才行。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				#04004F接下來就只剩把那個叫琪雅的女孩
				帶回來而已了。{wait}
			} {
				#04000F為了小滴著想，
				無論如何你們都要和
				亞里歐斯一起把她帶回來才行。{wait}
			}
			TextWait
	elif flag[3385]:
		if !flag[3541]:
			TextTalk char[0] {
				#04000F拘捕總統的工作完成……
				真是辛苦各位了。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00000F也感謝各位協會成員的
				大力協助。{wait}
			} {
				如果沒有各位協助，
				我想我們一定沒有辦法完成這項工作。{wait}
			}
			TextWait
			TextTalk char[0] {
				#04011F呵呵呵，不用客氣啦。{wait}
			} {
				#04004F其實對想改善
				這城市現狀的我們來說，
				這也只是順水推舟而已。{wait}
			} {
				#04000F而且也是托你們的福，
				我們協會才能夠恢復營運。{wait}
			}
			TextWait
			TextTalk name[1] {
				#00105F話說回來，協會的成員們是不是……{wait}
			}
			TextWait
			TextTalk char[0] {
				#04000F嗯，因為結界解除的關係，
				大家都到市外分頭去出任務了。{wait}
			} {
				#04003F畢竟前陣子大家都無法出動，
				導致各地發生了不少問題，
				所以現在委託就一口氣湧進來了。{wait}
			}
			TextWait
			TextTalk name[2] {
				#00200F那還真是災難啊……{wait}
			}
			TextWait
			TextTalk name[3] {
				#00303F要是我們也能
				幫忙就好了，可是……{wait}
			}
			TextWait
			TextTalk char[0] {
				#04004F沒關係啦，這邊的事就交給我們吧。{wait}
			} {
				#04001F相反的，出現在濕地
				那棵來路不明的《大樹》……
				就要麻煩你們處理了。{wait}
			} {
				你們現在的當務之急
				應該就是這個了，對吧？{wait}
			}
			TextWait
			TextTalk name[0] {
				#00003F嗯……沒錯。{wait}
			} {
				琪雅……
				還有亞里歐斯先生都在那裡。{wait}
			} {
				#00001F無論如何我們都得
				都得把他們帶回來才行……！{wait}
			}
			TextWait
			if PartyPosition name[9] > -1:
				TextTalk name[9] {
					#00603F……那是當然的。{wait}
				}
				TextWait
			TextTalk char[0] {
				#04004F呵呵，這樣才像你們的作風嘛。{wait}
			} {
				#04001F……亞里歐斯的實力
				老實說真的異於常人。{wait}
			} {
				這一點長期與他共事的
				我們再清楚不過了。{wait}
			} {
				#04011F打起精神來吧，特務支援課！{wait}
			}
			TextWait
			TextTalk name[0] {
				#00001F好的！！{wait}
			}
			TextWait
			FlagSet flag[3541]
		elif !flag[0]:
			TextTalk char[0] {
				#04003F……亞里歐斯的實力
				老實說真的異於常人。{wait}
			} {
				#04001F這一點長期與他共事的
				我們再清楚不過了。{wait}
			} {
				雖然這勢必會是場苦戰，
				但你們一定得把他和那個
				叫琪雅的女孩一起帶回來才行。{wait}
			} {
				#04011F呵呵，竟然敢擅自提出辭呈，
				不好好罵罵他怎麼行呢？{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				#04003F雖然這勢必會是場苦戰，
				但你們一定得把亞里歐斯和那個
				叫琪雅的女孩一起帶回來才行。{wait}
			} {
				#04011F呵呵，竟然敢擅自提出辭呈，
				不好好罵罵他怎麼行呢？{wait}
			}
			TextWait
	elif flag[3371]:
		if !flag[0]:
			TextTalk char[0] {
				#04006F自從獨立宣言發布以來，
				我們的行動就處處受限。{wait}
			} {
				就算宣稱協會是中立組織，
				也無法無視以獨立國名義
				建立的新秩序對吧。{wait}
			} {
				#04001F不過這次就不一樣了，
				既然已經有民眾受到威脅，
				協會就不能坐視不管。{wait}
			} {
				#04003F這次突擊蘭花塔還有
				逮捕總統的行動……請務必
				也讓我們參加吧。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				#04003F你們準備好要開始作戰的時候，
				請記得聯絡我們。{wait}
			} {
				#04001F在那之前我們也會
