			CharSetPos char[8] (1000, 0, 10310) 0deg
			if !flag[10]:
				CharFlagsSet char[8] 0x0010
				CharFlagsSet char[0] 0x0010
	elif flag[2560]:
		if !flag[2562]:
			CharFlagsUnset char[5] 0x0080
			CharFlagsUnset char[6] 0x0080
			CharFlagsSet char[5] 0x0010
			CharFlagsSet char[6] 0x0010
	elif flag[2369]:
		CharFlagsUnset char[2] 0x0080
		CharFlagsUnset char[1] 0x0080
		CharSetPos char[2] (-6000, 150, 43030) 180deg
		CharSetPos char[1] (-6000, 150, 40820) 0deg
		CharSetChipBase char[2] chip[8]
		CharSetChipPattern char[2] 0
		ForkQuit char[2] fork[0]
		CharFlags2Set char[2] 0x0004
		CharSetChipBase char[1] chip[7]
		CharSetChipPattern char[1] 0
		ForkQuit char[1] fork[0]
		CharFlags2Set char[1] 0x0004
		CharFlagsSet char[2] 0x0010
		CharFlagsSet char[1] 0x0010
		if !flag[2504]:
			Event fn[0,20]
	elif flag[2353]:
		CharFlagsUnset char[3] 0x0080
		CharFlagsUnset char[4] 0x0080
		CharSetPos char[3] (-540, 0, 45260) 180deg
		CharSetPos char[4] (-540, 0, 43420) 0deg
		if !flag[2504]:
			Event fn[0,20]
	if flag[272]:
		FlagUnset flag[272]
		Event fn[0,27]
	elif flag[273]:
		FlagUnset flag[273]
		FlagSet flag[11]
		FlagSet flag[12]
		Event fn[0,29]
	elif flag[274]:
		FlagUnset flag[274]
		Event fn[0,31]
	if flag[3089] && !flag[3090]:
		Event fn[0,30]
	if QuestFlagsGet quest[115] 0x02 && !QuestFlagsGet quest[115] 0x10 && !QuestFlagsGet quest[115] 0x40 && flag[2718]:
		if !flag[2719]:
			SystemFlagsSet 0x10000000
			Event fn[0,32]
