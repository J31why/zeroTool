		CharSetPos char[3] (-540, 0, 43820) 0deg
		CharFlagsUnset char[9] 0x0080
		CharSetPos char[9] (-540, 0, 45260) 180deg
		if !flag[3547]:
			CharFlagsSet char[3] 0x0010
