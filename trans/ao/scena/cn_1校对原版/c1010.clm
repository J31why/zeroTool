		CharFlagsUnset char[4] 0x0080
		CharSetPos char[3] (2760, 0, 10330) 315deg
		CharSetPos char[4] (1800, 0, 10320) 315deg
		CharFlagsUnset char[1] 0x0080
		CharSetPos char[1] (600, 0, 39580) 90deg
		CharFlagsSet char[1] 0x0010
		CharFlagsUnset char[2] 0x0080
		CharSetPos char[2] (-1400, 0, 40910) 135deg
	elif flag[2848]:
	elif flag[2837]:
	elif flag[2832]:
	elif flag[2816]:
	elif flag[2573]:
		CharFlagsUnset char[3] 0x0080
		CharSetPos char[3] (-5030, 0, 52190) 0deg
		CharFlagsUnset char[2] 0x0080
		CharSetPos char[2] (600, 0, 39580) 90deg
		CharFlagsSet char[2] 0x0010
