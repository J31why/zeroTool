fn[7]:
	if flag[2851] && !flag[2852]:
		Call fn[0,48]
		Return
	TextStart char[0]
	if flag[3385]:
		if !flag[0]:
			TextTalk char[0] {
				目前，
				在麥克道爾議長的主導下，
				蘭花塔已經納入他的管轄。{wait}
			}
			TextWait
			TextTalk char[0] {
				雖然還有很多混亂的狀況……
				但這裡是為了市民建設的大樓，
				這點是不會改變的。{wait}
			}
			TextWait
			TextTalk char[0] {
				今後還請
				多多指教。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				蘭花塔是
				為了市民建設的大樓，
				這點是不會改變的。{wait}
			}
