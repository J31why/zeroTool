		}
		TextWait
	CharSetPos field_party[0] (-290, 0, -3540) 0deg
	EventEnd 4
	Return

fn[52]:
	SystemFlagsSet 0x00000080
	FlagUnset flag[394]
	var[0] = 0
	while var[0] != 255:
		ED7MenuNew menu[0]
		ED7MenuAdd menu[0] "搭乘導力車移動"
		var[3] = 0
		var[4] = 0
		if flag[390]:
			ED7MenuAdd menu[0] "在導力車上休息"
			var[3] += 1
			var[4] += 1
		ED7MenuAdd menu[0] "放棄"
		ED7MenuShow menu[0] 65535 65535 1
		MenuWait var[0]
		MenuClose menu[0]
		if var[0] == 0:
			TextTalk name[0] {
				#00001F……現在不需要勉強移動它。
				等事件平息之後，再送去修理吧。{wait}
			}
			TextWait
		elif var[0] == var[3]:
			TextClose 0
			BgmStop 3000ms
			FadeOut 1000ms 0x00000000 255
			FadeWait
			_59
			SoundPlay sound[13] 0 100 0
			if flag[392]:
				PartySetAttr name[255] 255 0
			elif flag[391]:
				PartySetAttr name[255] 254 0
			else:
				PartySetAttr name[255] 250 0
			CamLookChar field_party[0] 0ms
			Sleep 3500ms
			BgmResume
			FadeIn 1000ms 0x00000000
			TextClose 0
			var[0] = 255
		else:
			var[0] = 255
	MenuClose menu[0]
	TextClose 0
	TextEnd null
	Return
