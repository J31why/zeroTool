calmare ao_k scena
scena:
	name "b0101" "b0101" "b0101"
	town town[0]
	bgm bgm[450]
	flags 8192
	item_use fn[0,255]
	unk 255 255

entry:
	pos (0, 0, -1000)
	unk1 0
	cam_from (0, 0, 24000)
	cam_pers 500
	unk2 30
	cam_deg 45deg
	cam_limit 0deg 360deg
	cam_at (0, 0, 0)
	unk3 0
	unk4 0
	flags 0x0001
	town town[1]
	init fn[0,0]
	reinit fn[0,1]

// NB: the first five sepith sets are seemingly junk data.
sepith[0] 100 1 2 3 70 89 99 0
sepith[1] 100 5 1 5 1 5 1 0
sepith[2] 100 5 1 5 1 5 1 0
sepith[3] 100 5 0 5 0 5 0 0
sepith[4] 100 5 0 5 0 5 0 0

at_roll[0]: none 100
