fn[0]:
	Event fn[0,7]
	Return

fn[1]:
	VisShow vis[0] 0 8 480 264 0 0 512 256 0 0 480 256 0x00FFFFFF 0 "c_vis120.itp"
	VisShow vis[1] 0 8 480 264 0 0 512 256 0 0 480 256 0xFF000000 1 "c_vis120.itp"
	Sc_C4Set 16
	SystemFlagsSet 0x00000080
	AoMap 0
	Return

fn[2]:
	MenuClose menu[2]
	MenuClose menu[1]
	TextClose 0
	FadeIn 300ms 0x00000000
	VisSet vis[0] 3 0x00FFFFFF 500ms 0 0
	Sleep 500ms
	FadeWait
	Return

fn[3]:
	VisSet vis[0] 3 0xFFFFFFFF 200ms 0 0
	Call fn[0,4]
	Call fn[0,5]
	VisSet vis[1] 3 0x00000000 500ms 0 0
	Return

fn[4]:
	TextSetName ""
	TextSetPos -1 0 28 1
	TextMessage null {
		　　　　　戰技閱覽{0x18}{0x06}{wait}
	}
	Menu menu[1] 32 96 1
		"Ｓ戰技①" // 0
		"Ｓ戰技②" // 1
		"Ｓ戰技③" // 2
		"組合戰技①" // 3
		"組合戰技②" // 4
		"返回" // 5
	ED7MenuSetStyle menu[1] 3
	Sleep 200ms
	ED7Menu_6 menu[1]
	Return

fn[5]:
	switch var[0]:
		case 0:
			ED7MenuSelect menu[1] 0
