	if !flag[3329]:
		TextTalk char[0] {
			#1510410005V#12100F#11P──所以，最後打算怎麼做呢？{wait}
		}
		TextWait
		TextTalk name[0] {
			#1510000022V#00003F#6P嗯，最後決定先在這個地方
			降落一次看看了。{wait}
		} {
			#1510000023V#00000F先不說這個了，沒想到你們
			居然還有這樣的背景。{wait}
		}
		TextWait
		TextTalk char[0] {
			#1510410006V#12102F#11P這全都是為了教會內部的對立──
			為了轉移對騎士團抱持著批判目光的
			艾拉爾達大主教的注意力。{wait}
		} {
			#1510410007V任誰都不會想到，最高階騎士中的
			其中一人，居然就是
			不良集團的頭目吧。{wait}
		}
		TextWait
