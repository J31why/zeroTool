			#1510000024V#00006F#6P這倒也是啦。{wait}
		} {
			#1510000025V#00005F啊，不過啊，感覺你們好像很常使用
			聖典#4R聖約幫#啊或是聖戰啊，
			這些充滿宗教氛圍的詞彙耶？{wait}
		}
		TextWait
		TextTalk char[0] {
			#1510410008V#12105F#11P唔，是這樣嗎？{wait}
		} {
			#1510410009V#12100F我還以為這樣反而能夠營造出
			沒禮貌的形象，並藉此蒙混過去呢……{wait}
		}
		TextWait
		TextTalk name[0] {
			#1510000026V#00012F#6P我、我覺得的確是
			會讓人誤以為是一個
			有著獨特氛圍的幫派啦。{wait}
		} {
			#1510000027V#00000F──話說回來，
			有辦法立刻降落嗎？{wait}
		}
		TextWait
		TextTalk char[0] {
			#1510410010V#12102F#11P嗯，我們已經正確掌握
			『隙縫』的位置了。{wait}
		} {
