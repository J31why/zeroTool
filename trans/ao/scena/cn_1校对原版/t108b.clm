	if flag[2605] && !flag[2606]:
		EntranceSetFunc entrance[1] fn[0,10]
	TriggerFlagsSet trigger[1] 0x0080
	TriggerFlagsSet trigger[2] 0x0080
	if flag[2607] && !flag[2608]:
		EntranceSetFunc entrance[6] fn[0,15]
