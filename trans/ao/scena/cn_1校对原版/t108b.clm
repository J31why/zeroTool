fn[4]:
	TextStart self
	if flag[2605]:
		if flag[2622]:
			if !flag[1]:
				CharTurnToChar self name[4] 0deg/s
				TextTalk self {
					咦？客人……
					您要走了嗎？{wait}
				}
				TextWait
				TextTalk name[4] {
					#10300F是啊，迎賓館那邊在叫我。{wait}
				}
				TextWait
				TextTalk self {
					這、這樣啊。
					請慢走……{wait}
				}
				TextWait
				TextTalk self {
					（怎、怎麼這樣～……
					　明明我
					　幾乎都還沒服務到～！）{wait}
				}
				TextWait
				TextTalk name[4] {
					#10302F呵呵，真是個怪女孩。{wait}
				}
				TextWait
				TextTalk name[0] {
					#00006F……你是故意的吧？{wait}
				}
				TextWait
				FlagSet flag[1]
			else:
				TextTalk self {
					唉……
					請慢走……{wait}
				}
				TextWait
		elif !flag[1]:
			TextTalk self {
				奇怪，瓦奇先生呢……？{wait}
			}
			TextWait
			TextTalk name[0] {
				#00000F喔，瓦奇的話，
				已經去迎賓館了吧。{wait}
			}
			TextWait
			TextTalk self {
				怎、怎麼這樣～……
				明明我幾乎都還沒
				服務到他～！{wait}
			}
			TextWait
			if flag[2618]:
				TextTalk name[1] {
					#00106F（不愧是瓦奇，真受歡迎……）{wait}
				}
				TextWait
			elif flag[2619]:
				TextTalk name[2] {
					#00203F（不愧是瓦奇先生，真受歡迎呢……）{wait}
				}
				TextWait
			elif flag[2620]:
				TextTalk name[3] {
					#00301F（那傢伙還真受歡迎……）{wait}
				}
				TextWait
			elif flag[2621]:
				TextTalk name[8] {
					#10106F（不愧是瓦奇，真受歡迎呢……）{wait}
				}
				TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				唉……真想再多
				為瓦奇先生服務一下……{wait}
			}
			TextWait
	elif flag[2601]:
	elif flag[2597]:
	TextEnd self
	Return

