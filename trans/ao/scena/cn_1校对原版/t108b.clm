		CharWalkToPos self (-106030, 0, 11300) 2000mm/s 0
		CharWalkToPos self (-93960, 0, 11300) 2000mm/s 0
		CharWalkToPos self (-93960, 0, 8260) 2000mm/s 0
	Return

fn[2]:
	if flag[2607]:
