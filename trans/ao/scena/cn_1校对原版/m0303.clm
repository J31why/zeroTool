fn[0]:
	if system[0] == 104 && flag[2584] && !flag[2585]:
		Event fn[0,3]
	if system[0] == 103:
		FlagSet flag[2696]
	Return

fn[1]:
	if flag[2585] && !flag[2591]:
		Sc_C4Set 8
	TriggerFlagsSet trigger[0] 0x0080
	if flag[2585] && !flag[2586]:
		TriggerFlagsUnset trigger[0] 0x0080
	if flag[2696]:
		ED7_76_1 object[2] "lock_g" 1
		ED7_76_0 object[2] "lock_r" 1
		ObjFlagsSet object[2] 0x0010
	else:
		ED7_76_0 object[2] "lock_g" 1
		ED7_76_1 object[2] "lock_r" 1
		ObjFlagsUnset object[2] 0x0010
	if !flag[3979]:
		ObjFrame object[0] 0
	else:
		ObjFrame object[0] 30
	Return

fn[2]:
	ED7_F2 1
	SystemFlagsSet 0x08000000
	if !flag[3979]:
		SoundPlay sound[14] 0 100 0
		ED7_74 object[0] 0 30
		ED7ObjPlay object[0] 0 30 0 0
		Sleep 500ms
		if ItemAdd item[508] 1:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextSetName ""
			TextMessage name[742] {
				{color 0}已取得{item[508]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			TextSetPos -1 280 60 3
			FadeIn 300ms 0x00000000
			FlagSet flag[3979]
			ED7_DE 5
		else:
			FadeOut 300ms 0x00000000 100
			TextSetName ""
			TextMessage name[742] {
				寶箱裡裝有{item[508]}{color 0}。
				因持有物品已達上限，已放棄{item[508]}{color 0}。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			SoundPlay sound[15] 0 100 0
			ED7ObjPlay object[0] 30 0 0 0
	else:
		FadeOut 300ms 0x00000000 100
		TextSetPos -1 -1 -1 -1
		TextSetName ""
		TextMessage name[742] {
			{0x06}{color 5}寶箱裡什麼都沒有。{color 0}{wait}
		}
		TextWait
		TextClose 0
		FadeIn 300ms 0x00000000
	Sleep 30ms
	TextEnd null
	SystemFlagsUnset 0x08000000
	Return

fn[3]:
	EventBegin 0
	FadeOut 0ms 0x00000000 255
	ED7_E0 3
	ED7LoadChip "chr/ch00250.itc" chip[30]
