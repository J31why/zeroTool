	CamZoom 13500 0ms
	CamSetDistance -20500 -1000 -31000 7000ms
	ED7CamRotate 35deg 17deg 0deg 7000ms
	CamZoom 32500 7000ms
	FadeWait
	Sleep 2500ms
	Sc_C8 340 200 "c_plac53" 0 0
	CamWait 121
	Sleep 500ms
	CrossFade 500ms
	CamSetDistance 0 1000 5000 0ms
	ED7CamRotate 43deg 21deg 0deg 0ms
	CamPers 560 0ms
	CamZoom 19500 0ms
	CamZoom 18500 1000ms
	FadeWait
	CamWait 121
	TextTalk name[0] {
		#1230000183V#6P#00005F這裡是……地下停車場嗎？{wait}
	}
	TextWait
	TextTalk name[1] {
		#1230010102V#6P#00108F是的，克洛斯貝爾
		總有一天會進入車輛社會，這是
		為了屆時所需而打造的區塊……{wait}
	}
	TextWait
	TextTalk name[3] {
		#1230030068V#00306F#5P不對啊，如果是這樣的話，
		這也太大了吧？{wait}
	} {
		#1230030069V#00301F我並不覺得有
		那麼大的需求啊……{wait}
	}
	TextWait
	TextTalk name[4] {
		#1230040052V#10302F#5P我猜是議員和官員捏造出
		根本不存在的需求，
		發包進行了這項工程吧？{wait}
	}
	TextWait
	TextTalk name[8] {
		#1230050059V#10106F#5P……原來如此。{wait}
	}
	TextWait
	TextTalk name[1] {
		#1230010103V#6P#00103F……沒錯。
		非常遺憾，事情就是這樣。{wait}
	} {
		#1230010104V#00108F不過現在工程似乎因為
		哈爾特曼議長的失勢而中止了。{wait}
	}
	TextWait
	TextTalk name[0] {
		#1230000184V#6P#00006F嗯，那才是正確的吧。{wait}
	} {
		#1230000185V#00001F不過……地方這麼大的話，
		追蹤起來也很困難啊。{wait}
	}
	TextWait
	TextTalk name[2] {
		#1230020090V#5P#00200F…………{wait}
	}
	TextWait
	Sleep 300ms
	BgmVolume 70 1000ms
	SoundPlay sound[2278] 255 70 0
	CrossFade 250ms
	CharSetChipBase name[2] chip[30]
	CharSetChipPattern name[2] 0
	SoundPlay sound[812] 0 100 0
	FadeWait
	Sleep 800ms
	ForkFunc name[0] fork[3] fn[0,4]
	SoundPlay sound[357] 0 70 0
	SoundPlay sound[852] 2 100 0
	EffPlay eff[0] eff_instance[0] name[2] 1 (0, 0, 0) 0 0 0 1000 1000 1000 null (0, 0, 0) 0ms
	EffPlay eff[1] eff_instance[1] name[2] 5 (0, 1450, 0) 0 0 0 2000 2000 2000 null (0, 0, 0) 0ms
	CharSetChipBase name[2] chip[31]
	CharSetChipPattern name[2] 0
	ED7CharAnimation name[2] 2000ms 0 1 2 1 0 1 2 1
	ED7CharAnimation name[2] 2000ms 0 1 2 1 0 1 2 1
	ED7CharAnimation name[2] 2000ms 0 1 2 1 0 1 2 1
	ED7CharAnimation name[2] 2000ms 0 1 2 1 0 1 2 1
	ED7CharAnimation name[2] 2000ms 0 1 2 1 0 1 2 1
	ED7CharAnimation name[2] 2000ms 0 1 2 1 0 1 2 1
	CrossFade 250ms
	SoundPlay sound[812] 0 100 0
	ED7_12 852 500 100
	CharSetChipBase name[2] chip[255]
	CharSetChipPattern name[2] 0
	EffStop eff_instance[0] 2
	EffStop eff_instance[1] 2
	FadeWait
	BgmVolume 100 1000ms
	Sleep 300ms
	TextTalk name[2] {
		#1230020091V#5P#00203F……發現疑似人類的反應。{wait}
	} {
		#1230020092V#00201F有一組大約８人的團體
		正在這附近移動中。{wait}
	}
	TextWait
	TextTalk name[0] {
		#1230000186V#12P#00000F真的嗎……！？{wait}
	}
	TextWait
	TextTalk name[3] {
		#1230030070V#00302F#11P嘿！出乎意料，
		看來很快就能追到人了。{wait}
	}
	TextWait
	CharTurnToChar name[8] name[0] 500deg/s
	Sleep 150ms
	TextTalk name[8] {
		#1230050060V#10101F#5P我們快過去吧！{wait}
	}
	TextWait
	FadeOut 1000ms 0x00000000 255
	FadeWait
	UnloadChip chip[30]
	UnloadChip chip[31]
	ED7_37
	CharSetPos field_party[0] (0, 0, 5000) 180deg
	CharFlagsSet field_party[4] 0x0080
	CharFlags2Set field_party[4] 0x8000
	CharFlagsSet field_party[5] 0x0080
	CharFlags2Set field_party[5] 0x8000
	FlagSet flag[2585]
	TriggerFlagsUnset trigger[0] 0x0080
	SoundStop sound[852]
	ED7_E0 2
	EventEnd 5
	Return

