fn[7]:
	TextStart self
	if flag[3385]:
	elif flag[3362]:
		if !flag[7]:
			TextTalk char[9] {
				聽說克洛斯貝爾市
				那邊發生了
				某件大事吧。{wait}
			}
			TextWait
			TextTalk char[9] {
				……我們礦工也不能
				繼續不聞不問。
				去找鎮長商量看看好了……{wait}
			}
			TextWait
			FlagSet flag[7]
		else:
			TextTalk char[9] {
				我們礦工也不能繼續不聞不問。
				去找鎮長商量看看好了……{wait}
			}
			TextWait
	elif flag[3328]:
		if !flag[7]:
			TextTalk char[9] {
				因為成為獨立國，
				七耀石的交易量劇減，
				所以礦山被暫時封鎖了。{wait}
			}
			TextWait
			TextTalk char[9] {
				畢竟與其他國家的
				貿易完全停擺了，
				這也沒辦法。{wait}
			}
			TextWait
			TextTalk char[9] {
				老實說這樣很沒勁……
				但目前我們大概
				也只能靜觀其變。{wait}
			}
			TextWait
			FlagSet flag[7]
		else:
			TextTalk char[9] {
				因為成為獨立國，
				七耀石的交易量劇減，
				所以礦山被暫時封鎖了。{wait}
			}
			TextWait
			TextTalk char[9] {
				老實說這樣很沒勁……
				但目前我們大概
				也只能靜觀其變。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[8]:
	TextStart self
	if flag[3385]:
		if !flag[1]:
			TextTalk char[3] {
				羅基順利回到礦山，
				讓我也放心了。{wait}
			}
			TextWait
			TextTalk char[3] {
				雖然不知道
				克洛斯貝爾將來
				會何去何從，但……{wait}
			}
			TextWait
			TextTalk char[3] {
				只要年輕人們
				腳踏實地奮鬥，
				一定能開拓出未來。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk char[3] {
				羅基順利回到礦山，
				讓我也放心了。{wait}
			}
			TextWait
			TextTalk char[3] {
				只要年輕人們
				腳踏實地奮鬥，
				一定能開拓出未來。{wait}
			}
			TextWait
	elif flag[3362]:
		if !flag[1]:
			TextTalk char[3] {
				獨立國的無效宣言
				使總統這個存在的
				正當性也受到動搖了……{wait}
			}
			TextWait
			TextTalk char[3] {
				我們現在
				面臨的也許是
				歷史的一大分歧點。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk char[3] {
				我們現在
				面臨的也許是
				歷史的一大分歧點。{wait}
			}
			TextWait
	elif flag[3328]:
		if !flag[1]:
			TextTalk char[3] {
				我完全沒料想到
				克洛斯貝爾的獨立會
				發展成如此的狀況。{wait}
			}
			TextWait
			TextTalk char[3] {
				礦山遭封鎖後，
				羅基似乎
				失去了活力……{wait}
			}
			TextWait
			TextTalk char[3] {
				唉，該怎麼辦才好呢？{wait}
