fn[0]:
	switch random % 8:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharIdle self (48500, null, 2700) (51500, null, -700) 1000mm/s
		Sleep 250ms
	Return

fn[2]:
	while 1:
		CharIdle self (103150, null, 2040) (99900, null, -1150) 1000mm/s
		Sleep 250ms
	Return

fn[3]:
	CharSetChipBase char[0] chip[1]
	CharSetChipPattern char[0] 0
	ForkQuit char[0] fork[0]
	CharFlags2Set char[0] 0x0004
	CharSetChipBase char[9] chip[11]
	CharSetChipPattern char[9] 0
	ForkQuit char[9] fork[0]
	CharFlags2Set char[9] 0x0004
	CharSetChipBase char[10] chip[12]
	CharSetChipPattern char[10] 0
	ForkQuit char[10] fork[0]
	CharFlags2Set char[10] 0x0004
	if flag[3385]:
	elif flag[3362]:
		CharFlagsUnset char[9] 0x0080
		CharFlagsUnset char[10] 0x0080
	elif flag[3328]:
		CharSetPos char[4] (147900, 250, 100) 90deg
		CharSetChipBase char[4] chip[15]
		CharSetChipPattern char[4] 0
		ForkQuit char[4] fork[0]
		CharFlags2Set char[4] 0x0004
		CharFlagsSet char[4] 0x0010
		CharSetChipBase char[0] chip[0]
		CharFlags2Unset char[0] 0x0004
		CharFlagsUnset char[0] 0x0040
		ForkFunc char[0] fork[0] fn[0,0]
		CharSetPos char[0] (0, 750, -1000) 90deg
		CharFlagsUnset char[11] 0x0080
		if !flag[3447]:
			CharFlagsSet char[0] 0x0010
			CharFlagsSet char[11] 0x0010
		CharFlagsUnset char[12] 0x0080
		CharFlagsUnset char[9] 0x0080
		CharFlagsUnset char[10] 0x0080
		CharFlagsSet char[10] 0x0010
	elif flag[3074]:
	elif flag[2861]:
	elif flag[2848]:
		CharFlagsUnset char[6] 0x0080
		CharSetPos char[6] (101600, 0, 500) 225deg
		CharFlagsUnset char[5] 0x0080
		CharSetPos char[5] (50000, 0, 1000) 315deg
	elif flag[2837]:
	elif flag[2832]:
	elif flag[2816]:
	elif flag[2573]:
	elif flag[2568]:
	elif flag[2564]:
		CharFlagsUnset char[5] 0x0080
		ForkFunc char[5] fork[0] fn[0,0]
		CharFlagsSet char[5] 0x0010
		CharFlagsUnset char[8] 0x0080
		CharSetChipBase char[8] chip[10]
		CharSetChipPattern char[8] 0
		ForkQuit char[8] fork[0]
		CharFlags2Set char[8] 0x0004
	elif flag[2560]:
		CharFlagsUnset char[7] 0x0080
		CharSetPos char[7] (1200, 750, -1000) 270deg
		CharSetChipBase char[0] chip[0]
		CharFlags2Unset char[0] 0x0004
		CharSetPos char[0] (0, 650, -1000) 90deg
		ForkFunc char[0] fork[0] fn[0,0]
		if !flag[2682]:
			CharFlagsSet char[7] 0x0010
			CharFlagsSet char[0] 0x0010
	elif flag[2389]:
	elif flag[2369]:
	elif flag[2353]:
	if system[0] == 100 && flag[2375] && !flag[2384]:
		SystemFlagsSet 0x10000000
		Event fn[0,23]
	Return

fn[4]:
	if flag[3100]:
		system[1] = 563
	if flag[2848] && !flag[2858]:
		ED7_76_0 object[255] "hikari_add" 1
		SoundPlay sound[128] 1 50 0
	Return

fn[5]:
	TextStart self
	if flag[3385]:
		if !flag[0]:
			TextTalk char[2] {
				雖然總覺得礦山現在就
				重新開工還太早了……{wait}
			}
			TextWait
			TextTalk char[2] {
				但要讓鎮民團結一心，
				這果然還是
				唯一的方法吧。{wait}
			}
			TextWait
			TextTalk char[2] {
				事到如今，希望我老公他們
				能盡全力工作。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[2] {
				事到如今，希望我老公他們
				能盡全力工作。{wait}
			}
			TextWait
			TextTalk char[2] {
				我也得做美味的便當
				支持老公才行呢。{wait}
			}
			TextWait
	elif flag[3362]:
		TextTalk char[2] {
			亞雷庫真是的，之前毫無戒心地
			靠近並撫摸在城鎮附近的狼耶。{wait}
		}
		TextWait
		TextTalk char[2] {
			因為那是會協助反抗軍的
			聰明動物，所以還好……
			但真希望他小心一點。{wait}
		}
		TextWait
	elif flag[3328]:
		if !flag[0]:
			TextTalk char[2] {
				畢竟狀況本來就已經很危險了，
				老公不用進礦山，就某種
				意義上來說，讓我很安心。{wait}
			}
			TextWait
			TextTalk char[2] {
				可是，再這樣下去，
				瑪因茲會越來越冷清吧。{wait}
			}
			TextWait
			TextTalk char[2] {
				畢竟總統幾乎不會來
				處理市外的問題，
				真不曉得今後會變成怎樣。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[2] {
				如果礦山繼續關著，
				瑪因茲想必會越來越冷清。{wait}
			}
			TextWait
			TextTalk char[2] {
				畢竟總統幾乎不會來
				處理市外的問題，
				真不曉得今後會變成怎樣。{wait}
			}
			TextWait
	elif flag[3074]:
		if !flag[0]:
			TextTalk char[2] {
				我先生在上次的占領事件
				受了一點傷。{wait}
			}
			TextWait
			TextTalk char[2] {
				雖然只是輕傷
				所以還好……
				但真的讓我很擔心。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[2] {
				我先生已經回礦山工作了……
				但當時真的很令人擔心。{wait}
			}
			TextWait
			TextTalk char[2] {
				雖然勇敢是好事，
				還是希望他別太亂來。{wait}
			}
			TextWait
	elif flag[2848]:
		if !flag[0]:
			TextTalk char[2] {
				雨天時礦山裡
				也相當寒冷呢。{wait}
			}
			TextWait
			TextTalk char[2] {
				但礦工們似乎都不怕冷，
				穿得很少。{wait}
			}
			TextWait
			TextTalk char[2] {
				唉，希望
				他們別感冒。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[2] {
				雨天時礦山裡
				也會相當寒冷，
				但礦工都穿得很少。{wait}
			}
			TextWait
			TextTalk char[2] {
				唉，希望
				他們別感冒。{wait}
			}
			TextWait
	elif flag[2832]:
		TextTalk char[2] {
			亞雷庫真是的，
			在大呼小叫什麼呀……{wait}
		}
		TextWait
		TextTalk char[2] {
			真是
			吵死人了。{wait}
		}
		TextWait
	elif flag[2816]:
		if !flag[0]:
			TextTalk char[2] {
				在身為礦山長的老公影響下，
				亞雷庫似乎想當一位礦工。{wait}
			}
			TextWait
			TextTalk char[2] {
				雖然我其實想要反對……
				但父母過度干涉小孩子
				想做的事，也是不好的吧。{wait}
			}
			TextWait
			TextTalk char[2] {
				在他長大前，
				我得好好守護他，
				至少不讓他受重傷。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[2] {
				在身為礦山長的老公影響下，
				亞雷庫似乎想當一位礦工。{wait}
			}
			TextWait
			TextTalk char[2] {
				雖然我其實想要反對……
				但那孩子是很認真地在考慮，
				所以我該在旁邊守著他吧。{wait}
			}
			TextWait
	elif flag[2573]:
		if !flag[0]:
			TextTalk char[2] {
				我每天都很擔心亞雷庫
				會不會踏進危險場所，不過……{wait}
			}
			TextWait
			TextTalk char[2] {
				主日學校的日子
				有修女幫忙看顧孩子，
				所以能稍微安心呢。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[2] {
				孩子去上主日學校的課時，
				應該不需要
				擔心孩子的事……{wait}
			}
			TextWait
			TextTalk char[2] {
				難得的機會，
				我就好好放鬆吧。{wait}
			}
			TextWait
	elif flag[2564]:
		if !flag[0]:
			TextTalk char[2] {
				昨天我去送便當給
				在礦山工作的老公……{wait}
			}
			TextWait
			TextTalk char[2] {
				在那時發現了擅自潛入
				礦山的亞雷庫。
				我狠狠訓了他一頓。{wait}
			}
			TextWait
			TextTalk char[2] {
				明明我總是交代他
				那裡很危險所以別進去，
				但那孩子就是說不聽……{wait}
			}
			TextWait
			TextTalk char[2] {
				我光是要擔心老公就來不及了，
				希望他別給我增添多餘的擔心啊。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[2] {
				明明我總是交代他
				礦山很危險所以別進去，
				但那孩子就是說不聽……{wait}
			}
			TextWait
			TextTalk char[2] {
				真希望他再
				聽話一點。{wait}
			}
			TextWait
	elif flag[2560]:
		TextTalk char[2] {
			霍夫曼真是的，
			忘記帶便當去礦山了。{wait}
		}
		TextWait
		TextTalk char[2] {
			他一定會餓，
			我得送便當過去呢。{wait}
		}
		TextWait
	elif flag[2389]:
		if !flag[0]:
			TextTalk char[2] {
				我家孩子，老是愛闖入
				危險場所，很令人傷腦筋呢。{wait}
			}
			TextWait
			TextTalk char[2] {
				今天早上也是，要不是岡茲先生
				幫忙阻止，真不曉得會怎樣……{wait}
			}
			TextWait
			TextTalk char[2] {
				有一天說不定會
				受重傷啊，真是的。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[2] {
				我家孩子似乎好奇心很旺盛。
				老是愛闖進危險的地方。{wait}
			}
			TextWait
			TextTalk char[2] {
				一定是遺傳到老公的個性了吧。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[6]:
	TextStart self
	if flag[3074]:
	elif flag[2848]:
		TextTalk char[6] {
			唉～下雨天
			不能在外面玩，好無聊哦。{wait}
		}
		TextWait
		TextTalk char[6] {
			真希望爸爸快點回來
