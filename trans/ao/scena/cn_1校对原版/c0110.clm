	TextTalk name[0] {
		#1330000005V#00004F#11P──呼，我吃飽了。{wait}
	}
	TextWait
	TextTalk name[3] {
		#1330030004V#00309F#11P哎呀～凍壞了的身體
		吃了雜炊舒服多了。{wait}
	}
	TextWait
	CharSetChipPattern name[1] 2
	Sleep 200ms
	TextTalk name[1] {
		#1330010004V#5P#00102F呵呵，對呀。
		畢竟還加了蛋和雞肉。{wait}
	}
	TextWait
	CharSetChipPattern name[8] 1
	Sleep 100ms
	TextTalk name[8] {
		#1330050004V#12P#10109F琪雅，謝謝妳的早餐。{wait}
	}
	TextWait
	CharSetChipPattern name[2] 1
	Sleep 100ms
	TextTalk name[2] {
		#1330020002V#6P#00202F真的很好吃。{wait}
	}
	TextWait
	CharSetChipPattern char[1] 2
	Sleep 300ms
	TextTalk char[1] {
		#1330110001V#6P#01104F耶嘿嘿，只是用昨天的
		火鍋的材料做的而已啦。{wait}
	} {
		#1330110002V#01110F瓦奇，你有吃飽嗎？{wait}
	}
	TextWait
	CharSetChipPattern name[4] 2
	Sleep 300ms
	TextTalk name[4] {
		#1330040007V#10304F#11P……嗯。
		美味的料理沁人心脾啊。{wait}
	} {
		#1330040008V#10302F多謝款待，琪雅。{wait}
	}
	TextWait
	TextTalk char[1] {
		#1330110003V#6P#01109F耶嘿嘿，太好了。{wait}
	}
	TextWait
	CharSetChipPattern char[0] 1
	Sleep 300ms
	TextTalk char[0] {
		#1330100001V#5P#01004F呵……吃完之後舒服多了吧。{wait}
	} {
		#1330100002V#01000F關於瓦魯多・瓦雷斯的事情……
		警備隊那邊也正在持續搜索。{wait}
	} {
		#1330100003V你們不用那麼自責。{wait}
	}
	TextWait
	CharSetChipPattern name[0] 2
	Sleep 100ms
	CharSetChipPattern name[1] 0
	Sleep 100ms
	CharSetChipPattern name[3] 2
	TextTalk name[4] {
		#1330040009V#10304F#12P……哈哈，也是。{wait}
	}
	TextWait
	TextTalk name[0] {
		#1330000006V#00013F#11P不過，瓦魯多肯定是
		在某個地方拿到了《真知》，
		絕對錯不了。{wait}
	} {
		#1330000007V我們得設法
		弄清楚他的管道才行……！{wait}
	}
	TextWait
	TextTalk char[0] {
		#1330100004V#5P#01003F關於這點，
		現在二課已經有所行動了。{wait}
	} {
		#1330100005V我聽說一課也正著手調查
		是否有外國勢力介入。{wait}
	} {
		#1330100006V#01000F總之，不用這麼著急。{wait}
	}
	TextWait
	TextTalk name[0] {
		#1330000008V#00006F#11P……好的。{wait}
	}
	TextWait
	TextTalk name[2] {
		#1330020003V#6P#00200F結果昨天的脫軌意外現場，
		已經大致恢復通車了嗎？{wait}
	}
	TextWait
	TextTalk char[0] {
		#1330100007V#5P#01005F嗯，在昨天傍晚恢復到
		可以單線通車之後，
		好像徹夜搶通到完全通車了。{wait}
	} {
		#1330100008V#01004F幸好沒有造成重大影響。{wait}
	}
	TextWait
	TextTalk name[8] {
		#1330050005V#12P#10106F呼……真是太好了。{wait}
	}
	TextWait
	TextTalk name[1] {
		#1330010005V#6P#00103F大陸橫斷鐵路是交通命脈……
		如果一直沒辦法通車，
		現在應該已經一片混亂了吧。{wait}
	}
	TextWait
	TextTalk name[3] {
		#1330030005V#00306F#11P如果演變成那樣，
		帝國和共和國一定會利用這件事
