fn[5]:
	TextStart char[0]
	if flag[2837]:
		Call fn[0,6]
	elif flag[2816]:
		if !QuestFlagsGet quest[129] 0x10:
			if !flag[0]:
				TextTalk char[0] {
					各位親愛的旅客，
					感謝您今日搭乘
					克洛斯貝爾站的列車。{wait}
				}
				TextWait
				TextTalk char[0] {
					開往共和國的列車
					以及開往帝國的列車，
					即將依序發車。{wait}
				}
				TextWait
				TextTalk char[0] {
					趕時間的旅客
					請儘早購買車票。{wait}
				}
				TextWait
				FlagSet flag[0]
			else:
				TextTalk char[0] {
					開往共和國的列車
					以及開往帝國的列車，
					即將依序發車。{wait}
				}
				TextWait
				TextTalk char[0] {
					趕時間的旅客
					請儘早購買車票。{wait}
				}
				TextWait
		else:
			TextTalk char[0] {
				聽說有逃犯跳到
				列車的屋頂時，
				我真懷疑是自己聽錯了。{wait}
			}
			TextWait
			TextTalk char[0] {
				看來今後需要多加提防
				有人做出類似的行為了。{wait}
			}
			TextWait
	elif flag[2573]:
		if !flag[0]:
			TextTalk char[0] {
				各位親愛的旅客，
				感謝您今日搭乘
				克洛斯貝爾站的列車。{wait}
			}
			TextWait
			TextTalk char[0] {
				通商會議期間，
				帝國軍將會
				加強月台的警備。{wait}
			}
			TextWait
			TextTalk char[0] {
				臨檢也會較為嚴格，
				懇請各位見諒。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				通商會議期間，
				帝國軍將會
				加強月台的警備。{wait}
			}
			TextWait
			TextTalk char[0] {
