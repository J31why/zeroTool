				感謝您今日搭乘
				克洛斯貝爾站的列車。{wait}
			}
			TextWait
			TextTalk char[0] {
				目前雖處於通商會議期間，
				但鐵路將會照常運行。{wait}
			}
			TextWait
			TextTalk char[0] {
				車票可於
				二樓購買，
				請您前往那邊。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
