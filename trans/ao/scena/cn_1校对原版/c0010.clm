fn[6]:
	_Char4A char[0] 255
	_Char4A char[8] 255
	if !flag[0]:
		TextTalk char[0] {
			開往帝國的列車以及
			開往共和國的列車，
			目前均處於停駛狀態。{wait}
		}
		TextWait
		TextTalk char[0] {
			將對各位旅客
			造成莫大的不便……{wait}
		}
		TextWait
		TextTalk char[8] {
			怎麼這樣？傷腦筋啊！
			我在帝國有很重要的
			生意要談……！{wait}
		}
		TextWait
		FlagSet flag[0]
