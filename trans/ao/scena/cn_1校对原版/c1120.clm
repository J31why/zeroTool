	TextTalk name[3] {
		#00300F明明是個雨天，
		還鬧得這麼火熱啊。{wait}
	}
	TextWait
	TextTalk name[0] {
		#00000F對啊，前去參加的市民
		也比想像中的還要多……{wait}
	} {
		#00003F話說回來，傾向帝國跟共和國的
		實力派議員，跟最近勢如破竹的獨立派
		年輕議員這樣掀起論戰……{wait}
	}
	TextWait
	TextTalk name[4] {
		#10302F呵呵，這陣容簡直就跟克洛斯貝爾
		當今的政治狀況一樣。{wait}
	}
	TextWait
	TextTalk name[2] {
		#00200F感覺不論哪派的說法
		聽起來都煞有其事，但是……{wait}
	}
	TextWait
	TextTalk name[1] {
		#00103F……實際上，這個問題
		可沒那麼容易就得出結論。{wait}
	} {
		畢竟這幾十年來一直都
		重複著這樣的議論。{wait}
	} {
		#00101F不過，也是時候該認真
		有個一致的結論了……{wait}
	}
	TextWait
	TextTalk name[8] {
		#10101F………我也這麼認為。{wait}
	} {
		#10108F（是要選擇前途多舛的獨立，
		　還是捨棄正義從屬他國……）{wait}
	}
	TextWait
