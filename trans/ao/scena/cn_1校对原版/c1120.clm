	unk1 126
	unk2 0
	function fn[0,17]
	unk3 0
	unk4 0

fn[0]:
	switch random % 8:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharSetPos self (3130, 0, 9060) 270deg
		CharWalkToPos self (-160, 0, 7500) 1000mm/s 0
		CharTurnTo self 180deg 500deg/s
		CharWalkToPos self (-1340, 0, 3750) 1000mm/s 0
		CharWalkToPos self (-80, 0, -190) 1000mm/s 0
		CharTurnTo self 135deg 500deg/s
		Sleep 2000ms
		CharWalkToPos self (-1120, 0, 1760) 1000mm/s 0
		CharWalkToPos self (-3830, 0, 1460) 1000mm/s 0
		CharWalkToPos self (-4390, 0, 2430) 1000mm/s 0
		CharTurnTo self 0deg 500deg/s
		Sleep 2000ms
		CharWalkToPos self (-4330, 0, -270) 1000mm/s 0
		Sleep 2000ms
		CharWalkToPos self (-2360, 0, 1350) 1000mm/s 0
		CharWalkToPos self (1010, 0, 2510) 1000mm/s 0
		CharWalkToPos self (1630, 0, 3540) 1000mm/s 0
		CharTurnTo self 0deg 500deg/s
		Sleep 2000ms
		CharWalkToPos self (3710, 0, 4130) 1000mm/s 0
		CharWalkToPos self (4290, 0, 7130) 1000mm/s 0
		CharWalkToPos self (3130, 0, 9060) 1000mm/s 0
	Return

fn[2]:
	while 1:
		CharWalkToPos char[15] (-7300, 0, -2510) 2000mm/s 0
		CharWalkToPos char[15] (-7330, 0, 1430) 2000mm/s 0
		CharTurnTo char[15] 270deg 500deg/s
		Sleep 2000ms
		CharWalkToPos char[15] (-5910, 0, 4260) 2000mm/s 0
		CharTurnTo char[15] 90deg 500deg/s
		Sleep 2000ms
		CharWalkToPos char[15] (-6960, 0, 7410) 2000mm/s 0
		CharTurnTo char[15] 270deg 500deg/s
		Sleep 2000ms
		CharWalkToPos char[15] (-5910, 0, 4260) 2000mm/s 0
		CharTurnTo char[15] 90deg 500deg/s
		Sleep 2000ms
		CharWalkToPos char[15] (-7330, 0, 1430) 2000mm/s 0
		CharTurnTo char[15] 270deg 500deg/s
		Sleep 2000ms
		CharWalkToPos char[15] (-7300, 0, -2510) 2000mm/s 0
		CharWalkToPos char[15] (-5820, 0, -3790) 2000mm/s 0
		CharTurnTo char[15] 45deg 500deg/s
		Sleep 2000ms
	Return

fn[3]:
	if flag[273]:
		FlagUnset flag[273]
		FlagSet flag[11]
		Event fn[0,24]
	elif flag[274]:
		FlagUnset flag[274]
		Event fn[0,41]
	if !flag[2861] && flag[2848]:
		if !flag[3038]:
			Event fn[0,42]
	if flag[3074] && !flag[3089]:
		FlagSet flag[11]
		if QuestFlagsGet quest[143] 0x10:
			CharFlagsSet char[0] 0x0010
			CharFlagsSet char[4] 0x0010
			CharSetPos char[4] (-4500, 0, -7300) 270deg
			CharSetPos char[0] (-5560, 0, -7300) 90deg
			CharSetPos char[1] (-5160, 0, -6000) 135deg
			CharSetPos char[16] (-8590, 0, 2730) 225deg
			CharFlagsUnset char[16] 0x0080
			CharFlagsSet char[6] 0x0080
			CharSetPos char[17] (3340, 0, 10090) 90deg
			CharFlagsUnset char[17] 0x0080
			CharSetPos char[15] (-5820, 0, -3790) 45deg
			ForkFunc char[15] fork[0] fn[0,2]
			CharFlagsUnset char[15] 0x0080
			CharSetChipBase char[5] chip[16]
			CharSetChipPattern char[5] 0
			ForkQuit char[5] fork[0]
			CharFlags2Set char[5] 0x0004
			CharSetChipBase char[14] chip[14]
			CharSetChipPattern char[14] 0
			ForkQuit char[14] fork[0]
			CharFlags2Set char[14] 0x0004
		else:
			CharFlagsSet char[5] 0x0010
			CharFlagsSet char[14] 0x0010
			CharFlagsSet char[12] 0x0010
			CharFlagsSet char[13] 0x0010
		CharSetChipBase char[7] chip[7]
		CharSetChipPattern char[7] 0
		ForkQuit char[7] fork[0]
		CharFlags2Set char[7] 0x0004
	Return

fn[4]:
	if flag[3074] && !flag[3089]:
		ObjFlagsSet object[11] 0x0004
		ObjFlagsSet object[12] 0x0004
		ObjFlagsSet object[13] 0x0004
		FlagSet flag[11]
	if flag[2848] && !flag[2858] | flag[2369] && system[4] == 1:
		ED7_76_0 object[255] "light01" 1
		ED7_76_0 object[255] "light04" 1
		SoundPlay sound[128] 1 50 0
	if !flag[3385] && flag[3370]:
		MapColor 0x00E6D2D2 0ms
		ED7_76_0 object[255] "light01" 1
		ED7_76_0 object[255] "light04" 1
	LookPointFlagsSet look_point[0] 0x0001
	ObjFlagsSet object[14] 0x0004
	if flag[3074]:
		LookPointFlagsUnset look_point[0] 0x0001
		ObjFlagsUnset object[14] 0x0004
	if flag[11]:
		system[1] = 162
		FlagUnset flag[11]
	Return

fn[5]:
	TextSetName ""
	TextSetPos -1 -1 -1 -1
	TextMessage null {
		{color 5}★特製香甜巧克力的做法★
		　～　各位要不要試著全家
		　　　一起做做看？　　～{wait}
	}
	TextWait
	TextMessage null {
		{color 5}上面寫著香甜巧克力的食譜。{wait}
	}
	TextWait
	TextClose 0
	_59
	TextSetPos -1 280 60 3
	if ItemHas item[2] 0:
		if !RecipeLearn 17:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextSetName ""
			TextMessage null {
				記住了{color 2}『香甜巧克力』{color 0}的食譜。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			FadeWait
			_59
			TextSetPos -1 280 60 3
	TextEnd null
	Return

fn[6]:
	TextStart self
	if QuestFlagsGet quest[143] 0x10:
		if !flag[4]:
			CharTurnToChar char[0] field_party[0] 500deg/s
			TextTalk char[0] {
				#02102F啊，你們也辛苦了！{wait}
			} {
				我正在採訪
				選美大會的參賽者。{wait}
			} {
				#02109F呵呵，你們幾個
				等會也要陪陪我哦～♪{wait}
			}
			TextWait
			TextTalk name[0] {
				#00006F（呃、嗯，雖然不太好意思，
				　但感覺採訪會耗費不少時間……）{wait}
			}
			TextWait
			TextTalk name[4] {
				#10302F（呵呵，我看還是偷偷溜掉
				　比較好吧。）{wait}
			}
			TextWait
			CharTurnTo char[0] 90deg 500deg/s
			FlagSet flag[4]
		else:
			TextTalk char[0] {
				#02105F哎呀呀，是這樣嗎？{wait}
			} {
				#02100F的確，
				才剛發生那種可怕的事件，
				去見見家人報個平安也是不錯。{wait}
			}
			TextWait
	elif !flag[3302]:
		TextTalk char[0] {
			#02109F嗨！羅伊德還有各位！{wait}
		}
		TextWait
		TextTalk name[0] {
			#00000F格蕾絲小姐……
			妳是來慈善活動進行採訪的嗎？{wait}
		}
		TextWait
		TextTalk char[0] {
			#02100F呵呵，就是這麼回事☆{wait}
		} {
			看上去挺熱鬧的，
			看來我能寫篇讓克洛斯貝爾
			市民振奮精神的报道了。{wait}
		} {
			#02103F畢竟那起攻擊事件
			造成的傷痕還沒癒合……{wait}
		} {
			#02102F我們媒體記者
			也得盡力而為才對。{wait}
		}
		TextWait
		TextTalk name[3] {
			#00309F哈哈，要努力啊。{wait}
		}
		TextWait
		FlagSet flag[3302]
	else:
		TextTalk char[0] {
			#02102F其實呢，我還聽說
			這場慈善活動
			有非常好玩的節目……{wait}
		} {
			#02109F呵呵，我一定要寫條獨家新聞！{wait}
		}
		TextWait
	TextEnd self
	Return

fn[7]:
	TextStart self
	if QuestFlagsGet quest[143] 0x10:
		TextTalk self {
			選美大會
			非常精彩呢。{wait}
		}
		TextWait
		TextTalk self {
			我也拍了一堆精彩的照片，
			得趕緊回去整理才行。{wait}
		}
		TextWait
	else:
		TextTalk self {
			被請到慈善活動來演出的
			美女鋼琴演奏家……{wait}
		}
		TextWait
		TextTalk self {
			看來能拍到精彩的照片。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[8]:
	TextStart self
	if QuestFlagsGet quest[143] 0x10:
		if !flag[5]:
			TextTalk self {
				哎呀～我還真沒想到
				珊珊會跑去參加
				選美大會咧。{wait}
			}
			TextWait
			TextTalk self {
				不過，她好像也因此
				恢復了一些精神，
				結果好就好了吧。{wait}
			}
			TextWait
			FlagSet flag[5]
		else:
			TextTalk self {
				可話又說回來，
				珊珊跑去參加選美大會……{wait}
			}
			TextWait
			TextTalk self {
				……希望店長不要發火。{wait}
			}
			TextWait
	elif !flag[5]:
		TextTalk self {
			我們《龍老飯店》
			為慈善活動
			提供餐點。{wait}
		}
		TextWait
		TextTalk self {
			店那邊是讓帕克跟魯斯
			來負責我的空缺。{wait}
		}
		TextWait
		TextTalk self {
			雖然有點擔心，
			但他們也慢慢上軌道了，
			應該沒問題吧。{wait}
		}
		TextWait
		FlagSet flag[5]
	else:
		TextTalk self {
			不過……珊珊最近
			都沒什麼精神耶。{wait}
		}
		TextWait
		TextTalk self {
			她好像也拒絕
			參加比賽……
			希望她能早點打起精神。{wait}
		}
		TextWait
	TextEnd self
	Return

fn[9]:
	TextStart self
	if QuestFlagsGet quest[143] 0x10:
		if !flag[9]:
			TextTalk self {
				哦呵呵，
				這樣客人要是變多，
				爸爸一定也會很高興。{wait}
			}
			TextWait
			TextTalk self {
				……雖然我很擔心莉夏，
				但我相信她一定會回來的。{wait}
			}
			TextWait
			TextTalk self {
				為了到時候能用笑臉迎接她，
				我也得打起精神等她回來才行。{wait}
			}
			TextWait
			FlagSet flag[9]
		else:
			TextTalk self {
				雖然我很擔心莉夏，
				但我相信她一定會回來的。{wait}
			}
			TextWait
			TextTalk self {
				為了到時候能用笑臉迎接她，
				我也得打起精神等她回來才行。{wait}
			}
			TextWait
	else:
	TextEnd self
	Return

fn[10]:
	TextStart self
	if QuestFlagsGet quest[143] 0x10:
