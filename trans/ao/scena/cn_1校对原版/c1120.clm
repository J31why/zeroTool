fn[13]:
	TextStart self
	if QuestFlagsGet quest[143] 0x10:
		if flag[7]:
			TextTalk char[0] {
				#02100F嗯、嗯……所以是
				職場的同事推薦妳來的？{wait}
			}
			TextWait
			TextTalk self {
				嗯，對啊。{wait}
			}
			TextWait
			TextTalk self {
				呵呵，站在選美大會的舞台上
				真的很讓人緊張。{wait}
			}
			TextWait
			TextTalk self {
				不過，我好高興自己
				能獲得大家的掌聲。{wait}
			}
			TextWait
			TextTalk self {
				呵呵，來報名果然是對的。{wait}
			}
			TextWait
