    static void fix_talk_cl_sjis_byte_valid(uintptr_t ptr) {
        DWORD old_protect = 0;
        if (!VirtualProtect((LPVOID)ptr, 0x100, PAGE_EXECUTE_READWRITE, &old_protect)) {
            throw runtime_error("无法更改内存保护");
        }
        /*
        140104D5F - 80 F9 80              - cmp cl,-80 { 128 }
        140104D62 - 77 04                 - ja 140104D68
        140104D64 - 90                    - nop
        140104D65 - 90                    - nop
        140104D66 - EB 2B                 - jmp 140104D93
        */
        uint8_t patch_bytes[] = { 0x80, 0xF9, 0x80, 0x77, 0x04, 0x90, 0x90 ,0xeb};
        void* patch_addr = reinterpret_cast<void*>(ptr);
		memcpy_s(patch_addr, sizeof(patch_bytes), patch_bytes, sizeof(patch_bytes));
        
        if (!VirtualProtect((LPVOID)ptr, 0x100, old_protect, &old_protect)) {
            throw runtime_error("无法更改内存保护");
        }
        /*
        140104D5C - 8D 41 80              - lea eax,[rcx-80]
        140104D5F - 3C 1F                 - cmp al,1F { 31 }    <--input ptr
        140104D61 - 76 05                 - jna 140104D68
        140104D63 - 80 F9 E0              - cmp cl,-20 { 224 }
        140104D66 - 72 2B                 - jb 140104D93
        140104D68 - 48 3B 5C 24 40        - cmp rbx,[rsp+40]
        140104D6D - 74 0C                 - je 140104D7B
        */
    }

    static void fix_talk_dl_sjis_byte_valid(uintptr_t ptr) {
        DWORD old_protect = 0;
        if (!VirtualProtect((LPVOID)ptr, 0x100, PAGE_EXECUTE_READWRITE, &old_protect)) {
            throw runtime_error("无法更改内存保护");
        }
        /*
        1402151DE - 80 FA 80              - cmp dl,-80 { 128 }
        1402151E1 - 77 04                 - ja 1402151E7
        1402151E3 - 90                    - nop 
        1402151E4 - 90                    - nop 
        1402151E5 - EB 0C                 - jmp 1402151F3
        */
        uint8_t patch_bytes[] = { 0x80, 0xFA, 0x80, 0x77, 0x04, 0x90, 0x90 ,0xeb };
        void* patch_addr = reinterpret_cast<void*>(ptr);
        memcpy_s(patch_addr, sizeof(patch_bytes), patch_bytes, sizeof(patch_bytes));

        if (!VirtualProtect((LPVOID)ptr, 0x100, old_protect, &old_protect)) {
            throw runtime_error("无法更改内存保护");
        }
        /*
        1402151DB - 48 FF C1              - inc rcx
        1402151DE - 3C 1F                 - cmp al,1F { 31 }
        1402151E0 - 76 05                 - jna 1402151E7
        1402151E2 - 80 FA E0              - cmp dl,-20 { 224 }
        1402151E5 - 72 0C                 - jb 1402151F3
        1402151E7 - 0FB6 03               - movzx eax,byte ptr [rbx]
        */
    }

    static void fix_escape_sjis_byte_valid(uintptr_t ptr) {
        DWORD old_protect = 0;
        if (!VirtualProtect((LPVOID)ptr, 0x100, PAGE_EXECUTE_READWRITE, &old_protect)) {
            throw runtime_error("无法更改内存保护");
        }
        memset((LPVOID)ptr, 0x90, 2);
        if (!VirtualProtect((LPVOID)ptr, 0x100, old_protect, &old_protect)) {
            throw runtime_error("无法更改内存保护");
        }
    }

    static void fix_check_talk_sjis_byte_valid(uintptr_t ptr) {
        DWORD old_protect = 0;
        if (!VirtualProtect((LPVOID)ptr, 0x100, PAGE_EXECUTE_READWRITE, &old_protect)) {
            throw runtime_error("无法更改内存保护");
        }
		memset((LPVOID)ptr, 0x90, 4);
        if (!VirtualProtect((LPVOID)ptr, 0x100, old_protect, &old_protect)) {
            throw runtime_error("无法更改内存保护");
        }
    }

    static void fix_noteHelpKey_pos(uintptr_t ptr) {
        uintptr_t pDic = ptr;
        pDic = (uintptr_t) * (uint64_t*)(pDic + 0x18);
        pDic = (uintptr_t) * (uint64_t*)(pDic + 0x48);
        pDic = (uintptr_t) * (uint64_t*)(pDic + 0x30);
        //0x50 关于手册
        uintptr_t pDic_key = (uintptr_t) * (uint64_t*)(pDic + 0x50);
        pDic_key = (uintptr_t) * (uint64_t*)(pDic_key + 0x30);
        pDic_key += 0xc;
        *(float_t*)pDic_key = 90.0f;
        for (size_t i = 0; i < 4; i++)
        {
            pDic_key += 0x1c;
            *(float_t*)pDic_key += 3.0f;
        }
        pDic_key += 0x1c;
        *(float_t*)pDic_key = 94.0f;
        // 战技2
        pDic_key = (uintptr_t) * (uint64_t*)(pDic + 0x48);
        pDic_key = (uintptr_t) * (uint64_t*)(pDic_key + 0x30);
        pDic_key += 0xc;
        *(float_t*)pDic_key = 89.0f;
        *(float_t*)(pDic_key + 0x4) += 1.0f;
        for (size_t i = 0; i < 4; i++)
        {
            pDic_key += 0x1c;
            *(float_t*)pDic_key += 3.0f;
            *(float_t*)(pDic_key + 0x4) += 5.0f;
        }
        cout << "[INFO]Fixed note help key position" << endl;
    }

    int32_t __fastcall hooked_loadNoteHelpKey_posMap() {
        int32_t result = ori_loadNoteHelpKey_posMap();
        fix_noteHelpKey_pos(noteHelpKey_posMap_addr);
        return result;
    }

