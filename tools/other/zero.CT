[ENABLE]

aobscanmodule(INJECT,zero.exe,F6 80 6C 01 00 00 10 74 52) // should be unique
alloc(newmem,$1000,INJECT)

label(code1)
label(code2)
label(return)

newmem:

code1:
  test rax,rax
  jne code2
  mov rbx,[rsp+1f8]
  add rsp,1c0
  pop rdi
  pop rsi
  pop rbp
  ret
code2:
  test byte ptr [rax+0000016C],10
  jmp return

INJECT:
  jmp newmem
  nop 2
return:
registersymbol(INJECT)

[DISABLE]

INJECT:
  db F6 80 6C 01 00 00 10

unregistersymbol(INJECT)
dealloc(newmem)

</AssemblerScript>
