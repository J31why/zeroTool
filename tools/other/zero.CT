          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
aobscanregion(INJECT,0000000,ffff0000000,0D 02 08 01 ?? ?? 00 00 19 01 5C 01 01 23 30 30 30 30 46)
registersymbol(INJECT)

INJECT+a:
  db 06 00 00 10 21 00 00 00 07


alloc(result,4)
registersymbol(result)
result:
dd INJECT
[DISABLE]
INJECT+a:
  db 5C 01 01 23 30 30 30 30 46

unregistersymbol(INJECT)
unregistersymbol(result)
dealloc(result)
</AssemblerScript>
